---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BanglaTypingTest from "../components/BanglaTypingTest.astro";
import { resolveCanonicalUrl, STANDALONE_TOOLS } from "../config/site";

const canonicalUrl = resolveCanonicalUrl("/bangla-typing-test/");
const testTool = STANDALONE_TOOLS.find((tool) => tool.id === "bangla-typing-test");
const pageTitle = "বাংলা টাইপিং পরীক্ষা – গতি ও নির্ভুলতা যাচাই করুন | Wordora";
const pageDescription = "বিনামূল্যে বাংলা টাইপিং পরীক্ষা দিন। সময়ভিত্তিক বা প্যাসেজভিত্তিক পরীক্ষা, গতি, নির্ভুলতা, ভুল বিশ্লেষণ ও ব্যক্তিগত রেকর্ড দেখুন।";

const faqs = [
	{
		question: "বাংলা টাইপিং পরীক্ষায় গতি কীভাবে হিসাব করা হয়?",
		answer: "সঠিক বর্ণ ও শব্দের সংখ্যা পরীক্ষা চলার সময়ের মিনিট অনুযায়ী হিসাব করা হয়। নেট গতি ভুল বর্জন করে, আর মোট গতি সব লেখা হিসাব করে।",
	},
	{
		question: "অভ্র ও বিজয় দুইভাবেই কি পরীক্ষা দেওয়া যাবে?",
		answer: "হ্যাঁ। আপনার কম্পিউটারে অভ্র, বিজয় ইউনিকোড বা অন্য বাংলা ইনপুট পদ্ধতি চালু থাকলে এটি ব্যবহার করা যাবে। পদ্ধতি গঠনের সময় লেখাটি সম্পূর্ণ হলে ফলাফল বাড়ে।",
	},
	{
		question: "কীভাবে ব্যক্তিগত রেকর্ড সংরক্ষিত হয়?",
		answer: "পরীক্ষার ইতিহাস ও সেরা রেকর্ড শুধুমাত্র এই ব্রাউজারের লোকাল স্টোরেজে সংরক্ষিত হয়। কোনো অ্যাকাউন্ট বা সার্ভার প্রয়োজন নেই।",
	},
	{
		question: "ট্যাবলেট বা মোবাইলেও কি পরীক্ষা চলবে?",
		answer: "হ্যাঁ। ছোট স্ক্রিনের জন্য সহজ কন্ট্রোল, বড় টাইপিং ঘর ও উত্তরোত্তর অগ্রগতি বার রাখা হয়েছে।",
	},
];

const structuredData = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	name: testTool?.name ?? "বাংলা টাইপিং পরীক্ষা",
	url: canonicalUrl,
	inLanguage: "bn",
	applicationCategory: "EducationalApplication",
	operatingSystem: "Web",
	offers: { "@type": "Offer", price: "0", priceCurrency: "BDT" },
	description: pageDescription,
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
	htmlLang="bn"
	ogLocale="bn_BD"
	robots="index, follow"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</Fragment>

	<Header />

	<main class="bangla-test-page flex-1">
		<section class="border-b border-hairline bg-[#EDF5F1] px-4 pt-10 pb-9 dark:bg-[#101D18] sm:px-6 sm:pt-14 sm:pb-11">
			<div class="mx-auto max-w-[1100px]">
				<p class="text-[13px] font-semibold text-[#315846] dark:text-[#B8D6C7]">বাংলা টাইপিং পরীক্ষা</p>
				<h1 class="mt-2 text-[32px] leading-[42px] font-semibold tracking-[-1.2px] text-ink sm:text-[44px] sm:leading-[54px]">
					আপনার বাংলা টাইপিংয়ের গতি পরীক্ষা করুন
				</h1>
				<p class="mt-3 max-w-2xl text-[16px] leading-[26px] text-body">
					সময় বা নির্দিষ্ট প্যাসেজ বেছে নিয়ে টাইপ করুন। গতি, নির্ভুলতা, ভুল বর্ণ এবং ব্যক্তিগত রেকর্ড সঙ্গে সঙ্গে দেখুন।
				</p>
			</div>
		</section>

		<section id="test" aria-labelledby="test-heading" class="mx-auto max-w-[1100px] px-4 py-8 sm:px-6 sm:py-10">
			<h2 id="test-heading" class="text-[20px] font-semibold text-ink">টাইপিং পরীক্ষা</h2>
			<p class="mt-1 text-[13.5px] leading-relaxed text-mute">সময়, স্তর, ধরন ও বিষয় বেছে নিন, তারপর পরীক্ষা শুরু করুন।</p>
			<div class="mt-4"><BanglaTypingTest /></div>
		</section>

		<section aria-labelledby="setup-heading" class="mx-auto max-w-[1100px] border-t border-hairline px-4 py-10 sm:px-6">
			<div class="max-w-3xl">
				<h2 id="setup-heading" class="text-[24px] font-semibold tracking-[-0.6px] text-ink sm:text-[28px]">অভ্র ও বিজয় কীভাবে ব্যবহার করবেন</h2>
				<p class="mt-2 text-[15px] leading-relaxed text-body">
					Wordora নিজে বাংলা রূপান্তর করে না। কম্পিউটার বা মোবাইলে অভ্র, বিজয় ইউনিকোড বা অন্য ইউনিকোড বাংলা কীবোর্ড চালু করে এই ঘরে লিখুন।
				</p>
			</div>
			<div class="mt-5 grid gap-3 md:grid-cols-2">
				<article class="rounded-xl border border-hairline bg-card p-5">
					<h3 class="text-[16px] font-semibold text-ink">অভ্র ফোনেটিক</h3>
					<p class="mt-2 text-[14px] leading-relaxed text-body">কম্পিউটারে অভ্র ফোনেটিক চালু করুন। এরপর ইংরেজি কিবোর্ডের সাহায্যে বাংলা উচ্চারণ লিখুন। যুক্তবর্ণ গঠনের জন্য হসন্ত ও পরের বর্ণটি পর্যায়ক্রমে লিখুন।</p>
				</article>
				<article class="rounded-xl border border-hairline bg-card p-5">
					<h3 class="text-[16px] font-semibold text-ink">বিজয় ইউনিকোড</h3>
					<p class="mt-2 text-[14px] leading-relaxed text-body">বিজয় ইউনিকোড ও বাংলা লেআউট বেছে নিন। বাংলা কীবোর্ড লেআউট অনুযায়ী বর্ণ, কারচিহ্ন ও যতিচিহ্ন লিখুন। পুরোনো বিজয় ফন্ট নয়, ইউনিকোড মোড ব্যবহার করুন।</p>
				</article>
			</div>
			<ol class="mt-5 grid gap-2 sm:grid-cols-3" aria-label="বাংলা কীবোর্ড চালু করার ধাপ">
				<li class="rounded-xl border border-hairline bg-surface p-4 text-[13.5px] text-body"><strong class="text-ink">১. কীবোর্ড চালু করুন</strong><br />উইন্ডোজ, ম্যাক বা মোবাইলে বাংলা ইনপুট যোগ করুন।</li>
				<li class="rounded-xl border border-hairline bg-surface p-4 text-[13.5px] text-body"><strong class="text-ink">২. ইউনিকোড বেছে নিন</strong><br />অভ্র ফোনেটিক বা বিজয় ইউনিকোড ব্যবহার করুন।</li>
				<li class="rounded-xl border border-hairline bg-surface p-4 text-[13.5px] text-body"><strong class="text-ink">৩. লেখা সম্পূর্ণ হলে পরীক্ষা দিন</strong><br />কারচিহ্ন ও যুক্তবর্ণ গঠনের মাঝখানে পরীক্ষা কক্ষ পরিবর্তন হবে না।</li>
			</ol>
		</section>

		<section aria-labelledby="faq-heading" class="mx-auto max-w-[1100px] border-t border-hairline px-4 py-10 sm:px-6">
			<h2 id="faq-heading" class="text-[24px] font-semibold tracking-[-0.6px] text-ink">সাধারণ প্রশ্ন</h2>
			<div class="mt-5 grid gap-3">
				{faqs.map((faq) => (
					<details class="rounded-xl border border-hairline bg-card px-4 py-3 open:bg-surface">
						<summary class="cursor-pointer text-[14.5px] font-semibold text-ink">{faq.question}</summary>
						<p class="mt-2 text-[13.5px] leading-relaxed text-body">{faq.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section aria-labelledby="related-heading" class="mx-auto max-w-[1100px] border-t border-hairline px-4 pt-10 pb-14 sm:px-6">
			<h2 id="related-heading" class="text-[24px] font-semibold tracking-[-0.6px] text-ink">সম্পর্কিত সরঞ্জাম</h2>
			<div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				<a href="/bangla-typing-practice/" class="rounded-xl border border-hairline bg-card p-5 transition hover:-translate-y-0.5 hover:border-ink">
					<span class="text-[12px] text-mute">টাইপিং</span>
					<h3 class="mt-2 text-[16px] font-semibold text-ink">বাংলা টাইপিং প্র্যাকটিস</h3>
					<p class="mt-1 text-[13.5px] text-body">বর্ণ, শব্দ ও বাক্য ধরে ধীরে অনুশীলন করুন।</p>
				</a>
				<a href="/typing-speed-test/" class="rounded-xl border border-hairline bg-card p-5 transition hover:-translate-y-0.5 hover:border-ink">
					<span class="text-[12px] text-mute">টাইপিং</span>
					<h3 class="mt-2 text-[16px] font-semibold text-ink">ইংরেজি টাইপিং পরীক্ষা</h3>
					<p class="mt-1 text-[13.5px] text-body">সময়ভিত্তিক ইংরেজি টাইপিংয়ের গতি যাচাই করুন।</p>
				</a>
				<a href="/word-counter/" class="rounded-xl border border-hairline bg-card p-5 transition hover:-translate-y-0.5 hover:border-ink">
					<span class="text-[12px] text-mute">লেখা</span>
					<h3 class="mt-2 text-[16px] font-semibold text-ink">শব্দ ও বর্ণ গণনা</h3>
					<p class="mt-1 text-[13.5px] text-body">শব্দ, বর্ণ, বাক্য ও অনুচ্ছেদ হিসাব করুন।</p>
				</a>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style is:global>
	.bangla-test-page { font-family: "Noto Sans Bengali", "Hind Siliguri", "Nirmala UI", "Vrinda", "Geist", "Inter", sans-serif; }
</style>
