---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import CaseConverterTool from "../components/CaseConverterTool.astro";
import RelatedTools from "../components/RelatedTools.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";

import { getLocaleFromUrl, getLocalizedPath, localizeHtmlLinks, useTranslations } from "../i18n/ui";
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

interface FaqItem {
	question: string;
	answer: string;
	answerHtml: string;
}

interface TitleBodyCard {
	title: string;
	bodyHtml: string;
}

interface CaseStyleRow {
	name: string;
	category: string;
	description: string;
	example: string;
}

interface TitleCaseRuleCard {
	title: string;
	tag: string;
	bodyHtml: string;
	example: string;
}

interface OfficeShortcutCard {
	icon: string;
	title: string;
	itemsHtml: string[];
}

interface WhereToUseCard {
	title: string;
	subtitle: string;
	bodyHtml: string;
}

const pageTitle = t("caseConverter.title");
const pageDescription = t("caseConverter.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/case-converter/", locale));

const faqs = t.raw<FaqItem[]>("caseConverter.faq.items") ?? [];
const featureList = t.raw<string[]>("caseConverter.schema.featureList") ?? [];
const howToUseSteps = t.raw<TitleBodyCard[]>("caseConverter.page.howToUse.steps") ?? [];
const caseStylesHeaders = t.raw<string[]>("caseConverter.page.caseStyles.headers") ?? [];
const caseStyles = t.raw<CaseStyleRow[]>("caseConverter.page.caseStyles.rows") ?? [];
const titleCaseRuleCards = t.raw<TitleCaseRuleCard[]>("caseConverter.page.titleCaseRules.cards") ?? [];
const officeShortcutCards = t.raw<OfficeShortcutCard[]>("caseConverter.page.officeShortcuts.cards") ?? [];
const whereToUseCards = t.raw<WhereToUseCard[]>("caseConverter.page.whereToUse.cards") ?? [];

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebApplication",
			name: t("caseConverter.name"),
			url: canonicalUrl,
			inLanguage: locale,
			applicationCategory: "UtilitiesApplication",
			operatingSystem: "All",
			offers: {
				"@type": "Offer",
				price: "0",
				priceCurrency: "USD",
			},
			description: pageDescription,
			featureList,
		},
		{
			"@type": "FAQPage",
			inLanguage: locale,
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: faq.answer,
				},
			})),
		},
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					{t("caseConverter.h1")}
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					{t("caseConverter.page.heroSubtitle")}
				</p>
			</div>
		</section>

		<!-- Interactive Case Converter Workspace -->
		<CaseConverterTool locale={locale} />

		<!-- Topical cluster interlinking -->
		<RelatedTools toolId="case-converter" locale={locale} />

		<!-- Section 1 — What Is an Online Case Converter & How to Use It (4-Step Grid) -->
		<section
			id="how-to-use"
			aria-labelledby="how-to-use-heading"
			class="mx-auto max-w-[1200px] px-4 pt-8 pb-12 sm:px-6 sm:pt-10"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("caseConverter.page.howToUse.badge")}
					</span>
					<h2
						id="how-to-use-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("caseConverter.page.howToUse.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("caseConverter.page.howToUse.intro")}
					</p>
				</div>

				<div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
					{
						howToUseSteps.map((step, idx) => (
							<div
								class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
							>
								<div>
									<div class="mb-4 flex items-center gap-3">
										<span
											class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
										>
											{idx + 1}
										</span>
										<h3 class="font-sans text-[15px] font-semibold text-ink">
											{step.title}
										</h3>
									</div>
									<p class="text-[14px] leading-relaxed text-body" set:html={localizeHtmlLinks(step.bodyHtml, locale)} />
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Section 2A — All 13 Text & Programming Case Styles Explained -->
		<section
			id="case-styles-explained"
			aria-labelledby="case-styles-heading"
			class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("caseConverter.page.caseStyles.badge")}
					</span>
					<h2
						id="case-styles-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("caseConverter.page.caseStyles.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("caseConverter.page.caseStyles.intro")}
					</p>
				</div>

				<div class="mt-8 overflow-hidden rounded-2xl border border-hairline bg-canvas-elevated">
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse text-[14px]">
							<thead>
								<tr class="border-b border-hairline bg-[#0f2e26]/5 text-[13px] font-semibold text-ink dark:bg-[#afe3d0]/5">
									{
										caseStylesHeaders.map((header) => (
											<th class="p-4 sm:px-6 sm:py-4">{header}</th>
										))
									}
								</tr>
							</thead>
							<tbody class="divide-y divide-hairline">
								{
									caseStyles.map((item) => (
										<tr class="transition-colors hover:bg-canvas/50">
											<td class="p-4 sm:px-6 sm:py-4 font-semibold text-ink whitespace-nowrap">
												{item.name}
											</td>
											<td class="p-4 sm:px-6 sm:py-4 whitespace-nowrap">
												<span class="inline-flex rounded-md border border-hairline bg-canvas px-2.5 py-1 text-[12px] font-medium text-mute">
													{item.category}
												</span>
											</td>
											<td class="p-4 sm:px-6 sm:py-4 text-body leading-relaxed max-w-md">
												{item.description}
											</td>
											<td class="p-4 sm:px-6 sm:py-4 font-mono text-[13px] text-ink whitespace-nowrap">
												<span class="rounded bg-canvas px-2 py-1 border border-hairline">
													{item.example}
												</span>
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</section>

		<!-- Section 2B — AP vs. APA vs. Chicago Title Case Rules -->
		<section
			id="title-case-rules"
			aria-labelledby="title-case-rules-heading"
			class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("caseConverter.page.titleCaseRules.badge")}
					</span>
					<h2
						id="title-case-rules-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("caseConverter.page.titleCaseRules.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("caseConverter.page.titleCaseRules.intro")}
					</p>
				</div>

				<div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
					{
						titleCaseRuleCards.map((card) => (
							<div class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6">
								<div>
									<div class="mb-3 flex items-center justify-between">
										<h3 class="font-sans text-[18px] font-semibold text-ink">{card.title}</h3>
										<span class="rounded-full bg-[#0f2e26]/10 px-2.5 py-0.5 text-[12px] font-medium text-[#0f2e26] dark:bg-[#afe3d0]/15 dark:text-[#afe3d0]">{card.tag}</span>
									</div>
									<p class="text-[14px] leading-relaxed text-body" set:html={localizeHtmlLinks(card.bodyHtml, locale)} />
								</div>
								<div class="mt-5 rounded-xl border border-hairline bg-canvas p-3 text-[13px] text-mute">
									<strong class="font-semibold text-ink">{t("caseConverter.page.titleCaseRules.exampleLabel")}</strong> {card.example}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Section 2C — How to Change Text Case in Microsoft Word, Excel & Google Docs -->
		<section
			id="office-shortcuts"
			aria-labelledby="office-shortcuts-heading"
			class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("caseConverter.page.officeShortcuts.badge")}
					</span>
					<h2
						id="office-shortcuts-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("caseConverter.page.officeShortcuts.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("caseConverter.page.officeShortcuts.intro")}
					</p>
				</div>

				<div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
					{
						officeShortcutCards.map((card) => (
							<div class="rounded-2xl border border-hairline bg-canvas-elevated p-6">
								<div class="flex items-center gap-3">
									<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#0f2e26] text-[15px] font-bold text-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]">
										{card.icon}
									</div>
									<h3 class="font-sans text-[18px] font-semibold text-ink">{card.title}</h3>
								</div>
								<ul class="mt-4 space-y-2.5 text-[14px] leading-relaxed text-body">
									{
										card.itemsHtml.map((itemHtml) => (
											<li class="flex items-start gap-2">
												<span class="text-[#0f2e26] dark:text-[#afe3d0]">&bull;</span>
												<span set:html={localizeHtmlLinks(itemHtml, locale)} />
											</li>
										))
									}
								</ul>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Section 3 — Where to Use Different Text & Code Case Styles (4-Card Practical Grid) -->
		<section
			id="where-to-use"
			aria-labelledby="where-to-use-heading"
			class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("caseConverter.page.whereToUse.badge")}
					</span>
					<h2
						id="where-to-use-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("caseConverter.page.whereToUse.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("caseConverter.page.whereToUse.intro")}
					</p>
				</div>

				<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{
						whereToUseCards.map((card, idx) => (
							<div class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30">
								<div>
									<div class="mb-3 inline-flex rounded-lg bg-[#0f2e26]/10 p-2.5 text-[#0f2e26] dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]">
										{idx === 0 && (
											<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
												<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
											</svg>
										)}
										{idx === 1 && (
											<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
											</svg>
										)}
										{idx === 2 && (
											<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<polyline points="16 18 22 12 16 6" />
												<polyline points="8 6 2 12 8 18" />
											</svg>
										)}
										{idx === 3 && (
											<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<circle cx="12" cy="12" r="10" />
												<line x1="2" y1="12" x2="22" y2="12" />
												<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
											</svg>
										)}
									</div>
									<h3 class="font-sans text-[16px] font-semibold text-ink">
										{card.title}
									</h3>
									<p class="mt-1 text-[12px] font-medium text-[#0f2e26] dark:text-[#afe3d0]">
										{card.subtitle}
									</p>
									<p class="mt-3 text-[14px] leading-relaxed text-body" set:html={localizeHtmlLinks(card.bodyHtml, locale)} />
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Section 4 — Frequently Asked Questions (10 PAA Accordion) -->
		<section
			id="faq"
			aria-labelledby="faq-heading"
			class="mx-auto max-w-[1200px] px-4 pt-12 pb-16 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("caseConverter.faq.badge")}
					</span>
					<h2
						id="faq-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("caseConverter.faq.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("caseConverter.faq.intro")}
					</p>
				</div>

				<div class="mt-8 divide-y divide-hairline rounded-2xl border border-hairline bg-canvas-elevated">
					{
						faqs.map((faq, idx) => (
							<details class="group p-5 sm:p-6" open={idx === 0}>
								<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-semibold text-ink focus:outline-none">
									<span>{faq.question}</span>
									<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-hairline text-mute transition-transform duration-200 group-open:rotate-45 group-open:border-[#0f2e26] group-open:bg-[#0f2e26] group-open:text-[#afe3d0] dark:group-open:border-[#afe3d0] dark:group-open:bg-[#afe3d0] dark:group-open:text-[#0f2e26]">
										<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
											<line x1="12" y1="5" x2="12" y2="19" />
											<line x1="5" y1="12" x2="19" y2="12" />
										</svg>
									</span>
								</summary>
								<p class="mt-3 pr-6 text-[14.5px] leading-relaxed text-body" set:html={localizeHtmlLinks(faq.answerHtml, locale)} />
							</details>
						))
					}
				</div>
			</div>
		</section>

		{/* Editorial Content & FAQ Slot — User Managed */}
		<div id="editorial-content-slot" class="mx-auto max-w-[1200px] px-4 sm:px-6"></div>
	</main>

	<Footer />
</Layout>
