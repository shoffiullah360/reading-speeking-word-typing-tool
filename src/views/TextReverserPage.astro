---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import TextReverserTool from "../components/TextReverserTool.astro";
import RelatedTools from "../components/RelatedTools.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";

import { getLocaleFromUrl, getLocalizedPath, localizeHtmlLinks, useTranslations } from "../i18n/ui";
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

interface FaqItem {
	question: string;
	answer: string;
	answerHtml: string;
}

interface StepCard {
	title: string;
	bodyHtml: string;
}

interface ReverseModeRow {
	name: string;
	transforms: string;
	input: string;
	output: string;
}

interface ImplementationRow {
	environment: string;
	implementation: string;
	bestUseCase: string;
}

const pageTitle = t("textReverser.title");
const pageDescription = t("textReverser.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/text-reverser/", locale));

const faqs = t.raw<FaqItem[]>("textReverser.faq.items") ?? [];
const featureList = t.raw<string[]>("textReverser.schema.featureList") ?? [];
const howToSteps = t.raw<StepCard[]>("textReverser.page.howTo.steps") ?? [];
const modesHeaders = t.raw<string[]>("textReverser.page.modes.headers") ?? [];
const reverseModes = t.raw<ReverseModeRow[]>("textReverser.page.modes.rows") ?? [];
const implementationsHeaders = t.raw<string[]>("textReverser.page.implementations.headers") ?? [];
const implementationGuides = t.raw<ImplementationRow[]>("textReverser.page.implementations.rows") ?? [];

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebApplication",
			name: t("textReverser.name"),
			url: canonicalUrl,
			inLanguage: locale,
			applicationCategory: "UtilitiesApplication",
			operatingSystem: "All",
			offers: {
				"@type": "Offer",
				price: "0",
				priceCurrency: "USD",
			},
			description: pageDescription,
			featureList,
		},
		{
			"@type": "FAQPage",
			inLanguage: locale,
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: faq.answer,
				},
			})),
		},
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					{t("textReverser.h1")}
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					{t("textReverser.page.heroSubtitle")}
				</p>
			</div>
		</section>

		<!-- Interactive Text Reverser Workspace -->
		<TextReverserTool locale={locale} />

		<!-- Topical cluster interlinking -->
		<RelatedTools toolId="text-reverser" locale={locale} />

		<!-- Section 1 — How to Use the Online Text Reverser & Flipper (4-Step Grid) -->
		<section
			id="how-to-use"
			aria-labelledby="how-to-use-heading"
			class="mx-auto max-w-[1200px] px-4 pt-8 pb-12 sm:px-6 sm:pt-10"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("textReverser.page.howTo.badge")}
					</span>
					<h2
						id="how-to-use-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("textReverser.page.howTo.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("textReverser.page.howTo.intro")}
					</p>
				</div>

				<div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
					{
						howToSteps.map((step, idx) => (
							<div
								class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
							>
								<div>
									<div class="mb-4 flex items-center gap-3">
										<span
											class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
										>
											{idx + 1}
										</span>
										<h3 class="font-sans text-[15px] font-semibold text-ink">
											{step.title}
										</h3>
									</div>
									<p class="text-[14px] leading-relaxed text-body" set:html={localizeHtmlLinks(step.bodyHtml, locale)} />
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Section 2 — All 6 Text Reversal & Flipping Modes Explained (Table + Deep Dive) -->
		<section
			id="modes-explained"
			aria-labelledby="modes-heading"
			class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("textReverser.page.modes.badge")}
					</span>
					<h2
						id="modes-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("textReverser.page.modes.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("textReverser.page.modes.intro")}
					</p>
				</div>

				<!-- Comparison Table -->
				<div class="mt-8 overflow-hidden rounded-2xl border border-hairline bg-canvas-elevated">
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse text-[14px]">
							<thead>
								<tr class="border-b border-hairline bg-[#0f2e26]/5 text-[13px] font-semibold text-ink dark:bg-[#afe3d0]/5">
									{
										modesHeaders.map((header) => (
											<th class="p-4 sm:px-6 sm:py-4">{header}</th>
										))
									}
								</tr>
							</thead>
							<tbody class="divide-y divide-hairline">
								{
									reverseModes.map((item) => (
										<tr class="transition-colors hover:bg-canvas/50">
											<td class="p-4 sm:px-6 sm:py-4 font-semibold text-ink whitespace-nowrap">
												{item.name}
											</td>
											<td class="p-4 sm:px-6 sm:py-4 text-body leading-relaxed max-w-sm">
												{item.transforms}
											</td>
											<td class="p-4 sm:px-6 sm:py-4 font-mono text-[13px] text-ink whitespace-nowrap">
												<span class="rounded bg-canvas px-2 py-1 border border-hairline">
													{item.input}
												</span>
											</td>
											<td class="p-4 sm:px-6 sm:py-4 font-mono text-[13px] text-[#0f2e26] font-semibold whitespace-nowrap dark:text-[#afe3d0]">
												<span class="rounded bg-[#afe3d0]/20 px-2 py-1 border border-[#afe3d0]/30 dark:border-[#afe3d0]/20">
													{item.output}
												</span>
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Deep-Dive Editorial Block: Unicode-Safe Reversal & RTL Scripts -->
				<div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
					<!-- Sub-block 1: Unicode & Grapheme Clusters -->
					<div class="rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:p-7">
						<div class="flex items-center gap-3">
							<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#0f2e26] text-[15px] font-bold text-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]">
								U
							</div>
							<h3 class="font-sans text-[18px] font-semibold text-ink">
								{t("textReverser.page.modes.unicodeCard.title")}
							</h3>
						</div>
						<div class="mt-4 space-y-3.5 text-[14px] leading-relaxed text-body">
							<p set:html={localizeHtmlLinks(t("textReverser.page.modes.unicodeCard.p1Html"), locale)} />
							<p set:html={localizeHtmlLinks(t("textReverser.page.modes.unicodeCard.p2Html"), locale)} />
						</div>
					</div>

					<!-- Sub-block 2: Reversed Text vs RTL Scripts -->
					<div class="rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:p-7">
						<div class="flex items-center gap-3">
							<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#0f2e26] text-[15px] font-bold text-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]">
								R
							</div>
							<h3 class="font-sans text-[18px] font-semibold text-ink">
								{t("textReverser.page.modes.rtlCard.title")}
							</h3>
						</div>
						<div class="mt-4 space-y-3.5 text-[14px] leading-relaxed text-body">
							<p set:html={localizeHtmlLinks(t("textReverser.page.modes.rtlCard.p1Html"), locale)} />
							<p set:html={localizeHtmlLinks(t("textReverser.page.modes.rtlCard.p2Html"), locale)} />
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Section 3 — How to Reverse Text in Excel, Word, JavaScript & Python (Table + Guide) -->
		<section
			id="software-implementations"
			aria-labelledby="software-implementations-heading"
			class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("textReverser.page.implementations.badge")}
					</span>
					<h2
						id="software-implementations-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("textReverser.page.implementations.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("textReverser.page.implementations.intro")}
					</p>
				</div>

				<!-- Reference Table -->
				<div class="mt-8 overflow-hidden rounded-2xl border border-hairline bg-canvas-elevated">
					<div class="overflow-x-auto">
						<table class="w-full text-left border-collapse text-[14px]">
							<thead>
								<tr class="border-b border-hairline bg-[#0f2e26]/5 text-[13px] font-semibold text-ink dark:bg-[#afe3d0]/5">
									{
										implementationsHeaders.map((header) => (
											<th class="p-4 sm:px-6 sm:py-4">{header}</th>
										))
									}
								</tr>
							</thead>
							<tbody class="divide-y divide-hairline">
								{
									implementationGuides.map((item) => (
										<tr class="transition-colors hover:bg-canvas/50">
											<td class="p-4 sm:px-6 sm:py-4 font-semibold text-ink whitespace-nowrap">
												{item.environment}
											</td>
											<td class="p-4 sm:px-6 sm:py-4 font-mono text-[13px] text-ink leading-relaxed">
												<span class="rounded bg-canvas px-2 py-1 border border-hairline inline-block">
													{item.implementation}
												</span>
											</td>
											<td class="p-4 sm:px-6 sm:py-4 text-body leading-relaxed max-w-sm">
												{item.bestUseCase}
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Practical Uses Editorial Walkthrough -->
				<div class="mt-10 rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:p-8">
					<h3 class="font-sans text-[20px] font-semibold text-ink">
						{t("textReverser.page.implementations.practicalUses.heading")}
					</h3>
					<div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-2 text-[14.5px] leading-relaxed text-body">
						<p set:html={localizeHtmlLinks(t("textReverser.page.implementations.practicalUses.p1Html"), locale)} />
						<p set:html={localizeHtmlLinks(t("textReverser.page.implementations.practicalUses.p2Html"), locale)} />
					</div>
				</div>
			</div>
		</section>

		<!-- Section 4 — Frequently Asked Questions (10 PAA Accordion) -->
		<section
			id="faq"
			aria-labelledby="faq-heading"
			class="mx-auto max-w-[1200px] px-4 pt-12 pb-16 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("textReverser.faq.badge")}
					</span>
					<h2
						id="faq-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("textReverser.faq.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("textReverser.faq.intro")}
					</p>
				</div>

				<div class="mt-8 divide-y divide-hairline rounded-2xl border border-hairline bg-canvas-elevated">
					{
						faqs.map((faq, idx) => (
							<details class="group p-5 sm:p-6" open={idx === 0}>
								<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-semibold text-ink focus:outline-none">
									<span>{faq.question}</span>
									<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-hairline text-mute transition-transform duration-200 group-open:rotate-45 group-open:border-[#0f2e26] group-open:bg-[#0f2e26] group-open:text-[#afe3d0] dark:group-open:border-[#afe3d0] dark:group-open:bg-[#afe3d0] dark:group-open:text-[#0f2e26]">
										<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
											<line x1="12" y1="5" x2="12" y2="19" />
											<line x1="5" y1="12" x2="19" y2="12" />
										</svg>
									</span>
								</summary>
								<p class="mt-3 pr-6 text-[14.5px] leading-relaxed text-body" set:html={localizeHtmlLinks(faq.answerHtml, locale)} />
							</details>
						))
					}
				</div>
			</div>
		</section>

		{/* Editorial Content & FAQ Slot — User Managed */}
		<div id="editorial-content-slot" class="mx-auto max-w-[1200px] px-4 sm:px-6"></div>
	</main>

	<Footer />
</Layout>
