---
import Layout from '../layouts/Layout.astro';
import MonkeyTypingArena from '../components/MonkeyTypingArena.astro';
import { resolveCanonicalUrl } from '../config/site';
import {
	getLocaleFromUrl,
	getLocalizedPath,
	useTranslations,
	type Locale,
} from '../i18n/ui';

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const pageTitle = t('typingSpeedTest.arena.pageTitle');
const pageDescription = t('typingSpeedTest.arena.pageDescription');
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath('/typing-speed-test/', locale));
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
	locale={locale}
>
	<Fragment slot="head">
		<meta name="robots" content="noindex, follow" />
		<link
			href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<style is:global>
			html,
			body {
				background-color: #050a08 !important;
				color: #d1fae5;
				color-scheme: dark;
			}
			::selection {
				background: rgba(0, 255, 157, 0.25);
				color: #d1fae5;
			}
		</style>
	</Fragment>

	<div class="relative flex min-h-screen flex-1 flex-col overflow-x-hidden bg-[#050a08] text-[#d1fae5]">
		<!-- Radial emerald glow -->
		<div
			aria-hidden="true"
			class="pointer-events-none fixed inset-0 z-0"
			style="background: radial-gradient(ellipse 70% 55% at 50% 38%, rgba(0,255,157,0.10), rgba(0,255,157,0.03) 45%, transparent 75%);"
		></div>
		<!-- Faint terminal grid -->
		<div
			aria-hidden="true"
			class="pointer-events-none fixed inset-0 z-0"
			style="background-image: linear-gradient(rgba(0,255,157,0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(0,255,157,0.045) 1px, transparent 1px); background-size: 44px 44px; mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 30%, transparent 85%); -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 30%, transparent 85%);"
		></div>
		<!-- Ultra-subtle scanlines -->
		<div
			aria-hidden="true"
			class="pointer-events-none fixed inset-0 z-20"
			style="background: repeating-linear-gradient(to bottom, rgba(0,0,0,0) 0, rgba(0,0,0,0) 2px, rgba(0,0,0,0.12) 3px); opacity: 0.35;"
		></div>

		<main class="relative z-10 flex min-h-screen flex-1 flex-col">
			<MonkeyTypingArena locale={locale} />
		</main>
	</div>
</Layout>
