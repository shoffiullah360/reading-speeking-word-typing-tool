---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import TextRepeaterTool from "../components/TextRepeaterTool.astro";
import RelatedTools from "../components/RelatedTools.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";

import { getLocaleFromUrl, getLocalizedPath, localizeHtmlLinks, useTranslations } from "../i18n/ui";
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

interface FaqItem {
	question: string;
	answer: string;
	answerHtml: string;
}

interface StepItem {
	title: string;
	bodyHtml: string;
}

interface SeparatorGuideRow {
	option: string;
	syntax: string;
	syntaxType: "code" | "text";
	sampleType: "multiline" | "inline";
	sampleLines?: string[];
	sampleText?: string;
	useCase: string;
}

interface PlatformLimitRow {
	platform: string;
	limit: string;
	tip: string;
	commonUse: string;
}

interface RepetitionMethodRow {
	method: string;
	snippet: string;
	isCode: boolean;
	whenToUse: string;
}

interface PracticalUseCard {
	title: string;
	subtitle: string;
	body: string;
}

const pageTitle = t("textRepeater.title");
const pageDescription = t("textRepeater.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/text-repeater/", locale));

const faqs = t.raw<FaqItem[]>("textRepeater.faq.items") ?? [];
const featureList = t.raw<string[]>("textRepeater.schema.featureList") ?? [];

const howToUseSteps = t.raw<StepItem[]>("textRepeater.page.howToUse.steps") ?? [];
const whyParagraphsHtml = t.raw<string[]>("textRepeater.page.howToUse.whyParagraphsHtml") ?? [];

const separatorHeaders = t.raw<string[]>("textRepeater.page.separatorGuide.headers") ?? [];
const separatorGuides = t.raw<SeparatorGuideRow[]>("textRepeater.page.separatorGuide.rows") ?? [];
const separatorDeepDiveHtml = t.raw<string[]>("textRepeater.page.separatorGuide.deepDiveParagraphsHtml") ?? [];

const characterLimitHeaders = t.raw<string[]>("textRepeater.page.characterLimits.headers") ?? [];
const platformLimits = t.raw<PlatformLimitRow[]>("textRepeater.page.characterLimits.rows") ?? [];
const characterLimitDeepDiveHtml = t.raw<string[]>("textRepeater.page.characterLimits.deepDiveParagraphsHtml") ?? [];

const repeatMethodHeaders = t.raw<string[]>("textRepeater.page.repeatMethods.headers") ?? [];
const repetitionMethods = t.raw<RepetitionMethodRow[]>("textRepeater.page.repeatMethods.rows") ?? [];
const repeatMethodDeepDiveHtml = t.raw<string[]>("textRepeater.page.repeatMethods.deepDiveParagraphsHtml") ?? [];

const practicalUseCards = t.raw<PracticalUseCard[]>("textRepeater.page.practicalUses.cards") ?? [];

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebApplication",
			name: t("textRepeater.name"),
			url: canonicalUrl,
			inLanguage: locale,
			applicationCategory: "UtilitiesApplication",
			operatingSystem: "All",
			offers: {
				"@type": "Offer",
				price: "0",
				priceCurrency: "USD",
			},
			description: pageDescription,
			featureList,
		},
		{
			"@type": "FAQPage",
			inLanguage: locale,
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: faq.answer,
				},
			})),
		},
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					{t("textRepeater.h1")}
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					{t("textRepeater.page.heroSubtitle")}
				</p>
			</div>
		</section>

		<!-- Interactive Text Repeater Workspace -->
		<TextRepeaterTool locale={locale} />

		<!-- Topical cluster interlinking -->
		<RelatedTools toolId="text-repeater" locale={locale} />

		<!-- Section 1 — What Is an Online Text Repeater & How to Use It (4-Step Grid) -->
		<section
			id="how-to-use"
			aria-labelledby="how-to-use-heading"
			class="mx-auto max-w-[1200px] px-4 pt-8 pb-12 sm:px-6 sm:pt-10"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("textRepeater.page.howToUse.badge")}
					</span>
					<h2
						id="how-to-use-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("textRepeater.page.howToUse.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("textRepeater.page.howToUse.intro")}
					</p>
				</div>

				<div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
					{
						howToUseSteps.map((step, idx) => (
							<div
								class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
							>
								<div>
									<div class="mb-4 flex items-center gap-3">
										<span
											class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
										>
											{idx + 1}
										</span>
										<h3 class="font-sans text-[15px] font-semibold text-ink">
											{step.title}
										</h3>
									</div>
									<p class="text-[14px] leading-relaxed text-body" set:html={localizeHtmlLinks(step.bodyHtml, locale)} />
								</div>
							</div>
						))
					}
				</div>

				<!-- Editorial Overview Block: Why Use a Browser-Based Text Repeater? -->
				<div class="mt-10 rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:p-8">
					<h3 class="font-sans text-[20px] font-semibold tracking-[-0.5px] text-ink sm:text-[22px]">
						{t("textRepeater.page.howToUse.whyTitle")}
					</h3>
					<div class="mt-4 space-y-4 text-[15px] leading-relaxed text-body">
						{
							whyParagraphsHtml.map((para) => (
								<p set:html={localizeHtmlLinks(para, locale)} />
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- Section 2A — Text Separator & Delimiter Formatting Guide -->
		<section
			id="separator-guide"
			aria-labelledby="separator-guide-heading"
			class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("textRepeater.page.separatorGuide.badge")}
					</span>
					<h2
						id="separator-guide-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("textRepeater.page.separatorGuide.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("textRepeater.page.separatorGuide.intro")}
					</p>
				</div>

				<div class="mt-8 overflow-hidden rounded-2xl border border-hairline bg-canvas-elevated">
					<div class="overflow-x-auto">
						<table class="w-full border-collapse text-left text-[14px]">
							<thead>
								<tr class="border-b border-hairline bg-[#0f2e26]/5 text-[13px] font-semibold text-ink dark:bg-[#afe3d0]/5">
									{
										separatorHeaders.map((header) => (
											<th class="p-4 sm:px-6 sm:py-4">{header}</th>
										))
									}
								</tr>
							</thead>
							<tbody class="divide-y divide-hairline">
								{
									separatorGuides.map((item) => (
										<tr class="transition-colors hover:bg-canvas/50">
											<td class="p-4 font-semibold text-ink whitespace-nowrap sm:px-6 sm:py-4">
												{item.option}
											</td>
											<td class="p-4 whitespace-nowrap sm:px-6 sm:py-4">
												{item.syntaxType === "code" ? (
													<code class="rounded border border-hairline bg-canvas px-2 py-0.5 font-mono text-[13px] text-ink">
														{item.syntax}
													</code>
												) : (
													<span class="inline-flex rounded-md border border-hairline bg-canvas px-2 py-0.5 text-[12px] font-medium text-mute">
														{item.syntax}
													</span>
												)}
											</td>
											<td class="p-4 sm:px-6 sm:py-4">
												{item.sampleType === "multiline" && item.sampleLines ? (
													<div class="inline-block rounded border border-hairline bg-canvas px-2.5 py-1.5 font-mono text-[12px] leading-tight text-ink">
														{item.sampleLines.map((line) => (
															<div>{line}</div>
														))}
													</div>
												) : (
													<span class="rounded border border-hairline bg-canvas px-2 py-1 font-mono text-[13px] text-ink">
														{item.sampleText}
													</span>
												)}
											</td>
											<td class="max-w-md p-4 leading-relaxed text-body sm:px-6 sm:py-4">
												{item.useCase}
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Deep Dive: How Delimiters, Prefixes & Auto-Numbering Work Together -->
				<div class="mt-8 rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:p-8">
					<h3 class="font-sans text-[18px] font-semibold tracking-[-0.4px] text-ink sm:text-[20px]">
						{t("textRepeater.page.separatorGuide.deepDiveTitle")}
					</h3>
					<div class="mt-4 space-y-4 text-[14.5px] leading-relaxed text-body">
						{
							separatorDeepDiveHtml.map((para) => (
								<p set:html={localizeHtmlLinks(para, locale)} />
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- Section 2B — Platform Character Limits & Safe Repetition Benchmarks -->
		<section
			id="character-limits"
			aria-labelledby="character-limits-heading"
			class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("textRepeater.page.characterLimits.badge")}
					</span>
					<h2
						id="character-limits-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("textRepeater.page.characterLimits.heading")}
					</h2>
					<p
						class="mt-2.5 text-[15px] leading-relaxed text-body"
						set:html={localizeHtmlLinks(t("textRepeater.page.characterLimits.introHtml"), locale)}
					/>
				</div>

				<div class="mt-8 overflow-hidden rounded-2xl border border-hairline bg-canvas-elevated">
					<div class="overflow-x-auto">
						<table class="w-full border-collapse text-left text-[14px]">
							<thead>
								<tr class="border-b border-hairline bg-[#0f2e26]/5 text-[13px] font-semibold text-ink dark:bg-[#afe3d0]/5">
									{
										characterLimitHeaders.map((header) => (
											<th class="p-4 sm:px-6 sm:py-4">{header}</th>
										))
									}
								</tr>
							</thead>
							<tbody class="divide-y divide-hairline">
								{
									platformLimits.map((item) => (
										<tr class="transition-colors hover:bg-canvas/50">
											<td class="p-4 font-semibold text-ink whitespace-nowrap sm:px-6 sm:py-4">
												{item.platform}
											</td>
											<td class="p-4 font-medium text-ink tabular-nums whitespace-nowrap sm:px-6 sm:py-4">
												<span class="inline-flex rounded-md border border-hairline bg-canvas px-2.5 py-1 text-[13px]">
													{item.limit}
												</span>
											</td>
											<td class="max-w-xs p-4 leading-relaxed text-body sm:px-6 sm:py-4">
												{item.tip}
											</td>
											<td class="max-w-xs p-4 leading-relaxed text-mute sm:px-6 sm:py-4">
												{item.commonUse}
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Deep Dive: Preventing Message Truncation & Mobile App Lag -->
				<div class="mt-8 rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:p-8">
					<h3 class="font-sans text-[18px] font-semibold tracking-[-0.4px] text-ink sm:text-[20px]">
						{t("textRepeater.page.characterLimits.deepDiveTitle")}
					</h3>
					<div class="mt-4 space-y-4 text-[14.5px] leading-relaxed text-body">
						{
							characterLimitDeepDiveHtml.map((para) => (
								<p set:html={localizeHtmlLinks(para, locale)} />
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- Section 2C — How to Repeat Text in Excel, Word, JavaScript & Python -->
		<section
			id="repeat-methods"
			aria-labelledby="repeat-methods-heading"
			class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("textRepeater.page.repeatMethods.badge")}
					</span>
					<h2
						id="repeat-methods-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("textRepeater.page.repeatMethods.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("textRepeater.page.repeatMethods.intro")}
					</p>
				</div>

				<div class="mt-8 overflow-hidden rounded-2xl border border-hairline bg-canvas-elevated">
					<div class="overflow-x-auto">
						<table class="w-full border-collapse text-left text-[14px]">
							<thead>
								<tr class="border-b border-hairline bg-[#0f2e26]/5 text-[13px] font-semibold text-ink dark:bg-[#afe3d0]/5">
									{
										repeatMethodHeaders.map((header) => (
											<th class="p-4 sm:px-6 sm:py-4">{header}</th>
										))
									}
								</tr>
							</thead>
							<tbody class="divide-y divide-hairline">
								{
									repetitionMethods.map((item) => (
										<tr class="transition-colors hover:bg-canvas/50">
											<td class="p-4 font-semibold text-ink whitespace-nowrap sm:px-6 sm:py-4">
												{item.method}
											</td>
											<td class="p-4 sm:px-6 sm:py-4">
												{item.isCode ? (
													<code class="rounded border border-hairline bg-canvas px-2.5 py-1 font-mono text-[13px] text-ink">
														{item.snippet}
													</code>
												) : (
													<span class="rounded border border-hairline bg-canvas px-2.5 py-1 text-[13px] font-medium text-body">
														{item.snippet}
													</span>
												)}
											</td>
											<td class="max-w-md p-4 leading-relaxed text-body sm:px-6 sm:py-4">
												{item.whenToUse}
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Deep Dive: Step-by-Step: Repeating Text in Excel & Google Sheets Without Errors -->
				<div class="mt-8 rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:p-8">
					<h3 class="font-sans text-[18px] font-semibold tracking-[-0.4px] text-ink sm:text-[20px]">
						{t("textRepeater.page.repeatMethods.deepDiveTitle")}
					</h3>
					<div class="mt-4 space-y-4 text-[14.5px] leading-relaxed text-body">
						{
							repeatMethodDeepDiveHtml.map((para) => (
								<p set:html={localizeHtmlLinks(para, locale)} />
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- Section 3 — Real-World Ways to Use an Online Text Repeater (4-Card Practical Grid) -->
		<section
			id="practical-uses"
			aria-labelledby="practical-uses-heading"
			class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("textRepeater.page.practicalUses.badge")}
					</span>
					<h2
						id="practical-uses-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("textRepeater.page.practicalUses.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("textRepeater.page.practicalUses.intro")}
					</p>
				</div>

				<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{
						practicalUseCards.map((card, idx) => (
							<div class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30">
								<div>
									<div class="mb-3 inline-flex rounded-lg bg-[#0f2e26]/10 p-2.5 text-[#0f2e26] dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]">
										{idx === 0 && (
											<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
											</svg>
										)}
										{idx === 1 && (
											<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
											</svg>
										)}
										{idx === 2 && (
											<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
												<rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
												<line x1="6" y1="6" x2="6.01" y2="6" />
												<line x1="6" y1="18" x2="6.01" y2="18" />
											</svg>
										)}
										{idx === 3 && (
											<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<line x1="8" y1="6" x2="21" y2="6" />
												<line x1="8" y1="12" x2="21" y2="12" />
												<line x1="8" y1="18" x2="21" y2="18" />
												<line x1="3" y1="6" x2="3.01" y2="6" />
												<line x1="3" y1="12" x2="3.01" y2="12" />
												<line x1="3" y1="18" x2="3.01" y2="18" />
											</svg>
										)}
									</div>
									<h3 class="font-sans text-[16px] font-semibold text-ink">
										{card.title}
									</h3>
									<p class="mt-1 text-[12px] font-medium text-[#0f2e26] dark:text-[#afe3d0]">
										{card.subtitle}
									</p>
									<p class="mt-3 text-[14px] leading-relaxed text-body">
										{card.body}
									</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Section 4 — Frequently Asked Questions (10 PAA Accordion) -->
		<section
			id="faq"
			aria-labelledby="faq-heading"
			class="mx-auto max-w-[1200px] px-4 pt-12 pb-16 sm:px-6"
		>
			<div class="border-t border-hairline pt-10 sm:pt-12">
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("textRepeater.faq.badge")}
					</span>
					<h2
						id="faq-heading"
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("textRepeater.faq.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("textRepeater.faq.subtitle")}
					</p>
				</div>

				<div class="mt-8 divide-y divide-hairline rounded-2xl border border-hairline bg-canvas-elevated">
					{
						faqs.map((faq, idx) => (
							<details class="group p-5 sm:p-6" open={idx === 0}>
								<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-semibold text-ink focus:outline-none">
									<span>{faq.question}</span>
									<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-hairline text-mute transition-transform duration-200 group-open:rotate-45 group-open:border-[#0f2e26] group-open:bg-[#0f2e26] group-open:text-[#afe3d0] dark:group-open:border-[#afe3d0] dark:group-open:bg-[#afe3d0] dark:group-open:text-[#0f2e26]">
										<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
											<line x1="12" y1="5" x2="12" y2="19" />
											<line x1="5" y1="12" x2="19" y2="12" />
										</svg>
									</span>
								</summary>
								<p class="mt-3 pr-6 text-[14.5px] leading-relaxed text-body" set:html={localizeHtmlLinks(faq.answerHtml, locale)} />
							</details>
						))
					}
				</div>
			</div>
		</section>

		{/* Editorial Content & FAQ Slot — User Managed */}
		<div id="editorial-content-slot" class="mx-auto max-w-[1200px] px-4 sm:px-6"></div>
	</main>

	<Footer />
</Layout>
