---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SpotlightTools from "../components/SpotlightTools.astro";
import {
	SITE_CONFIG,
	STANDALONE_TOOLS,
	TOOLS_REGISTRY,
	resolveCanonicalUrl,
} from "../config/site";
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "../i18n/ui";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const liveStandaloneTools = STANDALONE_TOOLS.filter((tool) => tool.status === "live");

const pageTitle = t("home.title");
const pageDescription = t("home.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/", locale));

const webSiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_CONFIG.name,
	url: canonicalUrl,
	description: pageDescription,
	inLanguage: locale,
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(webSiteSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Hero -->
		<section class="px-4 pt-14 pb-8 sm:px-6 sm:pt-20 sm:pb-10">
			<div class="mx-auto max-w-[1200px] text-center">
				<h1
					class="mx-auto max-w-3xl font-sans text-[36px] leading-[42px] font-semibold tracking-[-1.6px] text-ink sm:text-[48px] sm:leading-[52px] sm:tracking-[-2px]"
				>
					{t("home.h1")}
				</h1>

				<p
					class="mx-auto mt-4 max-w-2xl text-[17px] leading-[26px] font-normal text-body"
				>
					{t("home.subtitle")}
				</p>

				<div class="mt-7 flex flex-wrap items-center justify-center gap-3">
					<a
						href={getLocalizedPath("/reading-time-calculator/", locale)}
						class="inline-flex h-10 items-center gap-2 rounded-pill bg-primary px-5 text-[15px] font-semibold text-on-primary transition-opacity hover:opacity-90"
					>
						<span>{t("home.ctaOpen")}</span>
						<span aria-hidden="true">→</span>
					</a>
					<a
						href={getLocalizedPath("/reading-time-calculator/#benchmarks", locale)}
						class="inline-flex h-10 items-center rounded-pill border border-hairline bg-canvas-elevated px-5 text-[15px] font-medium text-ink transition-all hover:border-ink"
					>
						{t("home.ctaChart")}
					</a>
				</div>
			</div>
		</section>

		<!-- Spotlight: Random Topic Generator + Typing Speed Test -->
		<SpotlightTools locale={locale} />

		<!-- Multi-Tool Directory Grid (4 Canonical Categories) -->
		<section
			id="tools"
			aria-labelledby="directory-heading"
			class="mx-auto max-w-[1200px] px-4 py-10 sm:px-6 sm:py-14"
		>
			<div
				class="mb-8 flex flex-col justify-between gap-4 border-b border-hairline pb-5 lg:flex-row lg:items-end"
			>
				<div>
					<h2
						id="directory-heading"
						class="text-[26px] leading-[34px] font-semibold tracking-[-0.8px] text-ink sm:text-[30px] sm:leading-[38px]"
					>
						{t("home.allTools")}
					</h2>
					<p class="mt-1 text-[15px] text-body">
						{t("home.allToolsSub")}
					</p>
				</div>

				<!-- Category Filter Pills -->
				<div
					role="tablist"
					aria-label={t("home.filterLabel")}
					class="inline-flex flex-wrap items-center gap-1.5"
				>
					<button
						type="button"
						role="tab"
						aria-selected="true"
						data-category-filter="All"
						class="category-filter-btn cursor-pointer rounded-pill-category bg-primary px-4 py-1.5 text-[13px] font-semibold text-on-primary transition-all"
					>
						{t("home.filterAll")}
					</button>
					{
						SITE_CONFIG.categories.map((cat) => (
							<button
								type="button"
								role="tab"
								aria-selected="false"
								data-category-filter={cat}
								class="category-filter-btn cursor-pointer rounded-pill-category border border-hairline bg-canvas-elevated px-4 py-1.5 text-[13px] font-medium text-body transition-all hover:border-ink hover:text-ink"
							>
								{t(`common.categories.${cat}`)}
							</button>
						))
					}
				</div>
			</div>

			<!-- Tool Cards Grid (Strict Draft Protection: Only Live Tools Render <a>) -->
			<div
				id="tools-grid"
				class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3"
			>
				{
					TOOLS_REGISTRY.map((tool) =>
						tool.status === "live" ? (
							<a
								href={getLocalizedPath(tool.slug, locale)}
								data-tool-category={tool.category}
								data-tool-status="live"
								class="tool-card tool-card-live group flex flex-col justify-between rounded-md border border-[#1d463b] bg-[#0f2e26] p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-[#afe3d0] dark:border-hairline dark:bg-canvas-elevated dark:hover:border-ink"
							>
								<div>
									<div class="flex items-center justify-between gap-2">
										<span class="text-[13px] font-medium text-[#e2f5ee] dark:text-mute">
											{t(`common.categories.${tool.category}`)}
										</span>
										<span class="inline-flex items-center gap-1.5 rounded-full border border-[#1d463b] bg-[#153d33] px-2.5 py-0.5 text-[12px] font-medium text-[#afe3d0] dark:border-transparent dark:bg-hairline-soft dark:text-ink">
											<span class="inline-block h-1.5 w-1.5 rounded-full bg-[#afe3d0] dark:bg-vercel-blue" />
											{t("common.available")}
										</span>
									</div>

									<h3 class="mt-3 text-[19px] leading-[26px] font-semibold tracking-[-0.3px] text-white group-hover:text-[#afe3d0] transition-colors dark:text-ink dark:group-hover:text-vercel-blue">
										{t(`${tool.dictKey}.name`)}
									</h3>

									<p class="mt-2 text-[14px] leading-[22px] text-[#e2f5ee]/85 dark:text-body">
										{t(`${tool.dictKey}.description`)}
									</p>
								</div>

								<div class="mt-6 flex items-center justify-between border-t border-[#1d463b] pt-4 dark:border-hairline">
									<span class="text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:font-normal dark:text-mute">
										{t(`${tool.dictKey}.metric`)}
									</span>
									<span class="inline-flex items-center gap-1 rounded-full bg-[#afe3d0] px-3 py-1 text-[12px] font-semibold text-[#0f2e26] group-hover:translate-x-0.5 transition-transform dark:bg-transparent dark:p-0 dark:text-[13px] dark:font-medium dark:text-ink">
										<span>{t("common.openTool")}</span>
										<span aria-hidden="true">→</span>
									</span>
								</div>
							</a>
						) : (
							<article
								aria-disabled="true"
								data-tool-category={tool.category}
								data-tool-status="draft"
								class="tool-card flex flex-col justify-between rounded-md border border-hairline bg-canvas-muted p-6"
							>
								<div>
									<div class="flex items-center justify-between gap-2">
										<span class="text-[13px] font-medium text-mute">
											{t(`common.categories.${tool.category}`)}
										</span>
										<span class="inline-flex items-center rounded-full border border-hairline bg-canvas-elevated px-2.5 py-0.5 text-[12px] font-medium text-mute">
											{t("common.soon")}
										</span>
									</div>

									<h3 class="mt-3 text-[19px] leading-[26px] font-semibold tracking-[-0.3px] text-ink/80">
										{t(`${tool.dictKey}.name`)}
									</h3>

									<p class="mt-2 text-[14px] leading-[22px] text-body">
										{t(`${tool.dictKey}.description`)}
									</p>
								</div>

								<div class="mt-6 flex items-center justify-between border-t border-hairline pt-4">
									<span class="text-[13px] text-mute tabular-nums">
										{t(`${tool.dictKey}.metric`)}
									</span>
									<span class="text-[13px] text-mute">
										{t("common.comingSoon")}
									</span>
								</div>
							</article>
						)
					)
				}

				<!-- Root-level standalone tools belong to the Typing category -->
				{
					liveStandaloneTools.map((tool) => (
						<a
							href={tool.slug}
							data-tool-category={tool.category}
							data-tool-status="live"
							class="tool-card tool-card-live group flex flex-col justify-between rounded-md border border-[#1d463b] bg-[#0f2e26] p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-[#afe3d0] dark:border-hairline dark:bg-canvas-elevated dark:hover:border-ink"
						>
							<div>
								<div class="flex items-center justify-between gap-2">
									<span class="text-[13px] font-medium text-[#e2f5ee] dark:text-mute">
										{t(`common.categories.${tool.category}`)}
									</span>
									<span class="inline-flex items-center gap-1.5 rounded-full border border-[#1d463b] bg-[#153d33] px-2.5 py-0.5 text-[12px] font-medium text-[#afe3d0] dark:border-transparent dark:bg-hairline-soft dark:text-ink">
										<span class="inline-block h-1.5 w-1.5 rounded-full bg-[#afe3d0] dark:bg-vercel-blue" />
										{t("common.available")}
									</span>
								</div>

								<h3 class="mt-3 text-[19px] leading-[26px] font-semibold tracking-[-0.3px] text-white group-hover:text-[#afe3d0] transition-colors dark:text-ink dark:group-hover:text-vercel-blue">
									{tool.dictKey ? t(`${tool.dictKey}.shortName`) : tool.shortName}
								</h3>

								<p class="mt-2 text-[14px] leading-[22px] text-[#e2f5ee]/85 dark:text-body">
									{tool.dictKey ? t(`${tool.dictKey}.description`) : (tool.summary ?? tool.description)}
								</p>
							</div>

							<div class="mt-6 flex items-center justify-between border-t border-[#1d463b] pt-4 dark:border-hairline">
								<span class="text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:font-normal dark:text-mute">
									{tool.dictKey ? t(`${tool.dictKey}.metric`) : tool.metricPreview}
								</span>
								<span class="inline-flex items-center gap-1 rounded-full bg-[#afe3d0] px-3 py-1 text-[12px] font-semibold text-[#0f2e26] group-hover:translate-x-0.5 transition-transform dark:bg-transparent dark:p-0 dark:text-[13px] dark:font-medium dark:text-ink">
									<span>{t("common.openTool")}</span>
									<span aria-hidden="true">→</span>
								</span>
							</div>
						</a>
					))
				}
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	function initCategoryFilter() {
		const filterBtns = document.querySelectorAll<HTMLButtonElement>(
			".category-filter-btn"
		);
		const cards = document.querySelectorAll<HTMLElement>(".tool-card");

		filterBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const selectedCat = btn.dataset.categoryFilter || "All";

				filterBtns.forEach((b) => {
					const isActive = b.dataset.categoryFilter === selectedCat;
					b.setAttribute("aria-selected", isActive ? "true" : "false");
					b.className = isActive
						? "category-filter-btn cursor-pointer rounded-pill-category bg-primary px-4 py-1.5 text-[13px] font-semibold text-on-primary transition-all"
						: "category-filter-btn cursor-pointer rounded-pill-category border border-hairline bg-canvas-elevated px-4 py-1.5 text-[13px] font-medium text-body transition-all hover:border-ink hover:text-ink";
				});

				cards.forEach((card) => {
					const cardCat = card.dataset.toolCategory;
					const shouldShow =
						selectedCat === "All" || cardCat === selectedCat;
					card.classList.toggle("hidden", !shouldShow);
					card.classList.toggle("flex", shouldShow);
				});
			});
		});
	}

	initCategoryFilter();
</script>
