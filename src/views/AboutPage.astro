---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SpotlightTools from "../components/SpotlightTools.astro";
import { SITE_CONFIG, getLiveTools, resolveCanonicalUrl } from "../config/site";

import {
	getLocaleFromUrl,
	getLocalizedPath,
	localizeHtmlLinks,
	useTranslations,
} from "../i18n/ui";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

interface PrincipleItem {
	title: string;
	body: string;
}

const pageTitle = t("about.title");
const pageDescription = t("about.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/about/", locale));
const liveTools = getLiveTools();
const principles = t.raw<PrincipleItem[]>("about.page.principles") ?? [];
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Header />

	<main class="flex-1">
		<section class="mx-auto max-w-[900px] px-4 py-12 sm:px-6 sm:py-16">
			<h1 class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]">
				{t("about.h1")}
			</h1>

			<p class="mt-4 text-[17px] leading-[27px] text-body">
				{t("about.page.intro")}
			</p>

			<div class="whisper-shadow mt-8 space-y-6 rounded-md border border-hairline bg-canvas-elevated p-6 sm:p-8">
				<div>
					<h2 class="text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink">
						{t("about.page.whyHeading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-[24px] text-body">
						{t("about.page.whyP1")}
					</p>
					<p class="mt-2.5 text-[15px] leading-[24px] text-body">
						{t("about.page.whyP2")}
					</p>
				</div>

				<div class="grid grid-cols-1 gap-4 pt-2 sm:grid-cols-3">
					{
						principles.map((item) => (
							<div class="rounded-sm border border-hairline bg-canvas-muted p-4">
								<h3 class="text-[15px] font-semibold text-ink">{item.title}</h3>
								<p class="mt-1.5 text-[13px] leading-[20px] text-body">
									{item.body}
								</p>
							</div>
						))
					}
				</div>

				<div class="border-t border-hairline pt-6">
					<h2 class="text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink">
						{t("about.page.categoriesHeading")}
					</h2>
					<p class="mt-2 text-[15px] leading-[24px] text-body">
						{t("about.page.categoriesIntro")}
					</p>

					<div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
						{
							SITE_CONFIG.categories.map((cat) => {
								const toolsInCat = liveTools.filter((tool) => tool.category === cat);
								return (
									<div class="rounded-sm border border-hairline bg-canvas-elevated p-4">
										<h3 class="text-[15px] font-semibold text-ink">
											{t(`common.categories.${cat}`)}
										</h3>
										<ul class="mt-2 space-y-1.5 text-[14px]">
											{toolsInCat.map((tool) => (
												<li>
													<a
														href={getLocalizedPath(tool.slug, locale)}
														class="text-body transition-colors hover:text-vercel-blue"
													>
														{t(`${tool.dictKey}.name`)} →
													</a>
												</li>
											))}
										</ul>
									</div>
								);
							})
						}
					</div>
				</div>

				<div class="border-t border-hairline pt-6">
					<h2 class="text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink">
						{t("about.page.contactHeading")}
					</h2>
					<p
						class="mt-2 text-[15px] leading-[24px] text-body"
						set:html={localizeHtmlLinks(t("about.page.contactBodyHtml"), locale)}
					/>
				</div>
			</div>
		</section>

		<!-- Spotlight: Random Topic Generator + Typing Speed Test -->
		<SpotlightTools locale={locale} />
	</main>

	<Footer />
</Layout>
