---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ReadingSpeedTest from "../components/ReadingSpeedTest.astro";
import RelatedTools from "../components/RelatedTools.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";

import {
	getLocaleFromUrl,
	getLocalizedPath,
	localizeHtmlLinks,
	useTranslations,
} from "../i18n/ui";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const pageTitle = t("readingSpeedTest.title");
const pageDescription = t("readingSpeedTest.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/reading-speed-test/", locale));

interface HowToStep {
	title: string;
	bodyHtml: string;
}

interface ImproveTip {
	heading: string;
	bodyHtml: string;
}

interface FaqItem {
	question: string;
	answer: string;
}

const schemaFeatures = t.raw<string[]>("readingSpeedTest.page.schemaFeatures") ?? [];
const howToSteps = t.raw<HowToStep[]>("readingSpeedTest.page.howTo.steps") ?? [];
const wpmSub1Bullets = t.raw<string[]>("readingSpeedTest.page.wpmGuide.sub1BulletsHtml") ?? [];
const wpmSub2Bullets = t.raw<string[]>("readingSpeedTest.page.wpmGuide.sub2BulletsHtml") ?? [];
const avgTableHeaders = t.raw<string[]>("readingSpeedTest.page.averages.tableHeaders") ?? [];
const avgTableRows = t.raw<string[][]>("readingSpeedTest.page.averages.tableRows") ?? [];
const convBullets = t.raw<string[]>("readingSpeedTest.page.conversion.bulletsHtml") ?? [];
const convTableHeaders = t.raw<string[]>("readingSpeedTest.page.conversion.tableHeaders") ?? [];
const convTableRows = t.raw<string[][]>("readingSpeedTest.page.conversion.tableRows") ?? [];
const convSub2Bullets = t.raw<string[]>("readingSpeedTest.page.conversion.sub2BulletsHtml") ?? [];
const scienceSub1Bullets = t.raw<string[]>("readingSpeedTest.page.science.sub1BulletsHtml") ?? [];
const scienceSub2Bullets = t.raw<string[]>("readingSpeedTest.page.science.sub2BulletsHtml") ?? [];
const scienceSub3Bullets = t.raw<string[]>("readingSpeedTest.page.science.sub3BulletsHtml") ?? [];
const improveTips = t.raw<ImproveTip[]>("readingSpeedTest.page.improve.tips") ?? [];
const mythsSub1Bullets = t.raw<string[]>("readingSpeedTest.page.myths.sub1BulletsHtml") ?? [];
const mythsSub2Bullets = t.raw<string[]>("readingSpeedTest.page.myths.sub2BulletsHtml") ?? [];
const mythsSub3Bullets = t.raw<string[]>("readingSpeedTest.page.myths.sub3BulletsHtml") ?? [];
const formatsTableHeaders = t.raw<string[]>("readingSpeedTest.page.formats.tableHeaders") ?? [];
const formatsTableRows = t.raw<string[][]>("readingSpeedTest.page.formats.tableRows") ?? [];
const formatsSub2Bullets = t.raw<string[]>("readingSpeedTest.page.formats.sub2BulletsHtml") ?? [];
const faqList = t.raw<FaqItem[]>("readingSpeedTest.faq") ?? [];

const webAppSchema = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	name: t("readingSpeedTest.name"),
	url: canonicalUrl,
	inLanguage: locale,
	applicationCategory: "EducationalApplication",
	operatingSystem: "Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: schemaFeatures,
};

const faqPageSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqList.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer.replace(/<[^>]+>/g, ""),
		},
	})),
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(webAppSchema)}
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify(faqPageSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[880px] text-center">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					{t("readingSpeedTest.h1")}
				</h1>

				<p
					class="mx-auto mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					{t("readingSpeedTest.page.heroSubtitle")}
				</p>
			</div>
		</section>

		<!-- Interactive Reading Speed Test Workspace -->
		<ReadingSpeedTest locale={locale} />

		<!-- Topical cluster interlinking -->
		<RelatedTools toolId="reading-speed-test" locale={locale} maxWidthClass="max-w-[880px]" />

		<section class="mx-auto mt-10 max-w-[880px] space-y-6 border-t border-hairline px-4 pt-10 sm:px-6 md:mt-12 md:pt-12">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("readingSpeedTest.page.howTo.heading")}
			</h2>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.howTo.introHtml")}
			/>

			<ol class="grid gap-4 sm:grid-cols-2">
				{howToSteps.map((step, idx) => (
					<li class="rounded-xl border border-hairline bg-canvas-elevated p-5">
						<div class="mb-2 flex items-center gap-2.5">
							<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[12px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]">
								{idx + 1}
							</span>
							<h3 class="text-[16px] font-semibold text-ink">{step.title}</h3>
						</div>
						<p
							class="text-[14.5px] leading-relaxed text-body"
							set:html={step.bodyHtml}
						/>
					</li>
				))}
			</ol>
		</section>

		<section class="mx-auto mt-12 max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:mt-16 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("readingSpeedTest.page.wpmGuide.heading")}
			</h2>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.wpmGuide.p1Html")}
			/>

			<div class="rounded-xl border border-hairline bg-canvas-elevated px-5 py-4 text-center">
				<p class="text-[15px] font-semibold text-ink sm:text-[16px]">
					{t("readingSpeedTest.page.wpmGuide.formula1")}
				</p>
			</div>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.wpmGuide.p2Html")}
			/>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.wpmGuide.sub1Heading")}
			</h3>

			<p class="text-[16px] leading-relaxed text-body">
				{t("readingSpeedTest.page.wpmGuide.sub1P1")}
			</p>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.wpmGuide.sub1P2Html")}
			/>

			<div class="rounded-xl border border-hairline bg-canvas-elevated px-5 py-4 text-center">
				<p class="text-[15px] font-semibold text-ink sm:text-[16px]">
					{t("readingSpeedTest.page.wpmGuide.formula2")}
				</p>
			</div>

			<p class="text-[16px] leading-relaxed text-body">
				{t("readingSpeedTest.page.wpmGuide.sub1P3")}
			</p>

			<ul class="list-disc space-y-2.5 pl-6 text-[16px] leading-relaxed text-body">
				{wpmSub1Bullets.map((item) => <li set:html={item} />)}
			</ul>

			<p class="text-[16px] leading-relaxed text-body">
				{t("readingSpeedTest.page.wpmGuide.sub1P4")}
			</p>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.wpmGuide.sub2Heading")}
			</h3>

			<p class="text-[16px] leading-relaxed text-body">
				{t("readingSpeedTest.page.wpmGuide.sub2P1")}
			</p>

			<ul class="list-disc space-y-2.5 pl-6 text-[16px] leading-relaxed text-body">
				{wpmSub2Bullets.map((item) => <li set:html={item} />)}
			</ul>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={localizeHtmlLinks(t("readingSpeedTest.page.wpmGuide.sub2OutroHtml"), locale)}
			/>
		</section>

		<section class="mx-auto mt-12 max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:mt-16 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("readingSpeedTest.page.averages.heading")}
			</h2>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.averages.p1Html")}
			/>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.averages.p2Html")}
			/>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.averages.sub1Heading")}
			</h3>

			<p class="text-[16px] leading-relaxed text-body">
				{t("readingSpeedTest.page.averages.sub1P1")}
			</p>

			<div class="my-6 overflow-x-auto rounded-xl border border-hairline bg-canvas-elevated">
				<table class="w-full min-w-[600px] border-collapse text-left text-[14px]">
					<thead>
						<tr class="border-b border-hairline bg-canvas text-[13px] font-semibold text-ink">
							{avgTableHeaders.map((header) => <th class="px-4 py-3">{header}</th>)}
						</tr>
					</thead>
					<tbody class="divide-y divide-hairline text-body">
						{avgTableRows.map((row) => (
							<tr>
								<td class="px-4 py-3 font-medium text-ink">{row[0]}</td>
								<td class="px-4 py-3">{row[1]}</td>
								<td class="px-4 py-3 font-medium text-ink tabular-nums">{row[2]}</td>
								<td class="px-4 py-3">{row[3]}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.averages.sub2Heading")}
			</h3>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.averages.sub2P1Html")}
			/>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.averages.sub3Heading")}
			</h3>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.averages.sub3P1Html")}
			/>
		</section>

		<section class="mx-auto mt-12 max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:mt-16 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("readingSpeedTest.page.conversion.heading")}
			</h2>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.conversion.p1Html")}
			/>

			<p class="text-[16px] leading-relaxed text-body">
				{t("readingSpeedTest.page.conversion.p2")}
			</p>

			<ul class="list-disc space-y-2.5 pl-6 text-[16px] leading-relaxed text-body">
				{convBullets.map((item) => <li set:html={item} />)}
			</ul>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.conversion.p3Html")}
			/>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.conversion.sub1Heading")}
			</h3>

			<div class="my-6 overflow-x-auto rounded-xl border border-hairline bg-canvas-elevated">
				<table class="w-full min-w-[680px] border-collapse text-left text-[14px]">
					<thead>
						<tr class="border-b border-hairline bg-canvas text-[13px] font-semibold text-ink">
							{convTableHeaders.map((header) => <th class="px-4 py-3">{header}</th>)}
						</tr>
					</thead>
					<tbody class="divide-y divide-hairline text-body">
						{convTableRows.map((row, rowIdx) => {
							const isBenchmark = rowIdx === 3;
							return (
								<tr>
									<td class="px-4 py-3 font-medium text-ink">{row[0]}</td>
									<td
										class={
											isBenchmark
												? "px-4 py-3 font-semibold text-ink tabular-nums"
												: "px-4 py-3 font-medium text-ink tabular-nums"
										}
									>
										{row[1]}
									</td>
									<td
										class={
											isBenchmark
												? "px-4 py-3 font-medium text-ink tabular-nums"
												: "px-4 py-3 tabular-nums"
										}
									>
										{row[2]}
									</td>
									<td
										class={
											isBenchmark
												? "px-4 py-3 font-medium text-ink tabular-nums"
												: "px-4 py-3 tabular-nums"
										}
									>
										{row[3]}
									</td>
									<td
										class={
											isBenchmark
												? "px-4 py-3 font-medium text-ink tabular-nums"
												: "px-4 py-3 tabular-nums"
										}
									>
										{row[4]}
									</td>
									<td
										class={
											isBenchmark
												? "px-4 py-3 font-medium text-ink tabular-nums"
												: "px-4 py-3 tabular-nums"
										}
									>
										{row[5]}
									</td>
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.conversion.sub2Heading")}
			</h3>

			<ul class="list-disc space-y-2.5 pl-6 text-[16px] leading-relaxed text-body">
				{convSub2Bullets.map((item) => <li set:html={item} />)}
			</ul>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.conversion.sub3Heading")}
			</h3>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={localizeHtmlLinks(t("readingSpeedTest.page.conversion.sub3P1Html"), locale)}
			/>
		</section>

		<section class="mx-auto mt-12 max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:mt-16 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("readingSpeedTest.page.science.heading")}
			</h2>

			<p class="text-[16px] leading-relaxed text-body">
				{t("readingSpeedTest.page.science.p1")}
			</p>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.science.sub1Heading")}
			</h3>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.science.sub1P1Html")}
			/>

			<ul class="list-disc space-y-2.5 pl-6 text-[16px] leading-relaxed text-body">
				{scienceSub1Bullets.map((item) => <li set:html={item} />)}
			</ul>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.science.sub2Heading")}
			</h3>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.science.sub2P1Html")}
			/>

			<ul class="list-disc space-y-2.5 pl-6 text-[16px] leading-relaxed text-body">
				{scienceSub2Bullets.map((item) => <li set:html={item} />)}
			</ul>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.science.sub3Heading")}
			</h3>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.science.sub3P1Html")}
			/>

			<p class="text-[16px] leading-relaxed text-body">
				{t("readingSpeedTest.page.science.sub3P2")}
			</p>

			<ul class="list-disc space-y-2.5 pl-6 text-[16px] leading-relaxed text-body">
				{scienceSub3Bullets.map((item) => <li set:html={item} />)}
			</ul>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.science.sub4Heading")}
			</h3>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.science.sub4P1Html")}
			/>
		</section>

		<section class="mx-auto mt-12 max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:mt-16 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("readingSpeedTest.page.improve.heading")}
			</h2>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.improve.p1Html")}
			/>

			<p class="text-[16px] leading-relaxed text-body">
				{t("readingSpeedTest.page.improve.p2")}
			</p>

			{improveTips.map((tip) => (
				<>
					<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
						{tip.heading}
					</h3>
					<p
						class="text-[16px] leading-relaxed text-body"
						set:html={tip.bodyHtml}
					/>
				</>
			))}
		</section>

		<section class="mx-auto mt-12 max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:mt-16 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("readingSpeedTest.page.myths.heading")}
			</h2>

			<p class="text-[16px] leading-relaxed text-body">
				{t("readingSpeedTest.page.myths.p1")}
			</p>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.myths.sub1Heading")}
			</h3>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.myths.sub1P1Html")}
			/>

			<ul class="list-disc space-y-2.5 pl-6 text-[16px] leading-relaxed text-body">
				{mythsSub1Bullets.map((item) => <li set:html={item} />)}
			</ul>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.myths.sub2Heading")}
			</h3>

			<p class="text-[16px] leading-relaxed text-body">
				{t("readingSpeedTest.page.myths.sub2P1")}
			</p>

			<ul class="list-disc space-y-2.5 pl-6 text-[16px] leading-relaxed text-body">
				{mythsSub2Bullets.map((item) => <li set:html={item} />)}
			</ul>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.myths.sub3Heading")}
			</h3>

			<ul class="list-disc space-y-2.5 pl-6 text-[16px] leading-relaxed text-body">
				{mythsSub3Bullets.map((item) => <li set:html={item} />)}
			</ul>
		</section>

		<section class="mx-auto mt-12 max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:mt-16 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("readingSpeedTest.page.formats.heading")}
			</h2>

			<p class="text-[16px] leading-relaxed text-body">
				{t("readingSpeedTest.page.formats.p1")}
			</p>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.formats.sub1Heading")}
			</h3>

			<div class="my-6 overflow-x-auto rounded-xl border border-hairline bg-canvas-elevated">
				<table class="w-full min-w-[600px] border-collapse text-left text-[14px]">
					<thead>
						<tr class="border-b border-hairline bg-canvas text-[13px] font-semibold text-ink">
							{formatsTableHeaders.map((header) => <th class="px-4 py-3">{header}</th>)}
						</tr>
					</thead>
					<tbody class="divide-y divide-hairline text-body">
						{formatsTableRows.map((row) => (
							<tr>
								<td class="px-4 py-3 font-medium text-ink">{row[0]}</td>
								<td class="px-4 py-3 font-medium text-ink tabular-nums">{row[1]}</td>
								<td class="px-4 py-3">{row[2]}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.formats.sub2Heading")}
			</h3>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.formats.sub2P1Html")}
			/>

			<ul class="list-disc space-y-2.5 pl-6 text-[16px] leading-relaxed text-body">
				{formatsSub2Bullets.map((item) => (
					<li set:html={localizeHtmlLinks(item, locale)} />
				))}
			</ul>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("readingSpeedTest.page.formats.sub3Heading")}
			</h3>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={t("readingSpeedTest.page.formats.sub3P1Html")}
			/>
		</section>

		<section class="mx-auto mt-12 max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:mt-16 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("readingSpeedTest.page.faqHeading")}
			</h2>

			<div class="divide-y divide-hairline rounded-2xl border border-hairline bg-canvas-elevated">
				{faqList.map((item, idx) => (
					<details class="group p-5 sm:p-6" open={idx === 0}>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-semibold text-ink">
							<span>{item.question}</span>
							<span class="text-muted transition-transform duration-200 group-open:rotate-45">+</span>
						</summary>
						<p
							class="mt-3 text-[15px] leading-relaxed text-body"
							set:html={item.answer}
						/>
					</details>
				))}
			</div>
		</section>
	</main>

	<Footer />
</Layout>
