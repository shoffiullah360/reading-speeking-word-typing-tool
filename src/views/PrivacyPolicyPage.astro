---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";

import {
	getLocaleFromUrl,
	getLocalizedPath,
	localizeHtmlLinks,
	useTranslations,
} from "../i18n/ui";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const pageTitle = t("privacy.title");
const pageDescription = t("privacy.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/privacy-policy/", locale));
const cookiesItems = t.raw<string[]>("privacy.page.sections.cookiesAds.itemsHtml") ?? [];
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Header />

	<main class="flex-1">
		<section class="mx-auto max-w-[900px] px-4 py-12 sm:px-6 sm:py-16">
			<h1 class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]">
				{t("privacy.h1")}
			</h1>
			<p class="mt-2 text-[14px] text-mute">
				{t("privacy.page.lastUpdated")}
			</p>

			<div class="whisper-shadow mt-8 space-y-6 rounded-md border border-hairline bg-canvas-elevated p-6 text-[15px] leading-[24px] text-body sm:p-8">
				<div>
					<h2 class="text-[19px] leading-[26px] font-semibold text-ink">
						{t("privacy.page.sections.localProcessing.heading")}
					</h2>
					<p
						class="mt-2"
						set:html={localizeHtmlLinks(t("privacy.page.sections.localProcessing.p1Html"), locale)}
					/>
					<p
						class="mt-2"
						set:html={t("privacy.page.sections.localProcessing.p2Html")}
					/>
				</div>

				<div class="border-t border-hairline pt-6">
					<h2 class="text-[19px] leading-[26px] font-semibold text-ink">
						{t("privacy.page.sections.localStorage.heading")}
					</h2>
					<p
						class="mt-2"
						set:html={t("privacy.page.sections.localStorage.bodyHtml")}
					/>
				</div>

				<div class="border-t border-hairline pt-6">
					<h2 class="text-[19px] leading-[26px] font-semibold text-ink">
						{t("privacy.page.sections.cookiesAds.heading")}
					</h2>
					<p class="mt-2">
						{t("privacy.page.sections.cookiesAds.intro")}
					</p>
					<ul class="mt-2.5 list-disc space-y-2 pl-5">
						{
							cookiesItems.map((itemHtml) => (
								<li set:html={localizeHtmlLinks(itemHtml, locale)} />
							))
						}
					</ul>
				</div>

				<div class="border-t border-hairline pt-6">
					<h2 class="text-[19px] leading-[26px] font-semibold text-ink">
						{t("privacy.page.sections.logsAnalytics.heading")}
					</h2>
					<p class="mt-2">
						{t("privacy.page.sections.logsAnalytics.body")}
					</p>
				</div>

				<div class="border-t border-hairline pt-6">
					<h2 class="text-[19px] leading-[26px] font-semibold text-ink">
						{t("privacy.page.sections.contact.heading")}
					</h2>
					<p
						class="mt-2"
						set:html={localizeHtmlLinks(t("privacy.page.sections.contact.bodyHtml"), locale)}
					/>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
