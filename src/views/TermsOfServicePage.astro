---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";

import {
	getLocaleFromUrl,
	getLocalizedPath,
	localizeHtmlLinks,
	useTranslations,
} from "../i18n/ui";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const pageTitle = t("terms.title");
const pageDescription = t("terms.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/terms-of-service/", locale));
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Header />

	<main class="flex-1">
		<section class="mx-auto max-w-[900px] px-4 py-12 sm:px-6 sm:py-16">
			<h1 class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]">
				{t("terms.h1")}
			</h1>
			<p class="mt-2 text-[14px] text-mute">
				{t("terms.page.lastUpdated")}
			</p>

			<div class="whisper-shadow mt-8 space-y-6 rounded-md border border-hairline bg-canvas-elevated p-6 text-[15px] leading-[24px] text-body sm:p-8">
				<div>
					<h2 class="text-[19px] leading-[26px] font-semibold text-ink">
						{t("terms.page.sections.acceptance.heading")}
					</h2>
					<p
						class="mt-2"
						set:html={localizeHtmlLinks(t("terms.page.sections.acceptance.bodyHtml"), locale)}
					/>
				</div>

				<div class="border-t border-hairline pt-6">
					<h2 class="text-[19px] leading-[26px] font-semibold text-ink">
						{t("terms.page.sections.ownership.heading")}
					</h2>
					<p class="mt-2">
						{t("terms.page.sections.ownership.body")}
					</p>
				</div>

				<div class="border-t border-hairline pt-6">
					<h2 class="text-[19px] leading-[26px] font-semibold text-ink">
						{t("terms.page.sections.acceptableUse.heading")}
					</h2>
					<p
						class="mt-2"
						set:html={localizeHtmlLinks(t("terms.page.sections.acceptableUse.bodyHtml"), locale)}
					/>
				</div>

				<div class="border-t border-hairline pt-6">
					<h2 class="text-[19px] leading-[26px] font-semibold text-ink">
						{t("terms.page.sections.disclaimer.heading")}
					</h2>
					<p class="mt-2">
						{t("terms.page.sections.disclaimer.body")}
					</p>
				</div>

				<div class="border-t border-hairline pt-6">
					<h2 class="text-[19px] leading-[26px] font-semibold text-ink">
						{t("terms.page.sections.contact.heading")}
					</h2>
					<p
						class="mt-2"
						set:html={localizeHtmlLinks(t("terms.page.sections.contact.bodyHtml"), locale)}
					/>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
