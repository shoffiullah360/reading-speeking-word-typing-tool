---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import RandomTopicGenerator from "../components/RandomTopicGenerator.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";

import { getLocaleFromUrl, getLocalizedPath, localizeHtmlLinks, useTranslations } from "../i18n/ui";
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const pageTitle = t("randomTopicGenerator.title");
const pageDescription = t("randomTopicGenerator.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/random-topic-generator/", locale));

interface FaqItem {
	question: string;
	answer: string;
}

interface HowToStep {
	title: string;
	bodyHtml: string;
}

interface PracticalCard {
	badge: string;
	title: string;
	description: string;
}

interface FrameworkItem {
	letter: string;
	label: string;
	text: string;
}

interface AudienceCard {
	title: string;
	description: string;
}

interface RelatedToolCard {
	slug: string;
	categoryKey: string;
	title: string;
	description: string;
	cta: string;
}

const faqs = t.raw<FaqItem[]>("randomTopicGenerator.faq") ?? [];
const schemaFeatures = t.raw<string[]>("randomTopicGenerator.page.schemaFeatures") ?? [];
const howToSteps = t.raw<HowToStep[]>("randomTopicGenerator.page.howToUse.steps") ?? [];
const practicalCards = t.raw<PracticalCard[]>("randomTopicGenerator.page.practicalWays.cards") ?? [];
const speechListItems = t.raw<string[]>("randomTopicGenerator.page.curatedLists.speechList.items") ?? [];
const debateListItems = t.raw<string[]>("randomTopicGenerator.page.curatedLists.debateList.items") ?? [];
const socialListItems = t.raw<string[]>("randomTopicGenerator.page.curatedLists.socialList.items") ?? [];
const singleWordListWords = t.raw<string[]>("randomTopicGenerator.page.curatedLists.singleWordList.words") ?? [];
const prepItems = t.raw<FrameworkItem[]>("randomTopicGenerator.page.frameworks.prep.items") ?? [];
const peelItems = t.raw<FrameworkItem[]>("randomTopicGenerator.page.frameworks.peel.items") ?? [];
const audienceCards = t.raw<AudienceCard[]>("randomTopicGenerator.page.audience.cards") ?? [];
const relatedCards = t.raw<RelatedToolCard[]>("randomTopicGenerator.page.relatedTools.cards") ?? [];

const jsonLdSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebApplication",
			name: t("randomTopicGenerator.name"),
			url: canonicalUrl,
			inLanguage: locale,
			applicationCategory: "EducationalApplication",
			operatingSystem: "Any",
			offers: {
				"@type": "Offer",
				price: "0",
				priceCurrency: "USD",
			},
			description: pageDescription,
			featureList: schemaFeatures,
		},
		{
			"@type": "FAQPage",
			inLanguage: locale,
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: faq.answer,
				},
			})),
		},
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(jsonLdSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					{t("randomTopicGenerator.h1")}
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					{t("randomTopicGenerator.page.subtitle")}
				</p>
			</div>
		</section>

		<!-- Interactive Random Topic Generator Workspace -->
		<RandomTopicGenerator locale={locale} />

		<!-- Section 1: How to Use the Random Topic Generator (Clean 4-Step Grid) -->
		<section
			aria-labelledby="how-to-use-heading"
			class="mx-auto max-w-[1200px] space-y-6 border-t border-hairline px-4 pt-10 pb-12 sm:px-6 md:mt-12 md:pt-12"
		>
			<h2
				id="how-to-use-heading"
				class="text-2xl font-bold tracking-tight text-ink sm:text-3xl"
			>
				{t("randomTopicGenerator.page.howToUse.heading")}
			</h2>

			<p class="max-w-3xl text-[16px] leading-relaxed text-body">
				{t("randomTopicGenerator.page.howToUse.intro")}
			</p>

			<ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					howToSteps.map((step, idx) => (
						<li class="flex flex-col rounded-xl border border-hairline bg-canvas-elevated p-5">
							<div class="mb-3 flex items-center gap-2.5">
								<span
									class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
								>
									{idx + 1}
								</span>
								<h3 class="text-[16px] font-semibold text-ink">
									{step.title}
								</h3>
							</div>
							<p class="text-[14px] leading-relaxed text-body" set:html={step.bodyHtml} />
						</li>
					))
				}
			</ol>
		</section>

		<!-- Section 2: 6 Practical Ways to Use a Random Topic Generator (Clean 2x3 Card Grid) -->
		<section
			aria-labelledby="practical-ways-heading"
			class="mx-auto max-w-[1200px] space-y-6 border-t border-hairline px-4 pt-10 pb-16 sm:px-6 md:mt-12 md:pt-12"
		>
			<h2
				id="practical-ways-heading"
				class="text-2xl font-bold tracking-tight text-ink sm:text-3xl"
			>
				{t("randomTopicGenerator.page.practicalWays.heading")}
			</h2>

			<p class="max-w-3xl text-[16px] leading-relaxed text-body">
				{t("randomTopicGenerator.page.practicalWays.intro")}
			</p>

			<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
				{
					practicalCards.map((card) => (
						<div class="flex flex-col justify-between rounded-xl border border-hairline bg-canvas-elevated p-5 sm:p-6 space-y-3">
							<div>
								<span class="inline-flex items-center rounded-full border border-[#7ED4B6] bg-[#AFE3D0] px-2.5 py-0.5 text-[12px] font-semibold text-[#0f2e26] dark:border-hairline dark:bg-canvas dark:text-ink">
									{card.badge}
								</span>
								<h3 class="mt-3 text-lg font-semibold tracking-tight text-ink">
									{card.title}
								</h3>
								<p class="mt-2 text-[14.5px] leading-relaxed text-body">
									{card.description}
								</p>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- Section 3: Curated Ready-to-Use Topic Lists (Clean 2x2 Card Grid) -->
		<section
			aria-labelledby="curated-lists-heading"
			class="mx-auto max-w-[1200px] space-y-6 border-t border-hairline px-4 pt-10 pb-16 sm:px-6 md:mt-12 md:pt-12"
		>
			<h2
				id="curated-lists-heading"
				class="text-2xl font-bold tracking-tight text-ink sm:text-3xl"
			>
				{t("randomTopicGenerator.page.curatedLists.heading")}
			</h2>

			<p class="max-w-3xl text-[16px] leading-relaxed text-body">
				{t("randomTopicGenerator.page.curatedLists.intro")}
			</p>

			<div class="grid gap-6 md:grid-cols-2">
				<!-- List 1: 10 Topics for a 1-Minute Impromptu Speech -->
				<div class="flex flex-col rounded-xl border border-hairline bg-canvas-elevated p-5 sm:p-6 space-y-4">
					<div class="flex items-center justify-between gap-2 border-b border-hairline pb-3">
						<h3 class="text-lg font-semibold tracking-tight text-ink">
							{t("randomTopicGenerator.page.curatedLists.speechList.title")}
						</h3>
						<span class="inline-flex shrink-0 items-center rounded-full border border-[#7ED4B6] bg-[#AFE3D0] px-2.5 py-0.5 text-[12px] font-semibold text-[#0f2e26] dark:border-hairline dark:bg-canvas dark:text-ink">
							{t("randomTopicGenerator.page.curatedLists.speechList.badge")}
						</span>
					</div>

					<ol class="space-y-2.5 pl-5 list-decimal text-[14px] leading-relaxed text-body marker:font-medium marker:text-mute">
						{speechListItems.map((item) => <li>{item}</li>)}
					</ol>
				</div>

				<!-- List 2: 10 Balanced Essay & Debate Prompts -->
				<div class="flex flex-col rounded-xl border border-hairline bg-canvas-elevated p-5 sm:p-6 space-y-4">
					<div class="flex items-center justify-between gap-2 border-b border-hairline pb-3">
						<h3 class="text-lg font-semibold tracking-tight text-ink">
							{t("randomTopicGenerator.page.curatedLists.debateList.title")}
						</h3>
						<span class="inline-flex shrink-0 items-center rounded-full border border-[#7ED4B6] bg-[#AFE3D0] px-2.5 py-0.5 text-[12px] font-semibold text-[#0f2e26] dark:border-hairline dark:bg-canvas dark:text-ink">
							{t("randomTopicGenerator.page.curatedLists.debateList.badge")}
						</span>
					</div>

					<ol class="space-y-2.5 pl-5 list-decimal text-[14px] leading-relaxed text-body marker:font-medium marker:text-mute">
						{debateListItems.map((item) => <li>{item}</li>)}
					</ol>
				</div>

				<!-- List 3: 10 Deep & Funny Conversation Questions -->
				<div class="flex flex-col rounded-xl border border-hairline bg-canvas-elevated p-5 sm:p-6 space-y-4">
					<div class="flex items-center justify-between gap-2 border-b border-hairline pb-3">
						<h3 class="text-lg font-semibold tracking-tight text-ink">
							{t("randomTopicGenerator.page.curatedLists.socialList.title")}
						</h3>
						<span class="inline-flex shrink-0 items-center rounded-full border border-[#7ED4B6] bg-[#AFE3D0] px-2.5 py-0.5 text-[12px] font-semibold text-[#0f2e26] dark:border-hairline dark:bg-canvas dark:text-ink">
							{t("randomTopicGenerator.page.curatedLists.socialList.badge")}
						</span>
					</div>

					<ol class="space-y-2.5 pl-5 list-decimal text-[14px] leading-relaxed text-body marker:font-medium marker:text-mute">
						{socialListItems.map((item) => <li>{item}</li>)}
					</ol>
				</div>

				<!-- List 4: 20 Single-Word Prompts -->
				<div class="flex flex-col rounded-xl border border-hairline bg-canvas-elevated p-5 sm:p-6 space-y-4">
					<div class="flex items-center justify-between gap-2 border-b border-hairline pb-3">
						<h3 class="text-lg font-semibold tracking-tight text-ink">
							{t("randomTopicGenerator.page.curatedLists.singleWordList.title")}
						</h3>
						<span class="inline-flex shrink-0 items-center rounded-full border border-[#7ED4B6] bg-[#AFE3D0] px-2.5 py-0.5 text-[12px] font-semibold text-[#0f2e26] dark:border-hairline dark:bg-canvas dark:text-ink">
							{t("randomTopicGenerator.page.curatedLists.singleWordList.badge")}
						</span>
					</div>

					<p class="text-[13.5px] leading-relaxed text-body">
						{t("randomTopicGenerator.page.curatedLists.singleWordList.intro")}
					</p>

					<div class="flex flex-wrap gap-2 pt-1">
						{
							singleWordListWords.map((word) => (
								<span class="inline-flex items-center rounded-full border border-hairline bg-canvas px-3 py-1 text-[13px] font-medium text-ink transition-colors hover:border-[#7ED4B6] dark:hover:border-ink">
									{word}
								</span>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- Section 4: How to Structure an Impromptu Speech or Essay (2-Column Framework Cards) -->
		<section
			aria-labelledby="frameworks-heading"
			class="mx-auto max-w-[1200px] space-y-6 border-t border-hairline px-4 pt-10 pb-12 sm:px-6 md:mt-12 md:pt-12"
		>
			<h2
				id="frameworks-heading"
				class="text-2xl font-bold tracking-tight text-ink sm:text-3xl"
			>
				{t("randomTopicGenerator.page.frameworks.heading")}
			</h2>

			<p class="max-w-3xl text-[16px] leading-relaxed text-body">
				{t("randomTopicGenerator.page.frameworks.intro")}
			</p>

			<div class="grid gap-6 md:grid-cols-2">
				<!-- Card 1: The PREP Framework -->
				<div class="flex flex-col justify-between rounded-xl border border-hairline bg-canvas-elevated p-5 sm:p-6 space-y-4">
					<div>
						<div class="flex items-center justify-between gap-2 border-b border-hairline pb-3">
							<h3 class="text-lg font-semibold tracking-tight text-ink">
								{t("randomTopicGenerator.page.frameworks.prep.title")}
							</h3>
							<span class="inline-flex shrink-0 items-center rounded-full border border-[#7ED4B6] bg-[#AFE3D0] px-2.5 py-0.5 text-[12px] font-semibold text-[#0f2e26] dark:border-hairline dark:bg-canvas dark:text-ink">
								{t("randomTopicGenerator.page.frameworks.prep.badge")}
							</span>
						</div>

						<ul class="mt-4 space-y-3 text-[14px] leading-relaxed text-body">
							{
								prepItems.map((item) => (
									<li class="flex items-start gap-2.5">
										<span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[11px] font-bold text-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]">
											{item.letter}
										</span>
										<span>
											<strong class="font-semibold text-ink">{item.label}</strong> {item.text}
										</span>
									</li>
								))
							}
						</ul>
					</div>

					<p
						class="mt-4 rounded-md border border-hairline bg-canvas p-3 text-[13.5px] leading-relaxed text-body"
						set:html={localizeHtmlLinks(t("randomTopicGenerator.page.frameworks.prep.tipHtml"), locale)}
					/>
				</div>

				<!-- Card 2: The PEEL Framework -->
				<div class="flex flex-col justify-between rounded-xl border border-hairline bg-canvas-elevated p-5 sm:p-6 space-y-4">
					<div>
						<div class="flex items-center justify-between gap-2 border-b border-hairline pb-3">
							<h3 class="text-lg font-semibold tracking-tight text-ink">
								{t("randomTopicGenerator.page.frameworks.peel.title")}
							</h3>
							<span class="inline-flex shrink-0 items-center rounded-full border border-[#7ED4B6] bg-[#AFE3D0] px-2.5 py-0.5 text-[12px] font-semibold text-[#0f2e26] dark:border-hairline dark:bg-canvas dark:text-ink">
								{t("randomTopicGenerator.page.frameworks.peel.badge")}
							</span>
						</div>

						<ul class="mt-4 space-y-3 text-[14px] leading-relaxed text-body">
							{
								peelItems.map((item) => (
									<li class="flex items-start gap-2.5">
										<span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[11px] font-bold text-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]">
											{item.letter}
										</span>
										<span>
											<strong class="font-semibold text-ink">{item.label}</strong> {item.text}
										</span>
									</li>
								))
							}
						</ul>
					</div>

					<p
						class="mt-4 rounded-md border border-hairline bg-canvas p-3 text-[13.5px] leading-relaxed text-body"
						set:html={localizeHtmlLinks(t("randomTopicGenerator.page.frameworks.peel.tipHtml"), locale)}
					/>
				</div>
			</div>
		</section>

		<!-- Section 5: Who Uses Wordora's Random Topic Generator? + Related Tools -->
		<section
			aria-labelledby="audience-heading"
			class="mx-auto max-w-[1200px] space-y-10 border-t border-hairline px-4 pt-10 pb-16 sm:px-6 md:mt-12 md:pt-12"
		>
			<div class="space-y-6">
				<h2
					id="audience-heading"
					class="text-2xl font-bold tracking-tight text-ink sm:text-3xl"
				>
					{t("randomTopicGenerator.page.audience.heading")}
				</h2>

				<p class="max-w-3xl text-[16px] leading-relaxed text-body">
					{t("randomTopicGenerator.page.audience.intro")}
				</p>

				<!-- Compact 3x2 Audience Grid -->
				<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{
						audienceCards.map((card) => (
							<div class="rounded-xl border border-hairline bg-canvas-elevated p-5">
								<h3 class="text-[16px] font-semibold text-ink">
									{card.title}
								</h3>
								<p class="mt-2 text-[14px] leading-relaxed text-body">
									{card.description}
								</p>
							</div>
						))
					}
				</div>
			</div>

			<!-- Related Wordora Tools Strip (4 Clean Internal Link Cards) -->
			<div class="space-y-6 border-t border-hairline pt-10">
				<div>
					<h3 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">
						{t("randomTopicGenerator.page.relatedTools.heading")}
					</h3>
					<p class="mt-1 text-[15px] text-body">
						{t("randomTopicGenerator.page.relatedTools.subtitle")}
					</p>
				</div>

				<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
					{
						relatedCards.map((card) => (
							<a
								href={getLocalizedPath(card.slug, locale)}
								class="group flex flex-col justify-between rounded-xl border border-hairline bg-canvas-elevated p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-ink"
							>
								<div>
									<div class="flex items-center justify-between gap-2">
										<span class="text-[12px] font-medium text-mute">
											{t(`common.categories.${card.categoryKey}`)}
										</span>
										<span class="inline-flex items-center rounded-full border border-[#7ED4B6] bg-[#AFE3D0] px-2 py-0.5 text-[11px] font-semibold text-[#111827] dark:border-hairline dark:bg-canvas dark:text-ink">
											{t("randomTopicGenerator.page.relatedTools.utilityBadge")}
										</span>
									</div>
									<h4 class="mt-3 text-[16px] font-semibold tracking-tight text-ink group-hover:text-[#0D9488] dark:group-hover:text-[#AFE3D0] transition-colors">
										{card.title}
									</h4>
									<p class="mt-2 text-[13.5px] leading-relaxed text-body">
										{card.description}
									</p>
								</div>
								<span class="mt-4 inline-flex items-center gap-1 text-[13px] font-medium text-[#0D9488] group-hover:underline dark:text-[#AFE3D0]">
									{card.cta} &rarr;
								</span>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<!-- Section 6: Frequently Asked Questions (10 High-Intent PAA Questions) -->
		<section
			id="faq"
			aria-labelledby="faq-heading"
			class="mx-auto max-w-[1200px] space-y-6 border-t border-hairline px-4 pt-10 pb-16 sm:px-6 md:mt-12 md:pt-12"
		>
			<h2
				id="faq-heading"
				class="text-2xl font-bold tracking-tight text-ink sm:text-3xl"
			>
				{t("randomTopicGenerator.page.faqSection.heading")}
			</h2>

			<p class="max-w-3xl text-[16px] leading-relaxed text-body">
				{t("randomTopicGenerator.page.faqSection.intro")}
			</p>

			<div class="divide-y divide-hairline rounded-xl border border-hairline bg-canvas-elevated">
				{
					faqs.map((faq, idx) => (
						<details class="group p-5 sm:p-6" open={idx === 0}>
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-semibold text-ink focus:outline-none">
								<span>{faq.question}</span>
								<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-hairline text-mute transition-transform duration-200 group-open:rotate-45 group-open:border-[#7ED4B6] group-open:bg-[#AFE3D0] group-open:text-[#111827] dark:group-open:border-hairline dark:group-open:bg-canvas dark:group-open:text-ink">
									<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
										<line x1="12" y1="5" x2="12" y2="19" />
										<line x1="5" y1="12" x2="19" y2="12" />
									</svg>
								</span>
							</summary>
							<p class="mt-3 pr-6 text-[14.5px] leading-relaxed text-body">
								{faq.answer}
							</p>
						</details>
					))
				}
			</div>
		</section>

		{/* Editorial Content & FAQ Slot — User Managed */}
	</main>

	<Footer />
</Layout>
