---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import AudiobookCalculator from "../components/AudiobookCalculator.astro";
import RelatedTools from "../components/RelatedTools.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";

import { getLocaleFromUrl, getLocalizedPath, localizeHtmlLinks, useTranslations } from "../i18n/ui";
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

interface StepItem {
	title: string;
	bodyHtml: string;
}

interface LookupRow {
	cells: string[];
	highlightCol?: number;
}

interface FaqItem {
	question: string;
	answer: string;
	answerHtml: string;
}

const pageTitle = t("audiobookCalculator.title");
const pageDescription = t("audiobookCalculator.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/audiobook-speed-calculator/", locale));

const schemaFeatures = t.raw<string[]>("audiobookCalculator.page.schemaFeatures") ?? [];
const guideSteps = t.raw<StepItem[]>("audiobookCalculator.page.guide.steps") ?? [];
const multiplierHeaders = t.raw<string[]>("audiobookCalculator.page.speedChart.multiplierHeaders") ?? [];
const multiplierRows = t.raw<string[][]>("audiobookCalculator.page.speedChart.multiplierRows") ?? [];
const lookupHeaders = t.raw<string[]>("audiobookCalculator.page.speedChart.lookupHeaders") ?? [];
const lookupRows = t.raw<LookupRow[]>("audiobookCalculator.page.speedChart.lookupRows") ?? [];
const lengthHeaders = t.raw<string[]>("audiobookCalculator.page.lengthConverter.headers") ?? [];
const lengthRows = t.raw<string[][]>("audiobookCalculator.page.lengthConverter.rows") ?? [];
const spotifyParagraphsHtml = t.raw<string[]>("audiobookCalculator.page.platforms.spotifyParagraphsHtml") ?? [];
const audibleParagraphsHtml = t.raw<string[]>("audiobookCalculator.page.platforms.audibleParagraphsHtml") ?? [];
const audibleBulletsHtml = t.raw<string[]>("audiobookCalculator.page.platforms.audibleBulletsHtml") ?? [];
const comprehensionSteps = t.raw<StepItem[]>("audiobookCalculator.page.comprehension.steps") ?? [];
const faqList = t.raw<FaqItem[]>("audiobookCalculator.faq.items") ?? [];

const webAppSchema = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	name: t("audiobookCalculator.name"),
	url: canonicalUrl,
	inLanguage: locale,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: schemaFeatures,
};

const faqPageSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqList.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer,
		},
	})),
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(webAppSchema)}
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify(faqPageSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					{t("audiobookCalculator.h1")}
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					{t("audiobookCalculator.page.heroSubtitle")}
				</p>
			</div>
		</section>

		<!-- Interactive Audiobook Calculator Workspace -->
		<AudiobookCalculator locale={locale} />

		<!-- Topical cluster interlinking -->
		<RelatedTools toolId="audiobook-speed-calculator" locale={locale} maxWidthClass="max-w-[880px]" />

		<!-- Section 1: Editorial Guide -->
		<section class="mx-auto mt-10 max-w-[880px] space-y-6 border-t border-hairline px-4 pt-10 pb-16 sm:px-6 md:mt-12 md:pt-12">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("audiobookCalculator.page.guide.title")}
			</h2>

			<p class="text-[16px] leading-relaxed text-body" set:html={localizeHtmlLinks(t("audiobookCalculator.page.guide.p1Html"), locale)} />

			<p class="text-[16px] leading-relaxed text-body" set:html={localizeHtmlLinks(t("audiobookCalculator.page.guide.p2Html"), locale)} />

			<!-- Formula Callout Box -->
			<div class="rounded-xl border border-hairline bg-canvas-elevated px-5 py-4 space-y-2.5 text-center">
				<p class="text-[15px] font-semibold text-ink sm:text-[16px] tabular-nums">
					{t("audiobookCalculator.page.guide.formula1")}
				</p>
				<p class="text-[15px] font-semibold text-ink sm:text-[16px] tabular-nums">
					{t("audiobookCalculator.page.guide.formula2")}
				</p>
			</div>

			<ol class="grid gap-4 sm:grid-cols-3">
				{
					guideSteps.map((step, idx) => (
						<li class="rounded-xl border border-hairline bg-canvas-elevated p-5">
							<div class="mb-2 flex items-center gap-2.5">
								<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[12px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]">{idx + 1}</span>
								<h3 class="text-[16px] font-semibold text-ink">{step.title}</h3>
							</div>
							<p class="text-[14.5px] leading-relaxed text-body" set:html={localizeHtmlLinks(step.bodyHtml, locale)} />
						</li>
					))
				}
			</ol>
		</section>

		<!-- Section 2: Audiobook Playback Speed Chart & Common Listening Time Cheat Sheet -->
		<section class="mx-auto max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("audiobookCalculator.page.speedChart.title")}
			</h2>

			<p class="text-[16px] leading-relaxed text-body" set:html={localizeHtmlLinks(t("audiobookCalculator.page.speedChart.introHtml"), locale)} />

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("audiobookCalculator.page.speedChart.multiplierTableTitle")}
			</h3>

			<div class="my-6 overflow-x-auto rounded-xl border border-hairline bg-canvas-elevated">
				<table class="w-full min-w-[640px] border-collapse text-left text-[14px]">
					<thead>
						<tr class="border-b border-hairline bg-canvas text-[13px] font-semibold text-ink">
							{multiplierHeaders.map((header) => <th class="px-4 py-3">{header}</th>)}
						</tr>
					</thead>
					<tbody class="divide-y divide-hairline text-body">
						{
							multiplierRows.map((row) => (
								<tr>
									<td class="px-4 py-3 font-medium text-ink tabular-nums">{row[0]}</td>
									<td class="px-4 py-3 tabular-nums">{row[1]}</td>
									<td class="px-4 py-3 tabular-nums">{row[2]}</td>
									<td class="px-4 py-3 font-medium text-ink tabular-nums">{row[3]}</td>
									<td class="px-4 py-3">{row[4]}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("audiobookCalculator.page.speedChart.lookupTableTitle")}
			</h3>

			<div class="my-6 overflow-x-auto rounded-xl border border-hairline bg-canvas-elevated">
				<table class="w-full min-w-[640px] border-collapse text-left text-[14px]">
					<thead>
						<tr class="border-b border-hairline bg-canvas text-[13px] font-semibold text-ink">
							{lookupHeaders.map((header) => <th class="px-4 py-3">{header}</th>)}
						</tr>
					</thead>
					<tbody class="divide-y divide-hairline text-body">
						{
							lookupRows.map((row) => (
								<tr>
									{row.cells.map((cell, colIdx) => (
										<td
											class={`px-4 py-3 tabular-nums ${
												colIdx === 0 || colIdx === row.highlightCol ? "font-medium text-ink" : ""
											}`}
										>
											{cell}
										</td>
									))}
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<!-- Section 3: Audiobook Length to Word Count & Print Pages Converter -->
		<section class="mx-auto max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("audiobookCalculator.page.lengthConverter.title")}
			</h2>

			<p class="text-[16px] leading-relaxed text-body" set:html={localizeHtmlLinks(t("audiobookCalculator.page.lengthConverter.p1Html"), locale)} />

			<p class="text-[16px] leading-relaxed text-body" set:html={localizeHtmlLinks(t("audiobookCalculator.page.lengthConverter.p2Html"), locale)} />

			<p class="text-[16px] leading-relaxed text-body" set:html={localizeHtmlLinks(t("audiobookCalculator.page.lengthConverter.p3Html"), locale)} />

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("audiobookCalculator.page.lengthConverter.tableTitle")}
			</h3>

			<div class="my-6 overflow-x-auto rounded-xl border border-hairline bg-canvas-elevated">
				<table class="w-full min-w-[640px] border-collapse text-left text-[14px]">
					<thead>
						<tr class="border-b border-hairline bg-canvas text-[13px] font-semibold text-ink">
							{lengthHeaders.map((header) => <th class="px-4 py-3">{header}</th>)}
						</tr>
					</thead>
					<tbody class="divide-y divide-hairline text-body">
						{
							lengthRows.map((row) => (
								<tr>
									<td class="px-4 py-3 font-medium text-ink tabular-nums">{row[0]}</td>
									<td class="px-4 py-3 tabular-nums">{row[1]}</td>
									<td class="px-4 py-3 tabular-nums">{row[2]}</td>
									<td class="px-4 py-3 font-medium text-ink tabular-nums">{row[3]}</td>
									<td class="px-4 py-3">{row[4]}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</section>

		<!-- Section 4: Spotify, Audible & Libby: How Listening Time Limits & Percentages Work -->
		<section class="mx-auto max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("audiobookCalculator.page.platforms.title")}
			</h2>

			<p class="text-[16px] leading-relaxed text-body" set:html={localizeHtmlLinks(t("audiobookCalculator.page.platforms.introHtml"), locale)} />

			<div class="grid gap-5 md:grid-cols-2">
				<!-- Card 1: Spotify 15-Hour Monthly Quota -->
				<div class="rounded-xl border border-hairline bg-canvas-elevated p-5 space-y-3">
					<h3 class="text-lg font-semibold tracking-tight text-ink">
						{t("audiobookCalculator.page.platforms.spotifyTitle")}
					</h3>

					{
						spotifyParagraphsHtml.map((html) => (
							<p class="text-[14.5px] leading-relaxed text-body" set:html={localizeHtmlLinks(html, locale)} />
						))
					}
				</div>

				<!-- Card 2: Audible, Kindle & Libby Percentage Read -->
				<div class="rounded-xl border border-hairline bg-canvas-elevated p-5 space-y-3">
					<h3 class="text-lg font-semibold tracking-tight text-ink">
						{t("audiobookCalculator.page.platforms.audibleTitle")}
					</h3>

					{
						audibleParagraphsHtml.map((html) => (
							<p class="text-[14.5px] leading-relaxed text-body" set:html={localizeHtmlLinks(html, locale)} />
						))
					}

					<ul class="list-disc space-y-1.5 pl-5 text-[14.5px] leading-relaxed text-body">
						{
							audibleBulletsHtml.map((html) => (
								<li set:html={localizeHtmlLinks(html, locale)} />
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<!-- Section 5: How to Choose the Best Audiobook Playback Speed Without Losing Comprehension -->
		<section class="mx-auto max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("audiobookCalculator.page.comprehension.title")}
			</h2>

			<p class="text-[16px] leading-relaxed text-body" set:html={localizeHtmlLinks(t("audiobookCalculator.page.comprehension.introHtml"), locale)} />

			<h3 class="pt-2 text-xl font-semibold tracking-tight text-ink">
				{t("audiobookCalculator.page.comprehension.trainingTitle")}
			</h3>

			<p class="text-[16px] leading-relaxed text-body" set:html={localizeHtmlLinks(t("audiobookCalculator.page.comprehension.trainingIntroHtml"), locale)} />

			<ol class="grid gap-4 sm:grid-cols-3">
				{
					comprehensionSteps.map((step, idx) => (
						<li class="rounded-xl border border-hairline bg-canvas-elevated p-5">
							<div class="mb-2 flex items-center gap-2.5">
								<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[12px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]">{idx + 1}</span>
								<h4 class="text-[16px] font-semibold text-ink">{step.title}</h4>
							</div>
							<p class="text-[14.5px] leading-relaxed text-body" set:html={localizeHtmlLinks(step.bodyHtml, locale)} />
						</li>
					))
				}
			</ol>

			<div class="rounded-xl border border-hairline bg-canvas-elevated p-5">
				<h3 class="text-[16px] font-semibold text-ink">
					{t("audiobookCalculator.page.comprehension.habitTitle")}
				</h3>
				<p class="mt-1.5 text-[14.5px] leading-relaxed text-body" set:html={localizeHtmlLinks(t("audiobookCalculator.page.comprehension.habitBodyHtml"), locale)} />
			</div>
		</section>

		<!-- Section 6: Frequently Asked Questions About Audiobook Speed, Time & Percentages -->
		<section class="mx-auto max-w-[880px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("audiobookCalculator.faq.title")}
			</h2>

			<div class="divide-y divide-hairline rounded-2xl border border-hairline bg-canvas-elevated">
				{
					faqList.map((item, idx) => (
						<details class="group p-5 sm:p-6" open={idx === 0}>
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-semibold text-ink">
								<span>{item.question}</span>
								<span class="text-muted transition-transform duration-200 group-open:rotate-45">+</span>
							</summary>
							<p class="mt-3 text-[15px] leading-relaxed text-body" set:html={localizeHtmlLinks(item.answerHtml, locale)} />
						</details>
					))
				}
			</div>
		</section>
	</main>

	<Footer />
</Layout>
