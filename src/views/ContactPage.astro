---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SpotlightTools from "../components/SpotlightTools.astro";
import { resolveCanonicalUrl } from "../config/site";

import {
	getLocaleFromUrl,
	getLocalizedPath,
	localizeHtmlLinks,
	useTranslations,
} from "../i18n/ui";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

interface TopicOption {
	value: string;
	label: string;
}

const pageTitle = t("contact.title");
const pageDescription = t("contact.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/contact/", locale));
const topics = t.raw<TopicOption[]>("contact.page.topics") ?? [];

const clientI18n = {
	defaultTopic: t("contact.client.defaultTopic"),
	mailtoSubject: t("contact.client.mailtoSubject"),
	mailtoBody: t("contact.client.mailtoBody"),
	statusOpening: t("contact.client.statusOpening"),
	statusRequired: t("contact.client.statusRequired"),
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Header />

	<main class="flex-1">
		<section class="mx-auto max-w-[900px] px-4 py-12 sm:px-6 sm:py-16">
			<h1 class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]">
				{t("contact.h1")}
			</h1>
			<p class="mt-3 max-w-2xl text-[16px] leading-[25px] text-body">
				{t("contact.page.intro")}
			</p>

			<div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-12">
				<!-- Left: Direct Contact Info -->
				<div class="space-y-4 md:col-span-5">
					<div class="whisper-shadow rounded-md border border-hairline bg-canvas-elevated p-6">
						<h2 class="text-[17px] font-semibold text-ink">
							{t("contact.page.directEmailHeading")}
						</h2>
						<p class="mt-2 text-[14px] leading-[22px] text-body">
							{t("contact.page.directEmailBody")}
						</p>
						<p class="mt-3">
							<a
								href="mailto:support@wordora.site"
								class="inline-flex items-center gap-2 rounded-sm border border-hairline bg-canvas-muted px-3.5 py-2 text-[14px] font-medium text-vercel-blue transition-colors hover:border-ink"
							>
								support@wordora.site
							</a>
						</p>
						<p class="mt-3 text-[13px] text-mute">
							{t("contact.page.responseTimeNote")}
						</p>
					</div>

					<div class="whisper-shadow rounded-md border border-hairline bg-canvas-elevated p-6">
						<h2 class="text-[16px] font-semibold text-ink">
							{t("contact.page.privacyNoteHeading")}
						</h2>
						<p
							class="mt-2 text-[13px] leading-[20px] text-body"
							set:html={localizeHtmlLinks(t("contact.page.privacyNoteBodyHtml"), locale)}
						/>
					</div>
				</div>

				<!-- Right: Client-Side Feedback Form -->
				<div class="md:col-span-7">
					<div class="whisper-shadow rounded-md border border-hairline bg-canvas-elevated p-6 sm:p-7">
						<h2 class="text-[18px] font-semibold text-ink">
							{t("contact.page.formHeading")}
						</h2>
						<p class="mt-1 text-[13px] text-mute">
							{t("contact.page.formSubtitle")}
						</p>

						<form id="contact-feedback-form" class="mt-5 space-y-4">
							<div>
								<label for="cf-name" class="block text-[13px] font-medium text-ink">
									{t("contact.page.nameLabel")}
								</label>
								<input
									type="text"
									id="cf-name"
									name="name"
									required
									placeholder={t("contact.page.namePlaceholder")}
									class="mt-1.5 w-full rounded-sm border border-hairline bg-canvas-elevated px-3.5 py-2 text-[14px] text-ink placeholder:text-faint focus:border-vercel-blue focus:outline-none"
								/>
							</div>

							<div>
								<label for="cf-email" class="block text-[13px] font-medium text-ink">
									{t("contact.page.emailLabel")}
								</label>
								<input
									type="email"
									id="cf-email"
									name="email"
									required
									placeholder={t("contact.page.emailPlaceholder")}
									class="mt-1.5 w-full rounded-sm border border-hairline bg-canvas-elevated px-3.5 py-2 text-[14px] text-ink placeholder:text-faint focus:border-vercel-blue focus:outline-none"
								/>
							</div>

							<div>
								<label for="cf-topic" class="block text-[13px] font-medium text-ink">
									{t("contact.page.topicLabel")}
								</label>
								<select
									id="cf-topic"
									name="topic"
									class="mt-1.5 w-full rounded-sm border border-hairline bg-canvas-elevated px-3.5 py-2 text-[14px] text-ink focus:border-vercel-blue focus:outline-none"
								>
									{
										topics.map((topic) => (
											<option value={topic.value}>{topic.label}</option>
										))
									}
								</select>
							</div>

							<div>
								<label for="cf-message" class="block text-[13px] font-medium text-ink">
									{t("contact.page.messageLabel")}
								</label>
								<textarea
									id="cf-message"
									name="message"
									rows="4"
									required
									placeholder={t("contact.page.messagePlaceholder")}
									class="mt-1.5 w-full resize-y rounded-sm border border-hairline bg-canvas-elevated p-3.5 text-[14px] leading-[22px] text-ink placeholder:text-faint focus:border-vercel-blue focus:outline-none"
								></textarea>
							</div>

							<div class="flex flex-wrap items-center justify-between gap-3 pt-1">
								<button
									type="submit"
									class="cursor-pointer rounded-pill bg-primary px-5 py-2 text-[14px] font-medium text-on-primary transition-opacity hover:opacity-90"
								>
									{t("contact.page.submitButton")}
								</button>
								<span id="cf-status" class="hidden text-[13px] font-medium text-ink"></span>
							</div>
						</form>
					</div>
				</div>
			</div>
		</section>

		<!-- Spotlight: Random Topic Generator + Typing Speed Test -->
		<SpotlightTools locale={locale} />
	</main>

	<Footer />
</Layout>

<script
	type="application/json"
	id="contact-i18n"
	set:html={JSON.stringify(clientI18n).replace(/</g, "\\u003c")}
/>

<script>
	interface ContactClientI18n {
		defaultTopic: string;
		mailtoSubject: string;
		mailtoBody: string;
		statusOpening: string;
		statusRequired: string;
	}

	function formatTemplate(template: string, vars: Record<string, string>): string {
		return template.replace(/\{(\w+)\}/g, (_, key: string) => vars[key] ?? `{${key}}`);
	}

	function getContactI18n(): ContactClientI18n {
		const fallback: ContactClientI18n = {
			defaultTopic: "Feedback",
			mailtoSubject: "[Wordora {topic}] from {name}",
			mailtoBody: "Name: {name}\nEmail: {email}\nTopic: {topic}\n\n{message}",
			statusOpening: "Thank you! Opening your email client to send to support@wordora.site...",
			statusRequired: "Please fill in your name, email address, and message before sending.",
		};
		const el = document.getElementById("contact-i18n");
		if (!el?.textContent) return fallback;
		try {
			return { ...fallback, ...(JSON.parse(el.textContent) as Partial<ContactClientI18n>) };
		} catch {
			return fallback;
		}
	}

	function initContactForm() {
		const form = document.getElementById("contact-feedback-form") as HTMLFormElement | null;
		const statusEl = document.getElementById("cf-status");
		if (!form) return;

		const i18n = getContactI18n();

		form.addEventListener("submit", (e) => {
			e.preventDefault();
			const name = (document.getElementById("cf-name") as HTMLInputElement | null)?.value.trim() || "";
			const email = (document.getElementById("cf-email") as HTMLInputElement | null)?.value.trim() || "";
			const topic = (document.getElementById("cf-topic") as HTMLSelectElement | null)?.value || i18n.defaultTopic;
			const message = (document.getElementById("cf-message") as HTMLTextAreaElement | null)?.value.trim() || "";

			if (!name || !email || !message) {
				if (statusEl) {
					statusEl.textContent = i18n.statusRequired;
					statusEl.classList.remove("hidden");
				}
				return;
			}

			const subject = encodeURIComponent(
				formatTemplate(i18n.mailtoSubject, { topic, name }),
			);
			const body = encodeURIComponent(
				formatTemplate(i18n.mailtoBody, { name, email, topic, message }),
			);

			if (statusEl) {
				statusEl.textContent = i18n.statusOpening;
				statusEl.classList.remove("hidden");
			}

			window.location.href = `mailto:support@wordora.site?subject=${subject}&body=${body}`;
		});
	}

	initContactForm();
</script>
