---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_CONFIG, resolveCanonicalUrl } from "../config/site";

import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "../i18n/ui";
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const pageTitle = t("contact.title");
const pageDescription = t("contact.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/contact/", locale));
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Header />

	<main class="flex-1">
		<section class="mx-auto max-w-[900px] px-4 py-12 sm:px-6 sm:py-16">
			<h1 class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]">
					{t("contact.h1")}
				</h1>
			<p class="mt-3 max-w-2xl text-[16px] leading-[25px] text-body">
				Have a question, spotted a bug, or want to suggest a new utility for {SITE_CONFIG.name}? Reach out by email or use the quick feedback form below.
			</p>

			<div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-12">
				<!-- Left: Direct Contact Info -->
				<div class="space-y-4 md:col-span-5">
					<div class="whisper-shadow rounded-md border border-hairline bg-canvas-elevated p-6">
						<h2 class="text-[17px] font-semibold text-ink">
							Direct email support
						</h2>
						<p class="mt-2 text-[14px] leading-[22px] text-body">
							For support inquiries, press questions, or tool feedback, email us directly:
						</p>
						<p class="mt-3">
							<a
								href="mailto:support@wordora.site"
								class="inline-flex items-center gap-2 rounded-sm border border-hairline bg-canvas-muted px-3.5 py-2 text-[14px] font-medium text-vercel-blue transition-colors hover:border-ink"
							>
								support@wordora.site
							</a>
						</p>
						<p class="mt-3 text-[13px] text-mute">
							We aim to respond to all messages within 1–2 business days.
						</p>
					</div>

					<div class="whisper-shadow rounded-md border border-hairline bg-canvas-elevated p-6">
						<h2 class="text-[16px] font-semibold text-ink">
							Privacy note
						</h2>
						<p class="mt-2 text-[13px] leading-[20px] text-body">
							Remember that all {SITE_CONFIG.name} calculators run locally in your browser. Read our <a href={getLocalizedPath("/privacy-policy/", locale)} class="text-vercel-blue underline-offset-2 hover:underline">Privacy Policy</a> or learn more <a href={getLocalizedPath("/about/", locale)} class="text-vercel-blue underline-offset-2 hover:underline">About Wordora</a>.
						</p>
					</div>
				</div>

				<!-- Right: Client-Side Feedback Form -->
				<div class="md:col-span-7">
					<div class="whisper-shadow rounded-md border border-hairline bg-canvas-elevated p-6 sm:p-7">
						<h2 class="text-[18px] font-semibold text-ink">
							Send feedback
						</h2>
						<p class="mt-1 text-[13px] text-mute">
							Fill out the fields below to prepare a message or send quick feedback.
						</p>

						<form id="contact-feedback-form" class="mt-5 space-y-4">
							<div>
								<label for="cf-name" class="block text-[13px] font-medium text-ink">
									Your name
								</label>
								<input
									type="text"
									id="cf-name"
									name="name"
									required
									placeholder="Alex Morgan"
									class="mt-1.5 w-full rounded-sm border border-hairline bg-canvas-elevated px-3.5 py-2 text-[14px] text-ink placeholder:text-faint focus:border-vercel-blue focus:outline-none"
								/>
							</div>

							<div>
								<label for="cf-email" class="block text-[13px] font-medium text-ink">
									Email address
								</label>
								<input
									type="email"
									id="cf-email"
									name="email"
									required
									placeholder="alex@example.com"
									class="mt-1.5 w-full rounded-sm border border-hairline bg-canvas-elevated px-3.5 py-2 text-[14px] text-ink placeholder:text-faint focus:border-vercel-blue focus:outline-none"
								/>
							</div>

							<div>
								<label for="cf-topic" class="block text-[13px] font-medium text-ink">
									Topic
								</label>
								<select
									id="cf-topic"
									name="topic"
									class="mt-1.5 w-full rounded-sm border border-hairline bg-canvas-elevated px-3.5 py-2 text-[14px] text-ink focus:border-vercel-blue focus:outline-none"
								>
									<option value="Feature Request">Feature or new tool request</option>
									<option value="Bug Report">Bug report</option>
									<option value="General Feedback">General feedback</option>
									<option value="Other">Other inquiry</option>
								</select>
							</div>

							<div>
								<label for="cf-message" class="block text-[13px] font-medium text-ink">
									Message
								</label>
								<textarea
									id="cf-message"
									name="message"
									rows="4"
									required
									placeholder="Tell us how we can improve Wordora..."
									class="mt-1.5 w-full resize-y rounded-sm border border-hairline bg-canvas-elevated p-3.5 text-[14px] leading-[22px] text-ink placeholder:text-faint focus:border-vercel-blue focus:outline-none"
								></textarea>
							</div>

							<div class="flex flex-wrap items-center justify-between gap-3 pt-1">
								<button
									type="submit"
									class="cursor-pointer rounded-pill bg-primary px-5 py-2 text-[14px] font-medium text-on-primary transition-opacity hover:opacity-90"
								>
									Send message
								</button>
								<span id="cf-status" class="hidden text-[13px] font-medium text-ink"></span>
							</div>
						</form>
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	function initContactForm() {
		const form = document.getElementById('contact-feedback-form') as HTMLFormElement | null;
		const statusEl = document.getElementById('cf-status');
		if (!form) return;

		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const name = (document.getElementById('cf-name') as HTMLInputElement | null)?.value.trim() || '';
			const email = (document.getElementById('cf-email') as HTMLInputElement | null)?.value.trim() || '';
			const topic = (document.getElementById('cf-topic') as HTMLSelectElement | null)?.value || 'Feedback';
			const message = (document.getElementById('cf-message') as HTMLTextAreaElement | null)?.value.trim() || '';

			const subject = encodeURIComponent(`[Wordora ${topic}] from ${name}`);
			const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nTopic: ${topic}\n\n${message}`);

			if (statusEl) {
				statusEl.textContent = 'Thank you! Opening your email client to send to support@wordora.site...';
				statusEl.classList.remove('hidden');
			}

			window.location.href = `mailto:support@wordora.site?subject=${subject}&body=${body}`;
		});
	}

	initContactForm();
</script>

