---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import RelatedTools from "../components/RelatedTools.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";

import {
	getLocaleFromUrl,
	getLocalizedPath,
	localizeHtmlLinks,
	useTranslations,
} from "../i18n/ui";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const pageTitle = t("typingSpeedTest.title");
const pageDescription = t("typingSpeedTest.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/typing-speed-test/", locale));

interface QuickLaunchMode {
	label: string;
	query: string;
}

interface BenchmarkRow {
	tier: string;
	wpmRange: string;
	cpmRange: string;
	accuracyTarget: string;
	useCase: string;
}

interface MethodologyCard {
	title: string;
	bodyHtml: string;
}

interface TechniqueCard {
	number: string;
	title: string;
	bodyHtml: string;
}

interface FaqItem {
	question: string;
	answer: string;
}

const schemaFeatures = t.raw<string[]>("typingSpeedTest.page.schemaFeatures") ?? [];
const quickLaunchModes = (t.raw<QuickLaunchMode[]>("typingSpeedTest.page.hero.quickLaunch") ?? []).map(
	(mode) => ({
		label: mode.label,
		href: getLocalizedPath(`/typing-speed-test/play/${mode.query}`, locale),
	}),
);
const benchmarkHeaders = t.raw<string[]>("typingSpeedTest.page.benchmarks.tableHeaders") ?? [];
const speedBenchmarks = t.raw<BenchmarkRow[]>("typingSpeedTest.page.benchmarks.rows") ?? [];
const methodologyCards = t.raw<MethodologyCard[]>("typingSpeedTest.page.methodology.cards") ?? [];
const techniqueCards = t.raw<TechniqueCard[]>("typingSpeedTest.page.techniques.cards") ?? [];
const faqs = t.raw<FaqItem[]>("typingSpeedTest.faq") ?? [];

const primaryCtaHref = getLocalizedPath("/typing-speed-test/play/?mode=time&value=60", locale);

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "SoftwareApplication",
			name: t("typingSpeedTest.name"),
			url: canonicalUrl,
			inLanguage: locale,
			applicationCategory: "UtilitiesApplication",
			operatingSystem: "Web, Any",
			offers: {
				"@type": "Offer",
				price: "0",
				priceCurrency: "USD",
			},
			description: pageDescription,
			featureList: schemaFeatures,
		},
		{
			"@type": "FAQPage",
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: faq.answer,
				},
			})),
		},
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Hero Launcher Section -->
		<section class="px-4 py-12 sm:px-6 sm:py-16">
			<div class="mx-auto max-w-[1100px]">
				<!-- Typing Studio Launcher Hero Card -->
				<div class="rounded-3xl border border-[#afe3d0]/20 bg-[#0f2e26] p-5 text-white shadow-xl sm:p-12">
					<div class="mx-auto flex max-w-3xl flex-col items-center text-center">
						<span class="inline-flex items-center gap-2 rounded-full border border-[#afe3d0]/30 bg-[#afe3d0]/10 px-3.5 py-1 text-[13px] font-medium text-[#afe3d0]">
							<span class="h-2 w-2 rounded-full bg-[#afe3d0]"></span>
							<span>{t("typingSpeedTest.page.hero.badge")}</span>
						</span>

						<h1 class="mt-5 font-sans text-3xl leading-tight font-semibold tracking-[-1px] text-white sm:text-5xl sm:leading-[1.15] sm:tracking-[-1.5px]">
							{t("typingSpeedTest.h1")}
						</h1>

						<p class="mt-4 max-w-2xl text-base leading-relaxed text-[#afe3d0]/85 sm:text-lg">
							{t("typingSpeedTest.page.hero.subtitle")}
						</p>

						<!-- Primary CTA Button -->
						<div class="mt-8">
							<a
								href={primaryCtaHref}
								class="inline-flex w-full items-center justify-center rounded-2xl bg-[#afe3d0] px-6 py-3.5 text-base font-bold text-[#0f2e26] shadow-md transition hover:brightness-105 sm:w-auto sm:px-8 sm:py-4 sm:text-lg"
							>
								{t("typingSpeedTest.page.hero.cta")}
							</a>
						</div>

						<!-- Quick-Launch Mode Pills -->
						<div class="mt-7 flex flex-wrap items-center justify-center gap-2.5">
							{
								quickLaunchModes.map((mode) => (
									<a
										href={mode.href}
										class="rounded-full border border-[#afe3d0]/25 bg-white/5 px-4 py-2 text-[13px] font-medium text-white/90 transition hover:border-[#afe3d0] hover:bg-[#afe3d0] hover:text-[#0f2e26]"
									>
										{mode.label}
									</a>
								))
							}
						</div>

						<!-- Subtle Trust Strip -->
						<p class="mt-8 border-t border-[#afe3d0]/15 pt-5 text-[13px] text-[#afe3d0]/75">
							{t("typingSpeedTest.page.hero.trustStrip")}
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Topical cluster interlinking -->
		<RelatedTools toolId="typing-speed-test" locale={locale} maxWidthClass="max-w-[1100px]" />

		<!-- Section 1: WPM Speed Benchmarks Table -->
		<section
			id="wpm-benchmarks"
			aria-labelledby="wpm-benchmarks-heading"
			class="mx-auto max-w-[1100px] px-4 py-10 sm:px-6 sm:py-12"
		>
			<div class="border-t border-hairline pt-10">
				<div class="max-w-3xl">
					<span class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]">
						{t("typingSpeedTest.page.benchmarks.badge")}
					</span>
					<h2
						id="wpm-benchmarks-heading"
						class="mt-3 font-sans text-2xl font-semibold tracking-[-0.8px] text-ink sm:text-3xl"
					>
						{t("typingSpeedTest.page.benchmarks.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("typingSpeedTest.page.benchmarks.intro")}
					</p>
				</div>

				<div class="mt-7 overflow-hidden rounded-2xl border border-hairline bg-canvas-elevated">
					<div class="overflow-x-auto">
						<table class="w-full border-collapse text-left text-[14px]">
							<thead>
								<tr class="border-b border-hairline bg-[#0f2e26]/5 text-[13px] font-semibold text-ink dark:bg-[#afe3d0]/5">
									{
										benchmarkHeaders.map((header) => (
											<th class="p-4 sm:px-6">{header}</th>
										))
									}
								</tr>
							</thead>
							<tbody class="divide-y divide-hairline">
								{
									speedBenchmarks.map((row) => (
										<tr class="transition-colors hover:bg-canvas/60">
											<td class="p-4 font-semibold text-ink whitespace-nowrap sm:px-6">
												{row.tier}
											</td>
											<td class="p-4 font-semibold text-[#0f2e26] tabular-nums whitespace-nowrap sm:px-6 dark:text-[#afe3d0]">
												{row.wpmRange}
											</td>
											<td class="p-4 text-body tabular-nums whitespace-nowrap sm:px-6">
												{row.cpmRange}
											</td>
											<td class="p-4 font-medium text-ink tabular-nums whitespace-nowrap sm:px-6">
												{row.accuracyTarget}
											</td>
											<td class="max-w-md p-4 leading-relaxed text-body sm:px-6">
												{row.useCase}
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</section>

		<!-- Section 2: How WPM, Raw WPM & Consistency Are Calculated -->
		<section
			id="how-wpm-is-calculated"
			aria-labelledby="calculation-heading"
			class="mx-auto max-w-[1100px] px-4 py-10 sm:px-6 sm:py-12"
		>
			<div class="border-t border-hairline pt-10">
				<div class="max-w-3xl">
					<span class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]">
						{t("typingSpeedTest.page.methodology.badge")}
					</span>
					<h2
						id="calculation-heading"
						class="mt-3 font-sans text-2xl font-semibold tracking-[-0.8px] text-ink sm:text-3xl"
					>
						{t("typingSpeedTest.page.methodology.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("typingSpeedTest.page.methodology.intro")}
					</p>
				</div>

				<div class="mt-7 grid grid-cols-1 gap-5 md:grid-cols-3">
					{
						methodologyCards.map((card) => (
							<div class="rounded-2xl border border-hairline bg-canvas-elevated p-6">
								<h3 class="text-[17px] font-semibold text-ink">
									{card.title}
								</h3>
								<p
									class="mt-2 text-[14px] leading-relaxed text-body"
									set:html={localizeHtmlLinks(card.bodyHtml, locale)}
								/>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Section 3: 5 Proven Techniques to Increase Typing Speed -->
		<section
			id="improve-typing-speed"
			aria-labelledby="techniques-heading"
			class="mx-auto max-w-[1100px] px-4 py-10 sm:px-6 sm:py-12"
		>
			<div class="border-t border-hairline pt-10">
				<div class="max-w-3xl">
					<span class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]">
						{t("typingSpeedTest.page.techniques.badge")}
					</span>
					<h2
						id="techniques-heading"
						class="mt-3 font-sans text-2xl font-semibold tracking-[-0.8px] text-ink sm:text-3xl"
					>
						{t("typingSpeedTest.page.techniques.heading")}
					</h2>
					<p
						class="mt-2.5 text-[15px] leading-relaxed text-body"
						set:html={localizeHtmlLinks(t("typingSpeedTest.page.techniques.introHtml"), locale)}
					/>
				</div>

				<div class="mt-7 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
					{
						techniqueCards.map((card, idx) => (
							<div
								class={
									idx === 4
										? "rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:col-span-2 lg:col-span-2"
										: "rounded-2xl border border-hairline bg-canvas-elevated p-6"
								}
							>
								<span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#0f2e26] text-[13px] font-semibold text-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]">
									{card.number}
								</span>
								<h3 class="mt-3 text-[16px] font-semibold text-ink">
									{card.title}
								</h3>
								<p
									class="mt-2 text-[14px] leading-relaxed text-body"
									set:html={localizeHtmlLinks(card.bodyHtml, locale)}
								/>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Section 4: 10 PAA FAQs Accordion -->
		<section
			id="faq"
			aria-labelledby="faq-heading"
			class="mx-auto max-w-[1100px] px-4 pt-10 pb-16 sm:px-6"
		>
			<div class="border-t border-hairline pt-10">
				<div class="max-w-3xl">
					<span class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]">
						{t("typingSpeedTest.page.faqSection.badge")}
					</span>
					<h2
						id="faq-heading"
						class="mt-3 font-sans text-2xl font-semibold tracking-[-0.8px] text-ink sm:text-3xl"
					>
						{t("typingSpeedTest.page.faqSection.heading")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("typingSpeedTest.page.faqSection.intro")}
					</p>
				</div>

				<div class="mt-7 divide-y divide-hairline rounded-2xl border border-hairline bg-canvas-elevated">
					{
						faqs.map((faq, idx) => (
							<details class="group p-5 sm:p-6" open={idx === 0}>
								<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-sans text-[16px] font-semibold text-ink">
									<span>{faq.question}</span>
									<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-hairline bg-canvas text-mute transition-transform duration-150 group-open:rotate-180">
										<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="m6 9 6 6 6-6" />
										</svg>
									</span>
								</summary>
								<p class="mt-3 text-[14.5px] leading-relaxed text-body">
									{faq.answer}
								</p>
							</details>
						))
					}
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
