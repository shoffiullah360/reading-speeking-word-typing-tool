---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ReadingCalculator from "../components/ReadingCalculator.astro";
import BenchmarkTable from "../components/BenchmarkTable.astro";
import FAQSection, { faqItems as defaultFaqItems, type FAQItem } from "../components/FAQSection.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from "../i18n/ui";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

interface LeadItem {
	lead: string;
	text: string;
}

interface WordsGroup {
	h3: string;
	items: LeadItem[];
}

const pageTitle = t("readingTimeCalculator.title");
const pageDescription = t("readingTimeCalculator.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/reading-time-calculator/", locale));

const faqs: FAQItem[] = t.raw<FAQItem[]>("readingTimeCalculator.faq.items") ?? defaultFaqItems;

const featureList: string[] = t.raw<string[]>("readingTimeCalculator.schema.featureList") ?? [
	"Real-time silent reading time calculator (100 to 400 WPM, default 238 WPM)",
	"Read aloud speed timer (100 to 300 WPM, default 183 WPM)",
	"Multi-input system: Paste Text, Direct Word Count, and Pages Count converter",
	"Drag-and-drop .txt file reader with 100% client-side privacy",
	"Dynamic reading difficulty badge based on word length and syllable density",
];

const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: t("readingTimeCalculator.name"),
	url: canonicalUrl,
	inLanguage: locale,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web, Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList,
};

const faqPageSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	inLanguage: locale,
	mainEntity: faqs.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer,
		},
	})),
};

const exampleSteps = t.raw<string[]>("readingTimeCalculator.page.howCalculated.exampleSteps") ?? [];
const calcReasons = t.raw<LeadItem[]>("readingTimeCalculator.page.howCalculated.reasons") ?? [];

const ageHeaders = t.raw<string[]>("readingTimeCalculator.page.ageSpeed.headers") ?? [];
const ageRows = t.raw<string[][]>("readingTimeCalculator.page.ageSpeed.rows") ?? [];
const fastItems = t.raw<LeadItem[]>("readingTimeCalculator.page.ageSpeed.fastItems") ?? [];
const mythItems = t.raw<LeadItem[]>("readingTimeCalculator.page.ageSpeed.mythItems") ?? [];

const wordsGroups = t.raw<WordsGroup[]>("readingTimeCalculator.page.wordsToMinutes.groups") ?? [];

const minHeaders = t.raw<string[]>("readingTimeCalculator.page.minutesToWords.headers") ?? [];
const minRows = t.raw<string[][]>("readingTimeCalculator.page.minutesToWords.rows") ?? [];
const minQuickItems = t.raw<LeadItem[]>("readingTimeCalculator.page.minutesToWords.quickItems") ?? [];

const aloudHeaders = t.raw<string[]>("readingTimeCalculator.page.readAloud.headers") ?? [];
const aloudRows = t.raw<string[][]>("readingTimeCalculator.page.readAloud.rows") ?? [];
const aloudItems = t.raw<LeadItem[]>("readingTimeCalculator.page.readAloud.items") ?? [];

const wppHeaders = t.raw<string[]>("readingTimeCalculator.page.wordsPerPage.headers") ?? [];
const wppRows = t.raw<string[][]>("readingTimeCalculator.page.wordsPerPage.rows") ?? [];
const wppItems = t.raw<LeadItem[]>("readingTimeCalculator.page.wordsPerPage.items") ?? [];

const readPagesHeaders = t.raw<string[]>("readingTimeCalculator.page.readPages.headers") ?? [];
const readPagesRows = t.raw<string[][]>("readingTimeCalculator.page.readPages.rows") ?? [];
const readPagesItems = t.raw<LeadItem[]>("readingTimeCalculator.page.readPages.items") ?? [];

const booksHeaders = t.raw<string[]>("readingTimeCalculator.page.books.headers") ?? [];
const booksRows = t.raw<string[][]>("readingTimeCalculator.page.books.rows") ?? [];
const booksItems = t.raw<LeadItem[]>("readingTimeCalculator.page.books.items") ?? [];

const appsItems = t.raw<LeadItem[]>("readingTimeCalculator.page.apps.items") ?? [];
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(softwareAppSchema)}
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify(faqPageSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					{t("readingTimeCalculator.h1")}
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					{t("readingTimeCalculator.page.heroSubtitle")}
				</p>
			</div>
		</section>

		<!-- Flagship Interactive Calculator Workspace -->
		<ReadingCalculator locale={locale} />

		<!-- Editorial Content: How Is Reading Time Calculated? -->
		<section
			aria-labelledby="how-reading-time-is-calculated"
			class="mt-10 md:mt-12"
		>
			<div class="mx-auto max-w-[1200px] px-4 sm:px-6">
				<div class="max-w-3xl">
					<h2
						id="how-reading-time-is-calculated"
						class="text-[26px] leading-[34px] font-semibold tracking-[-0.8px] text-ink sm:text-[30px] sm:leading-[38px]"
					>
						{t("readingTimeCalculator.page.howCalculated.h2")}
					</h2>

					<p class="mt-4 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.howCalculated.p1")}
					</p>

					<p class="mt-4 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.howCalculated.p2")}
					</p>

					<div class="whisper-shadow my-6 rounded-md border border-hairline bg-canvas-elevated px-5 py-4 text-[15px] leading-relaxed font-semibold text-ink sm:text-[16px]">
						{t("readingTimeCalculator.page.howCalculated.formula")}
					</div>

					<p class="text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.howCalculated.p3")}
					</p>

					<ul class="mt-4 list-disc space-y-2 pl-5 text-[16px] leading-relaxed text-body marker:text-mute">
						{exampleSteps.map((step) => <li>{step}</li>)}
					</ul>

					<h3
						class="mt-10 text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink sm:text-[22px] sm:leading-[30px]"
					>
						{t("readingTimeCalculator.page.howCalculated.h3")}
					</h3>

					<p class="mt-3 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.howCalculated.p4")}
					</p>

					<ul class="mt-4 list-disc space-y-3 pl-5 text-[16px] leading-relaxed text-body marker:text-mute">
						{
							calcReasons.map((item) => (
								<li>
									<strong class="font-semibold text-ink">{item.lead}</strong>{item.text}
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<!-- Editorial Content: Average Reading Speed by Age, Grade & Reader Level -->
		<section
			aria-labelledby="average-reading-speed-by-age"
			class="mt-10 md:mt-12"
		>
			<div class="mx-auto max-w-[1200px] px-4 sm:px-6">
				<div class="max-w-3xl">
					<h2
						id="average-reading-speed-by-age"
						class="text-[26px] leading-[34px] font-semibold tracking-[-0.8px] text-ink sm:text-[30px] sm:leading-[38px]"
					>
						{t("readingTimeCalculator.page.ageSpeed.h2")}
					</h2>

					<p class="mt-4 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.ageSpeed.p1")}
					</p>

					<h3
						class="mt-10 text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink sm:text-[22px] sm:leading-[30px]"
					>
						{t("readingTimeCalculator.page.ageSpeed.h3Chart")}
					</h3>

					<p class="mt-3 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.ageSpeed.pChart")}
					</p>
				</div>

				<div class="whisper-shadow mt-6 max-w-4xl overflow-x-auto rounded-md border border-hairline bg-canvas-elevated">
					<table class="w-full border-collapse text-left">
						<thead>
							<tr class="border-b border-hairline bg-canvas-muted text-[13px] font-semibold text-ink">
								<th scope="col" class="py-3.5 pl-5 pr-4">{ageHeaders[0]}</th>
								<th scope="col" class="px-4 py-3.5">{ageHeaders[1]}</th>
								<th scope="col" class="px-4 py-3.5">{ageHeaders[2]}</th>
								<th scope="col" class="py-3.5 pl-4 pr-5">{ageHeaders[3]}</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-hairline text-[14px]">
							{
								ageRows.map((row) => (
									<tr>
										<td class="whitespace-nowrap py-3.5 pl-5 pr-4 font-semibold text-ink">{row[0]}</td>
										<td class="whitespace-nowrap px-4 py-3.5 text-body tabular-nums">{row[1]}</td>
										<td class="whitespace-nowrap px-4 py-3.5 font-medium text-ink tabular-nums">{row[2]}</td>
										<td class="whitespace-nowrap py-3.5 pl-4 pr-5 text-body">{row[3]}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>

				<div class="max-w-3xl">
					<h3
						class="mt-10 text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink sm:text-[22px] sm:leading-[30px]"
					>
						{t("readingTimeCalculator.page.ageSpeed.h3Fast")}
					</h3>

					<ul class="mt-4 list-disc space-y-3 pl-5 text-[16px] leading-relaxed text-body marker:text-mute">
						{
							fastItems.map((item) => (
								<li>
									<strong class="font-semibold text-ink">{item.lead}</strong>{item.text}
								</li>
							))
						}
					</ul>

					<h3
						class="mt-10 text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink sm:text-[22px] sm:leading-[30px]"
					>
						{t("readingTimeCalculator.page.ageSpeed.h3Myths")}
					</h3>

					<p class="mt-3 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.ageSpeed.pMyths")}
					</p>

					<ul class="mt-4 list-disc space-y-3 pl-5 text-[16px] leading-relaxed text-body marker:text-mute">
						{
							mythItems.map((item) => (
								<li>
									<strong class="font-semibold text-ink">{item.lead}</strong>{item.text}
								</li>
							))
						}
					</ul>

					<h3
						class="mt-10 text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink sm:text-[22px] sm:leading-[30px]"
					>
						{t("readingTimeCalculator.page.ageSpeed.h3OwnWpm")}
					</h3>

					<p class="mt-3 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.ageSpeed.ownWpmBefore")}<a href={getLocalizedPath("/reading-speed-test/", locale)} class="font-medium text-ink underline decoration-hairline underline-offset-4 transition-colors hover:decoration-ink">{t("readingTimeCalculator.page.ageSpeed.ownWpmLink")}</a>{t("readingTimeCalculator.page.ageSpeed.ownWpmAfter")}
					</p>
				</div>
			</div>
		</section>

		<!-- Editorial Content: Words to Minutes Conversion Guide (200 to 3,000+ Words) -->
		<section
			aria-labelledby="words-to-minutes-conversion-guide"
			class="mt-10 md:mt-12"
		>
			<div class="mx-auto max-w-[1200px] px-4 sm:px-6">
				<div class="max-w-3xl">
					<h2
						id="words-to-minutes-conversion-guide"
						class="text-[26px] leading-[34px] font-semibold tracking-[-0.8px] text-ink sm:text-[30px] sm:leading-[38px]"
					>
						{t("readingTimeCalculator.page.wordsToMinutes.h2")}
					</h2>

					<p class="mt-4 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.wordsToMinutes.p1")}
					</p>

					{
						wordsGroups.map((group) => (
							<>
								<h3 class="mt-10 text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink sm:text-[22px] sm:leading-[30px]">
									{group.h3}
								</h3>

								<ul class="mt-4 list-disc space-y-3 pl-5 text-[16px] leading-relaxed text-body marker:text-mute">
									{group.items.map((item) => (
										<li>
											<strong class="font-semibold text-ink">{item.lead}</strong>{item.text}
										</li>
									))}
								</ul>
							</>
						))
					}
				</div>
			</div>
		</section>

		<!-- Featured Snippet Benchmark Table (100 to 10,000 Words) -->
		<div class="mt-10 md:mt-12">
			<BenchmarkTable locale={locale} />
		</div>

		<!-- Editorial Content: Minutes to Words Guide: How Much Can You Read in 2 to 30 Minutes? -->
		<section
			aria-labelledby="minutes-to-words-guide"
			class="mt-10 md:mt-12"
		>
			<div class="mx-auto max-w-[1200px] px-4 sm:px-6">
				<div class="max-w-3xl">
					<h2
						id="minutes-to-words-guide"
						class="text-[26px] leading-[34px] font-semibold tracking-[-0.8px] text-ink sm:text-[30px] sm:leading-[38px]"
					>
						{t("readingTimeCalculator.page.minutesToWords.h2")}
					</h2>

					<p class="mt-4 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.minutesToWords.p1")}
					</p>

					<p class="mt-4 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.minutesToWords.p2")}
					</p>

					<div class="whisper-shadow my-6 rounded-md border border-hairline bg-canvas-elevated px-5 py-4 text-[15px] leading-relaxed font-semibold text-ink sm:text-[16px]">
						{t("readingTimeCalculator.page.minutesToWords.formula")}
					</div>

					<h3
						class="mt-10 text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink sm:text-[22px] sm:leading-[30px]"
					>
						{t("readingTimeCalculator.page.minutesToWords.h3Chart")}
					</h3>

					<p class="mt-3 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.minutesToWords.pChart")}
					</p>
				</div>

				<div class="whisper-shadow mt-6 max-w-5xl overflow-x-auto rounded-md border border-hairline bg-canvas-elevated">
					<table class="w-full border-collapse text-left">
						<thead>
							<tr class="border-b border-hairline bg-canvas-muted text-[13px] font-semibold text-ink">
								<th scope="col" class="py-3.5 pl-5 pr-4">{minHeaders[0]}</th>
								<th scope="col" class="px-4 py-3.5">{minHeaders[1]}</th>
								<th scope="col" class="px-4 py-3.5">{minHeaders[2]}</th>
								<th scope="col" class="px-4 py-3.5">{minHeaders[3]}</th>
								<th scope="col" class="py-3.5 pl-4 pr-5">{minHeaders[4]}</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-hairline text-[14px]">
							{
								minRows.map((row) => (
									<tr>
										<td class="whitespace-nowrap py-3.5 pl-5 pr-4 font-semibold text-ink tabular-nums">{row[0]}</td>
										<td class="whitespace-nowrap px-4 py-3.5 font-medium text-ink tabular-nums">{row[1]}</td>
										<td class="whitespace-nowrap px-4 py-3.5 text-body tabular-nums">{row[2]}</td>
										<td class="whitespace-nowrap px-4 py-3.5 text-body tabular-nums">{row[3]}</td>
										<td class="whitespace-nowrap py-3.5 pl-4 pr-5 text-body">{row[4]}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>

				<div class="max-w-3xl">
					<h3
						class="mt-10 text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink sm:text-[22px] sm:leading-[30px]"
					>
						{t("readingTimeCalculator.page.minutesToWords.h3Quick")}
					</h3>

					<ul class="mt-4 list-disc space-y-3 pl-5 text-[16px] leading-relaxed text-body marker:text-mute">
						{
							minQuickItems.map((item) => (
								<li>
									<strong class="font-semibold text-ink">{item.lead}</strong>{item.text}
								</li>
							))
						}
					</ul>

					<h3
						class="mt-10 text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink sm:text-[22px] sm:leading-[30px]"
					>
						{t("readingTimeCalculator.page.minutesToWords.h3Habit")}
					</h3>

					<p class="mt-3 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.minutesToWords.pHabit")}
					</p>
				</div>
			</div>
		</section>

		<!-- Editorial Content: How Long Does It Take to Read Out Loud? (Speeches, Scripts & Talks) -->
		<section
			aria-labelledby="how-long-to-read-out-loud"
			class="mt-10 md:mt-12"
		>
			<div class="mx-auto max-w-[1200px] px-4 sm:px-6">
				<div class="max-w-3xl">
					<h2
						id="how-long-to-read-out-loud"
						class="text-[26px] leading-[34px] font-semibold tracking-[-0.8px] text-ink sm:text-[30px] sm:leading-[38px]"
					>
						{t("readingTimeCalculator.page.readAloud.h2")}
					</h2>

					<p class="mt-4 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.readAloud.p1")}
					</p>

					<h3
						class="mt-10 text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink sm:text-[22px] sm:leading-[30px]"
					>
						{t("readingTimeCalculator.page.readAloud.h3Chart")}
					</h3>

					<p class="mt-3 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.readAloud.pChart")}
					</p>
				</div>

				<div class="whisper-shadow mt-6 max-w-5xl overflow-x-auto rounded-md border border-hairline bg-canvas-elevated">
					<table class="w-full border-collapse text-left">
						<thead>
							<tr class="border-b border-hairline bg-canvas-muted text-[13px] font-semibold text-ink">
								<th scope="col" class="py-3.5 pl-5 pr-4">{aloudHeaders[0]}</th>
								<th scope="col" class="px-4 py-3.5">{aloudHeaders[1]}</th>
								<th scope="col" class="px-4 py-3.5">{aloudHeaders[2]}</th>
								<th scope="col" class="px-4 py-3.5">{aloudHeaders[3]}</th>
								<th scope="col" class="py-3.5 pl-4 pr-5">{aloudHeaders[4]}</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-hairline text-[14px]">
							{
								aloudRows.map((row) => (
									<tr>
										<td class="whitespace-nowrap py-3.5 pl-5 pr-4 font-semibold text-ink tabular-nums">{row[0]}</td>
										<td class="whitespace-nowrap px-4 py-3.5 font-medium text-ink tabular-nums">{row[1]}</td>
										<td class="whitespace-nowrap px-4 py-3.5 text-body tabular-nums">{row[2]}</td>
										<td class="whitespace-nowrap px-4 py-3.5 text-body tabular-nums">{row[3]}</td>
										<td class="whitespace-nowrap py-3.5 pl-4 pr-5 text-body">{row[4]}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>

				<div class="max-w-3xl">
					<h3
						class="mt-10 text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink sm:text-[22px] sm:leading-[30px]"
					>
						{t("readingTimeCalculator.page.readAloud.h3Answers")}
					</h3>

					<ul class="mt-4 list-disc space-y-3 pl-5 text-[16px] leading-relaxed text-body marker:text-mute">
						{
							aloudItems.map((item) => (
								<li>
									<strong class="font-semibold text-ink">{item.lead}</strong>{item.text}
								</li>
							))
						}
					</ul>

					<p class="mt-6 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.readAloud.ctaBefore")}<a href={getLocalizedPath("/speech-time-calculator/", locale)} class="font-medium text-ink underline decoration-hairline underline-offset-4 transition-colors hover:decoration-ink">{t("readingTimeCalculator.page.readAloud.ctaLink")}</a>{t("readingTimeCalculator.page.readAloud.ctaAfter")}
					</p>
				</div>
			</div>
		</section>

		<!-- Editorial Content: How Many Words Per Page? (Single-Spaced, Double-Spaced & Books) -->
		<section
			aria-labelledby="how-many-words-per-page"
			class="mt-10 md:mt-12"
		>
			<div class="mx-auto max-w-[1200px] px-4 sm:px-6">
				<div class="max-w-3xl">
					<h2
						id="how-many-words-per-page"
						class="text-[26px] leading-[34px] font-semibold tracking-[-0.8px] text-ink sm:text-[30px] sm:leading-[38px]"
					>
						{t("readingTimeCalculator.page.wordsPerPage.h2")}
					</h2>

					<p class="mt-4 text-[16px] leading-relaxed text-body">
						{t("readingTimeCalculator.page.wordsPerPage.p1")}
					</p>

					<h3
						class="mt-10 text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink sm:text-[22px] sm:leading-[30px]"
					>
						{t("readingTimeCalculator.page.wordsPerPage.h3Chart")}
					</h3>
				</div>

