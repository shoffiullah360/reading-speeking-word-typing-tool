---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import WordsToPagesCalculator from "../components/WordsToPagesCalculator.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";

import { getLocaleFromUrl, getLocalizedPath, localizeHtmlLinks, useTranslations } from "../i18n/ui";
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const pageTitle = t("wordsToPages.title");
const pageDescription = t("wordsToPages.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/words-to-pages/", locale));

interface FaqItem {
	question: string;
	answerHtml: string;
}

const stripHtml = (html: string) =>
	html
		.replace(/<[^>]+>/g, "")
		.replace(/&gt;/g, ">")
		.replace(/&lt;/g, "<")
		.replace(/&amp;/g, "&")
		.replace(/&quot;/g, '"');

const schemaFeatures = t.raw<string[]>("wordsToPages.page.schemaFeatures") ?? [];

const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: t("wordsToPages.name"),
	url: canonicalUrl,
	inLanguage: locale,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web, Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: schemaFeatures,
};

const faqList = t.raw<FaqItem[]>("wordsToPages.faq") ?? [];

const faqPageSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqList.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: stripHtml(item.answerHtml),
		},
	})),
};

const w2pTableHeaders = t.raw<string[]>("wordsToPages.page.w2pTableHeaders") ?? [];
const w2pTableRows = t.raw<string[][]>("wordsToPages.page.w2pTableRows") ?? [];
const p2wTableHeaders = t.raw<string[]>("wordsToPages.page.p2wTableHeaders") ?? [];
const p2wTableRows = t.raw<string[][]>("wordsToPages.page.p2wTableRows") ?? [];

const fontMatrixHeaders = t.raw<string[]>("wordsToPages.page.fontMatrixHeaders") ?? [];
const fontMatrixRows = t.raw<string[][]>("wordsToPages.page.fontMatrixRows") ?? [];
const paperMarginsCards = t.raw<string[]>("wordsToPages.page.paperMarginsCards") ?? [];

const academicHeaders = t.raw<string[]>("wordsToPages.page.academicHeaders") ?? [];
const academicRows = t.raw<string[][]>("wordsToPages.page.academicRows") ?? [];

const bookTrimHeaders = t.raw<string[]>("wordsToPages.page.bookTrimHeaders") ?? [];
const bookTrimRows = t.raw<string[][]>("wordsToPages.page.bookTrimRows") ?? [];

const milestonesItems = t.raw<string[]>("wordsToPages.page.milestonesItems") ?? [];
const realWorldHeaders = t.raw<string[]>("wordsToPages.page.realWorldHeaders") ?? [];
const realWorldRows = t.raw<string[][]>("wordsToPages.page.realWorldRows") ?? [];

const stepsItems = t.raw<string[]>("wordsToPages.page.stepsItems") ?? [];
const tipsItems = t.raw<string[]>("wordsToPages.page.tipsItems") ?? [];
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(softwareAppSchema)}
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify(faqPageSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					{t("wordsToPages.h1")}
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					{t("wordsToPages.page.subtitle")}
				</p>
			</div>
		</section>

		<!-- Interactive Words to Pages Calculator Workspace -->
		<WordsToPagesCalculator locale={locale} />

		<!-- Section 1: Quick Reference Charts & Formula Cards -->
		<section class="mx-auto max-w-[1200px] space-y-6 border-t border-hairline px-4 pt-10 pb-16 sm:px-6 md:mt-12 md:pt-12">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("wordsToPages.page.s1Title")}
			</h2>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={localizeHtmlLinks(t("wordsToPages.page.s1IntroHtml"), locale)}
			/>

			<!-- 2-Column Side-by-Side Tables -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				<!-- Left Card: Words to Pages Conversion Table -->
				<div class="flex flex-col rounded-xl border border-hairline bg-canvas-elevated">
					<div class="border-b border-hairline px-4 py-3.5 sm:px-5">
						<h3 class="text-lg font-semibold tracking-tight text-ink">
							{t("wordsToPages.page.w2pTableTitle")}
						</h3>
					</div>
					<div class="overflow-x-auto">
						<table class="w-full min-w-[500px] border-collapse text-left text-[14px]">
							<thead>
								<tr class="border-b border-hairline bg-canvas text-[13px] font-semibold text-ink">
									{w2pTableHeaders.map((header) => (
										<th class="px-4 py-3">{header}</th>
									))}
								</tr>
							</thead>
							<tbody class="divide-y divide-hairline text-body">
								{w2pTableRows.map((row) => (
									<tr>
										{row.map((cell, idx) => (
											<td class={idx === 0 ? "px-4 py-3 font-medium text-ink tabular-nums" : "px-4 py-3 tabular-nums"}>
												{cell}
											</td>
										))}
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Right Card: Pages to Words Conversion Table -->
				<div class="flex flex-col rounded-xl border border-hairline bg-canvas-elevated">
					<div class="border-b border-hairline px-4 py-3.5 sm:px-5">
						<h3 class="text-lg font-semibold tracking-tight text-ink">
							{t("wordsToPages.page.p2wTableTitle")}
						</h3>
					</div>
					<div class="overflow-x-auto">
						<table class="w-full min-w-[440px] border-collapse text-left text-[14px]">
							<thead>
								<tr class="border-b border-hairline bg-canvas text-[13px] font-semibold text-ink">
									{p2wTableHeaders.map((header) => (
										<th class="px-4 py-3">{header}</th>
									))}
								</tr>
							</thead>
							<tbody class="divide-y divide-hairline text-body">
								{p2wTableRows.map((row) => (
									<tr>
										{row.map((cell, idx) => (
											<td class={idx === 0 ? "px-4 py-3 font-medium text-ink tabular-nums" : "px-4 py-3 tabular-nums"}>
												{cell}
											</td>
										))}
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>
			</div>

			<!-- 2-Column Formula Cards Directly Below -->
			<div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
				<div
					class="rounded-xl border border-hairline bg-canvas-elevated p-5 text-[14.5px] leading-relaxed text-body"
					set:html={localizeHtmlLinks(t("wordsToPages.page.formulaW2pHtml"), locale)}
				/>
				<div
					class="rounded-xl border border-hairline bg-canvas-elevated p-5 text-[14.5px] leading-relaxed text-body"
					set:html={localizeHtmlLinks(t("wordsToPages.page.formulaP2wHtml"), locale)}
				/>
			</div>
		</section>

		<!-- Section 2: Words Per Page by Font Family, Font Size & Paper Size -->
		<section class="mx-auto max-w-[1200px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("wordsToPages.page.s2Title")}
			</h2>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={localizeHtmlLinks(t("wordsToPages.page.s2IntroHtml"), locale)}
			/>

			<!-- Font & Size Matrix Card -->
			<div class="flex flex-col rounded-xl border border-hairline bg-canvas-elevated">
				<div class="border-b border-hairline px-4 py-3.5 sm:px-5">
					<h3 class="text-lg font-semibold tracking-tight text-ink">
						{t("wordsToPages.page.fontMatrixTitle")}
					</h3>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full min-w-[640px] border-collapse text-left text-[14px]">
						<thead>
							<tr class="border-b border-hairline bg-canvas text-[13px] font-semibold text-ink">
								{fontMatrixHeaders.map((header) => (
									<th class="px-4 py-3">{header}</th>
								))}
							</tr>
						</thead>
						<tbody class="divide-y divide-hairline text-body">
							{fontMatrixRows.map((row) => (
								<tr>
									{row.map((cell, idx) => (
										<td class={idx === 0 ? "px-4 py-3 font-medium text-ink" : "px-4 py-3 tabular-nums"}>
											{cell}
										</td>
									))}
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

			<!-- Paper Size & Margins Card -->
			<div class="rounded-xl border border-hairline bg-canvas-elevated p-5 sm:p-6 space-y-4">
				<h3 class="text-lg font-semibold tracking-tight text-ink">
					{t("wordsToPages.page.paperMarginsTitle")}
				</h3>

				<div class="grid gap-5 md:grid-cols-3">
					{paperMarginsCards.map((cardHtml) => (
						<div
							class="text-[14.5px] leading-relaxed text-body"
							set:html={localizeHtmlLinks(cardHtml, locale)}
						/>
					))}
				</div>
			</div>
		</section>

		<!-- Section 3: Academic Style Guides & Book / Novel Page Benchmarks -->
		<section class="mx-auto max-w-[1200px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("wordsToPages.page.s3Title")}
			</h2>

			<p
				class="text-[16px] leading-relaxed text-body"
				set:html={localizeHtmlLinks(t("wordsToPages.page.s3IntroHtml"), locale)}
			/>

			<!-- Academic Formatting Card -->
			<div class="flex flex-col rounded-xl border border-hairline bg-canvas-elevated">
				<div class="border-b border-hairline px-4 py-3.5 sm:px-5">
					<h3 class="text-lg font-semibold tracking-tight text-ink">
						{t("wordsToPages.page.academicTitle")}
					</h3>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full min-w-[640px] border-collapse text-left text-[14px]">
						<thead>
							<tr class="border-b border-hairline bg-canvas text-[13px] font-semibold text-ink">
								{academicHeaders.map((header) => (
									<th class="px-4 py-3">{header}</th>
								))}
							</tr>
						</thead>
						<tbody class="divide-y divide-hairline text-body">
							{academicRows.map((row) => (
								<tr>
									<td class="px-4 py-3 font-medium text-ink">{row[0]}</td>
									<td class="px-4 py-3">{row[1]}</td>
									<td class="px-4 py-3">{row[2]}</td>
									<td class="px-4 py-3 tabular-nums">{row[3]}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<div class="border-t border-hairline px-4 py-3 sm:px-5">
					<p class="text-[13px] italic text-muted">
						{t("wordsToPages.page.academicNote")}
					</p>
				</div>
			</div>

			<!-- Book Trim Sizes & Fiction Card -->
			<div class="flex flex-col rounded-xl border border-hairline bg-canvas-elevated">
				<div class="border-b border-hairline px-4 py-3.5 sm:px-5">
					<h3 class="text-lg font-semibold tracking-tight text-ink">
						{t("wordsToPages.page.bookTrimTitle")}
					</h3>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full min-w-[640px] border-collapse text-left text-[14px]">
						<thead>
							<tr class="border-b border-hairline bg-canvas text-[13px] font-semibold text-ink">
								{bookTrimHeaders.map((header) => (
									<th class="px-4 py-3">{header}</th>
								))}
							</tr>
						</thead>
						<tbody class="divide-y divide-hairline text-body">
							{bookTrimRows.map((row) => (
								<tr>
									<td class="px-4 py-3 font-medium text-ink">{row[0]}</td>
									<td class="px-4 py-3">{row[1]}</td>
									<td class="px-4 py-3 tabular-nums">{row[2]}</td>
									<td class="px-4 py-3 tabular-nums">{row[3]}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<!-- Section 4: Common Word-to-Page Breakdowns & Real-World Book Examples -->
		<section class="mx-auto max-w-[1200px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("wordsToPages.page.s4Title")}
			</h2>

			<p class="text-[16px] leading-relaxed text-body">
				{t("wordsToPages.page.s4Intro")}
			</p>

			<!-- Direct Milestone Breakdown Card -->
			<div class="rounded-xl border border-hairline bg-canvas-elevated p-5 sm:p-6">
				<h3 class="text-lg font-semibold tracking-tight text-ink">
					{t("wordsToPages.page.milestonesTitle")}
				</h3>

				<ul class="mt-4 grid gap-4 sm:grid-cols-2 text-[14.5px] leading-relaxed text-body">
					{milestonesItems.map((itemHtml, idx) => (
						<li
							class={
								idx === milestonesItems.length - 1
									? "flex items-start gap-2.5 sm:col-span-2"
									: "flex items-start gap-2.5"
							}
						>
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-vercel-blue"></span>
							<div set:html={localizeHtmlLinks(itemHtml, locale)} />
						</li>
					))}
				</ul>
			</div>

			<!-- Real-World Benchmarks Table Card -->
			<div class="flex flex-col rounded-xl border border-hairline bg-canvas-elevated">
				<div class="border-b border-hairline px-4 py-3.5 sm:px-5">
					<h3 class="text-lg font-semibold tracking-tight text-ink">
						{t("wordsToPages.page.realWorldTitle")}
					</h3>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full min-w-[640px] border-collapse text-left text-[14px]">
						<thead>
							<tr class="border-b border-hairline bg-canvas text-[13px] font-semibold text-ink">
								{realWorldHeaders.map((header) => (
									<th class="px-4 py-3">{header}</th>
								))}
							</tr>
						</thead>
						<tbody class="divide-y divide-hairline text-body">
							{realWorldRows.map((row) => (
								<tr>
									<td class="px-4 py-3 font-medium text-ink">{row[0]}</td>
									<td class="px-4 py-3 tabular-nums">{row[1]}</td>
									<td class="px-4 py-3 tabular-nums">{row[2]}</td>
									<td class="px-4 py-3">{row[3]}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<!-- Section 5: How to Use the Words to Pages Converter & Tips to Hit Your Page Target -->
		<section class="mx-auto max-w-[1200px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("wordsToPages.page.s5Title")}
			</h2>

			<!-- 2-Column Layout -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				<!-- Left Card: How to Convert Words to Pages (or Pages to Words) in 3 Steps -->
				<div class="rounded-xl border border-hairline bg-canvas-elevated p-5 sm:p-6 space-y-4">
					<h3 class="text-lg font-semibold tracking-tight text-ink">
						{t("wordsToPages.page.stepsTitle")}
					</h3>

					<ol class="space-y-4 text-[14.5px] leading-relaxed text-body">
						{stepsItems.map((stepHtml, idx) => (
							<li class="flex items-start gap-3">
								<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[12px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]">
									{idx + 1}
								</span>
								<div set:html={localizeHtmlLinks(stepHtml, locale)} />
							</li>
						))}
					</ol>
				</div>

				<!-- Right Card: Practical Writing Tips to Hit—or Trim—Your Target Page Count -->
				<div class="rounded-xl border border-hairline bg-canvas-elevated p-5 sm:p-6 space-y-4">
					<h3 class="text-lg font-semibold tracking-tight text-ink">
						{t("wordsToPages.page.tipsTitle")}
					</h3>

					<ul class="space-y-4 text-[14.5px] leading-relaxed text-body">
						{tipsItems.map((tipHtml) => (
							<li class="flex items-start gap-2.5">
								<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-vercel-blue"></span>
								<div set:html={localizeHtmlLinks(tipHtml, locale)} />
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>

		<!-- Section 6: Frequently Asked Questions -->
		<section class="mx-auto max-w-[1200px] space-y-6 border-t border-hairline px-4 pt-12 pb-16 sm:px-6 md:pt-16">
			<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
				{t("wordsToPages.page.faqTitle")}
			</h2>

			<div class="divide-y divide-hairline rounded-2xl border border-hairline bg-canvas-elevated">
				{faqList.map((item, idx) => (
					<details class="group p-5 sm:p-6" open={idx === 0}>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-semibold text-ink">
							<span>{item.question}</span>
							<span class="text-muted transition-transform duration-200 group-open:rotate-45">+</span>
						</summary>
						<p
							class="mt-3 text-[15px] leading-relaxed text-body"
							set:html={localizeHtmlLinks(item.answerHtml, locale)}
						/>
					</details>
				))}
			</div>
		</section>
	</main>

	<Footer />
</Layout>
