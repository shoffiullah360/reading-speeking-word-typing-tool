				<!-- Bijoy: keyboard layout first, row-by-row key tables directly below it -->
				<article class="bp-guide bp-guide-sand min-w-0">
					<h3 class="bangla-copy text-[17px] font-semibold text-ink">বিজয় কিবোর্ড</h3>
					<p class="bangla-copy mt-2 text-[14px] leading-relaxed text-body">
						বিজয় লেআউটে প্রতিটি ইংরেজি কী-এর সঙ্গে নির্দিষ্ট বাংলা অক্ষর যুক্ত থাকে। নিচের
						কীবোর্ডে Normal স্তর দেখানো হয়েছে; Shift বেছে নিলে একই কী-গুলোর দ্বিতীয় স্তর দেখা যাবে।
					</p>

					<div class="bp-kb-block" data-kb="bijoy">
						<p class="bp-kb-title">বিজয় কিবোর্ড</p>
						<div class="bp-layer-switch" role="radiogroup" aria-label="বিজয় কীবোর্ডের স্তর">
							<div class="bp-layer-option">
								<input
									type="radio"
									name="bijoy-layer"
									id="bijoy-layer-normal"
									class="bp-layer-input"
									checked
								/>
								<label class="bp-layer-label" for="bijoy-layer-normal">Normal</label>
							</div>
							<div class="bp-layer-option">
								<input
									type="radio"
									name="bijoy-layer"
									id="bijoy-layer-shift"
									class="bp-layer-input"
								/>
								<label class="bp-layer-label" for="bijoy-layer-shift">Shift</label>
							</div>
						</div>
						<div
							class="bp-kb"
							role="img"
							aria-label="বিজয় কীবোর্ড লেআউট: সংখ্যা সারি, টপ রো, হোম রো ও বটম রো"
						>
							{
								bijoyKeyboardRows.map((row) => (
									<div class="bp-kb-row">
