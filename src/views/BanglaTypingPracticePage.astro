										<div class="bp-kb-keys">
											{row.keys.map((cap) => (
												<div class="bp-kb-key">
													<span class="bp-kb-key-latin">{cap.key}</span>
													<span class="bp-kb-key-layers">
														<span class="bp-kb-key-bn bp-kb-key-normal" lang="bn">
															{cap.normal}
														</span>
														<span class="bp-kb-key-bn bp-kb-key-shift" lang="bn">
															{cap.shift}
														</span>
													</span>
												</div>
											))}
										</div>
									</div>
								))
							}
						</div>
						<p class="bp-kb-note">
							◌ চিহ্নটির মানে, ওই জায়গায় একটি ব্যঞ্জনবর্ণ বসবে। বিজয়ে
							<span class="bp-inkey">ি</span> ও <span class="bp-inkey">ে</span> কার আগে লিখে তারপর
							ব্যঞ্জনবর্ণ লিখতে হয়—<span class="bp-inkey">ি</span> + ক = কি। স্বর ও ব্যঞ্জন একই
							কী-এর দুই স্তরে ভাগ থাকে: <span class="bp-inkey">O</span> = গ,
							<span class="bp-inkey">Shift+O</span> = ঘ।
						</p>
					</div>

					<div class="bp-map-stack">
						{
							bijoyKeyboardRows.map((row) => (
