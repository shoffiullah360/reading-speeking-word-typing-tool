---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import BanglaTypingPractice from "../components/BanglaTypingPractice.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl, STANDALONE_TOOLS } from "../config/site";
import {
	BIJOY_SIGN_EXAMPLES,
	INPUT_SETUP_STEPS,
	TYPING_MISTAKES,
} from "../data/banglaKeyboardGuide";

// Root-level Bengali page: single canonical URL, <html lang="bn">, no hreflang alternates.
const pageTitle = "বাংলা টাইপিং প্র্যাকটিস – শিখুন ও অনুশীলন করুন | Wordora";
const pageDescription =
	"নতুনদের জন্য বিনামূল্যে বাংলা টাইপিং প্র্যাকটিস করুন। স্বরবর্ণ, ব্যঞ্জনবর্ণ, শব্দ ও বাক্য টাইপ শিখুন, ভুল সংশোধন করুন এবং নিজের অগ্রগতি দেখুন।";
const canonicalUrl = resolveCanonicalUrl("/bangla-typing-practice/");
const practiceTool = STANDALONE_TOOLS.find((tool) => tool.id === "bangla-typing-practice");

const bengaliDigits = (value: number) =>
	String(value).replace(/[0-9]/g, (digit) => "০১২৩৪৫৬৭৮৯"[Number(digit)]);

/** Avro phonetic examples only — Wordora itself does not convert Latin input to Bengali. */
const phoneticExamples = [
	{ input: "ami", output: "আমি" },
	{ input: "bangla", output: "বাংলা" },
	{ input: "amar", output: "আমার" },
	{ input: "tumi", output: "তুমি" },
];

/** Rotating palette tone for the mistakes grid. */
const guideTones = ["mint", "sand", "orange"] as const;

/**
 * Avro phonetic key → Bengali, on a US QWERTY board.
 * Taken from the Avro phonetic rule set (jsAvroPhonetic), not guessed.
 */
const avroKeyboardRows = [
	{
		label: "সংখ্যা সারি",
		keys: [
			{ key: "1", bn: "১" },
			{ key: "2", bn: "২" },
			{ key: "3", bn: "৩" },
			{ key: "4", bn: "৪" },
			{ key: "5", bn: "৫" },
			{ key: "6", bn: "৬" },
			{ key: "7", bn: "৭" },
			{ key: "8", bn: "৮" },
			{ key: "9", bn: "৯" },
			{ key: "0", bn: "০" },
		],
	},
	{
		label: "টপ রো (Q–P)",
		keys: [
			{ key: "q", bn: "ক" },
			{ key: "w", bn: "ও" },
			{ key: "e", bn: "এ" },
			{ key: "r", bn: "র" },
			{ key: "t", bn: "ত" },
			{ key: "y", bn: "য়" },
			{ key: "u", bn: "উ" },
			{ key: "i", bn: "ই" },
			{ key: "o", bn: "অ" },
			{ key: "p", bn: "প" },
		],
	},
	{
		label: "হোম রো (A–L)",
		keys: [
			{ key: "a", bn: "আ" },
			{ key: "s", bn: "স" },
			{ key: "d", bn: "দ" },
			{ key: "f", bn: "ফ" },
			{ key: "g", bn: "গ" },
			{ key: "h", bn: "হ" },
			{ key: "j", bn: "জ" },
			{ key: "k", bn: "ক" },
			{ key: "l", bn: "ল" },
		],
	},
	{
		label: "বটম রো (Z–M)",
		keys: [
			{ key: "z", bn: "য" },
			{ key: "x", bn: "ক্স" },
			{ key: "c", bn: "চ" },
			{ key: "v", bn: "ভ" },
			{ key: "b", bn: "ব" },
			{ key: "n", bn: "ন" },
			{ key: "m", bn: "ম" },
		],
	},
];

/** Independent vowels in Avro phonetic. */
const avroVowels = [
	{ input: "o", output: "অ" },
	{ input: "a", output: "আ" },
	{ input: "i", output: "ই" },
	{ input: "I", output: "ঈ" },
	{ input: "u", output: "উ" },
	{ input: "U", output: "ঊ" },
	{ input: "rri", output: "ঋ" },
	{ input: "e", output: "এ" },
	{ input: "OI", output: "ঐ" },
	{ input: "O", output: "ও" },
	{ input: "OU", output: "ঔ" },
];

/** Vowel signs: the same keys once a consonant comes first. */
const avroKars = [
	{ input: "a", sign: "◌া", example: "ka → কা" },
	{ input: "i", sign: "◌ি", example: "ki → কি" },
	{ input: "I", sign: "◌ী", example: "kI → কী" },
	{ input: "u", sign: "◌ু", example: "ku → কু" },
	{ input: "U", sign: "◌ূ", example: "kU → কূ" },
	{ input: "rri", sign: "◌ৃ", example: "krri → কৃ" },
	{ input: "e", sign: "◌ে", example: "ke → কে" },
	{ input: "OI", sign: "◌ৈ", example: "kOI → কৈ" },
	{ input: "O", sign: "◌ো", example: "kO → কো" },
	{ input: "OU", sign: "◌ৌ", example: "kOU → কৌ" },
	{ input: ",,", sign: "◌্", example: "k,, → ক্" },
];

const avroConsonants = [
	{ input: "k", output: "ক" },
	{ input: "kh", output: "খ" },
	{ input: "g", output: "গ" },
	{ input: "gh", output: "ঘ" },
	{ input: "Ng", output: "ঙ" },
	{ input: "c", output: "চ" },
	{ input: "ch", output: "ছ" },
	{ input: "j", output: "জ" },
	{ input: "jh", output: "ঝ" },
	{ input: "NG", output: "ঞ" },
	{ input: "T", output: "ট" },
	{ input: "Th", output: "ঠ" },
	{ input: "D", output: "ড" },
	{ input: "Dh", output: "ঢ" },
	{ input: "N", output: "ণ" },
	{ input: "t", output: "ত" },
	{ input: "th", output: "থ" },
	{ input: "d", output: "দ" },
	{ input: "dh", output: "ধ" },
	{ input: "n", output: "ন" },
	{ input: "p", output: "প" },
	{ input: "ph / f", output: "ফ" },
	{ input: "b", output: "ব" },
	{ input: "bh / v", output: "ভ" },
	{ input: "m", output: "ম" },
	{ input: "z", output: "য" },
	{ input: "r", output: "র" },
	{ input: "l", output: "ল" },
	{ input: "sh / S", output: "শ" },
	{ input: "Sh", output: "ষ" },
	{ input: "s", output: "স" },
	{ input: "h", output: "হ" },
	{ input: "R", output: "ড়" },
	{ input: "Rh", output: "ঢ়" },
	{ input: "y", output: "য়" },
	{ input: "q", output: "ক" },
	{ input: "x", output: "ক্স" },
];

/** Conjuncts and phalas Avro builds as you keep typing. */
const avroConjuncts = [
	{ input: "kk", output: "ক্ক", kind: "যুক্তাক্ষর" },
	{ input: "kkh / kSh", output: "ক্ষ", kind: "যুক্তাক্ষর" },
	{ input: "gg / jNG", output: "জ্ঞ", kind: "যুক্তাক্ষর" },
	{ input: "nt", output: "ন্ত", kind: "যুক্তাক্ষর" },
	{ input: "ndh", output: "ন্ধ", kind: "যুক্তাক্ষর" },
	{ input: "st", output: "স্ত", kind: "যুক্তাক্ষর" },
	{ input: "ky", output: "ক্য", kind: "য-ফলা" },
	{ input: "kri", output: "ক্রি", kind: "র-ফলা" },
	{ input: ",,", output: "◌্", kind: "হসন্ত" },
];

const avroSymbols = [
	{ input: "1 – 0", output: "১ – ০" },
	{ input: ".", output: "।" },
	{ input: "..", output: "।।" },
	{ input: ":", output: "ঃ" },
	{ input: "^", output: "ঁ" },
	{ input: ",,", output: "◌্" },
	{ input: "t``", output: "ৎ" },
	{ input: "$", output: "৳" },
];

/**
 * Bijoy row-by-row layout. Normal and Shift values follow the published Bijoy
 * chart; ◌ marks the spot where a consonant or vowel joins the sign.
 */
const bijoyKeyboardRows = [
	{
		label: "সংখ্যা সারি",
		keys: [
			{ key: "1", normal: "১", shift: "!" },
			{ key: "2", normal: "২", shift: "@" },
			{ key: "3", normal: "৩", shift: "#" },
			{ key: "4", normal: "৪", shift: "৳" },
			{ key: "5", normal: "৫", shift: "%" },
			{ key: "6", normal: "৬", shift: "÷" },
			{ key: "7", normal: "৭", shift: "ঁ" },
			{ key: "8", normal: "৮", shift: "×" },
			{ key: "9", normal: "৯", shift: "(" },
			{ key: "0", normal: "০", shift: ")" },
		],
	},
	{
		label: "টপ রো (Q–P)",
		keys: [
			{ key: "Q", normal: "ঙ", shift: "ং" },
			{ key: "W", normal: "য", shift: "য়" },
			{ key: "E", normal: "ড", shift: "ঢ" },
			{ key: "R", normal: "প", shift: "ফ" },
			{ key: "T", normal: "ট", shift: "ঠ" },
			{ key: "Y", normal: "চ", shift: "ছ" },
			{ key: "U", normal: "জ", shift: "ঝ" },
			{ key: "I", normal: "হ", shift: "ঞ" },
			{ key: "O", normal: "গ", shift: "ঘ" },
			{ key: "P", normal: "ড়", shift: "ঢ়" },
		],
	},
	{
		label: "হোম রো (A–L)",
		keys: [
			{ key: "A", normal: "◌ৃ", shift: "র্" },
			{ key: "S", normal: "◌ু", shift: "◌ূ" },
			{ key: "D", normal: "◌ি", shift: "◌ী" },
			{ key: "F", normal: "◌া", shift: "অ" },
			{ key: "G", normal: "◌্", shift: "।" },
			{ key: "H", normal: "ব", shift: "ভ" },
			{ key: "J", normal: "ক", shift: "খ" },
			{ key: "K", normal: "ত", shift: "থ" },
			{ key: "L", normal: "দ", shift: "ধ" },
		],
	},
	{
		label: "বটম রো (Z–M)",
		keys: [
			{ key: "Z", normal: "◌্র", shift: "◌্য" },
			{ key: "X", normal: "ও", shift: "◌ৌ" },
			{ key: "C", normal: "◌ে", shift: "◌ৈ" },
			{ key: "V", normal: "র", shift: "ল" },
			{ key: "B", normal: "ন", shift: "ণ" },
			{ key: "N", normal: "স", shift: "ষ" },
			{ key: "M", normal: "ম", shift: "শ" },
		],
	},
];

const structuredData = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	name: practiceTool?.name ?? "বাংলা টাইপিং প্র্যাকটিস",
	url: canonicalUrl,
	inLanguage: "bn",
	applicationCategory: "EducationalApplication",
	operatingSystem: "Web",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "BDT",
	},
	description: pageDescription,
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
	htmlLang="bn"
	ogLocale="bn_BD"
	robots="index, follow"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</Fragment>

	<Header />

	<main class="bangla-page flex-1">
		<!-- Hero: soft mint band with a three-step start hint -->
		<section class="bp-hero px-4 pt-10 pb-9 sm:px-6 sm:pt-14 sm:pb-11">
			<div class="mx-auto max-w-[1100px]">
				<p class="bangla-copy bp-eyebrow text-[13px] font-medium">টাইপিং অনুশীলন</p>
				<h1
					class="bangla-copy mt-2 text-[32px] leading-[42px] font-semibold tracking-[-1.2px] text-ink sm:text-[42px] sm:leading-[52px] sm:tracking-[-1.6px]"
				>
					বাংলা টাইপিং প্র্যাকটিস
				</h1>
				<p class="bangla-copy mt-3 max-w-2xl text-[16px] leading-[26px] text-body">
					স্বরবর্ণ থেকে অনুচ্ছেদ—নিজের গতিতে অনুশীলন করুন, ভুল হলে সঙ্গে সঙ্গে সংশোধন করুন আর অগ্রগতি
					নিজের ব্রাউজারেই জমা রাখুন।
				</p>

				<!-- 3-step start hint -->
				<ol class="bp-steps bangla-copy mt-6" aria-label="শুরুর তিন ধাপ">
					<li class="bp-step" data-tone="mint">
						<span class="bp-step-num" aria-hidden="true">১</span>
						<span>শিখুন</span>
					</li>
					<li class="bp-step-arrow" aria-hidden="true">→</li>
					<li class="bp-step" data-tone="sand">
						<span class="bp-step-num" aria-hidden="true">২</span>
						<span>অনুশীলন করুন</span>
					</li>
					<li class="bp-step-arrow" aria-hidden="true">→</li>
					<li class="bp-step" data-tone="orange">
						<span class="bp-step-num" aria-hidden="true">৩</span>
						<span>ভুল সংশোধন করুন</span>
					</li>
				</ol>

				<p class="bangla-copy mt-4 text-[13px] text-mute">
					ব্রাউজারেই চলে &middot; কোনো অ্যাকাউন্ট লাগে না &middot; সম্পূর্ণ বিনামূল্যে
				</p>
			</div>
		</section>

		<!-- Interactive typing workspace -->
		<section
			id="practice"
			aria-labelledby="practice-heading"
			class="mx-auto max-w-[1100px] px-4 pt-8 pb-2 sm:px-6"
		>
			<div class="mb-3.5 flex flex-wrap items-end justify-between gap-2">
				<h2
					id="practice-heading"
					class="bangla-copy text-[20px] leading-[28px] font-semibold tracking-[-0.4px] text-ink"
				>
					অনুশীলন ক্ষেত্র
				</h2>
				<p class="bangla-copy text-[13px] text-mute">
					আগে স্তর ও কীবোর্ড বেছে নিন, তারপর পাঠ শুরু করুন বা অনুশীলনের ধরন বেছে নিন।
				</p>
			</div>

			<div id="typing-workspace">
				<BanglaTypingPractice />
			</div>
		</section>

		<!-- Keyboard input guidance: the learner's own IME produces the Bengali text -->
		<section aria-labelledby="input-guide-heading" class="mx-auto max-w-[1100px] px-4 py-10 sm:px-6">
			<div class="max-w-3xl">
				<h2
					id="input-guide-heading"
					class="bangla-copy text-[24px] leading-[32px] font-semibold tracking-[-0.8px] text-ink sm:text-[28px]"
				>
					বাংলা কীভাবে টাইপ করবেন
				</h2>
				<p class="bangla-copy mt-2 text-[15px] leading-relaxed text-body">
					Wordora নিজে কোনো ফোনেটিক বা বিজয় রূপান্তর ইঞ্জিন চালায় না। আপনার কম্পিউটারে ইনস্টল করা
					অভ্র, বিজয় বা অন্য বাংলা ইনপুট পদ্ধতি দিয়েই বাংলা অক্ষর তৈরি হয়, আর সেই লেখা এখানে হুবহু
					মিলিয়ে দেখা হয়।
				</p>
				<p class="bangla-copy bp-note mt-3 text-[13px] leading-relaxed text-body">
					মনে রাখুন: Wordora আপনার ইনস্টল করা বাংলা ইনপুট সফটওয়্যারের বিকল্প নয়। এটি OS-স্তরের কোনো
					কিবোর্ড ইনস্টল করে না বা বদলায় না—আপনার কম্পিউটারে থাকা অভ্র, বিজয় বা অন্য ইউনিকোড বাংলা
					ইনপুট পদ্ধতিই বাংলা অক্ষর তৈরি করে।
				</p>

				<h3 class="bangla-copy mt-6 text-[16px] font-semibold text-ink">বাংলা ইনপুট চালু করার ধাপ</h3>
				<ol class="bp-setup" aria-label="বাংলা ইনপুট চালু করার চার ধাপ">
					{
						INPUT_SETUP_STEPS.map((step, index) => (
							<li class="bp-setup-item">
								<span class="bp-setup-num tabular-nums" aria-hidden="true">
									{bengaliDigits(index + 1)}
								</span>
								<div class="min-w-0">
									<p class="bp-setup-title">{step.title}</p>
									<p class="bp-setup-body">{step.body}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>

			<div class="mt-6 flex flex-col gap-5">
				<!-- Avro: keyboard layout first, mapping rows and tables directly below it -->
				<article class="bp-guide bp-guide-mint min-w-0">
					<h3 class="bangla-copy text-[17px] font-semibold text-ink">অভ্র ফোনেটিক</h3>
					<p class="bangla-copy mt-2 text-[14px] leading-relaxed text-body">
						অভ্র ফোনেটিকে ইংরেজি বর্ণে লিখলে বাংলা অক্ষর আসে। নিচের কীবোর্ডে প্রতিটি ইংরেজি কী-এর
						নিচে সেই কী থেকে তৈরি হওয়া মূল বাংলা অক্ষর দেখানো হয়েছে।
					</p>

					<div class="bp-kb-block">
						<p class="bp-kb-title">অভ্র ফোনেটিক কীবোর্ড</p>
						<div
							class="bp-kb"
							role="img"
							aria-label="অভ্র ফোনেটিক কীবোর্ড লেআউট: সংখ্যা সারি, টপ রো, হোম রো ও বটম রো"
						>
							{
								avroKeyboardRows.map((row) => (
									<div class="bp-kb-row">
										<p class="bp-kb-rowlabel">{row.label}</p>
										<div class="bp-kb-keys">
											{row.keys.map((cap) => (
												<div class="bp-kb-key">
													<span class="bp-kb-key-latin">{cap.key}</span>
													<span class="bp-kb-key-bn">{cap.bn}</span>
												</div>
											))}
										</div>
									</div>
								))
							}
						</div>
						<p class="bp-kb-note">
							একাধিক কী মিলেও একটি বর্ণ তৈরি হয়—<span class="bp-inkey">ch</span> → ছ,
							<span class="bp-inkey">kkh</span> → ক্ষ। বড় হাতের অক্ষর আলাদা বর্ণ দেয়:
							<span class="bp-inkey">T</span> → ট, <span class="bp-inkey">D</span> → ড,
							<span class="bp-inkey">N</span> → ণ, <span class="bp-inkey">Sh</span> → ষ।
						</p>
					</div>

