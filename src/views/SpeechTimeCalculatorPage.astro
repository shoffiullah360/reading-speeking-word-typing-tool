---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SpeechCalculator from "../components/SpeechCalculator.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";
import { getLocaleFromUrl, getLocalizedPath, localizeHtmlLinks, useTranslations } from "../i18n/ui";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

interface FaqItem {
	question: string;
	answer: string;
}

interface HowToStep {
	title: string;
	bodyHtml: string;
}

interface MinutesToWordsRow {
	length: string;
	slow: string;
	avg: string;
	fast: string;
	safe: string;
}

interface WordsToMinutesRow {
	words: string;
	slow: string;
	avg: string;
	fast: string;
	silent: string;
}

interface PaceItem {
	wpm: string;
	title: string;
	description: string;
}

const pageTitle = t("speechCalculator.title");
const pageDescription = t("speechCalculator.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/speech-time-calculator/", locale));

const faqs = t.raw<FaqItem[]>("speechCalculator.faq.items") ?? [];
const featureList = t.raw<string[]>("speechCalculator.schema.featureList") ?? [];
const howToSteps = t.raw<HowToStep[]>("speechCalculator.page.howTo.steps") ?? [];
const minutesToWordsHeaders = t.raw<string[]>("speechCalculator.page.minutesToWords.headers") ?? [];
const minutesToWordsData = t.raw<MinutesToWordsRow[]>("speechCalculator.page.minutesToWords.rows") ?? [];
const wordsToMinutesHeaders = t.raw<string[]>("speechCalculator.page.wordsToMinutes.headers") ?? [];
const wordsToMinutesData = t.raw<WordsToMinutesRow[]>("speechCalculator.page.wordsToMinutes.rows") ?? [];
const paceItems = t.raw<PaceItem[]>("speechCalculator.page.mathAndRates.paceCard.items") ?? [];

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebApplication",
			name: t("speechCalculator.name"),
			url: canonicalUrl,
			inLanguage: locale,
			applicationCategory: "UtilitiesApplication",
			operatingSystem: "All",
			offers: {
				"@type": "Offer",
				price: "0",
				priceCurrency: "USD",
			},
			description: pageDescription,
			featureList,
		},
		{
			"@type": "FAQPage",
			inLanguage: locale,
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: faq.answer,
				},
			})),
		},
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					{t("speechCalculator.h1")}
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					{t("speechCalculator.page.heroSubtitle")}
				</p>
			</div>
		</section>

		<!-- Flagship Interactive Speech Time Calculator Workspace -->
		<SpeechCalculator locale={locale} />

		<!-- Section 1: How to Convert Words to Minutes -->
		<section class="mx-auto max-w-[1140px] px-4 pb-16 sm:px-6">
			<div class="mb-8">
				<h2
					class="font-sans text-[24px] font-semibold tracking-[-0.8px] text-ink sm:text-[28px] sm:tracking-[-1px]"
				>
					{t("speechCalculator.page.howTo.heading")}
				</h2>
				<p class="mt-2 text-[15px] leading-relaxed text-body">
					{t("speechCalculator.page.howTo.intro")}
				</p>
			</div>

			<div class="grid grid-cols-1 gap-5 md:grid-cols-3">
				{
					howToSteps.map((step, idx) => (
						<div
							class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
						>
							<div>
								<div class="mb-4 flex items-center gap-3">
									<span
										class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
									>
										{idx + 1}
									</span>
									<h3 class="font-sans text-[16px] font-semibold text-ink">
										{step.title}
									</h3>
								</div>
								<p
									class="text-[14px] leading-relaxed text-body"
									set:html={localizeHtmlLinks(step.bodyHtml, locale)}
								/>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- Section 2A: Minutes to Words Benchmark -->
		<section class="mx-auto max-w-[1140px] px-4 pb-14 sm:px-6">
			<div class="mb-6">
				<h2
					class="font-sans text-[22px] font-semibold tracking-[-0.6px] text-ink sm:text-[26px]"
				>
					{t("speechCalculator.page.minutesToWords.heading")}
				</h2>
				<p class="mt-2 text-[15px] leading-relaxed text-body">
					{t("speechCalculator.page.minutesToWords.intro")}
				</p>
			</div>

			<div class="whisper-shadow overflow-x-auto rounded-2xl border border-hairline bg-canvas-elevated">
				<table class="w-full border-collapse text-left">
					<thead>
						<tr class="border-b border-hairline bg-canvas-muted text-[13px] font-semibold text-ink">
							<th scope="col" class="py-3.5 pl-5 pr-4">{minutesToWordsHeaders[0]}</th>
							<th scope="col" class="px-4 py-3.5">{minutesToWordsHeaders[1]}</th>
							<th scope="col" class="px-4 py-3.5">{minutesToWordsHeaders[2]}</th>
							<th scope="col" class="px-4 py-3.5">{minutesToWordsHeaders[3]}</th>
							<th scope="col" class="py-3.5 pl-4 pr-5 font-semibold text-[#0f2e26] dark:text-[#afe3d0]">
								{minutesToWordsHeaders[4]}
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-hairline text-[14px]">
						{minutesToWordsData.map((row) => (
							<tr class="transition-colors hover:bg-canvas/50">
								<td class="whitespace-nowrap py-3 pl-5 pr-4 font-semibold text-ink tabular-nums">
									{row.length}
								</td>
								<td class="whitespace-nowrap px-4 py-3 text-body tabular-nums">
									{row.slow}
								</td>
								<td class="whitespace-nowrap px-4 py-3 font-medium text-ink tabular-nums">
									{row.avg}
								</td>
								<td class="whitespace-nowrap px-4 py-3 text-body tabular-nums">
									{row.fast}
								</td>
								<td class="whitespace-nowrap py-3 pl-4 pr-5 font-semibold text-[#0f2e26] tabular-nums dark:text-[#afe3d0]">
									{row.safe}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<!-- Section 2B: Words to Minutes Benchmark -->
		<section class="mx-auto max-w-[1140px] px-4 pb-16 sm:px-6">
			<div class="mb-6">
				<h2
					class="font-sans text-[22px] font-semibold tracking-[-0.6px] text-ink sm:text-[26px]"
				>
					{t("speechCalculator.page.wordsToMinutes.heading")}
				</h2>
				<p class="mt-2 text-[15px] leading-relaxed text-body">
					{t("speechCalculator.page.wordsToMinutes.intro")}
				</p>
			</div>

			<div class="whisper-shadow overflow-x-auto rounded-2xl border border-hairline bg-canvas-elevated">
				<table class="w-full border-collapse text-left">
					<thead>
						<tr class="border-b border-hairline bg-canvas-muted text-[13px] font-semibold text-ink">
							<th scope="col" class="py-3.5 pl-5 pr-4">{wordsToMinutesHeaders[0]}</th>
							<th scope="col" class="px-4 py-3.5">{wordsToMinutesHeaders[1]}</th>
							<th scope="col" class="px-4 py-3.5">{wordsToMinutesHeaders[2]}</th>
							<th scope="col" class="px-4 py-3.5">{wordsToMinutesHeaders[3]}</th>
							<th scope="col" class="py-3.5 pl-4 pr-5">{wordsToMinutesHeaders[4]}</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-hairline text-[14px]">
						{wordsToMinutesData.map((row) => (
							<tr class="transition-colors hover:bg-canvas/50">
								<td class="whitespace-nowrap py-3 pl-5 pr-4 font-semibold text-ink tabular-nums">
									{row.words}
								</td>
								<td class="whitespace-nowrap px-4 py-3 text-body tabular-nums">
									{row.slow}
								</td>
								<td class="whitespace-nowrap px-4 py-3 font-medium text-ink tabular-nums">
									{row.avg}
								</td>
								<td class="whitespace-nowrap px-4 py-3 text-body tabular-nums">
									{row.fast}
								</td>
								<td class="whitespace-nowrap py-3 pl-4 pr-5 text-mute tabular-nums">
									{row.silent}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<!-- Contextual Link Strip -->
			<div class="mt-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-hairline bg-canvas-elevated p-4 sm:px-6">
				<span class="text-[13px] font-medium text-mute">
					{t("speechCalculator.page.relatedLabel")}
				</span>
				<div class="flex flex-wrap items-center gap-3 text-[13px]">
					<a
						href={getLocalizedPath("/reading-time-calculator/", locale)}
						class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas px-3.5 py-1.5 font-medium text-ink transition-colors hover:border-[#0f2e26] hover:text-[#0f2e26] dark:hover:border-[#afe3d0] dark:hover:text-[#afe3d0]"
					>
						{t("readingTimeCalculator.shortName")} &rarr;
					</a>
					<a
						href={getLocalizedPath("/random-topic-generator/", locale)}
						class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas px-3.5 py-1.5 font-medium text-ink transition-colors hover:border-[#0f2e26] hover:text-[#0f2e26] dark:hover:border-[#afe3d0] dark:hover:text-[#afe3d0]"
					>
						{t("randomTopicGenerator.shortName")} &rarr;
					</a>
					<a
						href={getLocalizedPath("/word-counter/", locale)}
						class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas px-3.5 py-1.5 font-medium text-ink transition-colors hover:border-[#0f2e26] hover:text-[#0f2e26] dark:hover:border-[#afe3d0] dark:hover:text-[#afe3d0]"
					>
						{t("wordCounter.shortName")} &rarr;
					</a>
				</div>
			</div>
		</section>

		<!-- Section 3: How Speech Time Is Calculated & Speaking Rates by Language -->
		<section class="mx-auto max-w-[1140px] px-4 pb-16 sm:px-6">
			<div class="mb-8">
				<h2
					class="font-sans text-[22px] font-semibold tracking-[-0.6px] text-ink sm:text-[26px]"
				>
					{t("speechCalculator.page.mathAndRates.heading")}
				</h2>
				<p class="mt-2 text-[15px] leading-relaxed text-body">
					{t("speechCalculator.page.mathAndRates.intro")}
				</p>
			</div>

			<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
				<!-- Left Card: The Words-to-Minutes Math Formula -->
				<div class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:p-7 space-y-5">
					<div>
						<div class="flex items-center gap-3 border-b border-hairline pb-4">
							<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-[#0f2e26] text-[14px] font-semibold text-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]">
								&fnof;
							</span>
							<h3 class="font-sans text-[18px] font-semibold text-ink">
								{t("speechCalculator.page.mathAndRates.formulaCard.heading")}
							</h3>
						</div>

						<p class="mt-4 text-[14.5px] leading-relaxed text-body">
							{t("speechCalculator.page.mathAndRates.formulaCard.intro")}
						</p>

						<div class="mt-4 space-y-3">
							<div class="rounded-xl border border-hairline bg-canvas p-3.5">
								<span class="block text-[12px] font-medium text-mute">
									{t("speechCalculator.page.mathAndRates.formulaCard.durationLabel")}
								</span>
								<p class="mt-0.5 font-sans text-[14.5px] font-semibold text-ink tabular-nums">
									{t("speechCalculator.page.mathAndRates.formulaCard.durationFormula")}
								</p>
								<p
									class="mt-1 text-[13px] text-body tabular-nums"
									set:html={localizeHtmlLinks(t("speechCalculator.page.mathAndRates.formulaCard.durationExampleHtml"), locale)}
								/>
							</div>

							<div class="rounded-xl border border-hairline bg-canvas p-3.5">
								<span class="block text-[12px] font-medium text-mute">
									{t("speechCalculator.page.mathAndRates.formulaCard.budgetLabel")}
								</span>
								<p class="mt-0.5 font-sans text-[14.5px] font-semibold text-ink tabular-nums">
									{t("speechCalculator.page.mathAndRates.formulaCard.budgetFormula")}
								</p>
								<p
									class="mt-1 text-[13px] text-body tabular-nums"
									set:html={localizeHtmlLinks(t("speechCalculator.page.mathAndRates.formulaCard.budgetExampleHtml"), locale)}
								/>
							</div>
						</div>

						<div class="mt-5 rounded-xl border border-[#0f2e26]/15 bg-[#0f2e26]/5 p-4 dark:border-[#afe3d0]/15 dark:bg-[#afe3d0]/5">
							<div class="flex items-center gap-2">
								<span class="inline-block h-2 w-2 rounded-full bg-[#0f2e26] dark:bg-[#afe3d0]"></span>
								<h4 class="font-sans text-[14px] font-semibold text-ink">
									{t("speechCalculator.page.mathAndRates.formulaCard.bufferHeading")}
								</h4>
							</div>
							<p class="mt-1.5 text-[13.5px] leading-relaxed text-body">
								{t("speechCalculator.page.mathAndRates.formulaCard.bufferBody")}
							</p>
						</div>
					</div>
				</div>

				<!-- Right Card: Speaking Pace Guide & Multi-Language Support -->
				<div class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:p-7 space-y-5">
					<div>
						<div class="flex items-center gap-3 border-b border-hairline pb-4">
							<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-[#0f2e26] text-[14px] font-semibold text-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]">
								&bull;&bull;&bull;
							</span>
							<h3 class="font-sans text-[18px] font-semibold text-ink">
								{t("speechCalculator.page.mathAndRates.paceCard.heading")}
							</h3>
						</div>

						<p class="mt-4 text-[14.5px] leading-relaxed text-body">
							{t("speechCalculator.page.mathAndRates.paceCard.intro")}
						</p>

						<ul class="mt-3 space-y-2.5 text-[14px] leading-relaxed text-body">
							{
								paceItems.map((item) => (
									<li class="flex items-start gap-2.5">
										<span class="rounded-md border border-hairline bg-canvas px-2 py-0.5 text-[12px] font-semibold text-ink tabular-nums">
											{item.wpm}
										</span>
										<span>
											<strong class="font-semibold text-ink">{item.title}</strong> {item.description}
										</span>
									</li>
								))
							}
						</ul>

						<div class="mt-5 rounded-xl border border-hairline bg-canvas p-4">
							<h4 class="font-sans text-[14px] font-semibold text-ink">
								{t("speechCalculator.page.mathAndRates.paceCard.multilangHeading")}
							</h4>
							<p
								class="mt-1.5 text-[13.5px] leading-relaxed text-body"
								set:html={localizeHtmlLinks(t("speechCalculator.page.mathAndRates.paceCard.multilangBodyHtml"), locale)}
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Section 4: Frequently Asked Questions -->
		<section
			id="faq"
			aria-labelledby="faq-heading"
			class="mx-auto max-w-[1140px] px-4 pb-16 sm:px-6"
		>
			<div class="mb-8">
				<h2
					id="faq-heading"
					class="font-sans text-[22px] font-semibold tracking-[-0.6px] text-ink sm:text-[26px]"
				>
					{t("speechCalculator.faq.heading")}
				</h2>
				<p class="mt-2 text-[15px] leading-relaxed text-body">
					{t("speechCalculator.faq.subtitle")}
				</p>
			</div>

			<div class="divide-y divide-hairline rounded-2xl border border-hairline bg-canvas-elevated">
				{
					faqs.map((faq, idx) => (
						<details class="group p-5 sm:p-6" open={idx === 0}>
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-semibold text-ink focus:outline-none">
								<span>{faq.question}</span>
								<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-hairline text-mute transition-transform duration-200 group-open:rotate-45 group-open:border-[#0f2e26] group-open:bg-[#0f2e26] group-open:text-[#afe3d0] dark:group-open:border-[#afe3d0] dark:group-open:bg-[#afe3d0] dark:group-open:text-[#0f2e26]">
									<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
										<line x1="12" y1="5" x2="12" y2="19" />
										<line x1="5" y1="12" x2="19" y2="12" />
									</svg>
								</span>
							</summary>
							<p class="mt-3 pr-6 text-[14.5px] leading-relaxed text-body">
								{faq.answer}
							</p>
						</details>
					))
				}
			</div>
		</section>

		{/* Editorial Content & FAQ Slot — User Managed */}
		<div id="editorial-content-slot" class="mx-auto max-w-[1200px] px-4 sm:px-6"></div>
	</main>

	<Footer />
</Layout>
