---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import WordCounterTool from "../components/WordCounterTool.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";

import { getLocaleFromUrl, getLocalizedPath, localizeHtmlLinks, useTranslations } from "../i18n/ui";
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

interface FaqItem {
	question: string;
	answer: string;
	answerHtml: string;
}

interface TitleBodyCard {
	title: string;
	bodyHtml: string;
}

interface EssayStandardRow {
	type: string;
	words: string;
	pages: string;
	readingTime: string;
}

interface CharacterLimitRow {
	platform: string;
	maxLimit: string;
	sweetSpot: string;
	method: string;
}

interface ComparisonRow {
	feature: string;
	wordora: string;
	docs: string;
	word: string;
}

const pageTitle = t("wordCounter.title");
const pageDescription = t("wordCounter.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/word-counter/", locale));

const faqs = t.raw<FaqItem[]>("wordCounter.faq.items") ?? [];
const featureList = t.raw<string[]>("wordCounter.schema.featureList") ?? [];

const guideSteps = t.raw<TitleBodyCard[]>("wordCounter.page.guide.steps") ?? [];
const guideMetrics = t.raw<TitleBodyCard[]>("wordCounter.page.guide.metrics") ?? [];

const essayStandardsHeaders = t.raw<string[]>("wordCounter.page.essayStandards.headers") ?? [];
const essayStandardsData = t.raw<EssayStandardRow[]>("wordCounter.page.essayStandards.rows") ?? [];

const characterLimitsHeaders = t.raw<string[]>("wordCounter.page.characterLimits.headers") ?? [];
const characterLimitsData = t.raw<CharacterLimitRow[]>("wordCounter.page.characterLimits.rows") ?? [];

const comparisonHeaders = t.raw<string[]>("wordCounter.page.comparison.headers") ?? [];
const comparisonData = t.raw<ComparisonRow[]>("wordCounter.page.comparison.rows") ?? [];

const reduceCards = t.raw<TitleBodyCard[]>("wordCounter.page.reduceGuide.cards") ?? [];
const edgeCasesHtml = t.raw<string[]>("wordCounter.page.readabilityRules.edgeCasesHtml") ?? [];

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebApplication",
			name: t("wordCounter.name"),
			url: canonicalUrl,
			inLanguage: locale,
			applicationCategory: "UtilitiesApplication",
			operatingSystem: "All",
			offers: {
				"@type": "Offer",
				price: "0",
				priceCurrency: "USD",
			},
			description: pageDescription,
			featureList,
		},
		{
			"@type": "FAQPage",
			inLanguage: locale,
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: faq.answer,
				},
			})),
		},
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					{t("wordCounter.h1")}
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					{t("wordCounter.page.heroSubtitle")}
				</p>
			</div>
		</section>

		<!-- Interactive Word & Character Counter Workspace -->
		<WordCounterTool locale={locale} />

		{/* Editorial Content Slot */}
		<div id="editorial-content-slot" class="mx-auto max-w-[1200px] px-4 pt-10 pb-16 sm:px-6 space-y-16">
			<!-- Section 1: What Is a Word Counter & How to Use It -->
			<section
				id="guide-and-features"
				aria-label={t("wordCounter.page.guide.aria")}
				class="space-y-12"
			>
				<!-- Section 1 Header -->
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("wordCounter.page.guide.badge")}
					</span>
					<h2
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						{t("wordCounter.page.guide.h2")}
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						{t("wordCounter.page.guide.intro")}
					</p>
				</div>

				<!-- Subsection 1A: How to Use the Online Word Counter Checker (4-Step Grid) -->
				<div class="space-y-5">
					<h3
						class="font-sans text-[20px] font-semibold tracking-[-0.5px] text-ink sm:text-[22px]"
					>
						{t("wordCounter.page.guide.howToUseH3")}
					</h3>

					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
						{
							guideSteps.map((step, idx) => (
								<div
									class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
								>
									<div>
										<div class="mb-4 flex items-center gap-3">
											<span
												class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
											>
												{idx + 1}
											</span>
											<h4 class="font-sans text-[15px] font-semibold text-ink">
												{step.title}
											</h4>
										</div>
										<p class="text-[14px] leading-relaxed text-body" set:html={localizeHtmlLinks(step.bodyHtml, locale)} />
									</div>
								</div>
							))
						}
					</div>
				</div>

				<!-- Subsection 1B: What Does This Word Counter Measure? (Clean 2-Column Feature Breakdown) -->
				<div class="space-y-5">
					<h3
						class="font-sans text-[20px] font-semibold tracking-[-0.5px] text-ink sm:text-[22px]"
					>
						{t("wordCounter.page.guide.whatMeasuresH3")}
					</h3>

					<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-5">
						{
							guideMetrics.map((metric) => (
								<div
									class="rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
								>
									<div class="flex items-center gap-2.5">
										<span
											class="inline-block h-2 w-2 rounded-full bg-[#0f2e26] dark:bg-[#afe3d0]"
										></span>
										<h4 class="font-sans text-[16px] font-semibold text-ink">
											{metric.title}
										</h4>
									</div>
									<p class="mt-2.5 text-[14px] leading-relaxed text-body" set:html={localizeHtmlLinks(metric.bodyHtml, locale)} />
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- Section 2A: Essay Word Count Standards & Word Count in Pages Guide -->
			<section
				id="essay-word-count-standards"
				aria-label={t("wordCounter.page.essayStandards.aria")}
				class="space-y-6 pt-4"
			>
				<div>
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("wordCounter.page.essayStandards.badge")}
					</span>
					<h2
						class="mt-3 font-sans text-[24px] font-semibold tracking-[-0.7px] text-ink sm:text-[28px] sm:tracking-[-0.9px]"
					>
						{t("wordCounter.page.essayStandards.h2")}
					</h2>
					<p class="mt-2 text-[15px] leading-relaxed text-body">
						{t("wordCounter.page.essayStandards.intro")}
					</p>
				</div>

				<div class="whisper-shadow overflow-x-auto rounded-2xl border border-hairline bg-canvas-elevated">
					<table class="w-full min-w-[640px] border-collapse text-left">
						<thead>
							<tr class="border-b border-hairline bg-[#0f2e26]/5 text-[13px] font-semibold text-ink dark:bg-[#111111]/80">
								<th scope="col" class="py-3.5 pl-5 pr-4">{essayStandardsHeaders[0]}</th>
								<th scope="col" class="px-4 py-3.5">{essayStandardsHeaders[1]}</th>
								<th scope="col" class="px-4 py-3.5">{essayStandardsHeaders[2]}</th>
								<th scope="col" class="py-3.5 pl-4 pr-5">{essayStandardsHeaders[3]}</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-hairline text-[14px]">
							{
								essayStandardsData.map((row) => (
									<tr class="transition-colors hover:bg-canvas-muted/40">
										<td class="py-3.5 pl-5 pr-4 font-medium text-ink">
											{row.type}
										</td>
										<td class="px-4 py-3.5 tabular-nums text-body">
											{row.words}
										</td>
										<td class="px-4 py-3.5 tabular-nums text-body">
											{row.pages}
										</td>
										<td class="py-3.5 pl-4 pr-5 tabular-nums font-medium text-ink">
											{row.readingTime}
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>

				<!-- Link Strip -->
				<div class="flex flex-wrap items-center gap-x-6 gap-y-2 rounded-xl border border-hairline bg-canvas px-5 py-3.5 text-[13px] text-body">
					<span class="font-medium text-ink">{t("wordCounter.page.essayStandards.relatedLabel")}</span>
					<a
						href={getLocalizedPath("/words-to-pages/", locale)}
						class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 transition-colors hover:text-vercel-blue-deep hover:decoration-vercel-blue"
					>
						{t("wordCounter.page.essayStandards.linkWordsToPages")} &rarr;
					</a>
					<a
						href={getLocalizedPath("/reading-time-calculator/", locale)}
						class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 transition-colors hover:text-vercel-blue-deep hover:decoration-vercel-blue"
					>
						{t("wordCounter.page.essayStandards.linkReadingTime")} &rarr;
					</a>
					<a
						href={getLocalizedPath("/speech-time-calculator/", locale)}
						class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 transition-colors hover:text-vercel-blue-deep hover:decoration-vercel-blue"
					>
						{t("wordCounter.page.essayStandards.linkSpeechTime")} &rarr;
					</a>
				</div>
			</section>

			<!-- Section 2B: Social Media & SEO Character Limits Reference Table -->
			<section
				id="character-limits-reference"
				aria-label={t("wordCounter.page.characterLimits.aria")}
				class="space-y-6 pt-4"
			>
				<div>
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("wordCounter.page.characterLimits.badge")}
					</span>
					<h2
						class="mt-3 font-sans text-[24px] font-semibold tracking-[-0.7px] text-ink sm:text-[28px] sm:tracking-[-0.9px]"
					>
						{t("wordCounter.page.characterLimits.h2")}
					</h2>
					<p class="mt-2 text-[15px] leading-relaxed text-body">
						{t("wordCounter.page.characterLimits.intro")}
					</p>
				</div>

				<div class="whisper-shadow overflow-x-auto rounded-2xl border border-hairline bg-canvas-elevated">
					<table class="w-full min-w-[640px] border-collapse text-left">
						<thead>
							<tr class="border-b border-hairline bg-[#0f2e26]/5 text-[13px] font-semibold text-ink dark:bg-[#111111]/80">
								<th scope="col" class="py-3.5 pl-5 pr-4">{characterLimitsHeaders[0]}</th>
								<th scope="col" class="px-4 py-3.5">{characterLimitsHeaders[1]}</th>
								<th scope="col" class="px-4 py-3.5">{characterLimitsHeaders[2]}</th>
								<th scope="col" class="py-3.5 pl-4 pr-5">{characterLimitsHeaders[3]}</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-hairline text-[14px]">
							{
								characterLimitsData.map((row) => (
									<tr class="transition-colors hover:bg-canvas-muted/40">
										<td class="py-3.5 pl-5 pr-4 font-medium text-ink">
											{row.platform}
										</td>
										<td class="px-4 py-3.5 tabular-nums font-medium text-ink">
											{row.maxLimit}
										</td>
										<td class="px-4 py-3.5 tabular-nums text-body">
											{row.sweetSpot}
										</td>
										<td class="py-3.5 pl-4 pr-5 text-mute">
											{row.method}
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</section>

			<!-- Section 2C: Wordora Word Counter vs. Microsoft Word & Google Docs -->
			<section
				id="wordora-vs-docs"
				aria-label={t("wordCounter.page.comparison.aria")}
				class="space-y-6 pt-4"
			>
				<div>
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("wordCounter.page.comparison.badge")}
					</span>
					<h2
						class="mt-3 font-sans text-[24px] font-semibold tracking-[-0.7px] text-ink sm:text-[28px] sm:tracking-[-0.9px]"
					>
						{t("wordCounter.page.comparison.h2")}
					</h2>
					<p class="mt-2 text-[15px] leading-relaxed text-body">
						{t("wordCounter.page.comparison.intro")}
					</p>
				</div>

				<div class="whisper-shadow overflow-x-auto rounded-2xl border border-hairline bg-canvas-elevated">
					<table class="w-full min-w-[700px] border-collapse text-left">
						<thead>
							<tr class="border-b border-hairline bg-[#0f2e26]/5 text-[13px] font-semibold text-ink dark:bg-[#111111]/80">
								<th scope="col" class="py-3.5 pl-5 pr-4">{comparisonHeaders[0]}</th>
								<th scope="col" class="px-4 py-3.5 text-[#0f2e26] dark:text-[#afe3d0]">
									{comparisonHeaders[1]}
								</th>
								<th scope="col" class="px-4 py-3.5">{comparisonHeaders[2]}</th>
								<th scope="col" class="py-3.5 pl-4 pr-5">{comparisonHeaders[3]}</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-hairline text-[14px]">
							{
								comparisonData.map((row) => (
									<tr class="transition-colors hover:bg-canvas-muted/40">
										<td class="py-3.5 pl-5 pr-4 font-medium text-ink">
											{row.feature}
										</td>
										<td class="px-4 py-3.5">
											<span class="inline-flex items-center rounded-full bg-[#0f2e26]/10 px-2.5 py-0.5 text-[12px] font-semibold text-[#0f2e26] dark:bg-[#afe3d0]/15 dark:text-[#afe3d0]">
												{row.wordora}
											</span>
										</td>
										<td class="px-4 py-3.5 text-[13px] text-body">
											{row.docs}
										</td>
										<td class="py-3.5 pl-4 pr-5 text-[13px] text-body">
											{row.word}
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</section>

			<!-- Section 3: How to Reduce Word Count in Essays & Papers -->
			<section
				id="reduce-word-count-guide"
				aria-label={t("wordCounter.page.reduceGuide.aria")}
				class="space-y-6 pt-4"
			>
				<div>
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("wordCounter.page.reduceGuide.badge")}
					</span>
					<h2
						class="mt-3 font-sans text-[24px] font-semibold tracking-[-0.7px] text-ink sm:text-[28px] sm:tracking-[-0.9px]"
					>
						{t("wordCounter.page.reduceGuide.h2")}
					</h2>
					<p class="mt-2 text-[15px] leading-relaxed text-body">
						{t("wordCounter.page.reduceGuide.intro")}
					</p>
				</div>

				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
					{
						reduceCards.map((card, idx) => (
							<div
								class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
							>
								<div>
									<div class="mb-4 flex items-center gap-3">
										<span
											class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
										>
											{idx + 1}
										</span>
										<h3 class="font-sans text-[15px] font-semibold text-ink">
											{card.title}
										</h3>
									</div>
									<p class="text-[14px] leading-relaxed text-body" set:html={localizeHtmlLinks(card.bodyHtml, locale)} />
								</div>
							</div>
						))
					}
				</div>
			</section>

			<!-- Section 4: Readability Score, Keyword Frequency & Counting Accuracy Rules -->
			<section
				id="readability-and-rules"
				aria-label={t("wordCounter.page.readabilityRules.aria")}
				class="space-y-6 pt-4"
			>
				<div>
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("wordCounter.page.readabilityRules.badge")}
					</span>
					<h2
						class="mt-3 font-sans text-[24px] font-semibold tracking-[-0.7px] text-ink sm:text-[28px] sm:tracking-[-0.9px]"
					>
						{t("wordCounter.page.readabilityRules.h2")}
					</h2>
					<p class="mt-2 text-[15px] leading-relaxed text-body">
						{t("wordCounter.page.readabilityRules.intro")}
					</p>
				</div>

				<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
					<!-- Left Card: Readability Score & Keyword Frequency Explained -->
					<div
						class="rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:p-7 space-y-5"
					>
						<div class="flex items-center gap-3 border-b border-hairline pb-4">
							<span
								class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-[#0f2e26] text-[14px] font-semibold text-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]"
							>
								Aa
							</span>
							<h3 class="font-sans text-[18px] font-semibold text-ink">
								{t("wordCounter.page.readabilityRules.leftTitle")}
							</h3>
						</div>

						<div class="space-y-4 text-[14px] leading-relaxed text-body">
							<div>
								<h4 class="font-sans text-[15px] font-semibold text-ink">
									{t("wordCounter.page.readabilityRules.leftFleschTitle")}
								</h4>
								<p class="mt-1" set:html={localizeHtmlLinks(t("wordCounter.page.readabilityRules.leftFleschHtml"), locale)} />
							</div>

							<div class="border-t border-hairline pt-4">
								<h4 class="font-sans text-[15px] font-semibold text-ink">
									{t("wordCounter.page.readabilityRules.leftKeywordTitle")}
								</h4>
								<p class="mt-1" set:html={localizeHtmlLinks(t("wordCounter.page.readabilityRules.leftKeywordHtml"), locale)} />
							</div>
						</div>
					</div>

					<!-- Right Card: How Our Word Counter Handles Edge Cases -->
					<div
						class="rounded-2xl border border-hairline bg-canvas-elevated p-6 sm:p-7 space-y-5"
					>
						<div class="flex items-center gap-3 border-b border-hairline pb-4">
							<span
								class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-[#0f2e26] text-[14px] font-semibold text-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]"
							>
								&check;
							</span>
							<h3 class="font-sans text-[18px] font-semibold text-ink">
								{t("wordCounter.page.readabilityRules.rightTitle")}
							</h3>
						</div>

						<ul class="space-y-3 text-[14px] leading-relaxed text-body">
							{
								edgeCasesHtml.map((itemHtml) => (
									<li class="flex items-start gap-2.5">
										<span
											class="inline-block h-1.5 w-1.5 mt-2 rounded-full bg-[#0f2e26] dark:bg-[#afe3d0] shrink-0"
										></span>
										<span set:html={localizeHtmlLinks(itemHtml, locale)} />
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</section>

			<!-- Section 5: Frequently Asked Questions -->
			<section
				id="faq"
				aria-labelledby="faq-heading"
				class="space-y-6 pt-4"
			>
				<div>
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						{t("wordCounter.faq.badge")}
					</span>
					<h2
						id="faq-heading"
						class="mt-3 font-sans text-[24px] font-semibold tracking-[-0.7px] text-ink sm:text-[28px] sm:tracking-[-0.9px]"
					>
						{t("wordCounter.faq.heading")}
					</h2>
					<p class="mt-2 text-[15px] leading-relaxed text-body">
						{t("wordCounter.faq.intro")}
					</p>
				</div>

				<div class="divide-y divide-hairline rounded-2xl border border-hairline bg-canvas-elevated">
					{
						faqs.map((faq, idx) => (
							<details class="group p-5 sm:p-6" open={idx === 0}>
								<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-semibold text-ink focus:outline-none">
									<span>{faq.question}</span>
									<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-hairline text-mute transition-transform duration-200 group-open:rotate-45 group-open:border-[#0f2e26] group-open:bg-[#0f2e26] group-open:text-[#afe3d0] dark:group-open:border-[#afe3d0] dark:group-open:bg-[#afe3d0] dark:group-open:text-[#0f2e26]">
										<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
											<line x1="12" y1="5" x2="12" y2="19" />
											<line x1="5" y1="12" x2="19" y2="12" />
										</svg>
									</span>
								</summary>
								<p class="mt-3 pr-6 text-[14.5px] leading-relaxed text-body" set:html={localizeHtmlLinks(faq.answerHtml, locale)} />
							</details>
						))
					}
				</div>
			</section>
		</div>
	</main>

	<Footer />
</Layout>
