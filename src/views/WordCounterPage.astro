								</span>
							</li>
							<li class="flex items-start gap-2.5">
								<span
									class="inline-block h-1.5 w-1.5 mt-2 rounded-full bg-[#0f2e26] dark:bg-[#afe3d0] shrink-0"
								></span>
								<span>
									<strong class="font-semibold text-ink">Extra Spaces &amp; Blank Lines:</strong> Ignored in word counts, and removable in one click with <strong class="font-medium text-ink">Clean spaces</strong>.
								</span>
							</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- Section 5: Frequently Asked Questions -->
			<section
				id="faq"
				aria-labelledby="faq-heading"
				class="space-y-6 pt-4"
			>
				<div>
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						Got Questions?
					</span>
					<h2
						id="faq-heading"
						class="mt-3 font-sans text-[24px] font-semibold tracking-[-0.7px] text-ink sm:text-[28px] sm:tracking-[-0.9px]"
					>
						Frequently Asked Questions
					</h2>
					<p class="mt-2 text-[15px] leading-relaxed text-body">
						Clear answers to common questions about word counting methods, page estimates, character limits, readability scoring, and browser privacy.
					</p>
				</div>

				<div class="divide-y divide-hairline rounded-2xl border border-hairline bg-canvas-elevated">
					{
						faqs.map((faq, idx) => (
							<details class="group p-5 sm:p-6" open={idx === 0}>
								<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-semibold text-ink focus:outline-none">
									<span>{faq.question}</span>
									<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-hairline text-mute transition-transform duration-200 group-open:rotate-45 group-open:border-[#0f2e26] group-open:bg-[#0f2e26] group-open:text-[#afe3d0] dark:group-open:border-[#afe3d0] dark:group-open:bg-[#afe3d0] dark:group-open:text-[#0f2e26]">
										<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
											<line x1="12" y1="5" x2="12" y2="19" />
											<line x1="5" y1="12" x2="19" y2="12" />
										</svg>
									</span>
								</summary>
								<p class="mt-3 pr-6 text-[14.5px] leading-relaxed text-body" set:html={localizeHtmlLinks(faq.answerHtml, locale)} />
							</details>
						))
					}
				</div>
			</section>
		</div>
	</main>

	<Footer />
</Layout>
