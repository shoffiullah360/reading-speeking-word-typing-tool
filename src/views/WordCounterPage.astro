---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import WordCounterTool from "../components/WordCounterTool.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl } from "../config/site";

import { getLocaleFromUrl, getLocalizedPath, localizeHtmlLinks, useTranslations } from "../i18n/ui";
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const pageTitle = t("wordCounter.title");
const pageDescription = t("wordCounter.metaDescription");
const canonicalUrl = resolveCanonicalUrl(getLocalizedPath("/word-counter/", locale));

const faqs = [
	{
		question: "How many pages is 1,000 words in an essay?",
		answer:
			"A 1,000-word essay is approximately 4 pages double-spaced or 2 pages single-spaced when using standard 12pt font (such as Times New Roman or Arial) with 1-inch margins. Exact length depends on formatting, paragraph breaks, and heading hierarchy. You can use our Words to Pages Converter to customize font size, line spacing, and margins.",
		answerHtml:
			'A 1,000-word essay is approximately 4 pages double-spaced or 2 pages single-spaced when using standard 12pt font (such as Times New Roman or Arial) with 1-inch margins. Exact length depends on formatting, paragraph breaks, and heading hierarchy. You can use our <a href="/words-to-pages/" class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 hover:text-vercel-blue-deep hover:decoration-vercel-blue">Words to Pages Converter</a> to customize font size, line spacing, and margins.',
	},
	{
		question:
			"What is the difference between characters with spaces and characters without spaces?",
		answer:
			"Characters with spaces counts every keystroke—including letters, numbers, punctuation, and whitespace gaps. Characters without spaces excludes all spaces, tabs, and line breaks, measuring only the visible letters and symbols. Platforms like Google SEO titles and X count total characters with spaces, while translation agencies and certain academic publications bill by characters without spaces.",
		answerHtml:
			"Characters with spaces counts every keystroke—including letters, numbers, punctuation, and whitespace gaps. Characters without spaces excludes all spaces, tabs, and line breaks, measuring only the visible letters and symbols. Platforms like Google SEO titles and X count total characters with spaces, while translation agencies and certain academic publications bill by characters without spaces.",
	},
	{
		question: "How do I reduce word count in an essay without losing key points?",
		answer:
			'To reduce word count effectively, cut filler phrases (replace "due to the fact that" with "because"), convert passive constructions to active voice, and prune weak adverbs like "very", "really", and "basically". Keeping introductions under 12% of total length and combining redundant transition sentences will easily trim 15% to 25% of your draft without sacrificing depth.',
		answerHtml:
			'To reduce word count effectively, cut filler phrases (replace <strong class="font-medium text-ink">"due to the fact that"</strong> with <strong class="font-medium text-ink">"because"</strong>), convert passive constructions to active voice, and prune weak adverbs like <strong class="font-medium text-ink">"very"</strong>, <strong class="font-medium text-ink">"really"</strong>, and <strong class="font-medium text-ink">"basically"</strong>. Keeping introductions under 12% of total length and combining redundant transition sentences will easily trim 15% to 25% of your draft without sacrificing depth.',
	},
	{
		question:
			"What is an ideal keyword frequency or density in articles and essays?",
		answer:
			"An ideal keyword density for SEO articles and essays is between 1% and 2% of total word count. This means a primary keyword or phrase appears roughly 10 to 20 times within a 1,000-word article. Higher frequencies risk sounding repetitive and triggering search engine over-optimization penalties.",
		answerHtml:
			'An ideal keyword density for SEO articles and essays is between <strong class="font-medium text-ink">1% and 2%</strong> of total word count. This means a primary keyword or phrase appears roughly 10 to 20 times within a 1,000-word article. Higher frequencies risk sounding repetitive and triggering search engine over-optimization penalties.',
	},
	{
		question: "Does this word counter work for Chinese and Japanese characters?",
		answer:
			"Yes. Wordora features smart CJK character detection that accurately counts Chinese (Hanzi) and Japanese (Kanji, Hiragana, Katakana) characters alongside space-separated Western text. When CJK characters are detected, a dedicated sub-badge displays your exact CJK count under the Characters metric.",
		answerHtml:
			'Yes. Wordora features smart CJK character detection that accurately counts Chinese (Hanzi) and Japanese (Kanji, Hiragana, Katakana) characters alongside space-separated Western text. When CJK characters are detected, a dedicated sub-badge displays your exact CJK count under the Characters metric.',
	},
	{
		question: "Are hyphenated words and numbers counted as one word?",
		answer:
			'Yes. Standard hyphenated terms (such as "well-being" or "state-of-the-art") are counted as a single word, conforming to major academic and journalistic style guides (APA, MLA, and Chicago). Standalone numbers, dates (such as "2026"), and percentages ("99.9%") are also counted as single individual words.',
		answerHtml:
			'Yes. Standard hyphenated terms (such as <strong class="font-medium text-ink">"well-being"</strong> or <strong class="font-medium text-ink">"state-of-the-art"</strong>) are counted as a single word, conforming to major academic and journalistic style guides (APA, MLA, and Chicago). Standalone numbers, dates (such as "2026"), and percentages ("99.9%") are also counted as single individual words.',
	},
	{
		question:
			"How many words is a 5-minute speech or 2-minute reading passage?",
		answer:
			"At an average presentation pace of 130 words per minute, a 5-minute speech requires approximately 650 words (or 550 words with an 85% stage buffer for natural pauses). A 2-minute silent reading passage equals roughly 476 words at the standard reading rate of 238 WPM. Calculate exact timings with our Speech Time Calculator and Reading Time Calculator.",
		answerHtml:
			'At an average presentation pace of 130 words per minute, a 5-minute speech requires approximately 650 words (or 550 words with an 85% stage buffer for natural pauses). A 2-minute silent reading passage equals roughly 476 words at the standard reading rate of 238 WPM. Calculate exact timings with our <a href="/speech-time-calculator/" class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 hover:text-vercel-blue-deep hover:decoration-vercel-blue">Speech Time Calculator</a> and <a href="/reading-time-calculator/" class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 hover:text-vercel-blue-deep hover:decoration-vercel-blue">Reading Time Calculator</a>.',
	},
	{
		question: "What is a good Flesch-Kincaid readability grade level?",
		answer:
			"For general web content, blog posts, and consumer articles, a Flesch-Kincaid score between Grade 6 and Grade 8 is recommended for maximum clarity and accessibility. High school essays typically score around Grade 9 to 11, while college research papers and academic dissertations register at Grade 12 or above.",
		answerHtml:
			'For general web content, blog posts, and consumer articles, a Flesch-Kincaid score between <strong class="font-medium text-ink">Grade 6 and Grade 8</strong> is recommended for maximum clarity and accessibility. High school essays typically score around Grade 9 to 11, while college research papers and academic dissertations register at Grade 12 or above.',
	},
	{
		question:
			"Does Google Docs or Microsoft Word count words differently than an online word counter?",
		answer:
			"Most word counters use similar tokenization rules, but differences arise with hyphenated terms, compound words, and CJK text. Google Docs counts hyphenated terms as single words but requires opening a dialog (Ctrl+Shift+C) to view characters without spaces. Wordora displays all metrics instantly in real time without lag, account logins, or menu clicks.",
		answerHtml:
			"Most word counters use similar tokenization rules, but differences arise with hyphenated terms, compound words, and CJK text. Google Docs counts hyphenated terms as single words but requires opening a dialog (Ctrl+Shift+C) to view characters without spaces. Wordora displays all metrics instantly in real time without lag, account logins, or menu clicks.",
	},
	{
		question:
			"Is my text saved or uploaded when I use this free online word counter?",
		answer:
			"No. Wordora executes all text analysis and calculations 100% locally in your web browser using client-side JavaScript. Your pasted text, drafts, and notes never leave your device, are never transmitted to external servers, and are never stored or logged anywhere.",
		answerHtml:
			"No. Wordora executes all text analysis and calculations 100% locally in your web browser using client-side JavaScript. Your pasted text, drafts, and notes never leave your device, are never transmitted to external servers, and are never stored or logged anywhere.",
	},
];

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebApplication",
			name: t("wordCounter.name"),
			url: canonicalUrl,
			inLanguage: locale,
			applicationCategory: "UtilitiesApplication",
			operatingSystem: "All",
			offers: {
				"@type": "Offer",
				price: "0",
				priceCurrency: "USD",
			},
			description: pageDescription,
			featureList: [
				"Real-time word, character (with and without spaces), sentence, and paragraph counts",
				"Smart CJK character detection for Chinese and Japanese text",
				"One-click Clean spaces utility to normalize whitespace and formatting",
				"Academic page count estimate (250 words/page) and Flesch-Kincaid grade level",
				"Silent reading time (238 WPM) and speaking time (130 WPM) calculations",
				"Platform character limit monitors (Google Title, Meta Description, X Post) and custom Word Goal tracker",
				"Top 8 keyword frequency and density breakdown with one-click export",
			],
		},
		{
			"@type": "FAQPage",
			mainEntity: faqs.map((faq) => ({
				"@type": "Question",
				name: faq.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: faq.answer,
				},
			})),
		},
	],
};

const essayStandardsData = [
	{
		type: "IELTS Writing Task 1 / TOEFL Integrated",
		words: "150 – 225 words",
		pages: "0.6 – 0.9 pages",
		readingTime: "~45 – 55 sec",
	},
	{
		type: "IELTS Writing Task 2 / TOEFL Independent",
		words: "250 – 350 words",
		pages: "1.0 – 1.4 pages",
		readingTime: "~1 – 1.5 min",
	},
	{
		type: "High School / 5-Paragraph Essay",
		words: "500 – 800 words",
		pages: "2.0 – 3.2 pages",
		readingTime: "~2 – 3.5 min",
	},
	{
		type: "College Admission Essay (Common App)",
		words: "500 – 650 words",
		pages: "2.0 – 2.6 pages",
		readingTime: "~2 – 2.7 min",
	},
	{
		type: "Undergraduate Research Essay",
		words: "1,000 – 2,500 words",
		pages: "4.0 – 10.0 pages",
		readingTime: "~4 – 10.5 min",
	},
	{
		type: "Standard SEO Blog Post",
		words: "1,200 – 2,000 words",
		pages: "4.8 – 8.0 pages",
		readingTime: "~5 – 8.5 min",
	},
	{
		type: "In-Depth Pillar Guide / Whitepaper",
		words: "2,500 – 5,000 words",
		pages: "10.0 – 20.0 pages",
		readingTime: "~10.5 – 21 min",
	},
	{
		type: "Master's Thesis / Dissertation Chapter",
		words: "10,000 – 20,000 words",
		pages: "40 – 80 pages",
		readingTime: "~42 – 84 min",
	},
	{
		type: "Full-Length Novel",
		words: "70,000 – 100,000 words",
		pages: "280 – 400 pages",
		readingTime: "~5 – 7 hours",
	},
];

const characterLimitsData = [
	{
		platform: "Google SEO Title Tag",
		maxLimit: "~60 characters (~580px)",
		sweetSpot: "50 – 60 characters",
		method: "Includes spaces",
	},
	{
		platform: "Google Meta Description",
		maxLimit: "~160 characters",
		sweetSpot: "145 – 158 characters",
		method: "Includes spaces",
	},
	{
		platform: "X (Twitter) Standard Post",
		maxLimit: "280 characters",
		sweetSpot: "100 – 240 characters",
		method: "Includes spaces",
	},
	{
		platform: "Instagram Caption",
		maxLimit: "2,200 characters",
		sweetSpot: '125 – 150 chars (before "More")',
		method: "Includes spaces",
	},
	{
		platform: "LinkedIn Post",
		maxLimit: "3,000 characters",
		sweetSpot: "150 – 300 characters",
		method: "Includes spaces",
	},
	{
		platform: "YouTube Video Title",
		maxLimit: "100 characters",
		sweetSpot: "55 – 70 characters",
		method: "Includes spaces",
	},
	{
		platform: "Standard SMS Message",
		maxLimit: "160 characters (GSM-7)",
		sweetSpot: "Under 160 characters",
		method: "Includes spaces",
	},
];

const comparisonData = [
	{
		feature: "Instant Paste-and-Count (No Login)",
		wordora: "Yes (1-Click)",
		docs: "Requires Google Account",
		word: "Requires Desktop/365 App",
	},
	{
		feature: "Live Characters With & Without Spaces",
		wordora: "Always Visible",
		docs: "Requires Ctrl+Shift+C Popup",
		word: "Requires Status Bar Click",
	},
	{
		feature: "Keyword Frequency & Density %",
		wordora: "Built-in Live Tab",
		docs: "No",
		word: "No",
	},
	{
		feature: "SEO Title / Meta / X Limit Bars",
		wordora: "Built-in Live Bars",
		docs: "No",
		word: "No",
	},
	{
		feature: "Flesch-Kincaid Readability Grade",
		wordora: "Instant Live Grade",
		docs: "No",
		word: "Hidden in Proofing Settings",
	},
	{
		feature: "100% Browser Privacy (Zero Cloud Upload)",
		wordora: "Yes (Local Only)",
		docs: "Cloud Synced",
		word: "Cloud/Local",
	},
];
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					{t("wordCounter.h1")}
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					Count words, characters (with and without spaces), sentences, paragraphs, and page estimates in real time—built for essays, articles, scripts, and SEO snippets.
				</p>
			</div>
		</section>

		<!-- Interactive Word & Character Counter Workspace -->
		<WordCounterTool />

		{/* Editorial Content Slot */}
		<div id="editorial-content-slot" class="mx-auto max-w-[1200px] px-4 pt-10 pb-16 sm:px-6 space-y-16">
			<!-- Section 1: What Is a Word Counter & How to Use It -->
			<section
				id="guide-and-features"
				aria-label="What Is a Word Counter & How to Use It"
				class="space-y-12"
			>
				<!-- Section 1 Header -->
				<div class="max-w-3xl">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-[#0f2e26]/15 bg-[#0f2e26]/5 px-3 py-1 text-[12px] font-medium text-[#0f2e26] dark:border-[#afe3d0]/20 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]"
					>
						Guide &amp; Documentation
					</span>
					<h2
						class="mt-3 font-sans text-[26px] font-semibold tracking-[-0.8px] text-ink sm:text-[32px] sm:tracking-[-1px]"
					>
						What Is a Word Counter &amp; How to Use It
					</h2>
					<p class="mt-2.5 text-[15px] leading-relaxed text-body">
						A word counter is a precision text analysis tool that tracks length, lexical density, and structural metrics in real time. Whether you are balancing an academic essay with rigid length constraints, writing an article with search engine snippet caps, or rehearsing a speech, Wordora runs 100% locally in your browser with zero server latency and total privacy.
					</p>
				</div>

				<!-- Subsection 1A: How to Use the Online Word Counter Checker (4-Step Grid) -->
				<div class="space-y-5">
					<h3
						class="font-sans text-[20px] font-semibold tracking-[-0.5px] text-ink sm:text-[22px]"
					>
						How to Use the Online Word Counter Checker
					</h3>

					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
						<!-- Step 1 -->
						<div
							class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
						>
							<div>
								<div class="mb-4 flex items-center gap-3">
									<span
										class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
									>
										1
									</span>
									<h4 class="font-sans text-[15px] font-semibold text-ink">
										Paste or Type Your Text
									</h4>
								</div>
								<p class="text-[14px] leading-relaxed text-body">
									Type directly into the editor, click <strong class="font-medium text-ink">Paste</strong> from your clipboard, or upload a <strong class="font-medium text-ink">.txt</strong> / <strong class="font-medium text-ink">.md</strong> file for instant local analysis.
								</p>
							</div>
						</div>

						<!-- Step 2 -->
						<div
							class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
						>
							<div>
								<div class="mb-4 flex items-center gap-3">
									<span
										class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
									>
										2
									</span>
									<h4 class="font-sans text-[15px] font-semibold text-ink">
										Check Live Word &amp; Character Counts
									</h4>
								</div>
								<p class="text-[14px] leading-relaxed text-body">
									View real-time <strong class="font-medium text-ink">Words</strong>, <strong class="font-medium text-ink">Characters</strong> (with and without spaces), <strong class="font-medium text-ink">Sentences</strong>, <strong class="font-medium text-ink">Paragraphs</strong>, <strong class="font-medium text-ink">Pages</strong>, and <strong class="font-medium text-ink">Readability</strong>.
								</p>
							</div>
						</div>

						<!-- Step 3 -->
						<div
							class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
						>
							<div>
								<div class="mb-4 flex items-center gap-3">
									<span
										class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
									>
										3
									</span>
									<h4 class="font-sans text-[15px] font-semibold text-ink">
										Track Word Goals &amp; Platform Limits
									</h4>
								</div>
								<p class="text-[14px] leading-relaxed text-body">
									Set a custom <strong class="font-medium text-ink">Word goal</strong> for essays or monitor character limits for <strong class="font-medium text-ink">Google Title (60)</strong>, <strong class="font-medium text-ink">Meta Description (160)</strong>, and <strong class="font-medium text-ink">X / Social Post (280)</strong>.
								</p>
							</div>
						</div>

						<!-- Step 4 -->
						<div
							class="flex flex-col justify-between rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
						>
							<div>
								<div class="mb-4 flex items-center gap-3">
									<span
										class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0f2e26] text-[13px] font-semibold text-[#afe3d0] tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
									>
										4
									</span>
									<h4 class="font-sans text-[15px] font-semibold text-ink">
										Inspect Top Keywords &amp; Clean Formatting
									</h4>
								</div>
								<p class="text-[14px] leading-relaxed text-body">
									Switch to <strong class="font-medium text-ink">Top Keywords</strong> to check word frequency and density, use <strong class="font-medium text-ink">Clean spaces</strong> to strip extra whitespace, or click <strong class="font-medium text-ink">Copy summary</strong>.
								</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Subsection 1B: What Does This Word Counter Measure? (Clean 2-Column Feature Breakdown) -->
				<div class="space-y-5">
					<h3
						class="font-sans text-[20px] font-semibold tracking-[-0.5px] text-ink sm:text-[22px]"
					>
						What Does This Word Counter Measure?
					</h3>

					<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-5">
						<!-- Metric 1: Words & Unique Frequency -->
						<div
							class="rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
						>
							<div class="flex items-center gap-2.5">
								<span
									class="inline-block h-2 w-2 rounded-full bg-[#0f2e26] dark:bg-[#afe3d0]"
								></span>
								<h4 class="font-sans text-[16px] font-semibold text-ink">
									Words &amp; Unique Frequency
								</h4>
							</div>
							<p class="mt-2.5 text-[14px] leading-relaxed text-body">
								Computes exact total word counts across standard space-separated Western languages as well as character-based CJK scripts. You can switch to the <strong class="font-medium text-ink">Top Keywords</strong> tab to isolate high-repetition vocabulary, avoid keyword stuffing, and ensure natural lexical variation.
							</p>
						</div>

						<!-- Metric 2: Characters (With & Without Spaces + CJK) -->
						<div
							class="rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
						>
							<div class="flex items-center gap-2.5">
								<span
									class="inline-block h-2 w-2 rounded-full bg-[#0f2e26] dark:bg-[#afe3d0]"
								></span>
								<h4 class="font-sans text-[16px] font-semibold text-ink">
									Characters (With &amp; Without Spaces + CJK)
								</h4>
							</div>
							<p class="mt-2.5 text-[14px] leading-relaxed text-body">
								Provides dual character tallies: overall keystrokes (with spaces) for strict social media or title limits, and compact length (without spaces) for translation or essay standards. Built-in CJK detection surfaces a dedicated counter whenever Chinese or Japanese glyphs are detected.
							</p>
						</div>

						<!-- Metric 3: Sentences & Paragraphs -->
						<div
							class="rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
						>
							<div class="flex items-center gap-2.5">
								<span
									class="inline-block h-2 w-2 rounded-full bg-[#0f2e26] dark:bg-[#afe3d0]"
								></span>
								<h4 class="font-sans text-[16px] font-semibold text-ink">
									Sentences &amp; Paragraphs
								</h4>
							</div>
							<p class="mt-2.5 text-[14px] leading-relaxed text-body">
								Breaks down overall document architecture by analyzing terminal punctuation marks (<strong class="font-medium text-ink">. ! ?</strong>) and line spacing breaks. Maintaining balanced sentence lengths prevents fatigue and keeps digital and printed copy engaging.
							</p>
						</div>

						<!-- Metric 4: Page Count Estimate (250 words/page) -->
						<div
							class="rounded-2xl border border-hairline bg-canvas-elevated p-6 transition-all hover:border-[#0f2e26]/30 dark:hover:border-[#afe3d0]/30"
						>
							<div class="flex items-center gap-2.5">
								<span
									class="inline-block h-2 w-2 rounded-full bg-[#0f2e26] dark:bg-[#afe3d0]"
								></span>
								<h4 class="font-sans text-[16px] font-semibold text-ink">
									Page Count Estimate (250 words/page)
								</h4>
