---
import '../styles/global.css';
import { SITE_CONFIG, resolveCanonicalUrl, getVerifiedHreflangLinks } from '../config/site';
import { getLocaleFromUrl, useTranslations, type Locale } from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
	canonicalUrl?: string;
	locale?: Locale;
	/** Overrides `<html lang>` for root-level pages whose copy is not in the site's UI language. */
	htmlLang?: string;
	/** Explicit robots directive, e.g. "index, follow". Omitted pages keep the default. */
	robots?: string;
	/** Overrides `og:locale` when `htmlLang` differs from the UI locale. */
	ogLocale?: string;
}

const locale: Locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const {
	title = t('meta.siteTitle'),
	description = t('meta.siteDescription'),
	canonicalUrl = resolveCanonicalUrl(Astro.url.pathname),
	htmlLang = locale,
	robots,
	ogLocale = { en: 'en_US', es: 'es_ES', pt: 'pt_BR' }[locale],
} = Astro.props;

// Reciprocal hreflang (en, es, pt) + x-default — only for verified routes.
const hreflangLinks = getVerifiedHreflangLinks(Astro.url.pathname);
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		{robots && <meta name="robots" content={robots} />}
		<link rel="canonical" href={canonicalUrl} />

		<!-- Verified Reciprocal hreflang + x-default -->
		{
			hreflangLinks.map((alt) => (
				<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
			))
		}

		<!-- Open Graph / Social -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:site_name" content={SITE_CONFIG.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<!-- Geist Sans Font -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<!-- Prevent Flash of Incorrect Theme (FOUC) — Light Mode is default for first-time visitors -->
		<script is:inline>
			(function () {
				try {
					const storedTheme = localStorage.getItem('theme');
					if (storedTheme === 'dark') {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
				} catch (e) {}
			})();
		</script>

		<slot name="head" />
	</head>
	<body class="min-h-dvh overflow-x-hidden bg-canvas text-ink antialiased selection:bg-vercel-blue/15 selection:text-vercel-blue">
		<slot />
	</body>
</html>
