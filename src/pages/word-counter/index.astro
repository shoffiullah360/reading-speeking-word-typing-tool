---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import WordCounterTool from "../../components/WordCounterTool.astro";
import Footer from "../../components/Footer.astro";
import { resolveCanonicalUrl } from "../../config/site";

const pageTitle =
	"Word & Character Counter — Sentence, Paragraph & Keyword Frequency Tool | Wordora";
const pageDescription =
	"Free online Word & Character Counter. Count words, characters with and without spaces, sentences, paragraphs, reading time (238 WPM), speaking time (130 WPM), and top keywords privately in your browser.";
const canonicalUrl = resolveCanonicalUrl("/word-counter/");

const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Word & Character Counter",
	url: canonicalUrl,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web, Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: [
		"Live real-time counts for Words, Characters (with spaces), and Characters (without spaces)",
		"Sentence and paragraph structure analysis with average words per sentence",
		"Estimated silent reading time (238 WPM) and speaking time (130 WPM)",
		"Top keywords and word frequency analysis excluding common stop words",
		"Drag-and-drop .txt and .md file upload, Sample Text, Copy Text, and Clear Text controls",
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(softwareAppSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					Word &amp; Character Counter
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					Count words, characters, sentences, and paragraphs in real time—plus check reading time, speaking time, and top keyword frequency right in your browser.
				</p>
			</div>
		</section>

		<!-- Interactive Word & Character Counter Workspace -->
		<WordCounterTool />

		{/* Editorial Content & FAQ Slot — User Managed */}
		<div id="editorial-content-slot" class="mx-auto max-w-[1200px] px-4 sm:px-6"></div>
	</main>

	<Footer />
</Layout>

