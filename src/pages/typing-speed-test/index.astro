---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import TypingSpeedTest from "../../components/TypingSpeedTest.astro";
import Footer from "../../components/Footer.astro";
import { resolveCanonicalUrl } from "../../config/site";

const pageTitle =
	"Typing Speed Test (WPM) — Check Your Typing Speed & Accuracy | Wordora";
const pageDescription =
	"Free distraction-free Typing Speed Test. Measure your real-time Words Per Minute (WPM), Raw WPM, and keystroke accuracy across 15s, 30s, 60s, and 120s natural English passages.";
const canonicalUrl = resolveCanonicalUrl("/typing-speed-test/");

const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Typing Speed Test (WPM)",
	url: canonicalUrl,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web, Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: [
		"Selectable timed typing test durations: 15s, 30s, 60s, and 120s",
		"Real-time character-by-character visual feedback for correct and incorrect keystrokes",
		"Live Net Words Per Minute (WPM), Raw WPM, and keystroke Accuracy percentage",
		"Curated, natural English paragraphs with instant Tab or click restart",
		"100% private client-side execution in your browser",
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(softwareAppSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					Typing Speed Test
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					Measure your typing speed in Words Per Minute (WPM), Raw WPM, and keystroke accuracy across natural English passages with 15s, 30s, 60s, and 120s timers.
				</p>
			</div>
		</section>

		<!-- Interactive Typing Speed Test Workspace -->
		<TypingSpeedTest />

		{/* Editorial Content & FAQ Slot — User Managed */}
	</main>

	<Footer />
</Layout>

