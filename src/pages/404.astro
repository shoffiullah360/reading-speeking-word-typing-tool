---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { resolveCanonicalUrl, getLiveTools } from "../config/site";

const pageTitle = "Page not found | Wordora";
const pageDescription = "The page you are looking for could not be found on Wordora.";
const canonicalUrl = resolveCanonicalUrl("/");
const liveTools = getLiveTools();
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<meta name="robots" content="noindex, nofollow" />
	</Fragment>

	<Header />

	<main class="flex flex-1 items-center justify-center px-4 py-16 sm:px-6 sm:py-24">
		<div class="whisper-shadow mx-auto w-full max-w-lg rounded-md border border-hairline bg-canvas-elevated p-8 text-center sm:p-10">
			<span class="inline-flex items-center rounded-full bg-hairline-soft px-3 py-1 text-[13px] font-medium text-mute tabular-nums">
				404 error
			</span>

			<h1 class="mt-4 font-sans text-[28px] leading-[34px] font-semibold tracking-[-1px] text-ink sm:text-[32px] sm:leading-[38px]">
				Page not found
			</h1>

			<p class="mt-3 text-[15px] leading-[24px] text-body">
				Sorry, we couldn’t find the page you were looking for. It may have been moved or doesn’t exist yet.
			</p>

			<div class="mt-7 flex flex-wrap items-center justify-center gap-3">
				<a
					href="/"
					class="inline-flex h-10 items-center gap-2 rounded-pill bg-primary px-5 text-[14px] font-medium text-on-primary transition-opacity hover:opacity-90"
				>
					<span>Back to home</span>
					<span aria-hidden="true">→</span>
				</a>
				<a
					href="/reading-time-counter/"
					class="inline-flex h-10 items-center rounded-pill border border-hairline bg-canvas px-5 text-[14px] font-medium text-ink transition-colors hover:border-ink"
				>
					Reading Time Counter
				</a>
			</div>

			{
				liveTools.length > 0 && (
					<div class="mt-8 border-t border-hairline pt-5 text-left">
						<span class="block text-[13px] font-medium text-mute">
							Available tools
						</span>
						<div class="mt-2.5 flex flex-wrap gap-2">
							{liveTools.map((tool) => (
								<a
									href={tool.slug}
									class="rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body transition-colors hover:border-ink hover:text-ink"
								>
									{tool.shortName}
								</a>
							))}
						</div>
					</div>
				)
			}
		</div>
	</main>

	<Footer />
</Layout>

