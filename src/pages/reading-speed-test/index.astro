---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ReadingSpeedTest from "../../components/ReadingSpeedTest.astro";
import Footer from "../../components/Footer.astro";
import { resolveCanonicalUrl } from "../../config/site";

const pageTitle =
	"Reading Speed Test (WPM) — Check Your Silent Reading Speed & Comprehension | Wordora";
const pageDescription =
	"Measure your personal silent reading speed in Words Per Minute (WPM) across short, medium, and long non-fiction passages with a 3-question comprehension check and 238 WPM benchmark comparison.";
const canonicalUrl = resolveCanonicalUrl("/reading-speed-test/");

const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Reading Speed Test (WPM)",
	url: canonicalUrl,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web, Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: [
		"Calibrated non-fiction passages in Short (~150 words), Medium (~300 words), and Long (~500 words) lengths",
		"Live stopwatch timer with Start Reading and Finish Reading controls",
		"Instant Words Per Minute (WPM) calculation and comparison against the 238 WPM adult silent reading average",
		"3-question reading comprehension check with comprehension-adjusted effective WPM",
		"100% private client-side execution in your browser",
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(softwareAppSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					Reading Speed Test
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					Measure your natural silent reading rate in Words Per Minute (WPM), compare your pace against the 238 WPM adult average, and check your comprehension with 3 quick questions.
				</p>
			</div>
		</section>

		<!-- Interactive Reading Speed Test Workspace -->
		<ReadingSpeedTest />

		{/* Editorial Content & FAQ Slot — User Managed */}
	</main>

	<Footer />
</Layout>

