---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
	SITE_CONFIG,
	TOOLS_REGISTRY,
	resolveCanonicalUrl,
} from "../config/site";

const pageTitle =
	"Wordora — Precision Reading, Writing, Speaking & Text Utilities";
const pageDescription =
	"Fast, privacy-first client-side utilities for writers, editors, speakers, and students. Estimate reading time, speech cadence, page conversions, and lexical complexity in real time.";
const canonicalUrl = resolveCanonicalUrl("/");

const webSiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_CONFIG.name,
	url: canonicalUrl,
	description: pageDescription,
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(webSiteSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Hero -->
		<section class="px-4 pt-14 pb-8 sm:px-6 sm:pt-20 sm:pb-10">
			<div class="mx-auto max-w-[1200px] text-center">
				<h1
					class="mx-auto max-w-3xl font-sans text-[36px] leading-[42px] font-semibold tracking-[-1.6px] text-ink sm:text-[48px] sm:leading-[52px] sm:tracking-[-2px]"
				>
					Simple, Fast Tools for Reading, Writing &amp; Speaking
				</h1>

				<p
					class="mx-auto mt-4 max-w-2xl text-[17px] leading-[26px] font-normal text-body"
				>
					Check how long an article takes to read, time your next speech, or count words and pages—right in your browser.
				</p>

				<div class="mt-7 flex flex-wrap items-center justify-center gap-3">
					<a
						href="/reading-time-calculator/"
						class="inline-flex h-10 items-center gap-2 rounded-pill bg-primary px-5 text-[15px] font-medium text-on-primary transition-opacity hover:opacity-90"
					>
						<span>Open Reading Time Counter</span>
						<span aria-hidden="true">→</span>
					</a>
					<a
						href="/reading-time-calculator/#benchmarks"
						class="whisper-shadow inline-flex h-10 items-center rounded-pill border border-hairline bg-canvas-elevated px-5 text-[15px] font-medium text-ink transition-all hover:border-ink"
					>
						Reading time chart
					</a>
				</div>
			</div>
		</section>

		<!-- Multi-Tool Directory Grid (4 Canonical Categories) -->
		<section
			id="tools"
			aria-labelledby="directory-heading"
			class="mx-auto max-w-[1200px] px-4 py-10 sm:px-6 sm:py-14"
		>
			<div
				class="mb-8 flex flex-col justify-between gap-4 border-b border-hairline pb-5 lg:flex-row lg:items-end"
			>
				<div>
					<h2
						id="directory-heading"
						class="text-[26px] leading-[34px] font-semibold tracking-[-0.8px] text-ink sm:text-[30px] sm:leading-[38px]"
					>
						All tools
					</h2>
					<p class="mt-1 text-[15px] text-body">
						Free utilities that run privately in your browser.
					</p>
				</div>

				<!-- Category Filter Pills -->
				<div
					role="tablist"
					aria-label="Filter tools by category"
					class="inline-flex flex-wrap items-center gap-1.5"
				>
					<button
						type="button"
						role="tab"
						aria-selected="true"
						data-category-filter="All"
						class="category-filter-btn cursor-pointer rounded-pill-category bg-primary px-4 py-1.5 text-[13px] font-medium text-on-primary transition-all"
					>
						All
					</button>
					{
						SITE_CONFIG.categories.map((cat) => (
							<button
								type="button"
								role="tab"
								aria-selected="false"
								data-category-filter={cat}
								class="category-filter-btn whisper-shadow cursor-pointer rounded-pill-category border border-hairline bg-canvas-elevated px-4 py-1.5 text-[13px] font-medium text-body transition-all hover:border-ink hover:text-ink"
							>
								{cat}
							</button>
						))
					}
				</div>
			</div>

			<!-- Tool Cards Grid (Strict Draft Protection: Only Live Tools Render <a>) -->
			<div
				id="tools-grid"
				class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3"
			>
				{
					TOOLS_REGISTRY.map((tool) =>
						tool.status === "live" ? (
							<a
								href={tool.slug}
								data-tool-category={tool.category}
								data-tool-status="live"
								class="tool-card tool-card-live group flex flex-col justify-between rounded-md border border-hairline bg-canvas-elevated p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-[#0f172a] dark:hover:border-ink"
							>
								<div>
									<div class="flex items-center justify-between gap-2">
										<span class="text-[13px] font-medium text-mute">
											{tool.category}
										</span>
										<span class="inline-flex items-center gap-1.5 rounded-full bg-hairline-soft px-2.5 py-0.5 text-[12px] font-medium text-ink">
											<span class="inline-block h-1.5 w-1.5 rounded-full bg-vercel-blue" />
											Available
										</span>
									</div>

									<h3 class="mt-3 text-[19px] leading-[26px] font-semibold tracking-[-0.3px] text-ink group-hover:text-vercel-blue transition-colors">
										{tool.name}
									</h3>

									<p class="mt-2 text-[14px] leading-[22px] text-body">
										{tool.description}
									</p>
								</div>

								<div class="mt-6 flex items-center justify-between border-t border-hairline pt-4">
									<span class="text-[13px] text-mute tabular-nums">
										{tool.metricPreview}
									</span>
									<span class="inline-flex items-center gap-1 text-[13px] font-medium text-ink group-hover:translate-x-0.5 transition-transform">
										<span>Open tool</span>
										<span aria-hidden="true">→</span>
									</span>
								</div>
							</a>
						) : (
							<article
								aria-disabled="true"
								data-tool-category={tool.category}
								data-tool-status="draft"
								class="tool-card flex flex-col justify-between rounded-md border border-hairline bg-canvas-muted p-6"
							>
								<div>
									<div class="flex items-center justify-between gap-2">
										<span class="text-[13px] font-medium text-mute">
											{tool.category}
										</span>
										<span class="inline-flex items-center rounded-full border border-hairline bg-canvas-elevated px-2.5 py-0.5 text-[12px] font-medium text-mute">
											{tool.badge ?? "Soon"}
										</span>
									</div>

									<h3 class="mt-3 text-[19px] leading-[26px] font-semibold tracking-[-0.3px] text-ink/80">
										{tool.name}
									</h3>

									<p class="mt-2 text-[14px] leading-[22px] text-body">
										{tool.description}
									</p>
								</div>

								<div class="mt-6 flex items-center justify-between border-t border-hairline pt-4">
									<span class="text-[13px] text-mute tabular-nums">
										{tool.metricPreview}
									</span>
									<span class="text-[13px] text-mute">
										Coming soon
									</span>
								</div>
							</article>
						)
					)
				}
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	function initCategoryFilter() {
		const filterBtns = document.querySelectorAll<HTMLButtonElement>(
			".category-filter-btn"
		);
		const cards = document.querySelectorAll<HTMLElement>(".tool-card");

		filterBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const selectedCat = btn.dataset.categoryFilter || "All";

				filterBtns.forEach((b) => {
					const isActive = b.dataset.categoryFilter === selectedCat;
					b.setAttribute("aria-selected", isActive ? "true" : "false");
					b.className = isActive
						? "category-filter-btn cursor-pointer rounded-pill-category bg-primary px-4 py-1.5 text-[13px] font-medium text-on-primary transition-all"
						: "category-filter-btn whisper-shadow cursor-pointer rounded-pill-category border border-hairline bg-canvas-elevated px-4 py-1.5 text-[13px] font-medium text-body transition-all hover:border-ink hover:text-ink";
				});

				cards.forEach((card) => {
					const cardCat = card.dataset.toolCategory;
					const shouldShow =
						selectedCat === "All" || cardCat === selectedCat;
					card.classList.toggle("hidden", !shouldShow);
					card.classList.toggle("flex", shouldShow);
				});
			});
		});
	}

	initCategoryFilter();
</script>
