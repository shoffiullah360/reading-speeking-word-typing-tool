---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SpeechCalculator from "../../components/SpeechCalculator.astro";
import Footer from "../../components/Footer.astro";
import { resolveCanonicalUrl } from "../../config/site";

const pageTitle =
	"Speech Time Calculator — Script Duration, Target Words & Live Rehearsal Timer | Wordora";
const pageDescription =
	"Free online Speech Time Calculator. Convert scripts to exact speaking duration (100–220 WPM, default 130 WPM keynote pace), calculate target word counts for any time slot, and rehearse with a live countdown timer.";
const canonicalUrl = resolveCanonicalUrl("/speech-time-calculator/");

const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Speech Time Calculator",
	url: canonicalUrl,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web, Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: [
		"Script to Speech Time calculator with word, sentence, and presentation slide estimates",
		"Target Time to Words reverse calculator for 1-minute pitches to 45-minute keynotes",
		"Live Rehearsal Countdown Timer synced with calculated speech duration and 00:00 alert",
		"Speaking Pace Control slider (100 to 220 WPM, default 130 WPM) with Ceremonial, Keynote, TED, and Podcast presets",
		"Drag-and-drop .txt and .md script upload with 100% client-side privacy",
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(softwareAppSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					Speech Time Calculator
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					Paste your script to see how long it takes to speak, find how many words you need for a set time slot, or practice with the rehearsal timer.
				</p>
			</div>
		</section>

		<!-- Flagship Interactive Speech Time Calculator Workspace -->
		<SpeechCalculator />

		{/* Editorial Content & FAQ Slot — User Managed */}
		<div id="editorial-content-slot" class="mx-auto max-w-[1200px] px-4 sm:px-6"></div>
	</main>

	<Footer />
</Layout>
