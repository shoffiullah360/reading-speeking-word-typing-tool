---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ReadingCalculator from "../../components/ReadingCalculator.astro";
import BenchmarkTable from "../../components/BenchmarkTable.astro";
import FAQSection, { faqItems } from "../../components/FAQSection.astro";
import Footer from "../../components/Footer.astro";
import { resolveCanonicalUrl } from "../../config/site";

const pageTitle =
	"Reading Time Calculator & Counter — Instant Silent & Read Aloud WPM Estimator | Wordora";
const pageDescription =
	"Free online Reading Time Calculator & Counter. Instantly estimate silent reading time (238 WPM) and read aloud duration (183 WPM) by pasting text, entering word counts, or converting pages.";
const canonicalUrl = resolveCanonicalUrl("/reading-time-counter/");

const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Reading Time Calculator & Counter",
	url: canonicalUrl,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web, Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: [
		"Real-time silent reading time calculator (100 to 400 WPM, default 238 WPM)",
		"Read aloud speed timer (100 to 300 WPM, default 183 WPM)",
		"Multi-input system: Paste Text, Direct Word Count, and Pages Count converter",
		"Drag-and-drop .txt file reader with 100% client-side privacy",
		"Dynamic reading difficulty badge based on word length and syllable density",
	],
};

const faqPageSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqItems.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer,
		},
	})),
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(softwareAppSchema)}
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify(faqPageSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					Reading Time Calculator
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					Paste your text, enter a word count, or convert pages to see how long it takes to read silently or out loud. Runs privately in your browser.
				</p>
			</div>
		</section>

		<!-- Flagship Interactive Calculator Workspace -->
		<ReadingCalculator />

		{/* Editorial Content & FAQ Slot — User Managed */}
		<!-- Featured Snippet Benchmark Table (100 to 10,000 Words) -->
		<BenchmarkTable />

		<!-- Comprehensive FAQ Accordion Section -->
		<FAQSection />
	</main>

	<Footer />
</Layout>
