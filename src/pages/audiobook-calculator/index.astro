---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import AudiobookCalculator from "../../components/AudiobookCalculator.astro";
import Footer from "../../components/Footer.astro";
import { resolveCanonicalUrl } from "../../config/site";

const pageTitle =
	"Audiobook Calculator — Playback Speed, Time Saved & Listening Schedule | Wordora";
const pageDescription =
	"Calculate exact audiobook listening time at 1.25x, 1.5x, 1.75x, or 2.0x playback speed. Estimate hours saved and daily listening schedules by audiobook length or book word count.";
const canonicalUrl = resolveCanonicalUrl("/audiobook-calculator/");

const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Audiobook Speed & Listening Time Calculator",
	url: canonicalUrl,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web, Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: [
		"Two input modes: By Audiobook Length (hours & minutes) or By Word Count (~155 WPM narration speed)",
		"Playback speed preset pills (0.75x, 1.0x, 1.25x, 1.5x, 1.75x, 2.0x) and fine-grained custom slider (0.5x – 3.0x)",
		"Exact Adjusted Listening Time and Time Saved (or added) calculations",
		"Practical Daily Listening Schedule showing days to finish at 30 min/day, 45 min/day, and 60 min/day",
		"Side-by-side comparison across playback speeds and silent reading time (238 WPM)",
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(softwareAppSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					Audiobook Calculator
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					See how long any audiobook takes to finish across custom playback speeds, how much time you save, and how many days it takes on your daily listening schedule.
				</p>
			</div>
		</section>

		<!-- Interactive Audiobook Calculator Workspace -->
		<AudiobookCalculator />

		{/* Editorial Content & FAQ Slot — User Managed */}
	</main>

	<Footer />
</Layout>

