---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import TextRepeaterTool from "../../components/TextRepeaterTool.astro";
import Footer from "../../components/Footer.astro";
import { resolveCanonicalUrl } from "../../config/site";

const pageTitle =
	"Text Repeater — Repeat Words, Phrases & Lines Up to 10,000 Times | Wordora";
const pageDescription =
	"Free online Text Repeater. Repeat any word, sentence, or phrase up to 10,000 times with new lines, spaces, commas, custom separators, and optional line numbering in your browser.";
const canonicalUrl = resolveCanonicalUrl("/text-repeater/");

const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Text Repeater",
	url: canonicalUrl,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web, Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: [
		"Repeat any text or phrase up to 10,000 times in real time",
		"Separator options: New line, Space, Comma, and Custom separator",
		"Optional sequential line numbering (1. 2. 3.)",
		"Live output character count, word count, and one-click Copy Output",
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(softwareAppSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					Text Repeater
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					Repeat any word, phrase, or block of text up to 10,000 times with custom separators and optional numbering—privately in your browser.
				</p>
			</div>
		</section>

		<!-- Interactive Text Repeater Workspace -->
		<TextRepeaterTool />

		{/* Editorial Content & FAQ Slot — User Managed */}
		<div id="editorial-content-slot" class="mx-auto max-w-[1200px] px-4 sm:px-6"></div>
	</main>

	<Footer />
</Layout>

