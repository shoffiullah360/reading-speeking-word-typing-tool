---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import WordsToPagesCalculator from "../../components/WordsToPagesCalculator.astro";
import Footer from "../../components/Footer.astro";
import { resolveCanonicalUrl } from "../../config/site";

const pageTitle =
	"Words to Pages Converter — Single, 1.5 & Double-Spaced Page Calculator | Wordora";
const pageDescription =
	"Convert words to pages or pages to words instantly. Compare single-spaced (500 words/page), 1.5-spaced (330 words/page), double-spaced (250 words/page), and paperback book layouts.";
const canonicalUrl = resolveCanonicalUrl("/words-to-pages/");

const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Words to Pages Converter",
	url: canonicalUrl,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web, Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: [
		"Two-way instant conversion between Words to Pages and Pages to Words",
		"Line spacing presets for Single-spaced (~500 words/page), 1.5-spaced (~330 words/page), Double-spaced (~250 words/page), and custom words-per-page",
		"Font and size presets for 12pt Times New Roman / Arial, 11pt Calibri, and Paperback Book (~275 words/page)",
		"Quick document word count presets (500, 1,000, 1,500, 2,500, 5,000, and 10,000 words)",
		"Live silent reading time (238 WPM) and speaking time (130 WPM) estimates",
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(softwareAppSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					Words to Pages Converter
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					Convert word counts into pages—or pages into target word counts—across single, 1.5, and double spacing, standard fonts, and book layouts.
				</p>
			</div>
		</section>

		<!-- Interactive Words to Pages Calculator Workspace -->
		<WordsToPagesCalculator />

		{/* Editorial Content & FAQ Slot — User Managed */}
		<div id="editorial-content-slot" class="mx-auto max-w-[1200px] px-4 sm:px-6"></div>
	</main>

	<Footer />
</Layout>

