---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import WordsToPagesCalculator from "../../components/WordsToPagesCalculator.astro";
import Footer from "../../components/Footer.astro";
import { resolveCanonicalUrl } from "../../config/site";

const pageTitle =
	"Words to Pages Calculator & Book Page Count Converter | Wordora";
const pageDescription =
	"Free words to pages calculator and words per page calculator. Convert essay word count to pages, estimate book page count by word count, or check how many words is 7 pages.";
const canonicalUrl = resolveCanonicalUrl("/words-to-pages/");

const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Words to Pages Converter",
	url: canonicalUrl,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web, Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: [
		"Two-way instant conversion between Words to Pages and Pages to Words",
		"Line spacing presets for Single-spaced (~500 words/page), 1.5-spaced (~330 words/page), Double-spaced (~250 words/page), and custom words-per-page",
		"Font and size presets for 12pt Times New Roman / Arial, 11pt Calibri, and Paperback Book (~275 words/page)",
		"Quick document word count presets (500, 1,000, 1,500, 2,500, 5,000, and 10,000 words)",
		"Live silent reading time (238 WPM) and speaking time (130 WPM) estimates",
	],
};

const faqList = [
	{
		question: "How many words are in 1 page?",
		answer:
			"Under standard formatting (12-point Times New Roman, 1-inch margins, US Letter paper), 1 single-spaced page contains about 500 words and 1 double-spaced page contains about 250 words. In a 5.5\" × 8.5\" trade paperback novel, 1 page averages 275 words.",
	},
	{
		question: "Is 1,000 words 4 pages?",
		answer:
			"Yes—1,000 words equals 4.0 pages double-spaced using 12-point Times New Roman and 1-inch margins. If your document is single-spaced, 1,000 words equals 2.0 pages, and in 11-point Calibri double-spaced it takes about 3.8 pages.",
	},
	{
		question: "Is 1,500 words 4 or 6 pages?",
		answer:
			"1,500 words is 6.0 pages double-spaced (at 250 words per page) and 3.0 pages single-spaced (at 500 words per page). At 1.5 line spacing, 1,500 words fills 4.5 pages.",
	},
	{
		question: "How many words is 7 pages?",
		answer:
			"Under standard academic formatting (12-point Times New Roman, 1-inch margins), 7 pages is 1,750 words double-spaced (at 250 words per page) or 3,500 words single-spaced (at 500 words per page). At 1.5 line spacing, 7 pages equals roughly 2,310 words, and in a standard 5.5\" × 8.5\" trade paperback book (~275 words per page), 7 pages is about 1,925 words.",
	},
	{
		question: "Is 5,000 words 20 pages?",
		answer:
			"Yes—5,000 words equals 20.0 pages double-spaced or 10.0 pages single-spaced in standard academic formatting. Printed in a 5.5\" × 8.5\" paperback book, 5,000 words is roughly 18.2 pages.",
	},
	{
		question: "How many pages is a 70,000-word book?",
		answer:
			"A 70,000-word novel prints at roughly 255 pages in a standard 5.5\" × 8.5\" trade paperback (~275 words/page), 280 pages in a 5\" × 8\" digest paperback (~250 words/page), or 233 pages in a 6\" × 9\" hardcover (~300 words/page).",
	},
	{
		question: "How many words should a 300-page book be?",
		answer:
			"A 300-page printed book typically contains 75,000 to 90,000 words, depending on trim size, font size, margins, and chapter spacing. Most commercial fiction novels fall squarely within this 300-page benchmark.",
	},
	{
		question: "How many pages is 100,000 words?",
		answer:
			"100,000 words equals 400 pages double-spaced or 200 pages single-spaced in manuscript format, and prints at 333 to 365 pages in a standard trade paperback novel.",
	},
	{
		question: "Does font choice (Times New Roman vs. Arial vs. Calibri) change page count?",
		answer:
			"Yes. At 12-point double-spaced, Calibri fits about 260 words/page, Times New Roman fits 250 words/page, Arial fits 225 words/page, and monospaced Courier New fits only 180 words/page—creating up to a 25% difference in total page count.",
	},
	{
		question: "Does A4 paper hold more words per page than US Letter?",
		answer:
			"Yes. Standard A4 paper (210 × 297 mm) is taller than US Letter (8.5 × 11 in) and provides roughly 6% more printable area with 1-inch margins, fitting about 265 double-spaced words per page instead of 250.",
	},
	{
		question: "How many words is a 5-minute speech in pages?",
		answer:
			"Spoken at a natural conversational pace of 130 to 150 words per minute, a 5-minute speech is 650 to 750 words, which equals 2.6 to 3.0 pages double-spaced (or 1.3 to 1.5 pages single-spaced).",
	},
	{
		question: "Do headings, block quotes, and images change my page count?",
		answer:
			"Yes. Word-to-page formulas measure continuous body paragraphs. Chapter headings, bulleted lists, tables, block quotes, title pages, and reference lists add extra vertical whitespace and will increase your final page count by 5% to 15%.",
	},
	{
		question: "Is this Words to Pages Converter free and private?",
		answer:
			"Yes. Wordora's Words to Pages Converter is 100% free with no limits or sign-up, and all word counting and page calculations run locally inside your browser—your text is never uploaded or stored on any server.",
	},
];

const faqPageSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqList.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer,
		},
	})),
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(softwareAppSchema)}
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify(faqPageSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
