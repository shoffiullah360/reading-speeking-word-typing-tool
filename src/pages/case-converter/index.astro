---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import CaseConverterTool from "../../components/CaseConverterTool.astro";
import Footer from "../../components/Footer.astro";
import { resolveCanonicalUrl } from "../../config/site";

const pageTitle =
	"Case Converter — Sentence Case, Title Case, UPPER, lower, camelCase & snake_case | Wordora";
const pageDescription =
	"Free online Case Converter. Instantly convert text to Sentence case, lower case, UPPER CASE, Title Case (AP/APA), Capitalized Case, camelCase, snake_case, or kebab-case in your browser.";
const canonicalUrl = resolveCanonicalUrl("/case-converter/");

const softwareAppSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Case Converter",
	url: canonicalUrl,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web, Any",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	description: pageDescription,
	featureList: [
		"One-click conversion to Sentence case, lower case, UPPER CASE, Title Case (smart AP/APA capitalization), and Capitalized Case",
		"Developer and slug identifier conversions: camelCase, snake_case, and kebab-case",
		"Live word, character, sentence, and line counts",
		"One-click Copy Text, Download .txt file, and Clear controls",
	],
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalUrl={canonicalUrl}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={JSON.stringify(softwareAppSchema)}
		/>
	</Fragment>

	<Header />

	<main class="flex-1">
		<!-- Clean Editorial Tool Header -->
		<section class="px-4 pt-12 pb-4 sm:px-6 sm:pt-16 sm:pb-6">
			<div class="mx-auto max-w-[1200px]">
				<h1
					class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1.4px] text-ink sm:text-[42px] sm:leading-[48px] sm:tracking-[-1.8px]"
				>
					Case Converter
				</h1>

				<p
					class="mt-3 max-w-2xl text-[16px] leading-[25px] font-normal text-body"
				>
					Switch any text between Sentence case, Title Case, UPPER CASE, lower case, camelCase, snake_case, and kebab-case in a single click.
				</p>
			</div>
		</section>

		<!-- Interactive Case Converter Workspace -->
		<CaseConverterTool />

		{/* Editorial Content & FAQ Slot — User Managed */}
		<div id="editorial-content-slot" class="mx-auto max-w-[1200px] px-4 sm:px-6"></div>
	</main>

	<Footer />
</Layout>

