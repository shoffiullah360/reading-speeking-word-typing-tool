		<!-- Stat 2: Total words -->
		<article class="kpi-card whisper-shadow flex flex-col justify-between rounded-md border border-[#1d463b] bg-[#0f2e26] p-3 sm:p-3.5 dark:border-hairline dark:bg-canvas-elevated">
			<div class="flex items-center justify-between gap-2">
				<span class="text-[12px] font-medium text-[#e2f5ee] dark:text-body">
					{t('wordsToPages.ui.kpiWordsLabel')}
				</span>
				<span
					id="wtp-badge-mode"
					class="shrink-0 rounded-full border border-[#1d463b] bg-[#153d33] px-2 py-0.5 text-[11px] font-medium text-[#afe3d0] dark:border-transparent dark:bg-hairline-soft dark:text-ink"
				>
					{t('wordsToPages.ui.tabWordsToPages')}
				</span>
			</div>
			<div class="my-1.5 flex items-baseline gap-2">
				<output
					id="wtp-metric-words"
					aria-live="polite"
					class="font-sans text-xl leading-[26px] font-semibold tracking-[-0.6px] text-[#afe3d0] tabular-nums sm:text-2xl sm:leading-[30px] dark:text-ink"
				>
					{t('wordsToPages.client.wordsPlural', { count: 0 })}
				</output>
			</div>
			<p id="wtp-metric-chars-sub" class="truncate text-[11px] text-[#e2f5ee]/80 tabular-nums dark:text-mute">
				{t('wordsToPages.client.charsSub', { withSpaces: 0, noSpaces: 0 })}
			</p>
		</article>

		<!-- Stat 3: Silent reading time -->
		<article class="kpi-card whisper-shadow flex flex-col justify-between rounded-md border border-[#1d463b] bg-[#0f2e26] p-3 sm:p-3.5 dark:border-hairline dark:bg-canvas-elevated">
			<div class="flex items-center justify-between gap-2">
				<span class="text-[12px] font-medium text-[#e2f5ee] dark:text-body">
					{t('wordsToPages.ui.kpiReadingLabel')}
				</span>
				<span
					class="shrink-0 rounded-full border border-[#1d463b] bg-[#153d33] px-2 py-0.5 text-[11px] font-medium text-[#afe3d0] tabular-nums dark:border-transparent dark:bg-hairline-soft dark:text-ink"
				>
					238 WPM
				</span>
			</div>
			<div class="my-1.5 flex items-baseline gap-2">
				<output
					id="wtp-metric-reading-time"
					aria-live="polite"
					class="font-sans text-xl leading-[26px] font-semibold tracking-[-0.6px] text-[#afe3d0] tabular-nums sm:text-2xl sm:leading-[30px] dark:text-ink"
				>
					{t('wordsToPages.client.zeroTime')}
				</output>
			</div>
			<p class="truncate text-[11px] text-[#e2f5ee]/80 tabular-nums dark:text-mute">
				{t('wordsToPages.ui.kpiReadingSub')}
			</p>
		</article>

		<!-- Stat 4: Speaking time -->
		<article class="kpi-card whisper-shadow flex flex-col justify-between rounded-md border border-[#1d463b] bg-[#0f2e26] p-3 sm:p-3.5 dark:border-hairline dark:bg-canvas-elevated">
			<div class="flex items-center justify-between gap-2">
				<span class="text-[12px] font-medium text-[#e2f5ee] dark:text-body">
					{t('wordsToPages.ui.kpiSpeakingLabel')}
				</span>
				<span
					class="shrink-0 rounded-full border border-[#1d463b] bg-[#153d33] px-2 py-0.5 text-[11px] font-medium text-[#afe3d0] tabular-nums dark:border-transparent dark:bg-hairline-soft dark:text-ink"
				>
					183 WPM
				</span>
			</div>
			<div class="my-1.5 flex items-baseline gap-2">
				<output
					id="wtp-metric-speaking-time"
					aria-live="polite"
					class="font-sans text-xl leading-[26px] font-semibold tracking-[-0.6px] text-[#afe3d0] tabular-nums sm:text-2xl sm:leading-[30px] dark:text-ink"
				>
					{t('wordsToPages.client.zeroTime')}
				</output>
			</div>
			<p class="truncate text-[11px] text-[#e2f5ee]/80 tabular-nums dark:text-mute">
				{t('wordsToPages.ui.kpiSpeakingSub')}
			</p>
		</article>
	</div>

	<!-- Related Tools Navigation Strip -->
	<aside aria-label={t('wordsToPages.ui.relatedAriaLabel')} class="mt-6 border-t border-hairline pt-3">
		<p class="text-xs text-mute">
			{t('wordsToPages.ui.relatedToolsLabel')}{' '}
			{
				readingTool?.status === 'live' ? (
					<a
						href={getLocalizedPath(readingTool.slug, locale)}
						class="font-medium text-ink underline decoration-hairline underline-offset-2 transition-colors hover:text-primary hover:decoration-primary"
					>
						{t(`${readingTool.dictKey}.shortName`)}
					</a>
				) : (
					<span>{readingTool ? t(`${readingTool.dictKey}.shortName`) : t('readingTimeCalculator.shortName')}</span>
				)
			}
			{' · '}
			{
				wordCounterTool?.status === 'live' ? (
					<a
						href={getLocalizedPath(wordCounterTool.slug, locale)}
						class="font-medium text-ink underline decoration-hairline underline-offset-2 transition-colors hover:text-primary hover:decoration-primary"
					>
						{t(`${wordCounterTool.dictKey}.shortName`)}
					</a>
				) : (
					<span>{wordCounterTool ? t(`${wordCounterTool.dictKey}.shortName`) : t('wordCounter.shortName')}</span>
				)
			}
			{' · '}
			{
				speechTool?.status === 'live' ? (
					<a
						href={getLocalizedPath(speechTool.slug, locale)}
						class="font-medium text-ink underline decoration-hairline underline-offset-2 transition-colors hover:text-primary hover:decoration-primary"
					>
						{t(`${speechTool.dictKey}.shortName`)}
					</a>
				) : (
					<span>{speechTool ? t(`${speechTool.dictKey}.shortName`) : t('speechCalculator.shortName')}</span>
				)
			}.
		</p>
	</aside>
</section>

<script
	type="application/json"
	id="wtp-i18n"
	set:html={JSON.stringify(clientI18n).replace(/</g, '\\u003c')}
/>

<script>
	interface WtpClientI18n {
		zeroTime: string;
		timeHrMin: string;
		timeMinSec: string;
		spacingSingle: string;
		spacing15: string;
		spacingDouble: string;
		spacingCustom: string;
		spacingOther: string;
		activeSpacingDisplay: string;
		customOverride: string;
		autoCalculated: string;
		shortFormats: Record<string, string>;
		modePasted: string;
		modeW2P: string;
		modeP2W: string;
		parsedPasted: string;
		parsedWords: string;
		shorthandHint: string;
		microstats: string;
		pagesSingular: string;
		pagesPlural: string;
		fullPageSingular: string;
		fullPagePlural: string;
		sheetSingular: string;
		sheetPlural: string;
		doubleSidedSheetSingular: string;
		doubleSidedSheetPlural: string;
		pagesSub: string;
		wordsSingular: string;
		wordsPlural: string;
		charsSub: string;
		forWordSingular: string;
		forWordsPlural: string;
		copyResult: string;
		copyLink: string;
		copied: string;
		copyHeader: string;
		copyEstimatedPages: string;
		copyTotalWords: string;
		copyCharacters: string;
		copyParagraphs: string;
		copyWpp: string;
		copySilentReading: string;
		copySpeakingTime: string;
		copyFooter: string;
		pageUrl: string;
	}

	function initWordsToPagesCalculator() {
		const i18nEl = document.getElementById('wtp-i18n');
		const i18n: WtpClientI18n = i18nEl?.textContent
			? (JSON.parse(i18nEl.textContent) as WtpClientI18n)
			: ({} as WtpClientI18n);

		function fmt(template: string, vars: Record<string, string | number>): string {
			return template.replace(/\{(\w+)\}/g, (_, k: string) => String(vars[k] ?? `{${k}}`));
		}

		function formatPagesText(valStr: string): string {
			const isOne = valStr === '1' || valStr === '1.0';
			return fmt(isOne ? i18n.pagesSingular : i18n.pagesPlural, { count: valStr });
		}

		function formatWordsText(count: number): string {
			return fmt(count === 1 ? i18n.wordsSingular : i18n.wordsPlural, {
				count: count.toLocaleString(),
			});
		}

		function formatFullPagesText(count: number): string {
			return fmt(count === 1 ? i18n.fullPageSingular : i18n.fullPagePlural, { count });
		}

		function formatSheetsText(count: number): string {
			return fmt(count === 1 ? i18n.sheetSingular : i18n.sheetPlural, { count });
		}

		function formatDoubleSidedSheetsText(count: number): string {
			return fmt(count === 1 ? i18n.doubleSidedSheetSingular : i18n.doubleSidedSheetPlural, {
				count,
			});
		}

		const SILENT_WPM = 238;
		const SPEAKING_WPM = 183;

		const DEFAULTS = {
			spacing: '2.0',
			font: 'times',
			size: '12',
			format: 'letter',
			margins: 'normal',
			orientation: 'portrait',
			wpp: 250,
		};

		type Mode = 'w2p' | 'p2w';

		let mode: Mode = 'w2p';
		let activeSpacing = DEFAULTS.spacing;
		let customRateActive = false;
		let customWppValue = 250;

		const el = <T extends HTMLElement>(id: string): T | null =>
			document.getElementById(id) as T | null;

		// Mode tabs & panels
		const modeBtns = document.querySelectorAll<HTMLButtonElement>('.wtp-mode-btn');
		const panelW2P = el<HTMLElement>('wtp-panel-w2p');
		const panelP2W = el<HTMLElement>('wtp-panel-p2w');

		// Header action buttons
		const btnCopyResult = el<HTMLButtonElement>('wtp-btn-copy-result');
		const btnCopyLink = el<HTMLButtonElement>('wtp-btn-copy-link');
		const btnReset = el<HTMLButtonElement>('wtp-btn-reset');

		// Inputs
		const wordsInput = el<HTMLInputElement>('wtp-words-input');
		const wordsParsedBadge = el<HTMLElement>('wtp-words-parsed');
		const pagesInput = el<HTMLInputElement>('wtp-pages-input');

		// Direct Compact Textarea & Stats
		const directPaste = el<HTMLTextAreaElement>('wtp-direct-paste');
		const directClearBtn = el<HTMLButtonElement>('wtp-direct-clear');
		const directMicrostats = el<HTMLElement>('wtp-direct-microstats');

		// Presets
		const wordPresetBtns = document.querySelectorAll<HTMLButtonElement>('.wtp-word-preset');
		const pagePresetBtns = document.querySelectorAll<HTMLButtonElement>('.wtp-page-preset');

		// Line Spacing Controls
		const spacingPillBtns = document.querySelectorAll<HTMLButtonElement>('.wtp-spacing-pill');
		const activeSpacingDisplay = el<HTMLElement>('wtp-active-spacing-display');
		const wppInput = el<HTMLInputElement>('wtp-wpp-input');
		const wppStatus = el<HTMLElement>('wtp-wpp-status');

		// 5 Dropdowns
		const selectFont = el<HTMLSelectElement>('wtp-select-font');
		const selectSize = el<HTMLSelectElement>('wtp-select-size');
		const selectFormat = el<HTMLSelectElement>('wtp-select-format');
		const selectMargins = el<HTMLSelectElement>('wtp-select-margins');
		const selectOrientation = el<HTMLSelectElement>('wtp-select-orientation');
		const typographySummary = el<HTMLElement>('wtp-typography-summary');

		// 2x2 Mint KPI outputs (Bottom of Left Column)
		const metricPages = el<HTMLElement>('wtp-metric-pages');
		const metricPagesSub = el<HTMLElement>('wtp-metric-pages-sub');
		const badgePages = el<HTMLElement>('wtp-badge-pages');

		const metricWords = el<HTMLElement>('wtp-metric-words');
		const metricCharsSub = el<HTMLElement>('wtp-metric-chars-sub');
		const badgeMode = el<HTMLElement>('wtp-badge-mode');

		const metricReadingTime = el<HTMLElement>('wtp-metric-reading-time');
		const metricSpeakingTime = el<HTMLElement>('wtp-metric-speaking-time');

		// Comparison strip elements
		const compBaseBadge = el<HTMLElement>('wtp-comparison-base-badge');
		const compSingle = el<HTMLElement>('wtp-comp-single');
		const comp15 = el<HTMLElement>('wtp-comp-15');
		const compDouble = el<HTMLElement>('wtp-comp-double');

		const state = {
			currentWords: 0,
			currentPages: 0,
			charsWithSpaces: 0,
			charsNoSpaces: 0,
			paragraphs: 0,
			source: 'numeric' as 'numeric' | 'paste' | 'pages',
		};

		function parseWordCount(raw: string | null | undefined): number {
			if (!raw) return 0;
			let str = String(raw).trim().toLowerCase().replace(/,/g, '');
			if (!str) return 0;
			let multiplier = 1;
			if (str.endsWith('k')) {
				multiplier = 1000;
				str = str.slice(0, -1).trim();
			} else if (str.endsWith('m')) {
				multiplier = 1000000;
				str = str.slice(0, -1).trim();
			}
			const val = parseFloat(str);
			if (isNaN(val) || val < 0) return 0;
			return Math.min(10000000, Math.round(val * multiplier));
		}

		function countTextMetrics(text: string) {
			const trimmed = text.trim();
			const words = trimmed ? trimmed.split(/\s+/).filter(Boolean).length : 0;
			const charsWithSpaces = text.length;
			const charsNoSpaces = text.replace(/\s/g, '').length;
			const paragraphs = trimmed
				? trimmed.split(/\n+/).filter((p) => p.trim().length > 0).length
				: 0;
			return { words, charsWithSpaces, charsNoSpaces, paragraphs };
		}

		function computeWppFromSettings(): number {
			if (customRateActive) {
				return customWppValue > 0 ? customWppValue : 250;
			}

			const baseSpacingMap: Record<string, number> = {
				'1.0': 500,
				'1.5': 330,
				'2.0': 250,
			};

			const fontFactorMap: Record<string, number> = {
				times: 1.0,
				arial: 0.95,
				calibri: 1.08,
				comic: 0.88,
				courier: 0.72,
				garamond: 1.05,
				verdana: 0.84,
			};

			const sizeFactorMap: Record<string, number> = {
				'10': 1.25,
				'10.5': 1.18,
				'11': 1.1,
				'11.5': 1.05,
				'12': 1.0,
				'12.5': 0.94,
				'13': 0.88,
				'13.5': 0.83,
				'14': 0.78,
			};

			const formatFactorMap: Record<string, number> = {
				letter: 1.0,
				a4: 1.04,
				a5: 0.5,
				b5: 0.72,
				legal: 1.27,
				digest: 1.0,
				trade: 1.1,
				hardcover: 1.2,
			};

			const marginsFactorMap: Record<string, number> = {
				normal: 1.0,
				narrow: 1.25,
				moderate: 1.12,
				wide: 0.85,
			};

			const orientationFactorMap: Record<string, number> = {
				portrait: 1.0,
				landscape: 0.95,
			};

			const base = baseSpacingMap[activeSpacing] || 250;
			const fontKey = selectFont?.value || 'times';
			const sizeKey = selectSize?.value || '12';
			const formatKey = selectFormat?.value || 'letter';
			const marginsKey = selectMargins?.value || 'normal';
			const orientationKey = selectOrientation?.value || 'portrait';

			const fFactor = fontFactorMap[fontKey] ?? 1.0;
			const sFactor = sizeFactorMap[sizeKey] ?? 1.0;
			const fmtFactor = formatFactorMap[formatKey] ?? 1.0;
			const mFactor = marginsFactorMap[marginsKey] ?? 1.0;
			const oFactor = orientationFactorMap[orientationKey] ?? 1.0;

			return Math.max(20, Math.round(base * fFactor * sFactor * fmtFactor * mFactor * oFactor));
		}

		function formatTime(totalSeconds: number): string {
			if (totalSeconds <= 0) return i18n.zeroTime;
			const minutes = Math.floor(totalSeconds / 60);
			const seconds = totalSeconds % 60;
			if (minutes >= 60) {
				const hours = Math.floor(minutes / 60);
				const remMins = minutes % 60;
				return fmt(i18n.timeHrMin, { h: hours, m: remMins });
			}
			return fmt(i18n.timeMinSec, { m: minutes, s: seconds });
		}

		function getSpacingLabel(): string {
			if (customRateActive) return i18n.spacingCustom;
			switch (activeSpacing) {
				case '1.0':
					return i18n.spacingSingle;
				case '1.5':
					return i18n.spacing15;
				case '2.0':
					return i18n.spacingDouble;
				default:
					return fmt(i18n.spacingOther, { spacing: activeSpacing });
			}
		}

		function updatePillStyles<T extends HTMLElement>(
			elements: NodeListOf<T>,
			activeValue: string,
			dataAttr: string,
		) {
			elements.forEach((btn) => {
				const val = btn.getAttribute(dataAttr);
				if (val === activeValue) {
					btn.classList.add('border-primary', 'bg-primary', 'text-on-primary');
					btn.classList.remove('border-hairline', 'bg-canvas', 'text-body');
				} else {
					btn.classList.remove('border-primary', 'bg-primary', 'text-on-primary');
					btn.classList.add('border-hairline', 'bg-canvas', 'text-body');
				}
			});
		}

		function updateInputPills() {
			const w = state.currentWords;
			wordPresetBtns.forEach((btn) => {
				const presetVal = Number(btn.getAttribute('data-words-preset'));
				if (w > 0 && presetVal === w && mode === 'w2p' && state.source === 'numeric') {
					btn.classList.add('border-primary', 'bg-primary', 'text-on-primary');
					btn.classList.remove('border-hairline', 'bg-canvas', 'text-body');
				} else {
					btn.classList.remove('border-primary', 'bg-primary', 'text-on-primary');
					btn.classList.add('border-hairline', 'bg-canvas', 'text-body');
				}
			});

			pagePresetBtns.forEach((btn) => {
				const presetVal = Number(btn.getAttribute('data-pages-preset'));
				if (state.currentPages > 0 && presetVal === state.currentPages && mode === 'p2w') {
					btn.classList.add('border-primary', 'bg-primary', 'text-on-primary');
					btn.classList.remove('border-hairline', 'bg-canvas', 'text-body');
				} else {
					btn.classList.remove('border-primary', 'bg-primary', 'text-on-primary');
					btn.classList.add('border-hairline', 'bg-canvas', 'text-body');
				}
			});
		}

		function updateSpacingUI() {
			updatePillStyles(
				spacingPillBtns,
				customRateActive ? 'custom' : activeSpacing,
				'data-spacing-preset',
			);

			const wpp = computeWppFromSettings();
			if (activeSpacingDisplay) {
				activeSpacingDisplay.textContent = fmt(i18n.activeSpacingDisplay, {
					label: getSpacingLabel(),
					wpp,
				});
			}

			if (wppInput && !customRateActive) {
				wppInput.value = String(wpp);
			}

			if (wppStatus) {
				if (customRateActive) {
					wppStatus.textContent = i18n.customOverride;
					wppStatus.classList.remove('text-mute');
					wppStatus.classList.add('text-ink', 'font-medium');
				} else {
					wppStatus.textContent = i18n.autoCalculated;
					wppStatus.classList.remove('text-ink', 'font-medium');
					wppStatus.classList.add('text-mute');
				}
			}

			if (typographySummary) {
				const fontText = selectFont?.options[selectFont.selectedIndex]?.text.split(' ')[0] || 'Times';
				const sizeText = selectSize?.options[selectSize.selectedIndex]?.text || '12 pt';
				const formatText = i18n.shortFormats[selectFormat?.value || ''] || i18n.shortFormats.letter;
				typographySummary.textContent = `${fontText} · ${sizeText} · ${formatText}`;
			}
		}

		function syncMode() {
			modeBtns.forEach((btn) => {
				const btnMode = btn.getAttribute('data-mode');
				if (btnMode === mode) {
					btn.setAttribute('aria-selected', 'true');
					btn.classList.add('bg-primary', 'text-on-primary');
					btn.classList.remove('bg-transparent', 'text-body');
				} else {
					btn.setAttribute('aria-selected', 'false');
					btn.classList.remove('bg-primary', 'text-on-primary');
					btn.classList.add('bg-transparent', 'text-body');
				}
			});

			if (panelW2P) panelW2P.classList.toggle('hidden', mode !== 'w2p');
			if (panelP2W) panelP2W.classList.toggle('hidden', mode !== 'p2w');

			if (badgeMode) {
				badgeMode.textContent =
					mode === 'w2p'
						? state.source === 'paste'
							? i18n.modePasted
							: i18n.modeW2P
						: i18n.modeP2W;
			}
		}

		function formatMicrostats(words: number, chars: number, paragraphs: number): string {
			return fmt(i18n.microstats, {
				words: words.toLocaleString(),
				chars: chars.toLocaleString(),
				paragraphs: paragraphs.toLocaleString(),
			});
		}

		function recalculate() {
			const wpp = computeWppFromSettings();

			if (state.source === 'paste') {
				const text = directPaste?.value ?? '';
				const metrics = countTextMetrics(text);
				state.currentWords = metrics.words;
				state.currentPages = wpp > 0 && metrics.words > 0 ? metrics.words / wpp : 0;
				state.charsWithSpaces = metrics.charsWithSpaces;
				state.charsNoSpaces = metrics.charsNoSpaces;
				state.paragraphs = metrics.paragraphs;

				if (wordsInput) {
					wordsInput.value = metrics.words > 0 ? metrics.words.toLocaleString() : '';
				}

				if (wordsParsedBadge) {
					wordsParsedBadge.textContent =
						metrics.words > 0
							? fmt(i18n.parsedPasted, { words: metrics.words.toLocaleString() })
							: i18n.shorthandHint;
				}

				if (directMicrostats) {
					directMicrostats.textContent = formatMicrostats(
						metrics.words,
						metrics.charsWithSpaces,
						metrics.paragraphs,
					);
				}
				if (directClearBtn) {
					directClearBtn.classList.toggle('hidden', text.length === 0);
				}
			} else if (mode === 'w2p') {
				const raw = wordsInput?.value ?? '';
				const parsed = parseWordCount(raw);
				state.currentWords = parsed;
				state.currentPages = wpp > 0 && parsed > 0 ? parsed / wpp : 0;
				state.charsWithSpaces = parsed > 0 ? Math.round(parsed * 6) : 0;
				state.charsNoSpaces = parsed > 0 ? Math.round(parsed * 5) : 0;
				state.paragraphs = parsed > 0 ? Math.max(1, Math.ceil(parsed / 125)) : 0;

				if (wordsParsedBadge) {
					if (raw.toLowerCase().includes('k') || raw.toLowerCase().includes('m')) {
						wordsParsedBadge.textContent = fmt(i18n.parsedWords, {
							words: parsed.toLocaleString(),
						});
						wordsParsedBadge.classList.add('text-ink', 'font-medium');
						wordsParsedBadge.classList.remove('text-mute');
					} else {
						wordsParsedBadge.textContent = i18n.shorthandHint;
						wordsParsedBadge.classList.remove('text-ink', 'font-medium');
						wordsParsedBadge.classList.add('text-mute');
					}
				}

				if (!directPaste?.value.trim()) {
					if (directMicrostats) {
						directMicrostats.textContent = formatMicrostats(
							parsed,
							state.charsWithSpaces,
							state.paragraphs,
						);
					}
					if (directClearBtn) directClearBtn.classList.add('hidden');
				}
			} else if (mode === 'p2w') {
				const pagesVal = Number(pagesInput?.value);
				const pages = Number.isFinite(pagesVal) && pagesVal > 0 ? pagesVal : 0;
				state.currentPages = pages;
				state.currentWords = Math.round(pages * wpp);
				state.charsWithSpaces = state.currentWords > 0 ? Math.round(state.currentWords * 6) : 0;
				state.charsNoSpaces = state.currentWords > 0 ? Math.round(state.currentWords * 5) : 0;
				state.paragraphs = state.currentWords > 0 ? Math.max(1, Math.ceil(state.currentWords / 125)) : 0;

				if (!directPaste?.value.trim()) {
					if (directMicrostats) {
						directMicrostats.textContent = formatMicrostats(
							state.currentWords,
							state.charsWithSpaces,
							state.paragraphs,
						);
					}
					if (directClearBtn) directClearBtn.classList.add('hidden');
				}
			}

			syncMode();
			updateInputPills();
			updateSpacingUI();
			renderOutputs();
		}

		function renderOutputs() {
			const w = state.currentWords;
			const p = state.currentPages;

			// 1. Estimated pages
			if (metricPages) {
				metricPages.textContent = formatPagesText(p.toFixed(1));
			}
			if (metricPagesSub) {
				const fullPages = Math.ceil(p);
				const sheets = Math.ceil(p / 2);
				metricPagesSub.textContent = fmt(i18n.pagesSub, {
					full: formatFullPagesText(fullPages),
					sheets: formatSheetsText(sheets),
				});
			}
			if (badgePages) {
				badgePages.textContent = getSpacingLabel();
			}

			// 2. Total words
			if (metricWords) {
				metricWords.textContent = formatWordsText(w);
			}
			if (metricCharsSub) {
				metricCharsSub.textContent = fmt(i18n.charsSub, {
					withSpaces: state.charsWithSpaces.toLocaleString(),
					noSpaces: state.charsNoSpaces.toLocaleString(),
				});
			}

			// 3. Silent reading time
			const silentSec = w > 0 ? Math.round((w / SILENT_WPM) * 60) : 0;
			const speakingSec = w > 0 ? Math.round((w / SPEAKING_WPM) * 60) : 0;

			if (metricReadingTime) {
				metricReadingTime.textContent = formatTime(silentSec);
			}

			// 4. Speaking time
			if (metricSpeakingTime) {
				metricSpeakingTime.textContent = formatTime(speakingSec);
			}

			// Live Format Comparison Strip
			if (compBaseBadge) {
				compBaseBadge.textContent = fmt(w === 1 ? i18n.forWordSingular : i18n.forWordsPlural, {
					words: w.toLocaleString(),
				});
			}
			if (compSingle) {
				const pages = w > 0 ? (w / 500).toFixed(1) : '0';
				compSingle.textContent = formatPagesText(pages);
			}
			if (comp15) {
				const pages = w > 0 ? (w / 330).toFixed(1) : '0';
				comp15.textContent = formatPagesText(pages);
			}
			if (compDouble) {
				const pages = w > 0 ? (w / 250).toFixed(1) : '0';
				compDouble.textContent = formatPagesText(pages);
			}
		}

		// Event Listeners: Mode Tabs
		modeBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const targetMode = btn.getAttribute('data-mode') as Mode;
				if (targetMode && targetMode !== mode) {
					mode = targetMode;
					state.source = targetMode === 'w2p' ? 'numeric' : 'pages';
					syncMode();
					recalculate();
				}
			});
		});

		// Event Listeners: Direct Textarea Input & Clear
		directPaste?.addEventListener('input', () => {
			state.source = 'paste';
			mode = 'w2p';
			recalculate();
		});

		directClearBtn?.addEventListener('click', () => {
			if (directPaste) directPaste.value = '';
			if (wordsInput) wordsInput.value = '';
			state.source = 'numeric';
			recalculate();
			if (directMicrostats) directMicrostats.textContent = formatMicrostats(0, 0, 0);
			if (directClearBtn) directClearBtn.classList.add('hidden');
		});

		// Event Listeners: Numeric Inputs
		wordsInput?.addEventListener('input', () => {
			state.source = 'numeric';
			if (directPaste && directPaste.value) {
				directPaste.value = '';
				if (directClearBtn) directClearBtn.classList.add('hidden');
			}
			recalculate();
		});
		wordsInput?.addEventListener('change', () => {
			state.source = 'numeric';
			recalculate();
		});

		pagesInput?.addEventListener('input', () => {
			state.source = 'pages';
			recalculate();
		});
		pagesInput?.addEventListener('change', () => {
			state.source = 'pages';
			recalculate();
		});

		// Event Listeners: Word Presets
		wordPresetBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const presetVal = btn.getAttribute('data-words-preset');
				if (wordsInput && presetVal) {
					wordsInput.value = Number(presetVal).toLocaleString();
					if (directPaste) directPaste.value = '';
					if (directClearBtn) directClearBtn.classList.add('hidden');
					mode = 'w2p';
					state.source = 'numeric';
					recalculate();
				}
			});
		});

		pagePresetBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const presetVal = btn.getAttribute('data-pages-preset');
				if (pagesInput && presetVal) {
					pagesInput.value = presetVal;
					mode = 'p2w';
					state.source = 'pages';
					recalculate();
				}
			});
		});

		// Event Listeners: Spacing Pills
		spacingPillBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const val = btn.getAttribute('data-spacing-preset');
				if (val === 'custom') {
					customRateActive = true;
					const currentWpp = Number(wppInput?.value) || 250;
					customWppValue = currentWpp;
					if (wppInput) wppInput.focus();
				} else if (val) {
					customRateActive = false;
					activeSpacing = val;
				}
				recalculate();
			});
		});

		// Event Listeners: Words Per Page Input
		wppInput?.addEventListener('input', () => {
			const val = Number(wppInput.value);
			if (Number.isFinite(val) && val > 0) {
				customRateActive = true;
				customWppValue = val;
				recalculate();
			}
		});

		// Event Listeners: Dropdowns
		[selectFont, selectSize, selectFormat, selectMargins, selectOrientation].forEach((sel) => {
			sel?.addEventListener('change', () => {
				customRateActive = false;
				recalculate();
			});
		});

		// Copy Result Action
		btnCopyResult?.addEventListener('click', async () => {
			const w = state.currentWords;
			const p = state.currentPages;
			const wpp = computeWppFromSettings();
			const silentSec = w > 0 ? Math.round((w / SILENT_WPM) * 60) : 0;
			const speakingSec = w > 0 ? Math.round((w / SPEAKING_WPM) * 60) : 0;

			const text = [
				i18n.copyHeader,
				'──────────────────────────────────',
				fmt(i18n.copyEstimatedPages, {
					pages: formatPagesText(p.toFixed(1)),
					full: formatFullPagesText(Math.ceil(p)),
					sheets: formatDoubleSidedSheetsText(Math.ceil(p / 2)),
				}),
				fmt(i18n.copyTotalWords, { words: formatWordsText(w) }),
				fmt(i18n.copyCharacters, {
					withSpaces: state.charsWithSpaces.toLocaleString(),
					noSpaces: state.charsNoSpaces.toLocaleString(),
				}),
				fmt(i18n.copyParagraphs, { paragraphs: state.paragraphs.toLocaleString() }),
				fmt(i18n.copyWpp, { wpp, spacing: getSpacingLabel() }),
				fmt(i18n.copySilentReading, { time: formatTime(silentSec) }),
				fmt(i18n.copySpeakingTime, { time: formatTime(speakingSec) }),
				'──────────────────────────────────',
				fmt(i18n.copyFooter, { url: i18n.pageUrl }),
			].join('\n');

			try {
				await navigator.clipboard.writeText(text);
			} catch {
				const ta = document.createElement('textarea');
				ta.value = text;
				ta.style.position = 'fixed';
				ta.style.opacity = '0';
				document.body.appendChild(ta);
				ta.focus();
				ta.select();
				document.execCommand('copy');
				document.body.removeChild(ta);
			}

			btnCopyResult.textContent = i18n.copied;
			btnCopyResult.classList.add('text-primary');
			setTimeout(() => {
				btnCopyResult.textContent = i18n.copyResult;
				btnCopyResult.classList.remove('text-primary');
			}, 1800);
		});

		// Copy Link Action
		btnCopyLink?.addEventListener('click', async () => {
			const url = new URL(window.location.href);
			url.searchParams.set('mode', mode);

			if (mode === 'w2p' && state.currentWords > 0) {
				url.searchParams.set('words', String(state.currentWords));
				url.searchParams.delete('pages');
			} else if (mode === 'p2w' && state.currentPages > 0) {
				url.searchParams.set('pages', String(state.currentPages));
				url.searchParams.delete('words');
			}

			if (customRateActive) {
				url.searchParams.set('wpp', String(customWppValue));
			} else {
				url.searchParams.delete('wpp');
				if (activeSpacing !== DEFAULTS.spacing) url.searchParams.set('spacing', activeSpacing);
				else url.searchParams.delete('spacing');
			}

			if (selectFont && selectFont.value !== DEFAULTS.font) url.searchParams.set('font', selectFont.value);
			else url.searchParams.delete('font');

			if (selectSize && selectSize.value !== DEFAULTS.size) url.searchParams.set('size', selectSize.value);
			else url.searchParams.delete('size');

			if (selectFormat && selectFormat.value !== DEFAULTS.format) url.searchParams.set('fmt', selectFormat.value);
			else url.searchParams.delete('fmt');

			if (selectMargins && selectMargins.value !== DEFAULTS.margins) url.searchParams.set('mrg', selectMargins.value);
			else url.searchParams.delete('mrg');

			if (selectOrientation && selectOrientation.value !== DEFAULTS.orientation) url.searchParams.set('ori', selectOrientation.value);
			else url.searchParams.delete('ori');

			window.history.replaceState({}, '', url.toString());

			try {
				await navigator.clipboard.writeText(url.toString());
			} catch {
				const ta = document.createElement('textarea');
				ta.value = url.toString();
				ta.style.position = 'fixed';
				ta.style.opacity = '0';
				document.body.appendChild(ta);
				ta.focus();
				ta.select();
				document.execCommand('copy');
				document.body.removeChild(ta);
			}

			btnCopyLink.textContent = i18n.copied;
			btnCopyLink.classList.add('text-primary');
			setTimeout(() => {
				btnCopyLink.textContent = i18n.copyLink;
				btnCopyLink.classList.remove('text-primary');
			}, 1800);
		});

		// Reset Defaults Action
		btnReset?.addEventListener('click', () => {
			mode = 'w2p';
			state.source = 'numeric';
			activeSpacing = DEFAULTS.spacing;
			customRateActive = false;
			customWppValue = 250;

			if (wordsInput) wordsInput.value = '';
			if (pagesInput) pagesInput.value = '';
			if (directPaste) directPaste.value = '';
			if (directClearBtn) directClearBtn.classList.add('hidden');
			if (directMicrostats) directMicrostats.textContent = formatMicrostats(0, 0, 0);

			if (selectFont) selectFont.value = DEFAULTS.font;
			if (selectSize) selectSize.value = DEFAULTS.size;
			if (selectFormat) selectFormat.value = DEFAULTS.format;
			if (selectMargins) selectMargins.value = DEFAULTS.margins;
			if (selectOrientation) selectOrientation.value = DEFAULTS.orientation;

			const url = new URL(window.location.href);
			url.search = '';
			window.history.replaceState({}, '', url.toString());

			syncMode();
			recalculate();
		});

		// Apply URL Query State on Load
		function applyUrlParams() {
			try {
				const params = new URLSearchParams(window.location.search);
				if (!params.toString()) return;

				if (params.get('mode') === 'p2w') {
					mode = 'p2w';
					state.source = 'pages';
				} else {
					mode = 'w2p';
					state.source = 'numeric';
				}

				if (params.has('words') && wordsInput) {
					wordsInput.value = params.get('words') || '';
				}
				if (params.has('pages') && pagesInput) {
					pagesInput.value = params.get('pages') || '';
				}
				if (params.has('spacing')) {
					activeSpacing = params.get('spacing') || DEFAULTS.spacing;
				}
				if (params.has('wpp')) {
					const val = Number(params.get('wpp'));
					if (Number.isFinite(val) && val > 0) {
						customRateActive = true;
						customWppValue = val;
						if (wppInput) wppInput.value = String(val);
					}
				}
				if (params.has('font') && selectFont) {
					selectFont.value = params.get('font') || DEFAULTS.font;
				}
				if (params.has('size') && selectSize) {
					selectSize.value = params.get('size') || DEFAULTS.size;
				}
				if (params.has('fmt') && selectFormat) {
					selectFormat.value = params.get('fmt') || DEFAULTS.format;
				}
				if (params.has('mrg') && selectMargins) {
					selectMargins.value = params.get('mrg') || DEFAULTS.margins;
				}
				if (params.has('ori') && selectOrientation) {
					selectOrientation.value = params.get('ori') || DEFAULTS.orientation;
				}
			} catch {
				// Fallback to defaults
			}
		}

		applyUrlParams();
		syncMode();
		recalculate();
	}

	initWordsToPagesCalculator();
</script>
