---
import { getLocaleFromUrl, getLocalizedPath, useTranslations, type Locale } from '../i18n/ui';
import { getToolById, resolveCanonicalUrl } from '../config/site';

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const readingTool = getToolById('reading-time-calculator');
const wordCounterTool = getToolById('word-counter');
const speechTool = getToolById('speech-time-calculator');

const canonicalPageUrl = resolveCanonicalUrl(getLocalizedPath('/words-to-pages/', locale));

const clientI18n = {
	zeroTime: t('wordsToPages.client.zeroTime'),
	timeHrMin: t('wordsToPages.client.timeHrMin'),
	timeMinSec: t('wordsToPages.client.timeMinSec'),
	spacingSingle: t('wordsToPages.client.spacingSingle'),
	spacing15: t('wordsToPages.client.spacing15'),
	spacingDouble: t('wordsToPages.client.spacingDouble'),
	spacingCustom: t('wordsToPages.client.spacingCustom'),
	spacingOther: t('wordsToPages.client.spacingOther'),
	activeSpacingDisplay: t('wordsToPages.client.activeSpacingDisplay'),
	customOverride: t('wordsToPages.client.customOverride'),
	autoCalculated: t('wordsToPages.client.autoCalculated'),
	shortFormats: {
		letter: t('wordsToPages.client.shortFormats.letter'),
		a4: t('wordsToPages.client.shortFormats.a4'),
		a5: t('wordsToPages.client.shortFormats.a5'),
		b5: t('wordsToPages.client.shortFormats.b5'),
		legal: t('wordsToPages.client.shortFormats.legal'),
		digest: t('wordsToPages.client.shortFormats.digest'),
		trade: t('wordsToPages.client.shortFormats.trade'),
		hardcover: t('wordsToPages.client.shortFormats.hardcover'),
	},
	modePasted: t('wordsToPages.client.modePasted'),
	modeW2P: t('wordsToPages.client.modeW2P'),
	modeP2W: t('wordsToPages.client.modeP2W'),
	parsedPasted: t('wordsToPages.client.parsedPasted'),
	parsedWords: t('wordsToPages.client.parsedWords'),
	shorthandHint: t('wordsToPages.client.shorthandHint'),
	microstats: t('wordsToPages.client.microstats'),
	pagesSingular: t('wordsToPages.client.pagesSingular'),
	pagesPlural: t('wordsToPages.client.pagesPlural'),
	fullPageSingular: t('wordsToPages.client.fullPageSingular'),
	fullPagePlural: t('wordsToPages.client.fullPagePlural'),
	sheetSingular: t('wordsToPages.client.sheetSingular'),
	sheetPlural: t('wordsToPages.client.sheetPlural'),
	doubleSidedSheetSingular: t('wordsToPages.client.doubleSidedSheetSingular'),
	doubleSidedSheetPlural: t('wordsToPages.client.doubleSidedSheetPlural'),
	pagesSub: t('wordsToPages.client.pagesSub'),
	wordsSingular: t('wordsToPages.client.wordsSingular'),
	wordsPlural: t('wordsToPages.client.wordsPlural'),
	charsSub: t('wordsToPages.client.charsSub'),
	forWordSingular: t('wordsToPages.client.forWordSingular'),
	forWordsPlural: t('wordsToPages.client.forWordsPlural'),
	copyResult: t('wordsToPages.client.copyResult'),
	copyLink: t('wordsToPages.client.copyLink'),
	copied: t('wordsToPages.client.copied'),
	copyHeader: t('wordsToPages.client.copyHeader'),
	copyEstimatedPages: t('wordsToPages.client.copyEstimatedPages'),
	copyTotalWords: t('wordsToPages.client.copyTotalWords'),
	copyCharacters: t('wordsToPages.client.copyCharacters'),
	copyParagraphs: t('wordsToPages.client.copyParagraphs'),
	copyWpp: t('wordsToPages.client.copyWpp'),
	copySilentReading: t('wordsToPages.client.copySilentReading'),
	copySpeakingTime: t('wordsToPages.client.copySpeakingTime'),
	copyFooter: t('wordsToPages.client.copyFooter'),
	pageUrl: canonicalPageUrl,
};
---

<section
	id="words-to-pages-workspace"
	aria-label={t('wordsToPages.ui.workspaceLabel')}
	class="mx-auto max-w-[1200px] px-4 pt-3 pb-8 sm:px-6"
>
	<!-- Top 2-Column Calculator Grid -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-stretch">
		<!-- Left Column: Main White Input Card ONLY -->
		<div class="flex flex-col">
			<!-- Main White Input Card -->
			<div class="whisper-shadow shadow-xs flex flex-1 flex-col justify-between rounded-md border border-hairline bg-canvas-elevated">
				<!-- Tab Bar Header: 2 Mode Tabs + Top Actions -->
				<div class="flex flex-wrap items-center justify-between gap-2 border-b border-hairline px-4 py-2.5">
					<div
						role="tablist"
						aria-label={t('wordsToPages.ui.modesLabel')}
						class="inline-flex items-center gap-1"
					>
						<button
							type="button"
							role="tab"
							id="wtp-tab-btn-w2p"
							aria-selected="true"
							aria-controls="wtp-panel-w2p"
							data-mode="w2p"
							class="wtp-mode-btn cursor-pointer rounded-pill-category bg-primary px-3.5 py-1.5 text-[12px] font-medium text-on-primary transition-all"
						>
							{t('wordsToPages.ui.tabWordsToPages')}
						</button>
						<button
							type="button"
							role="tab"
							id="wtp-tab-btn-p2w"
							aria-selected="false"
							aria-controls="wtp-panel-p2w"
							data-mode="p2w"
							class="wtp-mode-btn cursor-pointer rounded-pill-category bg-transparent px-3.5 py-1.5 text-[12px] font-medium text-body transition-all hover:bg-hairline-soft hover:text-ink"
						>
							{t('wordsToPages.ui.tabPagesToWords')}
						</button>
					</div>

					<div class="flex flex-wrap items-center gap-1">
						<button
							type="button"
							id="wtp-btn-copy-result"
							class="cursor-pointer rounded-sm border border-[#5ec4a3] bg-[#afe3d0] px-2.5 py-1 text-[12px] font-semibold text-[#0f2e26] transition-colors hover:bg-[#c5eedf] dark:border-transparent dark:bg-transparent dark:font-medium dark:text-mute dark:hover:bg-hairline-soft dark:hover:text-ink"
						>
							{t('wordsToPages.ui.copyResult')}
						</button>
						<button
							type="button"
							id="wtp-btn-copy-link"
							class="cursor-pointer rounded-sm px-2 py-1 text-[12px] font-medium text-mute transition-colors hover:bg-hairline-soft hover:text-ink"
						>
							{t('wordsToPages.ui.copyLink')}
						</button>
						<button
							type="button"
							id="wtp-btn-reset"
							class="cursor-pointer rounded-sm px-2 py-1 text-[12px] font-medium text-mute transition-colors hover:bg-hairline-soft hover:text-ink"
						>
							{t('wordsToPages.ui.resetDefaults')}
						</button>
					</div>
				</div>

				<!-- Card Content Container -->
				<div class="p-4 space-y-3">
					<!-- Panel 1: Words to Pages (Numeric/Shorthand Input + Presets) -->
					<div
						id="wtp-panel-w2p"
						role="tabpanel"
						aria-labelledby="wtp-tab-btn-w2p"
						class="space-y-2.5"
					>
						<div class="flex items-baseline justify-between gap-2">
							<label for="wtp-words-input" class="text-[13px] font-medium text-ink">
								{t('wordsToPages.ui.enterWordCount')}
							</label>
							<span id="wtp-words-parsed" class="text-[11px] text-mute tabular-nums">
								{t('wordsToPages.ui.shorthandHint')}
							</span>
						</div>

						<div class="relative flex items-center">
							<input
								id="wtp-words-input"
								type="text"
								inputmode="text"
								value=""
								placeholder={t('wordsToPages.ui.wordsPlaceholder')}
								class="w-full rounded-sm border border-hairline bg-canvas px-3 py-2 text-base font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
							/>
							<span class="pointer-events-none absolute right-3 text-[12px] text-mute">
								{t('wordsToPages.ui.unitWords')}
							</span>
						</div>

						<!-- Quick Essay / Document Presets -->
						<div>
							<span class="mb-1 block text-[11px] font-medium text-mute">
								{t('wordsToPages.ui.wordPresetsLabel')}
							</span>
							<div class="flex flex-wrap gap-1">
								{
									[
										{ words: 500, label: '500' },
										{ words: 1000, label: '1,000' },
										{ words: 1500, label: '1,500' },
										{ words: 2000, label: '2,000' },
										{ words: 5000, label: '5,000' },
										{ words: 100000, label: '100,000' },
									].map((preset) => (
										<button
											type="button"
											data-words-preset={preset.words}
											class="wtp-word-preset cursor-pointer rounded-sm border border-hairline bg-canvas px-2.5 py-1 text-xs font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
										>
											{preset.label}
										</button>
									))
								}
							</div>
						</div>
					</div>

					<!-- Panel 2: Pages to Words -->
					<div
						id="wtp-panel-p2w"
						role="tabpanel"
						aria-labelledby="wtp-tab-btn-p2w"
						class="hidden space-y-2.5"
					>
						<div class="flex items-baseline justify-between gap-2">
							<label for="wtp-pages-input" class="text-[13px] font-medium text-ink">
								{t('wordsToPages.ui.enterPageCount')}
							</label>
							<span class="text-[11px] text-mute tabular-nums">
								{t('wordsToPages.ui.pagesHint')}
							</span>
						</div>

						<div class="relative flex items-center">
							<input
								id="wtp-pages-input"
								type="number"
								min="0"
								max="50000"
								step="0.5"
								value=""
								placeholder={t('wordsToPages.ui.pagesPlaceholder')}
								class="w-full rounded-sm border border-hairline bg-canvas px-3 py-2 text-base font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
							/>
							<span class="pointer-events-none absolute right-3 text-[12px] text-mute">
								{t('wordsToPages.ui.unitPages')}
							</span>
						</div>

						<!-- Quick Page Presets -->
						<div>
							<span class="mb-1 block text-[11px] font-medium text-mute">
								{t('wordsToPages.ui.pagePresetsLabel')}
							</span>
							<div class="flex flex-wrap gap-1">
								{
									[2, 5, 10, 50, 300, 500].map((pg) => (
										<button
											type="button"
											data-pages-preset={pg}
											class="wtp-page-preset cursor-pointer rounded-sm border border-hairline bg-canvas px-2.5 py-1 text-xs font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
										>
											{t('wordsToPages.ui.pagesPreset', { count: pg })}
										</button>
									))
								}
							</div>
						</div>
					</div>

					<!-- Direct Compact Text Paste Box (textarea) Directly Below Input & Presets -->
					<div class="border-t border-hairline pt-3">
						<div class="mb-1.5 flex items-baseline justify-between gap-2">
							<label for="wtp-direct-paste" class="text-[12px] font-medium text-ink">
								{t('wordsToPages.ui.pasteLabel')}
							</label>
							<button
								type="button"
								id="wtp-direct-clear"
								class="hidden cursor-pointer text-[11px] font-medium text-mute transition-colors hover:text-ink"
							>
								{t('wordsToPages.ui.clear')}
							</button>
						</div>

						<div class="relative">
							<textarea
								id="wtp-direct-paste"
								rows="6"
								placeholder={t('wordsToPages.ui.pastePlaceholder')}
								class="w-full min-h-[145px] resize-y rounded-sm border border-hairline bg-canvas p-3 text-[13px] leading-relaxed text-ink placeholder:text-mute focus:border-ink focus:bg-canvas-elevated focus:outline-none"
							></textarea>
						</div>

						<!-- Compact Inline Counter -->
						<div class="mt-1.5 flex items-center justify-between text-[11px] text-mute">
							<span id="wtp-direct-microstats" class="tabular-nums">
								{t('wordsToPages.client.microstats', { words: 0, chars: 0, paragraphs: 0 })}
							</span>
							<span class="text-[10px] text-mute">
								{t('wordsToPages.ui.liveSynced')}
							</span>
						</div>
					</div>
				</div>

				<!-- Live Format Comparison Strip -->
				<div class="border-t border-hairline px-4 py-2.5">
					<div class="mb-1.5 flex items-center justify-between gap-2">
						<h2 class="text-[12px] font-semibold text-ink">
							{t('wordsToPages.ui.comparisonHeading')}
						</h2>
						<span id="wtp-comparison-base-badge" class="text-[11px] text-mute tabular-nums">
							{t('wordsToPages.client.forWordsPlural', { words: 0 })}
						</span>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-3 gap-1.5">
						<div class="flex items-center justify-between gap-1.5 rounded-sm border border-hairline bg-canvas px-2.5 py-1 text-xs">
							<span class="text-body truncate">{t('wordsToPages.ui.compSingle')} <span class="text-mute tabular-nums">(1.0)</span></span>
							<strong id="wtp-comp-single" class="font-semibold text-ink tabular-nums">{t('wordsToPages.client.pagesPlural', { count: 0 })}</strong>
						</div>
						<div class="flex items-center justify-between gap-1.5 rounded-sm border border-hairline bg-canvas px-2.5 py-1 text-xs">
							<span class="text-body truncate">{t('wordsToPages.ui.spacing15')}</span>
							<strong id="wtp-comp-15" class="font-semibold text-ink tabular-nums">{t('wordsToPages.client.pagesPlural', { count: 0 })}</strong>
						</div>
						<div class="flex items-center justify-between gap-1.5 rounded-sm border border-hairline bg-canvas px-2.5 py-1 text-xs">
							<span class="text-body truncate">{t('wordsToPages.ui.compDouble')} <span class="text-mute tabular-nums">(2.0)</span></span>
							<strong id="wtp-comp-double" class="font-semibold text-ink tabular-nums">{t('wordsToPages.client.pagesPlural', { count: 0 })}</strong>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Right Column: Top Line Spacing Card + Bottom Font & Page Settings Card -->
		<div class="flex flex-col gap-4">
			<!-- Top Card: Line Spacing -->
			<div class="whisper-shadow h-fit rounded-md border border-hairline bg-canvas-elevated p-4">
				<div class="flex items-baseline justify-between gap-2 mb-2.5">
					<h2 class="text-[14px] font-semibold tracking-[-0.2px] text-ink">
						{t('wordsToPages.ui.lineSpacingHeading')}
					</h2>
					<span
						id="wtp-active-spacing-display"
						class="text-[12px] font-semibold text-ink tabular-nums"
					>
						{t('wordsToPages.client.activeSpacingDisplay', { label: t('wordsToPages.ui.spacingDouble'), wpp: 250 })}
					</span>
				</div>

				<!-- Line Spacing Pills -->
				<div
					role="group"
					aria-label={t('wordsToPages.ui.lineSpacingHeading')}
					class="grid grid-cols-2 gap-1.5 sm:grid-cols-4"
				>
					<button
						type="button"
						data-spacing-preset="1.0"
						class="wtp-spacing-pill cursor-pointer rounded-sm border border-hairline bg-canvas py-1.5 text-center text-xs font-medium tabular-nums transition-all hover:border-ink hover:text-ink"
					>
						{t('wordsToPages.ui.spacingSingle')}
					</button>
					<button
						type="button"
						data-spacing-preset="1.5"
						class="wtp-spacing-pill cursor-pointer rounded-sm border border-hairline bg-canvas py-1.5 text-center text-xs font-medium tabular-nums transition-all hover:border-ink hover:text-ink"
					>
						{t('wordsToPages.ui.spacing15')}
					</button>
					<button
						type="button"
						data-spacing-preset="2.0"
						class="wtp-spacing-pill cursor-pointer rounded-sm border border-primary bg-primary text-on-primary py-1.5 text-center text-xs font-medium tabular-nums transition-all"
					>
						{t('wordsToPages.ui.spacingDouble')}
					</button>
					<button
						type="button"
						data-spacing-preset="custom"
						class="wtp-spacing-pill cursor-pointer rounded-sm border border-hairline bg-canvas py-1.5 text-center text-xs font-medium tabular-nums transition-all hover:border-ink hover:text-ink"
					>
						{t('wordsToPages.ui.spacingCustom')}
					</button>
				</div>

				<!-- Words Per Page Input -->
				<div class="mt-3 rounded-sm border border-hairline bg-canvas p-2.5">
					<div class="flex items-center justify-between gap-2">
						<label for="wtp-wpp-input" class="text-[12px] font-medium text-body">
							{t('wordsToPages.ui.wordsPerPageLabel')}
						</label>
						<span id="wtp-wpp-status" class="text-[11px] text-mute">
							{t('wordsToPages.client.autoCalculated')}
						</span>
					</div>
					<div class="relative mt-1 flex items-center">
						<input
							id="wtp-wpp-input"
							type="number"
							min="20"
							max="5000"
							step="5"
							value="250"
							class="w-full rounded-sm border border-hairline bg-canvas-elevated px-2.5 py-1.5 pr-14 text-sm font-semibold text-ink tabular-nums focus:border-ink focus:outline-none"
						/>
						<span class="pointer-events-none absolute right-2.5 text-[11px] text-mute">
							{t('wordsToPages.ui.unitWpp')}
						</span>
					</div>
				</div>
			</div>

			<!-- Bottom Card: Font & Page Settings (5 Compact Dropdowns) -->
			<div class="whisper-shadow h-fit rounded-md border border-hairline bg-canvas-elevated p-4">
				<div class="flex items-baseline justify-between gap-2 mb-2.5">
					<h2 class="text-[14px] font-semibold tracking-[-0.2px] text-ink">
						{t('wordsToPages.ui.fontSettingsHeading')}
					</h2>
					<span id="wtp-typography-summary" class="text-[11px] text-mute tabular-nums">
						{t('wordsToPages.ui.defaultTypographySummary')}
					</span>
				</div>

				<!-- 5 Compact Dropdowns Grid -->
				<div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
					<!-- 1. Font Family -->
					<div class="space-y-1">
						<label for="wtp-select-font" class="block text-[11px] font-medium text-body">
							{t('wordsToPages.ui.fontFamilyLabel')}
						</label>
						<select
							id="wtp-select-font"
							class="w-full rounded-sm border border-hairline bg-canvas px-2.5 py-1.5 text-xs text-ink focus:border-ink focus:outline-none"
						>
							<option value="times" selected>Times New Roman</option>
							<option value="arial">Arial</option>
							<option value="calibri">Calibri</option>
							<option value="comic">Comic Sans MS</option>
							<option value="courier">Courier</option>
							<option value="garamond">Garamond</option>
							<option value="verdana">Verdana</option>
						</select>
					</div>

					<!-- 2. Font Size -->
					<div class="space-y-1">
						<label for="wtp-select-size" class="block text-[11px] font-medium text-body">
							{t('wordsToPages.ui.fontSizeLabel')}
						</label>
						<select
							id="wtp-select-size"
							class="w-full rounded-sm border border-hairline bg-canvas px-2.5 py-1.5 text-xs text-ink focus:border-ink focus:outline-none"
						>
							<option value="10">10 pt</option>
							<option value="10.5">10.5 pt</option>
							<option value="11">11 pt</option>
							<option value="11.5">11.5 pt</option>
							<option value="12" selected>12 pt</option>
							<option value="12.5">12.5 pt</option>
							<option value="13">13 pt</option>
							<option value="13.5">13.5 pt</option>
							<option value="14">14 pt</option>
						</select>
					</div>

					<!-- 3. Page Format -->
					<div class="space-y-1">
						<label for="wtp-select-format" class="block text-[11px] font-medium text-body">
							{t('wordsToPages.ui.pageFormatLabel')}
						</label>
						<select
							id="wtp-select-format"
							class="w-full rounded-sm border border-hairline bg-canvas px-2.5 py-1.5 text-xs text-ink focus:border-ink focus:outline-none"
						>
							<option value="letter" selected>{t('wordsToPages.ui.formats.letter')}</option>
							<option value="a4">{t('wordsToPages.ui.formats.a4')}</option>
							<option value="a5">{t('wordsToPages.ui.formats.a5')}</option>
							<option value="b5">{t('wordsToPages.ui.formats.b5')}</option>
							<option value="legal">{t('wordsToPages.ui.formats.legal')}</option>
							<option value="digest">{t('wordsToPages.ui.formats.digest')}</option>
							<option value="trade">{t('wordsToPages.ui.formats.trade')}</option>
							<option value="hardcover">{t('wordsToPages.ui.formats.hardcover')}</option>
						</select>
					</div>

					<!-- 4. Margins -->
					<div class="space-y-1">
						<label for="wtp-select-margins" class="block text-[11px] font-medium text-body">
							{t('wordsToPages.ui.marginsLabel')}
						</label>
						<select
							id="wtp-select-margins"
							class="w-full rounded-sm border border-hairline bg-canvas px-2.5 py-1.5 text-xs text-ink focus:border-ink focus:outline-none"
						>
							<option value="normal" selected>{t('wordsToPages.ui.margins.normal')}</option>
							<option value="narrow">{t('wordsToPages.ui.margins.narrow')}</option>
							<option value="moderate">{t('wordsToPages.ui.margins.moderate')}</option>
							<option value="wide">{t('wordsToPages.ui.margins.wide')}</option>
						</select>
					</div>

					<!-- 5. Orientation (Span 2 cols on sm) -->
					<div class="space-y-1 sm:col-span-2">
						<label for="wtp-select-orientation" class="block text-[11px] font-medium text-body">
							{t('wordsToPages.ui.orientationLabel')}
						</label>
						<select
							id="wtp-select-orientation"
							class="w-full rounded-sm border border-hairline bg-canvas px-2.5 py-1.5 text-xs text-ink focus:border-ink focus:outline-none"
						>
							<option value="portrait" selected>{t('wordsToPages.ui.orientations.portrait')}</option>
							<option value="landscape">{t('wordsToPages.ui.orientations.landscape')}</option>
						</select>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Bottom Full-Width Horizontal Output Row (4 Deep Forest Emerald KPI Output Cards) -->
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mt-4">
		<!-- Stat 1: Estimated pages -->
		<article class="kpi-card whisper-shadow flex flex-col justify-between rounded-md border border-[#1d463b] bg-[#0f2e26] p-3 sm:p-3.5 dark:border-hairline dark:bg-canvas-elevated">
