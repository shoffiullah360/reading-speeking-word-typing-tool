---
import { getToolById } from '../config/site';

const readingTool = getToolById('reading-time-calculator');
const speedTestTool = getToolById('reading-speed-test');
const wordsToPagesTool = getToolById('words-to-pages');
---

<section
	id="speech-calculator"
	aria-label="Speech Time Calculator and Rehearsal Workspace"
	class="mx-auto max-w-[1200px] px-4 pt-4 pb-12 sm:px-6"
>
	<!-- Live Summary Bar -->
	<div class="kpi-summary-bar whisper-shadow mb-6 grid grid-cols-1 divide-y divide-[#7ED4B6] rounded-md border border-[#7ED4B6] bg-[#AFE3D0] sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x dark:divide-hairline dark:border-hairline dark:bg-canvas-elevated">
		<!-- Stat 1: Speaking time -->
		<article class="kpi-card flex flex-col justify-between p-5">
			<div class="flex items-center justify-between gap-2">
				<span class="text-[13px] font-medium text-[#1F2937] dark:text-body">
					Speaking time
				</span>
				<span
					id="badge-speaking-wpm"
					class="text-[12px] text-[#1F2937] tabular-nums dark:text-mute"
				>
					130 WPM
				</span>
			</div>
			<div class="my-2.5">
				<output
					id="metric-speech-time"
					aria-live="polite"
					class="block font-sans text-[30px] leading-[36px] font-semibold tracking-[-1px] text-[#111827] tabular-nums dark:text-ink"
				>
					0 min 0 sec
				</output>
			</div>
			<p id="metric-speech-sub" class="text-[12px] text-[#1F2937] dark:text-mute">
				Conversational / keynote pace
			</p>
		</article>

		<!-- Stat 2: Word & sentence count -->
		<article class="kpi-card flex flex-col justify-between p-5 sm:border-l sm:border-[#7ED4B6] lg:border-l-0 dark:sm:border-hairline">
			<div class="flex items-center justify-between gap-2">
				<span
					id="label-word-metric"
					class="text-[13px] font-medium text-[#1F2937] dark:text-body"
				>
					Word count
				</span>
				<span
					id="badge-active-mode"
					class="text-[12px] text-[#1F2937] dark:text-mute"
				>
					Script to time
				</span>
			</div>
			<div class="my-2.5 flex items-baseline gap-2">
				<output
					id="metric-word-count"
					aria-live="polite"
					class="font-sans text-[30px] leading-[36px] font-semibold tracking-[-1px] text-[#111827] tabular-nums dark:text-ink"
				>
					0
				</output>
				<span class="text-[14px] text-[#1F2937] dark:text-body">words</span>
			</div>
			<div class="flex items-center gap-4 text-[12px] text-[#1F2937] dark:text-mute">
				<span><strong id="metric-sentence-count" class="font-medium text-[#111827] tabular-nums dark:text-ink">0</strong> sentences</span>
				<span><strong id="metric-char-count" class="font-medium text-[#111827] tabular-nums dark:text-ink">0</strong> characters</span>
			</div>
		</article>

		<!-- Stat 3: Estimated slides -->
		<article class="kpi-card flex flex-col justify-between p-5 sm:border-t sm:border-[#7ED4B6] lg:border-t-0 dark:sm:border-hairline">
			<div class="flex items-center justify-between gap-2">
				<span class="text-[13px] font-medium text-[#1F2937] dark:text-body">
					Estimated slides
				</span>
				<span
					id="badge-slide-rate"
					class="text-[12px] text-[#1F2937] dark:text-mute"
				>
					1 slide / min
				</span>
			</div>
			<div class="my-2.5 flex items-baseline gap-2">
				<output
					id="metric-slide-count"
					aria-live="polite"
					class="font-sans text-[30px] leading-[36px] font-semibold tracking-[-1px] text-[#111827] tabular-nums dark:text-ink"
				>
					0
				</output>
				<span class="text-[14px] text-[#1F2937] dark:text-body">slides</span>
			</div>
			<p id="metric-slide-sub" class="text-[12px] text-[#1F2937] tabular-nums dark:text-mute">
				Typical range: 0–0 slides
			</p>
		</article>

		<!-- Stat 4: Speaking pace -->
		<article class="kpi-card flex flex-col justify-between p-5 sm:border-t sm:border-l sm:border-[#7ED4B6] lg:border-t-0 lg:border-l-0 dark:sm:border-hairline">
			<div class="flex items-center justify-between gap-2">
				<span class="text-[13px] font-medium text-[#1F2937] dark:text-body">
					Speaking pace
				</span>
				<span
					id="cadence-dot"
					class="inline-block h-2 w-2 rounded-full bg-[#0D9488] dark:bg-vercel-blue"
					aria-hidden="true"
				></span>
			</div>
			<div class="my-2.5 flex items-center">
				<output
					id="metric-cadence-badge"
					aria-live="polite"
					class="text-[24px] leading-[32px] font-semibold tracking-[-0.5px] text-[#111827] dark:text-ink"
				>
					Keynote
				</output>
			</div>
			<p id="metric-cadence-detail" class="text-[12px] text-[#1F2937] tabular-nums dark:text-mute">
				130 WPM · 2.2 words/sec
			</p>
		</article>
	</div>

	<!-- Main Dual-Column Workspace -->
	<div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
		<!-- Left Column: 3 Interactive Speaking Modes -->
		<div class="whisper-shadow flex flex-col rounded-md border border-hairline bg-canvas-elevated lg:col-span-7">
			<!-- Tab Bar Header -->
			<div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline px-5 py-3">
				<div
					role="tablist"
					aria-label="Speech calculation mode"
					class="inline-flex flex-wrap items-center gap-1"
				>
					<button
						type="button"
						role="tab"
						id="tab-btn-script"
						aria-selected="true"
						aria-controls="tab-panel-script"
						data-tab="script"
						class="speech-tab-btn cursor-pointer rounded-pill-category bg-primary px-3.5 py-1.5 text-[13px] font-medium text-on-primary transition-all"
					>
						Script to time
					</button>
					<button
						type="button"
						role="tab"
						id="tab-btn-target"
						aria-selected="false"
						aria-controls="tab-panel-target"
						data-tab="target"
						class="speech-tab-btn cursor-pointer rounded-pill-category bg-transparent px-3.5 py-1.5 text-[13px] font-medium text-body transition-all hover:bg-hairline-soft hover:text-ink"
					>
						Time to words
					</button>
					<button
						type="button"
						role="tab"
						id="tab-btn-rehearsal"
						aria-selected="false"
						aria-controls="tab-panel-rehearsal"
						data-tab="rehearsal"
						class="speech-tab-btn cursor-pointer rounded-pill-category bg-transparent px-3.5 py-1.5 text-[13px] font-medium text-body transition-all hover:bg-hairline-soft hover:text-ink"
					>
						Rehearsal timer
					</button>
				</div>

				<!-- Action Controls for Tab 1 (Script Mode) -->
				<div id="script-toolbar-actions" class="flex items-center gap-2">
					<button
						type="button"
						id="btn-load-sample"
						class="cursor-pointer rounded-sm px-2.5 py-1 text-[13px] font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink"
					>
						Sample speech
					</button>
					<label
						for="speech-file-upload"
						class="inline-flex cursor-pointer items-center gap-1.5 rounded-sm border border-hairline bg-canvas px-2.5 py-1 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
					>
						<svg class="h-3.5 w-3.5 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
							<polyline points="17 8 12 3 7 8" />
							<line x1="12" y1="3" x2="12" y2="15" />
						</svg>
						Upload .txt
						<input id="speech-file-upload" type="file" accept=".txt,text/plain,.md,text/markdown" class="sr-only" />
					</label>
					<button
						type="button"
						id="btn-clear-script"
						class="cursor-pointer rounded-sm px-2.5 py-1 text-[13px] font-medium text-mute transition-colors hover:bg-hairline-soft hover:text-vercel-error"
					>
						Clear
					</button>
				</div>
			</div>

			<!-- Tab 1 Panel: Script to Speech Time -->
			<div
				id="tab-panel-script"
				role="tabpanel"
				aria-labelledby="tab-btn-script"
				class="relative flex flex-1 flex-col p-5"
			>
				<!-- Drag and drop overlay -->
				<div
					id="speech-dropzone-overlay"
					class="pointer-events-none absolute inset-3 z-20 hidden flex-col items-center justify-center rounded-md border-2 border-dashed border-vercel-blue bg-canvas-elevated/95 backdrop-blur-xs transition-opacity"
				>
					<svg class="mb-2 h-8 w-8 text-vercel-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
						<polyline points="14 2 14 8 20 8" />
						<line x1="12" y1="18" x2="12" y2="12" />
						<line x1="9" y1="15" x2="15" y2="15" />
					</svg>
					<p class="text-[14px] font-medium text-ink">Drop your .txt or .md script here</p>
					<p class="text-[12px] text-mute">Runs privately in your browser</p>
				</div>

				<label for="speech-textarea" class="sr-only">Paste or type your speech script to calculate speaking duration</label>
				<textarea
					id="speech-textarea"
					rows="12"
					placeholder="Paste or type your speech script, talk notes, or podcast outline here..."
					class="w-full flex-1 resize-y bg-transparent font-sans text-[15px] leading-[25px] text-ink placeholder:text-faint focus:outline-none"
				></textarea>

				<!-- Bottom Status Bar inside Script Panel -->
				<div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-hairline pt-3 text-[13px] text-mute">
					<div class="flex flex-wrap items-center gap-4 tabular-nums">
						<span>Words: <strong id="inline-word-counter" class="font-medium text-ink">0</strong></span>
						<span>Sentences: <strong id="inline-sentence-counter" class="font-medium text-ink">0</strong></span>
						<span>Paragraphs: <strong id="inline-para-counter" class="font-medium text-ink">0</strong></span>
						<span>Slides: <strong id="inline-slide-counter" class="font-medium text-ink">0</strong></span>
					</div>
					<div class="flex items-center gap-3">
						<span id="speech-file-status" class="text-[12px] text-mute">
							Runs privately in your browser
						</span>
						<button
							type="button"
							id="btn-jump-rehearsal"
							class="cursor-pointer text-[13px] font-medium text-ink underline decoration-hairline underline-offset-4 transition-colors hover:text-vercel-blue"
						>
							Practice with timer →
						</button>
					</div>
				</div>
			</div>

			<!-- Tab 2 Panel: Target Time to Words -->
			<div
				id="tab-panel-target"
				role="tabpanel"
				aria-labelledby="tab-btn-target"
				class="hidden flex-1 flex-col justify-between p-6"
			>
				<div>
					<span class="block text-[15px] font-medium text-ink">
						Target speaking time
					</span>
					<p class="mt-1 mb-4 text-[14px] text-body">
						Enter your speaking time slot to see how many words you should write for your pace.
					</p>

					<!-- Minutes & Seconds Inputs -->
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<div>
							<label for="target-minutes-input" class="mb-1.5 block text-[13px] font-medium text-mute">
								Minutes
							</label>
							<div class="relative flex items-center">
								<input
									id="target-minutes-input"
									type="number"
									min="0"
									max="600"
									step="1"
									value="5"
									class="w-full rounded-sm border border-hairline bg-canvas px-4 py-3 text-[22px] font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
								/>
								<span class="pointer-events-none absolute right-3.5 text-[13px] text-mute">
									min
								</span>
							</div>
						</div>

						<div>
							<label for="target-seconds-input" class="mb-1.5 block text-[13px] font-medium text-mute">
								Seconds
							</label>
							<div class="relative flex items-center">
								<input
									id="target-seconds-input"
									type="number"
									min="0"
									max="59"
									step="5"
									value="0"
									class="w-full rounded-sm border border-hairline bg-canvas px-4 py-3 text-[22px] font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
								/>
								<span class="pointer-events-none absolute right-3.5 text-[13px] text-mute">
									sec
								</span>
							</div>
						</div>
					</div>

					<!-- Quick Speech Duration Presets -->
					<div class="mt-5">
						<span class="mb-2.5 block text-[13px] font-medium text-mute">
							Common speech lengths
						</span>
						<div class="flex flex-wrap gap-2">
							<button
								type="button"
								data-min-preset="1"
								data-sec-preset="0"
								class="duration-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body transition-colors hover:border-ink hover:text-ink"
							>
								Elevator pitch (1 min)
							</button>
							<button
								type="button"
								data-min-preset="3"
								data-sec-preset="0"
								class="duration-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body transition-colors hover:border-ink hover:text-ink"
							>
								Lightning talk (3 min)
							</button>
							<button
								type="button"
								data-min-preset="5"
								data-sec-preset="0"
								class="duration-preset-btn cursor-pointer rounded-sm border border-primary bg-primary px-3 py-1.5 text-[13px] font-medium text-on-primary transition-colors"
							>
								Standard speech (5 min)
							</button>
							<button
								type="button"
								data-min-preset="10"
								data-sec-preset="0"
								class="duration-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body transition-colors hover:border-ink hover:text-ink"
							>
								Conference talk (10 min)
							</button>
							<button
								type="button"
								data-min-preset="18"
								data-sec-preset="0"
								class="duration-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body transition-colors hover:border-ink hover:text-ink"
							>
								TED talk (18 min)
							</button>
							<button
								type="button"
								data-min-preset="30"
								data-sec-preset="0"
								class="duration-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body transition-colors hover:border-ink hover:text-ink"
							>
								Keynote (30 min)
							</button>
							<button
								type="button"
								data-min-preset="45"
								data-sec-preset="0"
								class="duration-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body transition-colors hover:border-ink hover:text-ink"
							>
								Lecture (45 min)
							</button>
						</div>
					</div>
				</div>

				<!-- Target Word Output Summary -->
				<div class="mt-6 border-t border-hairline pt-4">
					<div class="flex flex-wrap items-baseline justify-between gap-2 pb-3">
						<span class="text-[14px] text-body">
							Target word count at <strong id="target-wpm-inline" class="font-medium text-ink tabular-nums">130 WPM</strong>
						</span>
						<strong id="target-derived-words" class="text-[20px] font-semibold text-ink tabular-nums">
							650 words
						</strong>
					</div>
					<div class="space-y-1.5 text-[13px]">
						<div class="flex items-center justify-between">
							<span class="text-mute">Word range (100–180 WPM)</span>
							<strong id="target-word-range" class="font-medium text-ink tabular-nums">500 – 900 words</strong>
						</div>
						<div class="flex items-center justify-between">
							<span class="text-mute">Double-spaced pages (250 words/page)</span>
							<strong id="target-double-pages" class="font-medium text-ink tabular-nums">2.6 pages</strong>
						</div>
						<div class="flex items-center justify-between">
							<span class="text-mute">Suggested slides (1 slide/min)</span>
							<strong id="target-slide-count" class="font-medium text-ink tabular-nums">5 slides</strong>
						</div>
					</div>
				</div>
			</div>

			<!-- Tab 3 Panel: Live Rehearsal Countdown Timer -->
			<div
				id="tab-panel-rehearsal"
				role="tabpanel"
				aria-labelledby="tab-btn-rehearsal"
				class="hidden flex-1 flex-col justify-between p-6"
			>
				<div>
					<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
						<div class="flex items-center gap-2">
							<span
								id="timer-status-dot"
								class="inline-block h-2 w-2 rounded-full bg-mute"
								aria-hidden="true"
							></span>
							<span id="timer-sync-label" class="text-[13px] text-mute">
								Synced to speech time
							</span>
						</div>

						<label class="inline-flex cursor-pointer items-center gap-2 text-[13px] text-body select-none hover:text-ink">
							<input
								id="timer-audio-toggle"
								type="checkbox"
								checked
								class="h-3.5 w-3.5 accent-primary"
							/>
							<span>Chime when timer ends</span>
						</label>
					</div>

					<!-- Countdown Display Surface -->
					<div
						id="timer-display-box"
						class="relative flex flex-col items-center justify-center rounded-md border border-hairline bg-canvas px-6 py-7 text-center transition-colors"
					>
						<span
							id="timer-state-eyebrow"
							class="mb-1 text-[13px] font-medium text-mute"
						>
							Ready to rehearse
						</span>

						<output
							id="rehearsal-timer-display"
							aria-live="off"
							class="font-sans text-[48px] leading-[56px] font-semibold tracking-[-2px] text-ink tabular-nums sm:text-[64px] sm:leading-[68px]"
						>
							00:00
						</output>

						<p id="timer-target-sub" class="mt-2 text-[13px] text-mute tabular-nums">
							Total time: 0 min 0 sec (130 WPM)
						</p>

						<!-- Subtle Progress Bar -->
						<div class="mt-5 h-1.5 w-full max-w-md overflow-hidden rounded-full bg-hairline">
							<div
								id="rehearsal-progress-bar"
								class="h-full w-full bg-primary transition-all duration-300"
							></div>
						</div>

						<!-- Subtle Visual Alert Banner when 00:00 Reached -->
						<div
							id="rehearsal-complete-alert"
							role="status"
							aria-live="assertive"
							class="mt-4 hidden items-center gap-2 rounded-pill border border-vercel-blue bg-canvas-elevated px-4 py-1.5 text-[13px] font-medium text-ink"
						>
							<span class="inline-block h-2 w-2 rounded-full bg-vercel-blue"></span>
							<span>Time is up — rehearsal complete</span>
						</div>
					</div>

					<!-- Primary Timer Controls: Start, Pause, Reset + Quick Adjustments -->
					<div class="mt-4 flex flex-wrap items-center justify-between gap-3">
						<div class="flex items-center gap-2">
							<button
								type="button"
								id="btn-timer-start"
								class="inline-flex h-9 cursor-pointer items-center gap-2 rounded-pill bg-primary px-5 text-[14px] font-medium text-on-primary transition-opacity hover:opacity-90"
							>
								<svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
									<polygon points="5 3 19 12 5 21 5 3" />
								</svg>
								<span id="btn-timer-start-label">Start</span>
							</button>

							<button
								type="button"
								id="btn-timer-pause"
								disabled
								class="inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-sm border border-hairline bg-canvas-elevated px-3.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft disabled:cursor-not-allowed disabled:opacity-40"
							>
								Pause
							</button>

							<button
								type="button"
								id="btn-timer-reset"
								class="inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-sm border border-hairline bg-canvas-elevated px-3.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
							>
								Reset
							</button>
						</div>

						<div class="flex items-center gap-1.5">
							<button
								type="button"
								data-timer-adjust="-30"
								class="timer-adjust-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-2.5 py-1.5 text-[12px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
								title="Subtract 30 seconds"
							>
								-30s
							</button>
							<button
								type="button"
								data-timer-adjust="30"
								class="timer-adjust-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-2.5 py-1.5 text-[12px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
								title="Add 30 seconds"
							>
								+30s
							</button>
							<button
								type="button"
								data-timer-adjust="60"
								class="timer-adjust-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-2.5 py-1.5 text-[12px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
								title="Add 1 minute"
							>
								+1m
							</button>
						</div>
					</div>
				</div>

				<!-- Rehearsal Script Reader Preview -->
				<div class="mt-6 border-t border-hairline pt-4">
					<div class="mb-2 flex items-center justify-between">
