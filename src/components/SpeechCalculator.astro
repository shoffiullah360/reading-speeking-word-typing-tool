---
import { getLocaleFromUrl, useTranslations, type Locale } from '../i18n/ui';

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const clientI18n = {
	locale,
	zeroDuration: t('speechCalculator.client.zeroDuration'),
	unitMin: t('speechCalculator.client.unitMin'),
	unitSec: t('speechCalculator.client.unitSec'),
	durationFormat: t('speechCalculator.client.durationFormat'),
	wordSingular: t('speechCalculator.client.wordSingular'),
	wordPlural: t('speechCalculator.client.wordPlural'),
	charSingular: t('speechCalculator.client.charSingular'),
	charPlural: t('speechCalculator.client.charPlural'),
	atWpm: t('speechCalculator.client.atWpm'),
	atCpm: t('speechCalculator.client.atCpm'),
	mixedAtWpm: t('speechCalculator.client.mixedAtWpm'),
	mixedCopyAtWpm: t('speechCalculator.client.mixedCopyAtWpm'),
	onTarget: t('speechCalculator.client.onTarget'),
	overBySec: t('speechCalculator.client.overBySec'),
	copySummary: t('speechCalculator.client.copySummary'),
	copyResult: t('speechCalculator.client.copyResult'),
	copied: t('speechCalculator.client.copied'),
};

const wordChips = [250, 500, 1000, 1500].map((value) => ({
	label: value.toLocaleString(locale),
	value,
}));
---

<section
	id="speech-calculator"
	aria-label={t('speechCalculator.ui.workspaceAria')}
	class="mx-auto max-w-[1140px] px-4 pt-4 pb-14 sm:px-6"
>
	<!-- Unified Split-Studio Card -->
	<div class="whisper-shadow overflow-hidden rounded-3xl border border-hairline bg-canvas-elevated lg:grid lg:grid-cols-12">
		<!-- Left Input Surface (~60% width / 7 cols) -->
		<div class="flex flex-col justify-between p-6 sm:p-8 lg:col-span-7 lg:p-10">
			<div>
				<!-- Top Mode Switch: Segmented Pill Toggle -->
				<div class="mb-6 flex items-center justify-between gap-4">
					<div
						role="tablist"
						aria-label={t('speechCalculator.ui.inputModeAria')}
						class="inline-flex rounded-full border border-hairline bg-canvas p-1"
					>
						<button
							type="button"
							role="tab"
							id="mode-btn-script"
							aria-selected="true"
							aria-controls="mode-panel-script"
							data-mode="script"
							class="speech-mode-btn cursor-pointer rounded-full bg-[#afe3d0] px-4 py-1.5 text-[13px] font-semibold text-[#0f2e26] transition-all"
						>
							{t('speechCalculator.ui.tabScript')}
						</button>
						<button
							type="button"
							role="tab"
							id="mode-btn-words"
							aria-selected="false"
							aria-controls="mode-panel-words"
							data-mode="words"
							class="speech-mode-btn cursor-pointer rounded-full bg-transparent px-4 py-1.5 text-[13px] font-medium text-body transition-all hover:text-ink"
						>
							{t('speechCalculator.ui.tabWords')}
						</button>
					</div>
				</div>

				<!-- Mode 1: Paste script -->
				<div
					id="mode-panel-script"
					role="tabpanel"
					aria-labelledby="mode-btn-script"
					class="flex flex-col"
				>
					<label for="speech-script-input" class="sr-only">
						{t('speechCalculator.ui.scriptLabel')}
					</label>
					<textarea
						id="speech-script-input"
						rows="9"
						placeholder={t('speechCalculator.ui.scriptPlaceholder')}
						class="min-h-[220px] w-full resize-y border-0 bg-transparent font-sans text-[16px] leading-[27px] text-ink placeholder:text-faint focus:outline-none"
					></textarea>
				</div>

				<!-- Mode 2: Enter word count -->
				<div
					id="mode-panel-words"
					role="tabpanel"
					aria-labelledby="mode-btn-words"
					class="hidden min-h-[220px] flex-col justify-center py-6"
				>
					<label
						for="speech-wordcount-input"
						class="mb-2 block text-[13px] font-medium text-mute"
					>
						{t('speechCalculator.ui.wordCountLabel')}
					</label>
					<input
						id="speech-wordcount-input"
						type="number"
						min="0"
						max="100000"
						step="1"
						placeholder={t('speechCalculator.ui.wordCountPlaceholder')}
						class="w-full border-b border-hairline bg-transparent pb-3 font-sans text-[40px] leading-[48px] font-semibold tracking-[-1px] text-ink tabular-nums placeholder:text-faint focus:border-[#0f2e26] focus:outline-none dark:focus:border-[#afe3d0]"
					/>

					<!-- 4 Subtle Quick-Fill Chips -->
					<div class="mt-5 flex flex-wrap items-center gap-2">
						<span class="mr-1 text-[12px] text-mute">{t('speechCalculator.ui.quickFill')}</span>
						{
							wordChips.map((chip) => (
								<button
									type="button"
									data-word-chip={chip.value}
									class="word-chip-btn cursor-pointer rounded-full border border-hairline bg-canvas px-3.5 py-1 text-[13px] font-medium text-body tabular-nums transition-colors hover:border-[#0f2e26] hover:text-ink dark:hover:border-[#afe3d0]"
								>
									{chip.label}
								</button>
							))
						}
					</div>
				</div>
			</div>

			<!-- Bottom Section: Minimal Footer Bar + Speaking Pace Selector -->
			<div class="mt-6">
				<!-- Minimal Footer Bar -->
				<div class="flex items-center justify-between border-t border-hairline py-3.5 text-[13px]">
					<span id="live-word-counter" class="font-medium text-mute tabular-nums">
						{t('speechCalculator.ui.initialWordCount')}
					</span>
					<button
						type="button"
						id="btn-clear-input"
						class="cursor-pointer font-medium text-mute transition-colors hover:text-ink"
					>
						{t('speechCalculator.ui.btnClear')}
					</button>
				</div>

				<!-- Speaking Pace Selector -->
				<div class="border-t border-hairline pt-5">
					<div class="mb-3 flex items-center justify-between gap-2">
						<span class="text-[13px] font-medium text-ink">{t('speechCalculator.ui.speakingPaceLabel')}</span>
						<div id="custom-wpm-wrapper" class="hidden items-center gap-1.5">
							<label for="custom-wpm-input" class="text-[12px] text-mute">{t('speechCalculator.ui.customWpmLabel')}</label>
							<input
								id="custom-wpm-input"
								type="number"
								min="40"
								max="400"
								step="1"
								value="130"
								class="w-20 rounded-lg border border-hairline bg-canvas px-2.5 py-1 text-right text-[13px] font-semibold text-ink tabular-nums focus:border-[#0f2e26] focus:outline-none dark:focus:border-[#afe3d0]"
							/>
						</div>
					</div>

					<div
						role="radiogroup"
						aria-label={t('speechCalculator.ui.speakingPaceAria')}
						class="grid grid-cols-2 gap-2 sm:grid-cols-4"
					>
						<button
							type="button"
							data-pace-mode="preset"
							data-wpm="110"
							class="pace-pill-btn cursor-pointer rounded-xl border border-hairline bg-canvas px-3 py-2.5 text-center text-[13px] font-medium text-body tabular-nums transition-all hover:border-ink hover:text-ink"
						>
							{t('speechCalculator.ui.paceSlow')}
						</button>
						<button
							type="button"
							data-pace-mode="preset"
							data-wpm="130"
							class="pace-pill-btn cursor-pointer rounded-xl border border-[#0f2e26] bg-[#0f2e26] px-3 py-2.5 text-center text-[13px] font-medium text-[#afe3d0] tabular-nums transition-all dark:border-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]"
						>
							{t('speechCalculator.ui.paceAverage')}
						</button>
						<button
							type="button"
							data-pace-mode="preset"
							data-wpm="160"
							class="pace-pill-btn cursor-pointer rounded-xl border border-hairline bg-canvas px-3 py-2.5 text-center text-[13px] font-medium text-body tabular-nums transition-all hover:border-ink hover:text-ink"
						>
							{t('speechCalculator.ui.paceFast')}
						</button>
						<button
							type="button"
							data-pace-mode="custom"
							class="pace-pill-btn cursor-pointer rounded-xl border border-hairline bg-canvas px-3 py-2.5 text-center text-[13px] font-medium text-body transition-all hover:border-ink hover:text-ink"
						>
							{t('speechCalculator.ui.paceCustom')}
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Right Dark-Emerald Stage Result Panel (~40% width / 5 cols) -->
		<div class="emerald-result-panel flex flex-col justify-between bg-[#0f2e26] p-6 text-[#f0fdf7] sm:p-8 lg:col-span-5 lg:p-10">
			<div class="space-y-7">
				<!-- Primary Readout -->
				<div>
					<span class="block text-[11px] font-semibold tracking-[0.12em] text-[#afe3d0]/75 uppercase">
						{t('speechCalculator.ui.speakingTimeHeading')}
					</span>
					<output
						id="result-speaking-time"
						aria-live="polite"
						class="mt-2 block font-sans text-[44px] leading-[50px] font-semibold tracking-[-1.5px] text-[#afe3d0] tabular-nums sm:text-[50px] sm:leading-[56px]"
					>
						{t('speechCalculator.client.zeroDuration')}
					</output>
					<p id="result-subline" class="mt-2 text-[14px] text-[#d1fae5]/80 tabular-nums">
						{t('speechCalculator.ui.initialSubline')}
					</p>
				</div>

				<!-- Optional Time Limit Check -->
				<div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-[#afe3d0]/15 bg-[#153d33]/70 px-4 py-3">
					<div class="flex items-center gap-2.5">
						<label for="target-limit-input" class="text-[13px] font-medium text-[#d1fae5]/90">
							{t('speechCalculator.ui.targetLimitLabel')}
						</label>
						<div class="inline-flex items-center rounded-lg border border-[#afe3d0]/25 bg-[#0f2e26] px-2.5 py-1">
							<input
								id="target-limit-input"
								type="number"
								min="0"
								max="600"
								step="0.5"
								placeholder="—"
								class="w-12 bg-transparent text-right text-[13px] font-semibold text-white tabular-nums placeholder:text-[#afe3d0]/40 focus:outline-none"
							/>
							<span class="ml-1 text-[12px] text-[#afe3d0]/70">{t('speechCalculator.client.unitMin')}</span>
						</div>
					</div>

					<span
						id="target-status-pill"
						class="hidden rounded-full px-3 py-1 text-[12px] font-semibold tabular-nums"
					>
						{t('speechCalculator.client.onTarget')}
					</span>
				</div>

				<!-- Words That Fit at Current Pace (2x2 Mini-Grid) -->
				<div>
					<div class="mb-3 flex items-center justify-between">
						<span class="text-[12px] font-medium text-[#afe3d0]/80">
							{t('speechCalculator.ui.wordsThatFitHeading')}
						</span>
						<span id="fit-pace-label" class="text-[12px] text-[#afe3d0]/65 tabular-nums">
							130 WPM
						</span>
					</div>

					<div class="grid grid-cols-2 gap-2.5">
						<div class="rounded-2xl border border-[#afe3d0]/15 bg-[#153d33]/55 px-4 py-3">
							<span class="block text-[12px] text-[#afe3d0]/70">{t('speechCalculator.ui.fitMinLabel', { minutes: 1 })}</span>
							<strong id="fit-1m" class="mt-0.5 block text-[18px] font-semibold text-white tabular-nums">
								{t('speechCalculator.ui.fitWordsInitial', { count: (130).toLocaleString(locale) })}
							</strong>
						</div>
						<div class="rounded-2xl border border-[#afe3d0]/15 bg-[#153d33]/55 px-4 py-3">
							<span class="block text-[12px] text-[#afe3d0]/70">{t('speechCalculator.ui.fitMinLabel', { minutes: 3 })}</span>
							<strong id="fit-3m" class="mt-0.5 block text-[18px] font-semibold text-white tabular-nums">
								{t('speechCalculator.ui.fitWordsInitial', { count: (390).toLocaleString(locale) })}
							</strong>
						</div>
						<div class="rounded-2xl border border-[#afe3d0]/15 bg-[#153d33]/55 px-4 py-3">
							<span class="block text-[12px] text-[#afe3d0]/70">{t('speechCalculator.ui.fitMinLabel', { minutes: 5 })}</span>
							<strong id="fit-5m" class="mt-0.5 block text-[18px] font-semibold text-white tabular-nums">
								{t('speechCalculator.ui.fitWordsInitial', { count: (650).toLocaleString(locale) })}
							</strong>
						</div>
						<div class="rounded-2xl border border-[#afe3d0]/15 bg-[#153d33]/55 px-4 py-3">
							<span class="block text-[12px] text-[#afe3d0]/70">{t('speechCalculator.ui.fitMinLabel', { minutes: 10 })}</span>
							<strong id="fit-10m" class="mt-0.5 block text-[18px] font-semibold text-white tabular-nums">
								{t('speechCalculator.ui.fitWordsInitial', { count: (1300).toLocaleString(locale) })}
							</strong>
						</div>
					</div>
				</div>
			</div>

			<!-- Single Action Button -->
			<div class="mt-8 pt-2">
				<button
					type="button"
					id="btn-copy-result"
					class="w-full cursor-pointer rounded-2xl border border-[#afe3d0]/40 bg-[#afe3d0] px-5 py-3.5 text-center text-[14px] font-semibold text-[#0f2e26] transition-all hover:bg-[#c5eedf] active:scale-[0.99]"
				>
					{t('speechCalculator.client.copyResult')}
				</button>
			</div>
		</div>
	</div>
</section>

<script
	type="application/json"
	id="sc-i18n"
	set:html={JSON.stringify(clientI18n).replace(/</g, '\\u003c')}
/>

<script>
	interface SpeechClientI18n {
		locale: string;
		zeroDuration: string;
		unitMin: string;
		unitSec: string;
		durationFormat: string;
		wordSingular: string;
		wordPlural: string;
		charSingular: string;
		charPlural: string;
		atWpm: string;
		atCpm: string;
		mixedAtWpm: string;
		mixedCopyAtWpm: string;
		onTarget: string;
		overBySec: string;
		copySummary: string;
		copyResult: string;
		copied: string;
	}

	function initSpeechCalculator() {
		const fallbackI18n: SpeechClientI18n = {
			locale: 'en',
			zeroDuration: '0 min 0 sec',
			unitMin: 'min',
			unitSec: 'sec',
			durationFormat: '{mins} min {secs} sec',
			wordSingular: 'word',
			wordPlural: 'words',
			charSingular: 'character',
			charPlural: 'characters',
			atWpm: '{desc} at {wpm} WPM',
			atCpm: '{desc} at {cpm} CPM',
			mixedAtWpm: '{words} & {chars} at {wpm} WPM',
			mixedCopyAtWpm: '{words}, {chars} at {wpm} WPM',
			onTarget: 'On target',
			overBySec: 'Over by {secs} sec',
			copySummary: 'Speaking Time: {time} ({detail})',
			copyResult: 'Copy result',
			copied: 'Copied!',
		};

		let i18n: SpeechClientI18n = fallbackI18n;
		const i18nEl = document.getElementById('sc-i18n');
		if (i18nEl?.textContent) {
			try {
				const parsed = JSON.parse(i18nEl.textContent) as Partial<SpeechClientI18n>;
				i18n = { ...fallbackI18n, ...parsed };
			} catch {
				// Use fallback English strings if JSON fails to parse
			}
		}

		function fmt(template: string, vars: Record<string, string | number>): string {
			return template.replace(/\{(\w+)\}/g, (_, key: string) => String(vars[key] ?? `{${key}}`));
		}

		function formatWordCount(count: number): string {
			return `${count.toLocaleString(i18n.locale)} ${count === 1 ? i18n.wordSingular : i18n.wordPlural}`;
		}

		function formatCharCount(count: number): string {
			return `${count.toLocaleString(i18n.locale)} ${count === 1 ? i18n.charSingular : i18n.charPlural}`;
		}

		let inputMode: 'script' | 'words' = 'script';
		let activeWpm = 130;
		let isCustomPace = false;

		// Mode Toggle Elements
		const modeBtns = document.querySelectorAll<HTMLButtonElement>('.speech-mode-btn');
		const panelScript = document.getElementById('mode-panel-script');
		const panelWords = document.getElementById('mode-panel-words');

		// Input Elements
		const scriptInput = document.getElementById('speech-script-input') as HTMLTextAreaElement | null;
		const wordCountInput = document.getElementById('speech-wordcount-input') as HTMLInputElement | null;
		const wordChipBtns = document.querySelectorAll<HTMLButtonElement>('.word-chip-btn');
		const liveWordCounter = document.getElementById('live-word-counter');
		const btnClearInput = document.getElementById('btn-clear-input');

		// Pace Elements
		const pacePillBtns = document.querySelectorAll<HTMLButtonElement>('.pace-pill-btn');
		const customWpmWrapper = document.getElementById('custom-wpm-wrapper');
		const customWpmInput = document.getElementById('custom-wpm-input') as HTMLInputElement | null;

		// Right Panel Result Elements
		const resultSpeakingTime = document.getElementById('result-speaking-time');
		const resultSubline = document.getElementById('result-subline');
		const targetLimitInput = document.getElementById('target-limit-input') as HTMLInputElement | null;
		const targetStatusPill = document.getElementById('target-status-pill');
		const fitPaceLabel = document.getElementById('fit-pace-label');
		const fit1m = document.getElementById('fit-1m');
		const fit3m = document.getElementById('fit-3m');
		const fit5m = document.getElementById('fit-5m');
		const fit10m = document.getElementById('fit-10m');
		const btnCopyResult = document.getElementById('btn-copy-result');

		const CJK_REGEX = /[\u4e00-\u9fff\u3040-\u30ff]/;

		function countWords(text: string): number {
			const trimmed = text.trim();
			if (!trimmed) return 0;
			return trimmed.split(/\s+/).filter(Boolean).length;
		}

		interface ScriptAnalysis {
			totalSeconds: number;
			footerText: string;
			sublineText: string;
			copyText: string;
		}

		function analyzeScript(text: string, wpm: number): ScriptAnalysis {
			const trimmed = text.trim();
			if (!trimmed) {
				const zeroDesc = formatWordCount(0);
				const zeroAtWpm = fmt(i18n.atWpm, { desc: zeroDesc, wpm });
				return {
					totalSeconds: 0,
					footerText: zeroDesc,
					sublineText: zeroAtWpm,
					copyText: zeroAtWpm,
				};
			}

			// Standard space-separated word counting for non-CJK text (English, Spanish, French, etc.)
			if (!CJK_REGEX.test(trimmed)) {
				const words = countWords(trimmed);
				const totalSeconds = words > 0 ? Math.round((words / wpm) * 60) : 0;
				const wordDesc = formatWordCount(words);
				const atWpmText = fmt(i18n.atWpm, { desc: wordDesc, wpm });
				return {
					totalSeconds,
					footerText: wordDesc,
					sublineText: atWpmText,
					copyText: atWpmText,
				};
			}

			// Smart CJK character counting when Chinese/Japanese characters are present
			const cjkMatches = trimmed.match(/[\u4e00-\u9fff\u3040-\u30ff]/g);
			const cjkChars = cjkMatches ? cjkMatches.length : 0;

			// Count non-CJK space-separated words outside CJK segments
			const nonCjkText = trimmed.replace(/[\u4e00-\u9fff\u3040-\u30ff]/g, ' ').trim();
			const nonCjkWords = nonCjkText ? countWords(nonCjkText) : 0;

			// Realistic CJK speaking pace: ~200 CPM at 130 WPM (Average), scaled proportionally
			const cjkCpm = wpm * (200 / 130);
			const cjkSeconds = cjkCpm > 0 ? (cjkChars / cjkCpm) * 60 : 0;
			const nonCjkSeconds = (nonCjkWords / wpm) * 60;
			const totalSeconds = Math.round(cjkSeconds + nonCjkSeconds);

			const displayCpm = Math.round(cjkCpm);
			const charDesc = formatCharCount(cjkChars);

			if (nonCjkWords === 0) {
				const atCpmText = fmt(i18n.atCpm, { desc: charDesc, cpm: displayCpm });
				return {
					totalSeconds,
					footerText: charDesc,
					sublineText: atCpmText,
					copyText: atCpmText,
				};
			}

			const wordDesc = formatWordCount(nonCjkWords);
			return {
				totalSeconds,
				footerText: `${wordDesc}, ${charDesc}`,
				sublineText: fmt(i18n.mixedAtWpm, { words: wordDesc, chars: charDesc, wpm }),
				copyText: fmt(i18n.mixedCopyAtWpm, { words: wordDesc, chars: charDesc, wpm }),
			};
		}

		function formatMinSec(totalSeconds: number): { mins: number; secs: number; text: string } {
			const clean = Math.max(0, Math.round(totalSeconds));
			const mins = Math.floor(clean / 60);
			const secs = clean % 60;
			return {
				mins,
				secs,
				text: fmt(i18n.durationFormat, { mins: mins.toLocaleString(i18n.locale), secs }),
			};
		}

		function updateUI() {
			const wpm = Math.max(1, activeWpm);
			let totalSeconds = 0;
			const zeroDesc = formatWordCount(0);
			let footerText = zeroDesc;
			let sublineText = fmt(i18n.atWpm, { desc: zeroDesc, wpm });

			if (inputMode === 'script') {
				const analysis = analyzeScript(scriptInput?.value ?? '', wpm);
				totalSeconds = analysis.totalSeconds;
				footerText = analysis.footerText;
				sublineText = analysis.sublineText;
			} else {
				const raw = parseInt(wordCountInput?.value ?? '', 10);
				const words = Number.isNaN(raw) || raw < 0 ? 0 : raw;
				totalSeconds = words > 0 ? Math.round((words / wpm) * 60) : 0;
				const wordDesc = formatWordCount(words);
				footerText = wordDesc;
				sublineText = fmt(i18n.atWpm, { desc: wordDesc, wpm });
			}

			const formattedTime = formatMinSec(totalSeconds);

			// Footer word counter
			if (liveWordCounter) {
				liveWordCounter.textContent = footerText;
			}

			// Primary Readout
			if (resultSpeakingTime) {
				resultSpeakingTime.textContent = formattedTime.text;
			}
			if (resultSubline) {
				resultSubline.textContent = sublineText;
			}

			// Optional Target Limit Check
			const rawLimit = targetLimitInput?.value.trim() ?? '';
			const limitMinutes = parseFloat(rawLimit);
			if (targetStatusPill) {
				if (rawLimit !== '' && !Number.isNaN(limitMinutes) && limitMinutes > 0) {
					const limitSeconds = Math.round(limitMinutes * 60);
					const diffSeconds = totalSeconds - limitSeconds;
					targetStatusPill.classList.remove('hidden');

					if (diffSeconds <= 0) {
						targetStatusPill.textContent = i18n.onTarget;
						targetStatusPill.className =
							'rounded-full bg-[#afe3d0]/20 px-3 py-1 text-[12px] font-semibold text-[#afe3d0] tabular-nums';
					} else {
						targetStatusPill.textContent = fmt(i18n.overBySec, {
							secs: diffSeconds.toLocaleString(i18n.locale),
						});
						targetStatusPill.className =
							'rounded-full bg-amber-400/20 px-3 py-1 text-[12px] font-semibold text-amber-200 tabular-nums';
					}
				} else {
					targetStatusPill.classList.add('hidden');
				}
			}

			// 2x2 Words That Fit Grid
			if (fitPaceLabel) fitPaceLabel.textContent = `${wpm} WPM`;
			if (fit1m) fit1m.textContent = formatWordCount(Math.round(wpm * 1));
			if (fit3m) fit3m.textContent = formatWordCount(Math.round(wpm * 3));
			if (fit5m) fit5m.textContent = formatWordCount(Math.round(wpm * 5));
			if (fit10m) fit10m.textContent = formatWordCount(Math.round(wpm * 10));
		}

		function syncPacePills() {
			pacePillBtns.forEach((btn) => {
				const mode = btn.dataset.paceMode;
				const presetWpm = Number(btn.dataset.wpm);
				const isActive =
					(mode === 'custom' && isCustomPace) ||
					(mode === 'preset' && !isCustomPace && presetWpm === activeWpm);

				btn.className = isActive
					? 'pace-pill-btn cursor-pointer rounded-xl border border-[#0f2e26] bg-[#0f2e26] px-3 py-2.5 text-center text-[13px] font-medium text-[#afe3d0] tabular-nums transition-all dark:border-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]'
					: 'pace-pill-btn cursor-pointer rounded-xl border border-hairline bg-canvas px-3 py-2.5 text-center text-[13px] font-medium text-body tabular-nums transition-all hover:border-ink hover:text-ink';
			});

			if (customWpmWrapper) {
				customWpmWrapper.classList.toggle('hidden', !isCustomPace);
				customWpmWrapper.classList.toggle('inline-flex', isCustomPace);
			}
		}

		function switchMode(newMode: 'script' | 'words') {
			inputMode = newMode;
			modeBtns.forEach((btn) => {
				const isMatch = btn.dataset.mode === newMode;
				btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
				btn.className = isMatch
					? 'speech-mode-btn cursor-pointer rounded-full bg-[#afe3d0] px-4 py-1.5 text-[13px] font-semibold text-[#0f2e26] transition-all'
					: 'speech-mode-btn cursor-pointer rounded-full bg-transparent px-4 py-1.5 text-[13px] font-medium text-body transition-all hover:text-ink';
			});

			panelScript?.classList.toggle('hidden', newMode !== 'script');
			panelScript?.classList.toggle('flex', newMode === 'script');
			panelWords?.classList.toggle('hidden', newMode !== 'words');
			panelWords?.classList.toggle('flex', newMode === 'words');

			updateUI();
		}

		// Event Listeners: Mode Switch
		modeBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const targetMode = btn.dataset.mode as 'script' | 'words';
				if (targetMode) switchMode(targetMode);
			});
		});

		// Event Listeners: Inputs
		scriptInput?.addEventListener('input', updateUI);
		wordCountInput?.addEventListener('input', updateUI);

		wordChipBtns.forEach((chip) => {
			chip.addEventListener('click', () => {
				const val = chip.dataset.wordChip;
				if (val && wordCountInput) {
					wordCountInput.value = val;
					updateUI();
				}
			});
		});

		btnClearInput?.addEventListener('click', () => {
			if (inputMode === 'script' && scriptInput) {
				scriptInput.value = '';
				scriptInput.focus();
			} else if (inputMode === 'words' && wordCountInput) {
				wordCountInput.value = '';
				wordCountInput.focus();
			}
			updateUI();
		});

		// Event Listeners: Pace Pills
		pacePillBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const mode = btn.dataset.paceMode;
				if (mode === 'custom') {
					isCustomPace = true;
					if (customWpmInput) {
						customWpmInput.value = String(activeWpm);
						syncPacePills();
						customWpmInput.focus();
					}
				} else {
					isCustomPace = false;
					const wpmVal = Number(btn.dataset.wpm);
					if (wpmVal > 0) activeWpm = wpmVal;
					syncPacePills();
				}
				updateUI();
			});
		});

		customWpmInput?.addEventListener('input', () => {
			const parsed = parseInt(customWpmInput.value, 10);
			if (!Number.isNaN(parsed) && parsed > 0) {
				activeWpm = Math.min(400, Math.max(40, parsed));
				updateUI();
			}
		});

		targetLimitInput?.addEventListener('input', updateUI);

		// Copy Result Button
		let copyTimeout: number | null = null;
		btnCopyResult?.addEventListener('click', async () => {
			const wpm = Math.max(1, activeWpm);
			let totalSeconds = 0;
			let summaryDetail = '';

			if (inputMode === 'script') {
				const analysis = analyzeScript(scriptInput?.value ?? '', wpm);
				totalSeconds = analysis.totalSeconds;
				summaryDetail = analysis.copyText;
			} else {
				const raw = parseInt(wordCountInput?.value ?? '', 10);
				const words = Number.isNaN(raw) || raw < 0 ? 0 : raw;
				totalSeconds = words > 0 ? Math.round((words / wpm) * 60) : 0;
				const wordDesc = formatWordCount(words);
				summaryDetail = fmt(i18n.atWpm, { desc: wordDesc, wpm });
			}

			const formattedTime = formatMinSec(totalSeconds);
			const summaryText = fmt(i18n.copySummary, { time: formattedTime.text, detail: summaryDetail });

			try {
				await navigator.clipboard.writeText(summaryText);
				if (btnCopyResult) {
					btnCopyResult.textContent = i18n.copied;
					if (copyTimeout) window.clearTimeout(copyTimeout);
					copyTimeout = window.setTimeout(() => {
						if (btnCopyResult) btnCopyResult.textContent = i18n.copyResult;
					}, 1800);
				}
			} catch {
				// Clipboard fallback not required
			}
		});

		updateUI();
	}

	initSpeechCalculator();
</script>
