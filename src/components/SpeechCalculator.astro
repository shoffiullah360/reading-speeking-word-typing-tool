</section>

<script>
	function initSpeechCalculator() {
		// State
		let activeTab: 'script' | 'target' | 'rehearsal' = 'script';
		let speakingWpm = 130; // Default 130 WPM conversational/keynote pace
		let pauseBufferSec = 0;

		// Rehearsal Timer State
		let timerTotalSeconds = 300; // Synced with calculated duration
		let timerRemainingSeconds = 300;
		let timerIntervalId: number | null = null;
		let isTimerRunning = false;

		// DOM Elements — Tabs
		const tabBtns = document.querySelectorAll<HTMLButtonElement>('.speech-tab-btn');
		const panelScript = document.getElementById('tab-panel-script');
		const panelTarget = document.getElementById('tab-panel-target');
		const panelRehearsal = document.getElementById('tab-panel-rehearsal');
		const scriptToolbar = document.getElementById('script-toolbar-actions');
		const badgeActiveMode = document.getElementById('badge-active-mode');
		const labelWordMetric = document.getElementById('label-word-metric');

		// DOM Elements — Tab 1 (Script to Speech Time)
		const textarea = document.getElementById('speech-textarea') as HTMLTextAreaElement | null;
		const fileInput = document.getElementById('speech-file-upload') as HTMLInputElement | null;
		const dropzoneOverlay = document.getElementById('speech-dropzone-overlay');
		const fileStatusMsg = document.getElementById('speech-file-status');
		const btnClearScript = document.getElementById('btn-clear-script');
		const btnLoadSample = document.getElementById('btn-load-sample');
		const btnJumpRehearsal = document.getElementById('btn-jump-rehearsal');

		const inlineWordCounter = document.getElementById('inline-word-counter');
		const inlineSentenceCounter = document.getElementById('inline-sentence-counter');
		const inlineParaCounter = document.getElementById('inline-para-counter');
		const inlineSlideCounter = document.getElementById('inline-slide-counter');

		// DOM Elements — Tab 2 (Target Time to Words)
		const targetMinutesInput = document.getElementById('target-minutes-input') as HTMLInputElement | null;
		const targetSecondsInput = document.getElementById('target-seconds-input') as HTMLInputElement | null;
		const durationPresetBtns = document.querySelectorAll<HTMLButtonElement>('.duration-preset-btn');
		const targetWpmInline = document.getElementById('target-wpm-inline');
		const targetDerivedWords = document.getElementById('target-derived-words');
		const targetWordRange = document.getElementById('target-word-range');
		const targetDoublePages = document.getElementById('target-double-pages');
		const targetSlideCount = document.getElementById('target-slide-count');

		// DOM Elements — Tab 3 (Live Rehearsal Timer)
		const timerStatusDot = document.getElementById('timer-status-dot');
		const timerSyncLabel = document.getElementById('timer-sync-label');
		const timerAudioToggle = document.getElementById('timer-audio-toggle') as HTMLInputElement | null;
		const timerDisplayBox = document.getElementById('timer-display-box');
		const timerStateEyebrow = document.getElementById('timer-state-eyebrow');
		const rehearsalTimerDisplay = document.getElementById('rehearsal-timer-display');
		const timerTargetSub = document.getElementById('timer-target-sub');
		const rehearsalProgressBar = document.getElementById('rehearsal-progress-bar');
		const rehearsalCompleteAlert = document.getElementById('rehearsal-complete-alert');
		const btnTimerStart = document.getElementById('btn-timer-start') as HTMLButtonElement | null;
		const btnTimerStartLabel = document.getElementById('btn-timer-start-label');
		const btnTimerPause = document.getElementById('btn-timer-pause') as HTMLButtonElement | null;
		const btnTimerReset = document.getElementById('btn-timer-reset') as HTMLButtonElement | null;
		const timerAdjustBtns = document.querySelectorAll<HTMLButtonElement>('.timer-adjust-btn');
		const rehearsalWordBadge = document.getElementById('rehearsal-word-badge');
		const rehearsalScriptPreview = document.getElementById('rehearsal-script-preview');

		// DOM Elements — Right Column Controls
		const speakingSlider = document.getElementById('speaking-wpm-slider') as HTMLInputElement | null;
		const speakingWpmDisplay = document.getElementById('speaking-wpm-display');
		const badgeSpeakingWpm = document.getElementById('badge-speaking-wpm');
		const wpmPresetBtns = document.querySelectorAll<HTMLButtonElement>('.wpm-preset-btn');
		const pauseBufferBtns = document.querySelectorAll<HTMLButtonElement>('.pause-buffer-btn');
		const pauseBufferBadge = document.getElementById('pause-buffer-badge');

		const compare100 = document.getElementById('compare-100');
		const compare130 = document.getElementById('compare-130');
		const compare150 = document.getElementById('compare-150');
		const compare180 = document.getElementById('compare-180');

		// DOM Elements — Top Cards
		const metricSpeechTime = document.getElementById('metric-speech-time');
		const metricSpeechSub = document.getElementById('metric-speech-sub');
		const metricWordCount = document.getElementById('metric-word-count');
		const metricSentenceCount = document.getElementById('metric-sentence-count');
		const metricCharCount = document.getElementById('metric-char-count');
		const metricSlideCount = document.getElementById('metric-slide-count');
		const metricSlideSub = document.getElementById('metric-slide-sub');
		const metricCadenceBadge = document.getElementById('metric-cadence-badge');
		const metricCadenceDetail = document.getElementById('metric-cadence-detail');
		const cadenceDot = document.getElementById('cadence-dot');

		const defaultSampleSpeech = `Every great presentation begins with a simple promise: by the time these minutes are over, the audience will see a familiar problem in a clearer, more useful way.

When we speak on a stage or into a microphone, our listeners cannot re-read a dense paragraph. They rely on rhythm, clear phrasing, and natural pauses to take in each idea before the next one arrives. That is why experienced speakers aim for a conversational pace of around 130 words per minute—lively enough to hold attention, yet unhurried enough to let key points land.

Before you step up to speak, read your script out loud. Notice where you naturally take a breath, shorten sentences that feel wordy, and give your strongest ideas room to breathe.`;

		function formatSecondsToMinSec(totalSec: number): string {
			const clean = Math.max(0, Math.round(totalSec));
			const mins = Math.floor(clean / 60);
			const secs = clean % 60;
			return `${mins.toLocaleString()} min ${secs} sec`;
		}

		function formatClockDisplay(totalSec: number): string {
			const clean = Math.max(0, Math.round(totalSec));
			const hrs = Math.floor(clean / 3600);
			const mins = Math.floor((clean % 3600) / 60);
			const secs = clean % 60;
			const mm = String(mins).padStart(2, '0');
			const ss = String(secs).padStart(2, '0');
			if (hrs > 0) {
				return `${String(hrs).padStart(2, '0')}:${mm}:${ss}`;
			}
			return `${mm}:${ss}`;
		}

		function computeDurationSeconds(words: number, wpm: number, extraSec = 0): number {
			if (words <= 0 || wpm <= 0) return extraSec > 0 && words > 0 ? extraSec : 0;
			return Math.round((words / wpm) * 60) + extraSec;
		}

		function getCadenceProfile(wpm: number): {
			badge: string;
			sub: string;
			dotClass: string;
		} {
			if (wpm <= 114) {
				return {
					badge: 'Slow / formal',
					sub: 'Slow, deliberate pace',
					dotClass: 'bg-vercel-cyan',
				};
			}
			if (wpm <= 142) {
				return {
					badge: 'Keynote',
					sub: 'Conversational / keynote pace',
					dotClass: 'bg-vercel-blue',
				};
			}
			if (wpm <= 168) {
				return {
					badge: 'Presentation',
					sub: 'Lively presentation pace',
					dotClass: 'bg-vercel-violet',
				};
			}
			return {
				badge: 'Fast / podcast',
				sub: 'Fast podcast or broadcast pace',
				dotClass: 'bg-vercel-warning',
			};
		}

		function analyzeScript(text: string) {
			const trimmed = text.trim();
			const chars = text.length;
			if (!trimmed) {
				return { words: 0, sentences: 0, paragraphs: 0, chars: 0 };
			}
			const words = trimmed.split(/\s+/).filter(Boolean).length;
			const sentences = Math.max(
				1,
				trimmed.split(/[.!?]+/).filter((s) => s.trim().length > 0).length
			);
			const paragraphs = Math.max(
				1,
				trimmed.split(/\n\s*\n/).filter((p) => p.trim().length > 0).length
			);
			return { words, sentences, paragraphs, chars };
		}

		function playCompletionChime() {
			if (timerAudioToggle && !timerAudioToggle.checked) return;
			try {
				const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
				if (!AudioCtx) return;
				const ctx = new AudioCtx();
				const now = ctx.currentTime;

				const notes = [523.25, 659.25, 783.99];
				notes.forEach((freq, idx) => {
					const osc = ctx.createOscillator();
					const gain = ctx.createGain();
					osc.type = 'sine';
					osc.frequency.setValueAtTime(freq, now + idx * 0.12);
					gain.gain.setValueAtTime(0.0001, now + idx * 0.12);
					gain.gain.exponentialRampToValueAtTime(0.12, now + idx * 0.12 + 0.03);
					gain.gain.exponentialRampToValueAtTime(0.0001, now + idx * 0.12 + 0.55);
					osc.connect(gain);
					gain.connect(ctx.destination);
					osc.start(now + idx * 0.12);
					osc.stop(now + idx * 0.12 + 0.6);
				});
			} catch {
				// AudioContext blocked or unsupported
			}
		}

		function renderTimerDisplay() {
			if (rehearsalTimerDisplay) {
				rehearsalTimerDisplay.textContent = formatClockDisplay(timerRemainingSeconds);
			}
			if (rehearsalProgressBar) {
				const pct =
					timerTotalSeconds > 0
						? Math.max(0, Math.min(100, (timerRemainingSeconds / timerTotalSeconds) * 100))
						: 0;
				rehearsalProgressBar.style.width = `${pct}%`;
			}
		}

		function stopTimerInterval() {
			if (timerIntervalId !== null) {
				window.clearInterval(timerIntervalId);
				timerIntervalId = null;
			}
			isTimerRunning = false;
			if (btnTimerPause) btnTimerPause.disabled = true;
		}

		function syncTimerToDuration(newTotalSec: number, sourceLabel: string) {
			if (isTimerRunning) return;
			const fallbackSec = newTotalSec > 0 ? newTotalSec : 180;
			timerTotalSeconds = fallbackSec;
			timerRemainingSeconds = fallbackSec;

			if (timerSyncLabel) {
				timerSyncLabel.textContent = sourceLabel;
			}
			if (timerTargetSub) {
				timerTargetSub.textContent = `Total time: ${formatSecondsToMinSec(fallbackSec)} (${speakingWpm} WPM)`;
			}
			if (timerStateEyebrow) {
				timerStateEyebrow.textContent = 'Ready to rehearse';
			}
			if (btnTimerStartLabel) {
				btnTimerStartLabel.textContent = 'Start';
			}
			rehearsalCompleteAlert?.classList.add('hidden');
			rehearsalCompleteAlert?.classList.remove('inline-flex');
			timerDisplayBox?.classList.remove('border-vercel-blue');
			renderTimerDisplay();
		}

		function updateAllMetrics() {
			const rawScript = textarea ? textarea.value : '';
			const scriptStats = analyzeScript(rawScript);

			const minVal = targetMinutesInput ? parseInt(targetMinutesInput.value, 10) : 0;
			const secVal = targetSecondsInput ? parseInt(targetSecondsInput.value, 10) : 0;
			const cleanMin = Number.isNaN(minVal) || minVal < 0 ? 0 : minVal;
			const cleanSec = Number.isNaN(secVal) || secVal < 0 ? 0 : Math.min(59, secVal);
			const targetDurationSec = cleanMin * 60 + cleanSec;

			let activeWords = 0;
			let activeSentences = 0;
			let activeChars = 0;
			let activeDurationSec = 0;

			if (activeTab === 'script') {
				activeWords = scriptStats.words;
				activeSentences = scriptStats.sentences;
				activeChars = scriptStats.chars;
				activeDurationSec = computeDurationSeconds(activeWords, speakingWpm, pauseBufferSec);
			} else if (activeTab === 'target') {
				const effectiveSpeechSec = Math.max(0, targetDurationSec - pauseBufferSec);
				activeWords = Math.round((effectiveSpeechSec / 60) * speakingWpm);
				activeSentences = Math.max(0, Math.round(activeWords / 16));
				activeChars = activeWords * 6;
				activeDurationSec = targetDurationSec;
			} else {
				if (scriptStats.words > 0) {
					activeWords = scriptStats.words;
					activeSentences = scriptStats.sentences;
					activeChars = scriptStats.chars;
					activeDurationSec = computeDurationSeconds(activeWords, speakingWpm, pauseBufferSec);
				} else {
					const effectiveSpeechSec = Math.max(0, targetDurationSec - pauseBufferSec);
					activeWords = Math.round((effectiveSpeechSec / 60) * speakingWpm);
					activeSentences = Math.max(0, Math.round(activeWords / 16));
					activeChars = activeWords * 6;
					activeDurationSec = targetDurationSec;
				}
			}

			const scriptSlides =
				scriptStats.words > 0
					? Math.max(1, Math.round(computeDurationSeconds(scriptStats.words, speakingWpm, 0) / 60))
					: 0;
			if (inlineWordCounter) inlineWordCounter.textContent = scriptStats.words.toLocaleString();
			if (inlineSentenceCounter) inlineSentenceCounter.textContent = scriptStats.sentences.toLocaleString();
			if (inlineParaCounter) inlineParaCounter.textContent = scriptStats.paragraphs.toLocaleString();
			if (inlineSlideCounter) inlineSlideCounter.textContent = scriptSlides.toLocaleString();

			const effectiveTargetSec = Math.max(0, targetDurationSec - pauseBufferSec);
			const derivedTargetWords = Math.round((effectiveTargetSec / 60) * speakingWpm);
			const minRangeWords = Math.round((effectiveTargetSec / 60) * 100);
			const maxRangeWords = Math.round((effectiveTargetSec / 60) * 180);
			const targetSlides = targetDurationSec > 0 ? Math.max(1, Math.round(targetDurationSec / 60)) : 0;

			if (targetWpmInline) targetWpmInline.textContent = `${speakingWpm} WPM`;
			if (targetDerivedWords) targetDerivedWords.textContent = `${derivedTargetWords.toLocaleString()} words`;
			if (targetWordRange) {
				targetWordRange.textContent = `${minRangeWords.toLocaleString()} – ${maxRangeWords.toLocaleString()} words`;
			}
			if (targetDoublePages) {
				targetDoublePages.textContent = `${(derivedTargetWords / 250).toFixed(1)} pages`;
			}
			if (targetSlideCount) {
				targetSlideCount.textContent = `${targetSlides} ${targetSlides === 1 ? 'slide' : 'slides'}`;
			}

			if (rehearsalWordBadge) {
				rehearsalWordBadge.textContent =
					scriptStats.words > 0
						? `${scriptStats.words.toLocaleString()} words loaded`
						: `Target slot (${formatSecondsToMinSec(targetDurationSec)})`;
			}
			if (rehearsalScriptPreview) {
				rehearsalScriptPreview.textContent =
					scriptStats.words > 0
						? rawScript.trim()
						: 'Paste your script in the "Script to time" tab to read your notes here while practicing.';
			}

			const rehearsalSyncSeconds =
				scriptStats.words > 0
					? computeDurationSeconds(scriptStats.words, speakingWpm, pauseBufferSec)
					: targetDurationSec;
			const rehearsalSourceText =
				scriptStats.words > 0
					? `Synced to script (${scriptStats.words.toLocaleString()} words at ${speakingWpm} WPM)`
					: `Synced to target time (${formatSecondsToMinSec(targetDurationSec)})`;
			syncTimerToDuration(rehearsalSyncSeconds, rehearsalSourceText);

			const cadence = getCadenceProfile(speakingWpm);
			const durationMinutesFloat = activeDurationSec / 60;
			const estSlides = activeWords > 0 ? Math.max(1, Math.round(durationMinutesFloat)) : 0;
			const minSlides = activeWords > 0 ? Math.max(1, Math.floor(durationMinutesFloat / 2)) : 0;
			const maxSlides = activeWords > 0 ? Math.max(1, Math.ceil(durationMinutesFloat)) : 0;

			if (metricSpeechTime) {
				metricSpeechTime.textContent = formatSecondsToMinSec(activeDurationSec);
			}
			if (metricSpeechSub) {
				metricSpeechSub.textContent =
					pauseBufferSec > 0
						? `${cadence.sub} (+${pauseBufferSec}s buffer)`
						: cadence.sub;
			}
			if (metricWordCount) {
				metricWordCount.textContent = activeWords.toLocaleString();
			}
			if (metricSentenceCount) {
				metricSentenceCount.textContent = activeSentences.toLocaleString();
			}
			if (metricCharCount) {
				metricCharCount.textContent = activeChars.toLocaleString();
			}
			if (metricSlideCount) {
				metricSlideCount.textContent = estSlides.toLocaleString();
			}
			if (metricSlideSub) {
				metricSlideSub.textContent =
					activeWords > 0
						? `Typical range: ${minSlides}–${maxSlides} slides`
						: 'Typical range: 0–0 slides';
			}
			if (metricCadenceBadge) {
				metricCadenceBadge.textContent = cadence.badge;
			}
			if (metricCadenceDetail) {
				const wordsPerSec = (speakingWpm / 60).toFixed(1);
				metricCadenceDetail.textContent = `${speakingWpm} WPM · ${wordsPerSec} words/sec`;
			}
			if (cadenceDot) {
				cadenceDot.className = `inline-block h-2 w-2 rounded-full ${cadence.dotClass}`;
			}

			if (compare100) {
				compare100.textContent = formatSecondsToMinSec(
					computeDurationSeconds(activeWords, 100, pauseBufferSec)
				);
			}
			if (compare130) {
				compare130.textContent = formatSecondsToMinSec(
					computeDurationSeconds(activeWords, 130, pauseBufferSec)
				);
			}
			if (compare150) {
				compare150.textContent = formatSecondsToMinSec(
					computeDurationSeconds(activeWords, 150, pauseBufferSec)
				);
			}
			if (compare180) {
				compare180.textContent = formatSecondsToMinSec(
					computeDurationSeconds(activeWords, 180, pauseBufferSec)
				);
			}
		}

		function syncWpmPresetButtons() {
			wpmPresetBtns.forEach((btn) => {
				const presetVal = Number(btn.dataset.wpmPreset);
				const isActive = presetVal === speakingWpm;
				const titleSpan = btn.querySelector('span:first-child');
				const subSpan = btn.querySelector('span:last-child');
				if (isActive) {
					btn.className =
						'wpm-preset-btn flex cursor-pointer items-center justify-between rounded-sm border border-primary bg-primary px-3 py-2 text-left text-on-primary transition-all';
					if (titleSpan) titleSpan.className = 'text-[13px] font-medium';
					if (subSpan) subSpan.className = 'text-[12px] opacity-80 tabular-nums';
				} else {
					btn.className =
						'wpm-preset-btn flex cursor-pointer items-center justify-between rounded-sm border border-hairline bg-canvas px-3 py-2 text-left transition-all hover:border-ink';
					if (titleSpan) titleSpan.className = 'text-[13px] font-medium text-ink';
					if (subSpan) subSpan.className = 'text-[12px] text-mute tabular-nums';
				}
			});
		}

		function setSpeakingWpm(newWpm: number) {
			speakingWpm = Math.min(220, Math.max(100, newWpm));
			if (speakingSlider) speakingSlider.value = String(speakingWpm);
			if (speakingWpmDisplay) speakingWpmDisplay.textContent = String(speakingWpm);
			if (badgeSpeakingWpm) badgeSpeakingWpm.textContent = `${speakingWpm} WPM`;
			syncWpmPresetButtons();
			updateAllMetrics();
		}

		function switchTab(targetTab: 'script' | 'target' | 'rehearsal') {
			activeTab = targetTab;

			tabBtns.forEach((btn) => {
				const isMatch = btn.dataset.tab === targetTab;
				btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
				btn.className = isMatch
					? 'speech-tab-btn cursor-pointer rounded-pill-category bg-primary px-3.5 py-1.5 text-[13px] font-medium text-on-primary transition-all'
					: 'speech-tab-btn cursor-pointer rounded-pill-category bg-transparent px-3.5 py-1.5 text-[13px] font-medium text-body transition-all hover:bg-hairline-soft hover:text-ink';
			});

			panelScript?.classList.toggle('hidden', targetTab !== 'script');
			panelScript?.classList.toggle('flex', targetTab === 'script');

			panelTarget?.classList.toggle('hidden', targetTab !== 'target');
			panelTarget?.classList.toggle('flex', targetTab === 'target');

			panelRehearsal?.classList.toggle('hidden', targetTab !== 'rehearsal');
			panelRehearsal?.classList.toggle('flex', targetTab === 'rehearsal');

			scriptToolbar?.classList.toggle('hidden', targetTab !== 'script');
			scriptToolbar?.classList.toggle('flex', targetTab === 'script');

			if (badgeActiveMode) {
				badgeActiveMode.textContent =
					targetTab === 'script'
						? 'Script to time'
						: targetTab === 'target'
							? 'Time to words'
							: 'Rehearsal timer';
			}
			if (labelWordMetric) {
				labelWordMetric.textContent =
					targetTab === 'target' ? 'Target words' : 'Word count';
			}

			updateAllMetrics();
		}

		tabBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const t = btn.dataset.tab as 'script' | 'target' | 'rehearsal';
				if (t) switchTab(t);
			});
		});

		textarea?.addEventListener('input', updateAllMetrics);

		btnClearScript?.addEventListener('click', () => {
			if (textarea) {
				textarea.value = '';
				textarea.focus();
				if (fileStatusMsg) fileStatusMsg.textContent = 'Script cleared';
				updateAllMetrics();
			}
		});

		btnLoadSample?.addEventListener('click', () => {
			if (textarea) {
				textarea.value = defaultSampleSpeech;
				if (fileStatusMsg) fileStatusMsg.textContent = 'Sample speech loaded';
				if (activeTab !== 'script') switchTab('script');
				else updateAllMetrics();
			}
		});

		btnJumpRehearsal?.addEventListener('click', () => {
			stopTimerInterval();
			switchTab('rehearsal');
		});

		function readScriptFile(file: File) {
			if (!file) return;
			const lower = file.name.toLowerCase();
			const isSupported =
				file.type === 'text/plain' ||
				file.type === 'text/markdown' ||
				lower.endsWith('.txt') ||
				lower.endsWith('.md');

			if (!isSupported) {
				if (fileStatusMsg) fileStatusMsg.textContent = 'Please upload a .txt or .md file';
				return;
			}

			const reader = new FileReader();
			reader.onload = (e) => {
				const content = typeof e.target?.result === 'string' ? e.target.result : '';
				if (textarea) {
					textarea.value = content;
					if (activeTab !== 'script') switchTab('script');
					else updateAllMetrics();
				}
				if (fileStatusMsg) {
					fileStatusMsg.textContent = `Loaded ${file.name}`;
				}
			};
			reader.readAsText(file);
		}

		fileInput?.addEventListener('change', () => {
			const file = fileInput.files?.[0];
			if (file) readScriptFile(file);
			fileInput.value = '';
		});

		if (panelScript && dropzoneOverlay) {
			let dragCounter = 0;

			panelScript.addEventListener('dragenter', (e) => {
				e.preventDefault();
				dragCounter++;
				dropzoneOverlay.classList.remove('hidden');
				dropzoneOverlay.classList.add('flex');
			});

			panelScript.addEventListener('dragover', (e) => {
				e.preventDefault();
			});

			panelScript.addEventListener('dragleave', (e) => {
				e.preventDefault();
				dragCounter--;
				if (dragCounter <= 0) {
					dragCounter = 0;
					dropzoneOverlay.classList.add('hidden');
					dropzoneOverlay.classList.remove('flex');
				}
			});

			panelScript.addEventListener('drop', (e) => {
				e.preventDefault();
				dragCounter = 0;
				dropzoneOverlay.classList.add('hidden');
				dropzoneOverlay.classList.remove('flex');
				const file = e.dataTransfer?.files?.[0];
				if (file) readScriptFile(file);
			});
		}

		function syncDurationPresetButtons() {
			const curMin = Number(targetMinutesInput?.value ?? 0);
			const curSec = Number(targetSecondsInput?.value ?? 0);
			durationPresetBtns.forEach((btn) => {
				const pMin = Number(btn.dataset.minPreset);
				const pSec = Number(btn.dataset.secPreset);
				const isMatch = pMin === curMin && pSec === curSec;
				btn.className = isMatch
					? 'duration-preset-btn cursor-pointer rounded-sm border border-primary bg-primary px-3 py-1.5 text-[13px] font-medium text-on-primary transition-colors'
					: 'duration-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body transition-colors hover:border-ink hover:text-ink';
			});
		}

		targetMinutesInput?.addEventListener('input', () => {
			syncDurationPresetButtons();
			updateAllMetrics();
		});

		targetSecondsInput?.addEventListener('input', () => {
			syncDurationPresetButtons();
			updateAllMetrics();
		});

		durationPresetBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const pMin = btn.dataset.minPreset ?? '5';
				const pSec = btn.dataset.secPreset ?? '0';
				if (targetMinutesInput) targetMinutesInput.value = pMin;
				if (targetSecondsInput) targetSecondsInput.value = pSec;
				syncDurationPresetButtons();
				updateAllMetrics();
			});
		});

		btnTimerStart?.addEventListener('click', () => {
			if (isTimerRunning) return;

			if (timerRemainingSeconds <= 0) {
				timerRemainingSeconds = timerTotalSeconds > 0 ? timerTotalSeconds : 180;
			}

			rehearsalCompleteAlert?.classList.add('hidden');
			rehearsalCompleteAlert?.classList.remove('inline-flex');
			timerDisplayBox?.classList.remove('border-vercel-blue');

			isTimerRunning = true;
			if (btnTimerPause) btnTimerPause.disabled = false;
			if (btnTimerStartLabel) btnTimerStartLabel.textContent = 'Running...';
			if (timerStateEyebrow) timerStateEyebrow.textContent = 'Rehearsal in progress';
			if (timerStatusDot) timerStatusDot.className = 'inline-block h-2 w-2 rounded-full bg-vercel-blue';

			timerIntervalId = window.setInterval(() => {
				if (timerRemainingSeconds > 0) {
					timerRemainingSeconds--;
					renderTimerDisplay();
				}

				if (timerRemainingSeconds <= 0) {
					stopTimerInterval();
					if (btnTimerStartLabel) btnTimerStartLabel.textContent = 'Restart';
					if (timerStateEyebrow) timerStateEyebrow.textContent = 'Time complete';
					if (timerStatusDot) timerStatusDot.className = 'inline-block h-2 w-2 rounded-full bg-vercel-warning';
					rehearsalCompleteAlert?.classList.remove('hidden');
					rehearsalCompleteAlert?.classList.add('inline-flex');
					timerDisplayBox?.classList.add('border-vercel-blue');
					playCompletionChime();
				}
			}, 1000);
		});

		btnTimerPause?.addEventListener('click', () => {
			if (!isTimerRunning) return;
			stopTimerInterval();
			if (btnTimerStartLabel) btnTimerStartLabel.textContent = 'Resume';
			if (timerStateEyebrow) timerStateEyebrow.textContent = 'Paused';
			if (timerStatusDot) timerStatusDot.className = 'inline-block h-2 w-2 rounded-full bg-mute';
		});

		btnTimerReset?.addEventListener('click', () => {
			stopTimerInterval();
			timerRemainingSeconds = timerTotalSeconds > 0 ? timerTotalSeconds : 180;
			if (btnTimerStartLabel) btnTimerStartLabel.textContent = 'Start';
			if (timerStateEyebrow) timerStateEyebrow.textContent = 'Ready to rehearse';
			if (timerStatusDot) timerStatusDot.className = 'inline-block h-2 w-2 rounded-full bg-mute';
			rehearsalCompleteAlert?.classList.add('hidden');
			rehearsalCompleteAlert?.classList.remove('inline-flex');
			timerDisplayBox?.classList.remove('border-vercel-blue');
			renderTimerDisplay();
		});

		timerAdjustBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const delta = Number(btn.dataset.timerAdjust ?? 0);
				if (!delta) return;
				const nextRemaining = Math.max(10, timerRemainingSeconds + delta);
				timerRemainingSeconds = nextRemaining;
				timerTotalSeconds = Math.max(timerTotalSeconds, nextRemaining);
				renderTimerDisplay();
			});
		});

		speakingSlider?.addEventListener('input', () => {
			setSpeakingWpm(Number(speakingSlider.value));
		});

		wpmPresetBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const val = Number(btn.dataset.wpmPreset);
				if (val) setSpeakingWpm(val);
			});
		});

		pauseBufferBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const sec = Number(btn.dataset.pauseBuffer ?? 0);
				pauseBufferSec = sec;
				if (pauseBufferBadge) {
					pauseBufferBadge.textContent = `+${sec}s buffer`;
				}
				pauseBufferBtns.forEach((b) => {
					const active = Number(b.dataset.pauseBuffer ?? 0) === pauseBufferSec;
					b.className = active
						? 'pause-buffer-btn cursor-pointer rounded-sm border border-primary bg-primary py-1.5 text-center text-[13px] font-medium text-on-primary tabular-nums transition-all'
						: 'pause-buffer-btn cursor-pointer rounded-sm border border-hairline bg-canvas py-1.5 text-center text-[13px] font-medium text-body tabular-nums transition-all hover:border-ink hover:text-ink';
				});
				updateAllMetrics();
			});
		});

		const keynoteResetBtn = document.querySelector('[data-quick-action="keynote-reset"]');
		keynoteResetBtn?.addEventListener('click', (e) => {
			e.preventDefault();
			setSpeakingWpm(130);
			speakingSlider?.focus();
		});

		updateAllMetrics();
	}

	initSpeechCalculator();
</script>
