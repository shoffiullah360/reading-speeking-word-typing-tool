---
import { localePath } from '../i18n/ui';
import { getToolById } from '../config/site';

const readingTool = getToolById('reading-time-calculator');
const wordsToPagesTool = getToolById('words-to-pages');
const speechTool = getToolById('speech-time-calculator');
---

<section
	id="word-counter-workspace"
	aria-label="Word and Character Counter Workspace"
	class="mx-auto max-w-[1200px] px-4 pt-4 pb-12 sm:px-6"
>
	<!-- Unified Stacked Card Container -->
	<div class="whisper-shadow overflow-hidden rounded-3xl border border-hairline bg-canvas-elevated">
		<!-- Top Section — Full-Width Clean Editor -->
		<div class="flex flex-col justify-between p-6 sm:p-8">
			<!-- Borderless Textarea with balanced height -->
			<div class="flex flex-1 flex-col">
				<label for="wc-textarea" class="sr-only">Type or paste your text here</label>
				<textarea
					id="wc-textarea"
					placeholder="Type or paste your text here..."
					class="h-48 sm:h-56 w-full resize-y border-0 bg-transparent font-sans text-[16px] leading-[28px] text-ink placeholder:text-faint focus:outline-none"
				></textarea>
			</div>

			<!-- Minimal Footer Bar with Subtle Actions -->
			<div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-hairline pt-4 text-[13px]">
				<div class="flex items-center gap-1.5 font-medium text-mute tabular-nums">
					<span id="wc-footer-words">0</span> words &middot; <span id="wc-footer-chars">0</span> characters
				</div>

				<div class="flex flex-wrap items-center gap-3.5 sm:gap-4">
					<button
						type="button"
						id="wc-btn-paste"
						class="cursor-pointer font-medium text-mute transition-colors hover:text-ink"
					>
						Paste
					</button>
					<label
						for="wc-file-input"
						class="cursor-pointer font-medium text-mute transition-colors hover:text-ink"
					>
						Upload .txt
						<input
							id="wc-file-input"
							type="file"
							accept=".txt,.md,text/plain,text/markdown"
							class="sr-only"
						/>
					</label>
					<button
						type="button"
						id="wc-btn-clean-spaces"
						class="cursor-pointer font-medium text-mute transition-colors hover:text-ink"
					>
						Clean spaces
					</button>
					<button
						type="button"
						id="wc-btn-copy-text"
						class="cursor-pointer font-medium text-mute transition-colors hover:text-ink"
					>
						Copy text
					</button>
					<button
						type="button"
						id="wc-btn-clear"
						class="cursor-pointer font-medium text-mute transition-colors hover:text-vercel-error"
					>
						Clear
					</button>
				</div>
			</div>
		</div>

		<!-- Bottom Section — Full-Width Deep Forest Emerald Stats Dashboard -->
		<div class="border-t border-[#afe3d0]/15 bg-[#0f2e26] p-6 text-[#f0fdf7] sm:p-8">
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-8 items-stretch">
				<!-- Column 1 (Hero Counters & Action: lg:col-span-3) -->
				<div class="flex flex-col justify-between gap-6 lg:col-span-3">
					<div class="space-y-5">
						<!-- Words Hero -->
						<div>
							<span class="text-[12px] font-medium text-[#afe3d0]/80">Words</span>
							<output
								id="wc-hero-words"
								aria-live="polite"
								class="mt-1 block font-sans text-[40px] leading-[44px] font-semibold tracking-[-1.5px] text-[#afe3d0] tabular-nums sm:text-[46px] sm:leading-[50px]"
							>
								0
							</output>
						</div>

						<!-- Characters Hero -->
						<div class="border-t border-[#afe3d0]/15 pt-4">
							<span class="text-[12px] font-medium text-white/80">Characters</span>
							<output
								id="wc-hero-chars"
								aria-live="polite"
								class="mt-1 block font-sans text-[34px] leading-[38px] font-semibold tracking-[-1.5px] text-white tabular-nums sm:text-[38px] sm:leading-[42px]"
							>
								0
							</output>
							<p class="mt-1 text-[12px] text-white/60 tabular-nums">
								<span id="wc-hero-chars-nospace">0</span> without spaces<span id="wc-cjk-wrapper" class="hidden"> &middot; <span id="wc-cjk-count" class="text-[#afe3d0] font-medium">0</span> CJK chars</span>
							</p>
						</div>
					</div>

					<!-- Single Action Button: Copy Summary -->
					<div class="pt-2">
						<button
							type="button"
							id="wc-btn-copy-summary"
							class="flex w-full cursor-pointer items-center justify-center rounded-2xl bg-[#afe3d0] px-4 py-3 text-[14px] font-semibold text-[#0f2e26] transition-all hover:bg-[#c2edd6] active:scale-[0.99]"
						>
							Copy summary
						</button>
					</div>
				</div>

				<!-- Column 2 (Core Metrics / Top Keywords Switch: lg:col-span-5) -->
				<div class="flex flex-col gap-4 lg:col-span-5 lg:border-x lg:border-[#afe3d0]/15 lg:px-6">
					<!-- Compact Segmented Pill Switch -->
					<div class="flex items-center justify-between border-b border-[#afe3d0]/15 pb-3">
						<div
							role="tablist"
							aria-label="Panel view"
							class="inline-flex rounded-full border border-[#afe3d0]/20 bg-white/[0.04] p-1"
						>
							<button
								type="button"
								role="tab"
								id="wc-tab-stats"
								aria-selected="true"
								aria-controls="wc-view-stats"
								class="cursor-pointer rounded-full bg-[#afe3d0] px-3.5 py-1 text-[12px] font-semibold text-[#0f2e26] transition-all"
							>
								Stats
							</button>
							<button
								type="button"
								role="tab"
								id="wc-tab-keywords"
								aria-selected="false"
								aria-controls="wc-view-keywords"
								class="cursor-pointer rounded-full bg-transparent px-3.5 py-1 text-[12px] font-medium text-white/70 transition-all hover:text-white"
							>
								Top Keywords
							</button>
						</div>
					</div>

					<!-- Stats View: Clean 3×2 Grid -->
					<div id="wc-view-stats" class="grid grid-cols-2 gap-2.5">
						<!-- Sentences -->
						<div class="rounded-2xl border border-[#afe3d0]/15 bg-white/[0.04] p-3">
							<span class="text-[12px] font-medium text-white/70">Sentences</span>
							<output
								id="wc-stat-sentences"
								class="mt-1 block font-sans text-[20px] leading-[26px] font-semibold text-white tabular-nums"
							>
								0
							</output>
						</div>

						<!-- Paragraphs -->
						<div class="rounded-2xl border border-[#afe3d0]/15 bg-white/[0.04] p-3">
							<span class="text-[12px] font-medium text-white/70">Paragraphs</span>
							<output
								id="wc-stat-paragraphs"
								class="mt-1 block font-sans text-[20px] leading-[26px] font-semibold text-white tabular-nums"
							>
								0
							</output>
						</div>

						<!-- Reading Time (238 WPM) -->
						<div class="rounded-2xl border border-[#afe3d0]/15 bg-white/[0.04] p-3">
							<div class="flex items-center justify-between">
								<span class="text-[12px] font-medium text-white/70">Reading time</span>
								<span class="text-[10px] text-[#afe3d0]/60">238 WPM</span>
							</div>
							<output
								id="wc-stat-reading-time"
								class="mt-1 block font-sans text-[17px] leading-[24px] font-semibold text-white tabular-nums"
							>
								0 sec
							</output>
						</div>

						<!-- Speaking Time (130 WPM) -->
						<div class="rounded-2xl border border-[#afe3d0]/15 bg-white/[0.04] p-3">
							<div class="flex items-center justify-between">
								<span class="text-[12px] font-medium text-white/70">Speaking time</span>
								<span class="text-[10px] text-[#afe3d0]/60">130 WPM</span>
							</div>
							<output
								id="wc-stat-speaking-time"
								class="mt-1 block font-sans text-[17px] leading-[24px] font-semibold text-white tabular-nums"
							>
								0 sec
							</output>
						</div>

						<!-- Pages (250 words/page) -->
						<div class="rounded-2xl border border-[#afe3d0]/15 bg-white/[0.04] p-3">
							<div class="flex items-center justify-between">
								<span class="text-[12px] font-medium text-white/70">Pages</span>
								<span class="text-[10px] text-[#afe3d0]/60">250 w/p</span>
							</div>
							<output
								id="wc-stat-pages"
								class="mt-1 block font-sans text-[20px] leading-[26px] font-semibold text-white tabular-nums"
							>
								0
							</output>
						</div>

						<!-- Readability (Flesch-Kincaid) -->
						<div class="rounded-2xl border border-[#afe3d0]/15 bg-white/[0.04] p-3">
							<div class="flex items-center justify-between">
								<span class="text-[12px] font-medium text-white/70">Readability</span>
								<span class="text-[10px] text-[#afe3d0]/60">Flesch-Kincaid</span>
							</div>
							<output
								id="wc-stat-readability"
								class="mt-1 block font-sans text-[17px] leading-[24px] font-semibold text-white tabular-nums"
							>
								—
							</output>
						</div>
					</div>

					<!-- Top Keywords View: Clean 2-Column Compact List -->
					<div id="wc-view-keywords" class="hidden flex-col gap-3">
						<div class="flex items-center justify-between">
							<div>
								<span class="text-[12px] font-medium text-white">Top 8 Keywords</span>
							</div>
							<button
								type="button"
								id="wc-btn-copy-keywords"
								class="cursor-pointer text-[12px] font-medium text-[#afe3d0] transition-colors hover:text-white"
							>
								Copy keywords
							</button>
						</div>

						<!-- Empty State -->
						<div
							id="wc-keywords-empty"
							class="rounded-2xl border border-[#afe3d0]/15 bg-white/[0.04] p-6 text-center text-[12px] text-white/60"
						>
							Type or paste text to see keyword density.
						</div>

						<!-- Keywords List (2 columns on sm+) -->
						<ul
							id="wc-keywords-list"
							class="hidden grid-cols-1 sm:grid-cols-2 gap-2 text-[12px]"
						></ul>
					</div>
				</div>

				<!-- Column 3 (Platform Limits & Word Goal: lg:col-span-4) -->
				<div class="lg:col-span-4">
					<div class="space-y-3 rounded-2xl border border-[#afe3d0]/15 bg-white/[0.04] p-4">
						<div class="flex items-center justify-between">
							<span class="text-[12px] font-medium text-white/80">Platform limits</span>
							<span class="text-[11px] text-white/50">Characters</span>
						</div>

						<!-- Google Title (60 chars) -->
						<div>
							<div class="flex items-center justify-between text-[12px]">
								<span class="text-white/70">Google Title</span>
								<span id="wc-limit-label-title" class="font-medium text-white tabular-nums transition-colors">
									<span id="wc-limit-num-title">0</span> / 60
								</span>
							</div>
							<div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
								<div
									id="wc-limit-bar-title"
									class="h-full rounded-full bg-[#afe3d0] transition-all duration-200"
									style="width: 0%"
								></div>
							</div>
						</div>

						<!-- Meta Description (160 chars) -->
						<div>
							<div class="flex items-center justify-between text-[12px]">
								<span class="text-white/70">Meta Description</span>
								<span id="wc-limit-label-meta" class="font-medium text-white tabular-nums transition-colors">
									<span id="wc-limit-num-meta">0</span> / 160
								</span>
							</div>
							<div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
								<div
									id="wc-limit-bar-meta"
									class="h-full rounded-full bg-[#afe3d0] transition-all duration-200"
									style="width: 0%"
								></div>
							</div>
						</div>

						<!-- X / Social Post (280 chars) -->
						<div>
							<div class="flex items-center justify-between text-[12px]">
								<span class="text-white/70">X / Social Post</span>
								<span id="wc-limit-label-social" class="font-medium text-white tabular-nums transition-colors">
									<span id="wc-limit-num-social">0</span> / 280
								</span>
							</div>
							<div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
								<div
									id="wc-limit-bar-social"
									class="h-full rounded-full bg-[#afe3d0] transition-all duration-200"
									style="width: 0%"
								></div>
							</div>
						</div>

						<!-- Inline Word Goal -->
						<div class="border-t border-[#afe3d0]/10 pt-3">
							<div class="flex items-center justify-between text-[12px]">
								<div class="flex items-center gap-1.5">
									<label for="wc-goal-input" class="text-white/70">Word goal</label>
									<input
										id="wc-goal-input"
										type="number"
										min="1"
										max="100000"
										placeholder="—"
										class="w-16 rounded-md border border-[#afe3d0]/25 bg-white/[0.06] px-2 py-0.5 text-center text-[12px] font-medium text-[#afe3d0] tabular-nums placeholder:text-white/30 focus:border-[#afe3d0] focus:outline-none"
									/>
									<span class="text-white/50">words</span>
								</div>
								<span id="wc-goal-progress" class="font-medium text-white/70 tabular-nums">
									—
								</span>
							</div>
							<div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-white/10">
								<div
									id="wc-goal-bar"
									class="h-full rounded-full bg-[#afe3d0] transition-all duration-200"
									style="width: 0%"
								></div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Related Tools Note (Protected Against Draft Links) -->
	<aside
		aria-label="Related text and reading tools"
		class="mt-5 flex flex-col items-start justify-between gap-3 pt-2 text-[14px] text-body sm:flex-row sm:items-center"
	>
		<p class="leading-[22px]">
			Need page count formatting or custom WPM sliders? Try our{' '}
			{
				wordsToPagesTool?.status === 'live' ? (
					<a
						href={localePath(wordsToPagesTool.slug, Astro.url)}
						class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 transition-colors hover:text-vercel-blue-deep hover:decoration-vercel-blue"
					>
						{wordsToPagesTool.shortName}
					</a>
				) : (
					<span aria-disabled="true" class="inline-flex items-center gap-1.5 font-medium text-ink">
						<span>{wordsToPagesTool?.shortName ?? 'Words to Pages'}</span>
						<span class="rounded-full bg-hairline-soft px-2 py-0.5 text-[11px] font-medium text-mute">
							Soon
						</span>
					</span>
				)
			}
			,{' '}
			{
				readingTool?.status === 'live' ? (
					<a
						href={localePath(readingTool.slug, Astro.url)}
						class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 transition-colors hover:text-vercel-blue-deep hover:decoration-vercel-blue"
					>
						{readingTool.shortName}
					</a>
				) : (
					<span aria-disabled="true" class="inline-flex items-center gap-1.5 font-medium text-ink">
						<span>{readingTool?.shortName ?? 'Reading Time Counter'}</span>
						<span class="rounded-full bg-hairline-soft px-2 py-0.5 text-[11px] font-medium text-mute">
							Soon
						</span>
					</span>
				)
			}
			, or{' '}
			{
				speechTool?.status === 'live' ? (
					<a
						href={localePath(speechTool.slug, Astro.url)}
						class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 transition-colors hover:text-vercel-blue-deep hover:decoration-vercel-blue"
					>
						{speechTool.shortName}
					</a>
				) : (
					<span aria-disabled="true" class="inline-flex items-center gap-1.5 font-medium text-ink">
						<span>{speechTool?.shortName ?? 'Speech Time Calculator'}</span>
						<span class="rounded-full bg-hairline-soft px-2 py-0.5 text-[11px] font-medium text-mute">
							Soon
						</span>
					</span>
				)
			}
			.
		</p>
	</aside>
</section>

<script>
	function initWordCounterTool() {
		const STOP_WORDS = new Set([
			'a', 'an', 'the', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of',
			'with', 'is', 'are', 'was', 'were', 'be', 'been', 'being', 'this', 'that',
			'it', 'its', 'as', 'by', 'from', 'have', 'has', 'had', 'do', 'does', 'did',
			'i', 'you', 'he', 'she', 'we', 'they', 'them', 'their', 'my', 'your', 'his',
			'her', 'our', 'what', 'which', 'who', 'whom', 'not', 'no', 'so', 'can',
			'will', 'would', 'should', 'could', 'just', 'all', 'if', 'up', 'out', 'into',
			'there', 'than', 'then', 'now', 'about', 'more', 'some', 'any', 'also'
		]);

		const textarea = document.getElementById('wc-textarea') as HTMLTextAreaElement | null;
		const btnPaste = document.getElementById('wc-btn-paste');
		const fileInput = document.getElementById('wc-file-input') as HTMLInputElement | null;
		const btnCleanSpaces = document.getElementById('wc-btn-clean-spaces');
		const btnCopyText = document.getElementById('wc-btn-copy-text');
		const btnClear = document.getElementById('wc-btn-clear');
		const btnCopySummary = document.getElementById('wc-btn-copy-summary');

		// Tabs & Views
		const tabStats = document.getElementById('wc-tab-stats');
		const tabKeywords = document.getElementById('wc-tab-keywords');
		const viewStats = document.getElementById('wc-view-stats');
		const viewKeywords = document.getElementById('wc-view-keywords');

		// Left Footer Outputs
		const footerWords = document.getElementById('wc-footer-words');
		const footerChars = document.getElementById('wc-footer-chars');

		// Hero Outputs
		const heroWords = document.getElementById('wc-hero-words');
		const heroChars = document.getElementById('wc-hero-chars');
		const heroCharsNoSpace = document.getElementById('wc-hero-chars-nospace');
		const cjkWrapper = document.getElementById('wc-cjk-wrapper');
		const cjkCountEl = document.getElementById('wc-cjk-count');

		// Structure & Time Outputs
		const statSentences = document.getElementById('wc-stat-sentences');
		const statParagraphs = document.getElementById('wc-stat-paragraphs');
		const statReadingTime = document.getElementById('wc-stat-reading-time');
		const statSpeakingTime = document.getElementById('wc-stat-speaking-time');
		const statPages = document.getElementById('wc-stat-pages');
		const statReadability = document.getElementById('wc-stat-readability');

		// Platform Limits
		const limitNumTitle = document.getElementById('wc-limit-num-title');
		const limitLabelTitle = document.getElementById('wc-limit-label-title');
		const limitBarTitle = document.getElementById('wc-limit-bar-title');

		const limitNumMeta = document.getElementById('wc-limit-num-meta');
		const limitLabelMeta = document.getElementById('wc-limit-label-meta');
		const limitBarMeta = document.getElementById('wc-limit-bar-meta');

		const limitNumSocial = document.getElementById('wc-limit-num-social');
		const limitLabelSocial = document.getElementById('wc-limit-label-social');
		const limitBarSocial = document.getElementById('wc-limit-bar-social');

		// Word Goal
		const goalInput = document.getElementById('wc-goal-input') as HTMLInputElement | null;
		const goalProgress = document.getElementById('wc-goal-progress');
		const goalBar = document.getElementById('wc-goal-bar');

		// Keywords
		const keywordsEmpty = document.getElementById('wc-keywords-empty');
		const keywordsList = document.getElementById('wc-keywords-list');
		const btnCopyKeywords = document.getElementById('wc-btn-copy-keywords');

		let currentSummary = '';
		let topKeywordsList: Array<{ word: string; count: number; density: string }> = [];

		function formatDuration(words: number, wpm: number): string {
			if (words <= 0 || wpm <= 0) return '0 sec';
			const totalSeconds = Math.round((words / wpm) * 60);
			if (totalSeconds < 60) {
				return `${totalSeconds} sec`;
			}
			const minutes = Math.floor(totalSeconds / 60);
			const seconds = totalSeconds % 60;
			return seconds > 0 ? `${minutes} min ${seconds} sec` : `${minutes} min`;
		}

		function countSyllablesInWord(word: string): number {
			const w = word.toLowerCase().replace(/[^a-z]/g, '');
			if (!w) return 0;
			if (w.length <= 3) return 1;
			const cleaned = w
				.replace(/(?:[^laeiouy]|ed|es|e)$/, '')
				.replace(/^y/, '');
			const matches = cleaned.match(/[aeiouy]{1,2}/g);
			return matches ? Math.max(1, matches.length) : 1;
		}

		function calculateReadability(words: number, sentences: number, syllables: number): string {
			if (words < 5 || sentences < 1) return '—';
			const grade = 0.39 * (words / sentences) + 11.8 * (syllables / words) - 15.59;
			const rounded = Math.round(grade);
			if (rounded <= 0) return 'Grade 1';
			if (rounded <= 12) return `Grade ${rounded}`;
			if (rounded <= 16) return 'College';
			return 'Graduate';
		}

		function updateLimitRow(
			chars: number,
			limit: number,
			numEl: HTMLElement | null,
			labelEl: HTMLElement | null,
			barEl: HTMLElement | null
		) {
			if (numEl) numEl.textContent = chars.toLocaleString();
			const pct = limit > 0 ? Math.min(100, Math.round((chars / limit) * 100)) : 0;
			if (barEl) {
				barEl.style.width = `${pct}%`;
				if (chars > limit) {
					barEl.classList.remove('bg-[#afe3d0]');
					barEl.classList.add('bg-amber-400');
				} else {
					barEl.classList.add('bg-[#afe3d0]');
					barEl.classList.remove('bg-amber-400');
				}
			}
			if (labelEl) {
				if (chars > limit) {
					labelEl.classList.add('text-amber-300');
					labelEl.classList.remove('text-white');
				} else {
					labelEl.classList.remove('text-amber-300');
					labelEl.classList.add('text-white');
				}
			}
		}

		function updateGoal(wordCount: number) {
			if (!goalInput || !goalProgress || !goalBar) return;
			const goalVal = parseInt(goalInput.value, 10);
			if (Number.isNaN(goalVal) || goalVal <= 0) {
				goalProgress.textContent = '—';
				goalProgress.classList.remove('text-[#afe3d0]');
				goalProgress.classList.add('text-white/70');
				goalBar.style.width = '0%';
				return;
			}

			const pct = Math.round((wordCount / goalVal) * 100);
			goalProgress.textContent = `${wordCount.toLocaleString()} / ${goalVal.toLocaleString()} · ${pct}%`;
			goalBar.style.width = `${Math.min(100, pct)}%`;
			if (wordCount >= goalVal) {
				goalProgress.classList.add('text-[#afe3d0]');
				goalProgress.classList.remove('text-white/70');
			} else {
				goalProgress.classList.remove('text-[#afe3d0]');
				goalProgress.classList.add('text-white/70');
			}
		}

		function updateMetrics() {
			const raw = textarea ? textarea.value : '';
			const trimmed = raw.trim();
			const charsWithSpaces = raw.length;
			const charsWithoutSpaces = raw.replace(/\s/g, '').length;

			// Smart CJK Character Detection (Chinese & Japanese)
			const cjkMatches = raw.match(/[\u4e00-\u9fff\u3040-\u30ff]/g);
			const cjkCount = cjkMatches ? cjkMatches.length : 0;

			// Latin / space-delimited words (replacing CJK chars so adjacent words remain clean)
			const nonCjkText = raw.replace(/[\u4e00-\u9fff\u3040-\u30ff]/g, ' ').trim();
			const latinTokens = nonCjkText ? nonCjkText.split(/\s+/).filter(Boolean) : [];

			// Total Word Count: Latin words + CJK characters
			const wordCount = latinTokens.length + cjkCount;

			const sentenceParts = trimmed ? trimmed.split(/[.!?]+/).filter((s) => s.trim().length > 0) : [];
			const sentenceCount = trimmed ? Math.max(1, sentenceParts.length) : 0;

			const paragraphParts = trimmed ? trimmed.split(/\n\s*\n/).filter((p) => p.trim().length > 0) : [];
			const paragraphCount = trimmed ? Math.max(1, paragraphParts.length) : 0;

			const readingTimeStr = formatDuration(wordCount, 238);
			const speakingTimeStr = formatDuration(wordCount, 130);
			const pagesStr = wordCount > 0 ? (wordCount / 250).toFixed(1) : '0';

			let totalSyllables = 0;
			const freqMap = new Map<string, number>();

			for (const token of latinTokens) {
				const cleaned = token.toLowerCase().replace(/^[^a-z0-9]+|[^a-z0-9]+$/gi, '');
				if (!cleaned) continue;
				totalSyllables += countSyllablesInWord(cleaned);

				if (cleaned.length >= 2 && !STOP_WORDS.has(cleaned) && !/^\d+$/.test(cleaned)) {
					freqMap.set(cleaned, (freqMap.get(cleaned) || 0) + 1);
				}
			}

			if (cjkMatches) {
				for (const char of cjkMatches) {
					totalSyllables += 1;
					freqMap.set(char, (freqMap.get(char) || 0) + 1);
				}
			}

			const readabilityStr = calculateReadability(wordCount, sentenceCount, totalSyllables);

			// Format strings
			const wordsFormatted = wordCount.toLocaleString();
			const charsFormatted = charsWithSpaces.toLocaleString();
			const charsNoSpaceFormatted = charsWithoutSpaces.toLocaleString();
			const sentencesFormatted = sentenceCount.toLocaleString();
			const paragraphsFormatted = paragraphCount.toLocaleString();

			// Left Footer
			if (footerWords) footerWords.textContent = wordsFormatted;
			if (footerChars) footerChars.textContent = charsFormatted;

			// Hero
			if (heroWords) heroWords.textContent = wordsFormatted;
			if (heroChars) heroChars.textContent = charsFormatted;
			if (heroCharsNoSpace) heroCharsNoSpace.textContent = charsNoSpaceFormatted;

			// CJK Sub-badge under Characters
			if (cjkCount > 0) {
				cjkWrapper?.classList.remove('hidden');
				if (cjkCountEl) cjkCountEl.textContent = cjkCount.toLocaleString();
			} else {
				cjkWrapper?.classList.add('hidden');
			}

			// Core Structure & Time
			if (statSentences) statSentences.textContent = sentencesFormatted;
			if (statParagraphs) statParagraphs.textContent = paragraphsFormatted;
			if (statReadingTime) statReadingTime.textContent = readingTimeStr;
			if (statSpeakingTime) statSpeakingTime.textContent = speakingTimeStr;
			if (statPages) statPages.textContent = pagesStr;
			if (statReadability) statReadability.textContent = readabilityStr;

			// Platform Limits
			updateLimitRow(charsWithSpaces, 60, limitNumTitle, limitLabelTitle, limitBarTitle);
			updateLimitRow(charsWithSpaces, 160, limitNumMeta, limitLabelMeta, limitBarMeta);
			updateLimitRow(charsWithSpaces, 280, limitNumSocial, limitLabelSocial, limitBarSocial);

			// Word Goal
			updateGoal(wordCount);

			// Top Keywords calculation
			const sortedEntries = [...freqMap.entries()]
				.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
				.slice(0, 8);

			topKeywordsList = sortedEntries.map(([word, count]) => ({
				word,
				count,
				density: wordCount > 0 ? ((count / wordCount) * 100).toFixed(1) : '0.0',
			}));

			if (keywordsList && keywordsEmpty) {
				if (topKeywordsList.length === 0) {
					keywordsEmpty.classList.remove('hidden');
					keywordsList.classList.add('hidden');
					keywordsList.classList.remove('grid');
					keywordsList.innerHTML = '';
				} else {
					keywordsEmpty.classList.add('hidden');
					keywordsList.classList.remove('hidden');
					keywordsList.classList.add('grid');
					keywordsList.innerHTML = '';
					for (const item of topKeywordsList) {
						const li = document.createElement('li');
						li.className =
							'flex items-center justify-between rounded-xl border border-[#afe3d0]/15 bg-white/[0.04] px-3 py-1.5 text-[12px]';

						const wordSpan = document.createElement('span');
						wordSpan.className = 'font-medium text-white';
						wordSpan.textContent = item.word;

						const metaSpan = document.createElement('span');
						metaSpan.className = 'text-white/70 tabular-nums text-[11px]';
						metaSpan.innerHTML = `<span class="font-semibold text-[#afe3d0]">${item.count}</span> &middot; ${item.density}%`;

						li.appendChild(wordSpan);
						li.appendChild(metaSpan);
						keywordsList.appendChild(li);
					}
				}
			}

			// Summary string for clipboard
			currentSummary = `Words: ${wordsFormatted} | Characters: ${charsFormatted} (No spaces: ${charsNoSpaceFormatted}) | Sentences: ${sentencesFormatted} | Paragraphs: ${paragraphsFormatted} | Reading Time: ${readingTimeStr} | Speaking Time: ${speakingTimeStr}`;
		}

		// Event Listeners
		textarea?.addEventListener('input', updateMetrics);
		goalInput?.addEventListener('input', () => {
			const raw = textarea ? textarea.value : '';
			const trimmed = raw.trim();
			const wordTokens = trimmed ? trimmed.split(/\s+/).filter(Boolean) : [];
			const cjkMatches = raw.match(/[\u4e00-\u9fff\u3040-\u30ff]/g);
			const totalWords = wordTokens.length + (cjkMatches ? cjkMatches.length : 0);
			updateGoal(totalWords);
		});

		// Tabs Switching
		function switchTab(target: 'stats' | 'keywords') {
			if (target === 'stats') {
				tabStats?.classList.add('bg-[#afe3d0]', 'text-[#0f2e26]', 'font-semibold');
				tabStats?.classList.remove('bg-transparent', 'text-white/70', 'font-medium');
				tabStats?.setAttribute('aria-selected', 'true');

				tabKeywords?.classList.add('bg-transparent', 'text-white/70', 'font-medium');
				tabKeywords?.classList.remove('bg-[#afe3d0]', 'text-[#0f2e26]', 'font-semibold');
				tabKeywords?.setAttribute('aria-selected', 'false');

				viewStats?.classList.remove('hidden');
				viewKeywords?.classList.add('hidden');
				viewKeywords?.classList.remove('flex');
			} else {
				tabKeywords?.classList.add('bg-[#afe3d0]', 'text-[#0f2e26]', 'font-semibold');
				tabKeywords?.classList.remove('bg-transparent', 'text-white/70', 'font-medium');
				tabKeywords?.setAttribute('aria-selected', 'true');

				tabStats?.classList.add('bg-transparent', 'text-white/70', 'font-medium');
				tabStats?.classList.remove('bg-[#afe3d0]', 'text-[#0f2e26]', 'font-semibold');
				tabStats?.setAttribute('aria-selected', 'false');

				viewKeywords?.classList.remove('hidden');
				viewKeywords?.classList.add('flex');
				viewStats?.classList.add('hidden');
			}
		}

		tabStats?.addEventListener('click', () => switchTab('stats'));
		tabKeywords?.addEventListener('click', () => switchTab('keywords'));

		// Paste from Clipboard
		btnPaste?.addEventListener('click', async () => {
			try {
				const text = await navigator.clipboard.readText();
				if (text && textarea) {
					textarea.value = text;
					updateMetrics();
					const original = btnPaste.textContent;
					btnPaste.textContent = 'Pasted!';
					setTimeout(() => {
						btnPaste.textContent = original;
					}, 1500);
				}
			} catch {
				textarea?.focus();
			}
		});

		// Clean Extra Spaces Action
		btnCleanSpaces?.addEventListener('click', () => {
			if (!textarea || !textarea.value) return;
			const cleaned = textarea.value
				.split('\n')
				.map((line) => line.replace(/[ \t]+/g, ' ').trim())
				.join('\n')
				.replace(/\n{3,}/g, '\n\n')
				.trim();
			textarea.value = cleaned;
			updateMetrics();

			const original = btnCleanSpaces.textContent;
			btnCleanSpaces.textContent = 'Cleaned!';
			setTimeout(() => {
				btnCleanSpaces.textContent = original;
			}, 1500);
		});

		// Upload File
		fileInput?.addEventListener('change', () => {
			const file = fileInput.files?.[0];
			if (!file) return;
			const reader = new FileReader();
			reader.onload = (e) => {
				const content = typeof e.target?.result === 'string' ? e.target.result : '';
				if (textarea) {
					textarea.value = content;
					updateMetrics();
				}
			};
			reader.readAsText(file);
			fileInput.value = '';
		});

		// Copy Text
		btnCopyText?.addEventListener('click', async () => {
			const text = textarea?.value ?? '';
			if (!text) return;
			try {
				await navigator.clipboard.writeText(text);
			} catch {
				textarea?.select();
				document.execCommand('copy');
			}
			const original = btnCopyText.textContent;
			btnCopyText.textContent = 'Copied!';
			setTimeout(() => {
				btnCopyText.textContent = original;
			}, 1500);
		});

		// Clear Text
		btnClear?.addEventListener('click', () => {
			if (textarea) {
				textarea.value = '';
				textarea.focus();
				updateMetrics();
			}
		});

		// Copy Keywords
		btnCopyKeywords?.addEventListener('click', async () => {
			if (topKeywordsList.length === 0) return;
			const text = topKeywordsList
				.map((k, i) => `${i + 1}. ${k.word} — ${k.count}× (${k.density}%)`)
				.join('\n');
			try {
				await navigator.clipboard.writeText(text);
			} catch {
				const temp = document.createElement('textarea');
				temp.value = text;
				document.body.appendChild(temp);
				temp.select();
				document.execCommand('copy');
				document.body.removeChild(temp);
			}
			const original = btnCopyKeywords.textContent;
			btnCopyKeywords.textContent = 'Copied!';
			setTimeout(() => {
				btnCopyKeywords.textContent = original;
			}, 1500);
		});

		// Copy Summary
		btnCopySummary?.addEventListener('click', async () => {
			if (!currentSummary) updateMetrics();
			try {
				await navigator.clipboard.writeText(currentSummary);
			} catch {
				const temp = document.createElement('textarea');
				temp.value = currentSummary;
				document.body.appendChild(temp);
				temp.select();
				document.execCommand('copy');
				document.body.removeChild(temp);
			}
			const original = btnCopySummary.textContent;
			btnCopySummary.textContent = 'Copied!';
			setTimeout(() => {
				btnCopySummary.textContent = original;
			}, 1500);
		});

		updateMetrics();
	}

	initWordCounterTool();
	document.addEventListener('astro:page-load', initWordCounterTool);
</script>
