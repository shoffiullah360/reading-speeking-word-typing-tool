				rsvpDisplay.classList.remove(
					'text-[18px]',
					'sm:text-[20px]',
					'text-[20px]',
					'sm:text-[24px]',
					'text-[24px]',
					'sm:text-[28px]',
					'text-[22px]',
					'sm:text-[26px]',
					'text-[28px]',
					'sm:text-[34px]',
					'text-[34px]',
					'sm:text-[42px]',
				);
				if (rsvpChunkMode === 'sentence') {
					if (fontSizeMode === 'sm') {
						rsvpDisplay.classList.add('text-[18px]', 'sm:text-[20px]');
					} else if (fontSizeMode === 'lg') {
						rsvpDisplay.classList.add('text-[24px]', 'sm:text-[28px]');
					} else {
						rsvpDisplay.classList.add('text-[20px]', 'sm:text-[24px]');
					}
				} else {
					if (fontSizeMode === 'sm') {
						rsvpDisplay.classList.add('text-[22px]', 'sm:text-[26px]');
					} else if (fontSizeMode === 'lg') {
						rsvpDisplay.classList.add('text-[34px]', 'sm:text-[42px]');
					} else {
						rsvpDisplay.classList.add('text-[28px]', 'sm:text-[34px]');
					}
				}
			}

			// Sync all font-size buttons across Setup and Read windows
			fontBtns.forEach((b) => {
				const active = b.dataset.fontSize === fontSizeMode;
				const isSetupBtn = b.textContent?.includes(' ');
				const borderClasses = b.dataset.fontSize === 'md' ? 'border-x border-hairline ' : '';
				const textScale =
					b.dataset.fontSize === 'sm'
						? 'text-[12px]'
						: b.dataset.fontSize === 'lg'
							? 'text-[14px]'
							: 'text-[13px]';
				if (isSetupBtn) {
					b.className = active
						? `rst-font-btn flex-1 cursor-pointer ${borderClasses}bg-[#0f2e26] py-2 ${textScale} font-medium text-[#afe3d0] transition-colors dark:bg-[#afe3d0] dark:text-[#0f2e26]`
						: `rst-font-btn flex-1 cursor-pointer ${borderClasses}py-2 ${textScale} font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink`;
				} else {
					b.className = active
						? `rst-font-btn cursor-pointer ${borderClasses}bg-[#0f2e26] px-2.5 py-1 ${textScale} font-medium text-[#afe3d0] transition-colors dark:bg-[#afe3d0] dark:text-[#0f2e26]`
						: `rst-font-btn cursor-pointer ${borderClasses}px-2.5 py-1 ${textScale} font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink`;
				}
			});
		}

		function renderSetupWindow() {
			const active = getActivePassage();
			const words = countPassageWords(active.paragraphs);

			if (currentDifficulty === 'custom') {
				setupPassageCard?.classList.add('hidden');
				setupCustomCard?.classList.remove('hidden');
				if (quizLengthSelect) {
					quizLengthSelect.disabled = true;
				}
			} else {
				setupPassageCard?.classList.remove('hidden');
				setupCustomCard?.classList.add('hidden');
				if (quizLengthSelect) {
					quizLengthSelect.disabled = false;
				}
				if (setupPassageMeta) {
					setupPassageMeta.textContent = `${active.topic} · Passage ${active.indexInDiff} of ${active.totalInDiff} · ${words} words`;
				}
				if (setupPassageTitle) {
					setupPassageTitle.textContent = active.title;
				}
			}

			const qCount = getEffectiveQuizCount();
			const modeLabel = currentMode === 'rsvp' ? `RSVP Trainer (${rsvpTargetWpm} WPM)` : 'Standard Test';
			const quizLabel = qCount === 0 ? 'Speed only (no quiz)' : `${qCount}-question memory quiz`;
			if (setupSummaryLine) {
				setupSummaryLine.textContent = `${modeLabel} · ${words} words · ${quizLabel}`;
			}
		}

		function buildRsvpUnits() {
			const active = getActivePassage();
			const fullText = active.paragraphs.join(' ').trim();
			if (!fullText) {
				rsvpUnits = [];
				rsvpUnitWordCounts = [];
				return;
			}
			if (rsvpChunkMode === 'word') {
				rsvpUnits = fullText.split(/\s+/);
				rsvpUnitWordCounts = rsvpUnits.map(() => 1);
			} else {
				const sentences = fullText
					.split(/(?<=[.!?])\s+/)
					.map((s) => s.trim())
					.filter(Boolean);
				rsvpUnits = sentences.length > 0 ? sentences : [fullText];
				rsvpUnitWordCounts = rsvpUnits.map((s) => countWords(s));
			}
		}

		function updateRsvpProgressUI() {
			const totalWords = rsvpUnitWordCounts.reduce((a, b) => a + b, 0);
			const wordsDone = rsvpUnitWordCounts
				.slice(0, rsvpCurrentIndex)
				.reduce((a, b) => a + b, 0);
			const pct = totalWords > 0 ? Math.min(100, Math.round((wordsDone / totalWords) * 100)) : 0;

			if (rsvpProgressLabel) {
				rsvpProgressLabel.textContent = `${wordsDone} / ${totalWords} words`;
			}
			if (rsvpProgressBar) {
				rsvpProgressBar.style.width = `${pct}%`;
			}
			const wordsLeft = Math.max(0, totalWords - wordsDone);
			const secsLeft = Math.ceil((wordsLeft / rsvpTargetWpm) * 60);
			const mins = Math.floor(secsLeft / 60);
			const secs = String(secsLeft % 60).padStart(2, '0');
			if (rsvpTimeRemaining) {
				rsvpTimeRemaining.textContent = `~${mins}:${secs} at ${rsvpTargetWpm} WPM`;
			}
		}

		function stepRsvp() {
			if (!rsvpRunning) return;
			if (rsvpCurrentIndex >= rsvpUnits.length) {
				stopRsvpTimer();
				finishRsvpSession();
				return;
			}

			const currentUnit = rsvpUnits[rsvpCurrentIndex];
			const unitWords = rsvpUnitWordCounts[rsvpCurrentIndex] || 1;
			if (rsvpDisplay) {
				rsvpDisplay.textContent = currentUnit;
			}
			rsvpCurrentIndex += 1;
			updateRsvpProgressUI();

			const delayMs = Math.max(60, Math.round((unitWords * 60000) / rsvpTargetWpm));
			rsvpTimeoutId = window.setTimeout(stepRsvp, delayMs);
		}

		function startReadingWindow() {
			// Validate custom text if selected
			if (currentDifficulty === 'custom') {
				const raw = customTextarea?.value.trim() || '';
				const wc = countWords(raw);
				if (wc < 10) {
					if (customHint) {
						customHint.textContent = 'Please paste or type at least 10 words before starting.';
						customHint.className = 'mt-2 text-[12px] font-medium text-vercel-error';
					}
					customTextarea?.focus();
					return;
				}
				customParagraphs = raw
					.split(/\n+/)
					.map((p) => p.trim())
					.filter(Boolean);
			}

			stopStandardTimer();
			stopRsvpTimer();

			const active = getActivePassage();
			const words = countPassageWords(active.paragraphs);

			if (readWordBadge) readWordBadge.textContent = `${words} words`;
			if (readTopic) readTopic.textContent = active.topic;
			if (readTitle) readTitle.textContent = active.title;
			if (rsvpTitle) rsvpTitle.textContent = active.title;
			if (readParagraphs) {
				readParagraphs.innerHTML = active.paragraphs.map((p) => `<p>${p}</p>`).join('');
			}

			applyFontSize();
			setWizardStep('read');

			startTimeMs = performance.now();
			elapsedMs = 0;
			if (liveTimer) liveTimer.textContent = '00:00.0';

			timerInterval = window.setInterval(() => {
				elapsedMs = performance.now() - startTimeMs;
				if (liveTimer) liveTimer.textContent = formatStopwatch(elapsedMs);
			}, 100);

			if (currentMode === 'standard') {
				readStandardCanvas?.classList.remove('hidden');
				readRsvpCanvas?.classList.add('hidden');
			} else {
				readStandardCanvas?.classList.add('hidden');
				readRsvpCanvas?.classList.remove('hidden');
				buildRsvpUnits();
				rsvpCurrentIndex = 0;
				rsvpRunning = true;
				if (rsvpPlayBtn) {
					const span = rsvpPlayBtn.querySelector('span');
					if (span) span.textContent = 'Pause';
				}
				updateRsvpProgressUI();
				stepRsvp();
			}
		}

		function finishStandardReading() {
			stopStandardTimer();
			elapsedMs = Math.max(1200, performance.now() - startTimeMs);
			const active = getActivePassage();
			const words = countPassageWords(active.paragraphs);
			const minutes = elapsedMs / 60000;
			rawWpm = Math.max(40, Math.min(1500, Math.round(words / minutes)));

			proceedAfterReading();
		}

		function finishRsvpSession() {
			stopStandardTimer();
			stopRsvpTimer();
			const active = getActivePassage();
			const words = countPassageWords(active.paragraphs);
			rawWpm = rsvpTargetWpm;
			elapsedMs = Math.round((words / rsvpTargetWpm) * 60000);

			proceedAfterReading();
		}

		function proceedAfterReading() {
			const qCount = getEffectiveQuizCount();
			if (qCount === 0) {
				// Automatically skip Step 3 (Quiz) if No Quiz or Custom Text was selected
				accuracyPct = null;
				effectiveWpm = rawWpm;
				renderResultsWindow();
				setWizardStep('results');
			} else {
				userAnswers = new Array(qCount).fill(null);
				renderQuizWindow();
				setWizardStep('quiz');
			}
		}

		function renderQuizWindow() {
			const active = getActivePassage();
			const qCount = getEffectiveQuizCount();
			const questions = active.questions.slice(0, qCount);

			if (quizSpeedPill) {
				quizSpeedPill.textContent = `Raw speed recorded: ${rawWpm} WPM`;
			}
			if (quizHeading) {
				quizHeading.textContent = `${qCount}-question memory check`;
			}

			if (!quizQuestionsList) return;
			quizQuestionsList.innerHTML = '';

			questions.forEach((q, qIdx) => {
				const card = document.createElement('div');
				card.className = 'rounded-2xl border border-hairline bg-canvas p-5';

				const title = document.createElement('p');
				title.className = 'text-[14px] font-semibold text-ink';
				title.textContent = `${qIdx + 1}. ${q.question}`;
				card.appendChild(title);

				const optionsWrap = document.createElement('div');
				optionsWrap.className = 'mt-3.5 space-y-2';

				const selectedAnswer = userAnswers[qIdx];

				q.options.forEach((optText, oIdx) => {
					const btn = document.createElement('button');
					btn.type = 'button';
					const isChosen = selectedAnswer === oIdx;

					btn.className = isChosen
						? 'w-full cursor-pointer rounded-xl border border-[#0f2e26] bg-[#0f2e26] px-4 py-3 text-left text-[13px] font-semibold text-[#afe3d0] transition-colors flex items-center justify-between gap-2 dark:border-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]'
						: 'w-full cursor-pointer rounded-xl border border-hairline bg-canvas-elevated px-4 py-3 text-left text-[13px] text-body transition-colors hover:border-ink hover:text-ink flex items-center justify-between gap-2';

					const span = document.createElement('span');
					span.textContent = optText;
					btn.appendChild(span);

					btn.addEventListener('click', () => {
						userAnswers[qIdx] = oIdx;
						renderQuizWindow();
					});

					optionsWrap.appendChild(btn);
				});

				card.appendChild(optionsWrap);
				quizQuestionsList.appendChild(card);
			});

			const answeredCount = userAnswers.filter((a) => a !== null).length;
			if (quizProgressBadge) {
				quizProgressBadge.textContent = `${answeredCount} of ${qCount} selected`;
			}
			if (btnSubmitQuiz) {
				btnSubmitQuiz.disabled = answeredCount < qCount;
			}
			if (quizHelperMsg) {
				quizHelperMsg.textContent =
					answeredCount < qCount
						? `Select ${qCount - answeredCount} more ${qCount - answeredCount === 1 ? 'answer' : 'answers'} to view your results.`
						: 'All questions answered. Click Submit & View Results.';
			}
		}

		function submitQuizAndShowResults() {
			const active = getActivePassage();
			const qCount = getEffectiveQuizCount();
			const questions = active.questions.slice(0, qCount);
			const correctCount = questions.reduce((acc, q, idx) => {
				return acc + (userAnswers[idx] === q.correctIndex ? 1 : 0);
			}, 0);

			const accuracy = correctCount / qCount;
			accuracyPct = Math.round(accuracy * 100);
			effectiveWpm = Math.round(rawWpm * accuracy);

			renderResultsWindow();
			setWizardStep('results');
		}

		function updateAgeComparisonAndBooksUI() {
			const ageKey = ageSelect?.value || '25-34';
			const ageInfo = AGE_BENCHMARKS[ageKey] || AGE_BENCHMARKS['25-34'];
			const peerAvg = ageInfo.avgWpm;

			if (ageBenchmarkLabel) {
				ageBenchmarkLabel.textContent = `${peerAvg} WPM (${ageInfo.label} avg)`;
			}
			const markerPct = Math.max(5, Math.min(95, ((peerAvg - 100) / 400) * 100));
			if (ageMarker) {
				ageMarker.style.left = `${markerPct}%`;
			}

			const diff = rawWpm - peerAvg;
			const pctDiff = Math.round((Math.abs(diff) / peerAvg) * 100);
			const clamped = Math.max(100, Math.min(500, rawWpm));
			const barPct = ((clamped - 100) / 400) * 100;
			if (speedProgress) {
				speedProgress.style.width = `${Math.max(4, Math.min(100, barPct))}%`;
			}
			if (comparisonDetail) {
				if (diff === 0) {
					comparisonDetail.innerHTML = `Your reading rate of <strong class="font-semibold text-ink tabular-nums">${rawWpm} WPM</strong> matches the <strong class="font-semibold text-ink tabular-nums">${peerAvg} WPM</strong> benchmark for ${ageInfo.label}.`;
				} else if (diff > 0) {
					comparisonDetail.innerHTML = `At <strong class="font-semibold text-ink tabular-nums">${rawWpm} WPM</strong>, you read <strong class="font-semibold text-ink tabular-nums">${diff} WPM faster</strong> (+${pctDiff}%) than the ${ageInfo.label} benchmark (${peerAvg} WPM).`;
				} else {
					comparisonDetail.innerHTML = `At <strong class="font-semibold text-ink tabular-nums">${rawWpm} WPM</strong>, you are <strong class="font-semibold text-ink tabular-nums">${Math.abs(diff)} WPM below</strong> (${pctDiff}% slower than) the ${ageInfo.label} benchmark (${peerAvg} WPM).`;
				}
			}

			// Books a Year calculation
			const activeSpeed = effectiveWpm > 0 ? effectiveWpm : rawWpm > 0 ? rawWpm : 238;
			const dailyMins = Math.max(1, Math.min(600, Number(dailyMinsInput?.value) || 20));
			const wordsPerYear = activeSpeed * dailyMins * 365;
			const booksPerYear = wordsPerYear / 90000;

			if (booksPerYearOutput) {
				booksPerYearOutput.textContent = `${booksPerYear.toFixed(1)} books / yr`;
			}
			if (booksPerYearSub) {
				booksPerYearSub.textContent = `At ${activeSpeed} WPM pace · ~${Math.round(wordsPerYear).toLocaleString()} words/year`;
			}
		}

		function renderResultsWindow() {
			const active = getActivePassage();
			const words = countPassageWords(active.paragraphs);
			const secondsRounded = (elapsedMs / 1000).toFixed(1);
			const qCount = getEffectiveQuizCount();

			if (resRawWpm) resRawWpm.textContent = rawWpm.toLocaleString();
			if (resRawSub) resRawSub.textContent = `${words} words in ${secondsRounded}s`;

			if (qCount === 0 || accuracyPct === null) {
				if (resCompPct) resCompPct.textContent = 'Speed only';
				if (resCompSub) resCompSub.textContent = 'Quiz bypassed';
				if (resEffectiveWpm) resEffectiveWpm.textContent = rawWpm.toLocaleString();
				if (resEffectiveSub) resEffectiveSub.textContent = 'Unadjusted speed-only WPM';
			} else {
				const questions = active.questions.slice(0, qCount);
				const correctCount = questions.reduce((acc, q, idx) => {
					return acc + (userAnswers[idx] === q.correctIndex ? 1 : 0);
				}, 0);
				if (resCompPct) resCompPct.textContent = `${accuracyPct}%`;
				if (resCompSub) resCompSub.textContent = `${correctCount} of ${qCount} correct`;
				if (resEffectiveWpm) resEffectiveWpm.textContent = effectiveWpm.toLocaleString();
				if (resEffectiveSub) resEffectiveSub.textContent = `${rawWpm} WPM × ${accuracyPct}% accuracy`;
			}

			const { percentile, profile } = computeAdultPercentileAndProfile(rawWpm);
			if (resProfile) resProfile.textContent = profile;
			if (resPercentile) {
				resPercentile.textContent = `Faster than ${percentile}% of adult readers · ${profile}`;
			}

			if (skimWarning) {
				skimWarning.classList.toggle('hidden', rawWpm <= 700);
			}

			updateAgeComparisonAndBooksUI();

			// Render Answer Review
			if (answerReviewCard && answerReviewList) {
				if (qCount === 0) {
					answerReviewCard.classList.add('hidden');
				} else {
					answerReviewCard.classList.remove('hidden');
					const questions = active.questions.slice(0, qCount);
					const correctCount = questions.reduce((acc, q, idx) => {
						return acc + (userAnswers[idx] === q.correctIndex ? 1 : 0);
					}, 0);
					if (reviewSummaryBadge) {
						reviewSummaryBadge.textContent = `${correctCount} of ${qCount} correct (${accuracyPct}%)`;
					}
					answerReviewList.innerHTML = '';

					questions.forEach((q, qIdx) => {
						const chosenIdx = userAnswers[qIdx];
						const isCorrect = chosenIdx === q.correctIndex;
						const chosenText = chosenIdx !== null ? q.options[chosenIdx] : 'No answer';
						const correctText = q.options[q.correctIndex];

						const item = document.createElement('div');
						item.className = 'rounded-2xl border border-hairline bg-canvas p-4 sm:p-5';

						const headerRow = document.createElement('div');
						headerRow.className = 'flex items-start justify-between gap-3';

						const qTitle = document.createElement('p');
						qTitle.className = 'text-[13px] font-semibold text-ink';
						qTitle.textContent = `${qIdx + 1}. ${q.question}`;
						headerRow.appendChild(qTitle);

						const badge = document.createElement('span');
						badge.className = isCorrect
							? 'shrink-0 rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700 dark:text-emerald-400'
							: 'shrink-0 rounded-full bg-vercel-error/15 px-2.5 py-0.5 text-[11px] font-semibold text-vercel-error';
						badge.textContent = isCorrect ? 'Correct' : 'Incorrect';
						headerRow.appendChild(badge);
						item.appendChild(headerRow);

						const detail = document.createElement('div');
						detail.className = 'mt-2 space-y-1 text-[12px]';
						if (isCorrect) {
							detail.innerHTML = `<p class="text-body">Your answer: <strong class="font-medium text-ink">${chosenText}</strong></p>`;
						} else {
							detail.innerHTML = `
								<p class="text-vercel-error">Your answer: <strong class="font-medium">${chosenText}</strong></p>
								<p class="text-body">Correct answer: <strong class="font-medium text-ink">${correctText}</strong></p>
							`;
						}
						item.appendChild(detail);

						const exp = document.createElement('p');
						exp.className = 'mt-2 border-t border-hairline pt-2 text-[12px] text-mute';
						exp.textContent = q.explanation;
						item.appendChild(exp);

						answerReviewList.appendChild(item);
					});
				}
			}

			// Save to localStorage (Last 10 tests)
			saveTestResultToHistory({
				title: active.title,
				difficultyLabel: active.difficultyLabel,
				rawWpm,
				accuracyPct,
				effectiveWpm,
				timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
			});
		}

		function loadHistoryFromStorage(): SavedTestRecord[] {
			try {
				const raw = window.localStorage.getItem(STORAGE_KEY);
				if (!raw) return [];
				const parsed = JSON.parse(raw);
				if (!Array.isArray(parsed)) return [];
				return parsed.slice(0, 10);
			} catch {
				return [];
			}
		}

		function saveTestResultToHistory(record: SavedTestRecord) {
			try {
				const existing = loadHistoryFromStorage();
				const updated = [record, ...existing].slice(0, 10);
				window.localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
				updateHistoryBadgeCount();
			} catch {
				// ignore storage quota errors
			}
		}

		function updateHistoryBadgeCount() {
			const records = loadHistoryFromStorage();
			if (historyCountBadge) {
				historyCountBadge.textContent = String(records.length);
			}
		}

		function renderHistoryTable() {
			const records = loadHistoryFromStorage();
			updateHistoryBadgeCount();

			if (!historyEmpty || !historyTableWrap || !historyTbody || !historyTfoot) return;

			if (records.length === 0) {
				historyEmpty.classList.remove('hidden');
				historyTableWrap.classList.add('hidden');
				historyTbody.innerHTML = '';
				historyTfoot.innerHTML = '';
				return;
			}

			historyEmpty.classList.add('hidden');
			historyTableWrap.classList.remove('hidden');

			historyTbody.innerHTML = records
				.map((r) => {
					const compLabel = r.accuracyPct !== null ? `${r.accuracyPct}%` : 'Speed only';
					return `
						<tr>
							<td class="py-2.5 pr-4">
								<div class="font-medium text-ink">${r.title}</div>
								<div class="text-[11px] text-mute">${r.difficultyLabel}</div>
							</td>
							<td class="px-3 py-2.5 font-medium text-ink tabular-nums">${r.rawWpm} WPM</td>
							<td class="px-3 py-2.5 tabular-nums">${compLabel}</td>
							<td class="px-3 py-2.5 font-medium text-ink tabular-nums">${r.effectiveWpm} WPM</td>
							<td class="py-2.5 pl-3 text-right text-mute tabular-nums">${r.timestamp}</td>
						</tr>
					`;
				})
				.join('');

			const avgRawWpm = Math.round(
				records.reduce((acc, r) => acc + r.rawWpm, 0) / records.length,
			);
			const avgEffectiveWpm = Math.round(
				records.reduce((acc, r) => acc + r.effectiveWpm, 0) / records.length,
			);
			const withQuiz = records.filter((r) => r.accuracyPct !== null);
			const avgAccLabel =
				withQuiz.length > 0
					? `${Math.round(withQuiz.reduce((acc, r) => acc + (r.accuracyPct ?? 0), 0) / withQuiz.length)}%`
					: '—';

			historyTfoot.innerHTML = `
				<tr>
					<td class="py-2.5 pr-4 font-semibold text-ink">Average (${records.length} ${records.length === 1 ? 'test' : 'tests'})</td>
					<td class="px-3 py-2.5 font-semibold text-ink tabular-nums">${avgRawWpm} WPM</td>
					<td class="px-3 py-2.5 font-semibold text-ink tabular-nums">${avgAccLabel}</td>
					<td class="px-3 py-2.5 font-semibold text-ink tabular-nums">${avgEffectiveWpm} WPM</td>
					<td class="py-2.5 pl-3 text-right text-mute">—</td>
				</tr>
			`;
		}

		// Event Listeners — Top Stepper & Past Results Tab
		stepSetupIndicator?.addEventListener('click', () => {
			stopStandardTimer();
			stopRsvpTimer();
			renderSetupWindow();
			setWizardStep('setup');
		});

		tabHistoryBtn?.addEventListener('click', () => {
			if (activeView === 'history') {
				setWizardStep(currentStep);
			} else {
				showHistoryView();
			}
		});

		btnBackToTest?.addEventListener('click', () => {
			setWizardStep(currentStep);
		});

		// Event Listeners — Window 1 (Setup)
		modeBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				currentMode = (btn.dataset.mode as 'standard' | 'rsvp') || 'standard';
				modeBtns.forEach((b) => {
					const active = b.dataset.mode === currentMode;
					b.setAttribute('aria-selected', active ? 'true' : 'false');
					b.className = active
						? 'rst-mode-btn cursor-pointer rounded-full bg-[#afe3d0] px-4 py-1.5 text-[13px] font-semibold text-[#0f2e26] transition-all'
						: 'rst-mode-btn cursor-pointer rounded-full bg-transparent px-4 py-1.5 text-[13px] font-medium text-body transition-all hover:text-ink';
				});
				renderSetupWindow();
			});
		});

		diffBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				currentDifficulty = (btn.dataset.difficulty as DifficultyKey | 'custom') || 'beginner';
				diffBtns.forEach((b) => {
					const active = b.dataset.difficulty === currentDifficulty;
					b.setAttribute('aria-selected', active ? 'true' : 'false');
					b.className = active
						? 'rst-diff-btn cursor-pointer rounded-full bg-[#0f2e26] px-3.5 py-1.5 text-[13px] font-medium text-[#afe3d0] transition-all tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]'
						: 'rst-diff-btn cursor-pointer rounded-full bg-transparent px-3.5 py-1.5 text-[13px] font-medium text-body transition-all hover:text-ink tabular-nums';
				});
				renderSetupWindow();
			});
		});

		btnShuffle?.addEventListener('click', () => {
			if (currentDifficulty !== 'custom') {
				const matching = PASSAGES.filter((p) => p.difficulty === currentDifficulty);
				passageIndexByDiff[currentDifficulty] =
					(passageIndexByDiff[currentDifficulty] + 1) % matching.length;
				renderSetupWindow();
			}
		});

		customTextarea?.addEventListener('input', () => {
			const wc = countWords(customTextarea.value);
			if (customWordBadge) {
				customWordBadge.textContent = `${wc} ${wc === 1 ? 'word' : 'words'}`;
			}
			if (wc >= 10) {
				customParagraphs = customTextarea.value
					.trim()
					.split(/\n+/)
					.map((p) => p.trim())
					.filter(Boolean);
				if (customHint) {
					customHint.textContent = 'Custom text ready. Click Start Reading Test below.';
					customHint.className = 'mt-2 text-[12px] text-mute';
				}
				renderSetupWindow();
			}
		});

		quizLengthSelect?.addEventListener('change', () => {
			const val = Number(quizLengthSelect.value);
			quizLength = val === 5 ? 5 : val === 0 ? 0 : 3;
			renderSetupWindow();
		});

		fontBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				fontSizeMode = (btn.dataset.fontSize as 'sm' | 'md' | 'lg') || 'md';
				applyFontSize();
			});
		});

		btnStartTest?.addEventListener('click', () => {
			startReadingWindow();
		});

		// Event Listeners — Window 2 (Read & RSVP)
		btnCancelRead?.addEventListener('click', () => {
			stopStandardTimer();
			stopRsvpTimer();
			renderSetupWindow();
			setWizardStep('setup');
		});

		btnFinishReading?.addEventListener('click', () => {
			finishStandardReading();
		});

		rsvpChunkBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				rsvpChunkMode = (btn.dataset.rsvpChunk as 'word' | 'sentence') || 'word';
				rsvpChunkBtns.forEach((b) => {
					const active = b.dataset.rsvpChunk === rsvpChunkMode;
					b.className = active
						? 'rst-rsvp-chunk-btn cursor-pointer rounded-full bg-[#0f2e26] px-3.5 py-1 text-[12px] font-medium text-[#afe3d0] transition-colors dark:bg-[#afe3d0] dark:text-[#0f2e26]'
						: 'rst-rsvp-chunk-btn cursor-pointer rounded-full bg-transparent px-3.5 py-1 text-[12px] font-medium text-body transition-colors hover:text-ink';
				});
				stopRsvpTimer();
				buildRsvpUnits();
				rsvpCurrentIndex = 0;
				applyFontSize();
				updateRsvpProgressUI();
				if (rsvpDisplay) rsvpDisplay.textContent = rsvpUnits[0] || 'Ready';
			});
		});

		rsvpWpmSlider?.addEventListener('input', () => {
			rsvpTargetWpm = Number(rsvpWpmSlider.value) || 300;
			if (rsvpWpmLabel) rsvpWpmLabel.textContent = `${rsvpTargetWpm} WPM`;
			updateRsvpProgressUI();
		});

		rsvpPlayBtn?.addEventListener('click', () => {
			if (rsvpRunning) {
				stopRsvpTimer();
				return;
			}
			if (rsvpCurrentIndex >= rsvpUnits.length) {
				rsvpCurrentIndex = 0;
			}
			rsvpRunning = true;
			const span = rsvpPlayBtn.querySelector('span');
			if (span) span.textContent = 'Pause';
			stepRsvp();
		});

		rsvpRestartBtn?.addEventListener('click', () => {
			stopRsvpTimer();
			rsvpCurrentIndex = 0;
			updateRsvpProgressUI();
			rsvpRunning = true;
			if (rsvpPlayBtn) {
				const span = rsvpPlayBtn.querySelector('span');
				if (span) span.textContent = 'Pause';
			}
			stepRsvp();
		});

		rsvpFinishBtn?.addEventListener('click', () => {
			finishRsvpSession();
		});

		// Event Listeners — Window 3 (Quiz)
		btnSubmitQuiz?.addEventListener('click', () => {
			submitQuizAndShowResults();
		});

		// Event Listeners — Window 4 (Results)
		ageSelect?.addEventListener('change', updateAgeComparisonAndBooksUI);
		dailyMinsInput?.addEventListener('input', updateAgeComparisonAndBooksUI);

		btnTakeAnother?.addEventListener('click', () => {
			if (currentDifficulty !== 'custom') {
				const matching = PASSAGES.filter((p) => p.difficulty === currentDifficulty);
				passageIndexByDiff[currentDifficulty] =
					(passageIndexByDiff[currentDifficulty] + 1) % matching.length;
			}
			renderSetupWindow();
			setWizardStep('setup');
		});

		btnCopyResult?.addEventListener('click', async () => {
			const { percentile, profile } = computeAdultPercentileAndProfile(rawWpm);
			const summaryText = `Reading Speed Test (Wordora): ${rawWpm} WPM Raw · ${effectiveWpm} Effective WPM · ${profile} (faster than ${percentile}% of adult readers) — https://wordora.site/reading-speed-test/`;
			try {
				await navigator.clipboard.writeText(summaryText);
				if (btnCopyResult) {
					const prev = btnCopyResult.textContent;
					btnCopyResult.textContent = 'Copied!';
					window.setTimeout(() => {
						btnCopyResult.textContent = prev || 'Copy Result';
					}, 1800);
				}
			} catch {
				// fallback ignored
			}
		});

		// Event Listeners — History
		btnClearHistory?.addEventListener('click', () => {
			try {
				window.localStorage.removeItem(STORAGE_KEY);
			} catch {
				// ignore
			}
			renderHistoryTable();
		});

		// Initial Boot
		updateHistoryBadgeCount();
		applyFontSize();
		renderSetupWindow();
		setWizardStep('setup');
	}

	initReadingSpeedWizard();
</script>
