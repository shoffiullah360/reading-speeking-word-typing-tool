---
import { getToolById, resolveCanonicalUrl } from '../config/site';
import {
	getLocaleFromUrl,
	getLocalizedPath,
	useTranslations,
	type Locale,
} from '../i18n/ui';

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const readingCounterTool = getToolById('reading-time-calculator');
const audiobookTool = getToolById('audiobook-speed-calculator') || getToolById('audiobook-calculator');
const speechTool = getToolById('speech-time-calculator');

interface QuizQuestion {
	question: string;
	options: string[];
	correctIndex: number;
	explanation: string;
}

interface PassageItem {
	id: string;
	difficulty: 'beginner' | 'intermediate' | 'challenge';
	difficultyLabel: string;
	topic: string;
	title: string;
	paragraphs: string[];
	questions: QuizQuestion[];
}

const passages = t.raw<PassageItem[]>('readingSpeedTest.passages') ?? [];
const clientStrings = t.raw<Record<string, unknown>>('readingSpeedTest.client') ?? {};

const beginnerPassages = passages.filter((p) => p.difficulty === 'beginner');
const firstPassage = beginnerPassages[0] ?? passages[0];
const firstWordCount = firstPassage
	? firstPassage.paragraphs.join(' ').trim().split(/\s+/).filter(Boolean).length
	: 155;
const firstTotalInDiff = beginnerPassages.length || 2;
const firstRsvpSecs = Math.ceil((firstWordCount / 300) * 60);
const firstRsvpMins = Math.floor(firstRsvpSecs / 60);
const firstRsvpSecStr = String(firstRsvpSecs % 60).padStart(2, '0');

const initialPassageMeta = firstPassage
	? t('readingSpeedTest.client.passageMeta', {
			topic: firstPassage.topic,
			index: 1,
			total: firstTotalInDiff,
			words: firstWordCount,
		})
	: '';

const initialSetupSummary = t('readingSpeedTest.client.setupSummary', {
	mode: t('readingSpeedTest.client.modeStandardLabel'),
	words: firstWordCount,
	quiz: t('readingSpeedTest.client.quizCountLabel', { count: 3 }),
});

const initialRsvpProgress = t('readingSpeedTest.client.rsvpProgress', {
	done: 0,
	total: firstWordCount,
});

const initialRsvpRemaining = t('readingSpeedTest.client.rsvpTimeRemaining', {
	mins: firstRsvpMins,
	secs: firstRsvpSecStr,
	wpm: 300,
});

const clientI18n = {
	locale,
	shareUrl: resolveCanonicalUrl(getLocalizedPath('/reading-speed-test/', locale)),
	strings: clientStrings,
	passages,
};
---

<section
	id="reading-speed-test-workspace"
	aria-label={t('readingSpeedTest.ui.workspaceAria')}
	class="mx-auto max-w-[1140px] px-4 pt-4 pb-14 sm:px-6"
>
	<!-- Centered Single-Window Wizard Container -->
	<div class="mx-auto max-w-[840px]">
		<!-- Minimalist Top Header: Subtle Step Trail + Past Results Link -->
		<div class="mb-4 flex flex-wrap items-center justify-between gap-3 px-1">
			<nav
				aria-label={t('readingSpeedTest.ui.stepsNavAria')}
				class="flex flex-wrap items-center gap-1.5 text-[13px]"
			>
				<button
					type="button"
					id="rst-step-indicator-setup"
					data-step-nav="setup"
					class="rst-step-pill cursor-pointer rounded-full bg-[#0f2e26] px-3 py-1 text-[12px] font-semibold text-[#afe3d0] transition-colors tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
				>
					{t('readingSpeedTest.ui.stepSetup')}
				</button>
				<span aria-hidden="true" class="text-[11px] text-faint">→</span>
				<span
					id="rst-step-indicator-read"
					class="rst-step-pill rounded-full bg-transparent px-2.5 py-1 text-[12px] font-medium text-mute transition-colors tabular-nums"
				>
					{t('readingSpeedTest.ui.stepRead')}
				</span>
				<span aria-hidden="true" class="text-[11px] text-faint">→</span>
				<span
					id="rst-step-indicator-quiz"
					class="rst-step-pill rounded-full bg-transparent px-2.5 py-1 text-[12px] font-medium text-mute transition-colors tabular-nums"
				>
					{t('readingSpeedTest.ui.stepQuiz')}
				</span>
				<span aria-hidden="true" class="text-[11px] text-faint">→</span>
				<span
					id="rst-step-indicator-results"
					class="rst-step-pill rounded-full bg-transparent px-2.5 py-1 text-[12px] font-medium text-mute transition-colors tabular-nums"
				>
					{t('readingSpeedTest.ui.stepResults')}
				</span>
			</nav>

			<button
				type="button"
				id="rst-tab-history"
				class="cursor-pointer inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[13px] font-medium text-mute transition-colors hover:bg-hairline-soft hover:text-ink"
			>
				<span>{t('readingSpeedTest.ui.pastResults')}</span>
				<span
					id="rst-history-count-badge"
					class="rounded-full bg-hairline-soft px-2 py-0.5 text-[11px] font-semibold text-ink tabular-nums"
				>
					0
				</span>
			</button>
		</div>

		<!-- ===================================================================== -->
		<!-- WINDOW 1: SETUP (step === 'setup')                                    -->
		<!-- ===================================================================== -->
		<div
			id="rst-window-setup"
			class="whisper-shadow overflow-hidden rounded-3xl border border-hairline bg-canvas-elevated p-6 sm:p-8 lg:p-10"
		>
			<div class="space-y-7">
				<!-- Row 1: Reading Mode + Passage Difficulty in Clean Pill Controls -->
				<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
					<!-- Reading Mode -->
					<div>
						<label class="mb-2 block text-[13px] font-medium text-mute">
							{t('readingSpeedTest.ui.readingModeLabel')}
						</label>
						<div
							role="tablist"
							aria-label={t('readingSpeedTest.ui.readingModeAria')}
							class="inline-flex rounded-full border border-hairline bg-canvas p-1"
						>
							<button
								type="button"
								role="tab"
								aria-selected="true"
								data-mode="standard"
								class="rst-mode-btn cursor-pointer rounded-full bg-[#afe3d0] px-4 py-1.5 text-[13px] font-semibold text-[#0f2e26] transition-all"
							>
								{t('readingSpeedTest.ui.modeStandard')}
							</button>
							<button
								type="button"
								role="tab"
								aria-selected="false"
								data-mode="rsvp"
								class="rst-mode-btn cursor-pointer rounded-full bg-transparent px-4 py-1.5 text-[13px] font-medium text-body transition-all hover:text-ink"
							>
								{t('readingSpeedTest.ui.modeRsvp')}
							</button>
						</div>
					</div>

					<!-- Passage Difficulty -->
					<div>
						<label class="mb-2 block text-[13px] font-medium text-mute">
							{t('readingSpeedTest.ui.difficultyLabel')}
						</label>
						<div
							role="tablist"
							aria-label={t('readingSpeedTest.ui.difficultyAria')}
							class="inline-flex flex-wrap rounded-2xl border border-hairline bg-canvas p-1 sm:rounded-full"
						>
							<button
								type="button"
								role="tab"
								aria-selected="true"
								data-difficulty="beginner"
								class="rst-diff-btn cursor-pointer rounded-full bg-[#0f2e26] px-3.5 py-1.5 text-[13px] font-medium text-[#afe3d0] transition-all tabular-nums dark:bg-[#afe3d0] dark:text-[#0f2e26]"
							>
								{t('readingSpeedTest.ui.diffBeginner')}
							</button>
							<button
								type="button"
								role="tab"
								aria-selected="false"
								data-difficulty="intermediate"
								class="rst-diff-btn cursor-pointer rounded-full bg-transparent px-3.5 py-1.5 text-[13px] font-medium text-body transition-all hover:text-ink tabular-nums"
							>
								{t('readingSpeedTest.ui.diffIntermediate')}
							</button>
							<button
								type="button"
								role="tab"
								aria-selected="false"
								data-difficulty="challenge"
								class="rst-diff-btn cursor-pointer rounded-full bg-transparent px-3.5 py-1.5 text-[13px] font-medium text-body transition-all hover:text-ink tabular-nums"
							>
								{t('readingSpeedTest.ui.diffChallenge')}
							</button>
							<button
								type="button"
								role="tab"
								aria-selected="false"
								data-difficulty="custom"
								class="rst-diff-btn cursor-pointer rounded-full bg-transparent px-3.5 py-1.5 text-[13px] font-medium text-body transition-all hover:text-ink"
							>
								{t('readingSpeedTest.ui.diffCustom')}
							</button>
						</div>
					</div>
				</div>

				<!-- Row 2: Selected Curated Passage Preview Card -->
				<div>
					<div
						id="rst-setup-passage-card"
						class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-hairline bg-canvas px-5 py-4 sm:px-6 sm:py-5"
					>
						<div>
							<span
								id="rst-setup-passage-meta"
								class="text-[12px] font-medium text-mute tabular-nums"
							>
								{initialPassageMeta}
							</span>
							<h2
								id="rst-setup-passage-title"
								class="mt-1 text-[18px] font-semibold tracking-[-0.3px] text-ink sm:text-[20px]"
							>
								{firstPassage?.title ?? ''}
							</h2>
						</div>

						<button
							type="button"
							id="rst-btn-shuffle"
							class="cursor-pointer inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-4 py-2 text-[13px] font-medium text-ink transition-colors hover:border-ink"
						>
							<span>{t('readingSpeedTest.ui.shuffleBtn')}</span>
						</button>
					</div>

					<!-- Custom Text Input Area (Shown when Custom Text tab is active) -->
					<div id="rst-setup-custom-card" class="hidden rounded-2xl border border-hairline bg-canvas p-5">
						<div class="mb-2.5 flex items-center justify-between gap-2">
							<label for="rst-custom-textarea" class="text-[13px] font-medium text-ink">
								{t('readingSpeedTest.ui.customLabel')}
							</label>
							<span id="rst-custom-word-badge" class="text-[12px] font-medium text-mute tabular-nums">
								{t('readingSpeedTest.ui.zeroWords')}
							</span>
						</div>
						<textarea
							id="rst-custom-textarea"
							rows="5"
							placeholder={t('readingSpeedTest.ui.customPlaceholder')}
							class="w-full rounded-xl border border-hairline bg-canvas-elevated p-3.5 text-[15px] leading-[24px] text-ink placeholder:text-faint focus:border-ink focus:outline-none"
						></textarea>
						<p id="rst-custom-hint" class="mt-2 text-[12px] text-mute">
							{t('readingSpeedTest.ui.customHintDefault')}
						</p>
					</div>
				</div>

				<!-- Row 3: Collapsible Test Options (Quiz Length & Font Size) -->
				<details open class="group rounded-2xl border border-hairline bg-canvas px-5 py-3.5">
					<summary class="flex cursor-pointer list-none items-center justify-between text-[13px] font-medium text-body transition-colors hover:text-ink">
						<span>{t('readingSpeedTest.ui.testOptions')}</span>
						<span class="inline-block text-[12px] text-mute transition-transform duration-200 group-open:rotate-180">▾</span>
					</summary>
					<div class="mt-4 grid grid-cols-1 gap-4 border-t border-hairline pt-4 sm:grid-cols-2">
						<div>
							<label for="rst-quiz-length-select" class="block text-[12px] font-medium text-mute">
								{t('readingSpeedTest.ui.quizLengthLabel')}
							</label>
							<select
								id="rst-quiz-length-select"
								class="mt-1.5 w-full cursor-pointer rounded-xl border border-hairline bg-canvas-elevated px-3.5 py-2 text-[13px] font-medium text-ink outline-none transition-colors hover:border-ink focus:border-ink disabled:cursor-not-allowed disabled:opacity-50"
							>
								<option value="3" selected>{t('readingSpeedTest.ui.quizOption3')}</option>
								<option value="5">{t('readingSpeedTest.ui.quizOption5')}</option>
								<option value="0">{t('readingSpeedTest.ui.quizOption0')}</option>
							</select>
						</div>

						<div>
							<span class="block text-[12px] font-medium text-mute">
								{t('readingSpeedTest.ui.fontSizeLabel')}
							</span>
							<div
								role="group"
								aria-label={t('readingSpeedTest.ui.fontSizeAria')}
								class="mt-1.5 inline-flex w-full items-center overflow-hidden rounded-xl border border-hairline bg-canvas-elevated"
							>
								<button
									type="button"
									data-font-size="sm"
									class="rst-font-btn flex-1 cursor-pointer py-2 text-[12px] font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink"
								>
									{t('readingSpeedTest.ui.fontSmall')}
								</button>
								<button
									type="button"
									data-font-size="md"
									class="rst-font-btn flex-1 cursor-pointer border-x border-hairline bg-[#0f2e26] py-2 text-[13px] font-medium text-[#afe3d0] transition-colors dark:bg-[#afe3d0] dark:text-[#0f2e26]"
								>
									{t('readingSpeedTest.ui.fontDefault')}
								</button>
								<button
									type="button"
									data-font-size="lg"
									class="rst-font-btn flex-1 cursor-pointer py-2 text-[14px] font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink"
								>
									{t('readingSpeedTest.ui.fontLarge')}
								</button>
							</div>
						</div>
					</div>
				</details>

				<!-- Row 4: Setup Summary & Bold Start CTA -->
				<div class="flex flex-col items-stretch justify-between gap-4 border-t border-hairline pt-6 sm:flex-row sm:items-center">
					<span id="rst-setup-summary-line" class="text-[13px] text-mute tabular-nums">
						{initialSetupSummary}
					</span>
					<button
						type="button"
						id="rst-btn-start-test"
						class="cursor-pointer inline-flex h-12 items-center justify-center gap-2 rounded-2xl bg-[#0f2e26] px-8 text-[15px] font-semibold text-[#afe3d0] transition-all hover:opacity-95 active:scale-[0.99] dark:bg-[#afe3d0] dark:text-[#0f2e26]"
					>
						<span>{t('readingSpeedTest.ui.startTestBtn')}</span>
					</button>
				</div>
			</div>
		</div>

		<!-- ===================================================================== -->
		<!-- WINDOW 2: FOCUSED READING WINDOW (step === 'read')                    -->
		<!-- ===================================================================== -->
		<div
			id="rst-window-read"
			class="whisper-shadow hidden overflow-hidden rounded-3xl border border-hairline bg-canvas-elevated"
		>
			<!-- Minimal Distraction-Free Top Bar -->
			<div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline bg-canvas px-6 py-4 sm:px-8">
				<div class="flex items-center gap-3">
					<span
						id="rst-read-timer-pill"
						aria-live="off"
						class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated px-3.5 py-1 text-[14px] font-semibold text-ink tabular-nums"
					>
						<span class="h-2 w-2 rounded-full bg-[#0f2e26] dark:bg-[#afe3d0]"></span>
						<span id="rst-live-timer">00:00.0</span>
					</span>
					<span id="rst-read-word-badge" class="text-[13px] text-mute tabular-nums">
						{`${firstWordCount} ${t('readingSpeedTest.client.wordsPlural')}`}
					</span>
				</div>

				<div class="flex items-center gap-3">
					<div
						role="group"
						aria-label={t('readingSpeedTest.ui.fontSizeAria')}
						class="inline-flex items-center overflow-hidden rounded-xl border border-hairline bg-canvas-elevated"
					>
						<button
							type="button"
							data-font-size="sm"
							class="rst-font-btn cursor-pointer px-2.5 py-1 text-[12px] font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink"
						>
							A-
						</button>
						<button
							type="button"
							data-font-size="md"
							class="rst-font-btn cursor-pointer border-x border-hairline bg-[#0f2e26] px-2.5 py-1 text-[13px] font-medium text-[#afe3d0] transition-colors dark:bg-[#afe3d0] dark:text-[#0f2e26]"
						>
							A
						</button>
						<button
							type="button"
							data-font-size="lg"
							class="rst-font-btn cursor-pointer px-2.5 py-1 text-[14px] font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink"
						>
							A+
						</button>
					</div>

					<button
						type="button"
						id="rst-btn-cancel-read"
						class="cursor-pointer rounded-full px-3 py-1 text-[13px] font-medium text-mute transition-colors hover:bg-hairline-soft hover:text-ink"
					>
						{t('readingSpeedTest.ui.cancelBtn')}
					</button>
				</div>
			</div>

			<!-- Sub-View A: Standard Silent Reading Canvas -->
			<div id="rst-read-standard-canvas" class="px-6 py-8 sm:px-12 sm:py-10">
				<div class="mx-auto max-w-[65ch]">
					<span id="rst-read-topic" class="text-[12px] font-medium text-mute">
						{firstPassage?.topic ?? ''}
					</span>
					<h2
						id="rst-read-title"
						class="mt-1 text-[22px] leading-[30px] font-semibold tracking-[-0.4px] text-ink sm:text-[26px] sm:leading-[34px]"
					>
						{firstPassage?.title ?? ''}
					</h2>

					<div
						id="rst-read-paragraphs"
						class="mt-7 space-y-5 text-[16px] leading-[28px] font-normal text-ink"
					></div>

					<!-- Prominent Finish Reading CTA right below the last paragraph -->
					<div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-hairline pt-6 sm:flex-row">
						<span class="text-[13px] text-mute">
							{t('readingSpeedTest.ui.finishHint')}
						</span>
						<button
							type="button"
							id="rst-btn-finish-reading"
							class="w-full cursor-pointer inline-flex h-12 items-center justify-center gap-2 rounded-2xl bg-[#afe3d0] px-8 text-[15px] font-semibold text-[#0f2e26] transition-all hover:bg-[#c5eedf] sm:w-auto"
						>
							<span>{t('readingSpeedTest.ui.finishReadingBtn')}</span>
						</button>
					</div>
				</div>
			</div>

			<!-- Sub-View B: Focused RSVP Speed Trainer Canvas -->
			<div id="rst-read-rsvp-canvas" class="hidden px-6 py-8 sm:px-10 sm:py-10">
				<div class="mx-auto max-w-[680px]">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<div>
							<span class="text-[12px] font-medium text-mute">{t('readingSpeedTest.ui.rsvpHeading')}</span>
							<h2 id="rst-rsvp-title" class="mt-0.5 text-[18px] font-semibold text-ink">
								{firstPassage?.title ?? ''}
							</h2>
						</div>

						<!-- Word-by-word vs Sentence-by-sentence toggle -->
						<div
							role="group"
							aria-label={t('readingSpeedTest.ui.rsvpChunkAria')}
							class="inline-flex items-center rounded-full border border-hairline bg-canvas p-1"
						>
							<button
								type="button"
								data-rsvp-chunk="word"
								class="rst-rsvp-chunk-btn cursor-pointer rounded-full bg-[#0f2e26] px-3.5 py-1 text-[12px] font-medium text-[#afe3d0] transition-colors dark:bg-[#afe3d0] dark:text-[#0f2e26]"
							>
								{t('readingSpeedTest.ui.rsvpWordByWord')}
							</button>
							<button
								type="button"
								data-rsvp-chunk="sentence"
								class="rst-rsvp-chunk-btn cursor-pointer rounded-full bg-transparent px-3.5 py-1 text-[12px] font-medium text-body transition-colors hover:text-ink"
							>
								{t('readingSpeedTest.ui.rsvpSentenceBySentence')}
							</button>
						</div>
					</div>

					<!-- Target WPM Slider (150–800 WPM) -->
					<div class="mt-5 rounded-2xl border border-hairline bg-canvas p-4 sm:p-5">
						<div class="flex items-center justify-between text-[13px]">
							<label for="rst-rsvp-wpm-slider" class="font-medium text-body">
								{t('readingSpeedTest.ui.rsvpTargetSpeedLabel')}
							</label>
							<output
								id="rst-rsvp-wpm-label"
								for="rst-rsvp-wpm-slider"
								class="font-semibold text-ink tabular-nums"
							>
								300 WPM
							</output>
						</div>
						<input
							type="range"
							id="rst-rsvp-wpm-slider"
							min="150"
							max="800"
							step="10"
							value="300"
							class="geist-slider mt-2.5"
						/>
						<div class="mt-1.5 flex justify-between text-[11px] text-mute tabular-nums">
							<span>150 WPM</span>
							<span>300 WPM</span>
							<span>500 WPM</span>
							<span>800 WPM</span>
						</div>
					</div>

					<!-- RSVP Flash Display Box -->
					<div class="mt-5 flex min-h-[200px] flex-col items-center justify-center rounded-2xl border border-hairline bg-canvas px-6 py-10 text-center">
						<div
							id="rst-rsvp-display"
							class="max-w-xl font-sans text-[28px] leading-[38px] font-semibold tracking-[-0.5px] text-ink select-none sm:text-[34px] sm:leading-[44px]"
						>
							{t('readingSpeedTest.ui.rsvpReady')}
						</div>
					</div>

					<!-- Progress Bar -->
					<div class="mt-4">
						<div class="flex items-center justify-between text-[12px] text-mute tabular-nums">
							<span id="rst-rsvp-progress-label">{initialRsvpProgress}</span>
							<span id="rst-rsvp-time-remaining">{initialRsvpRemaining}</span>
						</div>
						<div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-hairline">
							<div
								id="rst-rsvp-progress-bar"
								class="h-full rounded-full bg-[#0f2e26] transition-all duration-100 dark:bg-[#afe3d0]"
								style="width: 0%;"
							></div>
						</div>
					</div>

					<!-- Play / Pause / Restart / Finish Session Controls -->
					<div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-hairline pt-5">
						<div class="flex items-center gap-2.5">
							<button
								type="button"
								id="rst-rsvp-play-btn"
								class="cursor-pointer inline-flex h-11 items-center gap-2 rounded-2xl bg-[#0f2e26] px-6 text-[14px] font-medium text-[#afe3d0] transition-opacity hover:opacity-90 dark:bg-[#afe3d0] dark:text-[#0f2e26]"
							>
								<span>{t('readingSpeedTest.ui.rsvpPause')}</span>
							</button>
							<button
								type="button"
								id="rst-rsvp-restart-btn"
								class="cursor-pointer inline-flex h-11 items-center gap-2 rounded-2xl border border-hairline bg-canvas px-5 text-[14px] font-medium text-ink transition-colors hover:bg-hairline-soft"
							>
								<span>{t('readingSpeedTest.ui.rsvpRestart')}</span>
							</button>
						</div>

						<button
							type="button"
							id="rst-rsvp-finish-btn"
							class="cursor-pointer inline-flex h-11 items-center gap-2 rounded-2xl bg-[#afe3d0] px-6 text-[14px] font-semibold text-[#0f2e26] transition-colors hover:bg-[#c5eedf]"
						>
							<span>{t('readingSpeedTest.ui.rsvpFinishSession')}</span>
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- ===================================================================== -->
		<!-- WINDOW 3: MEMORY QUIZ WINDOW (step === 'quiz')                        -->
		<!-- ===================================================================== -->
		<div
			id="rst-window-quiz"
			class="whisper-shadow hidden overflow-hidden rounded-3xl border border-hairline bg-canvas-elevated"
		>
			<div class="flex flex-wrap items-center justify-between gap-2 border-b border-hairline px-6 py-5 sm:px-8">
				<div>
					<span id="rst-quiz-speed-pill" class="text-[12px] font-medium text-mute tabular-nums">
						{t('readingSpeedTest.client.rawSpeedRecorded', { wpm: 250 })}
					</span>
					<h2 id="rst-quiz-heading" class="mt-0.5 text-[20px] font-semibold tracking-[-0.3px] text-ink">
						{t('readingSpeedTest.ui.quizHeadingDefault')}
					</h2>
				</div>
				<span
					id="rst-quiz-progress-badge"
					class="rounded-full bg-hairline-soft px-3.5 py-1 text-[12px] font-medium text-ink tabular-nums"
				>
					{t('readingSpeedTest.client.quizProgress', { answered: 0, total: 3 })}
				</span>
			</div>

			<div class="px-6 py-7 sm:px-8">
				<p class="mb-6 text-[14px] text-body">
					{t('readingSpeedTest.ui.quizIntro')}
				</p>

				<div id="rst-quiz-questions-list" class="space-y-4"></div>

				<div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-hairline pt-6">
					<span id="rst-quiz-helper-msg" class="text-[13px] text-mute">
						{t('readingSpeedTest.ui.quizHelperDefault')}
					</span>
					<button
						type="button"
						id="rst-btn-submit-quiz"
						disabled
						class="cursor-pointer inline-flex h-12 items-center justify-center rounded-2xl bg-[#0f2e26] px-8 text-[14px] font-semibold text-[#afe3d0] transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40 dark:bg-[#afe3d0] dark:text-[#0f2e26]"
					>
						{t('readingSpeedTest.ui.submitQuizBtn')}
					</button>
				</div>
			</div>
		</div>

		<!-- ===================================================================== -->
		<!-- WINDOW 4: RESULTS & INSIGHTS WINDOW (step === 'results')              -->
		<!-- ===================================================================== -->
		<div
			id="rst-window-results"
			class="hidden space-y-6"
		>
			<!-- Primary Deep Forest Emerald + Mint Hero Result Card -->
			<div class="emerald-result-panel whisper-shadow overflow-hidden rounded-3xl bg-[#0f2e26] p-6 text-[#f0fdf7] sm:p-8 lg:p-10">
				<div class="flex flex-wrap items-center justify-between gap-4 border-b border-[#afe3d0]/15 pb-6">
					<div>
						<span class="block text-[12px] font-medium text-[#afe3d0]/80">
							{t('readingSpeedTest.ui.resultsEyebrow')}
						</span>
						<h2 class="mt-1 text-[22px] font-semibold tracking-[-0.4px] text-white sm:text-[26px]">
							{t('readingSpeedTest.ui.resultsHeading')}
						</h2>
					</div>
					<div class="flex flex-wrap items-center gap-2.5">
						<button
							type="button"
							id="rst-btn-copy-result"
							class="cursor-pointer inline-flex h-11 items-center justify-center rounded-2xl border border-[#afe3d0]/40 bg-[#afe3d0] px-6 text-[14px] font-semibold text-[#0f2e26] transition-all hover:bg-[#c5eedf]"
						>
							{t('readingSpeedTest.ui.copyResultBtn')}
						</button>
						<button
							type="button"
							id="rst-btn-take-another"
							class="cursor-pointer inline-flex h-11 items-center justify-center rounded-2xl border border-[#afe3d0]/25 bg-[#153d33]/80 px-6 text-[14px] font-semibold text-[#f0fdf7] transition-all hover:bg-[#153d33]"
						>
							{t('readingSpeedTest.ui.takeAnotherBtn')}
						</button>
					</div>
				</div>

				<!-- 4 Summary KPI Cards inside the Emerald Stage -->
				<div
					aria-label={t('readingSpeedTest.ui.resultsMetricsAria')}
					class="mt-6 grid grid-cols-2 gap-3.5 sm:grid-cols-4"
				>
					<!-- KPI 1: Raw Speed (WPM) -->
					<article class="flex flex-col justify-between rounded-2xl border border-[#afe3d0]/15 bg-[#153d33]/65 p-4 sm:p-5">
						<span class="text-[12px] font-medium text-[#afe3d0]/80">{t('readingSpeedTest.ui.kpiRawSpeed')}</span>
						<div class="my-2 flex items-baseline gap-1.5">
							<output
								id="rst-res-raw-wpm"
								class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1px] text-[#afe3d0] tabular-nums sm:text-[36px]"
							>
								250
							</output>
							<span class="text-[13px] text-[#e2f5ee]">WPM</span>
						</div>
						<p id="rst-res-raw-sub" class="text-[12px] text-[#d1fae5]/75 tabular-nums">
							{t('readingSpeedTest.client.resRawSub', { words: firstWordCount, seconds: '37.2' })}
						</p>
					</article>

					<!-- KPI 2: Comprehension (%) -->
					<article class="flex flex-col justify-between rounded-2xl border border-[#afe3d0]/15 bg-[#153d33]/65 p-4 sm:p-5">
						<span class="text-[12px] font-medium text-[#afe3d0]/80">{t('readingSpeedTest.ui.kpiComprehension')}</span>
						<div class="my-2 flex items-baseline gap-1.5">
							<output
								id="rst-res-comp-pct"
								class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1px] text-[#afe3d0] tabular-nums sm:text-[36px]"
							>
								100%
							</output>
						</div>
						<p id="rst-res-comp-sub" class="text-[12px] text-[#d1fae5]/75 tabular-nums">
							{t('readingSpeedTest.client.resCompSub', { correct: 3, total: 3 })}
						</p>
					</article>

					<!-- KPI 3: Effective WPM -->
					<article class="flex flex-col justify-between rounded-2xl border border-[#afe3d0]/15 bg-[#153d33]/65 p-4 sm:p-5">
						<span class="text-[12px] font-medium text-[#afe3d0]/80">{t('readingSpeedTest.ui.kpiEffectiveWpm')}</span>
						<div class="my-2 flex items-baseline gap-1.5">
							<output
								id="rst-res-effective-wpm"
								class="font-sans text-[32px] leading-[38px] font-semibold tracking-[-1px] text-[#afe3d0] tabular-nums sm:text-[36px]"
							>
								250
							</output>
							<span class="text-[13px] text-[#e2f5ee]">WPM</span>
						</div>
						<p id="rst-res-effective-sub" class="text-[12px] text-[#d1fae5]/75 tabular-nums">
							{t('readingSpeedTest.ui.kpiEffectiveSubDefault')}
						</p>
					</article>

					<!-- KPI 4: Reader Profile & Percentile -->
					<article class="flex flex-col justify-between rounded-2xl border border-[#afe3d0]/15 bg-[#153d33]/65 p-4 sm:p-5">
						<span class="text-[12px] font-medium text-[#afe3d0]/80">{t('readingSpeedTest.ui.kpiReaderProfile')}</span>
						<div class="my-2">
							<output
								id="rst-res-profile"
								class="block font-sans text-[20px] leading-[26px] font-semibold tracking-[-0.4px] text-[#afe3d0] sm:text-[22px]"
							>
								{t('readingSpeedTest.client.profiles.average')}
							</output>
						</div>
						<p id="rst-res-percentile" class="text-[12px] text-[#d1fae5]/75 tabular-nums">
							{t('readingSpeedTest.client.resPercentile', {
								percentile: 58,
								profile: t('readingSpeedTest.client.profiles.average'),
							})}
						</p>
					</article>
				</div>
			</div>

			<!-- 700+ WPM Skimming Notice (Shown only if Raw WPM > 700) -->
			<div
				id="rst-skim-warning"
				class="whisper-shadow hidden rounded-2xl border border-vercel-warning/50 bg-canvas-elevated p-5 text-[13px] leading-[20px] text-body"
				set:html={t('readingSpeedTest.ui.skimWarningHtml')}
			/>

			<!-- Age Group Comparison & Books a Year Mini-Calculator Card -->
			<div class="whisper-shadow grid grid-cols-1 divide-y divide-hairline overflow-hidden rounded-3xl border border-hairline bg-canvas-elevated md:grid-cols-2 md:divide-x md:divide-y-0">
				<!-- Left: Age Group Comparison -->
				<div class="p-6 sm:p-7">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<h3 class="text-[15px] font-semibold text-ink">
							{t('readingSpeedTest.ui.ageComparisonHeading')}
						</h3>
						<div class="flex min-w-0 items-center gap-1.5">
							<label for="rst-age-select" class="shrink-0 text-[12px] text-mute">
								{t('readingSpeedTest.ui.ageLabel')}
							</label>
							<select
								id="rst-age-select"
								class="min-w-0 max-w-full cursor-pointer rounded-xl border border-hairline bg-canvas px-3 py-1.5 text-[12px] font-medium text-ink outline-none transition-colors hover:border-ink focus:border-ink"
							>
								<option value="under13">{t('readingSpeedTest.ui.ageOptUnder13')}</option>
								<option value="13-17">{t('readingSpeedTest.ui.ageOpt13_17')}</option>
								<option value="18-24">{t('readingSpeedTest.ui.ageOpt18_24')}</option>
								<option value="25-34" selected>{t('readingSpeedTest.ui.ageOpt25_34')}</option>
								<option value="35plus">{t('readingSpeedTest.ui.ageOpt35Plus')}</option>
							</select>
						</div>
					</div>

					<div class="mt-4 rounded-2xl border border-hairline bg-canvas p-4">
						<div class="flex items-center justify-between text-[12px] text-mute tabular-nums">
							<span>100 WPM</span>
							<span id="rst-age-benchmark-label" class="font-medium text-ink">{t('readingSpeedTest.ui.peerAvgInitial')}</span>
							<span>500+ WPM</span>
						</div>
						<div class="relative mt-2.5 h-2.5 w-full overflow-hidden rounded-full bg-hairline">
							<div
								id="rst-age-marker"
								class="absolute top-0 bottom-0 z-10 w-0.5 bg-ink/60"
								style="left: 34.5%;"
								title={t('readingSpeedTest.ui.peerBenchmarkTitle')}
							></div>
							<div
								id="rst-speed-progress"
								class="h-full rounded-full bg-[#0f2e26] transition-all duration-300 dark:bg-[#afe3d0]"
								style="width: 0%;"
							></div>
						</div>
						<p id="rst-comparison-detail" class="mt-3 text-[13px] text-body">
							{t('readingSpeedTest.ui.comparisonDetailDefault')}
						</p>
					</div>
				</div>

				<!-- Right: Books a Year at Your Speed Mini-Calculator -->
				<div class="p-6 sm:p-7">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<div>
							<h3 class="text-[15px] font-semibold text-ink">
								{t('readingSpeedTest.ui.booksPerYearHeading')}
							</h3>
							<p class="text-[12px] text-mute">
								{t('readingSpeedTest.ui.booksPerYearSub')}
							</p>
						</div>
						<div class="flex items-center gap-1.5">
							<input
								type="number"
								id="rst-daily-mins-input"
								min="5"
								max="300"
								step="5"
								value="20"
								aria-label={t('readingSpeedTest.ui.dailyMinsAria')}
								class="w-16 rounded-xl border border-hairline bg-canvas px-2.5 py-1.5 text-right text-[13px] font-semibold text-ink tabular-nums focus:border-ink focus:outline-none"
							/>
							<span class="text-[12px] text-body">{t('readingSpeedTest.ui.minPerDay')}</span>
						</div>
					</div>

					<div class="mt-4 rounded-2xl border border-hairline bg-canvas p-4">
						<div class="flex items-baseline justify-between">
							<span class="text-[13px] text-body">{t('readingSpeedTest.ui.estimatedAnnualBooks')}</span>
							<output
								id="rst-books-per-year-output"
								class="text-[20px] font-semibold text-ink tabular-nums"
							>
								{t('readingSpeedTest.ui.booksPerYearInitial')}
							</output>
						</div>
						<p id="rst-books-per-year-sub" class="mt-1.5 text-[12px] text-mute tabular-nums">
							{t('readingSpeedTest.ui.booksPerYearSubInitial')}
						</p>
					</div>
				</div>
			</div>

			<!-- Answer Review Section (Shown when quiz was taken) -->
			<div
				id="rst-answer-review-card"
				class="whisper-shadow rounded-3xl border border-hairline bg-canvas-elevated p-6 sm:p-8"
			>
				<div class="flex items-center justify-between gap-2">
					<h3 class="text-[16px] font-semibold tracking-[-0.2px] text-ink">
						{t('readingSpeedTest.ui.answerReviewHeading')}
					</h3>
					<span id="rst-review-summary-badge" class="text-[12px] font-medium text-mute tabular-nums">
						{t('readingSpeedTest.client.resCompSub', { correct: 3, total: 3 })}
					</span>
				</div>
				<div id="rst-answer-review-list" class="mt-4 space-y-3"></div>
			</div>
		</div>

		<!-- ===================================================================== -->
		<!-- PAST RESULTS TAB VIEW (view === 'history')                            -->
		<!-- ===================================================================== -->
		<div
			id="rst-window-history"
			class="whisper-shadow hidden rounded-3xl border border-hairline bg-canvas-elevated p-6 sm:p-8"
		>
			<div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline pb-4">
				<div>
					<h2 class="text-[18px] font-semibold tracking-[-0.3px] text-ink">
						{t('readingSpeedTest.ui.historyHeading')}
					</h2>
					<p class="mt-0.5 text-[13px] text-mute">
						{t('readingSpeedTest.ui.historySub')}
					</p>
				</div>
				<div class="flex items-center gap-2">
					<button
						type="button"
						id="rst-btn-clear-history"
						class="cursor-pointer rounded-full border border-hairline bg-canvas px-3.5 py-1.5 text-[12px] font-medium text-mute transition-colors hover:border-ink hover:text-ink"
					>
						{t('readingSpeedTest.ui.clearHistoryBtn')}
					</button>
					<button
						type="button"
						id="rst-btn-back-to-test"
						class="cursor-pointer rounded-full bg-[#0f2e26] px-4 py-1.5 text-[13px] font-medium text-[#afe3d0] transition-opacity hover:opacity-90 dark:bg-[#afe3d0] dark:text-[#0f2e26]"
					>
						{t('readingSpeedTest.ui.backToTestBtn')}
					</button>
				</div>
			</div>

			<div id="rst-history-empty" class="mt-5 rounded-2xl border border-hairline bg-canvas p-6 text-center text-[13px] text-mute">
				{t('readingSpeedTest.ui.historyEmpty')}
			</div>

			<div id="rst-history-table-wrap" class="mt-4 hidden overflow-x-auto">
				<table class="w-full border-collapse text-left text-[13px]">
					<thead>
						<tr class="border-b border-hairline text-mute">
							<th class="py-2.5 pr-4 font-medium">{t('readingSpeedTest.ui.historyColPassage')}</th>
							<th class="px-3 py-2.5 font-medium tabular-nums">{t('readingSpeedTest.ui.historyColRawWpm')}</th>
							<th class="px-3 py-2.5 font-medium tabular-nums">{t('readingSpeedTest.ui.historyColComp')}</th>
							<th class="px-3 py-2.5 font-medium tabular-nums">{t('readingSpeedTest.ui.historyColEffectiveWpm')}</th>
							<th class="py-2.5 pl-3 text-right font-medium tabular-nums">{t('readingSpeedTest.ui.historyColWhen')}</th>
						</tr>
					</thead>
					<tbody id="rst-history-tbody" class="divide-y divide-hairline text-body"></tbody>
					<tfoot id="rst-history-tfoot" class="border-t border-hairline bg-canvas font-semibold text-ink"></tfoot>
				</table>
			</div>
		</div>

		<!-- Related Tools Note (Protected Against Draft Links) -->
		<aside
			aria-label={t('readingSpeedTest.ui.relatedToolsAria')}
			class="mt-6 flex flex-col items-start justify-between gap-3 pt-2 text-[14px] text-body sm:flex-row sm:items-center"
		>
			<p class="leading-[22px]">
				{t('readingSpeedTest.ui.relatedBefore1')}{' '}
				{
					readingCounterTool?.status === 'live' ? (
						<a
							href={getLocalizedPath(readingCounterTool.slug, locale)}
							class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 transition-colors hover:text-vercel-blue-deep hover:decoration-vercel-blue"
						>
							{t('readingTimeCalculator.shortName')}
						</a>
					) : (
						<span aria-disabled="true" class="inline-flex items-center gap-1.5 font-medium text-ink">
							<span>{t('readingTimeCalculator.shortName')}</span>
							<span class="rounded-full bg-hairline-soft px-2 py-0.5 text-[11px] font-medium text-mute">
								{t('common.soon')}
							</span>
						</span>
					)
				}
				{t('readingSpeedTest.ui.relatedBefore2')}{' '}
				{
					audiobookTool?.status === 'live' ? (
						<a
							href={getLocalizedPath(audiobookTool.slug, locale)}
							class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 transition-colors hover:text-vercel-blue-deep hover:decoration-vercel-blue"
						>
							{t('audiobookCalculator.shortName')}
						</a>
					) : (
						<span aria-disabled="true" class="inline-flex items-center gap-1.5 font-medium text-ink">
							<span>{t('audiobookCalculator.shortName')}</span>
							<span class="rounded-full bg-hairline-soft px-2 py-0.5 text-[11px] font-medium text-mute">
								{t('common.soon')}
							</span>
						</span>
					)
				}
				{t('readingSpeedTest.ui.relatedBefore3')}{' '}
				{
					speechTool?.status === 'live' ? (
						<a
							href={getLocalizedPath(speechTool.slug, locale)}
							class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 transition-colors hover:text-vercel-blue-deep hover:decoration-vercel-blue"
						>
							{t('speechCalculator.shortName')}
						</a>
					) : (
						<span aria-disabled="true" class="inline-flex items-center gap-1.5 font-medium text-ink">
							<span>{t('speechCalculator.shortName')}</span>
							<span class="rounded-full bg-hairline-soft px-2 py-0.5 text-[11px] font-medium text-mute">
								{t('common.soon')}
							</span>
						</span>
					)
				}.
			</p>
		</aside>
	</div>
</section>

<script
	type="application/json"
	id="rst-i18n"
	set:html={JSON.stringify(clientI18n).replace(/</g, '\\u003c')}
/>

<script>
	interface QuizQuestion {
		question: string;
		options: string[];
		correctIndex: number;
		explanation: string;
	}

	type DifficultyKey = 'beginner' | 'intermediate' | 'challenge';
	type WizardStep = 'setup' | 'read' | 'quiz' | 'results';

	interface PassageItem {
		id: string;
		difficulty: DifficultyKey;
		difficultyLabel: string;
		topic: string;
		title: string;
		paragraphs: string[];
		questions: QuizQuestion[];
	}

	interface SavedTestRecord {
		title: string;
		difficultyLabel: string;
		rawWpm: number;
		accuracyPct: number | null;
		effectiveWpm: number;
		timestamp: string;
	}

	interface ClientStrings {
		ageBenchmarks: Record<string, string>;
		profiles: {
			careful: string;
			steady: string;
			average: string;
			fast: string;
			speed: string;
			skimmer: string;
		};
		customDefaultParagraph: string;
		customPassageTitle: string;
		customPassageTopic: string;
		customDifficultyLabel: string;
		wordSingular: string;
		wordsPlural: string;
		passageMeta: string;
		modeStandardLabel: string;
		modeRsvpLabel: string;
		quizSpeedOnlyLabel: string;
		quizCountLabel: string;
		setupSummary: string;
		rsvpProgress: string;
		rsvpTimeRemaining: string;
		rsvpPlay: string;
		rsvpPause: string;
		rsvpResume: string;
		rsvpReady: string;
		customMinWordsError: string;
		customReadyHint: string;
		rawSpeedRecorded: string;
		quizHeadingCount: string;
		quizProgress: string;
		quizHelperRemainingSingular: string;
		quizHelperRemainingPlural: string;
		quizHelperReady: string;
		ageBenchmarkLabel: string;
		comparisonExactHtml: string;
		comparisonFasterHtml: string;
		comparisonSlowerHtml: string;
		booksPerYearOutput: string;
		booksPerYearSub: string;
		resRawSub: string;
		speedOnlyShort: string;
		quizBypassed: string;
		effectiveSpeedOnlySub: string;
		resCompSub: string;
		resEffectiveSub: string;
		resPercentile: string;
		reviewSummaryBadge: string;
		noAnswer: string;
		badgeCorrect: string;
		badgeIncorrect: string;
		yourAnswerLabel: string;
		correctAnswerLabel: string;
		historyAverageSingular: string;
		historyAveragePlural: string;
		copySummary: string;
		copiedLabel: string;
		copyResultLabel: string;
	}

	interface ClientI18nPayload {
		locale: string;
		shareUrl: string;
		strings: ClientStrings;
		passages: PassageItem[];
	}

	const STORAGE_KEY = 'wordora_rst_history_v2';

	function loadClientI18n(): ClientI18nPayload | null {
		const el = document.getElementById('rst-i18n');
		if (!el?.textContent) return null;
		try {
			return JSON.parse(el.textContent) as ClientI18nPayload;
		} catch {
			return null;
		}
	}

	function fmt(template: string, vars: Record<string, string | number>): string {
		return template.replace(/\{(\w+)\}/g, (_, name: string) => String(vars[name] ?? `{${name}}`));
	}

	function countWords(text: string): number {
		const cleaned = text.trim();
		if (!cleaned) return 0;
		return cleaned.split(/\s+/).length;
	}

	function countPassageWords(paragraphs: string[]): number {
		return countWords(paragraphs.join(' '));
	}

	function initReadingSpeedWizard() {
		const i18nPayload = loadClientI18n();
		if (!i18nPayload || !Array.isArray(i18nPayload.passages) || i18nPayload.passages.length === 0) {
			return;
		}

		const S = i18nPayload.strings;
		const PASSAGES = i18nPayload.passages;
		const LOCALE = i18nPayload.locale || 'en';
		const SHARE_URL = i18nPayload.shareUrl || 'https://wordora.site/reading-speed-test/';

		const AGE_BENCHMARKS: Record<string, { label: string; avgWpm: number }> = {
			under13: { label: S.ageBenchmarks.under13, avgWpm: 165 },
			'13-17': { label: S.ageBenchmarks['13-17'], avgWpm: 205 },
			'18-24': { label: S.ageBenchmarks['18-24'], avgWpm: 245 },
			'25-34': { label: S.ageBenchmarks['25-34'], avgWpm: 238 },
			'35plus': { label: S.ageBenchmarks['35plus'], avgWpm: 230 },
		};

		function computeAdultPercentileAndProfile(wpm: number): { percentile: number; profile: string } {
			const z = (wpm - 238) / 70;
			const rawPct = Math.round(100 / (1 + Math.exp(-1.702 * z)));
			const percentile = Math.max(1, Math.min(99, rawPct));

			let profile = S.profiles.average;
			if (wpm < 170) profile = S.profiles.careful;
			else if (wpm < 220) profile = S.profiles.steady;
			else if (wpm <= 265) profile = S.profiles.average;
			else if (wpm <= 350) profile = S.profiles.fast;
			else if (wpm <= 500) profile = S.profiles.speed;
			else profile = S.profiles.skimmer;

			return { percentile, profile };
		}

