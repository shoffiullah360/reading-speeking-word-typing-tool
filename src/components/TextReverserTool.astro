---
import { getLocaleFromUrl, useTranslations, type Locale } from '../i18n/ui';

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const defaultSamples = [
	"Madam, in Eden, I'm Adam.",
	"A man, a plan, a canal: Panama!",
	"Step 1: Research audience intent\nStep 2: Draft clear headline\nStep 3: Polish and publish",
	"Never odd or even.",
	"Reading and writing clearly makes complex ideas simple.",
];

const clientI18n = {
	locale,
	defaultModeDesc: t('textReverser.ui.modeReverseAllDesc'),
	palindromeYes: t('textReverser.client.palindromeYes'),
	palindromeNo: t('textReverser.client.palindromeNo'),
	withoutSpaces: t('textReverser.client.withoutSpaces'),
	copied: t('textReverser.client.copied'),
	copyOutput: t('textReverser.ui.btnCopy'),
	downloadFilename: t('textReverser.client.downloadFilename'),
	samples: t.raw<string[]>('textReverser.client.samples') ?? defaultSamples,
};
---

<section
	id="text-reverser-workspace"
	aria-label={t('textReverser.ui.workspaceAria')}
	class="mx-auto max-w-[1200px] px-4 pt-4 pb-12 sm:px-6"
>
	<!-- Unified Stacked Studio Card -->
	<div class="whisper-shadow overflow-hidden rounded-3xl border border-hairline bg-canvas-elevated">
		<!-- Top Dual-Editor Stage -->
		<div class="relative grid grid-cols-1 divide-y divide-hairline bg-white lg:grid-cols-2 lg:divide-x lg:divide-y-0 dark:bg-canvas-elevated">
			<!-- Central Swap Button -->
			<button
				type="button"
				id="rv-btn-swap"
				title={t('textReverser.ui.swapAria')}
				aria-label={t('textReverser.ui.swapAria')}
				class="group absolute top-1/2 left-1/2 z-10 hidden -translate-x-1/2 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-hairline bg-canvas-elevated p-2.5 text-mute shadow-sm transition-all hover:border-[#0f2e26] hover:bg-[#0f2e26] hover:text-[#afe3d0] active:scale-95 lg:flex dark:hover:border-[#afe3d0] dark:hover:bg-[#afe3d0] dark:hover:text-[#0f2e26]"
			>
				<svg class="h-4 w-4 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4" />
				</svg>
			</button>

			<!-- Left Column: Original Text -->
			<div class="flex flex-col justify-between p-5 sm:p-7">
				<!-- Header Bar -->
				<div class="mb-3 flex flex-wrap items-center justify-between gap-2 border-b border-hairline pb-3">
					<label for="rv-input" class="text-[12px] font-semibold tracking-[0.04em] text-ink">
						{t('textReverser.ui.originalTextLabel')}
					</label>
					<div class="flex flex-wrap items-center gap-2 text-[12px]">
						<button
							type="button"
							id="rv-btn-paste"
							class="cursor-pointer rounded-lg border border-hairline bg-canvas-muted/60 px-2.5 py-1 font-medium text-body transition-colors hover:border-ink hover:text-ink"
						>
							{t('textReverser.ui.btnPaste')}
						</button>
						<button
							type="button"
							id="rv-btn-sample"
							class="cursor-pointer rounded-lg border border-hairline bg-canvas-muted/60 px-2.5 py-1 font-medium text-body transition-colors hover:border-ink hover:text-ink"
						>
							{t('textReverser.ui.btnSample')}
						</button>
						<label
							for="rv-file-upload"
							class="cursor-pointer rounded-lg border border-hairline bg-canvas-muted/60 px-2.5 py-1 font-medium text-body transition-colors hover:border-ink hover:text-ink"
						>
							{t('textReverser.ui.btnUpload')}
							<input id="rv-file-upload" type="file" accept=".txt,text/plain" class="sr-only" />
						</label>
						<button
							type="button"
							id="rv-btn-clear"
							class="cursor-pointer rounded-lg border border-hairline bg-canvas-muted/60 px-2.5 py-1 font-medium text-mute transition-colors hover:border-vercel-error hover:text-vercel-error"
						>
							{t('textReverser.ui.btnClear')}
						</button>
					</div>
				</div>

				<!-- Clean Borderless Textarea -->
				<div class="flex-1">
					<textarea
						id="rv-input"
						placeholder={t('textReverser.ui.inputPlaceholder')}
						class="h-48 w-full resize-y border-0 bg-transparent font-sans text-[16px] leading-[27px] text-ink placeholder:text-faint focus:outline-none sm:h-56"
					>{t('textReverser.ui.initialText')}</textarea>
				</div>

				<!-- Subtle Footer Bar -->
				<div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-hairline pt-3 text-[13px]">
					<div class="inline-flex items-center gap-1.5 rounded-xl border border-[#1d463b] bg-[#0f2e26] px-3 py-1 font-medium text-[#e2f5ee] tabular-nums">
						<output id="rv-metric-words" aria-live="polite" class="font-semibold text-[#afe3d0]">0</output> {t('textReverser.ui.unitWords')} &middot;
						<output id="rv-metric-chars" aria-live="polite" class="font-semibold text-[#afe3d0]">0</output> {t('textReverser.ui.unitChars')} &middot;
						<output id="rv-metric-lines" aria-live="polite" class="font-semibold text-[#afe3d0]">0</output> {t('textReverser.ui.unitLines')}
					</div>
					<span id="rv-metric-chars-nospace" class="text-[12px] text-mute tabular-nums">{t('textReverser.client.withoutSpaces', { count: 0 })}</span>
				</div>
			</div>

			<!-- Right Column: Reversed Output -->
			<div class="flex flex-col justify-between bg-canvas-muted/25 p-5 sm:p-7 dark:bg-black/20">
				<!-- Header Bar -->
				<div class="mb-3 flex flex-wrap items-center justify-between gap-2 border-b border-hairline pb-3">
					<div class="flex items-center gap-2.5">
						<label for="rv-output" class="text-[12px] font-semibold tracking-[0.04em] text-ink">
							{t('textReverser.ui.liveOutputLabel')}
						</label>
					</div>
					<!-- Dynamic Palindrome Pill Badge -->
					<output
						id="rv-palindrome-badge"
						aria-live="polite"
						class="inline-flex items-center gap-1.5 rounded-full border border-[#7ed4b6] bg-[#afe3d0] px-3 py-0.5 text-[12px] font-semibold text-[#0f2e26] transition-all"
					>
						<span id="rv-palindrome-dot" class="h-1.5 w-1.5 rounded-full bg-[#0f2e26]"></span>
						<span id="rv-palindrome-text">{t('textReverser.client.palindromeYes')}</span>
					</output>
				</div>

				<!-- Read-Only Borderless Output Textarea -->
				<div class="flex-1">
					<textarea
						id="rv-output"
						readonly
						placeholder={t('textReverser.ui.outputPlaceholder')}
						class="h-48 w-full resize-y border-0 bg-transparent font-sans text-[16px] leading-[27px] text-ink placeholder:text-faint focus:outline-none sm:h-56"
					></textarea>
				</div>

				<!-- Footer Bar -->
				<div class="mt-3 flex flex-wrap items-center justify-between gap-2.5 border-t border-hairline pt-3 text-[13px]">
					<button
						type="button"
						id="rv-btn-use-as-input"
						class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-hairline bg-canvas-elevated px-3 py-1.5 font-medium text-body transition-colors hover:border-ink hover:text-ink"
					>
						<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						{t('textReverser.ui.btnSendToInput')}
					</button>

					<div class="flex flex-wrap items-center gap-2">
						<button
							type="button"
							id="rv-btn-download"
							class="cursor-pointer rounded-xl border border-hairline bg-canvas-elevated px-3 py-1.5 font-medium text-body transition-colors hover:border-ink hover:text-ink"
						>
							{t('textReverser.ui.btnDownload')}
						</button>
						<button
							type="button"
							id="rv-btn-copy"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl bg-[#afe3d0] px-4 py-1.5 font-semibold text-[#0f2e26] shadow-xs transition-all hover:bg-[#c2edd6] active:scale-[0.99]"
						>
							{t('textReverser.ui.btnCopy')}
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Bottom Deep Forest Emerald Control Deck -->
		<div class="border-t border-[#afe3d0]/15 bg-[#0f2e26] p-5 text-white sm:p-6">
			<!-- Header: Section Label + Active Mode Description Subtitle -->
			<div class="flex flex-wrap items-center justify-between gap-2 pb-4">
				<div class="flex items-center gap-2">
					<span class="h-2 w-2 rounded-full bg-[#afe3d0]"></span>
					<span class="text-[12px] font-semibold tracking-[0.04em] text-[#afe3d0]">
						{t('textReverser.ui.transformationModeLabel')}
					</span>
				</div>
				<output
					id="rv-active-mode-desc"
					aria-live="polite"
					class="text-[13px] font-medium text-white/80"
				>
					{t('textReverser.ui.modeReverseAllDesc')}
				</output>
			</div>

			<!-- 6 Sleek Interactive Mode Pills -->
			<div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-6">
				<button
					type="button"
					data-reverse-mode="reverse-all"
					data-reverse-desc={t('textReverser.ui.modeReverseAllDesc')}
					class="rv-mode-btn cursor-pointer rounded-2xl border border-[#afe3d0] bg-[#afe3d0] px-3.5 py-3 text-left text-[#0f2e26] font-semibold transition-all"
				>
					<span class="block text-[14px] leading-tight">{t('textReverser.ui.modeReverseAllLabel')}</span>
					<span class="rv-mode-preview mt-1 block text-[11px] font-normal text-[#0f2e26]/75">{t('textReverser.ui.modeReverseAllPreview')}</span>
				</button>

				<button
					type="button"
					data-reverse-mode="word-order"
					data-reverse-desc={t('textReverser.ui.modeWordOrderDesc')}
					class="rv-mode-btn cursor-pointer rounded-2xl border border-[#afe3d0]/20 bg-white/[0.05] px-3.5 py-3 text-left text-white font-medium transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.09]"
				>
					<span class="block text-[14px] leading-tight">{t('textReverser.ui.modeWordOrderLabel')}</span>
					<span class="rv-mode-preview mt-1 block text-[11px] font-normal text-white/60">{t('textReverser.ui.modeWordOrderPreview')}</span>
				</button>

				<button
					type="button"
					data-reverse-mode="each-word"
					data-reverse-desc={t('textReverser.ui.modeEachWordDesc')}
					class="rv-mode-btn cursor-pointer rounded-2xl border border-[#afe3d0]/20 bg-white/[0.05] px-3.5 py-3 text-left text-white font-medium transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.09]"
				>
					<span class="block text-[14px] leading-tight">{t('textReverser.ui.modeEachWordLabel')}</span>
					<span class="rv-mode-preview mt-1 block text-[11px] font-normal text-white/60">{t('textReverser.ui.modeEachWordPreview')}</span>
				</button>

				<button
					type="button"
					data-reverse-mode="line-order"
					data-reverse-desc={t('textReverser.ui.modeLineOrderDesc')}
					class="rv-mode-btn cursor-pointer rounded-2xl border border-[#afe3d0]/20 bg-white/[0.05] px-3.5 py-3 text-left text-white font-medium transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.09]"
				>
					<span class="block text-[14px] leading-tight">{t('textReverser.ui.modeLineOrderLabel')}</span>
					<span class="rv-mode-preview mt-1 block text-[11px] font-normal text-white/60">{t('textReverser.ui.modeLineOrderPreview')}</span>
				</button>

				<button
					type="button"
					data-reverse-mode="upside-down"
					data-reverse-desc={t('textReverser.ui.modeUpsideDownDesc')}
					class="rv-mode-btn cursor-pointer rounded-2xl border border-[#afe3d0]/20 bg-white/[0.05] px-3.5 py-3 text-left text-white font-medium transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.09]"
				>
					<span class="block text-[14px] leading-tight">{t('textReverser.ui.modeUpsideDownLabel')}</span>
					<span class="rv-mode-preview mt-1 block text-[11px] font-normal text-white/60">{t('textReverser.ui.modeUpsideDownPreview')}</span>
				</button>

				<button
					type="button"
					data-reverse-mode="mirror-text"
					data-reverse-desc={t('textReverser.ui.modeMirrorTextDesc')}
					class="rv-mode-btn cursor-pointer rounded-2xl border border-[#afe3d0]/20 bg-white/[0.05] px-3.5 py-3 text-left text-white font-medium transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.09]"
				>
					<span class="block text-[14px] leading-tight">{t('textReverser.ui.modeMirrorTextLabel')}</span>
					<span class="rv-mode-preview mt-1 block text-[11px] font-normal text-white/60">{t('textReverser.ui.modeMirrorTextPreview')}</span>
				</button>
			</div>

			<!-- Compact Options Strip -->
			<div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-[#afe3d0]/15 pt-4 text-[13px]">
				<div class="flex flex-wrap items-center gap-5">
					<label class="inline-flex cursor-pointer items-center gap-2.5 text-white/90 select-none hover:text-white">
						<input
							type="checkbox"
							id="rv-opt-preserve-case"
							class="h-4 w-4 cursor-pointer rounded border-[#afe3d0]/40 bg-white/10 text-[#afe3d0] accent-[#afe3d0] focus:ring-0"
						/>
						<span>{t('textReverser.ui.optPreserveCase')}</span>
					</label>

					<label class="inline-flex cursor-pointer items-center gap-2.5 text-white/90 select-none hover:text-white">
						<input
							type="checkbox"
							id="rv-opt-line-by-line"
							class="h-4 w-4 cursor-pointer rounded border-[#afe3d0]/40 bg-white/10 text-[#afe3d0] accent-[#afe3d0] focus:ring-0"
						/>
						<span>{t('textReverser.ui.optLineByLine')}</span>
					</label>
				</div>

				<span class="text-[12px] text-[#afe3d0]/75">
					{t('textReverser.ui.privacyNote')}
				</span>
			</div>
		</div>
	</div>
</section>

<script type="application/json" id="trev-i18n" set:html={JSON.stringify(clientI18n).replace(/</g, '\\u003c')} />

<script>
	interface TrevClientI18n {
		locale: string;
		defaultModeDesc: string;
		palindromeYes: string;
		palindromeNo: string;
		withoutSpaces: string;
		copied: string;
		copyOutput: string;
		downloadFilename: string;
		samples: string[];
	}

	function initTextReverser() {
		const inputEl = document.getElementById('rv-input') as HTMLTextAreaElement | null;
		const outputEl = document.getElementById('rv-output') as HTMLTextAreaElement | null;
		const activeModeDescEl = document.getElementById('rv-active-mode-desc');
		const wordsEl = document.getElementById('rv-metric-words');
		const linesEl = document.getElementById('rv-metric-lines');
		const charsEl = document.getElementById('rv-metric-chars');
		const charsNoSpaceEl = document.getElementById('rv-metric-chars-nospace');

		const palindromeBadgeEl = document.getElementById('rv-palindrome-badge');
		const palindromeDotEl = document.getElementById('rv-palindrome-dot');
		const palindromeTextEl = document.getElementById('rv-palindrome-text');

		const modeBtns = document.querySelectorAll<HTMLButtonElement>('.rv-mode-btn');
		const pasteBtn = document.getElementById('rv-btn-paste');
		const sampleBtn = document.getElementById('rv-btn-sample');
		const fileUploadInput = document.getElementById('rv-file-upload') as HTMLInputElement | null;
		const clearBtn = document.getElementById('rv-btn-clear');
		const copyBtn = document.getElementById('rv-btn-copy');
		const downloadBtn = document.getElementById('rv-btn-download');
		const useAsInputBtn = document.getElementById('rv-btn-use-as-input');
		const swapBtn = document.getElementById('rv-btn-swap');

		const optPreserveCase = document.getElementById('rv-opt-preserve-case') as HTMLInputElement | null;
		const optLineByLine = document.getElementById('rv-opt-line-by-line') as HTMLInputElement | null;

		if (!inputEl || !outputEl) return;

		const fallbackI18n: TrevClientI18n = {
			locale: 'en',
			defaultModeDesc: 'Reverses every character end-to-end',
			palindromeYes: 'Palindrome: Yes',
			palindromeNo: 'Palindrome: No',
			withoutSpaces: '{count} without spaces',
			copied: 'Copied!',
			copyOutput: 'Copy Output',
			downloadFilename: 'reversed-text.txt',
			samples: [
				"Madam, in Eden, I'm Adam.",
				"A man, a plan, a canal: Panama!",
				"Step 1: Research audience intent\nStep 2: Draft clear headline\nStep 3: Polish and publish",
				"Never odd or even.",
				"Reading and writing clearly makes complex ideas simple.",
			],
		};

		let i18n: TrevClientI18n = fallbackI18n;
		const i18nEl = document.getElementById('trev-i18n');
		if (i18nEl?.textContent) {
			try {
				const parsed = JSON.parse(i18nEl.textContent) as Partial<TrevClientI18n>;
				i18n = {
					...fallbackI18n,
					...parsed,
					samples:
						Array.isArray(parsed.samples) && parsed.samples.length > 0
							? parsed.samples
							: fallbackI18n.samples,
				};
			} catch {
				// Use fallback English strings if JSON fails to parse
			}
		}

		function fmt(template: string, vars: Record<string, string | number>): string {
			return template.replace(/\{(\w+)\}/g, (_, key: string) => String(vars[key] ?? `{${key}}`));
		}

		let currentMode = 'reverse-all';
		let sampleIndex = 0;

		const SAMPLES = i18n.samples;

		const UPSIDE_DOWN_MAP: Record<string, string> = {
			a: 'ɐ', b: 'q', c: 'ɔ', d: 'p', e: 'ǝ', f: 'ɟ', g: 'ƃ', h: 'ɥ', i: 'ᴉ',
			j: 'ɾ', k: 'ʞ', l: 'l', m: 'ɯ', n: 'u', o: 'o', p: 'd', q: 'b', r: 'ɹ',
			s: 's', t: 'ʇ', u: 'n', v: 'ʌ', w: 'ʍ', x: 'x', y: 'ʎ', z: 'z',
			A: '∀', B: 'ᙠ', C: 'Ɔ', D: 'ᗡ', E: 'Ǝ', F: 'Ⅎ', G: '⅁', H: 'H', I: 'I',
			J: 'ſ', K: 'ʞ', L: '˥', M: 'W', N: 'N', O: 'O', P: 'Ԁ', Q: 'Ό', R: 'ᴚ',
			S: 'S', T: '⊥', U: '∩', V: 'Λ', W: 'M', X: 'X', Y: '⅄', Z: 'Z',
			'0': '0', '1': 'Ɩ', '2': 'ᄅ', '3': 'Ɛ', '4': 'ㄣ', '5': 'ϛ', '6': '9',
			'7': 'ㄥ', '8': '8', '9': '6',
			'.': '˙', ',': "'", "'": ',', '"': '„', '?': '¿', '!': '¡',
			'(': ')', ')': '(', '[': ']', ']': '[', '{': '}', '}': '{',
			'<': '>', '>': '<', '&': '⅋', '_': '‾'
		};

		const MIRROR_MAP: Record<string, string> = {
			a: 'ɒ', b: 'd', c: 'ɔ', d: 'b', e: 'ɘ', f: 'Ꮈ', g: 'ǫ', h: 'ʜ', i: 'i',
			j: 'ꞁ', k: 'ʞ', l: 'l', m: 'm', n: 'n', o: 'o', p: 'q', q: 'p', r: 'ɿ',
			s: 'ꙅ', t: 'ƚ', u: 'u', v: 'v', w: 'w', x: 'x', y: 'y', z: 'z',
			A: 'A', B: 'ᙠ', C: 'Ɔ', D: 'ᗡ', E: 'Ǝ', F: 'ꟻ', G: 'Ә', H: 'H', I: 'I',
			J: 'Ⴑ', K: '⋊', L: '⅃', M: 'M', N: 'И', O: 'O', P: 'Ꝺ', Q: 'Ọ', R: 'Я',
			S: 'Ꙅ', T: 'T', U: 'U', V: 'V', W: 'W', X: 'X', Y: 'Y', Z: 'S',
			'(': ')', ')': '(', '[': ']', ']': '[', '{': '}', '}': '{',
			'<': '>', '>': '<', '?': '⸮'
		};

		function toChars(str: string): string[] {
			return Array.from(str);
		}

		function applyCasePattern(source: string, target: string): string {
			const srcChars = toChars(source);
			const tgtChars = toChars(target);
			return tgtChars
				.map((ch, idx) => {
					const ref = srcChars[idx];
					if (!ref) return ch;
					const isUpper = ref >= 'A' && ref <= 'Z';
					const isLower = ref >= 'a' && ref <= 'z';
					if (isUpper) return ch.toUpperCase();
					if (isLower) return ch.toLowerCase();
					return ch;
				})
				.join('');
		}

		function reverseStringSegment(segment: string, preserveCase: boolean): string {
			const reversed = toChars(segment).reverse().join('');
			return preserveCase ? applyCasePattern(segment, reversed) : reversed;
		}

		function reverseAllText(text: string, lineByLine: boolean, preserveCase: boolean): string {
			if (lineByLine) {
				return text
					.split(/(\r?\n)/)
					.map((part) => (/^\r?\n$/.test(part) ? part : reverseStringSegment(part, preserveCase)))
					.join('');
			}
			return reverseStringSegment(text, preserveCase);
		}

		function reverseWordOrder(text: string, lineByLine: boolean, preserveCase: boolean): string {
			const processSegment = (seg: string) => {
				if (!seg.trim()) return seg;
				const words = seg.trim().split(/\s+/);
				const joined = words.reverse().join(' ');
				return preserveCase ? applyCasePattern(seg.trim(), joined) : joined;
			};

			if (lineByLine) {
				return text
					.split(/(\r?\n)/)
					.map((line) => (/^\r?\n$/.test(line) ? line : processSegment(line)))
					.join('');
			}

			const allLinesReversed = text
				.split(/(\r?\n)/)
				.reverse()
				.map((line) => (/^\r?\n$/.test(line) ? line : processSegment(line)))
				.join('');
			return allLinesReversed;
		}

		function reverseEachWordIndividually(text: string, preserveCase: boolean): string {
			return text.replace(/\S+/g, (word) => reverseStringSegment(word, preserveCase));
		}

		function reverseLineOrder(text: string): string {
			return text.split(/\r?\n/).reverse().join('\n');
		}

		function flipTextUpsideDown(text: string, lineByLine: boolean): string {
			const lines = text.split(/\r?\n/);
			const orderedLines = lineByLine ? lines : [...lines].reverse();
			return orderedLines
				.map((line) =>
					toChars(line)
						.reverse()
						.map((ch) => UPSIDE_DOWN_MAP[ch] ?? ch)
						.join('')
				)
				.join('\n');
		}

		function mirrorTextTransform(text: string, lineByLine: boolean): string {
			const lines = text.split(/\r?\n/);
			const orderedLines = lineByLine ? lines : [...lines].reverse();
			return orderedLines
				.map((line) =>
					toChars(line)
						.reverse()
						.map((ch) => MIRROR_MAP[ch] ?? UPSIDE_DOWN_MAP[ch] ?? ch)
						.join('')
				)
				.join('\n');
		}

		function updatePalindromeBadge(raw: string) {
			if (!palindromeBadgeEl || !palindromeDotEl || !palindromeTextEl) return;
			const cleanAlpha = raw.toLowerCase().replace(/[^a-z0-9]/g, '');
			const isPalindrome =
				cleanAlpha.length >= 2 && cleanAlpha === toChars(cleanAlpha).reverse().join('');

			if (isPalindrome) {
				palindromeBadgeEl.className =
					'inline-flex items-center gap-1.5 rounded-full border border-[#7ed4b6] bg-[#afe3d0] px-3 py-0.5 text-[12px] font-semibold text-[#0f2e26] transition-all';
				palindromeDotEl.className = 'h-1.5 w-1.5 rounded-full bg-[#0f2e26]';
				palindromeTextEl.textContent = i18n.palindromeYes;
			} else {
				palindromeBadgeEl.className =
					'inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-muted px-3 py-0.5 text-[12px] font-medium text-mute transition-all';
				palindromeDotEl.className = 'h-1.5 w-1.5 rounded-full bg-mute/60';
				palindromeTextEl.textContent = i18n.palindromeNo;
			}
		}

		function transformText() {
			if (!inputEl || !outputEl) return;
			const raw = inputEl.value;
			const preserveCase = Boolean(optPreserveCase?.checked);
			const lineByLine = Boolean(optLineByLine?.checked);
			let result = '';

			switch (currentMode) {
				case 'reverse-all':
					result = reverseAllText(raw, lineByLine, preserveCase);
					break;
				case 'word-order':
					result = reverseWordOrder(raw, lineByLine, preserveCase);
					break;
				case 'each-word':
					result = reverseEachWordIndividually(raw, preserveCase);
					break;
				case 'line-order':
					result = reverseLineOrder(raw);
					break;
				case 'upside-down':
					result = flipTextUpsideDown(raw, lineByLine);
					break;
				case 'mirror-text':
					result = mirrorTextTransform(raw, lineByLine);
					break;
			}

			outputEl.value = result;

			// Live Stats
			const trimmed = raw.trim();
			const words = trimmed ? trimmed.split(/\s+/).length : 0;
			const lines = raw.length > 0 ? raw.split(/\r?\n/).length : 0;
			const chars = raw.length;
			const charsNoSpace = raw.replace(/\s/g, '').length;

			if (wordsEl) wordsEl.textContent = words.toLocaleString(i18n.locale);
			if (charsEl) charsEl.textContent = chars.toLocaleString(i18n.locale);
			if (linesEl) linesEl.textContent = lines.toLocaleString(i18n.locale);
			if (charsNoSpaceEl) {
				charsNoSpaceEl.textContent = fmt(i18n.withoutSpaces, {
					count: charsNoSpace.toLocaleString(i18n.locale),
				});
			}

			updatePalindromeBadge(raw);
		}

		modeBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				currentMode = btn.dataset.reverseMode || 'reverse-all';
				const desc = btn.dataset.reverseDesc || i18n.defaultModeDesc;
				if (activeModeDescEl) activeModeDescEl.textContent = desc;

				modeBtns.forEach((b) => {
					const isActive = b === btn;
					const previewSpan = b.querySelector('.rv-mode-preview');
					if (isActive) {
						b.className =
							'rv-mode-btn cursor-pointer rounded-2xl border border-[#afe3d0] bg-[#afe3d0] px-3.5 py-3 text-left text-[#0f2e26] font-semibold transition-all';
						if (previewSpan) previewSpan.className = 'rv-mode-preview mt-1 block text-[11px] font-normal text-[#0f2e26]/75';
					} else {
						b.className =
							'rv-mode-btn cursor-pointer rounded-2xl border border-[#afe3d0]/20 bg-white/[0.05] px-3.5 py-3 text-left text-white font-medium transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.09]';
						if (previewSpan) previewSpan.className = 'rv-mode-preview mt-1 block text-[11px] font-normal text-white/60';
					}
				});

				transformText();
			});
		});

		inputEl.addEventListener('input', transformText);
		optPreserveCase?.addEventListener('change', transformText);
		optLineByLine?.addEventListener('change', transformText);

		pasteBtn?.addEventListener('click', async () => {
			try {
				const text = await navigator.clipboard.readText();
				if (text) {
					inputEl.value = text;
					transformText();
				}
			} catch {
				inputEl.focus();
			}
		});

		sampleBtn?.addEventListener('click', () => {
			sampleIndex = (sampleIndex + 1) % SAMPLES.length;
			inputEl.value = SAMPLES[sampleIndex];
			transformText();
		});

		fileUploadInput?.addEventListener('change', (e) => {
			const target = e.target as HTMLInputElement;
			const file = target.files?.[0];
			if (!file) return;
			const reader = new FileReader();
			reader.onload = () => {
				if (typeof reader.result === 'string') {
					inputEl.value = reader.result;
					transformText();
				}
			};
			reader.readAsText(file);
			target.value = '';
		});

		clearBtn?.addEventListener('click', () => {
			inputEl.value = '';
			transformText();
			inputEl.focus();
		});

		function sendOutputToInput() {
			if (!outputEl || !inputEl || !outputEl.value) return;
			inputEl.value = outputEl.value;
			transformText();
		}

		useAsInputBtn?.addEventListener('click', sendOutputToInput);
		swapBtn?.addEventListener('click', sendOutputToInput);

		copyBtn?.addEventListener('click', async () => {
			if (!outputEl.value) return;
			try {
				await navigator.clipboard.writeText(outputEl.value);
				copyBtn.textContent = i18n.copied;
				setTimeout(() => {
					copyBtn.textContent = i18n.copyOutput;
				}, 1600);
			} catch {
				outputEl.select();
				document.execCommand('copy');
			}
		});

		downloadBtn?.addEventListener('click', () => {
			if (!outputEl.value) return;
			const blob = new Blob([outputEl.value], { type: 'text/plain;charset=utf-8' });
			const url = URL.createObjectURL(blob);
			const link = document.createElement('a');
			link.href = url;
			link.download = i18n.downloadFilename;
			document.body.appendChild(link);
			link.click();
			document.body.removeChild(link);
			URL.revokeObjectURL(url);
		});

		transformText();
	}

	initTextReverser();
	document.addEventListener('astro:page-load', initTextReverser);
</script>
