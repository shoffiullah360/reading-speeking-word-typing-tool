---
import { getLocaleFromUrl, useTranslations, type Locale } from '../i18n/ui';

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const clientI18n = {
	locale,
	originalText: t('caseConverter.client.originalText'),
	converted: t('caseConverter.client.converted'),
	pasted: t('caseConverter.client.pasted'),
	copied: t('caseConverter.client.copied'),
	btnPaste: t('caseConverter.client.btnPaste'),
	btnCopy: t('caseConverter.client.btnCopy'),
	downloadFilename: t('caseConverter.client.downloadFilename'),
};
---

<section
	id="case-converter-workspace"
	aria-label={t('caseConverter.ui.workspaceAria')}
	class="mx-auto max-w-[1200px] px-4 pt-4 pb-12 sm:px-6"
>
	<!-- Unified Stacked Card Container -->
	<div class="whisper-shadow overflow-hidden rounded-3xl border border-hairline bg-canvas-elevated">
		<!-- Top Section — Full-Width Distraction-Free Editor -->
		<div class="flex flex-col justify-between bg-white p-6 sm:p-8 dark:bg-canvas-elevated">
			<div class="flex flex-1 flex-col">
				<label for="cc-textarea" class="sr-only">{t('caseConverter.ui.textareaLabel')}</label>
				<textarea
					id="cc-textarea"
					placeholder={t('caseConverter.ui.textareaPlaceholder')}
					class="h-48 w-full resize-y border-0 bg-transparent font-sans text-[16px] leading-[28px] text-ink placeholder:text-faint focus:outline-none sm:h-56"
				></textarea>
			</div>

			<!-- Minimal Footer Bar -->
			<div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-hairline pt-4 text-[13px]">
				<div class="inline-flex items-center gap-1.5 rounded-xl border border-[#1d463b] bg-[#0f2e26] px-3.5 py-1.5 font-medium text-[#e2f5ee] tabular-nums">
					<output id="cc-metric-words" aria-live="polite" class="font-semibold text-[#afe3d0]">0</output> {t('caseConverter.ui.wordsUnit')} &middot;
					<output id="cc-metric-chars" aria-live="polite" class="font-semibold text-[#afe3d0]">0</output> {t('caseConverter.ui.charactersUnit')} &middot;
					<output id="cc-metric-lines" aria-live="polite" class="font-semibold text-[#afe3d0]">0</output> {t('caseConverter.ui.linesUnit')}
				</div>

				<div class="flex flex-wrap items-center gap-3.5 sm:gap-4">
					<button
						type="button"
						id="cc-btn-paste"
						class="cursor-pointer font-medium text-mute transition-colors hover:text-ink"
					>
						{t('caseConverter.ui.btnPaste')}
					</button>
					<button
						type="button"
						id="cc-btn-undo"
						disabled
						class="cursor-pointer font-medium text-mute transition-colors hover:text-ink disabled:cursor-not-allowed disabled:opacity-40"
					>
						{t('caseConverter.ui.btnUndo')}
					</button>
					<button
						type="button"
						id="cc-btn-download"
						class="cursor-pointer font-medium text-mute transition-colors hover:text-ink"
					>
						{t('caseConverter.ui.btnDownload')}
					</button>
					<button
						type="button"
						id="cc-btn-clear"
						class="cursor-pointer font-medium text-mute transition-colors hover:text-vercel-error"
					>
						{t('caseConverter.ui.btnClear')}
					</button>
				</div>
			</div>
		</div>

		<!-- Bottom Section — Deep Forest Emerald Control Deck -->
		<div class="border-t border-[#afe3d0]/15 bg-[#0f2e26] p-6 text-[#f0fdf7] sm:p-8">
			<!-- Active Format & Primary Action Header -->
			<div class="flex flex-wrap items-center justify-between gap-4 border-b border-[#afe3d0]/15 pb-5">
				<div class="inline-flex items-center gap-2 rounded-full border border-[#afe3d0]/20 bg-white/[0.05] px-3.5 py-1.5 text-[13px]">
					<span class="h-2 w-2 rounded-full bg-[#afe3d0]"></span>
					<span class="text-white/70">{t('caseConverter.ui.activeLabel')}</span>
					<output id="cc-active-mode" aria-live="polite" class="font-semibold text-[#afe3d0]">
						{t('caseConverter.ui.originalText')}
					</output>
				</div>

				<button
					type="button"
					id="cc-btn-copy"
					class="cursor-pointer rounded-2xl bg-[#afe3d0] px-5 py-2.5 text-[14px] font-semibold text-[#0f2e26] transition-all hover:bg-[#c2edd6] active:scale-[0.99]"
				>
					{t('caseConverter.ui.btnCopy')}
				</button>
			</div>

			<!-- Two Clean Case Button Groups -->
			<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-8">
				<!-- Group 1: Writing & Editorial Cases -->
				<div class="lg:col-span-7">
					<span class="block text-[12px] font-medium text-[#afe3d0]/80">
						{t('caseConverter.ui.groupWriting')}
					</span>
					<div class="mt-3 flex flex-wrap gap-2.5">
						<button
							type="button"
							data-case-mode="sentence"
							data-case-label={t('caseConverter.ui.modes.sentence')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.sentence')}
						</button>
						<button
							type="button"
							data-case-mode="lower"
							data-case-label={t('caseConverter.ui.modes.lower')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.lower')}
						</button>
						<button
							type="button"
							data-case-mode="upper"
							data-case-label={t('caseConverter.ui.modes.upper')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.upper')}
						</button>
						<button
							type="button"
							data-case-mode="title"
							data-case-label={t('caseConverter.ui.modes.title')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.title')}
						</button>
						<button
							type="button"
							data-case-mode="capitalized"
							data-case-label={t('caseConverter.ui.modes.capitalized')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.capitalized')}
						</button>
						<button
							type="button"
							data-case-mode="alternating"
							data-case-label={t('caseConverter.ui.modes.alternating')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.alternating')}
						</button>
						<button
							type="button"
							data-case-mode="inverse"
							data-case-label={t('caseConverter.ui.modes.inverse')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.inverse')}
						</button>
					</div>
				</div>

				<!-- Group 2: Developer & Code Cases -->
				<div class="border-t border-[#afe3d0]/15 pt-5 lg:col-span-5 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
					<span class="block text-[12px] font-medium text-[#afe3d0]/80">
						{t('caseConverter.ui.groupDeveloper')}
					</span>
					<div class="mt-3 flex flex-wrap gap-2.5">
						<button
							type="button"
							data-case-mode="camel"
							data-case-label={t('caseConverter.ui.modes.camel')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.camel')}
						</button>
						<button
							type="button"
							data-case-mode="pascal"
							data-case-label={t('caseConverter.ui.modes.pascal')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.pascal')}
						</button>
						<button
							type="button"
							data-case-mode="snake"
							data-case-label={t('caseConverter.ui.modes.snake')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.snake')}
						</button>
						<button
							type="button"
							data-case-mode="constant"
							data-case-label={t('caseConverter.ui.modes.constant')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.constant')}
						</button>
						<button
							type="button"
							data-case-mode="kebab"
							data-case-label={t('caseConverter.ui.modes.kebab')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.kebab')}
						</button>
						<button
							type="button"
							data-case-mode="dot"
							data-case-label={t('caseConverter.ui.modes.dot')}
							class="cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]"
						>
							{t('caseConverter.ui.modes.dot')}
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script type="application/json" id="cc-i18n" set:html={JSON.stringify(clientI18n).replace(/</g, '\\u003c')} />

<script>
	interface CcClientI18n {
		locale: string;
		originalText: string;
		converted: string;
		pasted: string;
		copied: string;
		btnPaste: string;
		btnCopy: string;
		downloadFilename: string;
	}

	function initCaseConverter() {
		const fallbackI18n: CcClientI18n = {
			locale: 'en',
			originalText: 'Original text',
			converted: 'Converted',
			pasted: 'Pasted!',
			copied: 'Copied!',
			btnPaste: 'Paste',
			btnCopy: 'Copy text',
			downloadFilename: 'converted-text.txt',
		};

		let i18n: CcClientI18n = fallbackI18n;
		const i18nEl = document.getElementById('cc-i18n');
		if (i18nEl?.textContent) {
			try {
				const parsed = JSON.parse(i18nEl.textContent) as Partial<CcClientI18n>;
				i18n = {
					...fallbackI18n,
					...parsed,
				};
			} catch {
				// Use fallback English strings if JSON fails to parse
			}
		}

		const textarea = document.getElementById('cc-textarea') as HTMLTextAreaElement | null;
		const activeModeEl = document.getElementById('cc-active-mode');
		const wordsEl = document.getElementById('cc-metric-words');
		const charsEl = document.getElementById('cc-metric-chars');
		const linesEl = document.getElementById('cc-metric-lines');

		const pasteBtn = document.getElementById('cc-btn-paste');
		const undoBtn = document.getElementById('cc-btn-undo') as HTMLButtonElement | null;
		const copyBtn = document.getElementById('cc-btn-copy');
		const downloadBtn = document.getElementById('cc-btn-download');
		const clearBtn = document.getElementById('cc-btn-clear');
		const modeBtns = document.querySelectorAll<HTMLButtonElement>('.cc-mode-btn');

		if (!textarea) return;

		const historyStack: Array<{ text: string; label: string }> = [];

		const MINOR_WORDS = new Set([
			'a', 'an', 'and', 'as', 'at', 'but', 'by', 'for', 'from', 'in', 'into',
			'nor', 'of', 'on', 'onto', 'or', 'over', 'per', 'so', 'than', 'that',
			'the', 'to', 'up', 'upon', 'via', 'with', 'yet'
		]);

		function updateUndoButton() {
			if (!undoBtn) return;
			undoBtn.disabled = historyStack.length === 0;
		}

		function saveSnapshot() {
			if (!textarea) return;
			const currentLabel = activeModeEl?.textContent?.trim() || i18n.originalText;
			const last = historyStack[historyStack.length - 1];
			if (!last || last.text !== textarea.value) {
				historyStack.push({ text: textarea.value, label: currentLabel });
				if (historyStack.length > 25) historyStack.shift();
				updateUndoButton();
			}
		}

		function toSentenceCase(text: string): string {
			return text
				.toLowerCase()
				.replace(/(^\s*[a-z]|[.!?]\s+[a-z]|\n\s*[a-z])/g, (match) => match.toUpperCase())
				.replace(/\bi\b/g, 'I');
		}

		function toCapitalizedCase(text: string): string {
			return text
				.toLowerCase()
				.replace(/(^|[\s\-/—(["'])([a-z])/g, (_, sep, char) => sep + char.toUpperCase());
		}

		function toTitleCase(text: string): string {
			return text
				.split(/(\r?\n)/)
				.map((line) => {
					if (/^\r?\n$/.test(line)) return line;
					const tokens = line.split(/(\s+)/);
					const wordIndices: number[] = [];
					tokens.forEach((tok, idx) => {
						if (/\S/.test(tok)) wordIndices.push(idx);
					});
					if (wordIndices.length === 0) return line;
					const firstIdx = wordIndices[0];
					const lastIdx = wordIndices[wordIndices.length - 1];

					return tokens
						.map((tok, idx) => {
							if (!/\S/.test(tok)) return tok;
							const prevWordIdx = wordIndices[wordIndices.indexOf(idx) - 1];
							const prevToken = prevWordIdx !== undefined ? tokens[prevWordIdx] : '';
							const followsColon = /[:;—-]$/.test(prevToken);
							const lower = tok.toLowerCase();
							const bare = lower.replace(/^[^a-z0-9]+|[^a-z0-9]+$/g, '');

							if (idx === firstIdx || idx === lastIdx || followsColon || !MINOR_WORDS.has(bare)) {
								return lower.replace(/[a-z]/, (c) => c.toUpperCase());
							}
							return lower;
						})
						.join('');
				})
				.join('');
		}

		function toAlternatingCase(text: string): string {
			let index = 0;
			return Array.from(text)
				.map((ch) => {
					if (/[a-zA-Z]/.test(ch)) {
						const res = index % 2 === 0 ? ch.toLowerCase() : ch.toUpperCase();
						index++;
						return res;
					}
					return ch;
				})
				.join('');
		}

		function toInverseCase(text: string): string {
			return Array.from(text)
				.map((ch) => {
					if (ch >= 'a' && ch <= 'z') return ch.toUpperCase();
					if (ch >= 'A' && ch <= 'Z') return ch.toLowerCase();
					return ch;
				})
				.join('');
		}

		function extractWordsForIdentifier(line: string): string[] {
			const normalized = line
				.replace(/([a-z0-9])([A-Z])/g, '$1 $2')
				.replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2')
				.replace(/[_\-.]+/g, ' ')
				.replace(/[^\p{L}\p{N}\s]+/gu, ' ')
				.trim();
			return normalized ? normalized.split(/\s+/) : [];
		}

		function toCamelCase(text: string): string {
			return text
				.split(/\r?\n/)
				.map((line) => {
					const words = extractWordsForIdentifier(line);
					if (words.length === 0) return '';
					return words
						.map((w, idx) => {
							const lower = w.toLowerCase();
							return idx === 0 ? lower : lower.charAt(0).toUpperCase() + lower.slice(1);
						})
						.join('');
				})
				.join('\n');
		}

		function toPascalCase(text: string): string {
			return text
				.split(/\r?\n/)
				.map((line) => {
					const words = extractWordsForIdentifier(line);
					if (words.length === 0) return '';
					return words
						.map((w) => {
							const lower = w.toLowerCase();
							return lower.charAt(0).toUpperCase() + lower.slice(1);
						})
						.join('');
				})
				.join('\n');
		}

		function toSnakeCase(text: string): string {
			return text
				.split(/\r?\n/)
				.map((line) =>
					extractWordsForIdentifier(line)
						.map((w) => w.toLowerCase())
						.join('_')
				)
				.join('\n');
		}

		function toConstantCase(text: string): string {
			return text
				.split(/\r?\n/)
				.map((line) =>
					extractWordsForIdentifier(line)
						.map((w) => w.toUpperCase())
						.join('_')
				)
				.join('\n');
		}

		function toKebabCase(text: string): string {
			return text
				.split(/\r?\n/)
				.map((line) =>
					extractWordsForIdentifier(line)
						.map((w) => w.toLowerCase())
						.join('-')
				)
				.join('\n');
		}

		function toDotCase(text: string): string {
			return text
				.split(/\r?\n/)
				.map((line) =>
					extractWordsForIdentifier(line)
						.map((w) => w.toLowerCase())
						.join('.')
				)
				.join('\n');
		}

		function updateStats() {
			if (!textarea) return;
			const val = textarea.value;
			const trimmed = val.trim();
			const words = trimmed ? trimmed.split(/\s+/).length : 0;
			const chars = val.length;
			const lines = val.length > 0 ? val.split(/\r?\n/).length : 0;

			if (wordsEl) wordsEl.textContent = words.toLocaleString(i18n.locale);
			if (charsEl) charsEl.textContent = chars.toLocaleString(i18n.locale);
			if (linesEl) linesEl.textContent = lines.toLocaleString(i18n.locale);
		}

		function highlightActiveButton(activeBtn: HTMLButtonElement | null) {
			modeBtns.forEach((btn) => {
				const isCurrent = btn === activeBtn;
				btn.className = isCurrent
					? 'cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0] bg-[#afe3d0] px-4 py-2.5 text-[14px] font-semibold text-[#0f2e26] transition-all'
					: 'cc-mode-btn cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.04] px-4 py-2.5 text-[14px] font-medium text-white transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.08]';
			});
		}

		modeBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const mode = btn.dataset.caseMode;
				const label = btn.dataset.caseLabel || i18n.converted;
				const current = textarea.value;
				if (!current) {
					textarea.focus();
					return;
				}

				saveSnapshot();

				let converted = current;
				switch (mode) {
					case 'sentence':
						converted = toSentenceCase(current);
						break;
					case 'lower':
						converted = current.toLowerCase();
						break;
					case 'upper':
						converted = current.toUpperCase();
						break;
					case 'title':
						converted = toTitleCase(current);
						break;
					case 'capitalized':
						converted = toCapitalizedCase(current);
						break;
					case 'alternating':
						converted = toAlternatingCase(current);
						break;
					case 'inverse':
						converted = toInverseCase(current);
						break;
					case 'camel':
						converted = toCamelCase(current);
						break;
					case 'pascal':
						converted = toPascalCase(current);
						break;
					case 'snake':
						converted = toSnakeCase(current);
						break;
					case 'constant':
						converted = toConstantCase(current);
						break;
					case 'kebab':
						converted = toKebabCase(current);
						break;
					case 'dot':
						converted = toDotCase(current);
						break;
				}

				textarea.value = converted;
				if (activeModeEl) activeModeEl.textContent = label;
				highlightActiveButton(btn);
				updateStats();
			});
		});

		textarea.addEventListener('input', () => {
			updateStats();
		});

		pasteBtn?.addEventListener('click', async () => {
			try {
				const text = await navigator.clipboard.readText();
				if (text && textarea) {
					if (textarea.value) saveSnapshot();
					textarea.value = text;
					if (activeModeEl) activeModeEl.textContent = i18n.originalText;
					highlightActiveButton(null);
					updateStats();
					pasteBtn.textContent = i18n.pasted;
					setTimeout(() => {
						pasteBtn.textContent = i18n.btnPaste;
					}, 1500);
				}
			} catch {
				textarea?.focus();
			}
		});

		undoBtn?.addEventListener('click', () => {
			const prev = historyStack.pop();
			if (!prev || !textarea) return;
			textarea.value = prev.text;
			if (activeModeEl) activeModeEl.textContent = prev.label;
			highlightActiveButton(null);
			updateUndoButton();
			updateStats();
		});

		copyBtn?.addEventListener('click', async () => {
			if (!textarea.value) return;
			try {
				await navigator.clipboard.writeText(textarea.value);
				copyBtn.textContent = i18n.copied;
				setTimeout(() => {
					copyBtn.textContent = i18n.btnCopy;
				}, 1600);
			} catch {
				textarea.select();
				document.execCommand('copy');
			}
		});

		downloadBtn?.addEventListener('click', () => {
			if (!textarea.value) return;
			const blob = new Blob([textarea.value], { type: 'text/plain;charset=utf-8' });
			const url = URL.createObjectURL(blob);
			const link = document.createElement('a');
			link.href = url;
			link.download = i18n.downloadFilename;
			document.body.appendChild(link);
			link.click();
			document.body.removeChild(link);
			URL.revokeObjectURL(url);
		});

		clearBtn?.addEventListener('click', () => {
			if (textarea.value) saveSnapshot();
			textarea.value = '';
			if (activeModeEl) activeModeEl.textContent = i18n.originalText;
			highlightActiveButton(null);
			updateStats();
			textarea.focus();
		});

		updateStats();
		updateUndoButton();
	}

	initCaseConverter();
	document.addEventListener('astro:page-load', initCaseConverter);
</script>
