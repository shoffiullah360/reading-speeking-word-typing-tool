---
import {
	SITE_CONFIG,
	STANDALONE_TOOLS,
	getLiveTools,
	getStandaloneToolsForLocale,
	normalizeTrailingSlashPath,
} from '../config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/ui';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const currentPath = normalizeTrailingSlashPath(Astro.url.pathname);
const liveTools = getLiveTools();
const liveStandaloneTools = getStandaloneToolsForLocale(locale);

interface NavToolLink {
	slug: string;
	shortName: string;
}

interface NavCategory {
	label: string;
	id: string;
	tools: NavToolLink[];
	isActiveCategory: boolean;
}

const localizedLinks = (tools: typeof liveTools): NavToolLink[] =>
	tools.map((tool) => ({
		slug: getLocalizedPath(tool.slug, locale),
		shortName: t(`${tool.dictKey}.shortName`),
	}));

/** Standalone tools keep a single root URL, so their slug is never locale-prefixed. */
const standaloneLinks = (category: string): NavToolLink[] =>
	liveStandaloneTools
		.filter((tool) => tool.category === category)
		.map((tool) => ({ slug: tool.slug, shortName: tool.shortName }));

const categoriesWithTools: NavCategory[] = [
	{
		label: t('nav.reading'),
		id: 'reading',
		tools: localizedLinks(liveTools.filter((tool) => tool.category === 'Reading')),
		isActiveCategory: false,
	},
	{
		label: t('nav.writing'),
		id: 'writing',
		tools: localizedLinks(liveTools.filter((tool) => tool.category === 'Writing')),
		isActiveCategory: false,
	},
	{
		label: t('nav.speaking'),
		id: 'speaking',
		tools: localizedLinks(
			liveTools.filter((tool) => tool.category === 'Speaking' && tool.slug !== '/random-topic-generator/')
		),
		isActiveCategory: false,
	},
	{
		label: t('nav.text'),
		id: 'text',
		tools: localizedLinks(liveTools.filter((tool) => tool.category === 'Text')),
		isActiveCategory: false,
	},
	{
		label: t('nav.random'),
		id: 'random',
		tools: localizedLinks(liveTools.filter((tool) => tool.slug === '/random-topic-generator/')),
		isActiveCategory: false,
	},
	{
		label: t('nav.typing'),
		id: 'typing',
		tools: [...localizedLinks(liveTools.filter((tool) => tool.category === 'Typing')), ...standaloneLinks('Typing')],
		isActiveCategory: false,
	},
].map((cat) => ({
	...cat,
	isActiveCategory: cat.tools.some((tool) => tool.slug === currentPath),
}));
---

<header class="sticky top-0 z-50 w-full border-b border-[#e2e8e5] bg-[#ffffff] backdrop-blur-md dark:border-hairline dark:bg-header-bg">
	<div class="mx-auto flex max-w-[1200px] items-center justify-between gap-3 px-3 py-2.5 sm:px-6 lg:gap-4 lg:py-3.5">
		<!-- Left: Wordora Brand Logo -->
		<a
			href={getLocalizedPath('/', locale)}
			class="group flex min-w-0 shrink-0 items-center gap-2 text-[#0f172a] focus:outline-none sm:gap-2.5 dark:text-ink"
			aria-label={t('nav.home', { name: SITE_CONFIG.name })}
		>
			<span class="brand-badge flex h-7 w-7 shrink-0 items-center justify-center rounded-sm border border-[#0f2e26] bg-[#0f2e26] text-[#afe3d0] transition-transform duration-150 group-hover:scale-105 dark:border-transparent dark:bg-primary dark:text-on-primary">
				<svg
					class="h-4 w-4"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.3"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M4 6.5L8 18.5L12 9.5L16 18.5L20 6.5" />
				</svg>
			</span>
			<span class="text-[16px] font-semibold tracking-[-0.3px] text-[#0f172a] dark:text-ink">
				{SITE_CONFIG.name}
			</span>
		</a>

		<!-- Center: Category Dropdowns (Desktop / large tablet) -->
		<nav
			aria-label={t('nav.primaryNav')}
			class="hidden min-w-0 items-center gap-0.5 whitespace-nowrap lg:flex xl:gap-1.5"
		>
			{
				categoriesWithTools.map(({ label, id, tools, isActiveCategory }) => (
					<div class="relative" data-nav-dropdown={id}>
						<button
							type="button"
							id={`nav-trigger-${id}`}
							data-nav-trigger={id}
							data-active-category={isActiveCategory ? 'true' : 'false'}
							aria-expanded="false"
							aria-haspopup="true"
							aria-controls={`nav-panel-${id}`}
							class={`inline-flex min-h-[38px] cursor-pointer items-center gap-1 rounded-full px-2.5 py-1.5 text-[13px] transition-colors hover:bg-[#e6f7f1] hover:text-[#0f2e26] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0f2e26] xl:px-3.5 xl:text-[14px] dark:hover:bg-hairline-soft dark:hover:text-ink dark:focus-visible:outline-vercel-blue ${
								isActiveCategory
									? 'bg-[#afe3d0] font-semibold text-[#0f2e26] dark:bg-hairline-soft dark:text-ink'
									: 'font-normal text-[#0f172a] dark:text-body'
							}`}
						>
							<span>{label}</span>
							<svg
								data-nav-chevron={id}
								class={`h-3.5 w-3.5 transition-transform duration-150 ${
									isActiveCategory
										? 'text-[#0f2e26] dark:text-mute'
										: 'text-[#334155] dark:text-mute'
								}`}
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="m6 9 6 6 6-6" />
							</svg>
						</button>

						<!-- Elevated Dropdown Card -->
						<div
							id={`nav-panel-${id}`}
							data-nav-panel={id}
							role="menu"
							aria-label={t('nav.categoryTools', { category: label })}
							class="floating-shadow invisible absolute left-1/2 top-full z-50 mt-2 max-w-[calc(100vw-2rem)] min-w-[200px] -translate-x-1/2 rounded-md border border-[#e2e8e5] bg-[#ffffff] p-1.5 opacity-0 transition-all duration-150 dark:border-hairline dark:bg-[#141416]"
						>
							<ul class="space-y-0.5">
								{tools.map((tool) => (
									<li>
										<a
											href={tool.slug}
											role="menuitem"
											aria-current={currentPath === tool.slug ? 'page' : undefined}
											class={`block whitespace-nowrap rounded-sm px-3 py-2 text-[14px] transition-colors hover:bg-[#e6f7f1] hover:text-[#0f2e26] dark:text-ink dark:hover:bg-[#1f1f23] ${
												currentPath === tool.slug
													? 'bg-[#afe3d0] font-semibold text-[#0f2e26] dark:bg-[#1f1f23]'
													: 'font-medium text-[#0f172a]'
											}`}
										>
											{tool.shortName}
										</a>
									</li>
								))}
							</ul>
						</div>
					</div>
				))
			}
		</nav>

		<!-- Right: Theme Toggle & Mobile Menu Button -->
		<div class="flex shrink-0 items-center gap-1.5 whitespace-nowrap sm:gap-2">
			<LanguageSwitcher variant="desktop" />
			<button
				id="theme-toggle"
				type="button"
				class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-sm border border-[#e2e8e5] bg-[#ffffff] text-[#0f172a] transition-colors hover:bg-[#e6f7f1] hover:text-[#0f2e26] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0f2e26] lg:h-8 lg:w-8 dark:border-hairline dark:bg-canvas-elevated dark:text-ink dark:hover:bg-hairline-soft dark:focus-visible:outline-vercel-blue"
				aria-label={t('nav.toggleTheme')}
				title={t('nav.switchAppearance')}
			>
				<!-- Sun Icon (shown in dark mode) -->
				<svg
					id="theme-icon-sun"
					class="hidden h-4 w-4"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2" />
					<path d="M12 20v2" />
					<path d="m4.93 4.93 1.41 1.41" />
					<path d="m17.66 17.66 1.41 1.41" />
					<path d="M2 12h2" />
					<path d="M20 12h2" />
					<path d="m6.34 17.66-1.41 1.41" />
					<path d="m19.07 4.93-1.41 1.41" />
				</svg>
				<!-- Moon Icon (shown in light mode) -->
				<svg
					id="theme-icon-moon"
					class="block h-4 w-4"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
				</svg>
			</button>

			<!-- Mobile Drawer Trigger -->
			<button
				id="mobile-menu-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="mobile-nav-drawer"
				aria-label={t('nav.toggleMenu')}
				class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-sm border border-[#e2e8e5] bg-[#ffffff] text-[#0f172a] transition-colors hover:bg-[#e6f7f1] hover:text-[#0f2e26] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0f2e26] lg:hidden dark:border-hairline dark:bg-canvas-elevated dark:text-ink dark:hover:bg-hairline-soft dark:focus-visible:outline-vercel-blue"
			>
				<svg
					id="mobile-icon-open"
					class="block h-4 w-4"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<line x1="4" y1="7" x2="20" y2="7" />
					<line x1="4" y1="12" x2="20" y2="12" />
					<line x1="4" y1="17" x2="20" y2="17" />
				</svg>
				<svg
					id="mobile-icon-close"
					class="hidden h-4 w-4"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M18 6 6 18" />
					<path d="m6 6 12 12" />
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile Navigation Drawer / Accordion -->
	<div
		id="mobile-nav-drawer"
		aria-label={t('nav.mobileNav')}
		class="hidden max-h-[calc(100dvh-3.75rem)] overflow-y-auto overscroll-contain border-t border-[#e2e8e5] bg-[#ffffff] px-3 pt-2 pb-[max(1rem,env(safe-area-inset-bottom))] sm:px-4 lg:hidden dark:border-hairline dark:bg-[#141416]"
	>
		<div class="mx-auto max-w-[1200px] divide-y divide-hairline">
			{
				categoriesWithTools.map(({ label, id, tools, isActiveCategory }, index) => {
					const hasActiveCategory = categoriesWithTools.some((c) => c.isActiveCategory);
					const defaultOpen = isActiveCategory || (!hasActiveCategory && index === 0);
					return (
						<div class="py-2" data-mobile-accordion={id}>
							<button
								type="button"
								data-mobile-accordion-trigger={id}
								aria-expanded={defaultOpen ? 'true' : 'false'}
								aria-controls={`mobile-panel-${id}`}
								class={`flex min-h-[44px] w-full cursor-pointer items-center justify-between rounded-sm px-2 py-2.5 text-left text-[15px] transition-colors hover:bg-[#e6f7f1] hover:text-[#0f2e26] dark:hover:bg-hairline-soft ${
									isActiveCategory
										? 'font-semibold text-[#0f2e26] dark:text-ink'
										: 'font-medium text-[#0f172a] dark:text-ink'
								}`}
							>
								<span>{label}</span>
								<svg
									data-mobile-accordion-chevron={id}
									class={`h-4 w-4 text-mute transition-transform duration-150 ${
										defaultOpen ? 'rotate-180' : ''
									}`}
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="m6 9 6 6 6-6" />
								</svg>
							</button>

							<ul
								id={`mobile-panel-${id}`}
								data-mobile-accordion-panel={id}
								class={`mt-1 space-y-0.5 pl-2 ${defaultOpen ? 'block' : 'hidden'}`}
							>
								{tools.map((tool) => (
									<li>
										<a
											href={tool.slug}
											aria-current={currentPath === tool.slug ? 'page' : undefined}
											class={`block min-h-[44px] rounded-sm px-3 py-2.5 text-[14px] transition-colors hover:bg-[#e6f7f1] hover:text-[#0f2e26] dark:text-ink dark:hover:bg-[#1f1f23] ${
												currentPath === tool.slug
													? 'bg-[#afe3d0] font-semibold text-[#0f2e26] dark:bg-[#1f1f23]'
													: 'font-medium text-[#0f172a]'
											}`}
										>
											{tool.shortName}
										</a>
									</li>
								))}
							</ul>
						</div>
					);
				})
			}
			<LanguageSwitcher variant="mobile" />
		</div>
	</div>
</header>

<script>
	function setupHeaderInteractions() {
		// 1. Theme Toggle
		const toggleBtn = document.getElementById('theme-toggle');
		const sunIcon = document.getElementById('theme-icon-sun');
		const moonIcon = document.getElementById('theme-icon-moon');

		const syncIcons = () => {
			const isDark = document.documentElement.classList.contains('dark');
			if (sunIcon && moonIcon) {
				sunIcon.classList.toggle('hidden', !isDark);
				sunIcon.classList.toggle('block', isDark);
				moonIcon.classList.toggle('hidden', isDark);
				moonIcon.classList.toggle('block', !isDark);
			}
		};

		syncIcons();

		toggleBtn?.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			try {
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			} catch (e) {}
			syncIcons();
		});

		// 2. Desktop category dropdown menus
		const dropdownContainers = Array.from(
			document.querySelectorAll<HTMLElement>('[data-nav-dropdown]')
		);
		let activeDropdownId: string | null = null;
		let closeTimeout: number | null = null;

		const clearCloseTimer = () => {
			if (closeTimeout !== null) {
				window.clearTimeout(closeTimeout);
				closeTimeout = null;
			}
		};

		const closeAllDropdowns = () => {
			clearCloseTimer();
			activeDropdownId = null;
			for (const container of dropdownContainers) {
				const id = container.getAttribute('data-nav-dropdown');
				if (!id) continue;
				const trigger = container.querySelector<HTMLElement>(`[data-nav-trigger="${id}"]`);
				const panel = container.querySelector<HTMLElement>(`[data-nav-panel="${id}"]`);
				const chevron = container.querySelector<HTMLElement>(`[data-nav-chevron="${id}"]`);

				trigger?.setAttribute('aria-expanded', 'false');
				panel?.classList.remove('visible', 'opacity-100');
				panel?.classList.add('invisible', 'opacity-0');
				chevron?.classList.remove('rotate-180');
			}
		};

		const openDropdown = (targetId: string) => {
			clearCloseTimer();
			activeDropdownId = targetId;
			for (const container of dropdownContainers) {
				const id = container.getAttribute('data-nav-dropdown');
				if (!id) continue;
				const trigger = container.querySelector<HTMLElement>(`[data-nav-trigger="${id}"]`);
				const panel = container.querySelector<HTMLElement>(`[data-nav-panel="${id}"]`);
				const chevron = container.querySelector<HTMLElement>(`[data-nav-chevron="${id}"]`);

				if (id === targetId) {
					trigger?.setAttribute('aria-expanded', 'true');
					panel?.classList.remove('invisible', 'opacity-0');
					panel?.classList.add('visible', 'opacity-100');
					chevron?.classList.add('rotate-180');
				} else {
					trigger?.setAttribute('aria-expanded', 'false');
					panel?.classList.remove('visible', 'opacity-100');
					panel?.classList.add('invisible', 'opacity-0');
					chevron?.classList.remove('rotate-180');
				}
			}
		};

		for (const container of dropdownContainers) {
			const id = container.getAttribute('data-nav-dropdown');
			if (!id) continue;
			const trigger = container.querySelector<HTMLElement>(`[data-nav-trigger="${id}"]`);

			trigger?.addEventListener('click', (e) => {
				e.stopPropagation();
				if (activeDropdownId === id) {
					closeAllDropdowns();
				} else {
					openDropdown(id);
				}
			});

			container.addEventListener('mouseenter', () => {
				openDropdown(id);
			});

			container.addEventListener('mouseleave', () => {
				clearCloseTimer();
				closeTimeout = window.setTimeout(() => {
					if (activeDropdownId === id) {
						closeAllDropdowns();
					}
				}, 130);
			});
		}

		// 3. Mobile Drawer & Category Accordions
		const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
		const mobileDrawer = document.getElementById('mobile-nav-drawer');
		const mobileIconOpen = document.getElementById('mobile-icon-open');
		const mobileIconClose = document.getElementById('mobile-icon-close');
		let isMobileDrawerOpen = false;

		const setMobileDrawerState = (open: boolean) => {
			isMobileDrawerOpen = open;
			mobileMenuToggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
			mobileDrawer?.classList.toggle('hidden', !open);
			mobileIconOpen?.classList.toggle('hidden', open);
			mobileIconOpen?.classList.toggle('block', !open);
			mobileIconClose?.classList.toggle('hidden', !open);
			mobileIconClose?.classList.toggle('block', open);
		};

		mobileMenuToggle?.addEventListener('click', (e) => {
			e.stopPropagation();
			setMobileDrawerState(!isMobileDrawerOpen);
		});

		const accordionTriggers = Array.from(
			document.querySelectorAll<HTMLElement>('[data-mobile-accordion-trigger]')
		);

		for (const trigger of accordionTriggers) {
			trigger.addEventListener('click', () => {
				const id = trigger.getAttribute('data-mobile-accordion-trigger');
				if (!id) return;
				const panel = document.querySelector<HTMLElement>(
					`[data-mobile-accordion-panel="${id}"]`
				);
				const chevron = document.querySelector<HTMLElement>(
					`[data-mobile-accordion-chevron="${id}"]`
				);
				const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
				trigger.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
				panel?.classList.toggle('hidden', isExpanded);
				panel?.classList.toggle('block', !isExpanded);
				chevron?.classList.toggle('rotate-180', !isExpanded);
			});
		}

		// 4. Global Click-Outside & Escape Key Handling
		document.addEventListener('click', (e) => {
			const target = e.target as Node;
			if (activeDropdownId) {
				const activeContainer = document.querySelector<HTMLElement>(
					`[data-nav-dropdown="${activeDropdownId}"]`
				);
				if (activeContainer && !activeContainer.contains(target)) {
					closeAllDropdowns();
				}
			}

			if (
				isMobileDrawerOpen &&
				mobileDrawer &&
				!mobileDrawer.contains(target) &&
				mobileMenuToggle &&
				!mobileMenuToggle.contains(target)
			) {
				setMobileDrawerState(false);
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				if (activeDropdownId) {
					const triggerToFocus = document.querySelector<HTMLElement>(
						`[data-nav-trigger="${activeDropdownId}"]`
					);
					closeAllDropdowns();
					triggerToFocus?.focus();
				}
				if (isMobileDrawerOpen) {
					setMobileDrawerState(false);
					mobileMenuToggle?.focus();
				}
			}
		});
	}

	setupHeaderInteractions();
</script>
