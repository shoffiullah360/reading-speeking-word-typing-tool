		interface SecondSample {
			sec: number;
			wpm: number;
			raw: number;
			burst: number;
			errors: number;
		}
		let historySamples: SecondSample[] = [];
		let missedWordsSet = new Set<string>();
		let isMissedDrillActive = false;

		// Synthesized Web Audio API Mechanical Keystroke SFX
		function playTacticalSfx(isError: boolean) {
			if (!sfxEnabled) return;
			try {
				if (!audioCtx) {
					const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
					if (!AudioContextClass) return;
					audioCtx = new AudioContextClass();
				}
				if (audioCtx.state === 'suspended') {
					audioCtx.resume();
				}
				const now = audioCtx.currentTime;
				const osc = audioCtx.createOscillator();
				const gain = audioCtx.createGain();

				if (isError) {
					// Subtle low thud on error
					osc.type = 'sawtooth';
					osc.frequency.setValueAtTime(145, now);
					osc.frequency.exponentialRampToValueAtTime(55, now + 0.055);
					gain.gain.setValueAtTime(0.08, now);
					gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
					osc.connect(gain);
					gain.connect(audioCtx.destination);
					osc.start(now);
					osc.stop(now + 0.062);
				} else {
					// Crisp mechanical terminal tick on valid keystroke
					osc.type = 'triangle';
					osc.frequency.setValueAtTime(920, now);
					osc.frequency.exponentialRampToValueAtTime(240, now + 0.025);
					gain.gain.setValueAtTime(0.065, now);
					gain.gain.exponentialRampToValueAtTime(0.001, now + 0.028);
					osc.connect(gain);
					gain.connect(audioCtx.destination);
					osc.start(now);
					osc.stop(now + 0.03);
				}
			} catch (e) {}
		}

		function applyCaretVisualStyle() {
			if (!caretEl) return;
			if (caretStyle === 'BLOCK') {
				caretEl.className = 'pointer-events-none absolute top-1 left-0 z-10 h-[1.9rem] w-[0.6em] rounded-xs bg-[#00ff9d]/40 border border-[#00ff9d] shadow-[0_0_10px_#00ff9d] transition-all duration-75 sm:h-[2.35rem]';
			} else {
				caretEl.className = 'pointer-events-none absolute top-1 left-0 z-10 h-[1.9rem] w-[3px] rounded-full bg-[#00ff9d] shadow-[0_0_10px_#00ff9d] transition-all duration-75 sm:h-[2.35rem]';
			}
			if (caretStyleToggleBtn) {
				caretStyleToggleBtn.textContent = `[ CARET: ${caretStyle} ]`;
			}
		}

		function getActivePaceWpm(): number {
			const mode = PACE_OPTIONS[paceOptionIndex];
			if (mode === 'OFF') return 0;
			if (mode === 'LAST') return lastRunWpm > 0 ? lastRunWpm : 60;
			return Number(mode);
		}

		function updatePaceButtonLabel() {
			if (!paceToggleBtn) return;
			const mode = PACE_OPTIONS[paceOptionIndex];
			if (mode === 'OFF') {
				paceToggleBtn.textContent = '[ PACE: OFF ]';
				paceToggleBtn.className = 'cursor-pointer rounded px-1.5 py-0.5 text-[11px] font-bold tracking-wide text-[#6ee7b7] transition hover:bg-[#00ff9d]/15 hover:text-[#00ff9d]';
			} else if (mode === 'LAST') {
				paceToggleBtn.textContent = `[ PACE: LAST (${lastRunWpm} WPM) ]`;
				paceToggleBtn.className = 'cursor-pointer rounded bg-[#38bdf8]/15 px-1.5 py-0.5 text-[11px] font-bold tracking-wide text-[#38bdf8] transition hover:bg-[#38bdf8]/25';
			} else {
				paceToggleBtn.textContent = `[ PACE: ${mode} WPM ]`;
				paceToggleBtn.className = 'cursor-pointer rounded bg-[#38bdf8]/15 px-1.5 py-0.5 text-[11px] font-bold tracking-wide text-[#38bdf8] transition hover:bg-[#38bdf8]/25';
			}
		}

		function updateGhostCaretPosition() {
			if (!ghostCaretEl || !wordsStream || !wordsTrack) return;
			const paceWpm = getActivePaceWpm();
			if (paceWpm <= 0 || currentMode === 'zen' || !isRunning || startTimeMs === null || isFinished) {
				ghostCaretEl.classList.add('hidden');
				return;
			}

			const elapsedMin = Math.max(0, (performance.now() - startTimeMs) / 60000);
			const targetCharsFloat = elapsedMin * paceWpm * 5;
			let remainingChars = Math.floor(targetCharsFloat);

			let ghostWordIdx = 0;
			let ghostCharIdx = 0;

			for (let i = 0; i < targetWords.length; i++) {
				const wLen = targetWords[i].length;
				if (remainingChars <= wLen) {
					ghostWordIdx = i;
					ghostCharIdx = remainingChars;
					break;
				}
				remainingChars -= (wLen + 1); // +1 for space
				ghostWordIdx = i + 1;
				ghostCharIdx = 0;
			}

			if (ghostWordIdx >= targetWords.length) {
				ghostWordIdx = targetWords.length - 1;
				ghostCharIdx = (targetWords[ghostWordIdx] || '').length;
			}

			const wordEl = wordsStream.querySelector<HTMLElement>(`[data-word-idx="${ghostWordIdx}"]`);
			if (!wordEl) {
				ghostCaretEl.classList.add('hidden');
				return;
			}

			ghostCaretEl.classList.remove('hidden');
			const charSpans = Array.from(wordEl.querySelectorAll('span:not(#active-caret-anchor)')) as HTMLElement[];
			const trackRect = wordsTrack.getBoundingClientRect();

			let gx = wordEl.offsetLeft;
			let gy = wordEl.offsetTop;

			if (charSpans.length > 0) {
				if (ghostCharIdx <= 0) {
					const firstRect = charSpans[0].getBoundingClientRect();
					gx = firstRect.left - trackRect.left;
					gy = firstRect.top - trackRect.top;
				} else if (ghostCharIdx < charSpans.length) {
					const cRect = charSpans[ghostCharIdx].getBoundingClientRect();
					gx = cRect.left - trackRect.left;
					gy = cRect.top - trackRect.top;
				} else {
					const lastRect = charSpans[charSpans.length - 1].getBoundingClientRect();
					gx = lastRect.right - trackRect.left;
					gy = lastRect.top - trackRect.top;
				}
			}

			ghostCaretEl.style.transform = `translate(${gx}px, ${gy}px)`;
		}

		function setStatus(state: 'ready' | 'running' | 'done') {
			if (!statusText || !statusDot) return;
			if (state === 'ready') {
				statusText.textContent = 'TERMINAL READY';
				statusDot.className = 'inline-block h-2 w-2 animate-pulse rounded-full bg-[#00ff9d] shadow-[0_0_8px_#00ff9d]';
			} else if (state === 'running') {
				statusText.textContent = 'BREACHING...';
				statusDot.className = 'inline-block h-2 w-2 animate-pulse rounded-full bg-[#ffb020] shadow-[0_0_8px_#ffb020]';
			} else {
				statusText.textContent = 'ACCESS GRANTED';
				statusDot.className = 'inline-block h-2 w-2 rounded-full bg-[#00ff9d] shadow-[0_0_8px_#00ff9d]';
