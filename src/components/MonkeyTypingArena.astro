		const CLS_EXTRA = 'text-[#ff3b5c] bg-[#ff3b5c]/25 underline';

		let currentMode: TestMode = 'time';
		let timeLimit = 60;
		let wordLimit = 25;
		let usePunctuation = false;
		let useNumbers = false;
		let customText = 'Clear writing begins with steady rhythm and attention to detail. Type your own custom payload here to practice.';
		let currentQuoteAuthor = '';
		let lastQuoteIndex = -1;

		let targetWords: string[] = [];
		let typedWords: string[] = [];
		let activeWordIndex = 0;

		let isRunning = false;
		let isFinished = false;
		let startTimeMs: number | null = null;
		let endTimeMs: number | null = null;
		let timerId: number | null = null;

		let totalKeystrokes = 0;
		let totalErrorKeystrokes = 0;
		let correctKeystrokes = 0;
		let secondBucketKeys = 0;
		let secondBucketErrors = 0;
		let lastRecordedSecond = 0;

		// AFK / Idle gap tracking (> 5 seconds without keystrokes)
		let lastKeystrokeTimeMs: number | null = null;
		let totalAfkMs = 0;

		// Ghost Pacer State
		const PACE_OPTIONS: PaceOption[] = ['OFF', '40', '60', '80', 'LAST'];
		let paceOptionIndex = 0;
		let lastRunWpm = 60;

		// Audio SFX & Caret Style State
		let sfxEnabled = false;
		let audioCtx: AudioContext | null = null;
		let caretStyle: 'LINE' | 'BLOCK' = 'LINE';

		// Session total elapsed time & last result snapshot for PNG export
		let isRepeatedPayload = false;
		let cumulativeSessionSeconds = 0;
		let lastResultSnapshot = {
			wpm: 0,
			raw: 0,
			acc: 100,
			consistency: 100,
			modeLabel: 'time 60s',
			charsLabel: '0/0/0/0',
			durationLabel: '60s'
