		// Terminal class tokens
		const CLS_UNTYPED = 'text-[#345949]';
		const CLS_CORRECT = 'text-[#00ff9d] drop-shadow-[0_0_6px_rgba(0,255,157,0.35)]';
		const CLS_WRONG = 'text-[#ff3b5c] bg-[#ff3b5c]/15 rounded-xs';
