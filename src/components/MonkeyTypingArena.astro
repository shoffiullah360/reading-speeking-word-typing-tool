---
---

<div
	id="mta-root"
	class="relative flex min-h-screen w-full flex-col justify-between font-mono text-[#d1fae5] select-none"
>
	<!-- Tactical Mission Header & Command Bar -->
	<div
		id="mta-topbar"
		class="mx-auto flex w-full max-w-[1320px] flex-wrap items-center justify-between gap-4 px-4 pt-6 pb-2 transition-opacity duration-300 sm:px-8"
	>
		<!-- Left: Abort + status -->
		<div class="flex items-center gap-4">
			<a
				href="/typing-speed-test/"
				class="rounded-md border border-[#00ff9d]/30 bg-[#0a1410]/90 px-3 py-2 text-[13px] font-semibold tracking-wide text-[#00ff9d] transition hover:border-[#00ff9d] hover:bg-[#00ff9d]/10 hover:shadow-[0_0_12px_rgba(0,255,157,0.25)]"
				aria-label="Abort mission and exit to Typing Speed Test"
			>
				[ ← ABORT MISSION ]
			</a>
			<span id="mta-status" class="inline-flex items-center gap-2 text-[12px] font-medium tracking-wide text-[#6ee7b7]">
				<span id="mta-status-dot" class="inline-block h-2 w-2 animate-pulse rounded-full bg-[#00ff9d] shadow-[0_0_8px_#00ff9d]"></span>
				<span id="mta-status-text">TERMINAL READY</span>
			</span>
		</div>

		<!-- Center: Command Deck -->
		<div
			id="mta-control-pill"
			role="toolbar"
			aria-label="Mission protocol and modifiers"
			class="flex flex-wrap items-center justify-center gap-1.5 rounded-xl border border-[#00ff9d]/25 bg-[#0a1410]/90 px-3 py-2 text-[13px] backdrop-blur-md"
		>
			<div id="mta-modifiers-group" class="flex items-center gap-1">
				<button type="button" id="mta-mod-punctuation" aria-pressed="false" class="cursor-pointer rounded-md px-2.5 py-1 font-medium text-[#7fb69f] transition-all hover:text-[#00ff9d]">@ punctuation</button>
				<button type="button" id="mta-mod-numbers" aria-pressed="false" class="cursor-pointer rounded-md px-2.5 py-1 font-medium text-[#7fb69f] transition-all hover:text-[#00ff9d]"># numbers</button>
				<span class="mx-1 h-4 w-[1px] bg-[#00ff9d]/25" aria-hidden="true"></span>
			</div>

			<div class="flex flex-wrap items-center gap-1" role="group" aria-label="Test mode">
				<button type="button" data-mta-mode="time" aria-pressed="true" class="cursor-pointer rounded-md px-3 py-1 font-medium text-[#7fb69f] transition-all hover:text-[#00ff9d]">time</button>
				<button type="button" data-mta-mode="words" aria-pressed="false" class="cursor-pointer rounded-md px-3 py-1 font-medium text-[#7fb69f] transition-all hover:text-[#00ff9d]">words</button>
				<button type="button" data-mta-mode="quote" aria-pressed="false" class="cursor-pointer rounded-md px-3 py-1 font-medium text-[#7fb69f] transition-all hover:text-[#00ff9d]">quote</button>
				<button type="button" data-mta-mode="zen" aria-pressed="false" class="cursor-pointer rounded-md px-3 py-1 font-medium text-[#7fb69f] transition-all hover:text-[#00ff9d]">zen</button>
				<button type="button" data-mta-mode="custom" aria-pressed="false" class="cursor-pointer rounded-md px-3 py-1 font-medium text-[#7fb69f] transition-all hover:text-[#00ff9d]">custom</button>
			</div>

			<div id="mta-suboptions-wrapper" class="flex items-center gap-1">
				<span class="mx-1 h-4 w-[1px] bg-[#00ff9d]/25" aria-hidden="true"></span>

				<div id="mta-sub-time" class="flex items-center gap-1">
					<button type="button" data-mta-time="15" class="cursor-pointer rounded-md px-2.5 py-1 font-medium text-[#7fb69f] tabular-nums transition-all hover:text-[#00ff9d]">15</button>
					<button type="button" data-mta-time="30" class="cursor-pointer rounded-md px-2.5 py-1 font-medium text-[#7fb69f] tabular-nums transition-all hover:text-[#00ff9d]">30</button>
					<button type="button" data-mta-time="60" class="cursor-pointer rounded-md px-2.5 py-1 font-medium text-[#7fb69f] tabular-nums transition-all hover:text-[#00ff9d]">60</button>
					<button type="button" data-mta-time="120" class="cursor-pointer rounded-md px-2.5 py-1 font-medium text-[#7fb69f] tabular-nums transition-all hover:text-[#00ff9d]">120</button>
				</div>

				<div id="mta-sub-words" class="hidden items-center gap-1">
					<button type="button" data-mta-words="10" class="cursor-pointer rounded-md px-2.5 py-1 font-medium text-[#7fb69f] tabular-nums transition-all hover:text-[#00ff9d]">10</button>
					<button type="button" data-mta-words="25" class="cursor-pointer rounded-md px-2.5 py-1 font-medium text-[#7fb69f] tabular-nums transition-all hover:text-[#00ff9d]">25</button>
					<button type="button" data-mta-words="50" class="cursor-pointer rounded-md px-2.5 py-1 font-medium text-[#7fb69f] tabular-nums transition-all hover:text-[#00ff9d]">50</button>
					<button type="button" data-mta-words="100" class="cursor-pointer rounded-md px-2.5 py-1 font-medium text-[#7fb69f] tabular-nums transition-all hover:text-[#00ff9d]">100</button>
				</div>

				<div id="mta-sub-custom" class="hidden items-center gap-1">
					<button type="button" id="mta-btn-open-custom" class="cursor-pointer rounded-md bg-[#00ff9d] px-3 py-1 font-bold text-[#050a08] shadow-[0_0_12px_rgba(0,255,157,0.45)] transition hover:brightness-110">edit payload</button>
				</div>
			</div>
		</div>

		<!-- Right: Live Telemetry Pill + Ghost Pacer + SFX Toggle -->
		<div
			class="flex flex-wrap items-center gap-2.5 rounded-xl border border-[#00ff9d]/25 bg-[#0a1410]/90 px-3.5 py-2 text-[12px] font-semibold tracking-wide text-[#00ff9d] tabular-nums backdrop-blur-md"
			aria-label="Live telemetry and tactical controls"
		>
			<span>LIVE WPM: <span id="mta-live-wpm">00</span></span>
			<span class="h-3.5 w-[1px] bg-[#00ff9d]/25" aria-hidden="true"></span>
			<span>INTEGRITY: <span id="mta-live-integrity">100%</span></span>
			<span class="h-3.5 w-[1px] bg-[#00ff9d]/25" aria-hidden="true"></span>
			<button
				type="button"
				id="mta-pace-toggle"
				title="Cycle Ghost Pacer Caret (OFF / 40 / 60 / 80 WPM / LAST RUN)"
				class="cursor-pointer rounded px-1.5 py-0.5 text-[11px] font-bold tracking-wide text-[#6ee7b7] transition hover:bg-[#00ff9d]/15 hover:text-[#00ff9d]"
			>
				[ PACE: OFF ]
			</button>
			<button
				type="button"
				id="mta-sfx-toggle"
				aria-pressed="false"
				title="Toggle synthesized mechanical terminal keystroke audio"
				class="cursor-pointer rounded px-1.5 py-0.5 text-[11px] font-bold tracking-wide text-[#6ee7b7] transition hover:bg-[#00ff9d]/15 hover:text-[#00ff9d]"
			>
				[ SFX: OFF ]
			</button>
		</div>
	</div>

	<!-- Center Console -->
	<div class="mx-auto flex w-full max-w-[1100px] flex-1 flex-col justify-center px-4 py-6 sm:px-8">
		<!-- Active Typing Arena View -->
		<div id="mta-arena-view" class="w-full">
			<div class="mb-3 flex min-h-[2.75rem] flex-wrap items-center justify-between gap-3">
				<div class="flex flex-wrap items-center gap-3">
					<output
						id="mta-live-indicator"
						aria-live="polite"
						class="font-mono text-2xl font-bold tracking-wide text-[#00ff9d] tabular-nums drop-shadow-[0_0_10px_rgba(0,255,157,0.55)] sm:text-3xl"
					>
						T-MINUS 60s
					</output>
					<span
						id="mta-repeated-badge"
						class="hidden rounded border border-[#ffb020]/50 bg-[#ffb020]/10 px-2.5 py-0.5 text-[12px] font-bold tracking-wide text-[#ffb020] shadow-[0_0_10px_rgba(255,176,32,0.2)]"
					>
						[ REPEATED PAYLOAD ]
					</span>
					<span id="mta-quote-source" class="hidden text-[13px] font-medium text-[#6ee7b7]"></span>
				</div>

				<div class="flex items-center gap-2.5">
					<button
						type="button"
						id="mta-zen-finish-btn"
						class="hidden cursor-pointer items-center gap-1.5 rounded-md bg-[#00ff9d] px-4 py-1.5 text-[13px] font-bold text-[#050a08] shadow-[0_0_12px_rgba(0,255,157,0.45)] transition hover:brightness-110"
					>
						<span>[ EXECUTE LOG ]</span>
						<span class="text-[11px] opacity-75">(Shift+Enter)</span>
					</button>

					<button
						type="button"
						id="mta-quick-restart-btn"
						title="Restart sequence (Tab)"
						class="inline-flex cursor-pointer items-center gap-1.5 rounded-md border border-[#00ff9d]/30 bg-[#0a1410]/90 px-3.5 py-1.5 text-[13px] font-medium text-[#00ff9d] transition hover:border-[#00ff9d] hover:bg-[#00ff9d]/10"
					>
						[ RESTART ]
					</button>
				</div>
			</div>

			<!-- Payload Progress Bar -->
			<div class="mb-5 h-1.5 w-full overflow-hidden rounded-full bg-[#0f2a1f]" role="progressbar" aria-label="Payload progress" aria-valuemin="0" aria-valuemax="100">
				<div
					id="mta-progress-fill"
					class="h-full w-0 rounded-full bg-[#00ff9d] shadow-[0_0_10px_#00ff9d] transition-[width] duration-150 ease-out"
				></div>
			</div>

			<!-- Click-Anywhere Typing Viewport Box -->
			<div id="mta-canvas-box" class="relative w-full cursor-text rounded-xl py-2 focus-within:outline-none">
				<label for="mta-hidden-input" class="sr-only">Type the payload shown</label>
				<input
					id="mta-hidden-input"
					type="text"
					autocapitalize="off"
					autocomplete="off"
					autocorrect="off"
					spellcheck="false"
					aria-label="Typing speed test input"
					class="pointer-events-none fixed top-0 left-0 h-1 w-1 opacity-0"
				/>

				<div
					id="mta-viewport"
					class="relative h-[7.2rem] w-full overflow-hidden font-mono text-2xl leading-[2.4rem] sm:h-[9rem] sm:text-3xl sm:leading-[3rem]"
				>
					<div
						id="mta-words-track"
						class="relative w-full transition-transform duration-150 ease-out"
						style="transform: translateY(0px);"
					>
						<!-- Ghost Pacer Caret -->
						<div
							id="mta-ghost-caret"
							aria-hidden="true"
							class="pointer-events-none absolute top-1 left-0 z-10 hidden h-[1.9rem] w-[3px] rounded-full bg-[#38bdf8]/75 shadow-[0_0_10px_#38bdf8] transition-all duration-100 sm:h-[2.35rem]"
						></div>
						<!-- Active User Caret -->
						<div
							id="mta-caret"
							class="pointer-events-none absolute top-1 left-0 z-10 h-[1.9rem] w-[3px] rounded-full bg-[#00ff9d] shadow-[0_0_10px_#00ff9d] transition-all duration-75 sm:h-[2.35rem]"
						></div>
						<div id="mta-words-stream" class="flex flex-wrap content-start items-baseline select-none"></div>
					</div>
				</div>
			</div>
		</div>

		<!-- Post-Test Mission Report (Frameless Monkeytype Telemetry Layout) -->
		<div id="mta-results-view" class="hidden w-full py-2">
			<!-- 1. Frameless High-Impact Top Grid (WPM / ACC Left + Smooth Bezier SVG Chart Right) -->
			<div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:gap-8">
				<!-- Left Column: w-44 shrink-0 -->
				<div class="flex w-full flex-row items-baseline justify-start gap-10 lg:w-44 lg:shrink-0 lg:flex-col lg:gap-6">
					<div class="group relative">
						<div class="text-2xl leading-none font-medium text-[#5f8f7a]">wpm</div>
						<div
							id="mta-res-wpm"
							title="0.00 wpm"
							class="mt-1 cursor-help text-6xl leading-none font-bold text-[#00ff9d] tabular-nums drop-shadow-[0_0_16px_rgba(0,255,157,0.45)] sm:text-7xl"
						>
							0
						</div>
					</div>
					<div class="group relative">
						<div class="text-2xl leading-none font-medium text-[#5f8f7a]">acc</div>
						<div
							id="mta-res-acc"
							title="100.00% accuracy"
							class="mt-1 cursor-help text-5xl leading-none font-bold text-[#00ff9d] tabular-nums drop-shadow-[0_0_16px_rgba(0,255,157,0.45)] sm:text-6xl"
						>
							100%
						</div>
					</div>
				</div>

				<!-- Right Column: Smooth Bezier SVG Telemetry Chart -->
				<div class="flex min-w-0 flex-1 flex-col gap-2">
					<div class="flex flex-wrap items-center justify-end gap-4 text-[11px] text-[#5f8f7a]">
						<span class="inline-flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-full bg-[#00ff9d]"></span>wpm</span>
						<span class="inline-flex items-center gap-1.5"><span class="inline-block h-0 w-3 border-t-2 border-dashed border-[#4b7a66]"></span>raw</span>
						<span class="inline-flex items-center gap-1.5"><span class="inline-block h-0.5 w-3 bg-[#38bdf8]"></span>burst</span>
						<span class="inline-flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-full bg-[#ff3b5c]"></span>errors</span>
					</div>
					<div
						id="mta-chart-container"
						class="relative h-[220px] w-full overflow-hidden rounded-xl bg-[#070f0b]/60 p-2"
					>
						<svg id="mta-chart-svg" viewBox="0 0 700 200" preserveAspectRatio="none" class="h-full w-full overflow-visible" aria-label="Per-second WPM, raw WPM, burst WPM, and errors chart"></svg>
						<!-- Floating Hover Tooltip -->
						<div
							id="mta-chart-tooltip"
							class="pointer-events-none absolute top-3 left-3 z-20 hidden rounded-lg border border-[#00ff9d] bg-[#050a08]/95 px-3 py-2 text-[11px] leading-relaxed text-[#d1fae5] shadow-[0_0_16px_rgba(0,255,157,0.25)] tabular-nums"
						></div>
					</div>
				</div>
			</div>

			<!-- 2. Clean Horizontal 6-Column Telemetry Row Below the Graph -->
			<div class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-[1.1fr_1fr_0.8fr_1.45fr_1fr_1fr]">
				<div class="min-w-0">
					<div class="text-[13px] font-medium text-[#5f8f7a]">test type</div>
					<div id="mta-stat-type" class="mt-1 text-[16px] leading-snug font-semibold text-[#00ff9d]">
						time 60s<br />english
					</div>
				</div>
				<div class="min-w-0">
					<div class="text-[13px] font-medium text-[#5f8f7a]">other</div>
					<div id="mta-stat-other" class="mt-1 text-[16px] leading-snug font-semibold text-[#00ff9d]">
						clean run
					</div>
				</div>
				<div class="min-w-0">
					<div class="text-[13px] font-medium text-[#5f8f7a]">raw</div>
					<div id="mta-stat-raw" title="0.00 raw wpm" class="mt-1 cursor-help text-3xl leading-none font-bold text-[#00ff9d] tabular-nums">
						0
					</div>
				</div>
				<div class="min-w-0">
					<div class="text-[13px] font-medium text-[#5f8f7a]">characters</div>
					<div
						id="mta-stat-chars"
						title="correct / incorrect / extra / missed"
						class="mt-1 cursor-help text-2xl leading-none font-bold tracking-tight whitespace-nowrap text-[#00ff9d] tabular-nums sm:text-[1.65rem]"
					>
						0/0/0/0
					</div>
				</div>
				<div class="min-w-0">
					<div class="text-[13px] font-medium text-[#5f8f7a]">consistency</div>
					<div id="mta-stat-consistency" title="100% consistency" class="mt-1 cursor-help text-3xl leading-none font-bold text-[#00ff9d] tabular-nums">
						100%
					</div>
				</div>
				<div class="min-w-0">
					<div class="text-[13px] font-medium text-[#5f8f7a]">time</div>
					<div id="mta-stat-time" class="mt-1 text-3xl leading-none font-bold text-[#00ff9d] tabular-nums">
						60s
					</div>
					<div id="mta-stat-time-sub" class="mt-1.5 text-[11px] leading-tight text-[#5f8f7a] tabular-nums">
						0% afk · 00:01:00 session
					</div>
				</div>
			</div>

			<!-- 3. Centered Icon Action Bar -->
			<div class="mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-5">
				<button
					type="button"
					id="mta-btn-next-test"
					title="Next Test (Tab + Enter)"
					aria-label="Next Test"
					class="group inline-flex cursor-pointer items-center gap-2 rounded-lg border border-[#00ff9d]/30 bg-[#00ff9d]/10 px-4 py-2.5 text-[14px] font-bold text-[#00ff9d] transition hover:border-[#00ff9d] hover:bg-[#00ff9d] hover:text-[#050a08] hover:shadow-[0_0_16px_rgba(0,255,157,0.45)]"
				>
					<span class="text-base leading-none">&gt;</span>
					<span>Next Test</span>
				</button>

				<button
					type="button"
					id="mta-btn-repeat-test"
					title="Repeat Test"
					aria-label="Repeat Test"
					class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-transparent px-3.5 py-2.5 text-[14px] font-medium text-[#5f8f7a] transition hover:border-[#00ff9d]/30 hover:bg-[#0a1410] hover:text-[#00ff9d]"
				>
					<span class="text-base leading-none">↻</span>
					<span>Repeat</span>
				</button>

				<button
					type="button"
					id="mta-btn-practice-missed"
					disabled
					title="Practice Missed Words"
					aria-label="Practice Missed Words"
					class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-transparent px-3.5 py-2.5 text-[14px] font-medium text-[#5f8f7a] transition hover:border-[#ff3b5c]/40 hover:bg-[#ff3b5c]/10 hover:text-[#ff6b84] disabled:cursor-not-allowed disabled:opacity-35"
				>
					<span class="text-base leading-none">⚠</span>
					<span id="mta-missed-btn-label">Practice Missed (0)</span>
				</button>

				<button
					type="button"
					id="mta-btn-toggle-history"
					aria-expanded="false"
					title="Toggle Words History"
					aria-label="Toggle Words History"
					class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-transparent px-3.5 py-2.5 text-[14px] font-medium text-[#5f8f7a] transition hover:border-[#00ff9d]/30 hover:bg-[#0a1410] hover:text-[#00ff9d]"
				>
					<span class="text-base leading-none">≡</span>
					<span>Words History</span>
				</button>

				<button
					type="button"
					id="mta-btn-export-png"
					title="Export Result Card PNG"
					aria-label="Export Result Card PNG"
					class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-transparent px-3.5 py-2.5 text-[14px] font-medium text-[#5f8f7a] transition hover:border-[#00ff9d]/30 hover:bg-[#0a1410] hover:text-[#00ff9d]"
				>
					<span class="text-base leading-none">🖼</span>
					<span id="mta-export-png-label">Export PNG</span>
				</button>

				<a
					href="/typing-speed-test/"
					title="Exit to Guide (/typing-speed-test/)"
					aria-label="Exit to Guide"
					class="inline-flex items-center gap-2 rounded-lg border border-transparent px-3.5 py-2.5 text-[14px] font-medium text-[#5f8f7a] transition hover:border-[#00ff9d]/30 hover:bg-[#0a1410] hover:text-[#00ff9d]"
				>
					<span class="text-base leading-none">←</span>
					<span>Exit</span>
				</a>
			</div>

			<!-- Expandable Words History Drawer -->
			<div
				id="mta-words-history-drawer"
				class="mt-6 hidden rounded-xl border border-[#00ff9d]/20 bg-[#070f0b]/90 p-5"
			>
				<div class="mb-3 flex items-center justify-between gap-2 text-[12px] text-[#5f8f7a]">
					<span class="font-semibold tracking-wide text-[#00ff9d]">WORDS HISTORY // TYPED STREAM</span>
					<span>Mistyped characters highlighted in crimson</span>
				</div>
				<div
					id="mta-words-history-list"
					class="flex flex-wrap items-baseline gap-x-3 gap-y-2 font-mono text-base leading-relaxed"
				></div>
			</div>
		</div>
	</div>

	<!-- Custom Payload Modal -->
	<div
		id="mta-custom-modal"
		role="dialog"
		aria-modal="true"
		aria-labelledby="mta-custom-modal-title"
		class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4 backdrop-blur-xs"
	>
		<div class="w-full max-w-xl rounded-xl border border-[#00ff9d]/30 bg-[#08110d] p-6 shadow-[0_0_40px_rgba(0,255,157,0.12)]">
			<div class="flex items-center justify-between gap-3">
				<h2 id="mta-custom-modal-title" class="text-[16px] font-bold tracking-wide text-[#00ff9d]">&gt; CUSTOM PAYLOAD</h2>
				<button
					type="button"
					id="mta-custom-close"
					aria-label="Close custom payload dialog"
					class="cursor-pointer rounded-md px-2 py-1 text-[13px] font-semibold text-[#6ee7b7] transition hover:bg-[#00ff9d]/10 hover:text-[#00ff9d]"
				>
					[ X ]
				</button>
			</div>
			<p class="mt-1.5 text-[13px] text-[#7fb69f]">Paste any text or code below, then start practicing immediately.</p>
			<textarea
				id="mta-custom-textarea"
				rows="6"
				placeholder="Paste or type your payload here..."
				class="mt-4 w-full rounded-lg border-[1px] border-[#00ff9d]/30 bg-[#050a08] p-3.5 font-mono text-[14px] leading-relaxed text-[#d1fae5] placeholder:text-[#345949] focus:border-[#00ff9d] focus:outline-none"
			></textarea>
			<div class="mt-5 flex items-center justify-end gap-2.5">
				<button
