---
import { getLocaleFromUrl, getLocalizedPath, useTranslations, type Locale } from '../i18n/ui';
import { getToolById } from '../config/site';

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const speechTool = getToolById('speech-time-calculator');
const speedTestTool = getToolById('reading-speed-test');

const speechToolName = speechTool ? t(`${speechTool.dictKey}.shortName`) : 'Speech Time Calculator';
const speedTestToolName = speedTestTool ? t(`${speedTestTool.dictKey}.shortName`) : 'Reading Speed Test';

const clientI18n = {
	locale,
	sampleText: t('readingTimeCalculator.client.sampleText'),
	zeroDuration: t('readingTimeCalculator.client.zeroDuration'),
	unitMin: t('readingTimeCalculator.client.unitMin'),
	unitSec: t('readingTimeCalculator.client.unitSec'),
	wordSingular: t('readingTimeCalculator.client.wordSingular'),
	wordPlural: t('readingTimeCalculator.client.wordPlural'),
	charSingular: t('readingTimeCalculator.client.charSingular'),
	charPlural: t('readingTimeCalculator.client.charPlural'),
	pagePlural: t('readingTimeCalculator.client.pagePlural'),
	pasteToCheckLevel: t('readingTimeCalculator.client.pasteToCheckLevel'),
	syllablesAndLetters: t('readingTimeCalculator.client.syllablesAndLetters'),
	enterWordCountPrompt: t('readingTimeCalculator.client.enterWordCountPrompt'),
	estimatedGeneralReading: t('readingTimeCalculator.client.estimatedGeneralReading'),
	enterPageCountPrompt: t('readingTimeCalculator.client.enterPageCountPrompt'),
	spacingSingle: t('readingTimeCalculator.client.spacingSingle'),
	spacingDouble: t('readingTimeCalculator.client.spacingDouble'),
	spacingPaperback: t('readingTimeCalculator.client.spacingPaperback'),
	wppDetail: t('readingTimeCalculator.client.wppDetail'),
	modePaste: t('readingTimeCalculator.client.modePaste'),
	modeWords: t('readingTimeCalculator.client.modeWords'),
	modePages: t('readingTimeCalculator.client.modePages'),
	statusCleared: t('readingTimeCalculator.client.statusCleared'),
	statusSampleLoaded: t('readingTimeCalculator.client.statusSampleLoaded'),
	statusInvalidFile: t('readingTimeCalculator.client.statusInvalidFile'),
	statusLoadedFile: t('readingTimeCalculator.client.statusLoadedFile'),
	copySummary: t('readingTimeCalculator.client.copySummary'),
	copied: t('readingTimeCalculator.client.copied'),
	copyResult: t('readingTimeCalculator.client.copyResult'),
	difficultyLabels: t.raw<Record<string, string>>('readingTimeCalculator.client.difficultyLabels') ?? {
		'—': '—',
		Standard: 'Standard',
		Easy: 'Easy',
		Medium: 'Medium',
		Hard: 'Hard',
	},
};
---

<section id="calculator" aria-label={t('readingTimeCalculator.ui.workspaceAria')} class="mx-auto max-w-[1200px] px-4 pt-4 pb-12 sm:px-6">
	<!-- Main Dual-Column Workspace -->
	<div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-x-6 lg:gap-y-5">
		<!-- Left Column: Multi-Input System (3 Interactive Tabs) -->
		<div class="whisper-shadow order-1 flex flex-col rounded-md border border-hairline bg-canvas-elevated lg:order-1 lg:col-span-7">
			<!-- Tab Bar Header -->
			<div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline px-5 py-3">
				<div
					role="tablist"
					aria-label={t('readingTimeCalculator.ui.inputModeAria')}
					class="inline-flex items-center gap-1"
				>
					<button
						type="button"
						role="tab"
						id="tab-btn-paste"
						aria-selected="true"
						aria-controls="tab-panel-paste"
						data-tab="paste"
						class="calc-tab-btn cursor-pointer rounded-pill-category bg-primary px-3.5 py-1.5 text-[13px] font-medium text-on-primary transition-all"
					>
						{t('readingTimeCalculator.ui.tabPaste')}
					</button>
					<button
						type="button"
						role="tab"
						id="tab-btn-words"
						aria-selected="false"
						aria-controls="tab-panel-words"
						data-tab="words"
						class="calc-tab-btn cursor-pointer rounded-pill-category bg-transparent px-3.5 py-1.5 text-[13px] font-medium text-body transition-all hover:bg-hairline-soft hover:text-ink"
					>
						{t('readingTimeCalculator.ui.tabWords')}
					</button>
					<button
						type="button"
						role="tab"
						id="tab-btn-pages"
						aria-selected="false"
						aria-controls="tab-panel-pages"
						data-tab="pages"
						class="calc-tab-btn cursor-pointer rounded-pill-category bg-transparent px-3.5 py-1.5 text-[13px] font-medium text-body transition-all hover:bg-hairline-soft hover:text-ink"
					>
						{t('readingTimeCalculator.ui.tabPages')}
					</button>
				</div>

				<!-- Action Controls for Tab 1 -->
				<div id="paste-toolbar-actions" class="flex items-center gap-2">
					<button
						type="button"
						id="btn-load-sample"
						class="cursor-pointer rounded-sm px-2.5 py-1 text-[13px] font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink"
					>
						{t('readingTimeCalculator.ui.btnSample')}
					</button>
					<label
						for="file-upload-input"
						class="inline-flex cursor-pointer items-center gap-1.5 rounded-sm border border-hairline bg-canvas px-2.5 py-1 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
					>
						<svg class="h-3.5 w-3.5 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
							<polyline points="17 8 12 3 7 8" />
							<line x1="12" y1="3" x2="12" y2="15" />
						</svg>
						{t('readingTimeCalculator.ui.btnUpload')}
						<input id="file-upload-input" type="file" accept=".txt,text/plain,.md" class="sr-only" />
					</label>
					<button
						type="button"
						id="btn-clear-text"
						class="cursor-pointer rounded-sm px-2.5 py-1 text-[13px] font-medium text-mute transition-colors hover:bg-hairline-soft hover:text-vercel-error"
					>
						{t('readingTimeCalculator.ui.btnClear')}
					</button>
				</div>
			</div>

			<!-- Tab 1 Panel: Paste Text -->
			<div
				id="tab-panel-paste"
				role="tabpanel"
				aria-labelledby="tab-btn-paste"
				class="relative flex flex-1 flex-col p-4 sm:p-5"
			>
				<!-- Drag and drop overlay -->
				<div
					id="dropzone-overlay"
					class="pointer-events-none absolute inset-3 z-20 hidden flex-col items-center justify-center rounded-md border-2 border-dashed border-vercel-blue bg-canvas-elevated/95 backdrop-blur-xs transition-opacity"
				>
					<svg class="mb-2 h-8 w-8 text-vercel-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
						<polyline points="14 2 14 8 20 8" />
						<line x1="12" y1="18" x2="12" y2="12" />
						<line x1="9" y1="15" x2="15" y2="15" />
					</svg>
					<p class="text-[14px] font-medium text-ink">{t('readingTimeCalculator.ui.dropzoneTitle')}</p>
					<p class="text-[12px] text-mute">{t('readingTimeCalculator.ui.privacyNote')}</p>
				</div>

				<label for="reading-textarea" class="sr-only">{t('readingTimeCalculator.ui.textareaLabel')}</label>
				<textarea
					id="reading-textarea"
					rows="9"
					placeholder={t('readingTimeCalculator.ui.textareaPlaceholder')}
					class="w-full flex-1 resize-y bg-transparent font-sans text-[15px] leading-[24px] text-ink placeholder:text-faint focus:outline-none"
				></textarea>

				<!-- Bottom Status Bar inside Paste Panel -->
				<div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-hairline pt-2.5 text-[13px] text-mute">
					<div class="flex flex-wrap items-center gap-4 tabular-nums">
						<span>{t('readingTimeCalculator.ui.wordsLabel')} <strong id="inline-word-counter" class="font-medium text-ink">0</strong></span>
						<span>{t('readingTimeCalculator.ui.charsLabel')} <strong id="inline-char-counter" class="font-medium text-ink">0</strong></span>
						<span>{t('readingTimeCalculator.ui.withoutSpacesLabel')} <strong id="inline-char-nospace-counter" class="font-medium text-ink">0</strong></span>
						<span>{t('readingTimeCalculator.ui.paragraphsLabel')} <strong id="inline-para-counter" class="font-medium text-ink">0</strong></span>
					</div>
					<div class="flex flex-wrap items-center gap-3">
						<span id="inline-mini-counter" class="text-[12px] text-mute tabular-nums">
							{t('readingTimeCalculator.ui.initialMiniCounter')}
						</span>
						<span class="text-hairline" aria-hidden="true">·</span>
						<span id="file-status-msg" class="text-[12px] text-mute">
							{t('readingTimeCalculator.ui.privacyNote')}
						</span>
					</div>
				</div>
			</div>

			<!-- Tab 2 Panel: Word Count Direct Input -->
			<div
				id="tab-panel-words"
				role="tabpanel"
				aria-labelledby="tab-btn-words"
				class="hidden flex-1 flex-col justify-between p-4 sm:p-5"
			>
				<div>
					<label for="direct-word-input" class="block text-[15px] font-medium text-ink">
						{t('readingTimeCalculator.ui.enterWordCount')}
					</label>
					<p class="mt-1 mb-3.5 text-[14px] text-body">
						{t('readingTimeCalculator.ui.enterWordCountSub')}
					</p>

					<div class="relative flex items-center">
						<input
							id="direct-word-input"
							type="number"
							min="0"
							max="10000000"
							step="50"
							value="1500"
							class="w-full rounded-sm border border-hairline bg-canvas px-4 py-2.5 text-[20px] font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
						/>
						<span class="pointer-events-none absolute right-4 text-[14px] text-mute">
							{t('readingTimeCalculator.ui.wordsUnit')}
						</span>
					</div>

					<!-- Quick Word Count Presets -->
					<div class="mt-4">
						<span class="mb-2 block text-[13px] font-medium text-mute">
							{t('readingTimeCalculator.ui.quickWordCounts')}
						</span>
						<div class="flex flex-wrap gap-2">
							<button
								type="button"
								data-word-preset="300"
								class="word-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
							>
								{t('readingTimeCalculator.ui.nWords', { count: (300).toLocaleString(locale) })}
							</button>
							<button
								type="button"
								data-word-preset="500"
								class="word-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
							>
								{t('readingTimeCalculator.ui.nWords', { count: (500).toLocaleString(locale) })}
							</button>
							<button
								type="button"
								data-word-preset="1000"
								class="word-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
							>
								{t('readingTimeCalculator.ui.nWords', { count: (1000).toLocaleString(locale) })}
							</button>
							<button
								type="button"
								data-word-preset="1500"
								class="word-preset-btn cursor-pointer rounded-sm border border-primary bg-primary px-3 py-1.5 text-[13px] font-medium text-on-primary tabular-nums transition-colors"
							>
								{t('readingTimeCalculator.ui.nWords', { count: (1500).toLocaleString(locale) })}
							</button>
							<button
								type="button"
								data-word-preset="2500"
								class="word-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
							>
								{t('readingTimeCalculator.ui.nWords', { count: (2500).toLocaleString(locale) })}
							</button>
						</div>
					</div>
				</div>

				<div class="mt-5 space-y-2 border-t border-hairline pt-3.5 text-[14px]">
					<div class="flex items-center justify-between">
						<span class="text-body">{t('readingTimeCalculator.ui.singleSpacedLabel')}</span>
						<strong id="words-to-single-pages" class="font-medium text-ink tabular-nums">{t('readingTimeCalculator.ui.nPages', { count: '3.0' })}</strong>
					</div>
					<div class="flex items-center justify-between">
						<span class="text-body">{t('readingTimeCalculator.ui.doubleSpacedLabel')}</span>
						<strong id="words-to-double-pages" class="font-medium text-ink tabular-nums">{t('readingTimeCalculator.ui.nPages', { count: '6.0' })}</strong>
					</div>
				</div>
			</div>

			<!-- Tab 3 Panel: Pages Count Input -->
			<div
				id="tab-panel-pages"
				role="tabpanel"
				aria-labelledby="tab-btn-pages"
				class="hidden flex-1 flex-col justify-between p-4 sm:p-5"
			>
				<div>
					<label for="pages-count-input" class="block text-[15px] font-medium text-ink">
						{t('readingTimeCalculator.ui.convertPagesTitle')}
					</label>
					<p class="mt-1 mb-3.5 text-[14px] text-body">
						{t('readingTimeCalculator.ui.convertPagesSub')}
					</p>

					<div class="space-y-4">
						<div>
							<label for="pages-count-input" class="mb-1.5 block text-[13px] font-medium text-mute">
								{t('readingTimeCalculator.ui.numberOfPages')}
							</label>
							<div class="relative flex items-center">
								<input
									id="pages-count-input"
									type="number"
									min="0.5"
									max="10000"
									step="0.5"
									value="5"
									class="w-full rounded-sm border border-hairline bg-canvas px-4 py-2.5 text-[20px] font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
								/>
								<span class="pointer-events-none absolute right-3.5 text-[13px] text-mute">
									{t('readingTimeCalculator.ui.pagesUnit')}
								</span>
							</div>
						</div>

						<div>
							<span class="mb-1.5 block text-[13px] font-medium text-mute">
								{t('readingTimeCalculator.ui.lineSpacingLabel')}
							</span>
							<div class="grid grid-cols-3 gap-2" role="group" aria-label={t('readingTimeCalculator.ui.lineSpacingAria')}>
								<button
									type="button"
									id="spacing-btn-single"
									data-spacing="single"
									data-wpp="500"
									class="spacing-option-btn flex cursor-pointer flex-col items-start rounded-sm border border-primary bg-primary p-2.5 text-left text-on-primary transition-all"
								>
									<span class="text-[13px] font-semibold">{t('readingTimeCalculator.ui.singleSpaced')}</span>
									<span class="text-[12px] opacity-80 tabular-nums">{t('readingTimeCalculator.ui.wpp500')}</span>
								</button>
								<button
									type="button"
									id="spacing-btn-double"
									data-spacing="double"
									data-wpp="250"
									class="spacing-option-btn flex cursor-pointer flex-col items-start rounded-sm border border-hairline bg-canvas p-2.5 text-left text-ink transition-all hover:border-ink"
								>
									<span class="text-[13px] font-semibold">{t('readingTimeCalculator.ui.doubleSpaced')}</span>
									<span class="text-[12px] text-mute tabular-nums">{t('readingTimeCalculator.ui.wpp250')}</span>
								</button>
								<button
									type="button"
									id="spacing-btn-paperback"
									data-spacing="paperback"
									data-wpp="300"
									class="spacing-option-btn flex cursor-pointer flex-col items-start rounded-sm border border-hairline bg-canvas p-2.5 text-left text-ink transition-all hover:border-ink"
								>
									<span class="text-[13px] font-semibold">{t('readingTimeCalculator.ui.paperback')}</span>
									<span class="text-[12px] text-mute tabular-nums">{t('readingTimeCalculator.ui.wpp300')}</span>
								</button>
							</div>
						</div>
					</div>

					<!-- Quick Page Presets -->
					<div class="mt-4">
						<span class="mb-2 block text-[13px] font-medium text-mute">
							{t('readingTimeCalculator.ui.quickPageCounts')}
						</span>
						<div class="flex flex-wrap gap-2">
							<button
								type="button"
								data-page-preset="1"
								class="page-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
							>
								{t('readingTimeCalculator.ui.onePage')}
							</button>
							<button
								type="button"
								data-page-preset="2"
								class="page-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
							>
								{t('readingTimeCalculator.ui.nPages', { count: 2 })}
							</button>
							<button
								type="button"
								data-page-preset="5"
								class="page-preset-btn cursor-pointer rounded-sm border border-primary bg-primary px-3 py-1.5 text-[13px] font-medium text-on-primary tabular-nums transition-colors"
							>
								{t('readingTimeCalculator.ui.nPages', { count: 5 })}
							</button>
							<button
								type="button"
								data-page-preset="10"
								class="page-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
							>
								{t('readingTimeCalculator.ui.nPages', { count: 10 })}
							</button>
							<button
								type="button"
								data-page-preset="20"
								class="page-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
							>
								{t('readingTimeCalculator.ui.nPages', { count: 20 })}
							</button>
							<button
								type="button"
								data-page-preset="50"
								class="page-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
							>
								{t('readingTimeCalculator.ui.nPages', { count: 50 })}
							</button>
							<button
								type="button"
								data-page-preset="100"
								class="page-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
							>
								{t('readingTimeCalculator.ui.nPages', { count: 100 })}
							</button>
							<button
								type="button"
								data-page-preset="300"
								class="page-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-3 py-1.5 text-[13px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
							>
								{t('readingTimeCalculator.ui.nPages', { count: 300 })}
							</button>
						</div>
					</div>
				</div>

				<div class="mt-5 border-t border-hairline pt-3.5">
					<div class="flex items-center justify-between text-[14px]">
						<span class="text-body">{t('readingTimeCalculator.ui.estimatedWordCount')}</span>
						<strong id="pages-derived-words" class="text-[15px] font-semibold text-ink tabular-nums">
							{t('readingTimeCalculator.ui.nWords', { count: (2500).toLocaleString(locale) })}
						</strong>
					</div>
					<p class="mt-1 text-[13px] text-mute">
						{t('readingTimeCalculator.ui.basedOnWppBefore')}<span id="pages-wpp-label" class="tabular-nums">500</span>{t('readingTimeCalculator.ui.basedOnWppAfter')}
					</p>
				</div>
			</div>
		</div>

		<!-- Right Column: Reading Speed Controls (Unified, Calm Panel) -->
		<div class="whisper-shadow order-3 flex flex-col justify-between divide-y divide-hairline rounded-md border border-hairline bg-canvas-elevated lg:order-2 lg:col-span-5">
			<!-- Section A: Silent reading speed -->
			<div class="p-4 sm:p-5">
				<div class="flex items-baseline justify-between gap-2">
					<h2 class="text-[16px] font-semibold tracking-[-0.3px] text-ink">
						{t('readingTimeCalculator.ui.silentSpeedTitle')}
					</h2>
					<div class="flex items-baseline gap-1 text-ink tabular-nums">
						<span id="silent-wpm-display" class="text-[17px] font-semibold">238</span>
						<span class="text-[12px] text-mute">WPM</span>
					</div>
				</div>

				<div class="my-3">
					<label for="silent-wpm-slider" class="sr-only">{t('readingTimeCalculator.ui.silentSliderAria')}</label>
					<input
						id="silent-wpm-slider"
						type="range"
						min="100"
						max="400"
						step="1"
						value="238"
						class="geist-slider"
					/>
					<div class="mt-1 flex justify-between text-[12px] text-mute">
						<span>{t('readingTimeCalculator.ui.speedSlow')}</span>
						<span>{t('readingTimeCalculator.ui.speedAverage')}</span>
						<span>{t('readingTimeCalculator.ui.speedFast')}</span>
					</div>
				</div>

				<div class="grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4">
					<button
						type="button"
						data-silent-preset="130"
						class="silent-preset-btn cursor-pointer rounded-sm border border-hairline bg-canvas px-2.5 py-2 text-center transition-all hover:border-ink"
					>
						<span class="block text-[12px] font-medium text-ink">{t('readingTimeCalculator.ui.speedSlow')}</span>
						<span class="text-[11px] text-mute tabular-nums">130 WPM</span>
					</button>
					<button
						type="button"
						data-silent-preset="238"
						class="silent-preset-btn cursor-pointer rounded-sm border border-primary bg-primary px-2.5 py-2 text-center text-on-primary transition-all"
					>
						<span class="block text-[12px] font-medium">{t('readingTimeCalculator.ui.speedAverage')}</span>
						<span class="text-[11px] opacity-80 tabular-nums">238 WPM</span>
					</button>
					<button
						type="button"
						data-silent-preset="300"
