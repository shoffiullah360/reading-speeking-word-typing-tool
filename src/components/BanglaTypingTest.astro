	</div>

	<script define:vars={{ passages, categoryLabels, levelLabels }}>
		function initBanglaTypingTest() {
			const root = document.querySelector("[data-bangla-test]");
			if (!(root instanceof HTMLElement) || root.dataset.initialized === "true") return;
			root.dataset.initialized = "true";

			const passageElement = root.querySelector("#btt-passage");
			const input = root.querySelector("#btt-input");
			const startButton = root.querySelector("#btt-start");
			const restartButton = root.querySelector("#btt-restart");
			const resultRestart = root.querySelector("#btt-result-restart");
			const progressBar = root.querySelector("#btt-progress-bar");
			const progressTrack = root.querySelector("#btt-progress-track");
			const progressValue = root.querySelector("#btt-progress-value");
			const liveStatus = root.querySelector("#btt-live-status");
			const completion = root.querySelector("#btt-completion");
			if (!(passageElement instanceof HTMLElement) || !(input instanceof HTMLTextAreaElement)) return;
			if (!(startButton instanceof HTMLButtonElement) || !(restartButton instanceof HTMLButtonElement) || !(resultRestart instanceof HTMLButtonElement)) return;
			if (!(progressBar instanceof HTMLElement) || !(progressTrack instanceof HTMLElement) || !(progressValue instanceof HTMLElement)) return;
			if (!(liveStatus instanceof HTMLElement) || !(completion instanceof HTMLElement)) return;

			const Segmenter = Intl.Segmenter;
			const segmenter = Segmenter ? new Segmenter("bn", { granularity: "grapheme" }) : null;

			function normalize(value) {
				try { return value.normalize("NFC"); } catch { return value; }
			}

			function splitClusters(text) {
				const normalized = normalize(text);
				if (segmenter) return Array.from(segmenter.segment(normalized), (part) => part.segment);
				const marks = /[\u09BC\u09BE-\u09CD\u09D7\u09E2\u09E3\u200C\u200D\uFE00-\uFE0F]/;
				const clusters = [];
				let joinsNext = false;
				for (const char of Array.from(normalized)) {
					if (clusters.length > 0 && (joinsNext || marks.test(char))) clusters[clusters.length - 1] += char;
					else clusters.push(char);
					joinsNext = char === "\u09CD" || char === "\u200D";
				}
				return clusters;
			}

			const banglaDigits = (value) => String(Math.max(0, Math.round(value))).replace(/[0-9]/g, (digit) => "০১২৩৪৫৬৭৮৯"[Number(digit)]);
			const secondsToBangla = (seconds) => {
				const safe = Math.max(0, Math.floor(seconds));
				const minutes = Math.floor(safe / 60);
				return `${banglaDigits(minutes)}:${banglaDigits(safe % 60).padStart(2, "০")}`;
			};

			let duration = 1;
			let difficulty = "beginner";
			let mode = "time";
			let category = "general";
			let passageIndex = 0;
			let passageText = "";
			let targetClusters = [];
			let customPassage = "";
			let isRunning = false;
			let isComposing = false;
			let timerId;
			let startedAt = 0;
			let remainingSeconds = 60;
			let elapsedBeforePause = 0;
			let speedPoints = [];
			let lastSpeedSnapshot = -5;
			let latestResult = null;

			const HISTORY_KEY = "wordora-bangla-typing-test-history-v1";
			const BEST_KEY = "wordora-bangla-typing-test-best-v1";

			function readHistory() {
				try {
					const value = JSON.parse(localStorage.getItem(HISTORY_KEY) || "[]");
					return Array.isArray(value) ? value : [];
				} catch {
					return [];
				}
			}

			function readBest() {
				try {
					const value = JSON.parse(localStorage.getItem(BEST_KEY) || '{"speed":0,"accuracy":0}');
					return {
						speed: typeof value.speed === "number" ? value.speed : 0,
						accuracy: typeof value.accuracy === "number" ? value.accuracy : 0,
					};
				} catch {
					return { speed: 0, accuracy: 0 };
				}
			}

			function formatTestDate(timestamp) {
				try {
					const date = new Date(timestamp).toLocaleString("bn-BD", {
						year: "numeric",
						month: "short",
						day: "numeric",
						hour: "2-digit",
						minute: "2-digit",
					});
					return date;
				} catch {
					return "সংরক্ষিত পরীক্ষা";
				}
			}

			const getElement = (id) => {
				const element = root.querySelector("#" + id);
				if (!(element instanceof Element)) throw new Error("উপাদানটি পাওয়া যায়নি");
				return element;
			};

			function setPressed(group, active) {
				root.querySelectorAll(group + " [aria-pressed]").forEach((button) => {
					button.setAttribute("aria-pressed", "false");
					button.classList.remove("is-active");
				});
				active.setAttribute("aria-pressed", "true");
				active.classList.add("is-active");
			}

			function choosePassage() {
				if (mode === "custom" && customPassage.trim()) {
					passageText = normalize(customPassage.trim());
				} else {
					const pool = passages[category]?.[difficulty] ?? passages.general.beginner;
					passageIndex = passageIndex >= pool.length ? 0 : passageIndex;
					passageText = normalize(pool[passageIndex].text);
				}
				targetClusters = splitClusters(passageText);
				passageElement.innerHTML = "";
				targetClusters.forEach((glyph, index) => {
					const span = document.createElement("span");
					span.className = "btt-glyph";
					span.dataset.index = String(index);
					span.dataset.state = "pending";
					span.textContent = glyph;
					passageElement.appendChild(span);
				});
			}

			function resetTest(focusStartButton = false) {
				if (timerId !== undefined) window.clearInterval(timerId);
				timerId = undefined;
				isRunning = false;
				isComposing = false;
				startedAt = 0;
				elapsedBeforePause = 0;
				remainingSeconds = duration * 60;
				speedPoints = [];
				lastSpeedSnapshot = -5;
				input.value = "";
				input.disabled = true;
				passageText = "";
				targetClusters = [];
				passageElement.replaceChildren();
				completion.hidden = true;
				const customPanel = root.querySelector("#btt-custom-panel");
				if (customPanel instanceof HTMLElement) customPanel.hidden = mode !== "custom";
				getElement("btt-time-label").textContent = mode === "time" ? "অবশিষ্ট সময়" : "পরীক্ষার সময়";
				getElement("btt-time").textContent = mode === "time" ? secondsToBangla(remainingSeconds) : "প্যাসেজভিত্তিক";
				getElement("btt-wpm").textContent = "০";
				getElement("btt-cpm").textContent = "০";
				getElement("btt-accuracy").textContent = "১০০%";
				getElement("btt-errors").textContent = "০";
				progressBar.style.width = "0%";
				progressTrack.setAttribute("aria-valuenow", "0");
				progressValue.textContent = "০%";
				liveStatus.textContent = "পরীক্ষা শুরু করুন, তারপর লেখার ঘরে টাইপ করুন।";
				updateHighlight("");
				renderHistory();
				if (focusStartButton) startButton.focus();
			}

			function elapsedSeconds() {
				if (!isRunning && startedAt === 0) return elapsedBeforePause;
				return elapsedBeforePause + (startedAt ? (Date.now() - startedAt) / 1000 : 0);
			}

			function recordSpeedPoint(correctCharacters) {
				const elapsed = elapsedSeconds();
				const secondsBucket = Math.floor(elapsed / 5) * 5;
				if (secondsBucket <= lastSpeedSnapshot || elapsed < 1) return;
				lastSpeedSnapshot = secondsBucket;
				const wpm = Math.round((correctCharacters / 5) / (Math.max(elapsed, 1) / 60));
				speedPoints.push({ seconds: secondsBucket || 1, wpm });
			}

			function renderSpeedGraph() {
				const chart = getElement("btt-speed-chart");
				chart.replaceChildren();
				if (speedPoints.length < 2) {
					getElement("btt-chart-empty").hidden = false;
					return;
				}
				getElement("btt-chart-empty").hidden = true;
				const width = 700;
				const height = 150;
				const padding = 28;
				const maxWpm = Math.max(20, ...speedPoints.map((point) => point.wpm));
				const maxSeconds = Math.max(5, ...speedPoints.map((point) => point.seconds));

				for (let index = 0; index <= 4; index++) {
					const y = padding + ((height - padding * 2) * index) / 4;
					const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
					line.setAttribute("x1", String(padding));
					line.setAttribute("x2", String(width - padding));
					line.setAttribute("y1", String(y));
					line.setAttribute("y2", String(y));
					line.setAttribute("stroke", "#C4CFDD");
					line.setAttribute("stroke-width", "1");
					chart.appendChild(line);

					const label = document.createElementNS("http://www.w3.org/2000/svg", "text");
					label.setAttribute("x", "2");
					label.setAttribute("y", String(y + 4));
					label.setAttribute("fill", "#5B6B80");
					label.setAttribute("font-size", "11");
					label.textContent = banglaDigits(Math.round(maxWpm * (4 - index) / 4));
					chart.appendChild(label);
				}

				const points = speedPoints.map((point) => {
					const x = padding + (point.seconds / maxSeconds) * (width - padding * 2);
					const y = height - padding - (point.wpm / maxWpm) * (height - padding * 2);
					return `${x},${y}`;
				}).join(" ");

				const polyline = document.createElementNS("http://www.w3.org/2000/svg", "polyline");
				polyline.setAttribute("points", points);
				polyline.setAttribute("fill", "none");
				polyline.setAttribute("stroke", "#2F7D61");
				polyline.setAttribute("stroke-width", "3");
				polyline.setAttribute("stroke-linecap", "round");
				polyline.setAttribute("stroke-linejoin", "round");
				chart.appendChild(polyline);

				speedPoints.forEach((point) => {
					const x = padding + (point.seconds / maxSeconds) * (width - padding * 2);
					const y = height - padding - (point.wpm / maxWpm) * (height - padding * 2);
					const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
					circle.setAttribute("cx", String(x));
					circle.setAttribute("cy", String(y));
					circle.setAttribute("r", "4");
					circle.setAttribute("fill", "#15382A");
					chart.appendChild(circle);
				});
			}

			function renderMistakesAndReview(typed) {
				const glyphCounts = new Map();
				const wrongWords = new Map();
				const wrongPunctuation = new Map();
				const targetWords = splitWords(passageText);
				const typedWords = splitWords(input.value);

				targetClusters.forEach((glyph, index) => {
					if (index < typed.length && typed[index] !== glyph) {
						glyphCounts.set(glyph, (glyphCounts.get(glyph) || 0) + 1);
						if (/[\u0964\u0965।!?,:;:"“”‘’(){}\[\]—-]/u.test(glyph)) {
							wrongPunctuation.set(glyph, (wrongPunctuation.get(glyph) || 0) + 1);
						}
					}
				});

				targetWords.forEach((word, index) => {
					if (typedWords[index] !== undefined && typedWords[index] !== word) {
						wrongWords.set(word, (wrongWords.get(word) || 0) + 1);
					}
				});

				const topGlyphs = Array.from(glyphCounts.entries()).sort((a, b) => b[1] - a[1]).slice(0, 6);
				const topWords = Array.from(wrongWords.entries()).sort((a, b) => b[1] - a[1]).slice(0, 6);
				const topPunctuation = Array.from(wrongPunctuation.entries()).sort((a, b) => b[1] - a[1]).slice(0, 6);
				getElement("mistake-glyphs").textContent = topGlyphs.length ? topGlyphs.map(([glyph, count]) => `${glyph} × ${banglaDigits(count)}`).join(" · ") : "কোনো ভুল নেই";
				getElement("mistake-words").textContent = topWords.length ? topWords.map(([word, count]) => `${word} × ${banglaDigits(count)}`).join(" · ") : "কোনো ভুল নেই";
				getElement("mistake-punctuation").textContent = topPunctuation.length ? topPunctuation.map(([mark, count]) => `${mark} × ${banglaDigits(count)}`).join(" · ") : "কোনো ভুল নেই";

				const review = getElement("btt-review");
				review.replaceChildren();
				targetClusters.forEach((glyph, index) => {
					const span = document.createElement("span");
					if (index < typed.length) {
						span.className = typed[index] === glyph ? "text-[#1F6B4F] dark:text-[#86C9A9]" : "text-[#9E2F27] underline decoration-wavy dark:text-[#FDA29B]";
					}
					span.textContent = glyph;
					review.appendChild(span);
				});
			}

			function renderHistory(latest) {
				const history = readHistory();
				const historyElement = getElement("btt-history");
				historyElement.replaceChildren();
				if (history.length === 0) {
					const empty = document.createElement("p");
					empty.className = "text-[13px] text-mute";
					empty.textContent = "এখনো সংরক্ষিত পরীক্ষা নেই।";
					historyElement.appendChild(empty);
				} else {
					history.slice(0, 8).forEach((record, index) => {
						const row = document.createElement("div");
						row.className = "flex flex-wrap items-center justify-between gap-2 rounded-lg border border-hairline bg-card px-3 py-2.5";
						const title = document.createElement("div");
						title.className = "min-w-0";
						title.innerHTML = `<span class="block text-[12.5px] font-semibold text-ink">${index === 0 ? "সর্বশেষ পরীক্ষা" : formatTestDate(record.timestamp)}</span><span class="mt-0.5 block text-[11.5px] text-mute">${categoryLabels[record.category] || "সাধারণ"} • ${levelLabels[record.difficulty] || "সহজ"}</span>`;
						const metrics = document.createElement("span");
						metrics.className = "text-[12.5px] font-semibold text-[#315846] tabular-nums dark:text-[#B8D6C7]";
						metrics.textContent = `${banglaDigits(record.wpm)} শব্দ/মিনিট • ${banglaDigits(record.accuracy)}% নির্ভুল`;
						row.append(title, metrics);
						historyElement.appendChild(row);
					});
				}

				const best = readBest();
				getElement("best-speed").textContent = `${banglaDigits(best.speed)} শব্দ/মিনিট`;
				getElement("best-accuracy").textContent = `${banglaDigits(best.accuracy)}%`;

				const latestRecord = latest || history[0];
				if (history.length > 1) {
					const previous = latest ? history[1] : history[1];
					getElement("comparison-previous").textContent = `${banglaDigits(previous.wpm)} শব্দ/মিনিট • ${banglaDigits(previous.accuracy)}%`;
					getElement("comparison-latest").textContent = latestRecord ? `${banglaDigits(latestRecord.wpm)} শব্দ/মিনিট • ${banglaDigits(latestRecord.accuracy)}%` : "কোনো পরীক্ষা হয়নি";
				} else {
					getElement("comparison-previous").textContent = "প্রথম পরীক্ষা";
					getElement("comparison-latest").textContent = latestRecord ? `${banglaDigits(latestRecord.wpm)} শব্দ/মিনিট • ${banglaDigits(latestRecord.accuracy)}%` : "কোনো পরীক্ষা হয়নি";
				}
		 }

			function updateHighlight(rawValue) {
				if (isComposing) return;
				const typed = splitClusters(normalize(rawValue));
				let correct = 0;
				let errors = 0;
				targetClusters.forEach((glyph, index) => {
					const span = passageElement.querySelector(`[data-index="${index}"]`);
					if (!span) return;
					if (index >= typed.length) {
						span.dataset.state = index === typed.length ? "current" : "pending";
					} else if (typed[index] === glyph) {
						span.dataset.state = "correct";
						correct++;
					} else {
						span.dataset.state = "incorrect";
						errors++;
					}
				});

				const extra = Math.max(0, typed.length - targetClusters.length);
				errors += extra;
				const compared = Math.min(typed.length, targetClusters.length);
				const accuracy = compared === 0 ? 100 : Math.max(0, (correct / compared) * 100);
				const elapsed = Math.max(elapsedSeconds(), 1);
				const wpm = Math.round((correct / 5) / (elapsed / 60));
				const cpm = Math.round(correct / (elapsed / 60));
				const progress = targetClusters.length ? Math.min(100, (typed.length / targetClusters.length) * 100) : 0;

				getElement("btt-wpm").textContent = banglaDigits(wpm);
				getElement("btt-cpm").textContent = banglaDigits(cpm);
				getElement("btt-accuracy").textContent = `${banglaDigits(Math.round(accuracy))}%`;
				getElement("btt-errors").textContent = banglaDigits(errors);
				progressBar.style.width = `${progress}%`;
				progressTrack.setAttribute("aria-valuenow", String(Math.round(progress)));
				progressValue.textContent = `${banglaDigits(Math.round(progress))}%`;
				recordSpeedPoint(correct);

				if (typed.length >= targetClusters.length && isRunning) finishTest();
			}

			function startTest() {
				if (mode === "custom" && !customPassage.trim()) {
					liveStatus.textContent = "আগে নিজের বাংলা প্যাসেজ লিখে ব্যবহার করুন।";
					const customText = root.querySelector("#btt-custom-text");
					if (customText instanceof HTMLTextAreaElement) customText.focus({ preventScroll: true });
					return;
				}
				resetTest();
				choosePassage();
				input.disabled = false;
				isRunning = true;
				startedAt = Date.now();
				elapsedBeforePause = 0;
				remainingSeconds = duration * 60;
				liveStatus.textContent = "পরীক্ষা চলমান। এখন প্যাসেজটি টাইপ করুন।";
				updateHighlight("");
				input.focus();
				if (mode === "time") {
					if (timerId !== undefined) window.clearInterval(timerId);
					timerId = window.setInterval(() => {
						const elapsed = elapsedSeconds();
						remainingSeconds = Math.max(0, duration * 60 - elapsed);
						getElement("btt-time").textContent = secondsToBangla(remainingSeconds);
						const liveTyped = splitClusters(normalize(input.value));
						let liveCorrect = 0;
						targetClusters.forEach((glyph, index) => {
							if (liveTyped[index] === glyph) liveCorrect++;
						});
						recordSpeedPoint(liveCorrect);
						if (remainingSeconds <= 0) finishTest();
					}, 250);
				}
			}

			function splitWords(text) {
				return normalize(text).trim().split(/\s+/u).filter(Boolean);
			}

			function finishTest() {
				if (!isRunning) return;
				isRunning = false;
				if (!isComposing) input.disabled = true;
				if (timerId !== undefined) window.clearInterval(timerId);
				timerId = undefined;
				elapsedBeforePause = elapsedSeconds();
				startedAt = 0;

				const typed = splitClusters(normalize(input.value));
				let correct = 0;
				let errors = 0;
				targetClusters.forEach((glyph, index) => {
					if (index < typed.length) {
						if (typed[index] === glyph) correct++;
						else errors++;
					}
				});
				errors += Math.max(0, typed.length - targetClusters.length);
				const compared = Math.min(typed.length, targetClusters.length);
				const accuracy = compared === 0 ? 100 : Math.max(0, (correct / compared) * 100);
				const elapsed = Math.max(elapsedBeforePause, 1);
				const grossWpm = Math.round((typed.length / 5) / (elapsed / 60));
				const netWpm = Math.round((correct / 5) / (elapsed / 60));
				const wpm = netWpm;
				const cpm = Math.round(correct / (elapsed / 60));
				const roundedAccuracy = Math.round(accuracy);

				const targetWords = splitWords(passageText);
				const typedWords = splitWords(input.value);
				let correctWords = 0;
				targetWords.forEach((word, index) => {
					if (typedWords[index] === word) correctWords++;
				});

				getElement("result-wpm").textContent = banglaDigits(wpm);
				getElement("result-cpm").textContent = banglaDigits(cpm);
				getElement("result-accuracy").textContent = `${banglaDigits(roundedAccuracy)}%`;
				getElement("result-correct").textContent = banglaDigits(correct);
				getElement("result-errors").textContent = banglaDigits(errors);
				getElement("result-words").textContent = `${banglaDigits(correctWords)} / ${banglaDigits(targetWords.length)}`;
				getElement("dashboard-gross-wpm").textContent = banglaDigits(grossWpm);
				getElement("dashboard-net-wpm").textContent = banglaDigits(netWpm);
				getElement("dashboard-wpm").textContent = banglaDigits(wpm);
				getElement("dashboard-cpm").textContent = banglaDigits(cpm);
				getElement("dashboard-accuracy").textContent = `${banglaDigits(roundedAccuracy)}%`;

				recordSpeedPoint(correct);
				if (speedPoints.length === 0) {
					speedPoints.push({ seconds: Math.max(1, Math.round(elapsed)), wpm });
				}
				renderSpeedGraph();
				renderMistakesAndReview(typed.map((cluster) => cluster));

				const record = {
					timestamp: Date.now(),
					grossWpm,
					netWpm,
					wpm,
					cpm,
					accuracy: roundedAccuracy,
					correctCharacters: correct,
					errors,
					correctWords,
					totalWords: targetWords.length,
					elapsedSeconds: Math.round(elapsed),
					category,
					difficulty,
					mode,
				};
				latestResult = record;
				const history = [record, ...readHistory()].slice(0, 20);
				try {
					localStorage.setItem(HISTORY_KEY, JSON.stringify(history));
				} catch {
					liveStatus.textContent = "পরীক্ষা সম্পন্ন হয়েছে। এ ব্রাউজারেই পুরোনো ফলাফল সংরক্ষণ করা যাচ্ছে না।";
				}
				const previousBest = readBest();
				const best = {
					speed: Math.max(previousBest.speed, netWpm),
					accuracy: Math.max(previousBest.accuracy, roundedAccuracy),
				};
				try {
					localStorage.setItem(BEST_KEY, JSON.stringify(best));
				} catch {
					// ব্রাউজারের গোপনতা সেটিংসের কারণে সেরা রেকর্ড সংরক্ষণ না হলে ফলাফল তবু দেখানো হবে।
				}
				renderHistory(record);
				completion.hidden = false;
				liveStatus.textContent = "পরীক্ষা সম্পন্ন হয়েছে। নিচে ফলাফল দেখুন।";
				completion.scrollIntoView({ behavior: "smooth", block: "nearest" });
			}

			root.querySelectorAll("[data-duration]").forEach((button) => {
				button.addEventListener("click", () => {
					duration = Number(button.dataset.duration || 1);
					setPressed("#duration-options", button);
					resetTest();
				});
			});
			root.querySelectorAll("[data-difficulty]").forEach((button) => {
				button.addEventListener("click", () => {
					difficulty = button.dataset.difficulty || "beginner";
					passageIndex = 0;
					setPressed("#difficulty-options", button);
					resetTest();
				});
			});
			root.querySelectorAll("[data-mode]").forEach((button) => {
				button.addEventListener("click", () => {
					mode = button.dataset.mode || "time";
					setPressed("#mode-options", button);
					resetTest();
				});
			});
			root.querySelectorAll("[data-category]").forEach((button) => {
				button.addEventListener("click", () => {
					category = button.dataset.category || "general";
					passageIndex = 0;
					setPressed("#category-options", button);
					resetTest();
				});
			});

			input.addEventListener("compositionstart", () => {
				isComposing = true;
			});
			input.addEventListener("compositionupdate", () => {
				isComposing = true;
			});
			input.addEventListener("compositionend", () => {
				isComposing = false;
				if (!isRunning) {
					input.disabled = true;
					return;
				}
				updateHighlight(input.value);
			});
			input.addEventListener("beforeinput", (event) => {
				if (event instanceof InputEvent && event.isComposing) isComposing = true;
			});
			input.addEventListener("input", () => {
				if (isRunning && !isComposing) updateHighlight(input.value);
			});
			input.addEventListener("paste", (event) => {
				if (!isRunning) {
					event.preventDefault();
					return;
				}
				if (!event.clipboardData) return;
				event.preventDefault();
				const pasted = normalize(event.clipboardData.getData("text").replace(/[\r\n]+/g, " "));
				const start = input.selectionStart;
				const end = input.selectionEnd;
				input.setRangeText(pasted, start, end, "end");
				updateHighlight(input.value);
			});
			input.addEventListener("keydown", (event) => {
				if (event.key === "Backspace" && !isComposing) {
					window.requestAnimationFrame(() => updateHighlight(input.value));
				}
				if (event.key === "Enter" && mode !== "time") {
					event.preventDefault();
				}
			});

			startButton.addEventListener("click", startTest);
			restartButton.addEventListener("click", () => resetTest(true));
			resultRestart.addEventListener("click", () => resetTest(true));
			const clearHistoryButton = root.querySelector("#btt-clear-history");
			if (clearHistoryButton instanceof HTMLButtonElement) {
				clearHistoryButton.addEventListener("click", () => {
					try {
						localStorage.removeItem(HISTORY_KEY);
						localStorage.removeItem(BEST_KEY);
						renderHistory();
						liveStatus.textContent = "সংরক্ষিত পরীক্ষা ও সেরা রেকর্ড মুছে ফেলা হয়েছে।";
					} catch {
						liveStatus.textContent = "এই ব্রাউজার থেকে সংরক্ষিত তথ্য মুছে ফেলা যায়নি।";
					}
				});
			}

			const customText = root.querySelector("#btt-custom-text");
			const useCustomButton = root.querySelector("#btt-use-custom");
			const clearCustomButton = root.querySelector("#btt-clear-custom");
			const customError = root.querySelector("#btt-custom-error");
			if (customText instanceof HTMLTextAreaElement && useCustomButton instanceof HTMLButtonElement && clearCustomButton instanceof HTMLButtonElement && customError instanceof HTMLElement) {
				useCustomButton.addEventListener("click", () => {
					const text = normalize(customText.value).replace(/\r\n/g, "\n").trim();
					const hasBangla = /[\u0980-\u09FF]/u.test(text);
					if (!hasBangla || text.length < 5) {
						customError.hidden = false;
						customError.textContent = "কমপক্ষে পাঁচটি বাংলা অক্ষরবিশিষ্ট প্যাসেজ লিখুন।";
						customText.focus({ preventScroll: true });
						return;
					}
					customError.hidden = true;
					customPassage = text;
					resetTest();
					liveStatus.textContent = "নিজের প্যাসেজ প্রস্তুত। পরীক্ষা শুরু করতে প্রস্তুত।";
				});
				clearCustomButton.addEventListener("click", () => {
					customText.value = "";
					customPassage = "";
					customError.hidden = true;
					resetTest();
				});
			}

			const fullscreenButton = root.querySelector("#btt-fullscreen");
			if (fullscreenButton instanceof HTMLButtonElement) {
				fullscreenButton.addEventListener("click", async () => {
					try {
						if (!document.fullscreenElement) {
							await root.requestFullscreen();
							fullscreenButton.setAttribute("aria-pressed", "true");
							fullscreenButton.textContent = "পূর্ণ পর্দা বন্ধ করুন";
						} else {
							await document.exitFullscreen();
							fullscreenButton.setAttribute("aria-pressed", "false");
							fullscreenButton.textContent = "পূর্ণ পর্দা";
						}
					} catch {
						liveStatus.textContent = "এই ব্রাউজারে পূর্ণ পর্দা চালু করা যায়নি।";
					}
				});
				document.addEventListener("fullscreenchange", () => {
					if (!document.fullscreenElement) {
						fullscreenButton.setAttribute("aria-pressed", "false");
						fullscreenButton.textContent = "পূর্ণ পর্দা";
					}
				});
			}

			function resultSummaryText() {
				if (!latestResult) return "বাংলা টাইপিং পরীক্ষার ফলাফল";
				return `বাংলা টাইপিং পরীক্ষার ফলাফল\nমোট গতি: ${banglaDigits(latestResult.grossWpm)} শব্দ/মিনিট\nনেট গতি: ${banglaDigits(latestResult.netWpm)} শব্দ/মিনিট\nনির্ভুলতা: ${banglaDigits(latestResult.accuracy)}%\nভুল বর্ণ: ${banglaDigits(latestResult.errors)}\nWordora`;
			}

			const shareButton = root.querySelector("#btt-share-result");
			if (shareButton instanceof HTMLButtonElement) {
				shareButton.addEventListener("click", async () => {
					if (!latestResult) return;
					const summary = resultSummaryText();
					try {
						if (navigator.share) {
							await navigator.share({ title: "বাংলা টাইপিং পরীক্ষার ফলাফল", text: summary });
							liveStatus.textContent = "ফলাফল শেয়ার করার অনুরোধ পাঠানো হয়েছে।";
						} else if (navigator.clipboard) {
							await navigator.clipboard.writeText(summary);
							liveStatus.textContent = "ফলাফলের বিবরণ ক্লিপবোর্ডে কপি হয়েছে।";
						} else {
							liveStatus.textContent = "এই ব্রাউজারে শেয়ার বা ক্লিপবোর্ড ব্যবহার করা যাবে না।";
						}
					} catch {
						liveStatus.textContent = "ফলাফল শেয়ার করা হয়নি।";
					}
				});
			}

			const downloadButton = root.querySelector("#btt-download-result");
			if (downloadButton instanceof HTMLButtonElement) {
				downloadButton.addEventListener("click", () => {
					if (!latestResult) return;
					const canvas = document.createElement("canvas");
					canvas.width = 1000;
					canvas.height = 620;
					const context = canvas.getContext("2d");
					if (!context) {
						liveStatus.textContent = "ছবি তৈরি করা যায়নি।";
						return;
					}
					context.fillStyle = "#E8EDF3";
					context.fillRect(0, 0, canvas.width, canvas.height);
					context.fillStyle = "#15382A";
					context.fillRect(0, 0, canvas.width, 110);
					context.fillStyle = "#F3F9F6";
					context.font = "600 46px 'Noto Sans Bengali', sans-serif";
					context.fillText("বাংলা টাইপিং পরীক্ষার ফলাফল", 52, 72);
					context.fillStyle = "#15382A";
					context.font = "700 72px 'Noto Sans Bengali', sans-serif";
					context.fillText(`${banglaDigits(latestResult.wpm)} শব্দ/মিনিট`, 52, 205);
					context.font = "500 28px 'Noto Sans Bengali', sans-serif";
					context.fillStyle = "#315846";
					context.fillText(`মোট গতি: ${banglaDigits(latestResult.grossWpm)}  •  নেট গতি: ${banglaDigits(latestResult.netWpm)}`, 52, 270);
					context.fillText(`নির্ভুলতা: ${banglaDigits(latestResult.accuracy)}%  •  ভুল বর্ণ: ${banglaDigits(latestResult.errors)}`, 52, 325);
					context.fillText(`সঠিক বর্ণ: ${banglaDigits(latestResult.correctCharacters)}  •  সঠিক শব্দ: ${banglaDigits(latestResult.correctWords)}`, 52, 380);
					context.fillStyle = "#F3F6FA";
					context.fillRect(52, 435, 896, 105);
					context.fillStyle = "#15382A";
					context.font = "600 30px 'Noto Sans Bengali', sans-serif";
					context.fillText("Wordora • wordora.site", 82, 500);
					const link = document.createElement("a");
					link.download = "wordora-bangla-typing-result.png";
					link.href = canvas.toDataURL("image/png");
					link.click();
					liveStatus.textContent = "ফলাফলের ছবি ডাউনলোড করা হয়েছে।";
				});
			}

			const printButton = root.querySelector("#btt-print-result");
			if (printButton instanceof HTMLButtonElement) {
				printButton.addEventListener("click", () => window.print());
			}

			document.addEventListener("keydown", (event) => {
				if (event.isComposing || isComposing) return;
				if (event.ctrlKey && event.key === "Enter") {
					event.preventDefault();
					startTest();
				}
				if (event.ctrlKey && event.shiftKey && event.key.toLowerCase() === "r") {
					event.preventDefault();
					resetTest(true);
				}
			});

			resetTest();
		}

		document.addEventListener("astro:page-load", initBanglaTypingTest);
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initBanglaTypingTest, { once: true });
		} else {
			initBanglaTypingTest();
		}
	</script>
</div>

<style is:global>
	.bangla-test {
		font-family: "Noto Sans Bengali", "Hind Siliguri", "Nirmala UI", "Vrinda", "Geist", "Inter", sans-serif;
	}
