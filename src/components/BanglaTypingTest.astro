---
interface Passage {
	text: string;
}

const passages: Record<string, Record<string, Passage[]>> = {
	general: {
		beginner: [
			{ text: "আজ আকাশে মেঘ আছে। আমি উঠোনে দাঁড়িয়ে দেখছি নতুন দিনের আলো। ভালো লেখা মানে স্পষ্ট ভাব প্রকাশ করা।" },
			{ text: "বাংলা বই পড়তে পড়তে নতুন শব্দ শিখি। নিয়মিত অনুশীলন করলে হাত দ্রুত চলে।" },
			{ text: "সকালে ভালো ফল খাবেন। পরে পানি পান করুন। শান্ত মনেই বড় কাজ করা যায়।" },
		],
