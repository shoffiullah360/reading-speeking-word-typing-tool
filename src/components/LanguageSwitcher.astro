---
import {
	getAvailableLocalesForSlug,
	stripLocalePrefix,
} from '../config/site';
import {
	languages,
	languageNames,
	locales,
	getLocaleFromUrl,
	getLocalizedPath,
	useTranslations,
	type Locale,
} from '../i18n/ui';

interface Props {
	/** `desktop` sits in the header bar; `mobile` is a full-width row inside the drawer. */
	variant?: 'desktop' | 'mobile';
}

const { variant = 'desktop' } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Equivalent page in each locale; fall back to that locale's home for unknown routes (e.g. 404).
const baseSlug = stripLocalePrefix(Astro.url.pathname);
const available = getAvailableLocalesForSlug(baseSlug);
const items = locales.map((code: Locale) => ({
	code,
	label: languages[code],
	name: languageNames[code],
	href: getLocalizedPath(available.includes(code) ? baseSlug : '/', code),
	active: code === locale,
}));

const isMobile = variant === 'mobile';
---

{
	isMobile ? (
		<div
			class="mt-3 flex w-full items-center justify-between gap-3 border-t border-[#e2e8e5] px-2 pt-3 dark:border-hairline md:hidden"
			data-language-switcher="mobile"
		>
			<span class="text-[14px] font-medium text-[#0f172a] dark:text-ink">{t('nav.language')}</span>
			<div class="relative inline-block" data-language-switcher-container>
				<button
					type="button"
					data-lang-trigger
					aria-expanded="false"
					aria-haspopup="true"
					aria-label={t('nav.language')}
					class="inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-sm border border-[#e2e8e5] bg-[#ffffff] px-2.5 text-[12px] font-semibold text-[#0f172a] transition-colors hover:bg-[#e6f7f1] hover:text-[#0f2e26] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0f2e26] dark:border-hairline dark:bg-canvas-elevated dark:text-ink dark:hover:bg-hairline-soft dark:focus-visible:outline-vercel-blue"
				>
					<svg
						class="h-4 w-4 shrink-0"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle cx="12" cy="12" r="10" />
						<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
						<path d="M2 12h20" />
					</svg>
					<span class="tracking-wide">{languages[locale]}</span>
					<svg
						data-lang-chevron
						class="h-3.5 w-3.5 shrink-0 text-[#334155] transition-transform duration-150 dark:text-mute"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="m6 9 6 6 6-6" />
					</svg>
				</button>

				<div
					data-lang-menu
					role="menu"
					aria-label={t('nav.language')}
					class="floating-shadow invisible absolute bottom-full right-0 z-50 mb-2 min-w-[160px] rounded-md border border-[#e2e8e5] bg-[#ffffff] p-1.5 opacity-0 transition-all duration-150 dark:border-hairline dark:bg-[#141416]"
				>
					<ul class="space-y-0.5" role="none">
						{items.map((item) => (
							<li role="none">
								<a
									href={item.href}
									hreflang={item.code}
									lang={item.code}
									role="menuitem"
									aria-current={item.active ? 'page' : undefined}
									title={t('nav.switchTo', { language: item.name })}
									class={`flex items-center justify-between gap-3 rounded-sm px-3 py-2 text-[14px] transition-colors ${
										item.active
											? 'bg-[#afe3d0] font-semibold text-[#0f2e26] dark:bg-[#1f1f23] dark:text-ink'
											: 'font-medium text-[#0f172a] hover:bg-[#e6f7f1] hover:text-[#0f2e26] dark:text-ink dark:hover:bg-[#1f1f23]'
									}`}
								>
									<span>{item.name}</span>
									{item.active && (
										<svg
											class="h-4 w-4 shrink-0 text-[#0f2e26] dark:text-ink"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2.5"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	) : (
		<div
			class="relative hidden md:inline-block"
			data-language-switcher="desktop"
			data-language-switcher-container
		>
			<button
				type="button"
				data-lang-trigger
				aria-expanded="false"
				aria-haspopup="true"
				aria-label={t('nav.language')}
				class="inline-flex h-8 cursor-pointer items-center gap-1.5 rounded-sm border border-[#e2e8e5] bg-[#ffffff] px-2.5 text-[12px] font-semibold text-[#0f172a] transition-colors hover:bg-[#e6f7f1] hover:text-[#0f2e26] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0f2e26] dark:border-hairline dark:bg-canvas-elevated dark:text-ink dark:hover:bg-hairline-soft dark:focus-visible:outline-vercel-blue"
			>
				<svg
					class="h-4 w-4 shrink-0"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="10" />
					<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
					<path d="M2 12h20" />
				</svg>
				<span class="tracking-wide">{languages[locale]}</span>
				<svg
					data-lang-chevron
					class="h-3.5 w-3.5 shrink-0 text-[#334155] transition-transform duration-150 dark:text-mute"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="m6 9 6 6 6-6" />
				</svg>
			</button>

			<div
				data-lang-menu
				role="menu"
				aria-label={t('nav.language')}
				class="floating-shadow invisible absolute right-0 top-full z-50 mt-2 min-w-[160px] rounded-md border border-[#e2e8e5] bg-[#ffffff] p-1.5 opacity-0 transition-all duration-150 dark:border-hairline dark:bg-[#141416]"
			>
				<ul class="space-y-0.5" role="none">
					{items.map((item) => (
						<li role="none">
							<a
								href={item.href}
								hreflang={item.code}
								lang={item.code}
								role="menuitem"
								aria-current={item.active ? 'page' : undefined}
								title={t('nav.switchTo', { language: item.name })}
								class={`flex items-center justify-between gap-3 rounded-sm px-3 py-2 text-[14px] transition-colors ${
									item.active
										? 'bg-[#afe3d0] font-semibold text-[#0f2e26] dark:bg-[#1f1f23] dark:text-ink'
										: 'font-medium text-[#0f172a] hover:bg-[#e6f7f1] hover:text-[#0f2e26] dark:text-ink dark:hover:bg-[#1f1f23]'
								}`}
							>
								<span>{item.name}</span>
								{item.active && (
									<svg
										class="h-4 w-4 shrink-0 text-[#0f2e26] dark:text-ink"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2.5"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<path d="M20 6 9 17l-5-5" />
									</svg>
								)}
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	)
}

<script>
	function setupLanguageSwitchers() {
		const switchers = Array.from(
			document.querySelectorAll<HTMLElement>('[data-language-switcher-container]')
		);

		const closeSwitcher = (switcher: HTMLElement) => {
			const trigger = switcher.querySelector<HTMLElement>('[data-lang-trigger]');
			const menu = switcher.querySelector<HTMLElement>('[data-lang-menu]');
			const chevron = switcher.querySelector<HTMLElement>('[data-lang-chevron]');

			trigger?.setAttribute('aria-expanded', 'false');
			menu?.classList.remove('visible', 'opacity-100');
			menu?.classList.add('invisible', 'opacity-0');
			chevron?.classList.remove('rotate-180');
		};

		const openSwitcher = (switcher: HTMLElement) => {
			for (const s of switchers) {
				if (s !== switcher) closeSwitcher(s);
			}

			const trigger = switcher.querySelector<HTMLElement>('[data-lang-trigger]');
			const menu = switcher.querySelector<HTMLElement>('[data-lang-menu]');
			const chevron = switcher.querySelector<HTMLElement>('[data-lang-chevron]');

			trigger?.setAttribute('aria-expanded', 'true');
			menu?.classList.remove('invisible', 'opacity-0');
			menu?.classList.add('visible', 'opacity-100');
			chevron?.classList.add('rotate-180');
		};

		for (const switcher of switchers) {
			const trigger = switcher.querySelector<HTMLElement>('[data-lang-trigger]');

			trigger?.addEventListener('click', (e) => {
				e.stopPropagation();
				const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
				if (isExpanded) {
					closeSwitcher(switcher);
				} else {
					openSwitcher(switcher);
				}
			});
		}

		// Close when clicking outside in capture phase so stopPropagation elsewhere cannot block it
		document.addEventListener(
			'click',
			(e) => {
				const target = e.target as Node;
				for (const switcher of switchers) {
					if (!switcher.contains(target)) {
						closeSwitcher(switcher);
					}
				}
			},
			true
		);

		// Close on Escape key
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				for (const switcher of switchers) {
					const trigger = switcher.querySelector<HTMLElement>('[data-lang-trigger]');
					if (trigger?.getAttribute('aria-expanded') === 'true') {
						closeSwitcher(switcher);
						trigger.focus();
					}
				}
			}
		});
	}

	setupLanguageSwitchers();
</script>
