			pathProgressEl.textContent = `${bnNumber(completed)} / ${bnNumber(
				BANGLA_LESSONS.length
			)} পাঠ সম্পন্ন`;

			for (const el of [...levelChipEls, ...levelProgressEls]) {
				const levelKey = (el.dataset.levelCount ?? el.dataset.levelProgress) as
					| BanglaTypingLevelId
					| undefined;
				if (!levelKey) continue;
				const lessons = BANGLA_LESSONS.filter((lesson) => lesson.level === levelKey);
				const done = lessons.filter((lesson) => progress.lessons[lesson.id]?.completed).length;
				el.textContent = `${bnNumber(done)} / ${bnNumber(lessons.length)}`;
			}

			for (const el of lessonCheckEls) {
				const lessonId = el.closest<HTMLButtonElement>('[data-lesson-id]')?.dataset.lessonId;
				el.hidden = !(lessonId && progress.lessons[lessonId]?.completed);
			}

			const nextLesson = nextLessonFor(progress);
			const hasProgress = Object.keys(progress.lessons).length > 0;
			continueBtn.textContent = hasProgress
				? `শেখা চালিয়ে যান — পাঠ ${nextLesson.number}`
				: `পাঠ ${nextLesson.number} শুরু করুন`;
		}

		function renderLevel() {
			const level = LESSON_LEVELS.find((entry) => entry.id === levelId) ?? LESSON_LEVELS[0];
			for (const button of levelButtons) {
				const active = button.dataset.levelId === levelId;
				button.classList.toggle('is-active', active);
				button.setAttribute('aria-pressed', active ? 'true' : 'false');
			}
			levelNoteEl.textContent = level.description;

			for (const group of levelGroups) {
				const selected = group.dataset.levelGroup === levelId;
				group.dataset.selected = selected ? 'true' : 'false';
				group.hidden = !showAllLessons && !selected;
			}

			toggleAllBtn.textContent = showAllLessons ? 'শুধু নির্বাচিত স্তর' : 'সব পাঠ দেখুন';
			toggleAllBtn.setAttribute('aria-pressed', showAllLessons ? 'true' : 'false');
			renderCurriculum();
		}

		function renderWeakGlyphs(): number {
			const entries = Object.entries(readMistakes())
				.filter(([glyph]) => glyph.trim().length > 0)
				.sort((a, b) => b[1] - a[1])
				.slice(0, 8);

			weakGlyphsEl.textContent = '';
			weakEmptyEl.hidden = entries.length > 0;

			for (const [glyph, count] of entries) {
				const chip = document.createElement('span');
				chip.className = 'bp-weak-chip';
				chip.textContent = `${glyph} · ${bnNumber(count)}`;
				weakGlyphsEl.append(chip);
			}
			return entries.length;
		}

		/** Seven-day activity bars; every value is also written as text for screen readers. */
		function renderWeekChart(progress: PracticeProgress) {
			const days = recentDays(progress, 7);
			const totalMinutes = days.reduce((sum, day) => sum + day.minutes, 0);
			const totalSessions = days.reduce((sum, day) => sum + day.sessions, 0);
			const maxMinutes = Math.max(1, ...days.map((day) => day.minutes));

			weekSummaryEl.textContent =
				totalSessions > 0
					? `${bnNumber(totalMinutes)} মিনিট · ${bnNumber(totalSessions)} সেশন`
					: 'এখনো কোনো সেশন নেই';
			weekEmptyEl.hidden = progress.sessions > 0;

			weekChartEl.textContent = '';
			const fragment = document.createDocumentFragment();
			for (const day of days) {
				const item = document.createElement('li');
				item.className = 'bp-week-day';
				item.dataset.active = day.sessions > 0 ? 'true' : 'false';
				item.dataset.today = day.isToday ? 'true' : 'false';
				item.setAttribute(
					'aria-label',
					`${day.isToday ? 'আজ' : day.long}, ${bnNumber(day.minutes)} মিনিট, ${bnNumber(
						day.sessions
					)} সেশন`
				);

				const value = document.createElement('span');
				value.className = 'bp-week-value';
				value.textContent = bnNumber(day.minutes);

				const track = document.createElement('span');
				track.className = 'bp-week-track';
				track.setAttribute('aria-hidden', 'true');
				const bar = document.createElement('span');
				bar.className = 'bp-week-bar';
				bar.style.height =
					day.minutes > 0
						? `${Math.max(8, (day.minutes / maxMinutes) * 100).toFixed(1)}%`
						: '0%';
				track.append(bar);

				const label = document.createElement('span');
				label.className = 'bp-week-label';
				label.textContent = day.isToday ? 'আজ' : day.short;

				item.append(value, track, label);
				fragment.append(item);
			}
			weekChartEl.append(fragment);
		}

		/** Badges are computed from saved progress, so there is nothing extra to store. */
		function renderMilestones(progress: PracticeProgress) {
			const fragment = document.createDocumentFragment();
			let earned = 0;

			for (const milestone of BANGLA_MILESTONES) {
				const value = milestoneValue(milestone, progress);
				const done = value >= milestone.target;
				if (done) earned += 1;

				const chip = document.createElement('li');
				chip.className = 'bp-milestone';
				chip.dataset.tone = milestone.tone;
				chip.dataset.earned = done ? 'true' : 'false';
				chip.textContent = done ? `✓ ${milestone.label}` : milestone.label;
				chip.setAttribute(
					'aria-label',
					done
						? `${milestone.label} — অর্জিত। ${milestone.description}।`
						: `${milestone.label} — এখনো অর্জিত হয়নি। ${milestone.description}।`
				);
				fragment.append(chip);
			}

			milestoneListEl.textContent = '';
			milestoneListEl.append(fragment);
			milestoneSummaryEl.textContent = `${bnNumber(earned)} / ${bnNumber(
				BANGLA_MILESTONES.length
			)} ব্যাজ`;
			milestoneEmptyEl.hidden = earned > 0;
		}

		/** Keeps the dashboard buttons pointed at the next real step. */
		function renderProgressActions(progress: PracticeProgress, weakCount: number) {
			const nextLesson = nextLessonFor(progress);
			const hasProgress = Object.keys(progress.lessons).length > 0;
			progressContinueBtn.textContent = hasProgress
				? `শেখা চালিয়ে যান — পাঠ ${nextLesson.number}`
				: `পাঠ ${nextLesson.number} শুরু করুন`;
			progressWeakBtn.textContent =
				weakCount > 0 ? 'দুর্বল অক্ষর নিয়ে অনুশীলন' : 'বর্ণ অনুশীলন শুরু করুন';
			progressWeakBtn.dataset.intent = weakCount > 0 ? 'revision' : 'letters';
		}

		function renderProgress() {
			const progress = readProgress();
			const completedLessons = BANGLA_LESSONS.filter(
				(lesson) => progress.lessons[lesson.id]?.completed
			).length;
			const percent =
				BANGLA_LESSONS.length > 0 ? (completedLessons / BANGLA_LESSONS.length) * 100 : 0;
			const averageAccuracy = progress.sessions > 0 ? progress.accuracySum / progress.sessions : null;

			progressLessonsEl.textContent = `${bnNumber(completedLessons)} / ${bnNumber(BANGLA_LESSONS.length)}`;
			progressPercentEl.textContent = `${bnNumber(percent)}%`;
			progressSessionsEl.textContent = bnNumber(progress.sessions);
			progressAccuracyEl.textContent =
				averageAccuracy === null ? '—' : `${bnNumber(averageAccuracy)}%`;
			progressTimeEl.textContent = formatDuration(progress.totalTimeMs);
			progressWordsEl.textContent = bnNumber(progress.totalWords);

			// Yesterday still counts as an alive streak; a gap of two days means it lapsed.
			const streakGap = progress.streakLastDate
				? dayGap(progress.streakLastDate, localDateKey())
				: Number.POSITIVE_INFINITY;
			const liveStreak = streakGap <= 1 ? Math.max(1, progress.streakCurrent) : 0;
			progressStreakEl.textContent =
				liveStreak > 0
					? `${bnNumber(liveStreak)} দিন (সেরা ${bnNumber(progress.streakBest)})`
					: '—';
			progressBestEl.textContent = progress.bestSession
				? progress.bestSession.cpm > 0
					? `${bnNumber(progress.bestSession.accuracy)}% · ${bnNumber(progress.bestSession.cpm)} অক্ষর/মিনিট`
					: `${bnNumber(progress.bestSession.accuracy)}%`
				: '—';

			progressBarEl.style.width = `${percent.toFixed(1)}%`;
			progressTrackEl.setAttribute('aria-valuenow', String(Math.round(percent)));

			renderWeekChart(progress);
			renderMilestones(progress);
			const weakCount = renderWeakGlyphs();
			renderProgressActions(progress, weakCount);
			renderCurriculum();
		}

		function recordSession(
			stats: { accuracy: number; cpm: number | null; correct: number; ms: number },
			lessonId: string | null,
			success: boolean,
			target: string
		) {
			const progress = readProgress();
			const now = new Date();
			const today = localDateKey(now);
			const cpm = stats.cpm ?? 0;

			progress.sessions += 1;
			progress.totalTimeMs += Math.max(0, stats.ms);
			progress.totalCorrectChars += Math.max(0, stats.correct);
			progress.totalWords += normalizeText(target)
				.trim()
				.split(/\s+/)
				.filter(Boolean).length;
			progress.accuracySum += stats.accuracy;

			const best = progress.bestSession;
			const betterAccuracy = !best || stats.accuracy > best.accuracy + 0.01;
			const sameAccuracyFaster =
				!!best && Math.abs(stats.accuracy - best.accuracy) <= 0.01 && cpm > best.cpm;
			if (betterAccuracy || sameAccuracyFaster) {
				progress.bestSession = {
					accuracy: stats.accuracy,
					cpm,
					at: now.toISOString(),
				};
			}

			if (progress.streakLastDate === today) {
				progress.streakCurrent = Math.max(1, progress.streakCurrent);
			} else {
				const gap = dayGap(progress.streakLastDate, today);
				progress.streakCurrent = gap === 1 ? progress.streakCurrent + 1 : 1;
			}
			progress.streakLastDate = today;
			progress.streakBest = Math.max(progress.streakBest, progress.streakCurrent);

			const day = progress.days[today] ?? {
				sessions: 0,
				practiceMs: 0,
				correctChars: 0,
				accuracySum: 0,
			};
			day.sessions += 1;
			day.practiceMs += Math.max(0, stats.ms);
			day.correctChars += Math.max(0, stats.correct);
			day.accuracySum += stats.accuracy;
			progress.days[today] = day;

			// Keep the daily history bounded so long-term use cannot grow storage forever.
			const dayKeys = Object.keys(progress.days).sort();
			if (dayKeys.length > MAX_DAILY_RECORDS) {
				for (const key of dayKeys.slice(0, dayKeys.length - MAX_DAILY_RECORDS)) {
					delete progress.days[key];
				}
			}

			if (lessonId) {
				const existing = progress.lessons[lessonId] ?? {
					attempts: 0,
					completed: false,
					bestAccuracy: 0,
					bestCpm: 0,
					lastPracticedAt: '',
				};
				existing.attempts += 1;
				existing.completed = existing.completed || success;
				existing.bestAccuracy = Math.max(existing.bestAccuracy, stats.accuracy);
				existing.bestCpm = Math.max(existing.bestCpm, cpm);
				existing.lastPracticedAt = now.toISOString();
				progress.lessons[lessonId] = existing;
			}

			saveProgress(progress);
			renderProgress();
		}

		function elapsedMs(): number {
			if (startedAt === null) return 0;
			const end = finishedAt ?? pausedAt ?? Date.now();
			return Math.max(0, end - startedAt - pausedTotalMs);
		}

		/** Remaining time for timed challenges; null when the drill has no clock. */
		function timeRemainingMs(): number | null {
			if (!currentChallenge || currentChallenge.timeLimitSec <= 0) return null;
			return Math.max(0, currentChallenge.timeLimitSec * 1000 - elapsedMs());
		}

		function checkTimeLimit() {
			if (finished || composing || pausedAt !== null || startedAt === null) return;
			const remaining = timeRemainingMs();
			if (remaining === null || remaining > 0) return;
			finishAttempt('time');
		}

		function stopTimer() {
			if (timerId !== null) {
				window.clearInterval(timerId);
				timerId = null;
			}
		}

		function startTimer() {
			if (timerId !== null) return;
			timerId = window.setInterval(() => {
				if (finished || pausedAt !== null) return;
				updateMetrics();
				checkTimeLimit();
			}, 250);
		}

		/** Pause freezes the clock and locks the field; resume adds the idle span back to the paused total. */
		function setPaused(paused: boolean) {
			if (!current || finished) return;
			if (paused) {
				if (pausedAt !== null || startedAt === null) return;
				pausedAt = Date.now();
				stopTimer();
			} else {
				if (pausedAt === null) return;
				pausedTotalMs += Math.max(0, Date.now() - pausedAt);
				pausedAt = null;
				startTimer();
			}
			input.readOnly = paused;
			pauseNote.hidden = !paused;
			pauseBtn.textContent = paused ? 'চালিয়ে যান' : 'পজ করুন';
			pauseBtn.setAttribute('aria-pressed', paused ? 'true' : 'false');
			liveHint.hidden = true;
			setStatus(
				paused
					? 'অনুশীলন থামানো আছে। প্রস্তুত হলে "চালিয়ে যান" চাপুন।'
					: 'আবার শুরু হয়েছে—যেখানে ছিলেন সেখান থেকেই টাইপ করুন।'
			);
			updateMetrics();
			if (!paused) input.focus({ preventScroll: true });
		}

		/**
		 * Single source of truth for every visible metric. Correct/incorrect counts, accuracy,
		 * progress and speed are all derived from the same grapheme comparison, so the numbers
		 * on screen, the completion check and the saved session can never disagree.
		 */
		function analyze() {
			const typed = splitGraphemes(input.value);
			const total = targetGlyphs.length;
			const overlap = Math.min(typed.length, total);
			let correct = 0;
			for (let i = 0; i < overlap; i += 1) {
				if (typed[i] === targetGlyphs[i]) correct += 1;
			}
			const mismatched = overlap - correct;
			const extra = Math.max(0, typed.length - total);
			const incorrect = mismatched + extra;
			const missing = Math.max(0, total - typed.length);
			const accuracy = typed.length > 0 ? (correct / typed.length) * 100 : 100;
			const progress = total > 0 ? overlap / total : 0;
			const ms = elapsedMs();
			// Speed only becomes meaningful after a full second; shorter spans report null, not a fake number.
			const cpm = ms >= 1000 ? correct / (ms / 60000) : null;

			// A wrong grapheme is traced back to its target word, so word feedback never breaks on spacing.
			const wrongWordIndexes = new Set<number>();
			for (let i = 0; i < overlap; i += 1) {
				if (typed[i] === targetGlyphs[i]) continue;
				const wordIndex = glyphWordIndex[i] ?? -1;
				if (wordIndex >= 0) wrongWordIndexes.add(wordIndex);
			}
			const wrongWords = [...wrongWordIndexes]
				.map((index) => targetWords[index]?.text ?? '')
				.filter((word) => word.length > 0);

			return {
				typed,
				total,
				correct,
				incorrect,
				mismatched,
				extra,
				missing,
				accuracy,
				progress,
				ms,
				cpm,
				position: Math.min(typed.length, total),
				wrongWords,
			};
		}

		function paintTarget(typed: string[]) {
			for (let i = 0; i < glyphEls.length; i += 1) {
				let state: 'correct' | 'wrong' | 'current' | 'pending';
				if (i < typed.length) {
					state = typed[i] === targetGlyphs[i] ? 'correct' : 'wrong';
				} else if (i === typed.length) {
					state = 'current';
				} else {
					state = 'pending';
				}
				const glyph = glyphEls[i];
				if (glyph.dataset.state !== state) glyph.dataset.state = state;
			}
		}

		/** Names the first mismatch so the learner knows exactly what to fix. */
		function updateLiveHint() {
			// Concealed targets must not reappear through the hint text.
			if (finished || !current || targetHidden) {
				liveHint.hidden = true;
				return;
			}
			const typed = splitGraphemes(input.value);
			let message = '';
			for (let i = 0; i < typed.length; i += 1) {
				if (i >= targetGlyphs.length) {
					message = `অতিরিক্ত অক্ষর "${typed[i]}" টাইপ হয়েছে—মুছে ফেলুন।`;
					break;
				}
				if (typed[i] !== targetGlyphs[i]) {
					message = `লক্ষ্য "${targetGlyphs[i]}" · আপনি টাইপ করেছেন "${typed[i]}"`;
					break;
				}
			}
			liveHint.textContent = message;
			liveHint.hidden = message === '';
		}

		/** Mirrors the live challenge state: countdown, WPM and accuracy, or mistake count. */
		function updateChallengeBanner(stats: ReturnType<typeof analyze>) {
			if (!currentChallenge) {
				challengeBanner.hidden = true;
				return;
			}
			challengeBanner.hidden = false;

			const timed = currentChallenge.timeLimitSec > 0;
			const remaining = timeRemainingMs();
			const wpm = wordsPerMinute(stats.correct, stats.ms);

			challengeTitleEl.textContent = currentChallenge.label;
			challengeHintEl.textContent = currentChallenge.hint;
			challengeBadgeEl.textContent = currentChallenge.badge;
			challengeWpmEl.textContent = wpm === null ? '—' : bnNumber(wpm);
			challengeAccuracyEl.textContent =
				stats.typed.length > 0 ? `${bnNumber(stats.accuracy)}%` : '—';
			challengeExtraLabelEl.textContent = timed ? 'বাকি সময়' : 'ভুল অক্ষর';
			challengeExtraEl.textContent = timed
				? formatDuration(remaining ?? 0)
				: bnNumber(stats.incorrect);
			challengeBanner.dataset.state =
				timed && !finished && (remaining ?? 0) <= 10000 ? 'urgent' : 'normal';
		}

		function updateMetrics() {
			const stats = analyze();
			speedEl.textContent = stats.cpm === null ? '—' : bnNumber(stats.cpm);
			metricAccuracyEl.textContent = `${bnNumber(stats.accuracy)}%`;
			timeEl.textContent = formatDuration(stats.ms);
			progressEl.textContent = `${bnNumber(stats.position)} / ${bnNumber(stats.total)}`;
			progressTrack.setAttribute('aria-valuenow', String(Math.round(stats.progress * 100)));
			progressBar.style.width = `${(stats.progress * 100).toFixed(1)}%`;

			feedbackPositionEl.textContent = `${bnNumber(stats.position)} / ${bnNumber(stats.total)}`;
			feedbackCorrectEl.textContent = bnNumber(stats.correct);
			feedbackWrongEl.textContent = bnNumber(stats.mismatched);
			feedbackMissingEl.textContent = bnNumber(stats.missing);
			// While typing the remainder is just "left"; once finished it really was missed.
			feedbackMissingLabelEl.textContent = finished ? 'বাদ পড়া অক্ষর' : 'বাকি অক্ষর';
			feedbackExtraEl.textContent = bnNumber(stats.extra);

			paintTarget(stats.typed);
			updateLiveHint();
			updateChallengeBanner(stats);
		}

		/** Hiding the target keeps its height so nothing shifts, while glyph colours stop leaking answers. */
		function renderTargetVisibility() {
			targetEl.classList.toggle('is-concealed', targetHidden);
			targetEl.setAttribute('aria-hidden', targetHidden ? 'true' : 'false');
			toggleTargetBtn.textContent = targetHidden ? 'লক্ষ্য লেখা দেখান' : 'লক্ষ্য লেখা লুকান';
			toggleTargetBtn.setAttribute('aria-pressed', targetHidden ? 'true' : 'false');
		}

		function renderTarget(text: string) {
			targetGlyphs = splitGraphemes(text);
			targetWords = clusterWords(targetGlyphs);
			glyphWordIndex = new Array(targetGlyphs.length).fill(-1);
			targetWords.forEach((word, wordIndex) => {
				for (let i = word.start; i < word.end; i += 1) glyphWordIndex[i] = wordIndex;
			});

			glyphEls = [];
			const fragment = document.createDocumentFragment();
			for (const glyph of targetGlyphs) {
				const span = document.createElement('span');
				span.className = 'bp-glyph';
				span.dataset.state = 'pending';
				span.textContent = glyph;
				glyphEls.push(span);
				fragment.append(span);
			}
			targetEl.textContent = '';
			targetEl.append(fragment);
			renderTargetVisibility();
		}

		function addMistake(glyph: string) {
			if (!glyph || !glyph.trim()) return;
			const store = readMistakes();
			store[glyph] = (store[glyph] ?? 0) + 1;
			saveMistakes(store);
		}

		function recordMistakes(typed: string[]) {
			let changed = false;
			for (let i = 0; i < typed.length && i < targetGlyphs.length; i += 1) {
				if (typed[i] !== targetGlyphs[i] && !recordedMistakes.has(i)) {
					recordedMistakes.add(i);
					addMistake(targetGlyphs[i]);
					sessionMistakes.set(targetGlyphs[i], (sessionMistakes.get(targetGlyphs[i]) ?? 0) + 1);
					const wordIndex = glyphWordIndex[i] ?? -1;
					const word = wordIndex >= 0 ? targetWords[wordIndex]?.text : '';
					if (word) sessionWrongWords.set(word, (sessionWrongWords.get(word) ?? 0) + 1);
					changed = true;
				}
			}
			if (changed) renderMistakeDrill();
		}

		/** Glyphs missed in this attempt, most frequent first. */
		function focusedMistakes(): Array<[string, number]> {
			return [...sessionMistakes.entries()]
				.filter(([glyph, count]) => glyph.trim().length > 0 && count > 0)
				.sort((a, b) => b[1] - a[1]);
		}

		/** Words missed in this attempt, most frequent first. */
		function sortedSessionWords(): Array<[string, number]> {
			return [...sessionWrongWords.entries()]
				.filter(([word, count]) => word.trim().length > 0 && count > 0)
				.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'bn'));
		}

		function fillChips(container: HTMLElement, chips: Array<{ text: string; className: string }>) {
			container.textContent = '';
			const fragment = document.createDocumentFragment();
			for (const chip of chips) {
				const span = document.createElement('span');
				span.className = chip.className;
				span.textContent = chip.text;
				fragment.append(span);
			}
			container.append(fragment);
		}

		/** Session error summary: graphemes plus the words they belonged to. */
		function renderMistakeDrill() {
			if (!current) {
				mistakeDrillEl.hidden = true;
				return;
			}
			const glyphs = focusedMistakes().slice(0, 6);
			const words = sortedSessionWords()
				.slice(0, 6)
				.map(([word]) => word);

			if (glyphs.length === 0 && words.length === 0) {
				mistakeDrillEl.hidden = true;
				return;
			}

			const scope: string[] = [];
			if (glyphs.length > 0) scope.push(`${bnNumber(glyphs.length)}টি অক্ষরে`);
			if (words.length > 0) scope.push(`${bnNumber(words.length)}টি শব্দে`);
			mistakeDrillTextEl.textContent = `${scope.join(
				' ও '
			)} ভুল হয়েছে। নিচের ভুলগুলো আলাদা করে অনুশীলন করলে সংশোধন দ্রুত হবে।`;

			fillChips(
				mistakeGlyphsEl,
				glyphs.map(([glyph, count]) => ({
					text: `${glyph} · ${bnNumber(count)}`,
					className: 'bp-weak-chip',
				}))
			);
			mistakeGlyphBlock.hidden = glyphs.length === 0;

			fillChips(
				mistakeWordsEl,
				words.map((word) => ({ text: word, className: 'bp-word-chip' }))
			);
			mistakeWordBlock.hidden = words.length === 0;

			mistakeDrillEl.hidden = false;
		}

		function startMistakeDrill() {
			if (!current) return;
			const glyphs = focusedMistakes()
				.slice(0, 6)
				.map(([glyph]) => glyph);
			const words = sortedSessionWords()
				.slice(0, 6)
				.map(([word]) => word);
			const target = words.length > 0 ? words.join(' ') : glyphs.join(' ');
			if (!target) return;

			const minAccuracy = current.minAccuracy;
			const summaryParts: string[] = [];
			if (words.length > 0) summaryParts.push(words.map((word) => `"${word}"`).join(', '));
			if (glyphs.length > 0) summaryParts.push(glyphs.map((glyph) => `"${glyph}"`).join(', '));

			startExercise(
				{
					key: `mistake-${Date.now()}`,
					kind: 'drill',
					title: 'ভুল অক্ষর ও শব্দের ড্রিল',
					source: 'অতিরিক্ত অনুশীলন',
					difficulty: 'লক্ষ্যভিত্তিক',
					minAccuracy,
					summary: `${summaryParts.join(
						' · '
					)} — এই ভুলগুলো আপনার এই সেশনে বারবার হয়েছে। ছোট এই ড্রিলে ঠিকভাবে টাইপ করলেই সংশোধন হয়ে যাবে।`,
					criteria: `ড্রিলটি সম্পূর্ণ টাইপ করুন, ন্যূনতম ${bnNumber(minAccuracy)}% নির্ভুলতায়।`,
					target,
				},
				{ scroll: true }
			);
			setStatus(
				`${bnNumber(words.length + glyphs.length)}টি লক্ষ্য নিয়ে নতুন ড্রিল তৈরি হয়েছে—শুধু আপনার ভুলগুলোই এতে আছে।`
			);
		}

		function syncSelection(source: { kind: 'lesson' | 'mode' | 'challenge'; id: string } | null) {
			for (const button of lessonButtons) {
				const active = source?.kind === 'lesson' && button.dataset.lessonId === source.id;
				button.classList.toggle('is-active', active);
				button.setAttribute('aria-pressed', active ? 'true' : 'false');
			}
			for (const button of modeButtons) {
				const active = source?.kind === 'mode' && button.dataset.modeId === source.id;
				button.classList.toggle('is-active', active);
				button.setAttribute('aria-pressed', active ? 'true' : 'false');
			}
			for (const button of challengeButtons) {
				const active = source?.kind === 'challenge' && button.dataset.challengeId === source.id;
				button.classList.toggle('is-active', active);
				button.setAttribute('aria-pressed', active ? 'true' : 'false');
			}
		}

		function updateActionVisibility() {
			const timedChallenge = currentChallenge !== null && currentChallenge.timeLimitSec > 0;
			nextLessonBtn.hidden = !(
				current?.kind === 'lesson' &&
				currentLessonIndex >= 0 &&
				currentLessonIndex < BANGLA_LESSONS.length - 1
			);
			newDrillBtn.hidden = !(
				current?.kind === 'drill' &&
				(currentModeId !== null || current.challengeId !== undefined)
			);
			// A running countdown cannot be paused without handing out free time.
			pauseBtn.hidden = !current || finished || timedChallenge;
			// Pausing before a single keystroke would leave nothing to resume.
			pauseBtn.disabled = startedAt === null;
			toggleTargetBtn.disabled = !current;
		}

		function startExercise(
			exercise: Exercise,
			options: { focus?: boolean; scroll?: boolean } = {}
		) {
			current = exercise;
			currentChallenge =
				BANGLA_CHALLENGES.find((entry) => entry.id === exercise.challengeId) ?? null;
			targetGlyphs = [];
			recordedMistakes.clear();
			sessionMistakes.clear();
			sessionWrongWords.clear();
			finished = false;
			composing = false;
			startedAt = null;
			finishedAt = null;
			pausedAt = null;
			pausedTotalMs = 0;
			stopTimer();
			pauseNote.hidden = true;
			pauseBtn.textContent = 'পজ করুন';
			pauseBtn.setAttribute('aria-pressed', 'false');

			titleEl.textContent = exercise.title;
			sourceEl.textContent = exercise.source;
			difficultyEl.textContent = exercise.difficulty;
			accuracyEl.textContent = `ন্যূনতম নির্ভুলতা ${bnNumber(exercise.minAccuracy)}%`;
			summaryEl.textContent = exercise.summary;
			criteriaEl.textContent = `সম্পন্ন করার শর্ত: ${exercise.criteria}`;
			completionLabelEl.textContent = currentChallenge ? 'চ্যালেঞ্জের ফলাফল' : 'পাঠের ফলাফল';

			const lesson =
				exercise.kind === 'lesson'
					? BANGLA_LESSONS.find((entry) => entry.id === exercise.key)
					: undefined;
			lessonBrief.hidden = !lesson;
			if (lesson) lessonExplanationEl.textContent = lesson.explanation;
			renderLayoutGuide();

			input.value = '';
			input.readOnly = false;
			renderTarget(exercise.target);
			exercisePanel.hidden = false;
			completionCard.hidden = true;
			liveHint.hidden = true;
			liveHint.textContent = '';
			mistakeDrillEl.hidden = true;
			setStatus('');
			setResult(null);
			updateMetrics();
			updateActionVisibility();
			if (options.focus !== false) input.focus({ preventScroll: true });
			if (options.scroll) {
				exercisePanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		}

		function checkCompletion() {
			if (finished || !current || targetGlyphs.length === 0) return;
			const typed = splitGraphemes(input.value);
			if (typed.length < targetGlyphs.length) return;
			finishAttempt('complete');
		}

		function finishAttempt(reason: 'complete' | 'time') {
			if (finished || !current || targetGlyphs.length === 0) return;

			finished = true;
			finishedAt = Date.now();
			stopTimer();
			input.readOnly = true;
			updateMetrics();
			updateActionVisibility();

			const stats = analyze();
			const typedCount = stats.typed.length;
			const success = typedCount > 0 && stats.accuracy >= current.minAccuracy;
			const isChallenge = currentChallenge !== null;
			const timedOut = reason === 'time';
			const speedSummary =
				stats.cpm === null
					? 'গতি পরিমাপ হয়নি (১ সেকেন্ডের কম সময়)'
					: `গতি ${bnNumber(stats.cpm)} অক্ষর/মিনিট`;
			const wpm = wordsPerMinute(stats.correct, stats.ms);
			const wpmSummary = isChallenge && wpm !== null ? ` · ${bnNumber(wpm)} শব্দ/মিনিট` : '';

			liveHint.hidden = true;
			completionCard.hidden = false;
			completionCard.dataset.state = success ? 'success' : 'retry';

			if (isChallenge) {
				completionTitleEl.textContent = timedOut
					? 'সময় শেষ—এই এক মিনিটের ফলাফল'
					: success
						? `${current.title} সম্পন্ন হয়েছে`
						: `${current.title}—আরেকটু নির্ভুলতা দরকার`;
			} else {
				completionTitleEl.textContent = success
					? `${current.title} সম্পন্ন হয়েছে`
					: 'এখনো সম্পন্ন হয়নি';
			}

			completionAccuracyEl.textContent =
				typedCount > 0 ? `${bnNumber(stats.accuracy)}%` : '—';
			completionSpeedEl.textContent = stats.cpm === null ? '—' : bnNumber(stats.cpm);
			completionTimeEl.textContent = formatDuration(stats.ms);
			completionMistakesEl.textContent = bnNumber(stats.incorrect);

			if (isChallenge) {
				if (timedOut) {
					completionNextEl.textContent = `৬০ সেকেন্ডে ${bnNumber(
						stats.correct
					)}টি সঠিক অক্ষর। "আবার শুরু করুন" চেপে আরেকবার চেষ্টা করুন।`;
				} else if (success) {
					completionNextEl.textContent = `নির্ভুলতা ${bnNumber(
						stats.accuracy
					)}% — চমৎকার! চাইলে একই চ্যালেঞ্জ আবার খেলুন বা নতুন ড্রিল নিন।`;
				} else {
					completionNextEl.textContent = `লক্ষ্য ${bnNumber(
						current.minAccuracy
					)}% নির্ভুলতা, আপনি পেয়েছেন ${bnNumber(
						stats.accuracy
					)}%। "আবার শুরু করুন" চেপে আবার চেষ্টা করুন।`;
				}
			} else {
				const nextLesson = BANGLA_LESSONS[currentLessonIndex + 1];
				completionNextEl.textContent = success
					? nextLesson
						? `পরের পাঠ: ${nextLesson.number} · ${nextLesson.title}`
						: 'সব পাঠ শেষ—যেকোনো পাঠ আবার অনুশীলন করতে পারেন।'
					: `লক্ষ্য ${bnNumber(
							current.minAccuracy
					  )}% নির্ভুলতা। "আবার শুরু করুন" চেপে আবার চেষ্টা করুন।`;
			}

			if (isChallenge) {
				setStatus(
					timedOut
						? `সময় শেষ। ${bnNumber(stats.correct)}টি সঠিক অক্ষর, নির্ভুলতা ${bnNumber(
								stats.accuracy
						  )}%। "আবার শুরু করুন" চেপে আবার চেষ্টা করুন।`
						: success
							? `${current.title} সম্পন্ন হয়েছে। নির্ভুলতা ${bnNumber(
									stats.accuracy
							  )}%। চাইলে একই চ্যালেঞ্জ আবার খেলুন বা নতুন ড্রিল নিন।`
							: `ড্রিলটি শেষ হয়েছে, তবে নির্ভুলতা ${bnNumber(
									stats.accuracy
							  )}% — লক্ষ্য ${bnNumber(
									current.minAccuracy
							  )}%। "আবার শুরু করুন" চেপে আবার চেষ্টা করুন।`
				);
			} else {
				setStatus(
					success
						? `${current.title} সম্পন্ন হয়েছে। নির্ভুলতা ${bnNumber(stats.accuracy)}%। চাইলে পরের পাঠে যান বা একই পাঠ আবার করুন।`
						: `লেখাটি শেষ হয়েছে, তবে নির্ভুলতা ${bnNumber(stats.accuracy)}% — লক্ষ্য ${bnNumber(current.minAccuracy)}%। "আবার শুরু করুন" চেপে আবার চেষ্টা করুন।`
				);
			}

			const wordSummary =
				stats.wrongWords.length > 0
					? ` · ভুল শব্দ ${bnNumber(stats.wrongWords.length)}টি`
					: '';
			setResult(
				`${speedSummary}${wpmSummary} · সময় ${formatDuration(stats.ms)} · ভুল ${bnNumber(
					stats.incorrect
				)}টি${wordSummary} · সঠিক ${bnNumber(stats.correct)} / ${bnNumber(stats.total)} অক্ষর`
			);

			renderMistakeDrill();
			// A timed run that ended before a single keystroke is not a real session.
			if (typedCount > 0) {
				recordSession(
					stats,
					current.kind === 'lesson' ? current.key : null,
					success,
					timedOut ? stats.typed.join('') : current.target
				);
			}
		}

		function handleInput() {
			if (finished || composing || pausedAt !== null) return;
			const typed = splitGraphemes(input.value);

			if (typed.length === 0 && !(currentChallenge && currentChallenge.timeLimitSec > 0)) {
				// Clearing the field restarts the clock instead of leaving a stalled timer behind.
				stopTimer();
				startedAt = null;
				finishedAt = null;
				updateActionVisibility();
			} else if (startedAt === null) {
				startedAt = Date.now();
				startTimer();
				updateActionVisibility();
			}

			recordMistakes(typed);
			updateMetrics();
			checkTimeLimit();
			checkCompletion();
		}

		function selectLesson(
			lessonId: string,
			options: { focus?: boolean; scroll?: boolean; syncLevel?: boolean } = {}
		) {
			const index = BANGLA_LESSONS.findIndex((lesson) => lesson.id === lessonId);
			if (index === -1) return;
			const lesson = BANGLA_LESSONS[index];
			currentLessonIndex = index;
			currentModeId = null;
			customPanel.hidden = true;
			revisionEmpty.hidden = true;
			// Follow the lesson's level so the curriculum always highlights the lesson being practised.
			if (options.syncLevel !== false && lesson.level !== levelId) {
				levelId = lesson.level;
				storeChoice(LEVEL_STORE_KEY, levelId);
				renderLevel();
			}
			syncSelection({ kind: 'lesson', id: lesson.id });
			startExercise(lessonExercise(lesson), options);
		}

		function getRevisionGlyphs(): string[] {
			return Object.entries(readMistakes())
				.filter(([glyph]) => glyph.trim().length > 0)
				.sort((a, b) => b[1] - a[1])
				.slice(0, 12)
				.map(([glyph]) => glyph);
		}

		function selectMode(modeId: BanglaPracticeModeId, options: { scroll?: boolean } = {}) {
			const mode = PRACTICE_MODES.find((entry) => entry.id === modeId);
			if (!mode) return;

			currentModeId = mode.id;
			currentLessonIndex = -1;
			currentChallenge = null;
			customPanel.hidden = mode.kind !== 'custom';
			revisionEmpty.hidden = true;
			syncSelection({ kind: 'mode', id: mode.id });

			if (mode.kind === 'custom') {
				exercisePanel.hidden = true;
				current = null;
				updateActionVisibility();
				setResult(null);
				setStatus('নিচের বাক্সে আপনার লেখা দিন, তারপর "এই লেখা দিয়ে শুরু করুন" চাপুন।');
				customText.focus();
				return;
			}

			if (mode.kind === 'revision') {
				const glyphs = getRevisionGlyphs();
				if (glyphs.length === 0) {
					exercisePanel.hidden = true;
					current = null;
					updateActionVisibility();
					setResult(null);
					setStatus('');
					revisionEmpty.hidden = false;
					return;
				}
				startExercise(
					{
						key: `revision-${Date.now()}`,
						kind: 'revision',
						title: mode.label,
						source: 'অনুশীলন মোড',
						difficulty: mode.difficulty,
						minAccuracy: mode.minAccuracy,
						summary: mode.summary,
						criteria: `আপনার জমে থাকা ভুল অক্ষরগুলো সম্পূর্ণ টাইপ করুন, ন্যূনতম ${bnNumber(
							mode.minAccuracy
						)}% নির্ভুলতায়।`,
						target: glyphs.join(' '),
					},
					options
				);
				setStatus(
					`আপনার জমে থাকা ${bnNumber(glyphs.length)}টি ভুল অক্ষর থেকে ড্রিল তৈরি হয়েছে। যেগুলো বেশি ভুল হয়েছে সেগুলো আগে আছে।`
				);
				return;
			}

			startExercise(
				{
					key: `${mode.id}-${Date.now()}`,
					kind: 'drill',
					title: mode.label,
					source: 'অনুশীলন মোড',
					difficulty: mode.difficulty,
					minAccuracy: mode.minAccuracy,
					summary: mode.summary,
					criteria: `পুরো ড্রিলটি সম্পূর্ণ টাইপ করুন, ন্যূনতম ${bnNumber(
						mode.minAccuracy
					)}% নির্ভুলতায়।`,
					target: generateDrill(mode),
				},
				options
			);
		}

		function selectChallenge(
			challengeId: BanglaChallengeId,
			options: { scroll?: boolean } = {}
		) {
			const challenge = BANGLA_CHALLENGES.find((entry) => entry.id === challengeId);
			if (!challenge) return;

			currentModeId = null;
			currentLessonIndex = -1;
			customPanel.hidden = true;
			revisionEmpty.hidden = true;
			syncSelection({ kind: 'challenge', id: challenge.id });
			startExercise(challengeExercise(challenge), options);
			setStatus(
				challenge.timeLimitSec > 0
					? `${challenge.label} শুরু হয়েছে। টাইপ শুরু করলেই ${bnNumber(
							challenge.timeLimitSec
					  )} সেকেন্ডের ঘড়ি চলবে।`
					: `${challenge.label} শুরু হয়েছে। ${challenge.hint}`
			);
		}

		function startCustomText() {
			const normalized = customText.value.replace(/\s+/g, ' ').trim();
			// Counted in code points, not clusters: short words like "বাংলা" are only two clusters.
			if (Array.from(normalized).length < 3) {
				if (customError) {
					customError.textContent = 'কমপক্ষে ৩টি অক্ষর লিখুন বা পেস্ট করুন।';
					customError.hidden = false;
				}
				return;
			}
			if (customError) customError.hidden = true;

			const mode = PRACTICE_MODES.find((entry) => entry.id === 'custom');
			const truncated = splitGraphemes(normalized).slice(0, MAX_CUSTOM_LENGTH).join('');
			startExercise({
				key: `custom-${Date.now()}`,
				kind: 'custom',
				title: 'আপনার নিজের লেখা',
				source: 'অনুশীলন মোড',
				difficulty: mode?.difficulty ?? 'নিজের পছন্দ',
				minAccuracy: mode?.minAccuracy ?? 85,
				summary:
					'আপনার দেওয়া লেখাটি হুবহু টাইপ করুন। লেখাটি কোথাও পাঠানো হয় না, শুধু এই ব্রাউজার সেশনেই থাকে।',
				criteria: `আপনার লেখাটি সম্পূর্ণ টাইপ করুন, ন্যূনতম ${bnNumber(
					mode?.minAccuracy ?? 85
				)}% নির্ভুলতায়।`,
				target: truncated,
			});
			if (truncated !== normalized) {
				setStatus(`লেখাটি ${bnNumber(MAX_CUSTOM_LENGTH)} অক্ষরে সীমিত রাখা হয়েছে।`);
			}
		}

		for (const button of lessonButtons) {
			button.addEventListener('click', () => {
				const lessonId = button.dataset.lessonId;
				if (lessonId) selectLesson(lessonId);
			});
		}

		for (const button of modeButtons) {
			button.addEventListener('click', () => {
				const modeId = button.dataset.modeId as BanglaPracticeModeId | undefined;
				if (modeId) selectMode(modeId);
			});
		}

		for (const button of challengeButtons) {
			button.addEventListener('click', () => {
				const challengeId = button.dataset.challengeId as BanglaChallengeId | undefined;
				if (challengeId) selectChallenge(challengeId, { scroll: true });
			});
		}

		for (const button of keyboardButtons) {
			button.addEventListener('click', () => {
				const id = button.dataset.keyboardId as BanglaKeyboardId | undefined;
				if (!id || id === keyboardId) return;
				keyboardId = id;
				storeChoice(KEYBOARD_STORE_KEY, id);
				renderKeyboard();
			});
		}

		for (const button of levelButtons) {
			button.addEventListener('click', () => {
				const id = button.dataset.levelId as BanglaTypingLevelId | undefined;
				if (!id) return;
				levelId = id;
				storeChoice(LEVEL_STORE_KEY, id);
				renderLevel();
			});
		}

		toggleAllBtn.addEventListener('click', () => {
			showAllLessons = !showAllLessons;
			renderLevel();
		});

		continueBtn.addEventListener('click', () => {
			selectLesson(nextLessonFor(readProgress()).id, { scroll: true });
		});

		progressContinueBtn.addEventListener('click', () => {
			selectLesson(nextLessonFor(readProgress()).id, { scroll: true });
		});

		progressWeakBtn.addEventListener('click', () => {
			const intent = progressWeakBtn.dataset.intent === 'revision' ? 'revision' : 'letters';
			selectMode(intent, { scroll: true });
			progressStatusEl.textContent =
				intent === 'revision'
					? 'আপনার জমে থাকা ভুল অক্ষর দিয়ে ড্রিল শুরু হয়েছে।'
					: 'এখনো ভুলের তথ্য নেই, তাই বর্ণ অনুশীলন দিয়ে শুরু করুন।';
		});

		quickWordsBtn.addEventListener('click', () => selectMode('words', { scroll: true }));
		quickSentencesBtn.addEventListener('click', () => selectMode('sentences', { scroll: true }));
		quickParagraphsBtn.addEventListener('click', () =>
			selectMode('paragraphs', { scroll: true })
		);
		quickCustomBtn.addEventListener('click', () => selectMode('custom', { scroll: true }));
		mistakeDrillBtn.addEventListener('click', startMistakeDrill);

		input.addEventListener('input', (event) => {
			// IME (Avro/Bijoy/Ridmik) commits arrive as composition events; never score uncommitted text.
			if ((event as InputEvent).isComposing || composing) return;
			handleInput();
		});
		input.addEventListener('compositionstart', () => {
			composing = true;
		});
		input.addEventListener('compositionupdate', () => {
			composing = true;
		});
		input.addEventListener('compositionend', () => {
			composing = false;
			handleInput();
		});
		input.addEventListener('keydown', (event) => {
			// Targets never contain line breaks, so Enter would only insert an accidental newline.
			if (event.key === 'Enter' && !event.isComposing && !composing) event.preventDefault();
		});

		restartBtn.addEventListener('click', () => {
			if (!current) return;
			startExercise(current);
		});

		pauseBtn.addEventListener('click', () => setPaused(pausedAt === null));

		toggleTargetBtn.addEventListener('click', () => {
			targetHidden = !targetHidden;
			renderTargetVisibility();
			updateLiveHint();
		});

		nextLessonBtn.addEventListener('click', () => {
			const next = BANGLA_LESSONS[currentLessonIndex + 1];
			if (next) selectLesson(next.id, { scroll: true });
		});

		newDrillBtn.addEventListener('click', () => {
			const activeChallengeId = current?.challengeId;
			if (activeChallengeId) selectChallenge(activeChallengeId);
			else if (currentModeId) selectMode(currentModeId);
		});

		useCustomBtn?.addEventListener('click', startCustomText);
		customText.addEventListener('input', () => {
			if (customError) customError.hidden = true;
		});
		clearCustomBtn?.addEventListener('click', () => {
			customText.value = '';
			if (customError) customError.hidden = true;
			customText.focus();
		});
		startLettersBtn?.addEventListener('click', () => selectMode('letters'));

		resetBtn.addEventListener('click', () => {
			resetConfirm.hidden = false;
			progressStatusEl.textContent = '';
			resetConfirmBtn.focus();
		});
		resetCancelBtn.addEventListener('click', () => {
			resetConfirm.hidden = true;
			resetBtn.focus();
		});
		resetConfirmBtn.addEventListener('click', () => {
			try {
				window.localStorage.removeItem(PROGRESS_STORE_KEY);
				window.localStorage.removeItem(MISTAKE_STORE_KEY);
			} catch {
				// Ignore storage errors; the in-memory state is still cleared below.
			}
			recordedMistakes.clear();
			resetConfirm.hidden = true;
			renderProgress();
			progressStatusEl.textContent = 'সব অগ্রগতি মুছে ফেলা হয়েছে।';
		});

		// Start on lesson 01 so the workspace is usable immediately (without stealing focus on load).
		renderKeyboard();
		renderLevel();
		selectLesson(BANGLA_LESSONS[0].id, { focus: false, scroll: false, syncLevel: false });
		renderProgress();
	}
</script>
