</style>

<script>
	import {
		BANGLA_LESSONS,
		LESSON_LEVELS,
		PRACTICE_MODES,
		PRACTICE_POOLS,
		type BanglaPracticeMode,
		type BanglaPracticeModeId,
		type BanglaTypingLesson,
	} from '../data/banglaTypingCurriculum';

	const MISTAKE_STORE_KEY = 'wordora-bangla-typing-mistakes-v1';
	const PROGRESS_STORE_KEY = 'wordora-bangla-typing-progress-v1';
	const MAX_CUSTOM_LENGTH = 1200;

	interface Exercise {
		key: string;
		kind: 'lesson' | 'drill' | 'custom' | 'revision';
		title: string;
		source: string;
		difficulty: string;
		minAccuracy: number;
		summary: string;
		criteria: string;
		target: string;
	}

	type SegmenterCtor = new (
		locales?: string | string[],
		options?: { granularity: 'grapheme' }
	) => { segment(input: string): Iterable<{ segment: string }> };

	const Segmenter = (Intl as unknown as { Segmenter?: SegmenterCtor }).Segmenter;
	const segmenter = Segmenter ? new Segmenter('bn', { granularity: 'grapheme' }) : null;

	/** NFC keeps decomposed nukta forms (e.g. ড + ়) equal to their precomposed letters. */
	function normalizeText(text: string): string {
		try {
			return text.normalize('NFC');
		} catch {
			return text;
		}
	}

	/** Bengali vowel signs, nukta, virama, zero-width joiners and variation selectors. */
	const CLUSTER_MARK = /[\u09BC\u09BE-\u09CD\u09D7\u09E2\u09E3\u200C\u200D\uFE00-\uFE0F]/;

	/**
	 * Grapheme fallback for browsers without Intl.Segmenter: a base character keeps every
	 * following Bengali vowel sign/combining mark, and a virama or ZWJ joins the next consonant.
	 */
	function splitClustersFallback(text: string): string[] {
		const clusters: string[] = [];
		let joinsNext = false;
		for (const char of text) {
			if (clusters.length > 0 && (joinsNext || CLUSTER_MARK.test(char))) {
				clusters[clusters.length - 1] += char;
			} else {
				clusters.push(char);
			}
			joinsNext = char === '\u09CD' || char === '\u200D';
		}
		return clusters;
	}

	/**
	 * Splits NFC-normalised text into user-perceived Bengali clusters so "ক্ষ" or "কি" counts as one unit.
	 * Never indexes raw code units, so matras and conjuncts stay whole.
	 */
	function splitGraphemes(text: string): string[] {
		const normalized = normalizeText(text);
		return segmenter
			? Array.from(segmenter.segment(normalized), (part) => part.segment)
			: splitClustersFallback(normalized);
	}

	const BN_DIGITS = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];

	function bnNumber(value: number): string {
		return String(Math.round(value)).replace(/[0-9]/g, (digit) => BN_DIGITS[Number(digit)]);
	}

	function formatDuration(ms: number): string {
		const totalSeconds = Math.max(0, Math.floor(ms / 1000));
		const minutes = Math.floor(totalSeconds / 60);
		const seconds = totalSeconds % 60;
		return `${bnNumber(minutes)}:${bnNumber(seconds).padStart(2, '০')}`;
	}

	function readMistakes(): Record<string, number> {
		try {
			const raw = window.localStorage.getItem(MISTAKE_STORE_KEY);
			if (!raw) return {};
			const parsed: unknown = JSON.parse(raw);
			if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return {};
			const result: Record<string, number> = {};
			for (const [glyph, count] of Object.entries(parsed as Record<string, unknown>)) {
				if (typeof count === 'number' && Number.isFinite(count) && count > 0) result[glyph] = count;
			}
			return result;
		} catch {
			return {};
		}
	}

	function saveMistakes(store: Record<string, number>) {
		try {
			window.localStorage.setItem(MISTAKE_STORE_KEY, JSON.stringify(store));
		} catch {
			// Storage can be unavailable (private mode); practice still works, revision just stays empty.
		}
	}

	interface LessonRecord {
		attempts: number;
		completed: boolean;
		bestAccuracy: number;
		bestCpm: number;
		lastPracticedAt: string;
	}

	interface PracticeProgress {
		sessions: number;
		totalTimeMs: number;
		totalWords: number;
		totalCorrectChars: number;
		accuracySum: number;
		lessons: Record<string, LessonRecord>;
		bestSession: { accuracy: number; cpm: number; at: string } | null;
		streakCurrent: number;
		streakBest: number;
		streakLastDate: string;
	}

	function emptyProgress(): PracticeProgress {
		return {
			sessions: 0,
			totalTimeMs: 0,
			totalWords: 0,
			totalCorrectChars: 0,
			accuracySum: 0,
			lessons: {},
			bestSession: null,
			streakCurrent: 0,
			streakBest: 0,
			streakLastDate: '',
		};
	}

	function safeNumber(value: unknown, min = 0, max = 1e12): number {
		if (typeof value !== 'number' || !Number.isFinite(value)) return min;
		return Math.min(max, Math.max(min, value));
	}

	/** Loads saved progress, discarding anything malformed so corrupt data can never break the tool. */
	function readProgress(): PracticeProgress {
		const empty = emptyProgress();
		try {
			const raw = window.localStorage.getItem(PROGRESS_STORE_KEY);
			if (!raw) return empty;
			const parsed: unknown = JSON.parse(raw);
			if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return empty;
			const data = parsed as Record<string, unknown>;
			const progress = emptyProgress();

			progress.sessions = Math.round(safeNumber(data.sessions));
			progress.totalTimeMs = Math.round(safeNumber(data.totalTimeMs));
			progress.totalWords = Math.round(safeNumber(data.totalWords));
			progress.totalCorrectChars = Math.round(safeNumber(data.totalCorrectChars));
			progress.accuracySum = safeNumber(data.accuracySum);
			progress.streakCurrent = Math.round(safeNumber(data.streakCurrent));
			progress.streakBest = Math.round(safeNumber(data.streakBest));
			progress.streakLastDate =
				typeof data.streakLastDate === 'string' ? data.streakLastDate.slice(0, 10) : '';

			const lessons = data.lessons;
			if (lessons && typeof lessons === 'object' && !Array.isArray(lessons)) {
				for (const [lessonId, entry] of Object.entries(lessons as Record<string, unknown>)) {
					if (!entry || typeof entry !== 'object' || Array.isArray(entry)) continue;
					const record = entry as Record<string, unknown>;
					progress.lessons[lessonId] = {
						attempts: Math.round(safeNumber(record.attempts)),
						completed: record.completed === true,
						bestAccuracy: safeNumber(record.bestAccuracy, 0, 100),
						bestCpm: safeNumber(record.bestCpm),
						lastPracticedAt: typeof record.lastPracticedAt === 'string' ? record.lastPracticedAt : '',
					};
				}
			}

			const best = data.bestSession;
			if (best && typeof best === 'object' && !Array.isArray(best)) {
				const record = best as Record<string, unknown>;
				progress.bestSession = {
					accuracy: safeNumber(record.accuracy, 0, 100),
					cpm: safeNumber(record.cpm),
					at: typeof record.at === 'string' ? record.at : '',
				};
			}

			return progress;
		} catch {
			return empty;
		}
	}

	function saveProgress(progress: PracticeProgress) {
		try {
			window.localStorage.setItem(PROGRESS_STORE_KEY, JSON.stringify(progress));
		} catch {
			// Storage may be blocked; practice still works without saved progress.
		}
	}

	function localDateKey(date = new Date()): string {
		const year = date.getFullYear();
		const month = String(date.getMonth() + 1).padStart(2, '0');
		const day = String(date.getDate()).padStart(2, '0');
		return `${year}-${month}-${day}`;
	}

	/** Whole-day gap between two `YYYY-MM-DD` keys; Infinity when the previous key is missing. */
	function dayGap(from: string, to: string): number {
		if (!/^\d{4}-\d{2}-\d{2}$/.test(from)) return Number.POSITIVE_INFINITY;
		const parse = (value: string) => {
			const [year, month, day] = value.split('-').map(Number);
			return Date.UTC(year, (month || 1) - 1, day || 1);
		};
		return Math.round((parse(to) - parse(from)) / 86400000);
	}

	function samplePool(pool: readonly string[], size: number): string[] {
		const copy = [...pool];
		for (let i = copy.length - 1; i > 0; i -= 1) {
			const j = Math.floor(Math.random() * (i + 1));
			[copy[i], copy[j]] = [copy[j], copy[i]];
		}
		return copy.slice(0, Math.min(size, copy.length));
	}

	function lessonExercise(lesson: BanglaTypingLesson): Exercise {
		const level = LESSON_LEVELS.find((entry) => entry.id === lesson.level);
		return {
			key: lesson.id,
			kind: 'lesson',
			title: lesson.title,
			source: `পাঠ ${lesson.number} · ${level?.label ?? ''}`.trim(),
			difficulty: lesson.difficulty,
			minAccuracy: lesson.minAccuracy,
			summary: lesson.summary,
			criteria: lesson.criteria,
			target: lesson.target,
		};
	}

	function generateDrill(mode: BanglaPracticeMode): string {
		if (!mode.poolKey) return '';
		const pool = PRACTICE_POOLS[mode.poolKey];
		const size = mode.sampleSize ?? Math.min(8, pool.length);
		return samplePool(pool, size).join(' ');
	}

	const root = document.querySelector<HTMLElement>('[data-bangla-practice]');
	if (root) setupPractice(root);

	function setupPractice(root: HTMLElement) {
		function requireElement<T extends HTMLElement>(id: string): T {
			const element = root.querySelector<T>(`#${id}`);
			if (!element) throw new Error(`Bangla typing practice: missing #${id}`);
			return element;
		}

		function optionalElement<T extends HTMLElement>(id: string): T | null {
			return root.querySelector<T>(`#${id}`);
		}

		const exercisePanel = requireElement<HTMLDivElement>('exercise-panel');
		const targetEl = requireElement<HTMLDivElement>('target-text');
		const input = requireElement<HTMLTextAreaElement>('typing-input');
		const customPanel = requireElement<HTMLDivElement>('custom-panel');
		const customText = requireElement<HTMLTextAreaElement>('custom-text');
		const revisionEmpty = requireElement<HTMLDivElement>('revision-empty');
		const statusEl = requireElement<HTMLParagraphElement>('practice-status');
		const titleEl = requireElement<HTMLHeadingElement>('exercise-title');
		const sourceEl = requireElement<HTMLParagraphElement>('exercise-source');
		const difficultyEl = requireElement<HTMLSpanElement>('exercise-difficulty');
		const accuracyEl = requireElement<HTMLSpanElement>('exercise-accuracy');
		const summaryEl = requireElement<HTMLParagraphElement>('exercise-summary');
		const criteriaEl = requireElement<HTMLParagraphElement>('exercise-criteria');
		const speedEl = requireElement<HTMLElement>('metric-speed');
		const metricAccuracyEl = requireElement<HTMLElement>('metric-accuracy');
		const timeEl = requireElement<HTMLElement>('metric-time');
		const progressEl = requireElement<HTMLElement>('metric-progress');
		const progressTrack = requireElement<HTMLDivElement>('progress-track');
		const progressBar = requireElement<HTMLDivElement>('progress-bar');
		const restartBtn = requireElement<HTMLButtonElement>('btn-restart');
		const nextLessonBtn = requireElement<HTMLButtonElement>('btn-next-lesson');
		const newDrillBtn = requireElement<HTMLButtonElement>('btn-new-drill');
		const progressSessionsEl = requireElement<HTMLElement>('progress-sessions');
		const progressLessonsEl = requireElement<HTMLElement>('progress-lessons');
		const progressPercentEl = requireElement<HTMLElement>('progress-percent');
		const progressAccuracyEl = requireElement<HTMLElement>('progress-accuracy');
		const progressTimeEl = requireElement<HTMLElement>('progress-time');
		const progressWordsEl = requireElement<HTMLElement>('progress-words');
		const progressStreakEl = requireElement<HTMLElement>('progress-streak');
		const progressBestEl = requireElement<HTMLElement>('progress-best');
		const progressTrackEl = requireElement<HTMLDivElement>('progress-lesson-track');
		const progressBarEl = requireElement<HTMLDivElement>('progress-lesson-bar');
		const weakGlyphsEl = requireElement<HTMLDivElement>('weak-glyphs');
		const weakEmptyEl = requireElement<HTMLParagraphElement>('weak-empty');
		const progressStatusEl = requireElement<HTMLParagraphElement>('progress-status');
		const resetBtn = requireElement<HTMLButtonElement>('btn-reset-progress');
		const resetConfirm = requireElement<HTMLDivElement>('reset-confirm');
		const resetConfirmBtn = requireElement<HTMLButtonElement>('btn-reset-confirm');
		const resetCancelBtn = requireElement<HTMLButtonElement>('btn-reset-cancel');

		// Optional only because they live in panels that may be re-styled later.
		const customError = optionalElement<HTMLParagraphElement>('custom-error');
		const resultEl = optionalElement<HTMLParagraphElement>('result-details');
		const useCustomBtn = optionalElement<HTMLButtonElement>('btn-use-custom');
		const clearCustomBtn = optionalElement<HTMLButtonElement>('btn-clear-custom');
		const startLettersBtn = optionalElement<HTMLButtonElement>('btn-start-letters');

		const lessonButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-lesson-id]'));
		const modeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mode-id]'));

		let current: Exercise | null = null;
		let currentModeId: BanglaPracticeModeId | null = null;
		let currentLessonIndex = -1;
		let targetGlyphs: string[] = [];
		let glyphEls: HTMLSpanElement[] = [];
		let startedAt: number | null = null;
		let finishedAt: number | null = null;
		let finished = false;
		let composing = false;
		let timerId: number | null = null;
		const recordedMistakes = new Set<number>();

		function setStatus(message: string) {
			statusEl.textContent = message;
		}

		function setResult(details: string | null) {
			if (!resultEl) return;
			resultEl.textContent = details ?? '';
			resultEl.hidden = details === null;
		}

		function renderWeakGlyphs() {
			const entries = Object.entries(readMistakes())
				.filter(([glyph]) => glyph.trim().length > 0)
				.sort((a, b) => b[1] - a[1])
				.slice(0, 8);

			weakGlyphsEl.textContent = '';
			weakEmptyEl.hidden = entries.length > 0;

			for (const [glyph, count] of entries) {
				const chip = document.createElement('span');
				chip.className = 'bp-weak-chip';
				chip.textContent = `${glyph} · ${bnNumber(count)}`;
				weakGlyphsEl.append(chip);
			}
		}

		function renderProgress() {
			const progress = readProgress();
			const completedLessons = BANGLA_LESSONS.filter(
				(lesson) => progress.lessons[lesson.id]?.completed
			).length;
			const percent =
				BANGLA_LESSONS.length > 0 ? (completedLessons / BANGLA_LESSONS.length) * 100 : 0;
			const averageAccuracy = progress.sessions > 0 ? progress.accuracySum / progress.sessions : null;

			progressLessonsEl.textContent = `${bnNumber(completedLessons)} / ${bnNumber(BANGLA_LESSONS.length)}`;
			progressPercentEl.textContent = `${bnNumber(percent)}%`;
			progressSessionsEl.textContent = bnNumber(progress.sessions);
			progressAccuracyEl.textContent =
				averageAccuracy === null ? '—' : `${bnNumber(averageAccuracy)}%`;
			progressTimeEl.textContent = formatDuration(progress.totalTimeMs);
			progressWordsEl.textContent = bnNumber(progress.totalWords);
			progressStreakEl.textContent =
				progress.streakCurrent > 0
					? `${bnNumber(progress.streakCurrent)} দিন (সেরা ${bnNumber(progress.streakBest)})`
					: '—';
			progressBestEl.textContent = progress.bestSession
				? progress.bestSession.cpm > 0
					? `${bnNumber(progress.bestSession.accuracy)}% · ${bnNumber(progress.bestSession.cpm)} অক্ষর/মিনিট`
					: `${bnNumber(progress.bestSession.accuracy)}%`
				: '—';

			progressBarEl.style.width = `${percent.toFixed(1)}%`;
			progressTrackEl.setAttribute('aria-valuenow', String(Math.round(percent)));

			renderWeakGlyphs();
		}

		function recordSession(
			stats: { accuracy: number; cpm: number | null; correct: number; ms: number },
			lessonId: string | null,
			success: boolean,
			target: string
		) {
			const progress = readProgress();
			const now = new Date();
			const today = localDateKey(now);
			const cpm = stats.cpm ?? 0;

			progress.sessions += 1;
			progress.totalTimeMs += Math.max(0, stats.ms);
			progress.totalCorrectChars += Math.max(0, stats.correct);
			progress.totalWords += normalizeText(target)
				.trim()
				.split(/\s+/)
				.filter(Boolean).length;
			progress.accuracySum += stats.accuracy;

			const best = progress.bestSession;
			const betterAccuracy = !best || stats.accuracy > best.accuracy + 0.01;
			const sameAccuracyFaster =
				!!best && Math.abs(stats.accuracy - best.accuracy) <= 0.01 && cpm > best.cpm;
			if (betterAccuracy || sameAccuracyFaster) {
				progress.bestSession = {
					accuracy: stats.accuracy,
					cpm,
					at: now.toISOString(),
				};
			}

			if (progress.streakLastDate === today) {
				progress.streakCurrent = Math.max(1, progress.streakCurrent);
			} else {
				const gap = dayGap(progress.streakLastDate, today);
				progress.streakCurrent = gap === 1 ? progress.streakCurrent + 1 : 1;
			}
			progress.streakLastDate = today;
			progress.streakBest = Math.max(progress.streakBest, progress.streakCurrent);

			if (lessonId) {
				const existing = progress.lessons[lessonId] ?? {
					attempts: 0,
					completed: false,
					bestAccuracy: 0,
					bestCpm: 0,
					lastPracticedAt: '',
				};
				existing.attempts += 1;
				existing.completed = existing.completed || success;
				existing.bestAccuracy = Math.max(existing.bestAccuracy, stats.accuracy);
				existing.bestCpm = Math.max(existing.bestCpm, cpm);
				existing.lastPracticedAt = now.toISOString();
				progress.lessons[lessonId] = existing;
			}

			saveProgress(progress);
			renderProgress();
		}

		function elapsedMs(): number {
			if (startedAt === null) return 0;
			return (finishedAt ?? Date.now()) - startedAt;
		}

		function stopTimer() {
			if (timerId !== null) {
				window.clearInterval(timerId);
				timerId = null;
			}
		}

		function startTimer() {
			if (timerId !== null) return;
			timerId = window.setInterval(() => {
				if (!finished) updateMetrics();
			}, 250);
		}

		/**
		 * Single source of truth for every visible metric. Correct/incorrect counts, accuracy,
		 * progress and speed are all derived from the same grapheme comparison, so the numbers
		 * on screen, the completion check and the saved session can never disagree.
		 */
		function analyze() {
			const typed = splitGraphemes(input.value);
			const total = targetGlyphs.length;
			const overlap = Math.min(typed.length, total);
			let correct = 0;
			for (let i = 0; i < overlap; i += 1) {
				if (typed[i] === targetGlyphs[i]) correct += 1;
			}
			const mismatched = overlap - correct;
			const extra = Math.max(0, typed.length - total);
			const incorrect = mismatched + extra;
			const missing = Math.max(0, total - typed.length);
			const accuracy = typed.length > 0 ? (correct / typed.length) * 100 : 100;
			const progress = total > 0 ? overlap / total : 0;
			const ms = elapsedMs();
			// Speed only becomes meaningful after a full second; shorter spans report null, not a fake number.
			const cpm = ms >= 1000 ? correct / (ms / 60000) : null;
			return { typed, total, correct, incorrect, mismatched, extra, missing, accuracy, progress, ms, cpm };
		}

		function paintTarget(typed: string[]) {
			for (let i = 0; i < glyphEls.length; i += 1) {
				let state: 'correct' | 'wrong' | 'current' | 'pending';
				if (i < typed.length) {
					state = typed[i] === targetGlyphs[i] ? 'correct' : 'wrong';
				} else if (i === typed.length) {
					state = 'current';
				} else {
					state = 'pending';
				}
				const glyph = glyphEls[i];
				if (glyph.dataset.state !== state) glyph.dataset.state = state;
			}
		}

		function updateMetrics() {
			const stats = analyze();
			speedEl.textContent = stats.cpm === null ? '—' : bnNumber(stats.cpm);
			metricAccuracyEl.textContent = `${bnNumber(stats.accuracy)}%`;
			timeEl.textContent = formatDuration(stats.ms);
			progressEl.textContent = `${bnNumber(stats.total - stats.missing)} / ${bnNumber(stats.total)}`;
			progressTrack.setAttribute('aria-valuenow', String(Math.round(stats.progress * 100)));
			progressBar.style.width = `${(stats.progress * 100).toFixed(1)}%`;

			paintTarget(stats.typed);
		}

		function renderTarget(text: string) {
			targetGlyphs = splitGraphemes(text);
			glyphEls = [];
			const fragment = document.createDocumentFragment();
			for (const glyph of targetGlyphs) {
				const span = document.createElement('span');
				span.className = 'bp-glyph';
				span.dataset.state = 'pending';
				span.textContent = glyph;
				glyphEls.push(span);
				fragment.append(span);
			}
			targetEl.textContent = '';
			targetEl.append(fragment);
		}

		function addMistake(glyph: string) {
			if (!glyph || !glyph.trim()) return;
			const store = readMistakes();
			store[glyph] = (store[glyph] ?? 0) + 1;
			saveMistakes(store);
		}

		function recordMistakes(typed: string[]) {
			for (let i = 0; i < typed.length && i < targetGlyphs.length; i += 1) {
				if (typed[i] !== targetGlyphs[i] && !recordedMistakes.has(i)) {
					recordedMistakes.add(i);
					addMistake(targetGlyphs[i]);
				}
			}
		}

		function syncSelection(source: { kind: 'lesson' | 'mode'; id: string } | null) {
			for (const button of lessonButtons) {
				const active = source?.kind === 'lesson' && button.dataset.lessonId === source.id;
				button.classList.toggle('is-active', active);
				button.setAttribute('aria-pressed', active ? 'true' : 'false');
			}
			for (const button of modeButtons) {
				const active = source?.kind === 'mode' && button.dataset.modeId === source.id;
				button.classList.toggle('is-active', active);
				button.setAttribute('aria-pressed', active ? 'true' : 'false');
			}
		}

		function updateActionVisibility() {
			nextLessonBtn.hidden = !(
				current?.kind === 'lesson' &&
				currentLessonIndex >= 0 &&
				currentLessonIndex < BANGLA_LESSONS.length - 1
			);
			newDrillBtn.hidden = !(current?.kind === 'drill' && currentModeId !== null);
		}

		function startExercise(exercise: Exercise, options: { focus?: boolean } = {}) {
			current = exercise;
			targetGlyphs = [];
			recordedMistakes.clear();
			finished = false;
			composing = false;
			startedAt = null;
			finishedAt = null;
			stopTimer();

			titleEl.textContent = exercise.title;
			sourceEl.textContent = exercise.source;
			difficultyEl.textContent = exercise.difficulty;
			accuracyEl.textContent = `ন্যূনতম নির্ভুলতা ${bnNumber(exercise.minAccuracy)}%`;
			summaryEl.textContent = exercise.summary;
			criteriaEl.textContent = `সম্পন্ন করার শর্ত: ${exercise.criteria}`;

			input.value = '';
			input.readOnly = false;
			renderTarget(exercise.target);
			exercisePanel.hidden = false;
			setStatus('');
			setResult(null);
			updateMetrics();
			updateActionVisibility();
			if (options.focus !== false) input.focus();
		}

		function checkCompletion() {
			if (finished || !current || targetGlyphs.length === 0) return;
			const typed = splitGraphemes(input.value);
			if (typed.length < targetGlyphs.length) return;

			finished = true;
			finishedAt = Date.now();
			stopTimer();
			input.readOnly = true;
			updateMetrics();

			const stats = analyze();
			const success = stats.accuracy >= current.minAccuracy;
			const speedSummary =
				stats.cpm === null
					? 'গতি পরিমাপ হয়নি (১ সেকেন্ডের কম সময়)'
					: `গতি ${bnNumber(stats.cpm)} অক্ষর/মিনিট`;
			setStatus(
				success
					? `${current.title} সম্পন্ন হয়েছে। নির্ভুলতা ${bnNumber(stats.accuracy)}%। চাইলে পরের পাঠে যান বা একই পাঠ আবার করুন।`
					: `লেখাটি শেষ হয়েছে, তবে নির্ভুলতা ${bnNumber(stats.accuracy)}% — লক্ষ্য ${bnNumber(current.minAccuracy)}%। "আবার শুরু করুন" চেপে আবার চেষ্টা করুন।`
			);
			setResult(
				`${speedSummary} · সময় ${formatDuration(stats.ms)} · ভুল ${bnNumber(
					stats.incorrect
				)}টি · সঠিক ${bnNumber(stats.correct)} / ${bnNumber(stats.total)} অক্ষর`
			);

			recordSession(stats, current.kind === 'lesson' ? current.key : null, success, current.target);
		}

		function handleInput() {
			if (finished || composing) return;
			const typed = splitGraphemes(input.value);

			if (typed.length === 0) {
				// Clearing the field restarts the clock instead of leaving a stalled timer behind.
				stopTimer();
				startedAt = null;
				finishedAt = null;
			} else if (startedAt === null) {
				startedAt = Date.now();
				startTimer();
			}

			recordMistakes(typed);
			updateMetrics();
			checkCompletion();
		}

		function selectLesson(lessonId: string, focus = true) {
			const index = BANGLA_LESSONS.findIndex((lesson) => lesson.id === lessonId);
			if (index === -1) return;
			const lesson = BANGLA_LESSONS[index];
			currentLessonIndex = index;
			currentModeId = null;
			customPanel.hidden = true;
			revisionEmpty.hidden = true;
			syncSelection({ kind: 'lesson', id: lesson.id });
			startExercise(lessonExercise(lesson), { focus });
		}

		function getRevisionGlyphs(): string[] {
			return Object.entries(readMistakes())
				.filter(([glyph]) => glyph.trim().length > 0)
				.sort((a, b) => b[1] - a[1])
				.slice(0, 12)
				.map(([glyph]) => glyph);
		}

		function selectMode(modeId: BanglaPracticeModeId) {
			const mode = PRACTICE_MODES.find((entry) => entry.id === modeId);
			if (!mode) return;

			currentModeId = mode.id;
			currentLessonIndex = -1;
			customPanel.hidden = mode.kind !== 'custom';
			revisionEmpty.hidden = true;
			syncSelection({ kind: 'mode', id: mode.id });

			if (mode.kind === 'custom') {
				exercisePanel.hidden = true;
				current = null;
				updateActionVisibility();
				setResult(null);
				setStatus('নিচের বাক্সে আপনার লেখা দিন, তারপর "এই লেখা দিয়ে শুরু করুন" চাপুন।');
				customText.focus();
				return;
			}

			if (mode.kind === 'revision') {
				const glyphs = getRevisionGlyphs();
				if (glyphs.length === 0) {
					exercisePanel.hidden = true;
					current = null;
					updateActionVisibility();
					setResult(null);
					setStatus('');
					revisionEmpty.hidden = false;
					return;
				}
				startExercise({
					key: `revision-${Date.now()}`,
					kind: 'revision',
					title: mode.label,
					source: 'অনুশীলন মোড',
					difficulty: mode.difficulty,
					minAccuracy: mode.minAccuracy,
					summary: mode.summary,
					criteria: `আপনার জমে থাকা ভুল অক্ষরগুলো সম্পূর্ণ টাইপ করুন, ন্যূনতম ${bnNumber(
						mode.minAccuracy
					)}% নির্ভুলতায়।`,
					target: glyphs.join(' '),
				});
				setStatus(
					`আপনার জমে থাকা ${bnNumber(glyphs.length)}টি ভুল অক্ষর থেকে ড্রিল তৈরি হয়েছে। যেগুলো বেশি ভুল হয়েছে সেগুলো আগে আছে।`
				);
				return;
			}

			startExercise({
				key: `${mode.id}-${Date.now()}`,
				kind: 'drill',
				title: mode.label,
				source: 'অনুশীলন মোড',
				difficulty: mode.difficulty,
				minAccuracy: mode.minAccuracy,
				summary: mode.summary,
				criteria: `পুরো ড্রিলটি সম্পূর্ণ টাইপ করুন, ন্যূনতম ${bnNumber(
					mode.minAccuracy
				)}% নির্ভুলতায়।`,
				target: generateDrill(mode),
			});
		}

		function startCustomText() {
			const normalized = customText.value.replace(/\s+/g, ' ').trim();
			// Counted in code points, not clusters: short words like "বাংলা" are only two clusters.
			if (Array.from(normalized).length < 3) {
				if (customError) {
					customError.textContent = 'কমপক্ষে ৩টি অক্ষর লিখুন বা পেস্ট করুন।';
					customError.hidden = false;
				}
				return;
			}
			if (customError) customError.hidden = true;

			const mode = PRACTICE_MODES.find((entry) => entry.id === 'custom');
			const truncated = splitGraphemes(normalized).slice(0, MAX_CUSTOM_LENGTH).join('');
			startExercise({
				key: `custom-${Date.now()}`,
				kind: 'custom',
				title: 'আপনার নিজের লেখা',
				source: 'অনুশীলন মোড',
				difficulty: mode?.difficulty ?? 'নিজের পছন্দ',
				minAccuracy: mode?.minAccuracy ?? 85,
				summary:
					'আপনার দেওয়া লেখাটি হুবহু টাইপ করুন। লেখাটি কোথাও পাঠানো হয় না, শুধু এই ব্রাউজার সেশনেই থাকে।',
				criteria: `আপনার লেখাটি সম্পূর্ণ টাইপ করুন, ন্যূনতম ${bnNumber(
					mode?.minAccuracy ?? 85
				)}% নির্ভুলতায়।`,
				target: truncated,
			});
			if (truncated !== normalized) {
				setStatus(`লেখাটি ${bnNumber(MAX_CUSTOM_LENGTH)} অক্ষরে সীমিত রাখা হয়েছে।`);
			}
		}

		for (const button of lessonButtons) {
			button.addEventListener('click', () => {
				const lessonId = button.dataset.lessonId;
				if (lessonId) selectLesson(lessonId);
			});
		}

		for (const button of modeButtons) {
			button.addEventListener('click', () => {
				const modeId = button.dataset.modeId as BanglaPracticeModeId | undefined;
				if (modeId) selectMode(modeId);
			});
		}

		input.addEventListener('input', (event) => {
			// IME (Avro/Bijoy/Ridmik) commits arrive as composition events; never score uncommitted text.
			if (event.isComposing || composing) return;
			handleInput();
		});
		input.addEventListener('compositionstart', () => {
			composing = true;
		});
		input.addEventListener('compositionupdate', () => {
			composing = true;
		});
		input.addEventListener('compositionend', () => {
			composing = false;
			handleInput();
		});
		input.addEventListener('keydown', (event) => {
			// Targets never contain line breaks, so Enter would only insert an accidental newline.
			if (event.key === 'Enter' && !event.isComposing && !composing) event.preventDefault();
		});

		restartBtn.addEventListener('click', () => {
			if (!current) return;
			startExercise(current);
		});

		nextLessonBtn.addEventListener('click', () => {
			const next = BANGLA_LESSONS[currentLessonIndex + 1];
			if (next) selectLesson(next.id);
		});

		newDrillBtn.addEventListener('click', () => {
			if (currentModeId) selectMode(currentModeId);
		});

		useCustomBtn?.addEventListener('click', startCustomText);
		customText.addEventListener('input', () => {
			if (customError) customError.hidden = true;
		});
		clearCustomBtn?.addEventListener('click', () => {
			customText.value = '';
			if (customError) customError.hidden = true;
			customText.focus();
		});
		startLettersBtn?.addEventListener('click', () => selectMode('letters'));

		resetBtn.addEventListener('click', () => {
			resetConfirm.hidden = false;
			progressStatusEl.textContent = '';
			resetConfirmBtn.focus();
		});
		resetCancelBtn.addEventListener('click', () => {
			resetConfirm.hidden = true;
			resetBtn.focus();
		});
		resetConfirmBtn.addEventListener('click', () => {
			try {
				window.localStorage.removeItem(PROGRESS_STORE_KEY);
				window.localStorage.removeItem(MISTAKE_STORE_KEY);
			} catch {
				// Ignore storage errors; the in-memory state is still cleared below.
			}
			recordedMistakes.clear();
			resetConfirm.hidden = true;
			renderProgress();
			progressStatusEl.textContent = 'সব অগ্রগতি মুছে ফেলা হয়েছে।';
		});

		// Start on lesson 01 so the workspace is usable immediately (without stealing focus on load).
		selectLesson(BANGLA_LESSONS[0].id, false);
		renderProgress();
	}
</script>
