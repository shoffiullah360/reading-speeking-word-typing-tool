---
import {
	BANGLA_LESSONS,
	KEYBOARD_CONTEXTS,
	LESSON_LEVELS,
	PRACTICE_MODES,
	type BanglaTypingLesson,
} from "../data/banglaTypingCurriculum";
import { BANGLA_CHALLENGES } from "../data/banglaTypingChallenges";

const lessonsByLevel = LESSON_LEVELS.map((level) => ({
	...level,
	lessons: BANGLA_LESSONS.filter((lesson: BanglaTypingLesson) => lesson.level === level.id),
}));

const firstLesson = BANGLA_LESSONS[0];

const bengaliDigits = (value: number) =>
	String(value).replace(/[0-9]/g, (digit) => "০১২৩৪৫৬৭৮৯"[Number(digit)]);

/** Grapheme-safe split so matras and conjuncts count as a single character. */
const splitClusters = (text: string) =>
	Array.from(new Intl.Segmenter("bn", { granularity: "grapheme" }).segment(text.normalize("NFC")), (part) => part.segment);

const firstLessonClusters = splitClusters(firstLesson.target);

/** Level → palette tone, so beginner/intermediate/advanced stay colour-coded. */
const levelTones: Record<string, "mint" | "sand" | "orange"> = {
	beginner: "mint",
	intermediate: "sand",
	advanced: "orange",
};

/** Keyboard context → palette tone, matching the visual keyboards further down the page. */
const keyboardTones: Record<string, "mint" | "sand" | "orange"> = {
	avro: "mint",
	bijoy: "sand",
	general: "orange",
};

const firstGuidance = firstLesson.guidance.avro;
---

<div class="bangla-practice" data-bangla-practice>
	<!-- Workspace surface: modes, exercise and lessons sit on one warm-sand panel -->
	<div class="bp-workspace">
	<!-- Learning path: keyboard context, level and the lesson 01 entry point -->
	<section id="learning-path" aria-labelledby="learning-path-heading">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0">
				<h3 id="learning-path-heading" class="text-[15px] font-semibold text-ink">শেখার পথ</h3>
				<p class="mt-1 max-w-xl text-[13.5px] leading-relaxed text-body">
					প্রথমে কীবোর্ড ও স্তর বেছে নিন, তারপর পাঠ ০১ থেকে শুরু করুন। চাইলে শব্দ, বাক্য, অনুচ্ছেদ বা
					নিজের লেখা দিয়ে সরাসরি অনুশীলনও করতে পারেন।
				</p>
			</div>
			<span id="path-progress" class="bp-pill bp-pill-sand tabular-nums">
				০ / {bengaliDigits(BANGLA_LESSONS.length)} পাঠ সম্পন্ন
			</span>
		</div>

		<div class="mt-4 grid gap-4 sm:grid-cols-2">
			<div class="min-w-0">
				<p id="keyboard-label" class="text-[12.5px] font-medium text-mute">কীবোর্ড</p>
				<div role="group" aria-labelledby="keyboard-label" class="mt-2 flex flex-wrap gap-2">
					{
						KEYBOARD_CONTEXTS.map((keyboard, index) => (
							<button
								type="button"
								class={index === 0 ? 'bp-choice is-active' : 'bp-choice'}
								data-keyboard-id={keyboard.id}
								data-tone={keyboardTones[keyboard.id]}
								aria-pressed={index === 0 ? 'true' : 'false'}
							>
								<span class="bp-dot" aria-hidden="true" />
								{keyboard.label}
							</button>
						))
					}
				</div>
				<p id="keyboard-note" class="mt-2 text-[12.5px] leading-relaxed text-mute">
					{KEYBOARD_CONTEXTS[0].summary}
				</p>
			</div>
			<div class="min-w-0">
				<p id="level-label" class="text-[12.5px] font-medium text-mute">স্তর</p>
				<div role="group" aria-labelledby="level-label" class="mt-2 flex flex-wrap gap-2">
					{
						LESSON_LEVELS.map((level, index) => (
							<button
								type="button"
								class={index === 0 ? 'bp-choice is-active' : 'bp-choice'}
								data-level-id={level.id}
								data-tone={levelTones[level.id]}
								aria-pressed={index === 0 ? 'true' : 'false'}
							>
								<span class="bp-dot" aria-hidden="true" />
								{level.label}
								<span class="bp-choice-count tabular-nums" data-level-count={level.id}>
									০ / {bengaliDigits(lessonsByLevel[index].lessons.length)}
								</span>
							</button>
						))
					}
				</div>
				<p id="level-note" class="mt-2 text-[12.5px] leading-relaxed text-mute">
					{LESSON_LEVELS[0].description}
				</p>
			</div>
		</div>

		<div class="mt-4 flex flex-wrap items-center gap-2.5">
			<button type="button" id="btn-continue" class="bp-action bp-action-primary">
				পাঠ ০১ শুরু করুন
			</button>
		</div>
		<p class="mt-3 text-[12.5px] font-medium text-mute">দ্রুত অনুশীলন</p>
		<div class="mt-2 flex flex-wrap gap-2">
			<button type="button" id="btn-quick-words" class="bp-action bp-action-secondary">শব্দ</button>
			<button type="button" id="btn-quick-sentences" class="bp-action bp-action-secondary">বাক্য</button>
			<button type="button" id="btn-quick-paragraphs" class="bp-action bp-action-secondary">অনুচ্ছেদ</button>
			<button type="button" id="btn-quick-custom" class="bp-action bp-action-secondary">নিজের লেখা</button>
		</div>
	</section>

	<!-- Practice mode selector -->
	<div class="mt-6 border-t border-hairline pt-5">
		<h3 class="text-[15px] font-semibold text-ink">অনুশীলনের ধরন বেছে নিন</h3>
		<p class="mt-1 text-[13.5px] leading-relaxed text-body">
			যে ধরনের লেখা নিয়ে অনুশীলন করতে চান, সেটি বেছে নিন। পাঠ বেছে নিলে অনুশীলন সেই পাঠেই চলে যাবে।
		</p>
		<div role="group" aria-label="টাইপিং অনুশীলন মোড" class="mt-3 flex flex-wrap gap-2">
			{
				PRACTICE_MODES.map((mode) => (
					<button
						type="button"
						class="bp-choice"
						data-mode-id={mode.id}
						data-tone={mode.kind === 'drill' ? 'mint' : mode.kind === 'custom' ? 'sand' : 'orange'}
						aria-pressed="false"
					>
						<span class="bp-dot" aria-hidden="true"></span>
						{mode.label}
					</button>
				))
			}
		</div>
	</div>

	<!-- Practice games: three compact challenges running on the same typing engine -->
	<div class="mt-6 border-t border-hairline pt-5">
		<h3 class="text-[15px] font-semibold text-ink">চ্যালেঞ্জ</h3>
		<p class="mt-1 text-[13.5px] leading-relaxed text-body">
			সময়, নির্ভুলতা বা কঠিন শব্দ—একটি বেছে নিন। টাইপিং শুরু করলেই চ্যালেঞ্জের হিসাব শুরু হবে।
		</p>
		<div role="group" aria-label="টাইপিং চ্যালেঞ্জ" class="mt-3 grid gap-2 sm:grid-cols-3">
			{
				BANGLA_CHALLENGES.map((challenge) => (
					<button
						type="button"
						class="bp-challenge-card"
						data-challenge-id={challenge.id}
						data-tone={challenge.tone}
						aria-pressed="false"
					>
						<span class="bp-challenge-card-title">{challenge.label}</span>
						<span class="bp-challenge-card-note">{challenge.summary}</span>
					</button>
				))
			}
		</div>
	</div>

	<!-- Custom text panel -->
	<div id="custom-panel" hidden class="bp-inset bp-inset-sand mt-4">
		<label for="custom-text" class="block text-[13.5px] font-medium text-ink">আপনার লেখা</label>
		<textarea
			id="custom-text"
			rows="5"
			maxlength="1200"
			lang="bn"
			spellcheck="false"
			autocomplete="off"
			class="bp-input mt-2 w-full px-3.5 py-3 text-[17px] leading-[1.8] text-ink"
			placeholder="এখানে বাংলা লেখা পেস্ট করুন বা টাইপ করুন…"></textarea>
		<p class="mt-2 text-[12.5px] leading-relaxed text-mute">
			লেখাটি শুধু আপনার ব্রাউজারেই থাকে, কোনো সার্ভারে পাঠানো হয় না। লাইন ব্রেক স্পেস হিসেবে ধরা হয়।
		</p>
		<p id="custom-error" hidden class="mt-1.5 text-[12.5px] font-medium text-[#B42318] dark:text-[#FDA29B]"></p>
		<div class="mt-3 flex flex-wrap gap-2">
			<button type="button" id="btn-use-custom" class="bp-action bp-action-primary">
				এই লেখা দিয়ে শুরু করুন
			</button>
			<button type="button" id="btn-clear-custom" class="bp-action bp-action-secondary">লেখা মুছুন</button>
		</div>
	</div>

	<!-- Revision empty state -->
	<div id="revision-empty" hidden class="bp-inset bp-inset-orange mt-4">
		<p class="text-[14px] leading-relaxed text-body">
			এখনো নির্ভরযোগ্য কোনো ভুলের তথ্য নেই। অন্তত একটি অনুশীলনে ভুল টাইপ করলে সেই অক্ষরগুলো এখানে জমা হবে,
			তারপর এই মোডে শুধু সেগুলো দিয়েই ড্রিল তৈরি হবে।
		</p>
		<button type="button" id="btn-start-letters" class="bp-action bp-action-secondary mt-3">
			বর্ণ অনুশীলন শুরু করুন
		</button>
	</div>

	<!-- Exercise panel -->
	<div id="exercise-panel" class="mt-6 border-t border-hairline pt-5">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0">
				<p id="exercise-source" class="text-[12.5px] font-medium text-mute">
					পাঠ {firstLesson.number} · শিক্ষানবিস
				</p>
				<h3
					id="exercise-title"
					class="mt-1 text-[19px] leading-[26px] font-semibold tracking-[-0.3px] text-ink"
				>
					{firstLesson.title}
				</h3>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<span id="exercise-difficulty" class="bp-pill bp-pill-sand">
					{firstLesson.difficulty}
				</span>
				<span id="exercise-accuracy" class="bp-pill bp-pill-orange tabular-nums">
					ন্যূনতম নির্ভুলতা ৯৫%
				</span>
			</div>
		</div>

		<p id="exercise-summary" class="mt-2.5 max-w-2xl text-[14px] leading-relaxed text-body">
			{firstLesson.summary}
		</p>
		<p id="exercise-criteria" class="mt-1.5 max-w-2xl text-[13.5px] leading-relaxed text-mute">
			সম্পন্ন করার শর্ত: {firstLesson.criteria}
		</p>

		<!-- Live challenge strip: countdown, speed and accuracy while a game is running -->
		<div id="challenge-banner" hidden class="bp-challenge mt-4" data-state="normal">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<div class="min-w-0">
					<p id="challenge-title" class="text-[13.5px] font-semibold text-ink"></p>
					<p id="challenge-hint" class="mt-0.5 text-[12.5px] leading-relaxed text-body"></p>
				</div>
				<span id="challenge-badge" class="bp-pill bp-pill-orange">চ্যালেঞ্জ</span>
			</div>
			<dl class="bp-challenge-metrics mt-3" aria-label="চ্যালেঞ্জের লাইভ হিসাব">
				<div class="bp-challenge-metric">
					<dt>গতি (শব্দ/মিনিট)</dt>
					<dd id="challenge-wpm" class="tabular-nums">—</dd>
				</div>
				<div class="bp-challenge-metric">
					<dt>নির্ভুলতা</dt>
					<dd id="challenge-accuracy" class="tabular-nums">—</dd>
				</div>
				<div class="bp-challenge-metric">
					<dt id="challenge-extra-label">বাকি সময়</dt>
					<dd id="challenge-extra" class="tabular-nums">—</dd>
				</div>
			</dl>
		</div>

		<div id="lesson-brief" class="bp-inset bp-inset-mint mt-4">
			<p class="text-[12.5px] font-medium text-mute">এই পাঠে যা শিখবেন</p>
			<p id="lesson-explanation" class="mt-1 text-[13.5px] leading-relaxed text-body">
				{firstLesson.explanation}
			</p>
		</div>

		<!-- Layout-specific typing guidance, swapped when the keyboard changes -->
		<div id="layout-guide" class="bp-layout-guide mt-4">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<p id="layout-guide-title" class="text-[12.5px] font-medium text-mute">
					অভ্র ফোনেটিকে যেভাবে লিখবেন
				</p>
				<span id="layout-guide-badge" class="bp-pill bp-pill-mint">অভ্র ফোনেটিক</span>
			</div>
			<p id="layout-guide-note" class="mt-1.5 text-[13px] leading-relaxed text-body">
				{firstGuidance.note}
			</p>
			<ul
				id="layout-guide-examples"
				class="mt-2.5 flex flex-wrap gap-2"
				aria-label="কী ও অক্ষরের উদাহরণ"
			>
				{
					firstGuidance.examples.map((example) => (
						<li class="bp-key-chip">
							<span class="bp-key-chip-input">{example.input}</span>
							<span class="bp-key-chip-arrow" aria-hidden="true">
								→
							</span>
							<span class="bp-key-chip-output" lang="bn">
								{example.output}
							</span>
						</li>
					))
				}
			</ul>
		</div>

		<dl class="mt-5 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
			<div class="bp-metric" data-tone="mint">
				<dt class="text-[12px] font-medium text-mute">গতি (অক্ষর/মিনিট)</dt>
				<dd id="metric-speed" class="bp-metric-value tabular-nums">—</dd>
			</div>
			<div class="bp-metric" data-tone="orange">
				<dt class="text-[12px] font-medium text-mute">নির্ভুলতা</dt>
				<dd id="metric-accuracy" class="bp-metric-value tabular-nums">১০০%</dd>
			</div>
			<div class="bp-metric" data-tone="sand">
				<dt class="text-[12px] font-medium text-mute">সময়</dt>
				<dd id="metric-time" class="bp-metric-value tabular-nums">০:০০</dd>
			</div>
			<div class="bp-metric" data-tone="paper">
				<dt class="text-[12px] font-medium text-mute">অগ্রগতি</dt>
				<dd id="metric-progress" class="bp-metric-value tabular-nums">
					০ / {bengaliDigits(firstLessonClusters.length)}
				</dd>
			</div>
		</dl>

		<div
			id="progress-track"
			class="mt-3 h-1.5 w-full overflow-hidden rounded-full"
			role="progressbar"
			aria-label="অনুশীলনের অগ্রগতি"
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuenow="0"
		>
			<div id="progress-bar" class="h-full w-0 rounded-full"></div>
		</div>

		<p class="mt-5 text-[12.5px] font-medium text-mute">যে লেখাটি টাইপ করবেন</p>
		<div
			id="target-text"
			class="bp-target mt-2 min-h-[96px] text-[20px] leading-[1.9] text-ink"
			lang="bn"
		>
			{
				firstLessonClusters.map((glyph) => (
					<span class="bp-glyph" data-state="pending">
						{glyph}
					</span>
				))
			}
		</div>

		<p id="practice-instructions" class="sr-only">
			উপরের লক্ষ্য লেখাটি পড়ে হুবহু টাইপ করুন। আপনার ইনস্টল করা বাংলা ইনপুট পদ্ধতি দিয়ে লিখুন। ভুল হলে
			সংশোধন করা যাবে, আর বাক্স সম্পূর্ণ খালি করলে টাইমার আবার শুরু হবে।
		</p>

		<label for="typing-input" class="mt-4 block text-[12.5px] font-medium text-mute">
			এখানে টাইপ করুন
		</label>
		<textarea
			id="typing-input"
			rows="3"
			lang="bn"
			spellcheck="false"
			autocomplete="off"
			autocapitalize="off"
			autocorrect="off"
			aria-describedby="practice-instructions"
			class="bp-input mt-1.5 w-full px-4 py-3 text-[17px] leading-[1.8] text-ink"
			placeholder="আপনার ইনস্টল করা অভ্র, বিজয় বা অন্য ইউনিকোড বাংলা ইনপুট পদ্ধতি দিয়ে টাইপ শুরু করুন…"
		></textarea>

		<!-- Grapheme-level live status: where the learner is and what went wrong -->
		<dl class="bp-feedback mt-3" aria-label="টাইপিংয়ের লাইভ অবস্থা">
			<div class="bp-feedback-item" data-tone="mint">
				<dt>অবস্থান</dt>
				<dd id="feedback-position" class="tabular-nums">০ / ০</dd>
			</div>
			<div class="bp-feedback-item" data-tone="mint">
				<dt>সঠিক অক্ষর</dt>
				<dd id="feedback-correct" class="tabular-nums">০</dd>
			</div>
			<div class="bp-feedback-item" data-tone="orange">
				<dt>ভুল অক্ষর</dt>
				<dd id="feedback-wrong" class="tabular-nums">০</dd>
			</div>
			<div class="bp-feedback-item" data-tone="sand">
				<dt id="feedback-missing-label">বাকি অক্ষর</dt>
				<dd id="feedback-missing" class="tabular-nums">০</dd>
			</div>
			<div class="bp-feedback-item" data-tone="orange">
				<dt>অতিরিক্ত অক্ষর</dt>
				<dd id="feedback-extra" class="tabular-nums">০</dd>
			</div>
		</dl>

		<p id="pause-note" hidden class="bp-pause-note mt-3" role="status" aria-live="polite">
			অনুশীলন থামানো আছে। আবার শুরু করতে "চালিয়ে যান" চাপুন।
		</p>

		<!-- Live error feedback for the first mismatch in the current attempt -->
		<p id="live-hint" hidden class="bp-live-hint mt-3" role="status" aria-live="polite"></p>

		<!-- Session error summary: mistaken graphemes and difficult words feeding targeted practice -->
		<div id="mistake-drill" hidden class="bp-inset bp-inset-orange mt-3">
			<p id="mistake-drill-text" class="text-[13.5px] leading-relaxed text-body"></p>
			<div id="mistake-glyph-block" hidden class="mt-2.5">
				<p class="text-[12px] font-medium text-mute">সবচেয়ে বেশি ভুল হওয়া অক্ষর</p>
				<div
					id="mistake-drill-glyphs"
					class="bp-chip-row mt-1.5"
					aria-label="এই সেশনে সবচেয়ে বেশি ভুল হওয়া অক্ষর"
					lang="bn"
				></div>
			</div>
			<div id="mistake-word-block" hidden class="mt-2.5">
				<p class="text-[12px] font-medium text-mute">কঠিন শব্দ</p>
				<div
					id="mistake-drill-words"
					class="bp-chip-row mt-1.5"
					aria-label="এই সেশনে যে শব্দগুলোতে ভুল হয়েছে"
					lang="bn"
				></div>
			</div>
			<button type="button" id="btn-mistake-drill" class="bp-action bp-action-secondary mt-2.5">
				এই ভুলগুলো নিয়ে ড্রিল করুন
			</button>
		</div>

		<div class="mt-4 flex flex-wrap items-center gap-2.5">
			<button type="button" id="btn-restart" class="bp-action bp-action-primary">আবার শুরু করুন</button>
			<button
				type="button"
				id="btn-pause"
				class="bp-action bp-action-secondary"
				aria-pressed="false"
				disabled
			>
				পজ করুন
			</button>
			<button
				type="button"
				id="btn-toggle-target"
				class="bp-action bp-action-secondary"
				aria-pressed="false"
			>
				লক্ষ্য লেখা লুকান
			</button>
			<button type="button" id="btn-next-lesson" class="bp-action bp-action-secondary">পরের পাঠ</button>
			<button type="button" id="btn-new-drill" hidden class="bp-action bp-action-secondary">নতুন ড্রিল</button>
		</div>

		<!-- Lesson / attempt result -->
		<div id="completion-card" hidden class="bp-result mt-4" data-state="success">
			<p id="completion-label" class="text-[12.5px] font-medium text-mute">পাঠের ফলাফল</p>
			<p id="completion-title" class="mt-1 text-[16px] leading-[24px] font-semibold text-ink"></p>
			<dl class="mt-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4">
				<div class="bp-result-metric">
					<dt class="text-[12px] font-medium text-mute">নির্ভুলতা</dt>
					<dd id="completion-accuracy" class="bp-result-value tabular-nums">—</dd>
				</div>
				<div class="bp-result-metric">
					<dt class="text-[12px] font-medium text-mute">গতি (অক্ষর/মিনিট)</dt>
					<dd id="completion-speed" class="bp-result-value tabular-nums">—</dd>
				</div>
				<div class="bp-result-metric">
					<dt class="text-[12px] font-medium text-mute">সময়</dt>
					<dd id="completion-time" class="bp-result-value tabular-nums">—</dd>
				</div>
				<div class="bp-result-metric">
					<dt class="text-[12px] font-medium text-mute">ভুল</dt>
					<dd id="completion-mistakes" class="bp-result-value tabular-nums">—</dd>
				</div>
			</dl>
			<p id="completion-next" class="mt-2 text-[12.5px] leading-relaxed text-mute"></p>
			<p id="result-details" hidden class="mt-1 text-[13px] leading-relaxed text-mute tabular-nums"></p>
		</div>

		<p id="practice-status" class="mt-3 min-h-[22px] text-[14px] leading-relaxed text-body" role="status" aria-live="polite"></p>
	</div>

	<!-- Lesson list: no locks, any lesson can be opened -->
	<div class="mt-7 border-t border-hairline pt-5">
		<div class="flex flex-wrap items-end justify-between gap-2">
			<div class="min-w-0">
				<h3 class="text-[15px] font-semibold text-ink">
					{bengaliDigits(BANGLA_LESSONS.length)}টি পাঠ
				</h3>
				<p class="mt-1 text-[13.5px] leading-relaxed text-body">
					স্তর অনুযায়ী সাজানো পাঠ—কোনো পাঠ লক করা নেই, যেকোনো পাঠ থেকে শুরু করতে পারেন।
				</p>
			</div>
			<button
				type="button"
				id="btn-toggle-all-lessons"
				class="bp-action bp-action-secondary"
				aria-pressed="false"
			>
				সব পাঠ দেখুন
			</button>
		</div>
		<div id="lesson-list" class="mt-4 grid gap-5">
			{
				lessonsByLevel.map((level, index) => (
					<div
						class="bp-level"
						data-tone={levelTones[level.id]}
						data-level-group={level.id}
						data-selected={index === 0 ? 'true' : 'false'}
					>
						<p class="bp-level-title text-[13px] font-semibold text-ink">
							<span class="bp-dot" aria-hidden="true" />
							<span>{level.label}</span>
							<span class="bp-level-count tabular-nums" data-level-progress={level.id}>
								০ / {bengaliDigits(level.lessons.length)}
							</span>
						</p>
						<p class="mt-1 text-[12.5px] leading-relaxed text-mute">{level.description}</p>
						<div class="mt-2.5 flex flex-col gap-2">
							{level.lessons.map((lesson) => (
								<button
									type="button"
									class="bp-choice bp-choice-row"
									data-lesson-id={lesson.id}
									data-tone={levelTones[level.id]}
									aria-pressed="false"
								>
									<span class="shrink-0 text-[12px] font-medium text-mute tabular-nums">
										{lesson.number}
									</span>
									<span class="min-w-0 flex-1 break-words">{lesson.title}</span>
									<span
										class="bp-lesson-check shrink-0"
										data-lesson-check
										aria-hidden="true"
										hidden
									>
										✓
									</span>
									<span class="shrink-0 text-[11.5px] text-mute">{lesson.difficulty}</span>
								</button>
							))}
						</div>
					</div>
				))
			}
		</div>
	</div>
	</div>
	<!-- /.bp-workspace -->

	<!-- Learning progress: everything below is stored only in this browser -->
	<section id="progress-panel" aria-labelledby="progress-heading" class="bp-progress">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0">
				<h3 id="progress-heading" class="text-[15px] font-semibold text-ink">আপনার অগ্রগতি</h3>
				<p class="mt-1 max-w-xl text-[13.5px] leading-relaxed text-body">
					সম্পন্ন পাঠ, মোট অনুশীলন, সময় ও নির্ভুলতা আপনার ব্রাউজারেই জমা থাকে। কোনো তথ্য সার্ভারে
					পাঠানো হয় না।
				</p>
			</div>
			<button type="button" id="btn-reset-progress" class="bp-action bp-action-secondary">
				অগ্রগতি রিসেট করুন
			</button>
		</div>

		<div
			id="reset-confirm"
			hidden
			class="mt-3 rounded-xl border border-[#B42318]/35 bg-[#B42318]/5 p-4 dark:border-[#FDA29B]/40 dark:bg-[#FDA29B]/10"
		>
			<p class="text-[13.5px] leading-relaxed text-body">
				এতে সম্পন্ন পাঠ, অনুশীলনের হিসাব, সেরা ফলাফল এবং জমে থাকা ভুল অক্ষরের তালিকা মুছে যাবে। এটি ফেরানো
				যাবে না। আপনি কি নিশ্চিত?
			</p>
			<div class="mt-3 flex flex-wrap gap-2">
				<button type="button" id="btn-reset-confirm" class="bp-action bp-action-danger">
					হ্যাঁ, সব মুছে ফেলুন
				</button>
				<button type="button" id="btn-reset-cancel" class="bp-action bp-action-secondary">বাতিল</button>
			</div>
		</div>

		<dl class="mt-4 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
			<div class="bp-metric" data-tone="mint">
				<dt class="text-[12px] font-medium text-mute">সম্পন্ন পাঠ</dt>
				<dd id="progress-lessons" class="bp-metric-value tabular-nums">০ / ১২</dd>
			</div>
			<div class="bp-metric" data-tone="orange">
				<dt class="text-[12px] font-medium text-mute">পাঠ সম্পূর্ণ</dt>
				<dd id="progress-percent" class="bp-metric-value tabular-nums">০%</dd>
			</div>
			<div class="bp-metric" data-tone="sand">
				<dt class="text-[12px] font-medium text-mute">মোট অনুশীলন</dt>
				<dd id="progress-sessions" class="bp-metric-value tabular-nums">০</dd>
			</div>
			<div class="bp-metric" data-tone="mint">
				<dt class="text-[12px] font-medium text-mute">গড় নির্ভুলতা</dt>
				<dd id="progress-accuracy" class="bp-metric-value tabular-nums">—</dd>
			</div>
			<div class="bp-metric" data-tone="sand">
				<dt class="text-[12px] font-medium text-mute">মোট সময় (মিনিট:সেকেন্ড)</dt>
				<dd id="progress-time" class="bp-metric-value tabular-nums">০:০০</dd>
			</div>
			<div class="bp-metric" data-tone="paper">
				<dt class="text-[12px] font-medium text-mute">মোট শব্দ</dt>
				<dd id="progress-words" class="bp-metric-value tabular-nums">০</dd>
			</div>
			<div class="bp-metric" data-tone="orange">
				<dt class="text-[12px] font-medium text-mute">টানা অনুশীলন</dt>
				<dd id="progress-streak" class="bp-metric-value tabular-nums">—</dd>
			</div>
			<div class="bp-metric" data-tone="paper">
				<dt class="text-[12px] font-medium text-mute">সেরা সেশন</dt>
				<dd id="progress-best" class="bp-metric-value tabular-nums">—</dd>
			</div>
		</dl>

		<div
			id="progress-lesson-track"
			class="mt-3 h-1.5 w-full overflow-hidden rounded-full"
			role="progressbar"
			aria-label="পাঠ সম্পন্নের অগ্রগতি"
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuenow="0"
		>
			<div id="progress-lesson-bar" class="h-full w-0 rounded-full"></div>
		</div>

		<!-- Recent activity: seven plain CSS bars, no chart library -->
		<div class="bp-dashboard-block mt-4">
			<div class="flex flex-wrap items-baseline justify-between gap-2">
				<p class="text-[12.5px] font-medium text-mute">গত ৭ দিনের অনুশীলন (মিনিট)</p>
				<p id="week-summary" class="text-[12.5px] text-mute tabular-nums">—</p>
			</div>
			<ol id="week-chart" class="bp-week mt-2.5" aria-label="গত সাত দিনের অনুশীলন"></ol>
			<p id="week-empty" class="mt-2 text-[13px] leading-relaxed text-mute">
				প্রথম সেশন শেষ করলেই এখানে প্রতিদিনের হিসাব দেখা যাবে।
			</p>
		</div>

		<div class="bp-dashboard-block mt-4">
			<p class="text-[12.5px] font-medium text-mute">সবচেয়ে বেশি ভুল হওয়া অক্ষর</p>
			<div id="weak-glyphs" class="mt-2 flex flex-wrap gap-2"></div>
			<p id="weak-empty" class="mt-1 text-[13px] leading-relaxed text-mute">
				এখনো ভুলের তথ্য জমা হয়নি। ভুল টাইপ করলে অক্ষরগুলো এখানে দেখা যাবে।
			</p>
		</div>

		<div class="bp-dashboard-block mt-4">
			<div class="flex flex-wrap items-baseline justify-between gap-2">
				<p class="text-[12.5px] font-medium text-mute">ব্যাজ ও মাইলফলক</p>
				<p id="milestone-summary" class="text-[12.5px] text-mute tabular-nums">০ / ৮ ব্যাজ</p>
			</div>
			<ul id="milestone-list" class="bp-milestone-list" aria-label="অর্জিত ও বাকি ব্যাজ"></ul>
			<p id="milestone-empty" class="mt-2 text-[13px] leading-relaxed text-mute">
				প্রথম পাঠ শেষ করলেই প্রথম ব্যাজ পাবেন। ব্যাজগুলো আপনার সংরক্ষিত অগ্রগতি থেকেই তৈরি হয়।
			</p>
		</div>

		<!-- Dashboard actions connect the numbers back to practice -->
		<div class="bp-dashboard-block mt-4 flex flex-wrap gap-2">
			<button type="button" id="btn-progress-continue" class="bp-action bp-action-primary">
				পাঠ ০১ শুরু করুন
			</button>
			<button type="button" id="btn-progress-weak" class="bp-action bp-action-secondary">
				বর্ণ অনুশীলন শুরু করুন
			</button>
		</div>

		<p id="progress-status" class="mt-3 text-[13px] leading-relaxed text-mute" role="status" aria-live="polite"></p>
	</section>
</div>

<style is:global>
	/*
		Namespaced inside .bangla-practice so nothing leaks into other pages.
		Colours come from the page palette (--bp-*) defined on .bangla-page in the view.
	*/
	.bangla-practice {
		font-family:
			'Noto Sans Bengali', 'Hind Siliguri', 'Nirmala UI', 'Vrinda', 'Geist', 'Inter', -apple-system,
			sans-serif;
	}

	.bangla-practice [hidden] {
		display: none !important;
	}

	/* Warm-sand workspace surface */
	.bangla-practice .bp-workspace {
		padding: 1.15rem;
		border: 1px solid var(--bp-sand-line, #e6d6c1);
		border-radius: 20px;
		background: var(--bp-sand-soft, #f7efe3);
	}

	@media (min-width: 640px) {
		.bangla-practice .bp-workspace {
			padding: 1.6rem;
		}
	}

	/* Tone families: every chip, row and tile picks mint, sand, orange or paper */
	.bangla-practice [data-tone='mint'] {
		--tone: var(--bp-mint, #afe3d0);
		--tone-ink: var(--bp-mint-ink, #0f2e26);
		--tone-soft: var(--bp-mint-soft, #e4f4ec);
		--tone-line: var(--bp-mint-line, #bfe6d5);
	}

	.bangla-practice [data-tone='sand'] {
		--tone: var(--bp-sand, #ecdcc5);
		--tone-ink: var(--bp-sand-ink, #4a3624);
		--tone-soft: var(--bp-sand-soft, #f7efe3);
		--tone-line: var(--bp-sand-line, #e6d6c1);
	}

	.bangla-practice [data-tone='orange'] {
		--tone: var(--bp-orange, #f7bd90);
		--tone-ink: var(--bp-orange-ink, #7a3a12);
		--tone-soft: var(--bp-orange-soft, #fdece0);
		--tone-line: var(--bp-orange-line, #f4cba9);
	}

	.bangla-practice [data-tone='paper'] {
		--tone: var(--bp-line, #e2d9cb);
		--tone-ink: var(--c-ink);
		--tone-soft: var(--bp-paper, #fdfaf4);
		--tone-line: var(--bp-line, #e2d9cb);
	}

	/* Mode pills and lesson rows */
	.bangla-practice .bp-choice {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		padding: 0.5rem 0.9rem;
		border: 1px solid var(--tone-line);
		border-radius: 999px;
		background: var(--tone-soft);
		color: var(--c-body);
		font-size: 13.5px;
		font-weight: 500;
		line-height: 1.4;
		text-align: left;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease,
			color 0.15s ease;
	}

	.bangla-practice .bp-choice:hover {
		border-color: var(--tone);
		background: var(--bp-paper, #fdfaf4);
		color: var(--c-ink);
	}

	.bangla-practice .bp-choice:focus-visible {
		outline: 2px solid var(--c-ink);
		outline-offset: 2px;
	}

	.bangla-practice .bp-choice.is-active {
		border-color: var(--tone);
		background: var(--tone);
		color: var(--tone-ink);
		font-weight: 600;
	}

	.bangla-practice .bp-dot {
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: var(--tone);
		flex: none;
	}

	.bangla-practice .bp-choice.is-active .bp-dot {
		background: var(--tone-ink);
	}

	.bangla-practice .bp-choice-row {
		width: 100%;
		border-radius: 12px;
		padding: 0.45rem 0.7rem;
		font-size: 13.5px;
	}

	.bangla-practice .bp-choice-row::before {
		content: '';
		flex: none;
		align-self: stretch;
		width: 3px;
		border-radius: 999px;
		background: var(--tone);
		opacity: 0.55;
		transition: opacity 0.15s ease;
	}

	.bangla-practice .bp-choice-row:hover::before,
	.bangla-practice .bp-choice-row.is-active::before {
		opacity: 1;
	}

	.bangla-practice .bp-level-title {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.2rem 0.7rem 0.2rem 0.5rem;
		border-radius: 999px;
		background: var(--tone-soft);
		color: var(--tone-ink);
	}

	/* Contextual inset panels (custom text, revision empty state) */
	.bangla-practice .bp-inset {
		padding: 0.95rem 1rem;
		border-radius: 14px;
		background: var(--tone-soft);
		box-shadow: inset 3px 0 0 0 var(--tone);
	}

	.bangla-practice .bp-inset-sand {
		--tone: var(--bp-sand, #ecdcc5);
		--tone-ink: var(--bp-sand-ink, #4a3624);
		--tone-soft: var(--bp-sand-soft, #f7efe3);
		--tone-line: var(--bp-sand-line, #e6d6c1);
	}

	.bangla-practice .bp-inset-orange {
		--tone: var(--bp-orange, #f7bd90);
		--tone-ink: var(--bp-orange-ink, #7a3a12);
		--tone-soft: var(--bp-orange-soft, #fdece0);
		--tone-line: var(--bp-orange-line, #f4cba9);
	}

	.bangla-practice .bp-inset-mint {
		--tone: var(--bp-mint, #afe3d0);
		--tone-ink: var(--bp-mint-ink, #0f2e26);
		--tone-soft: var(--bp-mint-soft, #e4f4ec);
		--tone-line: var(--bp-mint-line, #bfe6d5);
	}

	/* Counters inside the keyboard / level choices */
	.bangla-practice .bp-choice-count,
	.bangla-practice .bp-level-count {
		font-size: 11.5px;
		font-weight: 500;
		opacity: 0.85;
		white-space: nowrap;
	}

	.bangla-practice .bp-level-count {
		margin-left: 0.15rem;
		color: var(--tone-ink);
	}

	/* Selected level stays visible while every level is shown */
	.bangla-practice .bp-level[data-selected='true'] .bp-level-title {
		outline: 2px solid var(--tone);
		outline-offset: 3px;
	}

	/* Auto-fit so a filtered single level stretches while all three sit side by side */
	.bangla-practice #lesson-list {
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
	}

	.bangla-practice .bp-lesson-check {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 18px;
		height: 18px;
		border-radius: 999px;
		background: var(--tone);
		color: var(--tone-ink);
		font-size: 11px;
		font-weight: 700;
	}

	/* Layout guidance sits on a hairline divider, not in another card */
	.bangla-practice .bp-layout-guide {
		padding-top: 0.9rem;
		border-top: 1px dashed var(--bp-sand-line, #e6d6c1);
	}

	.bangla-practice .bp-key-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		max-width: 100%;
		min-height: 32px;
		padding: 0.2rem 0.65rem;
		border: 1px solid var(--bp-line, #e2d9cb);
		border-radius: 999px;
		background: var(--bp-paper, #fdfaf4);
		font-size: 13px;
		line-height: 1.5;
	}

	.bangla-practice .bp-key-chip-input {
		color: var(--c-body);
		font-weight: 500;
		overflow-wrap: anywhere;
	}

	.bangla-practice .bp-key-chip-arrow {
		color: var(--c-faint);
	}

	.bangla-practice .bp-key-chip-output {
		color: var(--c-ink);
		font-weight: 500;
		overflow-wrap: anywhere;
	}

	/* Live mismatch hint */
	.bangla-practice .bp-live-hint {
		padding: 0.5rem 0.8rem;
