				arrow.className = 'bp-key-chip-arrow';
				arrow.setAttribute('aria-hidden', 'true');
				arrow.textContent = '→';

				const output = document.createElement('span');
				output.className = 'bp-key-chip-output';
				output.lang = 'bn';
				output.textContent = example.output;

				item.append(source, arrow, output);
				layoutGuideExamplesEl.append(item);
