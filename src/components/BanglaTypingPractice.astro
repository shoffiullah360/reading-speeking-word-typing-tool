	interface LessonRecord {
		attempts: number;
		completed: boolean;
		bestAccuracy: number;
		bestCpm: number;
		lastPracticedAt: string;
	}

	/** One day of finished sessions, keyed by a local `YYYY-MM-DD` date. */
	interface DailyRecord {
		sessions: number;
		practiceMs: number;
		correctChars: number;
		accuracySum: number;
	}

	interface PracticeProgress {
		sessions: number;
		totalTimeMs: number;
		totalWords: number;
		totalCorrectChars: number;
		accuracySum: number;
		lessons: Record<string, LessonRecord>;
		bestSession: { accuracy: number; cpm: number; at: string } | null;
		streakCurrent: number;
		streakBest: number;
		streakLastDate: string;
		days: Record<string, DailyRecord>;
	}

	const MAX_DAILY_RECORDS = 60;

	function emptyProgress(): PracticeProgress {
		return {
			sessions: 0,
			totalTimeMs: 0,
			totalWords: 0,
			totalCorrectChars: 0,
			accuracySum: 0,
			lessons: {},
			bestSession: null,
			streakCurrent: 0,
			streakBest: 0,
			streakLastDate: '',
			days: {},
		};
	}

	function safeNumber(value: unknown, min = 0, max = 1e12): number {
		if (typeof value !== 'number' || !Number.isFinite(value)) return min;
		return Math.min(max, Math.max(min, value));
	}

	/** Loads saved progress, discarding anything malformed so corrupt data can never break the tool. */
	function readProgress(): PracticeProgress {
		const empty = emptyProgress();
		try {
			const raw = window.localStorage.getItem(PROGRESS_STORE_KEY);
			if (!raw) return empty;
			const parsed: unknown = JSON.parse(raw);
			if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return empty;
			const data = parsed as Record<string, unknown>;
			const progress = emptyProgress();

			progress.sessions = Math.round(safeNumber(data.sessions));
			progress.totalTimeMs = Math.round(safeNumber(data.totalTimeMs));
			progress.totalWords = Math.round(safeNumber(data.totalWords));
			progress.totalCorrectChars = Math.round(safeNumber(data.totalCorrectChars));
			progress.accuracySum = safeNumber(data.accuracySum);
			progress.streakCurrent = Math.round(safeNumber(data.streakCurrent));
			progress.streakBest = Math.round(safeNumber(data.streakBest));
			progress.streakLastDate =
				typeof data.streakLastDate === 'string' ? data.streakLastDate.slice(0, 10) : '';

			const lessons = data.lessons;
			if (lessons && typeof lessons === 'object' && !Array.isArray(lessons)) {
				for (const [lessonId, entry] of Object.entries(lessons as Record<string, unknown>)) {
					if (!entry || typeof entry !== 'object' || Array.isArray(entry)) continue;
					const record = entry as Record<string, unknown>;
					progress.lessons[lessonId] = {
						attempts: Math.round(safeNumber(record.attempts)),
						completed: record.completed === true,
						bestAccuracy: safeNumber(record.bestAccuracy, 0, 100),
						bestCpm: safeNumber(record.bestCpm),
						lastPracticedAt: typeof record.lastPracticedAt === 'string' ? record.lastPracticedAt : '',
					};
				}
			}

			const best = data.bestSession;
			if (best && typeof best === 'object' && !Array.isArray(best)) {
				const record = best as Record<string, unknown>;
				progress.bestSession = {
					accuracy: safeNumber(record.accuracy, 0, 100),
					cpm: safeNumber(record.cpm),
					at: typeof record.at === 'string' ? record.at : '',
				};
			}

			const days = data.days;
			if (days && typeof days === 'object' && !Array.isArray(days)) {
				for (const [key, entry] of Object.entries(days as Record<string, unknown>)) {
					if (!/^\d{4}-\d{2}-\d{2}$/.test(key)) continue;
					if (!entry || typeof entry !== 'object' || Array.isArray(entry)) continue;
					const record = entry as Record<string, unknown>;
					progress.days[key] = {
						sessions: Math.round(safeNumber(record.sessions)),
						practiceMs: Math.round(safeNumber(record.practiceMs)),
						correctChars: Math.round(safeNumber(record.correctChars)),
						accuracySum: safeNumber(record.accuracySum),
					};
				}
			}

			return progress;
		} catch {
			return empty;
		}
	}

	function saveProgress(progress: PracticeProgress) {
		try {
			window.localStorage.setItem(PROGRESS_STORE_KEY, JSON.stringify(progress));
		} catch {
			// Storage may be blocked; practice still works without saved progress.
		}
	}

	function localDateKey(date = new Date()): string {
		const year = date.getFullYear();
		const month = String(date.getMonth() + 1).padStart(2, '0');
		const day = String(date.getDate()).padStart(2, '0');
		return `${year}-${month}-${day}`;
	}

	/** Reads a persisted single-choice preference, ignoring anything outside `allowed`. */
	function readStoredChoice<T extends string>(key: string, allowed: readonly T[], fallback: T): T {
		try {
			const raw = window.localStorage.getItem(key);
			return raw && (allowed as readonly string[]).includes(raw) ? (raw as T) : fallback;
		} catch {
			return fallback;
		}
	}

	function storeChoice(key: string, value: string) {
		try {
			window.localStorage.setItem(key, value);
		} catch {
			// Preferences are optional; the in-memory choice keeps working without storage.
		}
	}

	/** Whole-day gap between two `YYYY-MM-DD` keys; Infinity when the previous key is missing. */
	function dayGap(from: string, to: string): number {
		if (!/^\d{4}-\d{2}-\d{2}$/.test(from)) return Number.POSITIVE_INFINITY;
		const parse = (value: string) => {
			const [year, month, day] = value.split('-').map(Number);
			return Date.UTC(year, (month || 1) - 1, day || 1);
		};
		return Math.round((parse(to) - parse(from)) / 86400000);
	}

	const BN_WEEKDAYS = [
		{ short: 'রবি', long: 'রবিবার' },
		{ short: 'সোম', long: 'সোমবার' },
		{ short: 'মঙ্গ', long: 'মঙ্গলবার' },
		{ short: 'বুধ', long: 'বুধবার' },
		{ short: 'বৃহঃ', long: 'বৃহস্পতিবার' },
		{ short: 'শুক্র', long: 'শুক্রবার' },
		{ short: 'শনি', long: 'শনিবার' },
	];

	interface RecentDay {
		key: string;
		short: string;
		long: string;
		minutes: number;
		sessions: number;
		isToday: boolean;
	}

	/** Oldest→newest slice of daily activity, so the bars read left to right like a calendar. */
	function recentDays(progress: PracticeProgress, count = 7): RecentDay[] {
		const today = new Date();
		const days: RecentDay[] = [];
		for (let offset = count - 1; offset >= 0; offset -= 1) {
			const date = new Date(today.getFullYear(), today.getMonth(), today.getDate() - offset);
			const key = localDateKey(date);
			const record = progress.days[key];
			const weekday = BN_WEEKDAYS[date.getDay()] ?? BN_WEEKDAYS[0];
			days.push({
				key,
				short: weekday.short,
				long: weekday.long,
				// Any finished session counts as at least a minute, so a short drill still shows a bar.
				minutes:
					record && record.sessions > 0
						? Math.max(1, Math.round(record.practiceMs / 60000))
						: 0,
				sessions: record?.sessions ?? 0,
				isToday: offset === 0,
			});
		}
		return days;
	}

	function samplePool(pool: readonly string[], size: number): string[] {
		const copy = [...pool];
		for (let i = copy.length - 1; i > 0; i -= 1) {
			const j = Math.floor(Math.random() * (i + 1));
			[copy[i], copy[j]] = [copy[j], copy[i]];
		}
		return copy.slice(0, Math.min(size, copy.length));
	}

	function lessonExercise(lesson: BanglaTypingLesson): Exercise {
		const level = LESSON_LEVELS.find((entry) => entry.id === lesson.level);
		return {
			key: lesson.id,
			kind: 'lesson',
			title: lesson.title,
			source: `পাঠ ${lesson.number} · ${level?.label ?? ''}`.trim(),
			difficulty: lesson.difficulty,
			minAccuracy: lesson.minAccuracy,
			summary: lesson.summary,
			criteria: lesson.criteria,
			target: lesson.target,
		};
	}

	function generateDrill(mode: BanglaPracticeMode): string {
		if (!mode.poolKey) return '';
		const pool = PRACTICE_POOLS[mode.poolKey];
		const size = mode.sampleSize ?? Math.min(8, pool.length);
		return samplePool(pool, size).join(' ');
	}

	/** Builds challenge text from the existing pools, padding timed runs with short sentences. */
	function buildChallengeTarget(challenge: BanglaChallenge): string {
		const items: string[] = [];
		for (const poolKey of challenge.poolKeys) {
			items.push(...samplePool(PRACTICE_POOLS[poolKey], challenge.sampleSize));
		}
		let text = samplePool(items, items.length).join(' ');

		const minClusters = challenge.minClusters ?? 0;
		const fillers = PRACTICE_POOLS.sentences;
		let added = 0;
		while (splitGraphemes(text).length < minClusters && added < 40) {
			text += ` ${fillers[added % fillers.length]}`;
			added += 1;
		}
		return text;
	}

	/** Standard WPM treats five typed characters as one word. */
	function wordsPerMinute(correct: number, ms: number): number | null {
		if (ms < 1000) return null;
		return Math.round(correct / 5 / (ms / 60000));
	}

	function challengeExercise(challenge: BanglaChallenge): Exercise {
		return {
			key: `${challenge.id}-${Date.now()}`,
			kind: 'drill',
			challengeId: challenge.id,
			title: challenge.label,
			source: 'প্র্যাকটিস চ্যালেঞ্জ',
			difficulty: challenge.badge,
			minAccuracy: challenge.minAccuracy,
			summary: challenge.summary,
			criteria: challenge.criteria,
			target: buildChallengeTarget(challenge),
		};
	}

	function completedLessonCount(progress: PracticeProgress): number {
		return BANGLA_LESSONS.filter((lesson) => progress.lessons[lesson.id]?.completed).length;
	}

	function milestoneValue(milestone: BanglaMilestone, progress: PracticeProgress): number {
		switch (milestone.metric) {
			case 'lessons':
				return completedLessonCount(progress);
			case 'streak':
				return progress.streakBest;
			case 'accuracy':
				return progress.bestSession?.accuracy ?? 0;
			case 'sessions':
				return progress.sessions;
			default:
				return 0;
		}
	}

