---
import { getToolById } from '../config/site';

const readingTool = getToolById('reading-time-counter');
const wordCounterTool = getToolById('word-counter');
const speechTool = getToolById('speech-time-calculator');
---

<section
	id="words-to-pages-calculator"
	aria-label="Words to Pages and Pages to Words Converter Workspace"
	class="mx-auto max-w-[1200px] px-4 pt-4 pb-12 sm:px-6"
>
	<!-- Live Summary Bar -->
	<div class="whisper-shadow mb-6 grid grid-cols-1 divide-y divide-hairline rounded-md border border-hairline bg-canvas-elevated sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x">
		<!-- Stat 1: Estimated pages -->
		<article class="flex flex-col justify-between p-5">
			<div class="flex items-center justify-between gap-2">
				<span id="summary-primary-label" class="text-[13px] font-medium text-body">
					Estimated pages
				</span>
				<span
					id="badge-wpp-rate"
					class="text-[12px] text-mute tabular-nums"
				>
					250 words/page
				</span>
			</div>
			<div class="my-2.5 flex items-baseline gap-2">
				<output
					id="metric-pages-total"
					aria-live="polite"
					class="font-sans text-[30px] leading-[36px] font-semibold tracking-[-1px] text-ink tabular-nums"
				>
					6.0
				</output>
				<span id="metric-pages-unit" class="text-[14px] text-body">pages</span>
			</div>
			<p id="metric-pages-sub" class="text-[12px] text-mute">
				Double-spaced · 12pt Times / Arial
			</p>
		</article>

		<!-- Stat 2: Total words -->
		<article class="flex flex-col justify-between p-5 sm:border-l sm:border-hairline lg:border-l-0">
			<div class="flex items-center justify-between gap-2">
				<span class="text-[13px] font-medium text-body">
					Total words
				</span>
				<span
					id="badge-conversion-mode"
					class="text-[12px] text-mute"
				>
					Words to pages
				</span>
			</div>
			<div class="my-2.5 flex items-baseline gap-2">
				<output
					id="metric-words-total"
					aria-live="polite"
					class="font-sans text-[30px] leading-[36px] font-semibold tracking-[-1px] text-ink tabular-nums"
				>
					1,500
				</output>
				<span class="text-[14px] text-body">words</span>
			</div>
			<div class="flex items-center gap-4 text-[12px] text-mute">
				<span>~<strong id="metric-chars-est" class="font-medium text-ink tabular-nums">9,000</strong> characters</span>
				<span>~<strong id="metric-paragraphs-est" class="font-medium text-ink tabular-nums">12</strong> paragraphs</span>
			</div>
		</article>

		<!-- Stat 3: Silent reading time -->
		<article class="flex flex-col justify-between p-5 sm:border-t sm:border-hairline lg:border-t-0">
			<div class="flex items-center justify-between gap-2">
				<span class="text-[13px] font-medium text-body">
					Silent reading time
				</span>
				<span class="text-[12px] text-mute tabular-nums">
					238 WPM
				</span>
			</div>
			<div class="my-2.5">
				<output
					id="metric-silent-read-time"
					aria-live="polite"
					class="block font-sans text-[30px] leading-[36px] font-semibold tracking-[-1px] text-ink tabular-nums"
				>
					6 min 18 sec
				</output>
			</div>
			<p class="text-[12px] text-mute">
				Average adult reading pace
			</p>
		</article>

		<!-- Stat 4: Speaking / read-aloud time -->
		<article class="flex flex-col justify-between p-5 sm:border-t sm:border-l sm:border-hairline lg:border-t-0 lg:border-l-0">
			<div class="flex items-center justify-between gap-2">
				<span class="text-[13px] font-medium text-body">
					Speaking time
				</span>
				<span class="text-[12px] text-mute tabular-nums">
					130 WPM
				</span>
			</div>
			<div class="my-2.5">
				<output
					id="metric-speaking-read-time"
					aria-live="polite"
					class="block font-sans text-[30px] leading-[36px] font-semibold tracking-[-1px] text-ink tabular-nums"
				>
					11 min 32 sec
				</output>
			</div>
			<p class="text-[12px] text-mute">
				Conversational presentation pace
			</p>
		</article>
	</div>

	<!-- Main Dual-Column Workspace -->
	<div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
		<!-- Left Column: Two-Way Conversion Input & Comparison -->
		<div class="whisper-shadow flex flex-col justify-between rounded-md border border-hairline bg-canvas-elevated lg:col-span-7">
			<div>
				<!-- Tab Bar Header: Words to Pages vs Pages to Words -->
				<div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline px-5 py-3">
					<div
						role="tablist"
						aria-label="Conversion direction"
						class="inline-flex items-center gap-1"
					>
						<button
							type="button"
							role="tab"
							id="tab-btn-w2p"
							aria-selected="true"
							aria-controls="tab-panel-w2p"
							data-mode="w2p"
							class="wtp-mode-btn cursor-pointer rounded-pill-category bg-primary px-3.5 py-1.5 text-[13px] font-medium text-on-primary transition-all"
						>
							Words to pages
						</button>
						<button
							type="button"
							role="tab"
							id="tab-btn-p2w"
							aria-selected="false"
							aria-controls="tab-panel-p2w"
							data-mode="p2w"
							class="wtp-mode-btn cursor-pointer rounded-pill-category bg-transparent px-3.5 py-1.5 text-[13px] font-medium text-body transition-all hover:bg-hairline-soft hover:text-ink"
						>
							Pages to words
						</button>
					</div>

					<button
						type="button"
						id="btn-reset-defaults"
						class="cursor-pointer rounded-sm px-2.5 py-1 text-[13px] font-medium text-mute transition-colors hover:bg-hairline-soft hover:text-ink"
					>
						Reset defaults
					</button>
				</div>

				<!-- Tab Panel 1: Words to Pages -->
				<div
					id="tab-panel-w2p"
					role="tabpanel"
					aria-labelledby="tab-btn-w2p"
					class="p-6"
				>
					<label for="wtp-words-input" class="block text-[15px] font-medium text-ink">
						Enter word count
					</label>
					<p class="mt-1 mb-4 text-[14px] text-body">
						Type or choose a word count to see how many pages your essay, manuscript, or book chapter will be.
					</p>

					<div class="relative flex items-center">
						<input
							id="wtp-words-input"
							type="number"
							min="0"
							max="10000000"
							step="50"
							value="1500"
							class="w-full rounded-sm border border-hairline bg-canvas px-4 py-3 text-[24px] font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
						/>
						<span class="pointer-events-none absolute right-4 text-[14px] text-mute">
							words
						</span>
					</div>

					<!-- Common Document Word Presets -->
					<div class="mt-5">
						<span class="mb-2.5 block text-[13px] font-medium text-mute">
							Common document presets
						</span>
						<div class="flex flex-wrap gap-2">
							{
								[
									{ words: 500, label: '500 words' },
									{ words: 1000, label: '1,000 words' },
									{ words: 1500, label: '1,500 words' },
									{ words: 2500, label: '2,500 words' },
									{ words: 5000, label: '5,000 words' },
									{ words: 10000, label: '10,000 words' },
								].map((preset) => (
									<button
										type="button"
										data-words-preset={preset.words}
										class={`wtp-word-preset cursor-pointer rounded-sm border px-3 py-1.5 text-[13px] font-medium tabular-nums transition-colors ${
											preset.words === 1500
												? 'border-primary bg-primary text-on-primary'
												: 'border-hairline bg-canvas text-body hover:border-ink hover:text-ink'
										}`}
									>
										{preset.label}
									</button>
								))
							}
						</div>
					</div>
				</div>

				<!-- Tab Panel 2: Pages to Words -->
				<div
					id="tab-panel-p2w"
					role="tabpanel"
					aria-labelledby="tab-btn-p2w"
					class="hidden p-6"
				>
					<label for="wtp-pages-input" class="block text-[15px] font-medium text-ink">
						Enter number of pages
					</label>
					<p class="mt-1 mb-4 text-[14px] text-body">
						Enter your target page count to see how many words you need to write for your chosen spacing and font.
					</p>

					<div class="relative flex items-center">
						<input
							id="wtp-pages-input"
							type="number"
							min="0.25"
							max="50000"
							step="0.5"
							value="6"
							class="w-full rounded-sm border border-hairline bg-canvas px-4 py-3 text-[24px] font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
						/>
						<span class="pointer-events-none absolute right-4 text-[14px] text-mute">
							pages
						</span>
					</div>

					<!-- Common Page Count Presets -->
					<div class="mt-5">
						<span class="mb-2.5 block text-[13px] font-medium text-mute">
							Common page targets
						</span>
						<div class="flex flex-wrap gap-2">
							{
								[1, 2, 3, 5, 6, 10, 20, 50].map((pg) => (
									<button
										type="button"
										data-pages-preset={pg}
										class={`wtp-page-preset cursor-pointer rounded-sm border px-3 py-1.5 text-[13px] font-medium tabular-nums transition-colors ${
											pg === 6
												? 'border-primary bg-primary text-on-primary'
												: 'border-hairline bg-canvas text-body hover:border-ink hover:text-ink'
										}`}
									>
										{pg} {pg === 1 ? 'page' : 'pages'}
									</button>
								))
							}
						</div>
					</div>
				</div>
			</div>

			<!-- Instant Spacing & Format Comparison Breakdown -->
			<div class="border-t border-hairline px-6 py-5">
				<div class="mb-3 flex items-center justify-between gap-2">
					<h2 class="text-[14px] font-semibold text-ink">
						Page count across standard formats
					</h2>
					<span id="comparison-words-badge" class="text-[12px] text-mute tabular-nums">
						For 1,500 words
					</span>
				</div>

				<div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
					<div class="flex items-center justify-between rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-[13px]">
						<span class="text-body">Single-spaced <span class="text-mute">(~500 w/p)</span></span>
						<strong id="compare-single-pages" class="font-semibold text-ink tabular-nums">3.0 pages</strong>
					</div>
					<div class="flex items-center justify-between rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-[13px]">
						<span class="text-body">1.5-spaced <span class="text-mute">(~330 w/p)</span></span>
						<strong id="compare-onehalf-pages" class="font-semibold text-ink tabular-nums">4.5 pages</strong>
					</div>
					<div class="flex items-center justify-between rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-[13px]">
						<span class="text-body">Double-spaced <span class="text-mute">(~250 w/p)</span></span>
						<strong id="compare-double-pages" class="font-semibold text-ink tabular-nums">6.0 pages</strong>
					</div>
					<div class="flex items-center justify-between rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-[13px]">
						<span class="text-body">Paperback book <span class="text-mute">(~275 w/p)</span></span>
						<strong id="compare-book-pages" class="font-semibold text-ink tabular-nums">5.5 pages</strong>
					</div>
				</div>
			</div>
		</div>

		<!-- Right Column: Spacing, Font & Custom Words-Per-Page Controls -->
		<div class="whisper-shadow flex flex-col justify-between divide-y divide-hairline rounded-md border border-hairline bg-canvas-elevated lg:col-span-5">
			<!-- Section A: Line Spacing Controls -->
			<div class="p-5">
				<div class="flex items-baseline justify-between gap-2">
					<h2 class="text-[16px] font-semibold tracking-[-0.3px] text-ink">
						Line spacing
					</h2>
					<span id="active-spacing-badge" class="text-[12px] text-mute tabular-nums">
						Double-spaced
					</span>
				</div>
				<p class="mt-1 mb-3.5 text-[13px] text-body">
					Choose your document line spacing or enter a custom words-per-page rate.
				</p>

				<div class="grid grid-cols-1 gap-2 sm:grid-cols-2" role="group" aria-label="Line spacing options">
					<button
						type="button"
						data-spacing-mode="single"
						data-base-wpp="500"
						class="wtp-spacing-btn flex cursor-pointer flex-col items-start rounded-sm border border-hairline bg-canvas p-3 text-left text-ink transition-all hover:border-ink"
					>
						<span class="text-[13px] font-semibold">Single-spaced</span>
						<span class="text-[12px] text-mute tabular-nums">~500 words/page</span>
					</button>

					<button
						type="button"
						data-spacing-mode="onehalf"
						data-base-wpp="330"
						class="wtp-spacing-btn flex cursor-pointer flex-col items-start rounded-sm border border-hairline bg-canvas p-3 text-left text-ink transition-all hover:border-ink"
					>
						<span class="text-[13px] font-semibold">1.5-spaced</span>
						<span class="text-[12px] text-mute tabular-nums">~330 words/page</span>
					</button>

					<button
						type="button"
						data-spacing-mode="double"
						data-base-wpp="250"
						class="wtp-spacing-btn flex cursor-pointer flex-col items-start rounded-sm border border-primary bg-primary p-3 text-left text-on-primary transition-all"
					>
						<span class="text-[13px] font-semibold">Double-spaced</span>
						<span class="text-[12px] opacity-80 tabular-nums">~250 words/page</span>
					</button>

					<button
						type="button"
						data-spacing-mode="custom"
						data-base-wpp="300"
						class="wtp-spacing-btn flex cursor-pointer flex-col items-start rounded-sm border border-hairline bg-canvas p-3 text-left text-ink transition-all hover:border-ink"
					>
						<span class="text-[13px] font-semibold">Custom rate</span>
						<span class="text-[12px] text-mute tabular-nums">Set words/page</span>
					</button>
				</div>

				<!-- Custom Words-Per-Page Input (always accessible, highlighted in custom mode) -->
				<div class="mt-4 flex items-center justify-between gap-3 rounded-sm border border-hairline bg-canvas px-3.5 py-2.5">
					<label for="custom-wpp-input" class="text-[13px] font-medium text-body">
						Words per page
					</label>
					<div class="flex items-center gap-2">
						<input
							id="custom-wpp-input"
							type="number"
							min="50"
							max="2000"
							step="5"
							value="250"
							class="w-24 rounded-sm border border-hairline bg-canvas-elevated px-2.5 py-1 text-right text-[14px] font-semibold text-ink tabular-nums focus:border-ink focus:outline-none"
						/>
						<span class="text-[12px] text-mute">w/p</span>
					</div>
				</div>
			</div>

			<!-- Section B: Font & Size Presets -->
			<div class="p-5">
				<div class="flex items-baseline justify-between gap-2">
					<h2 class="text-[16px] font-semibold tracking-[-0.3px] text-ink">
						Font &amp; size preset
					</h2>
					<span id="active-font-badge" class="text-[12px] text-mute">
						12pt Times / Arial
					</span>
				</div>
				<p class="mt-1 mb-3.5 text-[13px] text-body">
					Adjust page density for academic essays, office documents, or trade paperbacks.
				</p>

				<div class="space-y-2" role="group" aria-label="Font and size presets">
					<button
						type="button"
						data-font-preset="standard"
						data-font-label="12pt Times / Arial"
						data-font-multiplier="1"
						class="wtp-font-btn flex w-full cursor-pointer items-center justify-between rounded-sm border border-primary bg-primary px-3.5 py-2.5 text-left text-on-primary transition-all"
					>
						<div>
							<span class="block text-[13px] font-semibold">12pt Times New Roman / Arial</span>
							<span class="text-[12px] opacity-80">Standard academic &amp; MLA / APA manuscript</span>
						</div>
						<span class="text-[12px] font-medium opacity-90 tabular-nums">100%</span>
					</button>

					<button
						type="button"
						data-font-preset="calibri"
						data-font-label="11pt Calibri"
						data-font-multiplier="1.1"
						class="wtp-font-btn flex w-full cursor-pointer items-center justify-between rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-left text-ink transition-all hover:border-ink"
					>
						<div>
							<span class="block text-[13px] font-semibold">11pt Calibri</span>
							<span class="text-[12px] text-mute">Default Word / Google Docs (~10% more words/page)</span>
						</div>
						<span class="text-[12px] text-mute tabular-nums">~275 / 550 w/p</span>
					</button>

					<button
						type="button"
						data-font-preset="book"
						data-font-label="Paperback Book"
						data-font-multiplier="book"
						class="wtp-font-btn flex w-full cursor-pointer items-center justify-between rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-left text-ink transition-all hover:border-ink"
					>
						<div>
							<span class="block text-[13px] font-semibold">Paperback Book (~275 w/p)</span>
							<span class="text-[12px] text-mute">Standard 6" × 9" trade book layout</span>
						</div>
						<span class="text-[12px] text-mute tabular-nums">275 w/p</span>
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Related Tools Note (Protected Against Draft Links) -->
	<aside
		aria-label="Related writing and reading tools"
		class="mt-5 flex flex-col items-start justify-between gap-3 pt-2 text-[14px] text-body sm:flex-row sm:items-center"
	>
		<p class="leading-[22px]">
			Have your draft ready? Paste your text into our{' '}
			{
				wordCounterTool?.status === 'live' ? (
					<a
						href={wordCounterTool.slug}
						class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 transition-colors hover:text-vercel-blue-deep hover:decoration-vercel-blue"
					>
						{wordCounterTool.shortName}
					</a>
				) : (
					<span aria-disabled="true" class="inline-flex items-center gap-1.5 font-medium text-ink">
						<span>{wordCounterTool?.shortName ?? 'Word Counter'}</span>
						<span class="rounded-full bg-hairline-soft px-2 py-0.5 text-[11px] font-medium text-mute">
							Soon
						</span>
					</span>
				)
			}
			, check reading duration with the{' '}
			{
				readingTool?.status === 'live' ? (
					<a
						href={readingTool.slug}
						class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 transition-colors hover:text-vercel-blue-deep hover:decoration-vercel-blue"
					>
						{readingTool.shortName}
					</a>
				) : (
					<span aria-disabled="true" class="inline-flex items-center gap-1.5 font-medium text-ink">
						<span>{readingTool?.shortName ?? 'Reading Time Counter'}</span>
						<span class="rounded-full bg-hairline-soft px-2 py-0.5 text-[11px] font-medium text-mute">
							Soon
						</span>
					</span>
				)
			}
			, or time a talk with the{' '}
			{
				speechTool?.status === 'live' ? (
					<a
						href={speechTool.slug}
						class="font-medium text-vercel-blue underline decoration-vercel-blue/30 underline-offset-4 transition-colors hover:text-vercel-blue-deep hover:decoration-vercel-blue"
					>
						{speechTool.shortName}
					</a>
				) : (
					<span aria-disabled="true" class="inline-flex items-center gap-1.5 font-medium text-ink">
						<span>{speechTool?.shortName ?? 'Speech Time Calculator'}</span>
						<span class="rounded-full bg-hairline-soft px-2 py-0.5 text-[11px] font-medium text-mute">
							Soon
						</span>
					</span>
				)
			}.
		</p>
	</aside>
</section>

<script>
	function initWordsToPagesCalculator() {
		let mode: 'w2p' | 'p2w' = 'w2p';
		let spacingMode: 'single' | 'onehalf' | 'double' | 'custom' = 'double';
		let baseSpacingWpp = 250; // single=500, onehalf=330, double=250
		let fontPreset: 'standard' | 'calibri' | 'book' = 'standard';
		let fontLabel = '12pt Times / Arial';
		let effectiveWpp = 250;

		// DOM Elements
		const modeBtns = document.querySelectorAll<HTMLButtonElement>('.wtp-mode-btn');
		const panelW2P = document.getElementById('tab-panel-w2p');
		const panelP2W = document.getElementById('tab-panel-p2w');
		const btnReset = document.getElementById('btn-reset-defaults');

		const wordsInput = document.getElementById('wtp-words-input') as HTMLInputElement | null;
		const pagesInput = document.getElementById('wtp-pages-input') as HTMLInputElement | null;
		const customWppInput = document.getElementById('custom-wpp-input') as HTMLInputElement | null;

		const wordPresetBtns = document.querySelectorAll<HTMLButtonElement>('.wtp-word-preset');
		const pagePresetBtns = document.querySelectorAll<HTMLButtonElement>('.wtp-page-preset');
		const spacingBtns = document.querySelectorAll<HTMLButtonElement>('.wtp-spacing-btn');
		const fontBtns = document.querySelectorAll<HTMLButtonElement>('.wtp-font-btn');

		// Summary Outputs
		const badgeWppRate = document.getElementById('badge-wpp-rate');
		const badgeConversionMode = document.getElementById('badge-conversion-mode');
		const metricPagesTotal = document.getElementById('metric-pages-total');
		const metricPagesUnit = document.getElementById('metric-pages-unit');
		const metricPagesSub = document.getElementById('metric-pages-sub');
		const metricWordsTotal = document.getElementById('metric-words-total');
		const metricCharsEst = document.getElementById('metric-chars-est');
		const metricParagraphsEst = document.getElementById('metric-paragraphs-est');
		const metricSilentReadTime = document.getElementById('metric-silent-read-time');
		const metricSpeakingReadTime = document.getElementById('metric-speaking-read-time');

		const activeSpacingBadge = document.getElementById('active-spacing-badge');
		const activeFontBadge = document.getElementById('active-font-badge');
		const comparisonWordsBadge = document.getElementById('comparison-words-badge');

		const compareSinglePages = document.getElementById('compare-single-pages');
		const compareOneHalfPages = document.getElementById('compare-onehalf-pages');
		const compareDoublePages = document.getElementById('compare-double-pages');
		const compareBookPages = document.getElementById('compare-book-pages');

		function formatDuration(words: number, wpm: number): string {
			if (words <= 0 || wpm <= 0) return '0 min 0 sec';
			const totalSeconds = Math.round((words / wpm) * 60);
			const minutes = Math.floor(totalSeconds / 60);
			const seconds = totalSeconds % 60;
			return `${minutes.toLocaleString()} min ${seconds} sec`;
		}

		function formatPagesCount(pages: number): string {
			if (pages <= 0) return '0';
			const rounded = Math.round(pages * 10) / 10;
			return Number.isInteger(rounded) ? rounded.toLocaleString() : rounded.toFixed(1);
		}

		function computeEffectiveWpp(): number {
			if (spacingMode === 'custom') {
				const customVal = Math.max(50, Math.min(2000, Number(customWppInput?.value) || 250));
				return customVal;
			}
			if (fontPreset === 'book') {
				return 275;
			}
			const multiplier = fontPreset === 'calibri' ? 1.1 : 1.0;
			return Math.round(baseSpacingWpp * multiplier);
		}

		function getSpacingName(): string {
			if (fontPreset === 'book' && spacingMode !== 'custom') return 'Paperback layout';
			if (spacingMode === 'single') return 'Single-spaced';
			if (spacingMode === 'onehalf') return '1.5-spaced';
			if (spacingMode === 'double') return 'Double-spaced';
			return 'Custom rate';
		}

		function updateUI() {
			effectiveWpp = computeEffectiveWpp();
			if (customWppInput && spacingMode !== 'custom') {
				customWppInput.value = String(effectiveWpp);
			}

			let words = 0;
			let pages = 0;

			if (mode === 'w2p') {
				words = Math.max(0, Math.round(Number(wordsInput?.value) || 0));
				pages = effectiveWpp > 0 ? words / effectiveWpp : 0;
				if (pagesInput) {
					const syncedPages = Math.round(pages * 10) / 10;
					pagesInput.value = String(syncedPages);
				}
			} else {
				pages = Math.max(0, Number(pagesInput?.value) || 0);
				words = Math.round(pages * effectiveWpp);
				if (wordsInput) {
					wordsInput.value = String(words);
				}
			}

			const formattedPages = formatPagesCount(pages);
			const spacingLabel = getSpacingName();

			if (badgeWppRate) badgeWppRate.textContent = `${effectiveWpp} words/page`;
			if (badgeConversionMode) {
				badgeConversionMode.textContent = mode === 'w2p' ? 'Words to pages' : 'Pages to words';
			}
			if (metricPagesTotal) metricPagesTotal.textContent = formattedPages;
			if (metricPagesUnit) metricPagesUnit.textContent = pages === 1 ? 'page' : 'pages';
			if (metricPagesSub) metricPagesSub.textContent = `${spacingLabel} · ${fontLabel}`;

			if (metricWordsTotal) metricWordsTotal.textContent = words.toLocaleString();
			if (metricCharsEst) metricCharsEst.textContent = (words * 6).toLocaleString();
			if (metricParagraphsEst) {
				const estParas = words > 0 ? Math.max(1, Math.round(words / 125)) : 0;
				metricParagraphsEst.textContent = estParas.toLocaleString();
			}

			if (metricSilentReadTime) metricSilentReadTime.textContent = formatDuration(words, 238);
			if (metricSpeakingReadTime) metricSpeakingReadTime.textContent = formatDuration(words, 130);

			if (activeSpacingBadge) activeSpacingBadge.textContent = spacingLabel;
			if (activeFontBadge) activeFontBadge.textContent = fontLabel;
			if (comparisonWordsBadge) comparisonWordsBadge.textContent = `For ${words.toLocaleString()} words`;

			if (compareSinglePages) {
				const p = words / 500;
				compareSinglePages.textContent = `${formatPagesCount(p)} ${p === 1 ? 'page' : 'pages'}`;
			}
			if (compareOneHalfPages) {
				const p = words / 330;
				compareOneHalfPages.textContent = `${formatPagesCount(p)} ${p === 1 ? 'page' : 'pages'}`;
			}
			if (compareDoublePages) {
				const p = words / 250;
				compareDoublePages.textContent = `${formatPagesCount(p)} ${p === 1 ? 'page' : 'pages'}`;
			}
			if (compareBookPages) {
				const p = words / 275;
				compareBookPages.textContent = `${formatPagesCount(p)} ${p === 1 ? 'page' : 'pages'}`;
			}
		}

		function syncSpacingButtons() {
			spacingBtns.forEach((btn) => {
				const isSelected = btn.dataset.spacingMode === spacingMode;
				btn.className = isSelected
					? 'wtp-spacing-btn flex cursor-pointer flex-col items-start rounded-sm border border-primary bg-primary p-3 text-left text-on-primary transition-all'
					: 'wtp-spacing-btn flex cursor-pointer flex-col items-start rounded-sm border border-hairline bg-canvas p-3 text-left text-ink transition-all hover:border-ink';
				const sub = btn.querySelector('span:last-child');
				if (sub) {
					sub.className = isSelected
						? 'text-[12px] opacity-80 tabular-nums'
						: 'text-[12px] text-mute tabular-nums';
				}
			});
		}

		function syncFontButtons() {
			fontBtns.forEach((btn) => {
				const isSelected = btn.dataset.fontPreset === fontPreset;
				btn.className = isSelected
					? 'wtp-font-btn flex w-full cursor-pointer items-center justify-between rounded-sm border border-primary bg-primary px-3.5 py-2.5 text-left text-on-primary transition-all'
					: 'wtp-font-btn flex w-full cursor-pointer items-center justify-between rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-left text-ink transition-all hover:border-ink';
			});
		}

		function syncWordPresets(activeWords: number) {
			wordPresetBtns.forEach((btn) => {
				const isMatch = Number(btn.dataset.wordsPreset) === activeWords;
				btn.className = `wtp-word-preset cursor-pointer rounded-sm border px-3 py-1.5 text-[13px] font-medium tabular-nums transition-colors ${
					isMatch
						? 'border-primary bg-primary text-on-primary'
						: 'border-hairline bg-canvas text-body hover:border-ink hover:text-ink'
				}`;
			});
		}

		function syncPagePresets(activePages: number) {
			pagePresetBtns.forEach((btn) => {
				const isMatch = Number(btn.dataset.pagesPreset) === activePages;
				btn.className = `wtp-page-preset cursor-pointer rounded-sm border px-3 py-1.5 text-[13px] font-medium tabular-nums transition-colors ${
					isMatch
						? 'border-primary bg-primary text-on-primary'
						: 'border-hairline bg-canvas text-body hover:border-ink hover:text-ink'
				}`;
			});
		}

		// Mode Tab Switching
		modeBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const targetMode = (btn.dataset.mode as 'w2p' | 'p2w') || 'w2p';
				mode = targetMode;

				modeBtns.forEach((b) => {
					const active = b.dataset.mode === mode;
					b.setAttribute('aria-selected', active ? 'true' : 'false');
					b.className = active
						? 'wtp-mode-btn cursor-pointer rounded-pill-category bg-primary px-3.5 py-1.5 text-[13px] font-medium text-on-primary transition-all'
						: 'wtp-mode-btn cursor-pointer rounded-pill-category bg-transparent px-3.5 py-1.5 text-[13px] font-medium text-body transition-all hover:bg-hairline-soft hover:text-ink';
				});

				panelW2P?.classList.toggle('hidden', mode !== 'w2p');
				panelP2W?.classList.toggle('hidden', mode !== 'p2w');
				updateUI();
			});
		});

		// Word count input & presets
		wordsInput?.addEventListener('input', () => {
			mode = 'w2p';
			syncWordPresets(Number(wordsInput.value));
			updateUI();
		});

		wordPresetBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const val = Number(btn.dataset.wordsPreset) || 1500;
				if (wordsInput) wordsInput.value = String(val);
				syncWordPresets(val);
				updateUI();
			});
		});

		// Page count input & presets
		pagesInput?.addEventListener('input', () => {
			mode = 'p2w';
			syncPagePresets(Number(pagesInput.value));
			updateUI();
		});

		pagePresetBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const val = Number(btn.dataset.pagesPreset) || 5;
				if (pagesInput) pagesInput.value = String(val);
				syncPagePresets(val);
				updateUI();
			});
		});

		// Spacing buttons
		spacingBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const newMode = (btn.dataset.spacingMode as 'single' | 'onehalf' | 'double' | 'custom') || 'double';
				spacingMode = newMode;
				if (newMode !== 'custom') {
					baseSpacingWpp = Number(btn.dataset.baseWpp) || 250;
					if (fontPreset === 'book') {
						fontPreset = 'standard';
						fontLabel = '12pt Times / Arial';
						syncFontButtons();
					}
				} else {
					customWppInput?.focus();
				}
				syncSpacingButtons();
				updateUI();
			});
		});

		// Custom WPP Input
		customWppInput?.addEventListener('input', () => {
			spacingMode = 'custom';
			syncSpacingButtons();
			updateUI();
		});

		// Font preset buttons
		fontBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				fontPreset = (btn.dataset.fontPreset as 'standard' | 'calibri' | 'book') || 'standard';
				fontLabel = btn.dataset.fontLabel || '12pt Times / Arial';
				if (spacingMode === 'custom') {
					spacingMode = 'double';
					baseSpacingWpp = 250;
					syncSpacingButtons();
				}
				syncFontButtons();
				updateUI();
			});
		});

		// Reset defaults
		btnReset?.addEventListener('click', () => {
			mode = 'w2p';
			spacingMode = 'double';
			baseSpacingWpp = 250;
			fontPreset = 'standard';
			fontLabel = '12pt Times / Arial';
			if (wordsInput) wordsInput.value = '1500';
			if (pagesInput) pagesInput.value = '6';
			if (customWppInput) customWppInput.value = '250';
			modeBtns[0]?.click();
			syncWordPresets(1500);
			syncPagePresets(6);
			syncSpacingButtons();
			syncFontButtons();
			updateUI();
		});

		updateUI();
	}

	initWordsToPagesCalculator();
</script>

