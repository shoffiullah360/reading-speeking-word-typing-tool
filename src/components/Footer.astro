---
import {
	SITE_CONFIG,
	STANDALONE_TOOLS,
	TOOLS_REGISTRY,
	STATIC_PAGES,
	getStandaloneToolsForLocale,
} from '../config/site';
import { getLocaleFromUrl, getLocalizedPath, useTranslations } from '../i18n/ui';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const homeHref = getLocalizedPath('/', locale);
const liveStandaloneTools = getStandaloneToolsForLocale(locale);

const currentYear = new Date().getFullYear();

const categorizedTools = SITE_CONFIG.categories.map((category) => ({
	category,
	tools: [
		...TOOLS_REGISTRY.filter((tool) => tool.category === category).map((tool) => ({
			slug: getLocalizedPath(tool.slug, locale),
			label: t(`${tool.dictKey}.shortName`),
			isLive: tool.status === 'live',
		})),
		// Standalone tools keep a single root URL, so their slug is never locale-prefixed.
		...liveStandaloneTools.filter((tool) => tool.status === 'live' && tool.category === category).map(
			(tool) => ({ slug: tool.slug, label: tool.shortName, isLive: true })
		),
	],
}));
---

<footer class="mt-auto border-t border-footer-border bg-footer-bg py-10 text-[14px] text-body sm:py-14">
	<div class="mx-auto max-w-[1200px] px-4 sm:px-6">
		<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-10 lg:grid-cols-12">
			<!-- Brand Column -->
			<div class="lg:col-span-3">
				<a href={homeHref} class="inline-flex items-center gap-2 text-ink">
					<span class="brand-badge flex h-6 w-6 items-center justify-center rounded-sm border border-[#0f2e26] bg-[#0f2e26] text-[#afe3d0] dark:border-transparent dark:bg-primary dark:text-on-primary">
						<svg
							class="h-3.5 w-3.5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.3"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M4 6.5L8 18.5L12 9.5L16 18.5L20 6.5" />
						</svg>
					</span>
					<span class="text-[16px] font-semibold tracking-[-0.3px] text-ink">
						{SITE_CONFIG.name}
					</span>
				</a>
				<p class="mt-3 max-w-xs text-[14px] leading-[22px] text-body">
					{t('footer.description')}
				</p>
				<p class="mt-3 text-[13px] text-mute">
					{t('footer.privacyNote')}
				</p>
			</div>

			<!-- 5 Category Columns + Company & Legal Column -->
			<div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-6 lg:col-span-9">
				{
					categorizedTools.map(({ category, tools }) => (
						<div>
							<h3 class="text-[13px] font-semibold text-ink">
								{t(`common.categories.${category}`)}
							</h3>
							<ul class="mt-3 space-y-2.5 text-[14px]">
								{tools.map((tool) => (
									<li>
										{tool.isLive ? (
											<a
												href={tool.slug}
												class="text-body transition-colors hover:text-ink"
											>
												{tool.label}
											</a>
										) : (
											<span
												aria-disabled="true"
												class="inline-flex cursor-default items-center gap-2 text-mute select-none"
											>
												<span>{tool.label}</span>
												<span class="rounded-full border border-hairline bg-canvas-elevated px-2 py-0.5 text-[11px] font-medium text-mute">
													{t('common.soon')}
												</span>
											</span>
										)}
									</li>
								))}
							</ul>
						</div>
					))
				}

				<div>
					<h3 class="text-[13px] font-semibold text-ink">
						{t('footer.companyLegal')}
					</h3>
					<ul class="mt-3 space-y-2.5 text-[14px]">
						{
							STATIC_PAGES.map((page) => (
								<li>
									<a
										href={getLocalizedPath(page.slug, locale)}
										class="text-body transition-colors hover:text-ink"
									>
										{t(`${page.dictKey}.shortName`)}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>

		<div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-footer-border pt-6 text-[13px] text-mute sm:flex-row">
			<p>© {currentYear} {SITE_CONFIG.name} ({SITE_CONFIG.origin.replace('https://', '')}). {t('footer.rights')}</p>
			<div class="flex flex-wrap items-center gap-4">
				<a href={getLocalizedPath('/about/', locale)} class="transition-colors hover:text-ink">{t('about.shortName')}</a>
				<a href={getLocalizedPath('/privacy-policy/', locale)} class="transition-colors hover:text-ink">{t('privacy.shortName')}</a>
				<a href={getLocalizedPath('/terms-of-service/', locale)} class="transition-colors hover:text-ink">{t('terms.shortName')}</a>
				<a href={getLocalizedPath('/contact/', locale)} class="transition-colors hover:text-ink">{t('contact.shortName')}</a>
			</div>
		</div>
	</div>
</footer>
