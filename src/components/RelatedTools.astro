---
import ToolLinkCard from './ToolLinkCard.astro';
import { getRelatedToolIds } from '../config/related';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
	toolId: string;
	locale: Locale;
	/** Tailwind max-width utility for the section wrapper (defaults to the 1200px grid). */
	maxWidthClass?: string;
}

const { toolId, locale, maxWidthClass = 'max-w-[1200px]' } = Astro.props;
const t = useTranslations(locale);
const relatedIds = getRelatedToolIds(toolId);
---

<section
	aria-label={t('relatedTools.ariaLabel')}
	class={`mx-auto ${maxWidthClass} border-t border-hairline px-4 pt-10 pb-16 sm:px-6`}
>
	<div class="max-w-2xl">
		<h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
			{t('relatedTools.heading')}
		</h2>
		<p class="mt-2 text-[15px] leading-relaxed text-body">
			{t('relatedTools.subtitle')}
		</p>
	</div>

	<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
		{relatedIds.map((id) => <ToolLinkCard toolId={id} locale={locale} />)}
	</div>
</section>
