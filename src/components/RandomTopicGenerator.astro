				copyBtn.type = 'button';
				copyBtn.className =
					'cursor-pointer rounded-lg border border-[#0f2e26]/15 bg-canvas-elevated px-3 py-1.5 text-[12px] font-medium text-ink transition-all hover:border-[#5EC4A3] hover:bg-[#E6F7F1] hover:text-[#0f2e26] dark:border-[#afe3d0]/20';
				copyBtn.textContent = I18N.btnCopy;
				copyBtn.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(formatTopicForCopy(item));
						copyBtn.textContent = I18N.btnCopied;
						setTimeout(() => {
							copyBtn.textContent = I18N.btnCopy;
						}, 1200);
					} catch {}
				});

				const saveBtn = document.createElement('button');
				saveBtn.type = 'button';
				const updateRowSaveBtn = () => {
					const saved = isTopicSaved(item.id);
					saveBtn.textContent = saved ? I18N.btnSavedShort : I18N.btnSaveShort;
					saveBtn.className = saved
						? 'cursor-pointer rounded-lg border border-[#5EC4A3] bg-[#afe3d0] px-3 py-1.5 text-[12px] font-semibold text-[#0f2e26]'
						: 'cursor-pointer rounded-lg border border-[#0f2e26]/15 bg-canvas-elevated px-3 py-1.5 text-[12px] font-medium text-ink transition-all hover:border-[#5EC4A3] hover:bg-[#E6F7F1] hover:text-[#0f2e26] dark:border-[#afe3d0]/20';
				};
				updateRowSaveBtn();

				saveBtn.addEventListener('click', () => {
					toggleSaveTopic(item);
					updateRowSaveBtn();
				});

				actionsDiv.appendChild(copyBtn);
				actionsDiv.appendChild(saveBtn);

				li.appendChild(leftDiv);
				li.appendChild(actionsDiv);
				batchList.appendChild(li);
			});

			updatePoolMeta();
		}

		function formatTopicForCopy(topic: TopicRecord): string {
			const lensLine =
				currentLens !== 'Straight'
					? `\n${fmt(I18N.copyPerspectiveLens, { lens: labelLens(currentLens) })}`
					: '';
			const pointsBlock = topic.points.map((p) => `• ${p}`).join('\n');
			return `${topic.title} [${labelMode(topic.mode)} · ${labelCategory(topic.category)} · ${labelLevel(topic.level)}]${lensLine}\n\n${I18N.copyTalkingPointsLabel}\n${pointsBlock}`;
		}

		function resolveSavedDisplay(item: SavedTopic): SavedTopic {
			const match = TOPICS.find((t) => t.id === item.id);
			if (!match) return item;
			return {
				id: match.id,
				mode: match.mode,
				category: match.category,
				level: match.level,
				title: match.title,
				points: [...match.points],
			};
		}

		function downloadTextFile(filename: string, content: string) {
			const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = filename;
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
			URL.revokeObjectURL(url);
		}

		// Shortlist Persistence
		function loadShortlist() {
			try {
				const raw = localStorage.getItem(SHORTLIST_STORAGE_KEY);
				if (raw) {
					const parsed = JSON.parse(raw);
					if (Array.isArray(parsed)) {
						savedTopics = parsed;
					}
				}
			} catch {}
		}

		function saveShortlist() {
			try {
				localStorage.setItem(SHORTLIST_STORAGE_KEY, JSON.stringify(savedTopics));
			} catch {}
		}

		function toggleSaveTopic(topic: TopicRecord) {
			const existingIdx = savedTopics.findIndex((s) => s.id === topic.id);
			if (existingIdx >= 0) {
				savedTopics.splice(existingIdx, 1);
				if (statusToast) statusToast.textContent = I18N.toastRemovedShortlist;
			} else {
				savedTopics.unshift({
					id: topic.id,
					mode: topic.mode,
					category: topic.category,
					level: topic.level,
					title: topic.title,
					points: [...topic.points],
				});
				if (statusToast) statusToast.textContent = I18N.toastSavedShortlist;
			}
			saveShortlist();
			renderShortlist();
			syncSaveButtonUI();
		}

		function renderShortlist() {
			const count = savedTopics.length;
			if (shortlistCount) shortlistCount.textContent = fmt(I18N.savedCount, { count });
			if (btnCopyAllSaved) btnCopyAllSaved.disabled = count === 0;
			if (btnDownloadSaved) btnDownloadSaved.disabled = count === 0;

			if (count === 0) {
				shortlistEmpty?.classList.remove('hidden');
				shortlistItemsList?.classList.add('hidden');
				btnClearShortlist?.classList.add('hidden');
				if (shortlistItemsList) shortlistItemsList.innerHTML = '';
				return;
			}

			shortlistEmpty?.classList.add('hidden');
			shortlistItemsList?.classList.remove('hidden');
			btnClearShortlist?.classList.remove('hidden');

			if (shortlistItemsList) {
				shortlistItemsList.innerHTML = '';
				savedTopics.forEach((rawItem, index) => {
					const item = resolveSavedDisplay(rawItem);
					const li = document.createElement('li');
					li.className = 'rounded-xl border border-[#0f2e26]/15 bg-canvas p-3.5 text-[13px] transition-colors hover:border-[#5EC4A3] dark:border-[#afe3d0]/20';

					const topRow = document.createElement('div');
					topRow.className = 'mb-1.5 flex items-center justify-between gap-2';

					const badgeSpan = document.createElement('span');
					badgeSpan.className = 'rounded-full bg-[#0f2e26]/[0.06] px-2.5 py-0.5 text-[11px] font-medium text-ink dark:bg-[#afe3d0]/10 dark:text-[#afe3d0]';
					badgeSpan.textContent = `${labelMode(item.mode)} · ${labelCategory(item.category)}`;

					const btnGroup = document.createElement('div');
					btnGroup.className = 'flex items-center gap-2';

					const copyBtn = document.createElement('button');
					copyBtn.type = 'button';
					copyBtn.className = 'cursor-pointer text-[11px] font-medium text-body hover:text-ink';
					copyBtn.textContent = I18N.btnCopy;
					copyBtn.addEventListener('click', async () => {
						try {
							const text = `${item.title}\n${(item.points || []).map((p) => `• ${p}`).join('\n')}`;
							await navigator.clipboard.writeText(text);
							copyBtn.textContent = I18N.btnCopied;
							setTimeout(() => {
								copyBtn.textContent = I18N.btnCopy;
							}, 1200);
						} catch {}
					});

					const removeBtn = document.createElement('button');
					removeBtn.type = 'button';
					removeBtn.setAttribute('aria-label', I18N.removeSavedAria);
					removeBtn.className =
						'cursor-pointer px-1 text-[14px] leading-none font-semibold text-mute hover:text-vercel-error';
					removeBtn.textContent = '×';
					removeBtn.addEventListener('click', () => {
						savedTopics.splice(index, 1);
						saveShortlist();
						renderShortlist();
						syncSaveButtonUI();
						if (viewMode === 'batch') renderBatchTopics();
					});

					btnGroup.appendChild(copyBtn);
					btnGroup.appendChild(removeBtn);
					topRow.appendChild(badgeSpan);
					topRow.appendChild(btnGroup);

					const titleP = document.createElement('p');
					titleP.className = 'cursor-pointer font-medium text-ink leading-[19px] hover:underline';
					titleP.textContent = item.title;
					titleP.addEventListener('click', () => {
						const match = TOPICS.find((t) => t.id === item.id);
						if (match) {
							currentTopic = match;
							setViewMode('single');
							renderSingleTopic();
						}
					});

					li.appendChild(topRow);
					li.appendChild(titleP);
					shortlistItemsList.appendChild(li);
				});
			}
		}

		function setViewMode(mode: 'single' | 'batch') {
			viewMode = mode;
			if (mode === 'single') {
				singlePanel?.classList.remove('hidden');
				batchPanel?.classList.add('hidden');
				btnViewSingle?.setAttribute('aria-pressed', 'true');
				btnViewBatch?.setAttribute('aria-pressed', 'false');
				if (btnViewSingle) {
					btnViewSingle.className =
						'cursor-pointer rounded-lg bg-[#afe3d0] px-3 py-1 text-[12px] font-semibold text-[#0f2e26] transition-all';
				}
				if (btnViewBatch) {
					btnViewBatch.className =
						'cursor-pointer rounded-lg px-3 py-1 text-[12px] font-medium text-white/75 transition-all hover:text-white';
				}
			} else {
				singlePanel?.classList.add('hidden');
				batchPanel?.classList.remove('hidden');
				btnViewSingle?.setAttribute('aria-pressed', 'false');
				btnViewBatch?.setAttribute('aria-pressed', 'true');
				if (btnViewBatch) {
					btnViewBatch.className =
						'cursor-pointer rounded-lg bg-[#afe3d0] px-3 py-1 text-[12px] font-semibold text-[#0f2e26] transition-all';
				}
				if (btnViewSingle) {
					btnViewSingle.className =
						'cursor-pointer rounded-lg px-3 py-1 text-[12px] font-medium text-white/75 transition-all hover:text-white';
				}
				if (currentBatch.length === 0) {
					currentBatch = pickBatchTopics(5);
				}
				renderBatchTopics();
			}
		}

		// Filter Events
		modePills.forEach((pill) => {
			pill.addEventListener('click', () => {
				const selected = pill.getAttribute('data-rtg-mode') || 'All';
				currentMode = selected;

				modePills.forEach((p) => {
					const active = p === pill;
					p.setAttribute('aria-selected', active ? 'true' : 'false');
					p.className = active
						? 'rtg-mode-pill cursor-pointer rounded-xl border border-[#afe3d0] bg-[#afe3d0] px-4 py-2 text-[13px] font-semibold text-[#0f2e26] shadow-2xs transition-all'
						: 'rtg-mode-pill cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.06] px-4 py-2 text-[13px] font-medium text-white/85 transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.12] hover:text-white';
				});

				if (viewMode === 'single') {
					currentTopic = pickNextTopic();
					renderSingleTopic();
				} else {
					currentBatch = pickBatchTopics(5);
					renderBatchTopics();
				}
			});
		});

		selectCategory?.addEventListener('change', () => {
			currentCategory = selectCategory.value;
			if (viewMode === 'single') {
				currentTopic = pickNextTopic();
				renderSingleTopic();
			} else {
				currentBatch = pickBatchTopics(5);
				renderBatchTopics();
			}
		});

		selectLevel?.addEventListener('change', () => {
			currentLevel = selectLevel.value;
			if (viewMode === 'single') {
				currentTopic = pickNextTopic();
				renderSingleTopic();
			} else {
				currentBatch = pickBatchTopics(5);
				renderBatchTopics();
			}
		});

		selectLens?.addEventListener('change', () => {
			currentLens = selectLens.value;
			renderSingleTopic();
		});

		checkboxNoRepeats?.addEventListener('change', () => {
			noRepeats = checkboxNoRepeats.checked;
			updatePoolMeta();
		});

		btnViewSingle?.addEventListener('click', () => setViewMode('single'));
		btnViewBatch?.addEventListener('click', () => setViewMode('batch'));

		// PREP Toggle
		btnPrepToggle?.addEventListener('click', () => {
			if (!prepStrip) return;
			const isHidden = prepStrip.classList.contains('hidden');
			if (isHidden) {
				prepStrip.classList.remove('hidden');
				btnPrepToggle.setAttribute('aria-expanded', 'true');
				btnPrepToggle.className =
					'cursor-pointer rounded-full border border-[#5EC4A3] bg-[#afe3d0] px-3 py-1 text-[12px] font-semibold text-[#0f2e26] transition-all';
			} else {
				prepStrip.classList.add('hidden');
				btnPrepToggle.setAttribute('aria-expanded', 'false');
				btnPrepToggle.className =
					'cursor-pointer rounded-full border border-[#0f2e26]/15 bg-canvas px-3 py-1 text-[12px] font-medium text-body transition-all hover:border-[#5EC4A3] hover:bg-[#E6F7F1] hover:text-[#0f2e26] dark:border-[#afe3d0]/20 dark:hover:border-[#afe3d0]/40 dark:hover:text-[#afe3d0]';
			}
		});

		// Today's Topic deterministic daily seed
		btnTodaysTopic?.addEventListener('click', () => {
			const now = new Date();
			const daySeed =
				now.getFullYear() * 10000 + (now.getMonth() + 1) * 100 + now.getDate();
			const pool = getMatchingPool();
			const list = pool.length > 0 ? pool : TOPICS;
			const index = daySeed % list.length;
			currentTopic = list[index];
			seenIds.add(currentTopic.id);
			setViewMode('single');
			renderSingleTopic();
			if (statusToast) {
				const dateStr = now.toLocaleDateString(I18N.locale || undefined, { month: 'short', day: 'numeric' });
				statusToast.textContent = fmt(I18N.toastTodaysTopic, { date: dateStr });
			}
		});

		// Generate New Topic (Single)
		btnGenerate?.addEventListener('click', () => {
			currentTopic = pickNextTopic();
			renderSingleTopic();
			if (statusToast) {
				statusToast.textContent = fmt(I18N.toastGeneratedNew, { mode: labelMode(currentTopic.mode) });
			}
		});

		// Spacebar shortcut when not typing in an input/textarea/select
		window.addEventListener('keydown', (e) => {
			if (e.code !== 'Space') return;
			const activeEl = document.activeElement;
			const tag = activeEl?.tagName.toLowerCase();
			if (
				tag === 'input' ||
				tag === 'textarea' ||
				tag === 'select' ||
				tag === 'button' ||
				(activeEl as HTMLElement | null)?.isContentEditable
			) {
				return;
			}
			const workspace = document.getElementById('random-topic-workspace');
			if (!workspace) return;
			e.preventDefault();
			if (viewMode === 'single') {
				currentTopic = pickNextTopic();
				renderSingleTopic();
			} else {
				currentBatch = pickBatchTopics(5);
				renderBatchTopics();
			}
		});

		// Copy Single Topic + Points
		btnCopySingle?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(formatTopicForCopy(currentTopic));
				if (copySingleLabel) copySingleLabel.textContent = I18N.btnCopiedBang;
				if (statusToast) statusToast.textContent = I18N.toastCopiedSingle;
				setTimeout(() => {
					if (copySingleLabel) copySingleLabel.textContent = I18N.btnCopyTopicPoints;
				}, 1400);
			} catch {}
		});

		// Save Single Topic
		btnSaveSingle?.addEventListener('click', () => {
			toggleSaveTopic(currentTopic);
		});

		// Copy Share Link
		btnCopyLink?.addEventListener('click', async () => {
			try {
				const url = new URL(window.location.href);
				url.searchParams.set('topic', currentTopic.id);
				await navigator.clipboard.writeText(url.toString());
				if (copyLinkLabel) copyLinkLabel.textContent = I18N.btnLinkCopied;
				if (statusToast) statusToast.textContent = I18N.toastLinkCopied;
				setTimeout(() => {
					if (copyLinkLabel) copyLinkLabel.textContent = I18N.btnCopyLink;
				}, 1400);
			} catch {}
		});

		// Batch Actions
		btnGenerateBatch?.addEventListener('click', () => {
			currentBatch = pickBatchTopics(5);
			renderBatchTopics();
			if (batchToast) batchToast.textContent = I18N.toastBatchGenerated;
		});

		btnCopyBatch?.addEventListener('click', async () => {
			if (currentBatch.length === 0) return;
			const formatted = currentBatch
				.map((t, idx) => `${idx + 1}. ${formatTopicForCopy(t)}`)
				.join('\n\n---\n\n');
			try {
				await navigator.clipboard.writeText(formatted);
				const prev = btnCopyBatch.textContent;
				btnCopyBatch.textContent = I18N.btnCopiedAll5;
				setTimeout(() => {
					btnCopyBatch.textContent = prev;
				}, 1400);
			} catch {}
		});

		btnDownloadBatch?.addEventListener('click', () => {
			if (currentBatch.length === 0) return;
			const formatted = currentBatch
				.map((t, idx) => `${idx + 1}. ${formatTopicForCopy(t)}`)
				.join('\n\n---\n\n');
			downloadTextFile('wordora-random-topics-batch.txt', formatted);
		});

		// Shortlist Actions
		btnClearShortlist?.addEventListener('click', () => {
			savedTopics = [];
			saveShortlist();
			renderShortlist();
			syncSaveButtonUI();
			if (viewMode === 'batch') renderBatchTopics();
		});

		btnCopyAllSaved?.addEventListener('click', async () => {
			if (savedTopics.length === 0) return;
			const text = savedTopics
				.map((raw, idx) => {
					const t = resolveSavedDisplay(raw);
					return `${idx + 1}. [${labelMode(t.mode)} · ${labelCategory(t.category)}] ${t.title}\n${(t.points || []).map((p) => `   • ${p}`).join('\n')}`;
				})
				.join('\n\n');
			try {
				await navigator.clipboard.writeText(text);
				const prev = btnCopyAllSaved.textContent;
				btnCopyAllSaved.textContent = I18N.btnCopiedAll;
				setTimeout(() => {
					btnCopyAllSaved.textContent = prev;
				}, 1400);
			} catch {}
		});

		btnDownloadSaved?.addEventListener('click', () => {
			if (savedTopics.length === 0) return;
			const text = savedTopics
				.map((raw, idx) => {
					const t = resolveSavedDisplay(raw);
					return `${idx + 1}. [${labelMode(t.mode)} · ${labelCategory(t.category)} · ${labelLevel(t.level)}] ${t.title}\n${(t.points || []).map((p) => `   • ${p}`).join('\n')}`;
				})
				.join('\n\n');
			downloadTextFile('wordora-shortlisted-topics.txt', text);
		});

		// Practice Timer Controls
		function formatTimer(seconds: number): string {
			const mins = Math.floor(seconds / 60);
			const secs = seconds % 60;
			return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
		}

		function updateTimerUI() {
			if (timerDisplay) timerDisplay.textContent = formatTimer(remainingSec);
		}

		function stopTimerInterval() {
			if (timerInterval !== null) {
				window.clearInterval(timerInterval);
				timerInterval = null;
			}
		}

		timerPresets.forEach((btn) => {
			btn.addEventListener('click', () => {
				const sec = parseInt(btn.getAttribute('data-rtg-timer') || '60', 10);
				stopTimerInterval();
				selectedDurationSec = sec;
				remainingSec = sec;
				updateTimerUI();
				if (btnTimerStart) btnTimerStart.textContent = I18N.timerStart;
				if (timerStateLabel) timerStateLabel.textContent = I18N.timerReady;

				timerPresets.forEach((b) => {
					const active = b === btn;
					b.className = active
						? 'rtg-timer-preset cursor-pointer rounded-lg border border-[#5EC4A3] bg-[#afe3d0] px-2.5 py-1 text-[12px] font-semibold text-[#0f2e26] transition-all'
						: 'rtg-timer-preset cursor-pointer rounded-lg border border-[#0f2e26]/15 bg-canvas px-2.5 py-1 text-[12px] font-medium text-mute transition-all hover:border-[#5EC4A3] hover:text-ink dark:border-[#afe3d0]/20';
				});
			});
		});

		btnTimerStart?.addEventListener('click', () => {
			if (timerInterval !== null) {
				// Pause
				stopTimerInterval();
				btnTimerStart.textContent = I18N.timerResume;
				if (timerStateLabel) timerStateLabel.textContent = I18N.timerPaused;
			} else {
				if (remainingSec <= 0) {
					remainingSec = selectedDurationSec;
				}
				btnTimerStart.textContent = I18N.timerPause;
				if (timerStateLabel) timerStateLabel.textContent = I18N.timerRunning;
				timerInterval = window.setInterval(() => {
					remainingSec = Math.max(0, remainingSec - 1);
					updateTimerUI();
					if (remainingSec <= 0) {
						stopTimerInterval();
						if (btnTimerStart) btnTimerStart.textContent = I18N.timerStart;
						if (timerStateLabel) timerStateLabel.textContent = I18N.timerTimesUp;
					}
				}, 1000);
			}
		});

		btnTimerReset?.addEventListener('click', () => {
			stopTimerInterval();
			remainingSec = selectedDurationSec;
			updateTimerUI();
			if (btnTimerStart) btnTimerStart.textContent = I18N.timerStart;
			if (timerStateLabel) timerStateLabel.textContent = I18N.timerReady;
		});

		// Quick Notes Scratchpad
		function updateNotesWordCount() {
			if (!notesInput || !notesWordcount) return;
			const raw = notesInput.value.trim();
			const words = raw ? raw.split(/\s+/).length : 0;
			const tpl = words === 1 ? I18N.wordSingular : I18N.wordPlural;
			notesWordcount.textContent = fmt(tpl, { count: words });
		}

		try {
			const savedNotes = localStorage.getItem(NOTES_STORAGE_KEY);
			if (savedNotes && notesInput) {
				notesInput.value = savedNotes;
				updateNotesWordCount();
			}
		} catch {}

		notesInput?.addEventListener('input', () => {
			updateNotesWordCount();
			try {
				localStorage.setItem(NOTES_STORAGE_KEY, notesInput.value);
			} catch {}
		});

		btnNotesClear?.addEventListener('click', () => {
			if (!notesInput) return;
			notesInput.value = '';
			updateNotesWordCount();
			try {
				localStorage.removeItem(NOTES_STORAGE_KEY);
			} catch {}
		});

		// Check URL query parameter ?topic=id
		try {
			const params = new URLSearchParams(window.location.search);
			const topicParam = params.get('topic');
			if (topicParam) {
				const found = TOPICS.find((t) => t.id === topicParam);
				if (found) {
					currentTopic = found;
				}
			}
		} catch {}

		seenIds.add(currentTopic.id);
		loadShortlist();
		renderSingleTopic();
		renderShortlist();
	}

	initRandomTopicGenerator();
</script>
