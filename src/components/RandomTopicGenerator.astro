		const btnDownloadSaved = document.getElementById('rtg-btn-download-saved') as HTMLButtonElement | null;

		// State
		let currentMode = 'All';
		let currentCategory = 'All Categories';
		let currentLevel = 'Any Level';
		let currentLens = 'Straight';
		let viewMode: 'single' | 'batch' = 'single';
		let noRepeats = true;

		let seenIds = new Set<string>();
		let currentTopic: TopicRecord = TOPICS[16]; // Flagship university research vs exams prompt
		let currentBatch: TopicRecord[] = [];
		let savedTopics: SavedTopic[] = [];

		// Timer State
		let selectedDurationSec = 60;
		let remainingSec = 60;
		let timerInterval: number | null = null;

		function getMatchingPool(): TopicRecord[] {
			return TOPICS.filter((item) => {
				if (currentMode !== 'All' && item.mode !== currentMode) return false;
				if (currentCategory !== 'All Categories' && item.category !== currentCategory) return false;
				if (currentLevel !== 'Any Level' && item.level !== currentLevel) return false;
				return true;
			});
		}

		function updatePoolMeta() {
			const pool = getMatchingPool();
			if (poolCountLabel) {
				const tpl = pool.length === 1 ? I18N.matchingTopicSingular : I18N.matchingTopicPlural;
				poolCountLabel.textContent = fmt(tpl, { count: pool.length });
			}
			if (seenCounter) {
				const seenInPool = pool.filter((t) => seenIds.has(t.id)).length;
				seenCounter.textContent = fmt(I18N.seenCounter, {
					seen: Math.max(1, seenInPool),
					total: pool.length,
				});
			}
		}

		function pickNextTopic(excludeIds: Set<string> = new Set()): TopicRecord {
			const pool = getMatchingPool();
			if (pool.length === 0) {
				return TOPICS[0];
			}

			let candidates = pool.filter((t) => !excludeIds.has(t.id));
			if (noRepeats) {
				const unseen = candidates.filter((t) => !seenIds.has(t.id));
				if (unseen.length > 0) {
					candidates = unseen;
				} else {
					// Pool exhausted: reset seenIds for current pool so cycle starts fresh without immediate repeat
					pool.forEach((t) => seenIds.delete(t.id));
					candidates = pool.filter((t) => t.id !== currentTopic.id && !excludeIds.has(t.id));
					if (candidates.length === 0) candidates = pool;
				}
			} else {
				const different = candidates.filter((t) => t.id !== currentTopic.id);
				if (different.length > 0) candidates = different;
			}

			const chosen = candidates[Math.floor(Math.random() * candidates.length)];
			seenIds.add(chosen.id);
			return chosen;
		}

		function pickBatchTopics(count = 5): TopicRecord[] {
			const pool = getMatchingPool();
			if (pool.length === 0) return [];
			const targetCount = Math.min(count, pool.length);
			const chosenBatch: TopicRecord[] = [];
			const batchIds = new Set<string>();

			for (let i = 0; i < targetCount; i++) {
				const next = pickNextTopic(batchIds);
				chosenBatch.push(next);
				batchIds.add(next.id);
			}
			return chosenBatch;
		}

		function isTopicSaved(id: string): boolean {
			return savedTopics.some((s) => s.id === id);
		}

		function syncSaveButtonUI() {
			if (!saveSingleLabel || !btnSaveSingle) return;
			const saved = isTopicSaved(currentTopic.id);
			if (saved) {
				saveSingleLabel.textContent = I18N.savedInShortlist;
				btnSaveSingle.className =
					'inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-[#5EC4A3] bg-[#afe3d0] px-4 py-3 text-[13px] font-semibold text-[#0f2e26] transition-all';
			} else {
				saveSingleLabel.textContent = I18N.saveToShortlist;
				btnSaveSingle.className =
					'inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-[#0f2e26]/15 bg-canvas px-4 py-3 text-[13px] font-medium text-ink transition-all hover:border-[#5EC4A3] hover:bg-[#E6F7F1] hover:text-[#0f2e26] dark:border-[#afe3d0]/20 dark:hover:border-[#afe3d0]/40 dark:hover:bg-[#0f2e26]/40 dark:hover:text-[#afe3d0]';
			}
		}

		function renderSingleTopic() {
			if (badgeMode) badgeMode.textContent = labelMode(currentTopic.mode);
			if (badgeCategory) badgeCategory.textContent = labelCategory(currentTopic.category);
			if (badgeLevel) badgeLevel.textContent = labelLevel(currentTopic.level);

			if (badgeLens && lensInstruction) {
				if (currentLens === 'Straight') {
					badgeLens.classList.add('hidden');
					lensInstruction.classList.add('hidden');
					lensInstruction.textContent = '';
				} else {
					badgeLens.classList.remove('hidden');
					badgeLens.textContent = fmt(I18N.lensBadge, { lens: labelLens(currentLens) });
					lensInstruction.classList.remove('hidden');
					lensInstruction.textContent = I18N.lensInstructions[currentLens] || '';
				}
			}

			if (topicTitle) {
				topicTitle.textContent = currentTopic.title;
			}

			if (pointsHeading) {
				pointsHeading.textContent =
					currentTopic.mode === 'Single-Word'
						? I18N.creativeAnglesHeading
						: I18N.talkingPointsHeading;
			}

			if (topicPointsList) {
				topicPointsList.innerHTML = '';
				currentTopic.points.forEach((pt) => {
					const li = document.createElement('li');
					li.className = 'flex items-start gap-2.5';
					const dot = document.createElement('span');
					dot.className = 'mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#0f2e26] dark:bg-[#afe3d0]';
					const text = document.createElement('span');
					text.textContent = pt;
					li.appendChild(dot);
					li.appendChild(text);
					topicPointsList.appendChild(li);
				});
			}

			syncSaveButtonUI();
			updatePoolMeta();
		}

