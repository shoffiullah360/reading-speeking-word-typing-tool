---
import { getLocaleFromUrl, getLocalizedPath, useTranslations, type Locale } from '../i18n/ui';
import { getToolById } from '../config/site';

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const wordsToPagesTool = getToolById('words-to-pages');
const typingSpeedTool = getToolById('typing-speed-test');
const speechTimeTool = getToolById('speech-time-calculator');

interface PrepStep {
	title: string;
	desc: string;
}

interface TopicCopy {
	title: string;
	points: [string, string, string];
}

const prepSteps = t.raw<PrepStep[]>('randomTopicGenerator.ui.prepSteps') ?? [];
const topicsDict = t.raw<Record<string, TopicCopy>>('randomTopicGenerator.topics') ?? {};
const initialTopic = topicsDict['ea-17'];

const clientI18n = {
	locale,
	modes: t.raw<Record<string, string>>('randomTopicGenerator.client.modes') ?? {},
	categories: t.raw<Record<string, string>>('randomTopicGenerator.client.categories') ?? {},
	levels: t.raw<Record<string, string>>('randomTopicGenerator.client.levels') ?? {},
	lenses: t.raw<Record<string, string>>('randomTopicGenerator.client.lenses') ?? {},
	lensInstructions: t.raw<Record<string, string>>('randomTopicGenerator.client.lensInstructions') ?? {},
	matchingTopicSingular: t('randomTopicGenerator.client.matchingTopicSingular'),
	matchingTopicPlural: t('randomTopicGenerator.client.matchingTopicPlural'),
	seenCounter: t('randomTopicGenerator.client.seenCounter'),
	savedInShortlist: t('randomTopicGenerator.client.savedInShortlist'),
	saveToShortlist: t('randomTopicGenerator.client.saveToShortlist'),
	lensBadge: t('randomTopicGenerator.client.lensBadge'),
	creativeAnglesHeading: t('randomTopicGenerator.client.creativeAnglesHeading'),
	talkingPointsHeading: t('randomTopicGenerator.client.talkingPointsHeading'),
	btnCopy: t('randomTopicGenerator.client.btnCopy'),
	btnCopied: t('randomTopicGenerator.client.btnCopied'),
	btnSavedShort: t('randomTopicGenerator.client.btnSavedShort'),
	btnSaveShort: t('randomTopicGenerator.client.btnSaveShort'),
	copyPerspectiveLens: t('randomTopicGenerator.client.copyPerspectiveLens'),
	copyTalkingPointsLabel: t('randomTopicGenerator.client.copyTalkingPointsLabel'),
	toastRemovedShortlist: t('randomTopicGenerator.client.toastRemovedShortlist'),
	toastSavedShortlist: t('randomTopicGenerator.client.toastSavedShortlist'),
	savedCount: t('randomTopicGenerator.client.savedCount'),
	removeSavedAria: t('randomTopicGenerator.client.removeSavedAria'),
	toastTodaysTopic: t('randomTopicGenerator.client.toastTodaysTopic'),
	toastGeneratedNew: t('randomTopicGenerator.client.toastGeneratedNew'),
	btnCopiedBang: t('randomTopicGenerator.client.btnCopiedBang'),
	btnCopyTopicPoints: t('randomTopicGenerator.client.btnCopyTopicPoints'),
	toastCopiedSingle: t('randomTopicGenerator.client.toastCopiedSingle'),
	btnLinkCopied: t('randomTopicGenerator.client.btnLinkCopied'),
	btnCopyLink: t('randomTopicGenerator.client.btnCopyLink'),
	toastLinkCopied: t('randomTopicGenerator.client.toastLinkCopied'),
	toastBatchGenerated: t('randomTopicGenerator.client.toastBatchGenerated'),
	btnCopiedAll5: t('randomTopicGenerator.client.btnCopiedAll5'),
	btnCopiedAll: t('randomTopicGenerator.client.btnCopiedAll'),
	timerStart: t('randomTopicGenerator.client.timerStart'),
	timerPause: t('randomTopicGenerator.client.timerPause'),
	timerResume: t('randomTopicGenerator.client.timerResume'),
	timerReady: t('randomTopicGenerator.client.timerReady'),
	timerPaused: t('randomTopicGenerator.client.timerPaused'),
	timerRunning: t('randomTopicGenerator.client.timerRunning'),
	timerTimesUp: t('randomTopicGenerator.client.timerTimesUp'),
	wordSingular: t('randomTopicGenerator.client.wordSingular'),
	wordPlural: t('randomTopicGenerator.client.wordPlural'),
	topics: topicsDict,
};
---

<section
	id="random-topic-workspace"
	aria-label={t('randomTopicGenerator.ui.workspaceAria')}
	class="mx-auto max-w-[1200px] px-4 pt-4 pb-12 sm:px-6"
>
	<!-- 1. Top Command Deck (#0f2e26 Deep Forest Emerald Control Header) -->
	<div class="emerald-result-panel mb-6 rounded-2xl border border-[#afe3d0]/25 bg-[#0f2e26] p-4 text-white shadow-lg sm:p-6">
		<!-- Row 1: Purpose Mode Pills -->
		<div class="flex flex-wrap items-center gap-2 border-b border-[#afe3d0]/15 pb-4" role="tablist" aria-label={t('randomTopicGenerator.ui.modesAria')}>
			<button
				type="button"
				data-rtg-mode="All"
				aria-selected="true"
				class="rtg-mode-pill cursor-pointer rounded-xl border border-[#afe3d0] bg-[#afe3d0] px-4 py-2 text-[13px] font-semibold text-[#0f2e26] shadow-2xs transition-all"
			>
				{t('randomTopicGenerator.ui.modeAll')}
			</button>
			<button
				type="button"
				data-rtg-mode="Essay & Academic"
				aria-selected="false"
				class="rtg-mode-pill cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.06] px-4 py-2 text-[13px] font-medium text-white/85 transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.12] hover:text-white"
			>
				{t('randomTopicGenerator.ui.modeEssayAcademic')}
			</button>
			<button
				type="button"
				data-rtg-mode="Speech & Debate"
				aria-selected="false"
				class="rtg-mode-pill cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.06] px-4 py-2 text-[13px] font-medium text-white/85 transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.12] hover:text-white"
			>
				{t('randomTopicGenerator.ui.modeSpeechDebate')}
			</button>
			<button
				type="button"
				data-rtg-mode="Conversation & Icebreakers"
				aria-selected="false"
				class="rtg-mode-pill cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.06] px-4 py-2 text-[13px] font-medium text-white/85 transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.12] hover:text-white"
			>
				{t('randomTopicGenerator.ui.modeConversationIcebreakers')}
			</button>
			<button
				type="button"
				data-rtg-mode="Creative Writing"
				aria-selected="false"
				class="rtg-mode-pill cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.06] px-4 py-2 text-[13px] font-medium text-white/85 transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.12] hover:text-white"
			>
				{t('randomTopicGenerator.ui.modeCreativeWriting')}
			</button>
			<button
				type="button"
				data-rtg-mode="Single-Word"
				aria-selected="false"
				class="rtg-mode-pill cursor-pointer rounded-xl border border-[#afe3d0]/20 bg-white/[0.06] px-4 py-2 text-[13px] font-medium text-white/85 transition-all hover:border-[#afe3d0]/50 hover:bg-white/[0.12] hover:text-white"
			>
				{t('randomTopicGenerator.ui.modeSingleWord')}
			</button>
		</div>

		<!-- Row 2: Compact Inline Dropdowns & View Toggle -->
		<div class="mt-4 flex flex-wrap items-center justify-between gap-3.5">
			<div class="flex w-full min-w-0 flex-wrap items-center gap-3 sm:w-auto">
				<!-- Category Select -->
				<div class="flex w-full min-w-0 items-center gap-2 sm:w-auto">
					<label for="rtg-select-category" class="text-[12px] font-medium text-[#afe3d0]/80">{t('randomTopicGenerator.ui.labelCategory')}</label>
					<select
						id="rtg-select-category"
						style="background-color: #163d33; color: #ffffff; border-color: rgba(175, 227, 208, 0.3);"
						class="min-w-0 flex-1 cursor-pointer rounded-lg border px-3 py-1.5 text-[13px] font-medium text-white transition-colors focus:border-[#afe3d0] focus:outline-none sm:flex-none"
					>
						<option value="All Categories" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.catAll')}</option>
						<option value="Technology & AI" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.catTechAi')}</option>
						<option value="Science & Health" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.catScienceHealth')}</option>
						<option value="Psychology & Philosophy" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.catPsychPhil')}</option>
						<option value="Business & Career" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.catBusinessCareer')}</option>
						<option value="Education & Society" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.catEduSociety')}</option>
						<option value="Culture & History" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.catCultureHistory')}</option>
						<option value="Fun & Random" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.catFunRandom')}</option>
					</select>
				</div>

				<!-- Level Select -->
				<div class="flex w-full min-w-0 items-center gap-2 sm:w-auto">
					<label for="rtg-select-level" class="text-[12px] font-medium text-[#afe3d0]/80">{t('randomTopicGenerator.ui.labelLevel')}</label>
					<select
						id="rtg-select-level"
						style="background-color: #163d33; color: #ffffff; border-color: rgba(175, 227, 208, 0.3);"
						class="min-w-0 flex-1 cursor-pointer rounded-lg border px-3 py-1.5 text-[13px] font-medium text-white transition-colors focus:border-[#afe3d0] focus:outline-none sm:flex-none"
					>
						<option value="Any Level" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.levelAny')}</option>
						<option value="Easy" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.levelEasy')}</option>
						<option value="Medium" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.levelMedium')}</option>
						<option value="Hard" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.levelHard')}</option>
					</select>
				</div>

				<!-- Perspective Lens Select -->
				<div class="flex w-full min-w-0 items-center gap-2 sm:w-auto">
					<label for="rtg-select-lens" class="text-[12px] font-medium text-[#afe3d0]/80">{t('randomTopicGenerator.ui.labelLens')}</label>
					<select
						id="rtg-select-lens"
						style="background-color: #163d33; color: #ffffff; border-color: rgba(175, 227, 208, 0.3);"
						class="min-w-0 flex-1 cursor-pointer rounded-lg border px-3 py-1.5 text-[13px] font-medium text-white transition-colors focus:border-[#afe3d0] focus:outline-none sm:flex-none"
					>
						<option value="Straight" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.lensStraight')}</option>
						<option value="Devil's Advocate" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.lensDevilsAdvocate')}</option>
						<option value="ELI5 (Simple)" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.lensEli5')}</option>
						<option value="Pitch It" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.lensPitchIt')}</option>
						<option value="Storytime" class="bg-[#0f2e26] text-white">{t('randomTopicGenerator.ui.lensStorytime')}</option>
					</select>
				</div>
			</div>

			<!-- Right Controls: View Mode Toggle + No Repeats + Pool Count -->
			<div class="flex flex-wrap items-center gap-3">
				<label class="inline-flex cursor-pointer items-center gap-2 text-[12px] font-medium text-white/90 select-none">
					<input
						type="checkbox"
						id="rtg-no-repeats"
						checked
						class="h-3.5 w-3.5 cursor-pointer rounded border-[#afe3d0]/40 accent-[#afe3d0]"
					/>
					<span>{t('randomTopicGenerator.ui.noRepeats')}</span>
					<span id="rtg-pool-count" class="rounded-full border border-[#afe3d0]/30 bg-white/[0.08] px-2.5 py-0.5 text-[11px] font-medium text-[#afe3d0] tabular-nums">
						{t('randomTopicGenerator.ui.initialPoolCount')}
					</span>
				</label>

				<div class="inline-flex rounded-xl border border-[#afe3d0]/25 bg-black/20 p-1" role="group" aria-label={t('randomTopicGenerator.ui.viewModeAria')}>
					<button
						type="button"
						id="rtg-view-single"
						aria-pressed="true"
						class="cursor-pointer rounded-lg bg-[#afe3d0] px-3 py-1 text-[12px] font-semibold text-[#0f2e26] transition-all"
					>
						{t('randomTopicGenerator.ui.viewSingle')}
					</button>
					<button
						type="button"
						id="rtg-view-batch"
						aria-pressed="false"
						class="cursor-pointer rounded-lg px-3 py-1 text-[12px] font-medium text-white/75 transition-all hover:text-white"
					>
						{t('randomTopicGenerator.ui.viewBatch')}
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- 2. Elevated Topic Stage Card -->
	<div class="whisper-shadow overflow-hidden rounded-2xl border border-[#0f2e26]/15 bg-canvas-elevated dark:border-[#afe3d0]/20">
		<!-- SINGLE FOCUS MODE -->
		<div id="rtg-single-panel">
			<!-- Top Meta Strip -->
			<div class="flex flex-wrap items-center justify-between gap-2.5 border-b border-[#0f2e26]/10 bg-[#0f2e26]/[0.02] px-6 py-4 sm:px-8 dark:border-[#afe3d0]/15 dark:bg-[#afe3d0]/[0.02]">
				<div class="flex flex-wrap items-center gap-2">
					<span
						id="rtg-badge-mode"
						class="rounded-full border border-[#5EC4A3] bg-[#afe3d0] px-3.5 py-1 text-[12px] font-semibold text-[#0f2e26]"
					>
						{t('randomTopicGenerator.ui.modeEssayAcademic')}
					</span>
					<span
						id="rtg-badge-category"
						class="rounded-full border border-[#0f2e26]/15 bg-canvas px-3 py-1 text-[12px] font-medium text-ink dark:border-[#afe3d0]/20"
					>
						{t('randomTopicGenerator.ui.catEduSociety')}
					</span>
					<span
						id="rtg-badge-level"
						class="rounded-full border border-[#0f2e26]/15 bg-canvas px-3 py-1 text-[12px] font-medium text-mute dark:border-[#afe3d0]/20"
					>
						{t('randomTopicGenerator.ui.levelMedium')}
					</span>
					<span
						id="rtg-badge-lens"
						class="hidden rounded-full border border-[#5EC4A3] bg-[#E6F7F1] px-3 py-1 text-[12px] font-semibold text-[#0f2e26] dark:border-[#afe3d0]/30 dark:bg-[#0f2e26] dark:text-[#afe3d0]"
					>
						{t('randomTopicGenerator.client.lensBadge', { lens: t('randomTopicGenerator.ui.lensStraight') })}
					</span>
				</div>

				<div class="flex items-center gap-2">
					<button
						type="button"
						id="rtg-btn-prep-toggle"
						aria-expanded="false"
						class="cursor-pointer rounded-full border border-[#0f2e26]/15 bg-canvas px-3 py-1 text-[12px] font-medium text-body transition-all hover:border-[#5EC4A3] hover:bg-[#E6F7F1] hover:text-[#0f2e26] dark:border-[#afe3d0]/20 dark:hover:border-[#afe3d0]/40 dark:hover:text-[#afe3d0]"
					>
						{t('randomTopicGenerator.ui.btnPrepFramework')}
					</button>
					<button
						type="button"
						id="rtg-btn-todays-topic"
						class="cursor-pointer rounded-full border border-[#0f2e26]/20 bg-[#0f2e26]/[0.05] px-3.5 py-1 text-[12px] font-semibold text-[#0f2e26] transition-all hover:bg-[#afe3d0] dark:border-[#afe3d0]/25 dark:bg-[#afe3d0]/10 dark:text-[#afe3d0] dark:hover:bg-[#afe3d0] dark:hover:text-[#0f2e26]"
					>
						{t('randomTopicGenerator.ui.btnTodaysTopic')}
					</button>
				</div>
			</div>

			<!-- Spotlight Body -->
			<div class="px-6 py-8 sm:px-8 sm:py-10">
				<!-- Optional Perspective Lens Framing Cue -->
				<p id="rtg-lens-instruction" class="mb-3 hidden text-[13px] font-semibold text-[#0F766E] dark:text-[#afe3d0]"></p>

				<!-- Large Crisp Topic Prompt Headline -->
				<blockquote
					id="rtg-topic-title"
					aria-live="polite"
					class="font-sans text-2xl leading-snug font-bold tracking-tight text-ink sm:text-3xl"
				>
					{initialTopic?.title}
				</blockquote>

				<!-- Angles & Talking Points Callout Panel -->
				<div class="mt-7 rounded-r-xl border border-[#0f2e26]/10 border-l-4 border-l-[#0f2e26] bg-[#0f2e26]/[0.03] p-5 sm:p-6 dark:border-[#afe3d0]/15 dark:border-l-[#afe3d0] dark:bg-[#afe3d0]/[0.05]">
					<div class="flex items-center justify-between gap-2">
						<p id="rtg-points-heading" class="text-[13px] font-semibold text-[#0f2e26] dark:text-[#afe3d0]">
							{t('randomTopicGenerator.client.talkingPointsHeading')}
						</p>
						<span id="rtg-seen-counter" class="rounded-full bg-[#0f2e26]/[0.06] px-2.5 py-0.5 text-[12px] font-medium text-mute tabular-nums dark:bg-white/[0.06]">
							{t('randomTopicGenerator.ui.initialSeenCounter')}
						</span>
					</div>
					<ul id="rtg-topic-points" class="mt-3 space-y-2.5 text-[14px] leading-[22px] text-body">
						{
							(initialTopic?.points ?? []).map((pt) => (
								<li class="flex items-start gap-2.5">
									<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#0f2e26] dark:bg-[#afe3d0]"></span>
									<span>{pt}</span>
								</li>
							))
						}
					</ul>
				</div>

				<!-- Collapsible PREP Structure Strip -->
				<div
					id="rtg-prep-strip"
					class="mt-5 hidden rounded-xl border border-[#7ED4B6] bg-[#E6F7F1]/70 p-5 dark:border-[#afe3d0]/25 dark:bg-[#0f2e26]/40"
				>
					<div class="mb-3 flex items-center justify-between">
						<span class="text-[12px] font-semibold text-[#0f2e26] dark:text-[#afe3d0]">
							{t('randomTopicGenerator.ui.prepTitle')}
						</span>
						<span class="text-[11px] font-medium text-mute">{t('randomTopicGenerator.ui.prepDuration')}</span>
					</div>
					<div class="grid grid-cols-1 gap-3 text-[13px] sm:grid-cols-4">
						{
							prepSteps.map((step) => (
								<div class="rounded-lg border border-[#0f2e26]/10 bg-canvas-elevated p-3 dark:border-[#afe3d0]/15">
									<strong class="block text-ink">{step.title}</strong>
									<span class="mt-0.5 block text-[12px] text-body">{step.desc}</span>
								</div>
							))
						}
					</div>
				</div>

				<!-- Primary Action Bar -->
				<div class="mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-[#0f2e26]/10 pt-5 dark:border-[#afe3d0]/15">
					<div class="flex flex-wrap items-center gap-2.5">
						<button
							type="button"
							id="rtg-btn-generate"
							class="inline-flex cursor-pointer items-center gap-2 rounded-xl bg-[#0f2e26] px-6 py-3 text-[14px] font-semibold text-[#afe3d0] shadow-sm transition hover:opacity-95 dark:bg-[#afe3d0] dark:text-[#0f2e26]"
						>
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
								<polyline points="7.5 4.21 12 6.81 16.5 4.21" />
								<polyline points="7.5 19.79 7.5 14.6 3 12" />
								<polyline points="21 12 16.5 14.6 16.5 19.79" />
								<polyline points="3.27 6.96 12 12.01 20.73 6.96" />
								<line x1="12" y1="22.08" x2="12" y2="12" />
							</svg>
							<span>{t('randomTopicGenerator.ui.btnGenerateNew')}</span>
						</button>

						<button
							type="button"
							id="rtg-btn-copy-single"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-[#0f2e26]/15 bg-canvas px-4 py-3 text-[13px] font-medium text-ink transition-all hover:border-[#5EC4A3] hover:bg-[#E6F7F1] hover:text-[#0f2e26] dark:border-[#afe3d0]/20 dark:hover:border-[#afe3d0]/40 dark:hover:bg-[#0f2e26]/40 dark:hover:text-[#afe3d0]"
						>
							<svg class="h-4 w-4 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
								<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
							</svg>
							<span id="rtg-copy-single-label">{t('randomTopicGenerator.ui.btnCopySingle')}</span>
						</button>

						<button
							type="button"
							id="rtg-btn-save-single"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-[#0f2e26]/15 bg-canvas px-4 py-3 text-[13px] font-medium text-ink transition-all hover:border-[#5EC4A3] hover:bg-[#E6F7F1] hover:text-[#0f2e26] dark:border-[#afe3d0]/20 dark:hover:border-[#afe3d0]/40 dark:hover:bg-[#0f2e26]/40 dark:hover:text-[#afe3d0]"
						>
							<svg class="h-4 w-4 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" />
							</svg>
							<span id="rtg-save-single-label">{t('randomTopicGenerator.ui.btnSaveSingle')}</span>
						</button>

						<button
							type="button"
							id="rtg-btn-copy-link"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-[#0f2e26]/15 bg-canvas px-4 py-3 text-[13px] font-medium text-ink transition-all hover:border-[#5EC4A3] hover:bg-[#E6F7F1] hover:text-[#0f2e26] dark:border-[#afe3d0]/20 dark:hover:border-[#afe3d0]/40 dark:hover:bg-[#0f2e26]/40 dark:hover:text-[#afe3d0]"
						>
							<svg class="h-4 w-4 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
