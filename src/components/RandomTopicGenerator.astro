		function getMatchingPool(): TopicRecord[] {
			return TOPICS.filter((item) => {
				if (currentMode !== 'All' && item.mode !== currentMode) return false;
				if (currentCategory !== 'All Categories' && item.category !== currentCategory) return false;
				if (currentLevel !== 'Any Level' && item.level !== currentLevel) return false;
				return true;
			});
		}

		function updatePoolMeta() {
			const pool = getMatchingPool();
			if (poolCountLabel) {
				poolCountLabel.textContent = `${pool.length} matching ${pool.length === 1 ? 'topic' : 'topics'}`;
			}
			if (seenCounter) {
				const seenInPool = pool.filter((t) => seenIds.has(t.id)).length;
				seenCounter.textContent = `${Math.max(1, seenInPool)} of ${pool.length} seen`;
			}
		}

		function pickNextTopic(excludeIds: Set<string> = new Set()): TopicRecord {
			const pool = getMatchingPool();
			if (pool.length === 0) {
				return TOPICS[0];
			}

			let candidates = pool.filter((t) => !excludeIds.has(t.id));
			if (noRepeats) {
				const unseen = candidates.filter((t) => !seenIds.has(t.id));
				if (unseen.length > 0) {
					candidates = unseen;
				} else {
					// Pool exhausted: reset seenIds for current pool so cycle starts fresh without immediate repeat
					pool.forEach((t) => seenIds.delete(t.id));
					candidates = pool.filter((t) => t.id !== currentTopic.id && !excludeIds.has(t.id));
					if (candidates.length === 0) candidates = pool;
				}
			} else {
				const different = candidates.filter((t) => t.id !== currentTopic.id);
				if (different.length > 0) candidates = different;
			}

			const chosen = candidates[Math.floor(Math.random() * candidates.length)];
			seenIds.add(chosen.id);
			return chosen;
		}

		function pickBatchTopics(count = 5): TopicRecord[] {
			const pool = getMatchingPool();
			if (pool.length === 0) return [];
			const targetCount = Math.min(count, pool.length);
			const chosenBatch: TopicRecord[] = [];
			const batchIds = new Set<string>();

			for (let i = 0; i < targetCount; i++) {
				const next = pickNextTopic(batchIds);
				chosenBatch.push(next);
				batchIds.add(next.id);
			}
			return chosenBatch;
		}

		function isTopicSaved(id: string): boolean {
			return savedTopics.some((s) => s.id === id);
		}

		function syncSaveButtonUI() {
			if (!saveSingleLabel || !btnSaveSingle) return;
			const saved = isTopicSaved(currentTopic.id);
			if (saved) {
				saveSingleLabel.textContent = 'Saved in Shortlist ✓';
				btnSaveSingle.className =
					'inline-flex cursor-pointer items-center gap-1.5 rounded-sm border border-[#5EC4A3] bg-[#E6F7F1] px-3.5 py-2.5 text-[13px] font-semibold text-[#0F766E] transition-colors dark:border-hairline dark:bg-canvas dark:text-ink';
			} else {
				saveSingleLabel.textContent = 'Save to Shortlist';
				btnSaveSingle.className =
					'inline-flex cursor-pointer items-center gap-1.5 rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft';
			}
		}

		function renderSingleTopic() {
			if (badgeMode) badgeMode.textContent = currentTopic.mode;
			if (badgeCategory) badgeCategory.textContent = currentTopic.category;
			if (badgeLevel) badgeLevel.textContent = currentTopic.level;

			if (badgeLens && lensInstruction) {
				if (currentLens === 'Straight') {
					badgeLens.classList.add('hidden');
					lensInstruction.classList.add('hidden');
					lensInstruction.textContent = '';
				} else {
					badgeLens.classList.remove('hidden');
					badgeLens.textContent = `Lens: ${currentLens}`;
					lensInstruction.classList.remove('hidden');
					lensInstruction.textContent = LENS_INSTRUCTIONS[currentLens] || '';
				}
			}

			if (topicTitle) {
				topicTitle.textContent = currentTopic.title;
			}

			if (pointsHeading) {
				pointsHeading.textContent =
					currentTopic.mode === 'Single-Word'
						? 'Creative association angles'
						: 'Angles & talking points';
			}

			if (topicPointsList) {
				topicPointsList.innerHTML = '';
				currentTopic.points.forEach((pt) => {
					const li = document.createElement('li');
					li.className = 'flex items-start gap-2';
					const dot = document.createElement('span');
					dot.className = 'mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#0D9488]';
					const text = document.createElement('span');
					text.textContent = pt;
					li.appendChild(dot);
					li.appendChild(text);
					topicPointsList.appendChild(li);
				});
			}

			syncSaveButtonUI();
			updatePoolMeta();
		}

		function renderBatchTopics() {
			if (!batchList) return;
			batchList.innerHTML = '';

			currentBatch.forEach((item, idx) => {
				const li = document.createElement('li');
				li.className =
					'flex flex-col justify-between gap-3 rounded-sm border border-hairline bg-canvas p-4 transition-colors hover:border-[#7ED4B6] sm:flex-row sm:items-center';

				const leftDiv = document.createElement('div');
				leftDiv.className = 'flex-1 cursor-pointer';
				leftDiv.addEventListener('click', () => {
					currentTopic = item;
					seenIds.add(item.id);
					setViewMode('single');
					renderSingleTopic();
				});

				const metaRow = document.createElement('div');
				metaRow.className = 'mb-1.5 flex flex-wrap items-center gap-1.5';

				const numSpan = document.createElement('span');
				numSpan.className = 'text-[12px] font-semibold text-mute tabular-nums';
				numSpan.textContent = `${idx + 1}.`;

				const modePill = document.createElement('span');
				modePill.className =
					'rounded-full border border-[#5EC4A3] bg-[#AFE3D0] px-2 py-0.5 text-[11px] font-semibold text-[#111827]';
				modePill.textContent = item.mode;

				const catPill = document.createElement('span');
				catPill.className =
					'rounded-full border border-hairline bg-canvas-elevated px-2 py-0.5 text-[11px] font-medium text-body';
				catPill.textContent = item.category;

				const lvlPill = document.createElement('span');
				lvlPill.className =
					'rounded-full border border-hairline bg-canvas-elevated px-2 py-0.5 text-[11px] font-medium text-mute';
				lvlPill.textContent = item.level;

				metaRow.appendChild(numSpan);
				metaRow.appendChild(modePill);
				metaRow.appendChild(catPill);
				metaRow.appendChild(lvlPill);

				const titleP = document.createElement('p');
				titleP.className = 'text-[15px] leading-[22px] font-semibold text-ink';
				titleP.textContent = item.title;

				leftDiv.appendChild(metaRow);
				leftDiv.appendChild(titleP);

				const actionsDiv = document.createElement('div');
				actionsDiv.className = 'flex shrink-0 items-center gap-2';

				const copyBtn = document.createElement('button');
				copyBtn.type = 'button';
				copyBtn.className =
					'cursor-pointer rounded-sm border border-hairline bg-canvas-elevated px-2.5 py-1.5 text-[12px] font-medium text-ink transition-colors hover:bg-hairline-soft';
				copyBtn.textContent = 'Copy';
				copyBtn.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(formatTopicForCopy(item));
						copyBtn.textContent = 'Copied';
						setTimeout(() => {
							copyBtn.textContent = 'Copy';
						}, 1200);
					} catch {}
				});

				const saveBtn = document.createElement('button');
				saveBtn.type = 'button';
				const updateRowSaveBtn = () => {
					const saved = isTopicSaved(item.id);
					saveBtn.textContent = saved ? 'Saved ✓' : 'Save';
					saveBtn.className = saved
						? 'cursor-pointer rounded-sm border border-[#5EC4A3] bg-[#E6F7F1] px-2.5 py-1.5 text-[12px] font-semibold text-[#0F766E] dark:border-hairline dark:bg-canvas dark:text-ink'
						: 'cursor-pointer rounded-sm border border-hairline bg-canvas-elevated px-2.5 py-1.5 text-[12px] font-medium text-ink transition-colors hover:bg-hairline-soft';
				};
				updateRowSaveBtn();

				saveBtn.addEventListener('click', () => {
					toggleSaveTopic(item);
					updateRowSaveBtn();
				});

				actionsDiv.appendChild(copyBtn);
				actionsDiv.appendChild(saveBtn);

				li.appendChild(leftDiv);
				li.appendChild(actionsDiv);
				batchList.appendChild(li);
			});

			updatePoolMeta();
		}

		function formatTopicForCopy(topic: TopicRecord): string {
			const lensLine =
				currentLens !== 'Straight' ? `\nPerspective Lens: ${currentLens}` : '';
			const pointsBlock = topic.points.map((p) => `• ${p}`).join('\n');
			return `${topic.title} [${topic.mode} · ${topic.category} · ${topic.level}]${lensLine}\n\nTalking Points:\n${pointsBlock}`;
		}

		function downloadTextFile(filename: string, content: string) {
			const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = filename;
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
			URL.revokeObjectURL(url);
		}

		// Shortlist Persistence
		function loadShortlist() {
			try {
				const raw = localStorage.getItem(SHORTLIST_STORAGE_KEY);
				if (raw) {
					const parsed = JSON.parse(raw);
					if (Array.isArray(parsed)) {
						savedTopics = parsed;
					}
				}
			} catch {}
		}

		function saveShortlist() {
			try {
				localStorage.setItem(SHORTLIST_STORAGE_KEY, JSON.stringify(savedTopics));
			} catch {}
		}

		function toggleSaveTopic(topic: TopicRecord) {
			const existingIdx = savedTopics.findIndex((s) => s.id === topic.id);
			if (existingIdx >= 0) {
				savedTopics.splice(existingIdx, 1);
				if (statusToast) statusToast.textContent = 'Removed topic from shortlist';
			} else {
				savedTopics.unshift({
					id: topic.id,
					mode: topic.mode,
					category: topic.category,
					level: topic.level,
					title: topic.title,
					points: [...topic.points],
				});
				if (statusToast) statusToast.textContent = 'Saved topic to shortlist';
			}
			saveShortlist();
			renderShortlist();
			syncSaveButtonUI();
		}

		function renderShortlist() {
			const count = savedTopics.length;
			if (shortlistCount) shortlistCount.textContent = `${count} saved`;
			if (btnCopyAllSaved) btnCopyAllSaved.disabled = count === 0;
			if (btnDownloadSaved) btnDownloadSaved.disabled = count === 0;

			if (count === 0) {
				shortlistEmpty?.classList.remove('hidden');
				shortlistItemsList?.classList.add('hidden');
				btnClearShortlist?.classList.add('hidden');
				if (shortlistItemsList) shortlistItemsList.innerHTML = '';
				return;
			}

			shortlistEmpty?.classList.add('hidden');
			shortlistItemsList?.classList.remove('hidden');
			btnClearShortlist?.classList.remove('hidden');

			if (shortlistItemsList) {
				shortlistItemsList.innerHTML = '';
				savedTopics.forEach((item, index) => {
					const li = document.createElement('li');
					li.className = 'rounded-sm border border-hairline bg-canvas p-3 text-[13px]';

					const topRow = document.createElement('div');
					topRow.className = 'mb-1 flex items-center justify-between gap-2';

					const badgeSpan = document.createElement('span');
					badgeSpan.className = 'text-[11px] font-medium text-mute';
					badgeSpan.textContent = `${item.mode} · ${item.category}`;

					const btnGroup = document.createElement('div');
					btnGroup.className = 'flex items-center gap-2';

					const copyBtn = document.createElement('button');
					copyBtn.type = 'button';
					copyBtn.className = 'cursor-pointer text-[11px] font-medium text-body hover:text-ink';
					copyBtn.textContent = 'Copy';
					copyBtn.addEventListener('click', async () => {
						try {
							const text = `${item.title}\n${(item.points || []).map((p) => `• ${p}`).join('\n')}`;
							await navigator.clipboard.writeText(text);
							copyBtn.textContent = 'Copied';
							setTimeout(() => {
								copyBtn.textContent = 'Copy';
							}, 1200);
						} catch {}
					});

					const removeBtn = document.createElement('button');
					removeBtn.type = 'button';
					removeBtn.setAttribute('aria-label', 'Remove saved topic');
					removeBtn.className =
						'cursor-pointer px-1 text-[14px] leading-none font-semibold text-mute hover:text-vercel-error';
					removeBtn.textContent = '×';
					removeBtn.addEventListener('click', () => {
						savedTopics.splice(index, 1);
						saveShortlist();
						renderShortlist();
						syncSaveButtonUI();
						if (viewMode === 'batch') renderBatchTopics();
					});

					btnGroup.appendChild(copyBtn);
					btnGroup.appendChild(removeBtn);
					topRow.appendChild(badgeSpan);
					topRow.appendChild(btnGroup);

					const titleP = document.createElement('p');
					titleP.className = 'cursor-pointer font-medium text-ink leading-[19px] hover:underline';
					titleP.textContent = item.title;
					titleP.addEventListener('click', () => {
						const match = TOPICS.find((t) => t.id === item.id);
						if (match) {
							currentTopic = match;
							setViewMode('single');
							renderSingleTopic();
						}
					});

					li.appendChild(topRow);
					li.appendChild(titleP);
					shortlistItemsList.appendChild(li);
				});
			}
		}

		function setViewMode(mode: 'single' | 'batch') {
			viewMode = mode;
			if (mode === 'single') {
				singlePanel?.classList.remove('hidden');
				batchPanel?.classList.add('hidden');
				btnViewSingle?.setAttribute('aria-pressed', 'true');
				btnViewBatch?.setAttribute('aria-pressed', 'false');
				if (btnViewSingle) {
					btnViewSingle.className =
						'cursor-pointer rounded-[4px] bg-[#AFE3D0] px-2.5 py-1 text-[12px] font-semibold text-[#111827] transition-colors';
				}
				if (btnViewBatch) {
					btnViewBatch.className =
						'cursor-pointer rounded-[4px] px-2.5 py-1 text-[12px] font-medium text-mute transition-colors hover:text-ink';
				}
			} else {
				singlePanel?.classList.add('hidden');
				batchPanel?.classList.remove('hidden');
				btnViewSingle?.setAttribute('aria-pressed', 'false');
				btnViewBatch?.setAttribute('aria-pressed', 'true');
				if (btnViewBatch) {
					btnViewBatch.className =
						'cursor-pointer rounded-[4px] bg-[#AFE3D0] px-2.5 py-1 text-[12px] font-semibold text-[#111827] transition-colors';
				}
				if (btnViewSingle) {
					btnViewSingle.className =
						'cursor-pointer rounded-[4px] px-2.5 py-1 text-[12px] font-medium text-mute transition-colors hover:text-ink';
				}
				if (currentBatch.length === 0) {
					currentBatch = pickBatchTopics(5);
				}
				renderBatchTopics();
			}
		}

		// Filter Events
		modePills.forEach((pill) => {
			pill.addEventListener('click', () => {
				const selected = pill.getAttribute('data-rtg-mode') || 'All';
				currentMode = selected;

				modePills.forEach((p) => {
					const active = p === pill;
					p.setAttribute('aria-selected', active ? 'true' : 'false');
					p.className = active
						? 'rtg-mode-pill cursor-pointer rounded-sm border border-[#5EC4A3] bg-[#AFE3D0] px-3.5 py-1.5 text-[13px] font-semibold text-[#111827] transition-colors'
						: 'rtg-mode-pill cursor-pointer rounded-sm border border-hairline bg-canvas px-3.5 py-1.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft';
				});

				if (viewMode === 'single') {
					currentTopic = pickNextTopic();
					renderSingleTopic();
				} else {
					currentBatch = pickBatchTopics(5);
					renderBatchTopics();
				}
			});
		});

		selectCategory?.addEventListener('change', () => {
			currentCategory = selectCategory.value;
			if (viewMode === 'single') {
				currentTopic = pickNextTopic();
				renderSingleTopic();
			} else {
				currentBatch = pickBatchTopics(5);
				renderBatchTopics();
			}
		});

		selectLevel?.addEventListener('change', () => {
			currentLevel = selectLevel.value;
			if (viewMode === 'single') {
				currentTopic = pickNextTopic();
				renderSingleTopic();
			} else {
				currentBatch = pickBatchTopics(5);
				renderBatchTopics();
			}
		});

		selectLens?.addEventListener('change', () => {
			currentLens = selectLens.value;
			renderSingleTopic();
		});

		checkboxNoRepeats?.addEventListener('change', () => {
			noRepeats = checkboxNoRepeats.checked;
			updatePoolMeta();
		});

		btnViewSingle?.addEventListener('click', () => setViewMode('single'));
		btnViewBatch?.addEventListener('click', () => setViewMode('batch'));

		// PREP Toggle
		btnPrepToggle?.addEventListener('click', () => {
			if (!prepStrip) return;
			const isHidden = prepStrip.classList.contains('hidden');
			if (isHidden) {
				prepStrip.classList.remove('hidden');
				btnPrepToggle.setAttribute('aria-expanded', 'true');
				btnPrepToggle.className =
					'cursor-pointer rounded-full border border-[#5EC4A3] bg-[#AFE3D0] px-2.5 py-1 text-[12px] font-semibold text-[#111827] transition-colors';
			} else {
				prepStrip.classList.add('hidden');
				btnPrepToggle.setAttribute('aria-expanded', 'false');
				btnPrepToggle.className =
					'cursor-pointer rounded-full border border-hairline bg-canvas px-2.5 py-1 text-[12px] font-medium text-body transition-colors hover:border-[#5EC4A3] hover:text-ink';
			}
		});

		// Today's Topic deterministic daily seed
		btnTodaysTopic?.addEventListener('click', () => {
			const now = new Date();
			const daySeed =
				now.getFullYear() * 10000 + (now.getMonth() + 1) * 100 + now.getDate();
			const pool = getMatchingPool();
			const list = pool.length > 0 ? pool : TOPICS;
			const index = daySeed % list.length;
			currentTopic = list[index];
			seenIds.add(currentTopic.id);
			setViewMode('single');
			renderSingleTopic();
			if (statusToast) {
				statusToast.textContent = `Loaded Today's Topic (${now.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })})`;
			}
		});

		// Generate New Topic (Single)
		btnGenerate?.addEventListener('click', () => {
			currentTopic = pickNextTopic();
			renderSingleTopic();
			if (statusToast) {
				statusToast.textContent = `Generated new ${currentTopic.mode} topic`;
			}
		});

		// Spacebar shortcut when not typing in an input/textarea/select
		window.addEventListener('keydown', (e) => {
			if (e.code !== 'Space') return;
			const activeEl = document.activeElement;
			const tag = activeEl?.tagName.toLowerCase();
			if (
				tag === 'input' ||
				tag === 'textarea' ||
				tag === 'select' ||
				tag === 'button' ||
				(activeEl as HTMLElement | null)?.isContentEditable
			) {
				return;
			}
			const workspace = document.getElementById('random-topic-workspace');
			if (!workspace) return;
			e.preventDefault();
			if (viewMode === 'single') {
				currentTopic = pickNextTopic();
				renderSingleTopic();
			} else {
				currentBatch = pickBatchTopics(5);
				renderBatchTopics();
			}
		});

		// Copy Single Topic + Points
		btnCopySingle?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(formatTopicForCopy(currentTopic));
				if (copySingleLabel) copySingleLabel.textContent = 'Copied!';
				if (statusToast) statusToast.textContent = 'Copied topic & talking points';
				setTimeout(() => {
					if (copySingleLabel) copySingleLabel.textContent = 'Copy Topic + Points';
				}, 1400);
			} catch {}
		});

		// Save Single Topic
		btnSaveSingle?.addEventListener('click', () => {
			toggleSaveTopic(currentTopic);
		});

		// Copy Share Link
		btnCopyLink?.addEventListener('click', async () => {
			try {
				const url = new URL(window.location.href);
				url.searchParams.set('topic', currentTopic.id);
				await navigator.clipboard.writeText(url.toString());
				if (copyLinkLabel) copyLinkLabel.textContent = 'Link Copied!';
				if (statusToast) statusToast.textContent = 'Shareable topic link copied';
				setTimeout(() => {
					if (copyLinkLabel) copyLinkLabel.textContent = 'Copy Link';
				}, 1400);
			} catch {}
		});

		// Batch Actions
		btnGenerateBatch?.addEventListener('click', () => {
			currentBatch = pickBatchTopics(5);
			renderBatchTopics();
			if (batchToast) batchToast.textContent = 'Generated 5 new topics';
		});

		btnCopyBatch?.addEventListener('click', async () => {
			if (currentBatch.length === 0) return;
			const formatted = currentBatch
				.map((t, idx) => `${idx + 1}. ${formatTopicForCopy(t)}`)
				.join('\n\n---\n\n');
			try {
				await navigator.clipboard.writeText(formatted);
				const prev = btnCopyBatch.textContent;
				btnCopyBatch.textContent = 'Copied All 5!';
				setTimeout(() => {
					btnCopyBatch.textContent = prev;
				}, 1400);
			} catch {}
		});

		btnDownloadBatch?.addEventListener('click', () => {
			if (currentBatch.length === 0) return;
			const formatted = currentBatch
				.map((t, idx) => `${idx + 1}. ${formatTopicForCopy(t)}`)
				.join('\n\n---\n\n');
			downloadTextFile('wordora-random-topics-batch.txt', formatted);
		});

		// Shortlist Actions
		btnClearShortlist?.addEventListener('click', () => {
			savedTopics = [];
			saveShortlist();
			renderShortlist();
			syncSaveButtonUI();
			if (viewMode === 'batch') renderBatchTopics();
		});

		btnCopyAllSaved?.addEventListener('click', async () => {
			if (savedTopics.length === 0) return;
			const text = savedTopics
				.map(
					(t, idx) =>
						`${idx + 1}. [${t.mode} · ${t.category}] ${t.title}\n${(t.points || []).map((p) => `   • ${p}`).join('\n')}`
				)
				.join('\n\n');
			try {
				await navigator.clipboard.writeText(text);
				const prev = btnCopyAllSaved.textContent;
				btnCopyAllSaved.textContent = 'Copied All!';
				setTimeout(() => {
					btnCopyAllSaved.textContent = prev;
				}, 1400);
			} catch {}
		});

		btnDownloadSaved?.addEventListener('click', () => {
			if (savedTopics.length === 0) return;
			const text = savedTopics
				.map(
					(t, idx) =>
						`${idx + 1}. [${t.mode} · ${t.category} · ${t.level}] ${t.title}\n${(t.points || []).map((p) => `   • ${p}`).join('\n')}`
				)
				.join('\n\n');
			downloadTextFile('wordora-shortlisted-topics.txt', text);
		});

		// Practice Timer Controls
		function formatTimer(seconds: number): string {
			const mins = Math.floor(seconds / 60);
			const secs = seconds % 60;
			return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
		}

		function updateTimerUI() {
			if (timerDisplay) timerDisplay.textContent = formatTimer(remainingSec);
		}

		function stopTimerInterval() {
			if (timerInterval !== null) {
				window.clearInterval(timerInterval);
				timerInterval = null;
			}
		}

		timerPresets.forEach((btn) => {
			btn.addEventListener('click', () => {
				const sec = parseInt(btn.getAttribute('data-rtg-timer') || '60', 10);
				stopTimerInterval();
				selectedDurationSec = sec;
				remainingSec = sec;
				updateTimerUI();
				if (btnTimerStart) btnTimerStart.textContent = 'Start';
				if (timerStateLabel) timerStateLabel.textContent = 'Ready';

				timerPresets.forEach((b) => {
					const active = b === btn;
					b.className = active
						? 'rtg-timer-preset cursor-pointer rounded-sm border border-[#5EC4A3] bg-[#AFE3D0] px-2 py-1 text-[12px] font-semibold text-[#111827] transition-colors'
						: 'rtg-timer-preset cursor-pointer rounded-sm border border-hairline bg-canvas px-2 py-1 text-[12px] font-medium text-mute transition-colors hover:text-ink';
				});
			});
		});

		btnTimerStart?.addEventListener('click', () => {
			if (timerInterval !== null) {
				// Pause
				stopTimerInterval();
				btnTimerStart.textContent = 'Resume';
				if (timerStateLabel) timerStateLabel.textContent = 'Paused';
			} else {
				if (remainingSec <= 0) {
					remainingSec = selectedDurationSec;
				}
				btnTimerStart.textContent = 'Pause';
				if (timerStateLabel) timerStateLabel.textContent = 'Running';
				timerInterval = window.setInterval(() => {
					remainingSec = Math.max(0, remainingSec - 1);
					updateTimerUI();
					if (remainingSec <= 0) {
						stopTimerInterval();
						if (btnTimerStart) btnTimerStart.textContent = 'Start';
						if (timerStateLabel) timerStateLabel.textContent = "Time's up!";
					}
				}, 1000);
			}
		});

		btnTimerReset?.addEventListener('click', () => {
			stopTimerInterval();
			remainingSec = selectedDurationSec;
			updateTimerUI();
			if (btnTimerStart) btnTimerStart.textContent = 'Start';
			if (timerStateLabel) timerStateLabel.textContent = 'Ready';
		});

		// Quick Notes Scratchpad
		function updateNotesWordCount() {
			if (!notesInput || !notesWordcount) return;
			const raw = notesInput.value.trim();
			const words = raw ? raw.split(/\s+/).length : 0;
			notesWordcount.textContent = `${words} ${words === 1 ? 'word' : 'words'}`;
		}

		try {
			const savedNotes = localStorage.getItem(NOTES_STORAGE_KEY);
			if (savedNotes && notesInput) {
				notesInput.value = savedNotes;
				updateNotesWordCount();
			}
		} catch {}

		notesInput?.addEventListener('input', () => {
			updateNotesWordCount();
			try {
				localStorage.setItem(NOTES_STORAGE_KEY, notesInput.value);
			} catch {}
		});

		btnNotesClear?.addEventListener('click', () => {
			if (!notesInput) return;
			notesInput.value = '';
			updateNotesWordCount();
			try {
				localStorage.removeItem(NOTES_STORAGE_KEY);
			} catch {}
		});

		// Check URL query parameter ?topic=id
		try {
			const params = new URLSearchParams(window.location.search);
			const topicParam = params.get('topic');
			if (topicParam) {
				const found = TOPICS.find((t) => t.id === topicParam);
				if (found) {
					currentTopic = found;
				}
			}
		} catch {}

		seenIds.add(currentTopic.id);
		loadShortlist();
		renderSingleTopic();
		renderShortlist();
	}

	initRandomTopicGenerator();
</script>
