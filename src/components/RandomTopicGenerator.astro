---
import { getToolById } from '../config/site';

const wordsToPagesTool = getToolById('words-to-pages');
const typingSpeedTool = getToolById('typing-speed-test');
const speechTimeTool = getToolById('speech-time-calculator');
---

<section
	id="random-topic-workspace"
	aria-label="Random Topic Generator Workspace"
	class="mx-auto max-w-[1200px] px-4 pt-4 pb-12 sm:px-6"
>
	<!-- 1. Clean Top Control Strip (Single Unified Filter Card) -->
	<div class="whisper-shadow mb-6 rounded-md border border-hairline bg-canvas-elevated p-4 sm:p-5">
		<!-- Row 1: Purpose Mode Pills -->
		<div class="flex flex-wrap items-center gap-1.5 border-b border-hairline pb-3.5" role="tablist" aria-label="Topic purpose modes">
			<button
				type="button"
				role="tab"
				data-rtg-mode="All"
				aria-selected="true"
				class="rtg-mode-pill cursor-pointer rounded-sm border border-[#5EC4A3] bg-[#AFE3D0] px-3.5 py-1.5 text-[13px] font-semibold text-[#111827] transition-colors"
			>
				All
			</button>
			<button
				type="button"
				role="tab"
				data-rtg-mode="Essay & Academic"
				aria-selected="false"
				class="rtg-mode-pill cursor-pointer rounded-sm border border-hairline bg-canvas px-3.5 py-1.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
			>
				Essay &amp; Academic
			</button>
			<button
				type="button"
				role="tab"
				data-rtg-mode="Speech & Debate"
				aria-selected="false"
				class="rtg-mode-pill cursor-pointer rounded-sm border border-hairline bg-canvas px-3.5 py-1.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
			>
				Speech &amp; Debate
			</button>
			<button
				type="button"
				role="tab"
				data-rtg-mode="Conversation & Icebreakers"
				aria-selected="false"
				class="rtg-mode-pill cursor-pointer rounded-sm border border-hairline bg-canvas px-3.5 py-1.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
			>
				Conversation &amp; Icebreakers
			</button>
			<button
				type="button"
				role="tab"
				data-rtg-mode="Creative Writing"
				aria-selected="false"
				class="rtg-mode-pill cursor-pointer rounded-sm border border-hairline bg-canvas px-3.5 py-1.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
			>
				Creative Writing
			</button>
			<button
				type="button"
				role="tab"
				data-rtg-mode="Single-Word"
				aria-selected="false"
				class="rtg-mode-pill cursor-pointer rounded-sm border border-hairline bg-canvas px-3.5 py-1.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
			>
				Single-Word
			</button>
		</div>

		<!-- Row 2: Compact Inline Dropdowns & View Toggle -->
		<div class="mt-3.5 flex flex-wrap items-center justify-between gap-3">
			<div class="flex flex-wrap items-center gap-2.5">
				<!-- Category Select -->
				<div class="flex items-center gap-1.5">
					<label for="rtg-select-category" class="text-[12px] font-medium text-mute">Category</label>
					<select
						id="rtg-select-category"
						class="cursor-pointer rounded-sm border border-hairline bg-canvas px-2.5 py-1.5 text-[13px] font-medium text-ink focus:border-[#0D9488] focus:outline-none"
					>
						<option value="All Categories">All Categories</option>
						<option value="Technology & AI">Technology &amp; AI</option>
						<option value="Science & Health">Science &amp; Health</option>
						<option value="Psychology & Philosophy">Psychology &amp; Philosophy</option>
						<option value="Business & Career">Business &amp; Career</option>
						<option value="Education & Society">Education &amp; Society</option>
						<option value="Culture & History">Culture &amp; History</option>
						<option value="Fun & Random">Fun &amp; Random</option>
					</select>
				</div>

				<!-- Level Select -->
				<div class="flex items-center gap-1.5">
					<label for="rtg-select-level" class="text-[12px] font-medium text-mute">Level</label>
					<select
						id="rtg-select-level"
						class="cursor-pointer rounded-sm border border-hairline bg-canvas px-2.5 py-1.5 text-[13px] font-medium text-ink focus:border-[#0D9488] focus:outline-none"
					>
						<option value="Any Level">Any Level</option>
						<option value="Easy">Easy</option>
						<option value="Medium">Medium</option>
						<option value="Hard">Hard</option>
					</select>
				</div>

				<!-- Perspective Lens Select -->
				<div class="flex items-center gap-1.5">
					<label for="rtg-select-lens" class="text-[12px] font-medium text-mute">Lens</label>
					<select
						id="rtg-select-lens"
						class="cursor-pointer rounded-sm border border-hairline bg-canvas px-2.5 py-1.5 text-[13px] font-medium text-ink focus:border-[#0D9488] focus:outline-none"
					>
						<option value="Straight">Straight</option>
						<option value="Devil's Advocate">Devil's Advocate</option>
						<option value="ELI5 (Simple)">ELI5 (Simple)</option>
						<option value="Pitch It">Pitch It</option>
						<option value="Storytime">Storytime</option>
					</select>
				</div>
			</div>

			<!-- Right Controls: View Mode Toggle + No Repeats + Pool Count -->
			<div class="flex flex-wrap items-center gap-3">
				<label class="inline-flex cursor-pointer items-center gap-1.5 text-[12px] font-medium text-body select-none">
					<input
						type="checkbox"
						id="rtg-no-repeats"
						checked
						class="h-3.5 w-3.5 cursor-pointer rounded border-hairline accent-[#0D9488]"
					/>
					<span>No Repeats</span>
					<span id="rtg-pool-count" class="rounded-full border border-hairline bg-canvas px-2 py-0.5 text-[11px] font-medium text-mute tabular-nums">
						140 matching topics
					</span>
				</label>

				<div class="inline-flex rounded-sm border border-hairline bg-canvas p-0.5" role="group" aria-label="View mode">
					<button
						type="button"
						id="rtg-view-single"
						aria-pressed="true"
						class="cursor-pointer rounded-[4px] bg-[#AFE3D0] px-2.5 py-1 text-[12px] font-semibold text-[#111827] transition-colors"
					>
						Single Focus
					</button>
					<button
						type="button"
						id="rtg-view-batch"
						aria-pressed="false"
						class="cursor-pointer rounded-[4px] px-2.5 py-1 text-[12px] font-medium text-mute transition-colors hover:text-ink"
					>
						Batch (5 Topics)
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- 2. Center-Stage Topic Spotlight Card -->
	<div class="whisper-shadow rounded-md border border-hairline bg-canvas-elevated">
		<!-- SINGLE FOCUS MODE -->
		<div id="rtg-single-panel">
			<!-- Top Meta Strip -->
			<div class="flex flex-wrap items-center justify-between gap-2 border-b border-hairline px-5 py-3.5 sm:px-7">
				<div class="flex flex-wrap items-center gap-2">
					<span
						id="rtg-badge-mode"
						class="rounded-full border border-[#5EC4A3] bg-[#AFE3D0] px-3 py-0.5 text-[12px] font-semibold text-[#111827]"
					>
						Essay &amp; Academic
					</span>
					<span
						id="rtg-badge-category"
						class="rounded-full border border-hairline bg-canvas px-2.5 py-0.5 text-[12px] font-medium text-body"
					>
						Education &amp; Society
					</span>
					<span
						id="rtg-badge-level"
						class="rounded-full border border-hairline bg-canvas px-2.5 py-0.5 text-[12px] font-medium text-mute"
					>
						Medium
					</span>
					<span
						id="rtg-badge-lens"
						class="hidden rounded-full border border-[#5EC4A3] bg-[#E6F7F1] px-2.5 py-0.5 text-[12px] font-medium text-[#0F766E] dark:border-hairline dark:bg-canvas dark:text-ink"
					>
						Lens: Straight
					</span>
				</div>

				<div class="flex items-center gap-2">
					<button
						type="button"
						id="rtg-btn-prep-toggle"
						aria-expanded="false"
						class="cursor-pointer rounded-full border border-hairline bg-canvas px-2.5 py-1 text-[12px] font-medium text-body transition-colors hover:border-[#5EC4A3] hover:text-ink"
					>
						PREP Framework
					</button>
					<button
						type="button"
						id="rtg-btn-todays-topic"
						class="cursor-pointer rounded-full border border-hairline bg-canvas px-3 py-1 text-[12px] font-medium text-ink transition-colors hover:bg-hairline-soft"
					>
						Today's Topic
					</button>
				</div>
			</div>

			<!-- Spotlight Body -->
			<div class="px-5 py-7 sm:px-7 sm:py-9">
				<!-- Optional Perspective Lens Framing Cue -->
				<p id="rtg-lens-instruction" class="mb-2.5 hidden text-[13px] font-medium text-[#0F766E] dark:text-[#AFE3D0]"></p>

				<!-- Large Crisp Topic Prompt Headline -->
				<blockquote
					id="rtg-topic-title"
					aria-live="polite"
					class="font-sans text-2xl leading-[1.3] font-bold tracking-[-0.5px] text-ink sm:text-3xl sm:leading-[1.28]"
				>
					Should universities evaluate students primarily through long-form research projects rather than timed examinations?
				</blockquote>

				<!-- Angles & Talking Points Box -->
				<div class="mt-6 rounded-sm border border-hairline bg-canvas p-4 sm:p-5">
					<div class="flex items-center justify-between gap-2">
						<p id="rtg-points-heading" class="text-[13px] font-semibold text-ink">
							Angles &amp; talking points
						</p>
						<span id="rtg-seen-counter" class="text-[12px] text-mute tabular-nums">
							1 of 140 seen
						</span>
					</div>
					<ul id="rtg-topic-points" class="mt-2.5 space-y-2 text-[14px] leading-[22px] text-body">
						<li class="flex items-start gap-2">
							<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#0D9488]"></span>
							<span>Compare how timed exams measure short-term recall under pressure versus how extended research tests synthesis and revision.</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#0D9488]"></span>
							<span>Address academic integrity challenges in an era of generative AI and how oral defenses could verify original work.</span>
						</li>
						<li class="flex items-start gap-2">
							<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#0D9488]"></span>
							<span>Consider whether high-stakes professions like medicine and aviation still require rapid, unassisted recall under time constraints.</span>
						</li>
					</ul>
				</div>

				<!-- Collapsible PREP Structure Strip -->
				<div
					id="rtg-prep-strip"
					class="mt-4 hidden rounded-sm border border-[#7ED4B6] bg-[#E6F7F1]/60 p-4 dark:border-hairline dark:bg-canvas"
				>
					<div class="mb-2 flex items-center justify-between">
						<span class="text-[12px] font-semibold text-ink">
							PREP Speaking &amp; Essay Structure (Point · Reason · Example · Point)
						</span>
						<span class="text-[11px] text-mute">60–90 sec framework</span>
					</div>
					<div class="grid grid-cols-1 gap-2.5 text-[13px] sm:grid-cols-4">
						<div class="rounded-sm border border-hairline bg-canvas-elevated p-2.5">
							<strong class="block text-ink">1. Point</strong>
							<span class="text-[12px] text-body">State your core thesis or direct answer in one clear sentence.</span>
						</div>
						<div class="rounded-sm border border-hairline bg-canvas-elevated p-2.5">
							<strong class="block text-ink">2. Reason</strong>
							<span class="text-[12px] text-body">Explain the primary cause, mechanism, or principle behind your claim.</span>
						</div>
						<div class="rounded-sm border border-hairline bg-canvas-elevated p-2.5">
							<strong class="block text-ink">3. Example</strong>
							<span class="text-[12px] text-body">Anchor your argument with a concrete story, case study, or statistic.</span>
						</div>
						<div class="rounded-sm border border-hairline bg-canvas-elevated p-2.5">
							<strong class="block text-ink">4. Point</strong>
							<span class="text-[12px] text-body">Restate your conclusion so the audience leaves with a memorable takeaway.</span>
						</div>
					</div>
				</div>

				<!-- Primary Action Bar -->
				<div class="mt-6 flex flex-wrap items-center justify-between gap-3">
					<div class="flex flex-wrap items-center gap-2.5">
						<button
							type="button"
							id="rtg-btn-generate"
							class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-[#5EC4A3] bg-[#AFE3D0] px-4 py-2.5 text-[14px] font-semibold text-[#111827] transition-opacity hover:opacity-90"
						>
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
								<polyline points="7.5 4.21 12 6.81 16.5 4.21" />
								<polyline points="7.5 19.79 7.5 14.6 3 12" />
								<polyline points="21 12 16.5 14.6 16.5 19.79" />
								<polyline points="3.27 6.96 12 12.01 20.73 6.96" />
								<line x1="12" y1="22.08" x2="12" y2="12" />
							</svg>
							<span>Generate New Topic</span>
						</button>

						<button
							type="button"
							id="rtg-btn-copy-single"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
						>
							<svg class="h-4 w-4 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
								<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
							</svg>
							<span id="rtg-copy-single-label">Copy Topic + Points</span>
						</button>

						<button
							type="button"
							id="rtg-btn-save-single"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
						>
							<svg class="h-4 w-4 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z" />
							</svg>
							<span id="rtg-save-single-label">Save to Shortlist</span>
						</button>

						<button
							type="button"
							id="rtg-btn-copy-link"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
						>
							<svg class="h-4 w-4 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
								<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
							</svg>
							<span id="rtg-copy-link-label">Copy Link</span>
						</button>
					</div>

					<span id="rtg-status-toast" class="text-[12px] text-mute">
						Press <kbd class="rounded border border-hairline bg-canvas px-1.5 py-0.5 text-[11px] font-medium text-ink">Space</kbd> for next topic
					</span>
				</div>
			</div>
		</div>

		<!-- BATCH (5 TOPICS) MODE -->
		<div id="rtg-batch-panel" class="hidden">
			<div class="flex flex-wrap items-center justify-between gap-2 border-b border-hairline px-5 py-3.5 sm:px-7">
				<div class="flex items-center gap-2">
					<span class="rounded-full border border-[#5EC4A3] bg-[#AFE3D0] px-3 py-0.5 text-[12px] font-semibold text-[#111827]">
						Batch View (5 Topics)
					</span>
					<span class="text-[12px] text-mute">
						Click any topic row to open its full talking points in Single Focus
					</span>
				</div>
			</div>

			<div class="p-5 sm:p-7">
				<ul id="rtg-batch-list" class="space-y-3" aria-label="Batch generated topics"></ul>

				<div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-hairline pt-4">
					<div class="flex flex-wrap items-center gap-2.5">
						<button
							type="button"
							id="rtg-btn-generate-batch"
							class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-[#5EC4A3] bg-[#AFE3D0] px-4 py-2.5 text-[14px] font-semibold text-[#111827] transition-opacity hover:opacity-90"
						>
							Generate 5 New
						</button>
						<button
							type="button"
							id="rtg-btn-copy-batch"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
						>
							Copy All 5
						</button>
						<button
							type="button"
							id="rtg-btn-download-batch"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-sm border border-hairline bg-canvas px-3.5 py-2.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
						>
							Download .txt
						</button>
					</div>
					<span id="rtg-batch-toast" class="text-[12px] text-mute">
						Showing 5 random topics from current filters
					</span>
				</div>
			</div>
		</div>
	</div>

	<!-- 3. Balanced 2-Column Bottom Utility Dock -->
	<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
		<!-- Left Card: Practice Timer & Quick Notes -->
		<div class="whisper-shadow flex flex-col justify-between rounded-md border border-hairline bg-canvas-elevated p-5">
			<div>
				<div class="flex flex-wrap items-center justify-between gap-2 border-b border-hairline pb-3.5">
					<h2 class="text-[16px] font-semibold tracking-[-0.3px] text-ink">
						Practice Timer &amp; Quick Notes
					</h2>
					<div class="flex items-center gap-1" role="group" aria-label="Timer presets">
						<button
							type="button"
							data-rtg-timer="30"
							class="rtg-timer-preset cursor-pointer rounded-sm border border-hairline bg-canvas px-2 py-1 text-[12px] font-medium text-mute transition-colors hover:text-ink"
						>
							30s Prep
						</button>
						<button
							type="button"
							data-rtg-timer="60"
							class="rtg-timer-preset cursor-pointer rounded-sm border border-[#5EC4A3] bg-[#AFE3D0] px-2 py-1 text-[12px] font-semibold text-[#111827] transition-colors"
						>
							1 min
						</button>
						<button
							type="button"
							data-rtg-timer="120"
							class="rtg-timer-preset cursor-pointer rounded-sm border border-hairline bg-canvas px-2 py-1 text-[12px] font-medium text-mute transition-colors hover:text-ink"
						>
							2 min
						</button>
						<button
							type="button"
							data-rtg-timer="300"
							class="rtg-timer-preset cursor-pointer rounded-sm border border-hairline bg-canvas px-2 py-1 text-[12px] font-medium text-mute transition-colors hover:text-ink"
						>
							5 min
						</button>
					</div>
				</div>

				<!-- Timer Bar -->
				<div class="mt-4 flex items-center justify-between rounded-sm border border-hairline bg-canvas px-4 py-3">
					<div class="flex items-baseline gap-2.5">
						<span
							id="rtg-timer-display"
							class="text-2xl font-bold tracking-tight text-ink tabular-nums sm:text-3xl"
						>
							01:00
						</span>
						<span id="rtg-timer-state" class="text-[12px] font-medium text-mute">
							Ready
						</span>
					</div>
					<div class="flex items-center gap-2">
						<button
							type="button"
							id="rtg-timer-start"
							class="cursor-pointer rounded-sm border border-[#5EC4A3] bg-[#AFE3D0] px-3.5 py-1.5 text-[13px] font-semibold text-[#111827] transition-opacity hover:opacity-90"
						>
							Start
						</button>
						<button
							type="button"
							id="rtg-timer-reset"
							class="cursor-pointer rounded-sm border border-hairline bg-canvas-elevated px-3 py-1.5 text-[13px] font-medium text-ink transition-colors hover:bg-hairline-soft"
						>
							Reset
						</button>
					</div>
				</div>

				<!-- Minimal Quick Notes Scratchpad -->
				<div class="mt-4">
					<div class="mb-1.5 flex items-center justify-between">
						<label for="rtg-notes-input" class="text-[12px] font-medium text-body">
							Quick outline &amp; opening hook scratchpad
						</label>
						<span id="rtg-notes-wordcount" class="text-[12px] text-mute tabular-nums">
							0 words
						</span>
					</div>
					<textarea
						id="rtg-notes-input"
						rows="4"
						placeholder="Jot down your opening hook or thesis..."
						class="w-full resize-y rounded-sm border border-hairline bg-canvas p-3 text-[13px] leading-[20px] text-ink placeholder:text-mute focus:border-[#0D9488] focus:outline-none"
					></textarea>
				</div>
			</div>

			<div class="mt-3 flex items-center justify-between border-t border-hairline pt-3 text-[12px] text-mute">
				<span>Notes auto-save locally in your browser</span>
				<button
					type="button"
					id="rtg-notes-clear"
					class="cursor-pointer font-medium text-mute transition-colors hover:text-ink"
				>
					Clear notes
				</button>
			</div>
		</div>

