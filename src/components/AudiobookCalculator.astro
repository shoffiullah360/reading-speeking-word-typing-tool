<script>
	function initAudiobookCalculator() {
		const NARRATION_WPM = 155; // Standard audiobook narration rate (~155 WPM / ~9,300 words per hour)
		const WORDS_PER_PAGE = 275; // Standard trade book page (~275 words/page)
		const SILENT_WPM = 238;

		const DEFAULTS = {
			hours: 0,
			minutes: 0,
			seconds: 0,
			words: 0,
			speed: 1.0,
			dailyMinutes: 0,
			targetDays: 0,
			totalHours: 0,
			totalMinutes: 0,
			totalSeconds: 0,
			listenedHours: 0,
			listenedMinutes: 0,
			listenedSeconds: 0,
			remainingHours: 0,
			remainingMinutes: 0,
			remainingSeconds: 0,
			pctCompleted: 0,
		};

		type Mode = 'length' | 'words' | 'remaining';

		let mode: Mode = 'length';
		let playbackSpeed: number = DEFAULTS.speed;

		const el = <T extends HTMLElement>(id: string): T | null =>
			document.getElementById(id) as T | null;

		// Mode tabs & actions
		const modeBtns = document.querySelectorAll<HTMLButtonElement>('.ab-mode-btn');
		const panelLength = el<HTMLElement>('ab-panel-length');
		const panelWords = el<HTMLElement>('ab-panel-words');
		const panelRemaining = el<HTMLElement>('ab-panel-remaining');
		const btnReset = el<HTMLButtonElement>('ab-btn-reset');
		const btnCopyResult = el<HTMLButtonElement>('ab-btn-copy-result');
		const btnCopyLink = el<HTMLButtonElement>('ab-btn-copy-link');

		// Length inputs
		const hoursInput = el<HTMLInputElement>('ab-hours-input');
		const minutesInput = el<HTMLInputElement>('ab-minutes-input');
		const secondsInput = el<HTMLInputElement>('ab-seconds-input');
		const wordsInput = el<HTMLInputElement>('ab-words-input');

		// Remaining progress inputs
		const totalHoursInput = el<HTMLInputElement>('ab-total-hours');
		const totalMinutesInput = el<HTMLInputElement>('ab-total-minutes');
		const totalSecondsInput = el<HTMLInputElement>('ab-total-seconds');
		const listenedHoursInput = el<HTMLInputElement>('ab-listened-hours');
		const listenedMinutesInput = el<HTMLInputElement>('ab-listened-minutes');
		const listenedSecondsInput = el<HTMLInputElement>('ab-listened-seconds');
		const remainingHoursInput = el<HTMLInputElement>('ab-remaining-hours');
		const remainingMinutesInput = el<HTMLInputElement>('ab-remaining-minutes');
		const remainingSecondsInput = el<HTMLInputElement>('ab-remaining-seconds');
		const pctCompletedInput = el<HTMLInputElement>('ab-pct-completed-input');
		const pctCompletedSlider = el<HTMLInputElement>('ab-pct-completed-slider');
		const pctRemainingBadge = el<HTMLElement>('ab-pct-remaining-badge');
		const pctPresetBtns = document.querySelectorAll<HTMLButtonElement>('.ab-pct-preset');
		const progressPct = el<HTMLElement>('ab-progress-pct');
		const progressTrack = el<HTMLElement>('ab-progress-track');
		const progressFill = el<HTMLElement>('ab-progress-fill');
		const progressListened = el<HTMLElement>('ab-progress-listened');
		const progressRemaining = el<HTMLElement>('ab-progress-remaining');

		// Presets & speed controls
		const durationPresetBtns = document.querySelectorAll<HTMLButtonElement>('.ab-duration-preset');
		const wordsPresetBtns = document.querySelectorAll<HTMLButtonElement>('.ab-words-preset');
		const speedPillBtns = document.querySelectorAll<HTMLButtonElement>('.ab-speed-pill');
		const speedSlider = el<HTMLInputElement>('ab-speed-slider');
		const sliderValueOut = el<HTMLElement>('ab-slider-value');
		const activeSpeedDisplay = el<HTMLElement>('ab-active-speed-display');

		// Summary bar
		const badgeSpeed = el<HTMLElement>('ab-badge-speed');
		const metricAdjustedTime = el<HTMLElement>('ab-metric-adjusted-time');
		const metricAdjustedSub = el<HTMLElement>('ab-metric-adjusted-sub');
		const labelSaved = el<HTMLElement>('ab-label-saved');
		const badgeSavedPct = el<HTMLElement>('ab-badge-saved-pct');
		const metricTimeSaved = el<HTMLElement>('ab-metric-time-saved');
		const metricSavedSub = el<HTMLElement>('ab-metric-saved-sub');
		const badgeMode = el<HTMLElement>('ab-badge-mode');
		const metricBaseTime = el<HTMLElement>('ab-metric-base-time');
		const metricWordsEst = el<HTMLElement>('ab-metric-words-est');
		const metricDailyLabel = el<HTMLElement>('ab-metric-daily-label');
		const metricDailyDays = el<HTMLElement>('ab-metric-days-45');
		const metricDailySub = el<HTMLElement>('ab-metric-days-sub');

		// Comparison grid
		const comparisonBaseBadge = el<HTMLElement>('ab-comparison-base-badge');
		const comp100 = el<HTMLElement>('ab-comp-100');
		const comp125 = el<HTMLElement>('ab-comp-125');
		const comp150 = el<HTMLElement>('ab-comp-150');
		const comp175 = el<HTMLElement>('ab-comp-175');
		const comp200 = el<HTMLElement>('ab-comp-200');
		const compSilent = el<HTMLElement>('ab-comp-silent');

		// Daily schedule builder
		const scheduleSpeedBadge = el<HTMLElement>('ab-schedule-speed-badge');
		const dailyMinutesInput = el<HTMLInputElement>('ab-daily-minutes');
		const dailyPresetBtns = document.querySelectorAll<HTMLButtonElement>('.ab-daily-preset');
		const schedDays = el<HTMLElement>('ab-sched-days');
		const schedWeeks = el<HTMLElement>('ab-sched-weeks');
		const schedFinish = el<HTMLElement>('ab-sched-finish');
		const schedBooks = el<HTMLElement>('ab-sched-books');
		const targetDaysInput = el<HTMLInputElement>('ab-target-days');
		const targetResult = el<HTMLElement>('ab-target-result');

		const current = {
			baseSeconds: 0,
			adjustedSeconds: 0,
			diffSeconds: 0,
			totalWords: 0,
			dailyMinutes: DEFAULTS.dailyMinutes,
			days: 0,
			finishDate: '',
		};

		function clamp(value: number, min: number, max: number): number {
			return Math.min(max, Math.max(min, value));
		}

		function readNumber(input: HTMLInputElement | null): number {
			const value = Number(input?.value);
			return Number.isFinite(value) ? value : 0;
		}

		function readHms(
			hours: HTMLInputElement | null,
			minutes: HTMLInputElement | null,
			seconds: HTMLInputElement | null,
		): number {
			const h = clamp(Math.floor(readNumber(hours)), 0, 500);
			const m = clamp(Math.floor(readNumber(minutes)), 0, 59);
			const s = clamp(Math.floor(readNumber(seconds)), 0, 59);
			return h * 3600 + m * 60 + s;
		}

		function splitSeconds(totalSeconds: number): { hours: number; minutes: number; seconds: number } {
			const rounded = Math.max(0, Math.round(totalSeconds));
			return {
				hours: Math.floor(rounded / 3600),
				minutes: Math.floor((rounded % 3600) / 60),
				seconds: rounded % 60,
			};
		}

		function formatDuration(totalSeconds: number, includeSeconds = true): string {
			const { hours, minutes, seconds } = splitSeconds(totalSeconds);
			if (hours === 0 && minutes === 0 && seconds === 0) {
				return '0 hr 0 min';
			}
			const parts: string[] = [];
			if (hours > 0) {
				parts.push(`${hours.toLocaleString()} hr`);
				parts.push(`${minutes} min`);
				if (includeSeconds && seconds > 0) parts.push(`${seconds} sec`);
			} else if (minutes > 0) {
				parts.push(`${minutes} min`);
				if (includeSeconds && seconds > 0) parts.push(`${seconds} sec`);
			} else {
				parts.push(`${seconds} sec`);
			}
			return parts.join(' ');
		}

		function formatDaysCount(days: number): string {
			if (days <= 0) return '0 days';
			return days === 1 ? '1 day' : `${days.toLocaleString()} days`;
		}

		function formatWeeks(days: number): string {
			if (days <= 0) return '—';
			return `~${(days / 7).toFixed(1)} weeks`;
		}

		function formatFinishDate(days: number, long = false): string {
			if (days <= 0) return '—';
			const date = new Date();
			date.setHours(12, 0, 0, 0);
			date.setDate(date.getDate() + days - 1);
			if (long) {
				return date.toLocaleDateString('en-US', {
					weekday: 'long',
					month: 'long',
					day: 'numeric',
					year: 'numeric',
				});
			}
			return date.toLocaleDateString('en-US', {
				month: 'short',
				day: 'numeric',
				year: 'numeric',
			});
		}

		function formatBooksPerYear(days: number): string {
			if (days <= 0) return '—';
			const books = 365 / days;
			return books >= 100 ? String(Math.round(books)) : books.toFixed(1);
		}

		function formatSpeedLabel(spd: number): string {
			const rounded = Math.round(spd * 100) / 100;
			if (Number.isInteger(rounded)) return `${rounded.toFixed(1)}x`;
			return `${rounded}x`;
		}

		function dailyMinutesValue(): number {
			const raw = Math.floor(readNumber(dailyMinutesInput));
			if (raw <= 0) return 0;
			return clamp(raw, 1, 1440);
		}

		function syncSpeedControls() {
			const speedStr = formatSpeedLabel(playbackSpeed);
			const effectiveWpm = Math.round(NARRATION_WPM * playbackSpeed);

			if (speedSlider) speedSlider.value = String(playbackSpeed);
			if (sliderValueOut) sliderValueOut.textContent = speedStr;
			if (activeSpeedDisplay) {
				activeSpeedDisplay.textContent = `${speedStr} (~${effectiveWpm} WPM)`;
			}

			speedPillBtns.forEach((btn) => {
				const presetVal = Number(btn.dataset.speedPreset);
				const isMatch = Math.abs(presetVal - playbackSpeed) < 0.001;
				btn.className = `ab-speed-pill cursor-pointer rounded-xl border py-2.5 text-center text-[13px] font-medium tabular-nums transition-all ${
					isMatch
						? 'border-[#0f2e26] bg-[#0f2e26] text-[#afe3d0] dark:border-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]'
						: 'border-hairline bg-canvas text-body hover:border-ink hover:text-ink'
				}`;
			});
		}

		function syncDurationPresets(h: number, m: number, s: number) {
			durationPresetBtns.forEach((btn) => {
				const ph = Number(btn.dataset.hoursPreset);
				const pm = Number(btn.dataset.minutesPreset);
				const ps = Number(btn.dataset.secondsPreset ?? 0) || 0;
				const isMatch = (h > 0 || m > 0 || s > 0) && ph === h && pm === m && ps === s;
				btn.className = `ab-duration-preset cursor-pointer rounded-full border px-3 py-1 text-xs font-medium tabular-nums transition-colors ${
					isMatch
						? 'border-[#0f2e26] bg-[#0f2e26] text-[#afe3d0] dark:border-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]'
						: 'border-hairline bg-canvas-elevated text-body hover:border-ink hover:text-ink'
				}`;
			});
		}

		function syncWordsPresets(w: number) {
			wordsPresetBtns.forEach((btn) => {
				const pw = Number(btn.dataset.wordsPreset);
				const isMatch = w > 0 && pw === w;
				btn.className = `ab-words-preset cursor-pointer rounded-full border px-3 py-1 text-xs font-medium tabular-nums transition-colors ${
					isMatch
						? 'border-[#0f2e26] bg-[#0f2e26] text-[#afe3d0] dark:border-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]'
						: 'border-hairline bg-canvas text-body hover:border-ink hover:text-ink'
				}`;
			});
		}

		function syncDailyPresets(minutes: number) {
			dailyPresetBtns.forEach((btn) => {
				const preset = Number(btn.dataset.dailyPreset);
				const isMatch = minutes > 0 && preset === minutes;
				btn.className = `ab-daily-preset cursor-pointer rounded-full border px-2.5 py-0.5 text-[11px] font-medium tabular-nums transition-colors ${
					isMatch
						? 'border-[#0f2e26] bg-[#0f2e26] text-[#afe3d0] dark:border-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]'
						: 'border-hairline bg-canvas text-body hover:border-ink hover:text-ink'
				}`;
			});
		}

		function syncPctPresets(pct: number) {
			pctPresetBtns.forEach((btn) => {
				const preset = Number(btn.dataset.pctPreset);
				const isMatch = pct > 0 && Math.abs(preset - pct) < 0.05;
				btn.className = `ab-pct-preset cursor-pointer rounded-full border px-2.5 py-0.5 text-[11px] font-medium tabular-nums transition-colors ${
					isMatch
						? 'border-[#0f2e26] bg-[#0f2e26] text-[#afe3d0] dark:border-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]'
						: 'border-hairline bg-canvas-elevated text-body hover:border-ink hover:text-ink'
				}`;
			});
		}

		function setHmsInputs(
			totalSec: number,
			hInput: HTMLInputElement | null,
			mInput: HTMLInputElement | null,
			sInput: HTMLInputElement | null,
		) {
			const parts = splitSeconds(totalSec);
			if (hInput) hInput.value = String(parts.hours);
			if (mInput) mInput.value = String(parts.minutes);
			if (sInput) sInput.value = String(parts.seconds);
		}

		function syncRemainingFromListened() {
			const totalSeconds = readHms(totalHoursInput, totalMinutesInput, totalSecondsInput);
			const listenedSeconds = clamp(
				readHms(listenedHoursInput, listenedMinutesInput, listenedSecondsInput),
				0,
				totalSeconds,
			);
			const remainingSeconds = Math.max(0, totalSeconds - listenedSeconds);
			setHmsInputs(remainingSeconds, remainingHoursInput, remainingMinutesInput, remainingSecondsInput);

			const pct = totalSeconds > 0 ? clamp((listenedSeconds / totalSeconds) * 100, 0, 100) : 0;
			const pctRounded = Math.round(pct * 10) / 10;
			if (pctCompletedInput) pctCompletedInput.value = String(pctRounded);
			if (pctCompletedSlider) pctCompletedSlider.value = String(pctRounded);
			syncPctPresets(pctRounded);
		}

		function syncRemainingFromRemainingInput() {
			const totalSeconds = readHms(totalHoursInput, totalMinutesInput, totalSecondsInput);
			const remainingSeconds = clamp(
				readHms(remainingHoursInput, remainingMinutesInput, remainingSecondsInput),
				0,
				totalSeconds,
			);
			const listenedSeconds = Math.max(0, totalSeconds - remainingSeconds);
			setHmsInputs(listenedSeconds, listenedHoursInput, listenedMinutesInput, listenedSecondsInput);

			const pct = totalSeconds > 0 ? clamp((listenedSeconds / totalSeconds) * 100, 0, 100) : 0;
			const pctRounded = Math.round(pct * 10) / 10;
			if (pctCompletedInput) pctCompletedInput.value = String(pctRounded);
			if (pctCompletedSlider) pctCompletedSlider.value = String(pctRounded);
			syncPctPresets(pctRounded);
		}

		function syncRemainingFromPercentage(pctRaw: number) {
			const pct = clamp(pctRaw, 0, 100);
			const pctRounded = Math.round(pct * 10) / 10;
			const totalSeconds = readHms(totalHoursInput, totalMinutesInput, totalSecondsInput);
			const listenedSeconds = Math.round(totalSeconds * (pct / 100));
			const remainingSeconds = Math.max(0, totalSeconds - listenedSeconds);

			setHmsInputs(listenedSeconds, listenedHoursInput, listenedMinutesInput, listenedSecondsInput);
			setHmsInputs(remainingSeconds, remainingHoursInput, remainingMinutesInput, remainingSecondsInput);
			if (pctCompletedInput && document.activeElement !== pctCompletedInput) {
				pctCompletedInput.value = String(pctRounded);
			}
			if (pctCompletedSlider && document.activeElement !== pctCompletedSlider) {
				pctCompletedSlider.value = String(pctRounded);
			}
			syncPctPresets(pctRounded);
		}

		function syncModeButtons() {
			modeBtns.forEach((btn) => {
				const active = btn.dataset.mode === mode;
				btn.setAttribute('aria-selected', active ? 'true' : 'false');
				btn.className = active
					? 'ab-mode-btn cursor-pointer rounded-full bg-[#afe3d0] px-4 py-1.5 text-[13px] font-semibold text-[#0f2e26] transition-all'
					: 'ab-mode-btn cursor-pointer rounded-full bg-transparent px-4 py-1.5 text-[13px] font-medium text-body transition-all hover:text-ink';
			});
			panelLength?.classList.toggle('hidden', mode !== 'length');
			panelWords?.classList.toggle('hidden', mode !== 'words');
			panelRemaining?.classList.toggle('hidden', mode !== 'remaining');
		}

		function setMode(nextMode: Mode) {
			mode = nextMode;
			syncModeButtons();
			updateUI();
		}

		function updateUI() {
			let baseSeconds = 0;
			let totalWords = 0;
			let remainingPctCompleted = 0;
			let remainingPctLeft = 0;

			if (mode === 'length') {
				baseSeconds = readHms(hoursInput, minutesInput, secondsInput);
				totalWords = Math.round((baseSeconds / 60) * NARRATION_WPM);
				if (wordsInput) wordsInput.value = String(totalWords);
			} else if (mode === 'words') {
				totalWords = clamp(Math.round(readNumber(wordsInput)), 0, 5000000);
				baseSeconds = (totalWords / NARRATION_WPM) * 60;
				const parts = splitSeconds(baseSeconds);
				if (hoursInput) hoursInput.value = String(parts.hours);
				if (minutesInput) minutesInput.value = String(parts.minutes);
				if (secondsInput) secondsInput.value = String(parts.seconds);
			} else {
				const totalSeconds = readHms(totalHoursInput, totalMinutesInput, totalSecondsInput);
				const listenedSeconds = Math.min(
					readHms(listenedHoursInput, listenedMinutesInput, listenedSecondsInput),
					totalSeconds,
				);
				baseSeconds = Math.max(0, totalSeconds - listenedSeconds);
				totalWords = Math.round((baseSeconds / 60) * NARRATION_WPM);
				if (wordsInput) wordsInput.value = String(totalWords);

				const pct = totalSeconds > 0 ? clamp((listenedSeconds / totalSeconds) * 100, 0, 100) : 0;
				const pctLeft = totalSeconds > 0 ? clamp(100 - pct, 0, 100) : 0;
				remainingPctCompleted = pct;
				remainingPctLeft = pctLeft;

				if (pctRemainingBadge) pctRemainingBadge.textContent = `${pctLeft.toFixed(1)}% left`;
				if (progressPct) progressPct.textContent = `${pct.toFixed(1)}% completed · ${pctLeft.toFixed(1)}% left`;
				if (progressFill) progressFill.style.width = `${pct}%`;
				if (progressTrack) progressTrack.setAttribute('aria-valuenow', String(Math.round(pct * 10) / 10));
				if (progressListened) progressListened.textContent = `${formatDuration(listenedSeconds)} listened`;
				if (progressRemaining) progressRemaining.textContent = `${formatDuration(baseSeconds)} remaining`;
			}

			const adjustedSeconds = playbackSpeed > 0 ? baseSeconds / playbackSpeed : 0;
			const diffSeconds = baseSeconds - adjustedSeconds; // positive = saved, negative = added
			const speedStr = formatSpeedLabel(playbackSpeed);
			const baseFormatted = formatDuration(baseSeconds);
			const adjustedFormatted = formatDuration(adjustedSeconds);

			current.baseSeconds = baseSeconds;
			current.adjustedSeconds = adjustedSeconds;
			current.diffSeconds = diffSeconds;
			current.totalWords = totalWords;

			// Stat 1: Adjusted listening time
			if (badgeSpeed) badgeSpeed.textContent = `At ${speedStr} speed`;
			if (metricAdjustedTime) metricAdjustedTime.textContent = adjustedFormatted;
			if (metricAdjustedSub) {
				if (mode === 'remaining') {
					metricAdjustedSub.textContent = `${remainingPctCompleted.toFixed(1)}% completed · ${remainingPctLeft.toFixed(1)}% left`;
				} else {
					metricAdjustedSub.textContent = `${Math.round(adjustedSeconds / 60).toLocaleString()} total minutes of listening`;
				}
			}

			// Stat 2: Time saved or added
			if (baseSeconds <= 0 || Math.abs(playbackSpeed - 1.0) < 0.001) {
				if (labelSaved) labelSaved.textContent = 'Time saved';
				if (badgeSavedPct) {
					badgeSavedPct.textContent = Math.abs(playbackSpeed - 1.0) < 0.001 ? 'Original pace' : '0% shorter';
				}
				if (metricTimeSaved) metricTimeSaved.textContent = '0 min';
				if (metricSavedSub) {
					metricSavedSub.textContent =
						baseSeconds <= 0 ? 'Compared to 0 hr 0 min at 1.0x' : 'Standard 1.0x narration pace';
				}
			} else if (diffSeconds > 0) {
				const pctSaved = Math.round((diffSeconds / Math.max(1, baseSeconds)) * 100);
				if (labelSaved) labelSaved.textContent = 'Time saved';
				if (badgeSavedPct) badgeSavedPct.textContent = `${pctSaved}% shorter`;
				if (metricTimeSaved) metricTimeSaved.textContent = formatDuration(diffSeconds);
				if (metricSavedSub) metricSavedSub.textContent = `Compared to ${baseFormatted} at 1.0x`;
			} else {
				const addedSeconds = Math.abs(diffSeconds);
				const pctAdded = Math.round((addedSeconds / Math.max(1, baseSeconds)) * 100);
				if (labelSaved) labelSaved.textContent = 'Time added';
				if (badgeSavedPct) badgeSavedPct.textContent = `+${pctAdded}% longer`;
				if (metricTimeSaved) metricTimeSaved.textContent = `+${formatDuration(addedSeconds)}`;
				if (metricSavedSub) metricSavedSub.textContent = `Slower than ${baseFormatted} at 1.0x`;
			}

			// Stat 3: Original 1.0x length
			const estPages = Math.round(totalWords / WORDS_PER_PAGE);
			if (badgeMode) {
				badgeMode.textContent =
					mode === 'length'
						? 'By length'
						: mode === 'words'
							? 'By word count'
							: `${remainingPctCompleted.toFixed(1)}% completed`;
			}
			if (metricBaseTime) metricBaseTime.textContent = baseFormatted;
			if (metricWordsEst) {
				metricWordsEst.textContent =
					totalWords > 0
						? `~${totalWords.toLocaleString()} words · ~${estPages.toLocaleString()} pages`
						: '0 words · 0 pages';
			}

			// Stat 4 & schedule: custom daily listening minutes
			const dailyMinutes = dailyMinutesValue();
			const dailySeconds = dailyMinutes * 60;
			const days = dailySeconds > 0 && adjustedSeconds > 0 ? Math.ceil(adjustedSeconds / dailySeconds) : 0;
			const finishShort = formatFinishDate(days);
			const finishLong = formatFinishDate(days, true);

			current.dailyMinutes = dailyMinutes;
			current.days = days;
			current.finishDate = finishLong;

			if (metricDailyLabel) metricDailyLabel.textContent = `At ${dailyMinutes || 0} min/day`;
			if (metricDailyDays) metricDailyDays.textContent = formatDaysCount(days);
			if (metricDailySub) {
				metricDailySub.textContent =
					days > 0 ? `${formatWeeks(days)} · finishes ${finishShort}` : 'Set daily minutes in Schedule Planner';
			}

			if (scheduleSpeedBadge) scheduleSpeedBadge.textContent = `At ${speedStr} speed`;
			if (schedDays) schedDays.textContent = formatDaysCount(days);
			if (schedWeeks) schedWeeks.textContent = formatWeeks(days);
			if (schedFinish) schedFinish.textContent = finishLong;
			if (schedBooks) schedBooks.textContent = formatBooksPerYear(days);

			// Reverse goal mode: minutes per day needed to finish in X days
			const targetDaysRaw = Math.floor(readNumber(targetDaysInput));
			const targetDays = targetDaysRaw > 0 ? clamp(targetDaysRaw, 1, 365) : 0;
			if (targetResult) {
				if (baseSeconds <= 0 || targetDays <= 0) {
					targetResult.textContent = 'Enter an audiobook length to see your daily goal';
				} else {
					const neededPerDay = adjustedSeconds / targetDays;
					const goalText = `Listen ${formatDuration(neededPerDay, false)} per day at ${speedStr}`;
					targetResult.textContent =
						neededPerDay > 86400 ? `${goalText} (more than 24 hours a day)` : goalText;
				}
			}

			// Speed comparison grid
			if (comparisonBaseBadge) {
				comparisonBaseBadge.textContent = `For ${baseFormatted} book`;
			}
			if (comp100) comp100.textContent = formatDuration(baseSeconds / 1.0);
			if (comp125) comp125.textContent = formatDuration(baseSeconds / 1.25);
			if (comp150) comp150.textContent = formatDuration(baseSeconds / 1.5);
			if (comp175) comp175.textContent = formatDuration(baseSeconds / 1.75);
			if (comp200) comp200.textContent = formatDuration(baseSeconds / 2.0);
			if (compSilent) {
				compSilent.textContent = formatDuration((totalWords / SILENT_WPM) * 60);
			}
		}

		// Copy helpers
		const copyTimers = new WeakMap<HTMLElement, number>();

		function flashCopied(btn: HTMLElement | null) {
			if (!btn) return;
			if (!btn.dataset.originalLabel) {
				btn.dataset.originalLabel = btn.textContent?.trim() ?? '';
			}
			const original = btn.dataset.originalLabel;
			btn.textContent = 'Copied!';
			const existing = copyTimers.get(btn);
			if (existing) window.clearTimeout(existing);
			const timer = window.setTimeout(() => {
				btn.textContent = original;
				copyTimers.delete(btn);
			}, 1600);
			copyTimers.set(btn, timer);
		}

		function fallbackCopy(text: string, onDone: () => void) {
			const area = document.createElement('textarea');
			area.value = text;
			area.setAttribute('readonly', '');
			area.style.position = 'fixed';
			area.style.opacity = '0';
			document.body.appendChild(area);
			area.select();
			try {
				document.execCommand('copy');
				onDone();
			} catch {
				// Clipboard access unavailable; nothing else to do
			}
			document.body.removeChild(area);
		}

		function copyText(text: string, btn: HTMLElement | null) {
			const onDone = () => flashCopied(btn);
			if (navigator.clipboard?.writeText) {
				navigator.clipboard.writeText(text).then(onDone).catch(() => fallbackCopy(text, onDone));
			} else {
				fallbackCopy(text, onDone);
			}
		}

		function buildShareUrl(): string {
			const base = current.baseSeconds > 0 ? current.baseSeconds : readHms(hoursInput, minutesInput, secondsInput);
			const parts = splitSeconds(base);
			const url = new URL(window.location.href);
			url.search = '';
			url.hash = '';
			url.searchParams.set('h', String(parts.hours));
			url.searchParams.set('m', String(parts.minutes));
			url.searchParams.set('sec', String(parts.seconds));
			url.searchParams.set('s', String(playbackSpeed));
			url.searchParams.set('d', String(current.dailyMinutes || DEFAULTS.dailyMinutes));
			return url.toString();
		}

		function buildResultText(): string {
			const speedStr = formatSpeedLabel(playbackSpeed);
			const savedLabel = current.diffSeconds >= 0 ? 'Time saved' : 'Time added';
			const savedValue = formatDuration(Math.abs(current.diffSeconds));
			const estPages = Math.round(current.totalWords / WORDS_PER_PAGE);
			const lines = [
				`Audiobook length: ${formatDuration(current.baseSeconds)} at 1.0x`,
				`Playback speed: ${speedStr}`,
				`Adjusted listening time: ${formatDuration(current.adjustedSeconds)}`,
				`${savedLabel}: ${savedValue}`,
				`Estimated length: ~${current.totalWords.toLocaleString()} words · ~${estPages.toLocaleString()} pages`,
			];
			if (current.days > 0) {
				lines.push(
					`Daily schedule: ${current.dailyMinutes} min/day → ${formatDaysCount(current.days)} (~${(current.days / 7).toFixed(1)} weeks, finishes ${current.finishDate})`,
				);
			}
			lines.push(buildShareUrl());
			return lines.join('\n');
		}

		btnCopyResult?.addEventListener('click', () => {
			copyText(buildResultText(), btnCopyResult);
		});

		btnCopyLink?.addEventListener('click', () => {
			copyText(buildShareUrl(), btnCopyLink);
		});

		// Mode tab switching
		modeBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				setMode((btn.dataset.mode as Mode) || 'length');
			});
		});

		// Length inputs (hours / minutes / seconds)
		const handleLengthInput = () => {
			mode = 'length';
			syncModeButtons();
			const parts = splitSeconds(readHms(hoursInput, minutesInput, secondsInput));
			syncDurationPresets(parts.hours, parts.minutes, parts.seconds);
			updateUI();
		};
		hoursInput?.addEventListener('input', handleLengthInput);
		minutesInput?.addEventListener('input', handleLengthInput);
		secondsInput?.addEventListener('input', handleLengthInput);

		durationPresetBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const h = Number(btn.dataset.hoursPreset) || 0;
				const m = Number(btn.dataset.minutesPreset) || 0;
				const s = Number(btn.dataset.secondsPreset ?? 0) || 0;
				if (hoursInput) hoursInput.value = String(h);
				if (minutesInput) minutesInput.value = String(m);
				if (secondsInput) secondsInput.value = String(s);
				syncDurationPresets(h, m, s);
				setMode('length');
			});
		});

		// Word count input & presets
		wordsInput?.addEventListener('input', () => {
			mode = 'words';
			syncModeButtons();
			syncWordsPresets(Number(wordsInput.value));
			updateUI();
		});

		wordsPresetBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const w = Number(btn.dataset.wordsPreset) || DEFAULTS.words;
				if (wordsInput) wordsInput.value = String(w);
				syncWordsPresets(w);
				setMode('words');
			});
		});

		// Remaining progress inputs: Total length or Elapsed time changed -> recalculate Remaining time & Percentage
		[totalHoursInput, totalMinutesInput, totalSecondsInput, listenedHoursInput, listenedMinutesInput, listenedSecondsInput].forEach(
			(input) => {
				input?.addEventListener('input', () => {
					mode = 'remaining';
					syncModeButtons();
					syncRemainingFromListened();
					updateUI();
				});
			},
		);

		// Remaining time inputs changed -> recalculate Elapsed time & Percentage
		[remainingHoursInput, remainingMinutesInput, remainingSecondsInput].forEach(
			(input) => {
				input?.addEventListener('input', () => {
					mode = 'remaining';
					syncModeButtons();
					syncRemainingFromRemainingInput();
					updateUI();
				});
			},
		);

		// Percentage completed input & slider -> recalculate Elapsed time & Remaining time
		pctCompletedInput?.addEventListener('input', () => {
			mode = 'remaining';
			syncModeButtons();
			syncRemainingFromPercentage(readNumber(pctCompletedInput));
			updateUI();
		});

		pctCompletedSlider?.addEventListener('input', () => {
			mode = 'remaining';
			syncModeButtons();
			syncRemainingFromPercentage(readNumber(pctCompletedSlider));
			updateUI();
		});

		pctPresetBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const pct = Number(btn.dataset.pctPreset) || 0;
				mode = 'remaining';
				syncModeButtons();
				if (pctCompletedInput) pctCompletedInput.value = String(pct);
				if (pctCompletedSlider) pctCompletedSlider.value = String(pct);
				syncRemainingFromPercentage(pct);
				updateUI();
			});
		});

		// Playback speed preset pills
		speedPillBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				playbackSpeed = Number(btn.dataset.speedPreset) || 1.0;
				syncSpeedControls();
				updateUI();
			});
		});

		// Fine-grained speed slider
		speedSlider?.addEventListener('input', () => {
			playbackSpeed = Number(speedSlider.value) || 1.0;
			syncSpeedControls();
			updateUI();
		});

		// Daily listening minutes input & presets
		dailyMinutesInput?.addEventListener('input', () => {
			syncDailyPresets(dailyMinutesValue());
			updateUI();
		});

		dailyPresetBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const minutes = Number(btn.dataset.dailyPreset) || DEFAULTS.dailyMinutes;
				if (dailyMinutesInput) dailyMinutesInput.value = String(minutes);
				syncDailyPresets(minutes);
				updateUI();
			});
		});

		targetDaysInput?.addEventListener('input', () => {
			updateUI();
		});

		// Reset button
		btnReset?.addEventListener('click', () => {
			playbackSpeed = DEFAULTS.speed;
			if (hoursInput) hoursInput.value = String(DEFAULTS.hours);
			if (minutesInput) minutesInput.value = String(DEFAULTS.minutes);
			if (secondsInput) secondsInput.value = String(DEFAULTS.seconds);
			if (wordsInput) wordsInput.value = String(DEFAULTS.words);
			if (totalHoursInput) totalHoursInput.value = String(DEFAULTS.totalHours);
			if (totalMinutesInput) totalMinutesInput.value = String(DEFAULTS.totalMinutes);
			if (totalSecondsInput) totalSecondsInput.value = String(DEFAULTS.totalSeconds);
			if (listenedHoursInput) listenedHoursInput.value = String(DEFAULTS.listenedHours);
			if (listenedMinutesInput) listenedMinutesInput.value = String(DEFAULTS.listenedMinutes);
			if (listenedSecondsInput) listenedSecondsInput.value = String(DEFAULTS.listenedSeconds);
			if (remainingHoursInput) remainingHoursInput.value = String(DEFAULTS.remainingHours);
			if (remainingMinutesInput) remainingMinutesInput.value = String(DEFAULTS.remainingMinutes);
			if (remainingSecondsInput) remainingSecondsInput.value = String(DEFAULTS.remainingSeconds);
			if (pctCompletedInput) pctCompletedInput.value = String(DEFAULTS.pctCompleted);
			if (pctCompletedSlider) pctCompletedSlider.value = String(DEFAULTS.pctCompleted);
			if (dailyMinutesInput) dailyMinutesInput.value = String(DEFAULTS.dailyMinutes);
			if (targetDaysInput) targetDaysInput.value = String(DEFAULTS.targetDays);

			syncDurationPresets(DEFAULTS.hours, DEFAULTS.minutes, DEFAULTS.seconds);
			syncWordsPresets(DEFAULTS.words);
			syncDailyPresets(DEFAULTS.dailyMinutes);
			syncPctPresets(DEFAULTS.pctCompleted);
			syncSpeedControls();
			setMode('length');
		});

		// Shareable state from the URL (?h=&m=&sec=&s=&d=)
		function applyUrlState() {
			let params: URLSearchParams;
			try {
				params = new URLSearchParams(window.location.search);
			} catch {
				return;
			}
			const has = (key: string) => params.get(key) !== null && params.get(key) !== '';

			if (has('h') || has('m') || has('sec')) {
				if (hoursInput) hoursInput.value = String(clamp(Math.floor(Number(params.get('h')) || 0), 0, 500));
				if (minutesInput) minutesInput.value = String(clamp(Math.floor(Number(params.get('m')) || 0), 0, 59));
				if (secondsInput) secondsInput.value = String(clamp(Math.floor(Number(params.get('sec')) || 0), 0, 59));
				mode = 'length';
			}
			if (has('s')) {
				playbackSpeed = clamp(Number(params.get('s')) || DEFAULTS.speed, 0.5, 3);
			}
			if (has('d')) {
				const minutes = clamp(Math.floor(Number(params.get('d')) || 0), 0, 1440);
				if (dailyMinutesInput) dailyMinutesInput.value = String(minutes);
				syncDailyPresets(minutes);
			}
		}

		applyUrlState();

		const initialParts = splitSeconds(readHms(hoursInput, minutesInput, secondsInput));
		syncDurationPresets(initialParts.hours, initialParts.minutes, initialParts.seconds);
		syncWordsPresets(Number(wordsInput?.value));
		syncDailyPresets(dailyMinutesValue());
		syncSpeedControls();
		syncModeButtons();
		updateUI();
	}

	initAudiobookCalculator();
</script>
