---
import { getLocaleFromUrl, getLocalizedPath, useTranslations, type Locale } from '../i18n/ui';
import { getToolById } from '../config/site';

interface Props {
	locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const readingCounterTool = getToolById('reading-time-calculator');
const speedTestTool = getToolById('reading-speed-test');
const wordsToPagesTool = getToolById('words-to-pages');

interface WordsPreset {
	words: number;
	label: string;
}

interface DurationPreset {
	hours: number;
	minutes: number;
	label: string;
}

const wordsPresets = t.raw<WordsPreset[]>('audiobookCalculator.ui.wordsPresets') ?? [];
const durationPresets = t.raw<DurationPreset[]>('audiobookCalculator.ui.durationPresets') ?? [];
const popularBooks = t.raw<DurationPreset[]>('audiobookCalculator.ui.popularBooks') ?? [];
const clientI18n = t.raw<Record<string, string>>('audiobookCalculator.client') ?? {};
---

<section
	id="audiobook-calculator-workspace"
	aria-label={t('audiobookCalculator.ui.workspaceAriaLabel')}
	class="mx-auto max-w-[1140px] px-4 pt-4 pb-14 sm:px-6"
>
	<!-- Unified 2-Column Split-Studio Card (Matching SpeechCalculator.astro) -->
	<div class="whisper-shadow overflow-hidden rounded-3xl border border-hairline bg-canvas-elevated lg:grid lg:grid-cols-12">
		<!-- Left Column (~60% width / 7 cols): Clean Inputs, Playback Speed, and Collapsible Presets & Schedule -->
		<div class="flex flex-col justify-between p-6 sm:p-8 lg:col-span-7 lg:p-10">
			<div class="space-y-6">
				<!-- Top Mode Pills: By Length | By Words | Remaining -->
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div
						role="tablist"
						aria-label={t('audiobookCalculator.ui.inputModeAriaLabel')}
						class="inline-flex flex-wrap rounded-full border border-hairline bg-canvas p-1"
					>
						<button
							type="button"
							role="tab"
							id="ab-tab-btn-length"
							aria-selected="true"
							aria-controls="ab-panel-length"
							data-mode="length"
							class="ab-mode-btn cursor-pointer rounded-full bg-[#afe3d0] px-4 py-1.5 text-[13px] font-semibold text-[#0f2e26] transition-all"
						>
							{t('audiobookCalculator.ui.modeByLength')}
						</button>
						<button
							type="button"
							role="tab"
							id="ab-tab-btn-words"
							aria-selected="false"
							aria-controls="ab-panel-words"
							data-mode="words"
							class="ab-mode-btn cursor-pointer rounded-full bg-transparent px-4 py-1.5 text-[13px] font-medium text-body transition-all hover:text-ink"
						>
							{t('audiobookCalculator.ui.modeByWords')}
						</button>
						<button
							type="button"
							role="tab"
							id="ab-tab-btn-remaining"
							aria-selected="false"
							aria-controls="ab-panel-remaining"
							data-mode="remaining"
							class="ab-mode-btn cursor-pointer rounded-full bg-transparent px-4 py-1.5 text-[13px] font-medium text-body transition-all hover:text-ink"
						>
							{t('audiobookCalculator.ui.modeRemaining')}
						</button>
					</div>
				</div>

				<!-- Panel 1: By Audiobook Length (Hours, Minutes & Seconds) -->
				<div
					id="ab-panel-length"
					role="tabpanel"
					aria-labelledby="ab-tab-btn-length"
					class="space-y-4"
				>
					<div>
						<h2 class="text-[14px] font-medium text-ink">
							{t('audiobookCalculator.ui.lengthTitle')}
						</h2>
						<p class="mt-0.5 text-[13px] text-mute">
							{t('audiobookCalculator.ui.lengthSubtitle')}
						</p>
					</div>

					<div class="grid grid-cols-3 gap-2 sm:gap-3">
						<div>
							<label for="ab-hours-input" class="mb-1.5 block text-[12px] font-medium text-mute">
								{t('audiobookCalculator.ui.hoursLabel')}
							</label>
							<div class="relative flex items-center">
								<input
									id="ab-hours-input"
									type="number"
									min="0"
									max="500"
									step="1"
									value="0"
									class="w-full rounded-2xl border border-hairline bg-canvas px-2.5 py-3 pr-8 text-[18px] sm:px-3.5 sm:pr-9 sm:text-[22px] font-semibold text-ink tabular-nums focus:border-[#0f2e26] focus:bg-canvas-elevated focus:outline-none dark:focus:border-[#afe3d0]"
								/>
								<span class="pointer-events-none absolute right-3.5 text-[12px] text-mute">
									{t('audiobookCalculator.ui.unitHr')}
								</span>
							</div>
						</div>

						<div>
							<label for="ab-minutes-input" class="mb-1.5 block text-[12px] font-medium text-mute">
								{t('audiobookCalculator.ui.minutesLabel')}
							</label>
							<div class="relative flex items-center">
								<input
									id="ab-minutes-input"
									type="number"
									min="0"
									max="59"
									step="1"
									value="0"
									class="w-full rounded-2xl border border-hairline bg-canvas px-2.5 py-3 pr-9 text-[18px] sm:px-3.5 sm:pr-11 sm:text-[22px] font-semibold text-ink tabular-nums focus:border-[#0f2e26] focus:bg-canvas-elevated focus:outline-none dark:focus:border-[#afe3d0]"
								/>
								<span class="pointer-events-none absolute right-3.5 text-[12px] text-mute">
									{t('audiobookCalculator.ui.unitMin')}
								</span>
							</div>
						</div>

						<div>
							<label for="ab-seconds-input" class="mb-1.5 block text-[12px] font-medium text-mute">
								{t('audiobookCalculator.ui.secondsLabel')}
							</label>
							<div class="relative flex items-center">
								<input
									id="ab-seconds-input"
									type="number"
									min="0"
									max="59"
									step="1"
									value="0"
									class="w-full rounded-2xl border border-hairline bg-canvas px-2.5 py-3 pr-9 text-[18px] sm:px-3.5 sm:pr-11 sm:text-[22px] font-semibold text-ink tabular-nums focus:border-[#0f2e26] focus:bg-canvas-elevated focus:outline-none dark:focus:border-[#afe3d0]"
								/>
								<span class="pointer-events-none absolute right-3.5 text-[12px] text-mute">
									{t('audiobookCalculator.ui.unitSec')}
								</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Panel 2: By Word Count (~155 WPM Narration Speed) -->
				<div
					id="ab-panel-words"
					role="tabpanel"
					aria-labelledby="ab-tab-btn-words"
					class="hidden space-y-4"
				>
					<div class="flex flex-wrap items-baseline justify-between gap-2">
						<div>
							<label for="ab-words-input" class="block text-[14px] font-medium text-ink">
								{t('audiobookCalculator.ui.wordsTitle')}
							</label>
							<p class="mt-0.5 text-[13px] text-mute">
								{t('audiobookCalculator.ui.wordsSubtitle')}
							</p>
						</div>
					</div>

					<div class="relative flex items-center">
						<input
							id="ab-words-input"
							type="number"
							min="0"
							max="5000000"
							step="1000"
							value="0"
							class="w-full rounded-2xl border border-hairline bg-canvas px-4 py-3 pr-16 text-[22px] font-semibold text-ink tabular-nums focus:border-[#0f2e26] focus:bg-canvas-elevated focus:outline-none dark:focus:border-[#afe3d0]"
						/>
						<span class="pointer-events-none absolute right-4 text-[12px] text-mute">
							{t('audiobookCalculator.ui.unitWords')}
						</span>
					</div>

					<!-- Common Book Word Count Presets -->
					<div>
						<span class="mb-2 block text-[12px] font-medium text-mute">
							{t('audiobookCalculator.ui.wordsPresetsLabel')}
						</span>
						<div class="flex flex-wrap gap-1.5">
							{
								wordsPresets.map((preset) => (
									<button
										type="button"
										data-words-preset={preset.words}
										class="ab-words-preset cursor-pointer rounded-full border border-hairline bg-canvas px-3 py-1 text-xs font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
									>
										{preset.label}
									</button>
								))
							}
						</div>
					</div>
				</div>

				<!-- Panel 3: Remaining Progress (Total Length vs Already Listened / Remaining / Percentage) -->
				<div
					id="ab-panel-remaining"
					role="tabpanel"
					aria-labelledby="ab-tab-btn-remaining"
					class="hidden space-y-4"
				>
					<div>
						<h2 class="text-[14px] font-medium text-ink">
							{t('audiobookCalculator.ui.remainingTitle')}
						</h2>
						<p class="mt-0.5 text-[13px] text-mute">
							{t('audiobookCalculator.ui.remainingSubtitle')}
						</p>
					</div>

					<div class="space-y-3.5">
						<div>
							<span class="mb-1.5 block text-[12px] font-medium text-mute">
								{t('audiobookCalculator.ui.totalLengthLabel')}
							</span>
							<div class="grid grid-cols-3 gap-2.5">
								<div class="relative flex items-center">
									<input
										id="ab-total-hours"
										type="number"
										min="0"
										max="500"
										step="1"
										value="0"
										aria-label={t('audiobookCalculator.ui.totalHoursAria')}
										class="w-full rounded-xl border border-hairline bg-canvas px-3 py-2 text-base font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
									/>
									<span class="pointer-events-none absolute right-3 text-[12px] text-mute">{t('audiobookCalculator.ui.unitHr')}</span>
								</div>
								<div class="relative flex items-center">
									<input
										id="ab-total-minutes"
										type="number"
										min="0"
										max="59"
										step="1"
										value="0"
										aria-label={t('audiobookCalculator.ui.totalMinutesAria')}
										class="w-full rounded-xl border border-hairline bg-canvas px-3 py-2 text-base font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
									/>
									<span class="pointer-events-none absolute right-3 text-[12px] text-mute">{t('audiobookCalculator.ui.unitMin')}</span>
								</div>
								<div class="relative flex items-center">
									<input
										id="ab-total-seconds"
										type="number"
										min="0"
										max="59"
										step="1"
										value="0"
										aria-label={t('audiobookCalculator.ui.totalSecondsAria')}
										class="w-full rounded-xl border border-hairline bg-canvas px-3 py-2 text-base font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
									/>
									<span class="pointer-events-none absolute right-3 text-[12px] text-mute">{t('audiobookCalculator.ui.unitSec')}</span>
								</div>
							</div>
						</div>

						<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
							<div>
								<span class="mb-1.5 block text-[12px] font-medium text-mute">
									{t('audiobookCalculator.ui.elapsedLabel')}
								</span>
								<div class="grid grid-cols-3 gap-2">
									<div class="relative flex items-center">
										<input
											id="ab-listened-hours"
											type="number"
											min="0"
											max="500"
											step="1"
											value="0"
											aria-label={t('audiobookCalculator.ui.listenedHoursAria')}
											class="w-full rounded-xl border border-hairline bg-canvas px-2.5 py-2 pr-7 text-sm font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
										/>
										<span class="pointer-events-none absolute right-2 text-[11px] text-mute">{t('audiobookCalculator.ui.unitHr')}</span>
									</div>
									<div class="relative flex items-center">
										<input
											id="ab-listened-minutes"
											type="number"
											min="0"
											max="59"
											step="1"
											value="0"
											aria-label={t('audiobookCalculator.ui.listenedMinutesAria')}
											class="w-full rounded-xl border border-hairline bg-canvas px-2.5 py-2 pr-8 text-sm font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
										/>
										<span class="pointer-events-none absolute right-2 text-[11px] text-mute">{t('audiobookCalculator.ui.unitMin')}</span>
									</div>
									<div class="relative flex items-center">
										<input
											id="ab-listened-seconds"
											type="number"
											min="0"
											max="59"
											step="1"
											value="0"
											aria-label={t('audiobookCalculator.ui.listenedSecondsAria')}
											class="w-full rounded-xl border border-hairline bg-canvas px-2.5 py-2 pr-8 text-sm font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
										/>
										<span class="pointer-events-none absolute right-2 text-[11px] text-mute">{t('audiobookCalculator.ui.unitSec')}</span>
									</div>
								</div>
							</div>

							<div>
								<span class="mb-1.5 block text-[12px] font-medium text-mute">
									{t('audiobookCalculator.ui.remainingTimeLabel')}
								</span>
								<div class="grid grid-cols-3 gap-2">
									<div class="relative flex items-center">
										<input
											id="ab-remaining-hours"
											type="number"
											min="0"
											max="500"
											step="1"
											value="0"
											aria-label={t('audiobookCalculator.ui.remainingHoursAria')}
											class="w-full rounded-xl border border-hairline bg-canvas px-2.5 py-2 pr-7 text-sm font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
										/>
										<span class="pointer-events-none absolute right-2 text-[11px] text-mute">{t('audiobookCalculator.ui.unitHr')}</span>
									</div>
									<div class="relative flex items-center">
										<input
											id="ab-remaining-minutes"
											type="number"
											min="0"
											max="59"
											step="1"
											value="0"
											aria-label={t('audiobookCalculator.ui.remainingMinutesAria')}
											class="w-full rounded-xl border border-hairline bg-canvas px-2.5 py-2 pr-8 text-sm font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
										/>
										<span class="pointer-events-none absolute right-2 text-[11px] text-mute">{t('audiobookCalculator.ui.unitMin')}</span>
									</div>
									<div class="relative flex items-center">
										<input
											id="ab-remaining-seconds"
											type="number"
											min="0"
											max="59"
											step="1"
											value="0"
											aria-label={t('audiobookCalculator.ui.remainingSecondsAria')}
											class="w-full rounded-xl border border-hairline bg-canvas px-2.5 py-2 pr-8 text-sm font-semibold text-ink tabular-nums focus:border-ink focus:bg-canvas-elevated focus:outline-none"
										/>
										<span class="pointer-events-none absolute right-2 text-[11px] text-mute">{t('audiobookCalculator.ui.unitSec')}</span>
									</div>
								</div>
							</div>
						</div>

						<!-- Percentage Completed (%) Input, Slider & Quick Presets -->
						<div class="rounded-2xl border border-hairline bg-canvas p-4">
							<div class="flex flex-wrap items-center justify-between gap-2">
								<label for="ab-pct-completed-input" class="text-[12px] font-medium text-body">
									{t('audiobookCalculator.ui.pctCompletedLabel')}
								</label>
								<div class="flex items-center gap-2">
									<div class="relative flex w-28 items-center">
										<input
											id="ab-pct-completed-input"
											type="number"
											min="0"
											max="100"
											step="0.1"
											value="0"
											class="w-full rounded-xl border border-hairline bg-canvas-elevated px-2.5 py-1 pr-6 text-right text-sm font-semibold text-ink tabular-nums focus:border-ink focus:outline-none"
										/>
										<span class="pointer-events-none absolute right-2.5 text-[12px] text-mute">%</span>
									</div>
									<span
										id="ab-pct-remaining-badge"
										class="rounded-full bg-hairline-soft px-2.5 py-0.5 text-[11px] font-medium text-ink tabular-nums"
									>
										{t('audiobookCalculator.ui.initialPctLeft')}
									</span>
								</div>
							</div>

							<div class="mt-2.5">
								<input
									id="ab-pct-completed-slider"
									type="range"
									min="0"
									max="100"
									step="0.1"
									value="0"
									aria-label={t('audiobookCalculator.ui.pctSliderAria')}
									class="geist-slider"
								/>
							</div>

							<div class="mt-2.5 flex flex-wrap items-center justify-between gap-2">
								<span class="text-[11px] font-medium text-mute">
									{t('audiobookCalculator.ui.pctPresetsLabel')}
								</span>
								<div class="flex flex-wrap gap-1.5">
									{
										[10, 25, 50, 75, 90].map((pct) => (
											<button
												type="button"
												data-pct-preset={pct}
												class="ab-pct-preset cursor-pointer rounded-full border border-hairline bg-canvas-elevated px-2.5 py-0.5 text-[11px] font-medium text-body tabular-nums transition-colors hover:border-ink hover:text-ink"
											>
												{pct}%
											</button>
										))
									}
								</div>
							</div>
						</div>

						<!-- Live Progress Bar & Remaining Time -->
						<div class="rounded-2xl border border-hairline bg-canvas p-4">
							<div class="mb-1.5 flex items-baseline justify-between gap-2">
								<span class="text-[12px] font-medium text-body">{t('audiobookCalculator.ui.listeningProgressLabel')}</span>
								<span id="ab-progress-pct" class="text-[13px] font-semibold text-ink tabular-nums">
									{t('audiobookCalculator.ui.initialProgressPct')}
								</span>
							</div>
							<div
								id="ab-progress-track"
								role="progressbar"
								aria-label={t('audiobookCalculator.ui.progressBarAria')}
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow="0"
								class="h-2 w-full overflow-hidden rounded-full bg-hairline-soft"
							>
								<div id="ab-progress-fill" class="h-full rounded-full bg-[#0f2e26] transition-all dark:bg-[#afe3d0]" style="width: 0%"></div>
							</div>
							<div class="mt-1.5 flex flex-wrap items-baseline justify-between gap-1 text-[11px] text-mute tabular-nums">
								<span id="ab-progress-listened">{t('audiobookCalculator.ui.initialListened')}</span>
								<span id="ab-progress-remaining" class="font-medium text-ink">{t('audiobookCalculator.ui.initialRemaining')}</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Playback Speed Section (Always Visible, Cleanly Spaced) -->
				<div class="border-t border-hairline pt-6">
					<div class="mb-3 flex items-baseline justify-between gap-2">
						<span class="text-[13px] font-medium text-ink">
							{t('audiobookCalculator.ui.playbackSpeedLabel')}
						</span>
						<span
							id="ab-active-speed-display"
							class="text-[13px] font-semibold text-ink tabular-nums"
						>
							1.0x (~155 WPM)
						</span>
					</div>

					<!-- Quick Preset Speed Pills (0.75x, 1.0x, 1.25x, 1.5x, 1.75x, 2.0x) -->
					<div
						role="group"
						aria-label={t('audiobookCalculator.ui.speedPresetsAria')}
						class="grid grid-cols-3 gap-2 sm:grid-cols-6"
					>
						{
							[0.75, 1.0, 1.25, 1.5, 1.75, 2.0].map((spd) => (
								<button
									type="button"
									data-speed-preset={spd}
									class={`ab-speed-pill cursor-pointer rounded-xl border py-2.5 text-center text-[13px] font-medium tabular-nums transition-all ${
										spd === 1.0
											? 'border-[#0f2e26] bg-[#0f2e26] text-[#afe3d0] dark:border-[#afe3d0] dark:bg-[#afe3d0] dark:text-[#0f2e26]'
											: 'border-hairline bg-canvas text-body hover:border-ink hover:text-ink'
									}`}
								>
									{spd === 1 || spd === 2 ? `${spd.toFixed(1)}x` : `${spd}x`}
								</button>
							))
						}
					</div>

					<!-- Fine-Grained Custom Speed Slider (0.5x – 3.0x) -->
					<div class="mt-4 rounded-2xl border border-hairline bg-canvas px-4 py-3.5">
						<div class="mb-1.5 flex items-center justify-between">
							<label for="ab-speed-slider" class="text-[12px] font-medium text-mute">
								{t('audiobookCalculator.ui.customSpeedSliderLabel')}
							</label>
							<output
								id="ab-slider-value"
								for="ab-speed-slider"
								class="text-[13px] font-semibold text-ink tabular-nums"
							>
								1.0x
							</output>
						</div>
						<input
							id="ab-speed-slider"
							type="range"
							min="0.5"
							max="3.0"
							step="0.05"
							value="1.0"
							class="geist-slider"
						/>
						<div class="mt-1 flex justify-between text-[11px] text-mute tabular-nums">
							<span>0.5x</span>
							<span>1.0x</span>
							<span>2.0x</span>
							<span>3.0x</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Bottom Collapsible Toggles: Quick Presets & Daily Schedule Planner -->
			<div class="mt-6 space-y-2.5 border-t border-hairline pt-5">
				<!-- Collapsible 1: Quick Presets -->
